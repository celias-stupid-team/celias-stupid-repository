raw `

`

mapscripts TwoIsland_CapeBrink_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setflag(FLAG_TEMP_3)
		if(var(VAR_TWO_ISLAND_STARMAN) != 1) {
			setbench(BENCH_TWO_ISLAND_CAVE)

		}
	}
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_TWO_ISLAND_COUNTER, 10800 {
			clearflag(FLAG_SYS_UNDER_WATERFALL)
			msgbox(
			"Hey!\n"
			"That's the secret code!\p"

			"C'mon in!\n"
			"", MSGBOX_DEFAULT)
			setvar(VAR_TWO_ISLAND_COUNTER, 0)
			warp(MAP_TWO_ISLAND_WATERFALL_CAVE, 0)

		}
	]
}

script TwoIsland_StarmanEncounter {
	lock
	playse(SE_M_CONFUSE_RAY)
	setbench(BENCH_TWO_ISLAND_CAVE)
	addobject(LOCALID_TWO_ISLAND_STARMAN)
	applymovement(LOCALID_TWO_ISLAND_STARMAN, moves(
		delay_8
		face_left
		delay_8
		face_down
	))
	waitmovement(0)
	delay(20)
	specialvar(VAR_RESULT, GetPlayerFacingDirection)
	switch(var(VAR_RESULT)) {
		case DIR_SOUTH:
			applymovement(LOCALID_PLAYER, moves(
				face_up
			))
		case DIR_WEST:
			applymovement(LOCALID_PLAYER, moves(
				face_right
			))
		case DIR_EAST:
			applymovement(LOCALID_PLAYER, moves(
				face_left
			))
	}
	waitmovement(0)
	msgbox(
	"{PLAYER}.\n"
	"You stand in our way.\p"

	"I'll stomp you hard.{PAUSE 20}\n"
	"Don't go to heaven!", MSGBOX_DEFAULT)

	trainerbattle_no_intro(TRAINER_STARMAN, "heck")
	msgbox(
	"Hmph.\p"

	"Take this.\n"
	"", MSGBOX_DEFAULT)
	giveitem_msg("{PLAYER} was given the\nMOON STONE!", ITEM_MOON_STONE)
	waitfanfare
	msgbox(
	"Farewell.\n"
	"", MSGBOX_DEFAULT)
	clearflag(FLAG_SYS_FUSHCIA_DISABLE_FLY)
	closemessage
	applymovement(LOCALID_TWO_ISLAND_STARMAN, moves(
		face_left
		delay_8
		face_up
		delay_8
	))
	waitmovement(0)
	removeobject(LOCALID_TWO_ISLAND_STARMAN)
	setvar(VAR_TWO_ISLAND_STARMAN, 2)
	release
}


script TwoIsland_SoftSandGirl {
	lock
	textcolor(NPC_TEXT_COLOR_RED)
	if(flag(FLAG_SOFT_SAND_GIRL)) {
		msgbox(
		"Hmm…\n"
		"Nope!\l"
		"Can't seem to find any more!", MSGBOX_DEFAULT)
		release
		end
	}
	faceplayer
	msgbox(
	"Wowie!\n"
	"Look what I found here!\p"

	"Here, take it!\n"
	"", MSGBOX_DEFAULT)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	giveitem_msg("{PLAYER} was given a handful\nof SAND.", ITEM_SOFT_SAND)
	waitfanfare
	closemessage
	delay(20)
	textcolor(NPC_TEXT_COLOR_RED)
	msgbox(
	"Oooh, lookie!\n"
	"Here's some more!", MSGBOX_DEFAULT)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	giveitem_msg("{PLAYER} was given another\nhandful of SAND.", ITEM_SOFT_SAND)
	waitfanfare
	closemessage
	delay(20)
	textcolor(NPC_TEXT_COLOR_RED)
	msgbox(
	"Oh! Oh!\n"
	"And there's some over here!\l"
	"Take it!", MSGBOX_DEFAULT)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	giveitem_msg("{PLAYER} was given a third fucking\nhandful of SAND.", ITEM_SOFT_SAND)
	waitfanfare
	closemessage
	delay(60)
	msgbox(
	"You no longer need sand.\n"
	"", MSGBOX_DEFAULT)
	setflag(FLAG_SOFT_SAND_GIRL)
	release
	end
}


script TwoIsland_DrawUnderWaterfall {
	setflag(FLAG_SYS_UNDER_WATERFALL)
	setlayouttiles(LAYOUT_TWO_ISLAND_CAPE_BRINK_UNDER_WATERFALL, 0, 0, 0, 0, 44, 29)
					setmaplayoutindex(LAYOUT_TWO_ISLAND_CAPE_BRINK_UNDER_WATERFALL)
	release
}
script TwoIsland_DrawOverWaterfall {
	clearflag(FLAG_SYS_UNDER_WATERFALL)
	setlayouttiles(LAYOUT_TWO_ISLAND_CAPE_BRINK, 0, 0, 0, 0, 44, 29)
					setmaplayoutindex(LAYOUT_TWO_ISLAND_CAPE_BRINK)
	release
	
}