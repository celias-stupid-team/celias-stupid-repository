mapscripts ViridianGym_Koga_MapScripts {
        MAP_SCRIPT_ON_TRANSITION {
        if(var(VAR_CURRENT_DMCA_PHASE) < 5) {
            setvar(VAR_CURRENT_DMCA_PHASE, 5)
        }
        setrespawn(HEAL_LOCATION_VIRIDIAN_GYM_KOGA)
        switch(var(VAR_CURRENT_DMCA_PHASE)) {
            case 1:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM, 5)
            case 2:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_2, 5)
            case 3:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_3, 5)
            case 4:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_4, 5)
            case 5:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_5, 5)
            case 6:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_6, 5)
            case 7:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_7, 5)
            case 8:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_8, 5)
            case 9:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_9, 5)
        }
        call(DMCAKoga_StopSnowing)
        if(flag(FLAG_DEFEATED_DMCA_KOGA)) {
            setmaplayoutindex(LAYOUT_VIRIDIAN_GYM_KOGA_OPEN)
        }
    }
    MAP_SCRIPT_ON_LOAD {
        if(flag(FLAG_DMCA_KOGA_BRICK_1)) {
            setobjectmovementtype(LOCALID_KOGA_BRICK_1, MOVEMENT_TYPE_FACE_DOWN)
        }
        if(flag(FLAG_DMCA_KOGA_BRICK_2)) {
            setobjectmovementtype(LOCALID_KOGA_BRICK_2, MOVEMENT_TYPE_FACE_DOWN)
        }
        if(flag(FLAG_DMCA_KOGA_BRICK_3)) {
            setobjectmovementtype(LOCALID_KOGA_BRICK_3, MOVEMENT_TYPE_FACE_DOWN)
        }
        if(flag(FLAG_DMCA_KOGA_BRICK_4)) {
            setobjectmovementtype(LOCALID_KOGA_BRICK_4, MOVEMENT_TYPE_FACE_DOWN)
        }
        if(flag(FLAG_DMCA_KOGA_BRICK_5)) {
            setobjectmovementtype(LOCALID_KOGA_BRICK_5, MOVEMENT_TYPE_FACE_DOWN)
        }
        call(DMCAKoga_StopSnowing)
    }
}




script ViridianGym_KogaBattle {
    lock
    msgbox(
	"Why hello, {PLAYER}!\n"
	"It's me!\l"
	"Your UNCLE from NINTENDO!\p"

	"Say I've heard some… unfortunate\n"
	"rumors about you and copyright.\p"

	"I'm afraid if it's true, you're\n"
	"no relative of mine!", MSGBOX_DEFAULT)

    trainerbattle_no_intro(TRAINER_DMCA_KOGA, ViridianGym_KogaBattle_End)
    delay(30)
    playse(SE_M_EXPLOSION)
    removeobject(VAR_LAST_TALKED)
    setflag(FLAG_DEFEATED_DMCA_KOGA)
    setlayouttiles(LAYOUT_VIRIDIAN_GYM_KOGA_OPEN, 0,0,0,0,30,23)
					setmaplayoutindex(LAYOUT_VIRIDIAN_GYM_KOGA_OPEN)
    release
}

text ViridianGym_KogaBattle_Start {
    "I'm your uncle from nitnendo\n"
}


text ViridianGym_KogaBattle_End {
   "Oh, no!\n"
	"You blocked my SNOVER in!"
}


script ViridianGym_Koga_Snover {
    lock
    faceplayer
    playmoncry(SPECIES_SNOVER, CRY_MODE_DEFAULT)
	msgbox(
	"snover\n"
	"", MSGBOX_DEFAULT)
    waitmoncry
    release
}

script DMCAKoga_BrickWall1 {
    lock
    if(flag(FLAG_DMCA_KOGA_BRICK_1)) {
        msgbox(
        "The BRICKS have been unbroken.\n"
        "", MSGBOX_DEFAULT)

    } else {
        msgbox(
        "There is a BRICK missing from the\n"
        "wall.\l"
        "SNOVER's hail is seeping through.", MSGBOX_DEFAULT)
        if(checkitem(ITEM_BRICK_PIECE, 1)) {
            msgbox(
            "{PLAYER} deposited a\n"
            "BRICK PIECE.", MSGBOX_DEFAULT)
            closemessage
            playse(SE_M_SPIT_UP)
            removeitem(ITEM_BRICK_PIECE, 1)
            closemessage
            setflag(FLAG_DMCA_KOGA_BRICK_1)
            playse(SE_M_SPIT_UP)
            applymovement(VAR_LAST_TALKED, moves(
                face_down
            ))
            waitmovement(0)
            setobjectmovementtype(VAR_LAST_TALKED, MOVEMENT_TYPE_FACE_DOWN)
        }
    }
    call(DMCAKoga_StopSnowing)
    call(DMCAKoga_StopSnowingString)
    release
}

