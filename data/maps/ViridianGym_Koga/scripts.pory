script DMCAKoga_StopSnowing {
    if(flag(FLAG_DMCA_KOGA_BRICK_5)
    && flag(FLAG_DMCA_KOGA_BRICK_1)
    && flag(FLAG_DMCA_KOGA_BRICK_2)
    && flag(FLAG_DMCA_KOGA_BRICK_3)
    && flag(FLAG_DMCA_KOGA_BRICK_4)) {
        //setmaplayoutindex(LAYOUT_VIRIDIAN_GYM_KOGA_OPEN)
        setweather(WEATHER_NONE)
        doweather
        

    }
    return
}
script DMCAKoga_StopSnowingString {
    if(flag(FLAG_DMCA_KOGA_BRICK_5)
    && flag(FLAG_DMCA_KOGA_BRICK_1)
    && flag(FLAG_DMCA_KOGA_BRICK_2)
    && flag(FLAG_DMCA_KOGA_BRICK_3)
    && flag(FLAG_DMCA_KOGA_BRICK_4)) {
        msgbox(
        "The SNOVER is now sealed away.\n"
        "", MSGBOX_DEFAULT)
        playmoncry(SPECIES_SNOVER, CRY_MODE_FAINT)
        waitmoncry
        msgbox(
        "The snow has stopped.\n"
        "", MSGBOX_DEFAULT)
        setlayouttiles(LAYOUT_VIRIDIAN_GYM_KOGA_OPEN, 0,0,0,0,31,25)
					setmaplayoutindex(LAYOUT_VIRIDIAN_GYM_KOGA_OPEN)
        

    }
    return
}