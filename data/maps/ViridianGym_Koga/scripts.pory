script DMCAKoga_BrickWall4 {
    lock
    if(flag(FLAG_DMCA_KOGA_BRICK_4)) {
        msgbox(
        "The BRICKS have been unbroken.\n"
        "", MSGBOX_DEFAULT)

    } else {
        msgbox(
        "There is a BRICK missing from the\n"
        "wall.\l"
        "SNOVER's hail is seeping through.", MSGBOX_DEFAULT)
        if(checkitem(ITEM_BRICK_PIECE, 1)) {
            if(!flag(FLAG_GOT_MEW_BRICK_PIECE)) {
                msgbox(
                "{PLAYER} attempted to deposit\n"
                "a BRICK PIECE…", MSGBOX_DEFAULT)
                closemessage
                playse(SE_BOO)
                waitse
                msgbox(
                "Hmm…\n"
                "Your BRICK PIECE won't fit.", MSGBOX_DEFAULT)
                if(checkpartymon(SPECIES_DITTO_MEW)) {
                    setflag(FLAG_TRIED_DITTO_IN_WALL)
                    playmoncry(SPECIES_DITTO_MEW, CRY_MODE_DEFAULT)
                    waitmoncry
                    msgbox(
                    "Your DITTO noticed the BRICK WALL.\p"

                    "Maybe it knows how to help…\n"
                    "", MSGBOX_DEFAULT)
                }
                release
                end
            }
            msgbox(
            "{PLAYER} deposited a\n"
            "purple BRICK PIECE.", MSGBOX_DEFAULT)
            closemessage
            playse(SE_M_SPIT_UP)
            removeitem(ITEM_BRICK_PIECE, 1)
            closemessage
            setflag(FLAG_DMCA_KOGA_BRICK_4)
            playse(SE_M_SPIT_UP)
            applymovement(VAR_LAST_TALKED, moves(
                face_down
            ))
            waitmovement(0)
            setobjectmovementtype(VAR_LAST_TALKED, MOVEMENT_TYPE_FACE_DOWN)
        } else {
                if(checkpartymon(SPECIES_DITTO_MEW)) {
                    playmoncry(SPECIES_DITTO_MEW, CRY_MODE_DEFAULT)
                    setflag(FLAG_TRIED_DITTO_IN_WALL)
                    waitmoncry
                    msgbox(
                    "Oh!\n"
                    "Your DITTO noticed the BRICK WALL!\l"
                    "Maybe it knows how to help.\p"

                    "Quick, go put DITTO right where\n"
                    "he belongs!", MSGBOX_DEFAULT)
                }
                release
                end

        }
    }
    call(DMCAKoga_StopSnowing)
    call(DMCAKoga_StopSnowingString)
    release
}

