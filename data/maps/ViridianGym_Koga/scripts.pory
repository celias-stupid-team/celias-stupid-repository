mapscripts ViridianGym_Koga_MapScripts {
        MAP_SCRIPT_ON_TRANSITION {
        if(var(VAR_CURRENT_DMCA_PHASE) < 5) {
            setvar(VAR_CURRENT_DMCA_PHASE, 5)
        }
        setrespawn(HEAL_LOCATION_VIRIDIAN_GYM_KOGA)
        switch(var(VAR_CURRENT_DMCA_PHASE)) {
            case 1:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM, 5)
            case 2:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_2, 5)
            case 3:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_3, 5)
            case 4:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_4, 5)
            case 5:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_5, 5)
            case 6:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_6, 5)
            case 7:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_7, 5)
            case 8:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_8, 5)
            case 9:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_9, 5)
        }
    }
}




script ViridianGym_KogaBattle {
    trainerbattle_single(TRAINER_DMCA_KOGA, ViridianGym_KogaBattle_Start, ViridianGym_KogaBattle_End)
    msgbox(
	"i'm dead\n"
	"", MSGBOX_DEFAULT)
}

text ViridianGym_KogaBattle_Start {
    "I'm your uncle from nitnendo\n"
}


text ViridianGym_KogaBattle_End {
   "oh no\n"
	"walls"
}


script ViridianGym_Koga_Snover {
    lock
    faceplayer
    playmoncry(SPECIES_SNOVER, CRY_MODE_DEFAULT)
	msgbox(
	"snover\n"
	"", MSGBOX_DEFAULT)
    waitmoncry
    release
}
