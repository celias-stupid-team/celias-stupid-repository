mapscripts Ocean11_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
		setworldmapflag(FLAG_CSR_MAP_EGG_DELIVERY)
		if(!checkmoncaught(SPECIES_LUVDISC)) {
			setflag(FLAG_TEMP_1)
		} else {
			clearflag(FLAG_TEMP_1)
		}
    }
	MAP_SCRIPT_ON_RESUME {
		if(checkmoncaught(SPECIES_LUVDISC)) {
			clearflag(FLAG_TEMP_1)
			setvar(VAR_TEMP_1, 1)
			
		}
	}
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_TEMP_1, 1 {
			addobject(LOCALID_LUVDISC_SWIMMER, MAP_OCEAN11)
			setvar(VAR_TEMP_1, 0)
			release
		}
	]
}

script Route21_StartAlomomolaBattle {
	lock
	setwildbattle(SPECIES_LUVDISC, 5)
	//special(StartAlomomolaBattle)
	release
}

script GreatSea_LuvdiscHint {
	setflag(FLAG_LUVDISC_HINT)
	lock
	faceplayer
	msgbox(
	"I've heard there's a rare POKéMON\n"
	"somewhere in the GREAT SEA, but\l"
	"only by fishing in one, single tile.\p"

	"I wonder where that might be…\n"
	"", MSGBOX_DEFAULT)
	release
}

script GreatSea_LuvdiscSwimmer {
	lock
	faceplayer
	
	msgbox(
	"Oh, man.\n"
	"THAT'S what was lurking here?\p"

	"Too bad you couldn't swap that\n"
	"encounter out for a different one.", MSGBOX_DEFAULT)
	release
	end
}

script GreatSea_EggDeliverySign {
	msgbox(
	"KANTO EGG DELIVERY SERVICE\n"
	"", MSGBOX_SIGN)

}


script GreatSea_EggDeliveryHint {
	setflag(FLAG_HEART_SWAP_HINT)
	famechecker(FAMECHECKER_GREAT_SEA_CENTER, 1)
	msgbox(
	"Hi! I'm a representative for the\n"
	"KANTO EGG DELIVERY SERVICE.\p"

	"Say, one of our deliverymen got\n"
	"stuck in CELADON CITY a while back.\l"
	"I hear one of his eggs was ODD?\p"

	"That's sad to hear.\n"
	"We strive for the highest quality!", MSGBOX_NPC)
}


script GreatSea_EggDeliveryBattle {
	trainerbattle_single(
		TRAINER_PICNICKER_MARCY,
		"I got some eggs from the EGG\n"
	"DELIVERY SERVICE, but…\l"
	"I think they all hatched.",

	"Whoops!"
	)
	lock
	faceplayer
	msgbox(
	"Honestly, the EGG DELIVERY service\n"
	"has been dipping in quality.\p"

	"There's a different place up in\n"
	"GREAT BAY with some better eggs.\l"
	"Have you heard of it?", MSGBOX_YESNO)
	if(var(VAR_RESULT)) {
		msgbox(
		"Exactly!\n"
		"", MSGBOX_DEFAULT)
	} else {
		msgbox(
		"Yes!\n", MSGBOX_DEFAULT)
	}
	release
}


script GreatSea_Ocean11Sign {
	msgbox(
	"OCEAN 11\n"
	"NEW WILD POKéMON: 2", MSGBOX_SIGN)

}


script GreatSea_Mantyke {
	lock
	playmoncry(SPECIES_MANTYKE, CRY_MODE_DEFAULT)
	msgbox(
	"MANTYKE: Maaa-!\n"
	"", MSGBOX_DEFAULT)
	waitmoncry
	closemessage
	delay(20)
	msgbox(
	"Aww!\n"
	"He's playing with his friend!", MSGBOX_DEFAULT)
	release
	end
}


script GreatSea_BabyRemoraid {
	lock
	playmoncry(SPECIES_REMORAID, CRY_MODE_DEFAULT)

	waitmoncry
	release
	end
}


script GreatSea_BabyGrowlithe {
	lock
	playmoncry(SPECIES_GROWLITHE, CRY_MODE_DEFAULT)
	msgbox(
	"GROWLITHE: Grwwooo-!\n"
	"", MSGBOX_DEFAULT)
	waitmoncry
	closemessage
	delay(20)
	msgbox(
	"He wants to join in on the fun.\n"
	"", MSGBOX_DEFAULT)
	release
	end
}


script GreatSea_ManaphyTrade {
	lock
	faceplayer
	if(flag(FLAG_SHINY_PHIONE)) {
		msgbox(
		"Good luck with that one!\p"

		"I have a good feeling that we'll\n"
		"finally find its rightful owner.", MSGBOX_DEFAULT)
		release
		end
	}

	msgbox(
	"Heya, friend!\n"
	"I'm looking for a very special EGG.\p"

	"Or rather, I have an EGG here which\n"
	"I know is not special.\l"
	"At least, it's not special for me.", MSGBOX_DEFAULT)
	if(checkmoncaught(SPECIES_PHIONE)) {
		msgbox(
		"You've hatched an EGG before, no?\n"
		"But you weren't the one for it.\p"

		"Maybe this one here would've been\n"
		"yours, and yours mine.\l"
		"It seems we'll never know.", MSGBOX_DEFAULT)
	} else {
		if(checkpartymonslotegg(SPECIES_PHIONE) == PARTY_SIZE) {
			msgbox(
			"If you find a cool EGG somewhere,\n"
			"why don't you bring it here?\p"

			"Who knows? Maybe this one here is\n"
			"yours and yours mine.", MSGBOX_DEFAULT)

		} else {
			msgbox(
			"Oh! Oh!\n"
			"You have an EGG too!\p"

			"Here - let's trade them!\n"
			"Maybe your ID is what mine needs.", MSGBOX_DEFAULT)
			closemessage
			fadescreen(FADE_TO_BLACK)
			playse(SE_BALL_TRADE)
			setflag(FLAG_SHINY_PHIONE)
			fadescreen(FADE_FROM_BLACK)
			playfanfare(MUS_LEVEL_UP)
			textcolor(NPC_TEXT_COLOR_NEUTRAL)
			msgbox(
			"{PLAYER} traded the ODD EGG\n"
			"for a new one!", MSGBOX_DEFAULT)
			waitfanfare
			closemessage
			delay(30)
			textcolor(NPC_TEXT_COLOR_BLUE)
			msgbox(
			"Good luck with that one!\p"

			"I have a good feeling that we'll\n"
			"finally find its rightful owner.", MSGBOX_DEFAULT)
			
		}
	}

	release

}
