mapscripts Chapter3_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_CURRENT_CHAPTER, 2 {
            applymovement(OBJ_EVENT_ID_PLAYER, SetPlayerInvisible)
            applymovement(1, CurtainLeft) //sorry not labeling these it's much faster this way
            applymovement(3, CurtainLeft)
            applymovement(5, CurtainLeft)            
            applymovement(2, CurtainRight)
            applymovement(4, CurtainRight)
            applymovement(6, CurtainRight)
            delay(16)
            call(Chapter3_DeleteInnerCurtainColumns)
            delay(16)
            call(Chapter3_DeleteOuterCurtainColumns)


            waitmovement(1)
            copyobjectxytoperm(1)
            copyobjectxytoperm(2)
            copyobjectxytoperm(3)
            copyobjectxytoperm(4)
            copyobjectxytoperm(5)
            copyobjectxytoperm(6)
            call(Chapter3_PrintChapter)
            delay(170)
            call(Chapter3_Print3)
            delay(40)
            call(Chapter3_PrintMy)
            delay(40)
            call(Chapter3_PrintSe)
            delay(40)
            call(Chapter3_PrintCret)
            delay(40)
            call(Chapter3_PrintLife)

            setvar(VAR_CURRENT_CHAPTER, 3)
            delay(250)
            warp(MAP_POKEMON_TOWER_3F, 0)
        }
    ]
}

movement OuterCurtainLeft {
    walk_fast_left 
    walk_faster_left * 2
    walk_fast_left
}
movement OuterCurtainRight {
    walk_fast_right
    walk_faster_right * 2
    walk_fast_right
}

script Chapter3_DeleteInnerCurtainColumns {
    setmetatile(3, 1, 0x009, TRUE)
    setmetatile(3, 2, 0x011, TRUE)
    setmetatile(3, 3, 0x000, TRUE)
    setmetatile(3, 4, 0x000, TRUE)
    setmetatile(3, 5, 0x000, TRUE)
    setmetatile(3, 6, 0x000, TRUE)
    setmetatile(3, 7, 0x000, TRUE)
    setmetatile(3, 8, 0x000, TRUE)
    setmetatile(3, 9, 0x000, TRUE)
    setmetatile(3, 10, 0x000, TRUE)

    
    setmetatile(11, 1, 0x00C, TRUE)
    setmetatile(11, 2, 0x014, TRUE)
    setmetatile(11, 3, 0x000, TRUE)
    setmetatile(11, 4, 0x000, TRUE)
    setmetatile(11, 5, 0x000, TRUE)
    setmetatile(11, 6, 0x000, TRUE)
    setmetatile(11, 7, 0x000, TRUE)
    setmetatile(11, 8, 0x000, TRUE)
    setmetatile(11, 9, 0x000, TRUE)
    setmetatile(11, 10, 0x000, TRUE)

    special(DrawWholeMapView)
    return
}

