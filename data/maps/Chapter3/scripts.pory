script Chapter3_PrintChapter {
    setmetatile(1, 3, 0x020, TRUE)
    setmetatile(1, 4, 0x028, TRUE)

    setmetatile(2, 3, 0x021, TRUE)
    setmetatile(2, 4, 0x029, TRUE)

    setmetatile(3, 3, 0x022, TRUE)
    setmetatile(3, 4, 0x02A, TRUE)

    setmetatile(4, 3, 0x023, TRUE)
    setmetatile(4, 4, 0x02B, TRUE)

    setmetatile(5, 3, 0x024, TRUE)
    setmetatile(5, 4, 0x02C, TRUE)

    setmetatile(6, 3, 0x025, TRUE)
    setmetatile(6, 4, 0x02D, TRUE)

    setmetatile(7, 3, 0x026, TRUE)
    setmetatile(7, 4, 0x02E, TRUE)

    setmetatile(8, 3, 0x027, TRUE)
    setmetatile(8, 4, 0x02F, TRUE)

    
    setmetatile(9, 3, 0x00D, TRUE)
    setmetatile(9, 4, 0x015, TRUE)
    setmetatile(10, 3, 0x00E, TRUE)
    setmetatile(10, 4, 0x016, TRUE)
    setmetatile(11, 3, 0x00F, TRUE)
    setmetatile(11, 4, 0x017, TRUE)
    special(DrawWholeMapView)
    return
}

script Chapter3_Print3 {
    setmetatile(12, 2, 0x030, TRUE)
    setmetatile(12, 3, 0x038, TRUE)
    setmetatile(12, 4, 0x040, TRUE)


    setmetatile(13, 2, 0x031, TRUE)
    setmetatile(13, 3, 0x039, TRUE)
    setmetatile(13, 4, 0x041, TRUE)
    special(DrawWholeMapView)
    return
}

script Chapter3_PrintMy {
    setmetatile(4, 5, 0x068, TRUE)
    setmetatile(4, 6, 0x070, TRUE)
    setmetatile(5, 5, 0x069, TRUE)
    setmetatile(5, 6, 0x071, TRUE)
    
    special(DrawWholeMapView)
    return
}

script Chapter3_PrintSe {
    setmetatile(6, 5, 0x058, TRUE)

    special(DrawWholeMapView)
    return
}

script Chapter3_PrintCret {
    setmetatile(6, 5, 0x06A, TRUE)
    setmetatile(7, 5, 0x06B, TRUE)
    setmetatile(8, 5, 0x06C, TRUE)

    special(DrawWholeMapView)
    return
}

script Chapter3_PrintLife {
    setmetatile(9, 5, 0x06D, TRUE)
    setmetatile(9, 6, 0x075, TRUE)
    setmetatile(10, 5, 0x06E, TRUE)
    setmetatile(10, 6, 0x076, TRUE)

    special(DrawWholeMapView)
    return
}

movement SetPlayerInvisible {
    set_invisible
}

movement CurtainLeft {
    walk_fast_left
    walk_faster_left * 2
    walk_fast_left
    delay_16
    walk_fast_left
    walk_faster_left * 2
    walk_fast_left
}


movement CurtainRight {
    walk_fast_right
    walk_faster_right * 2
    walk_fast_right
    delay_16
    walk_fast_right
    walk_faster_right * 2
    walk_fast_right
}