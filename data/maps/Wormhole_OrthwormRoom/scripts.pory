mapscripts Wormhole_OrthwormRoom_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if(checkmoncaught(SPECIES_ORTHWORM)) {
            setvar(VAR_TEMP_0, 2)
        }
        if(!flag(FLAG_ORTHWORM_POTION) && checkmoncaught(SPECIES_ORTHWORM)) {
            setobjectxyperm(LOCALID_ORTHWORM_POTION, 9, 12)
        }
    }
    MAP_SCRIPT_ON_LOAD {
        if(!flag(FLAG_ORTHWORM_POTION) && checkmoncaught(SPECIES_ORTHWORM)) {
            setobjectxyperm(LOCALID_ORTHWORM_POTION, 9, 12)
            setobjectmovementtype(LOCALID_ORTHWORM_POTION, MOVEMENT_TYPE_FACE_DOWN)
        }

    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_0, 1 {
        
        removeobject(LOCALID_ORTHWORM_ATTACKING)
        delay(60)
        special(SpawnCameraObject)
        applymovement(LOCALID_CAMERA, moves(
            walk_down * 8
        ))
        waitmovement(LOCALID_CAMERA)
        addobject(LOCALID_ORTHWORM_POTION)
        playse(SE_FALL)
        applymovement(LOCALID_ORTHWORM_POTION, moves(
            set_visible
            walk_down * 5
        ))
        waitmovement(LOCALID_ORTHWORM_POTION)
        //copyobjectxytoperm(LOCALID_ORTHWORM_POTION)
        special(RemoveCameraObject)
        delay(20)
        waitmovement(0)
        setvar(VAR_TEMP_0, 2)
        release
    }
    ]
}

script FixTheCamera {

}

script Wormhole_OrthwormRises {
    lock
    setvar(VAR_TEMP_0, 2)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(
        walk_slow_up * 2
    ))
    waitmovement(0)
    applymovement(LOCALID_CAMERA, moves(
        walk_slow_up * 6
    ))
    playse(SE_M_EARTHQUAKE)
    setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 2)
    setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 2)
    setvar(VAR_SHAKESCREEN_NUM_SHAKES, 70)
    setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
    special(ShakeScreen)
    delay(220)
    waitmovement(0)
    applymovement(LOCALID_ORTHWORM_RISING, moves(
        walk_slow_up * 4
    ))
    applymovement(LOCALID_ORTHWORM_ATTACKING, moves(
        face_left
    ))
    waitmovement(LOCALID_ORTHWORM_RISING)
    delay(60)
    fadescreeninstant(FADE_TO_WHITE)
    delay(5)
    
    applymovement(LOCALID_ORTHWORM_RISING, moves(
        set_invisible
    ))
    applymovement(LOCALID_ORTHWORM_ATTACKING, moves(
        face_up
        set_visible
    ))
    fadescreeninstant(FADE_FROM_WHITE)
    playmoncry(SPECIES_ORTHWORM, CRY_MODE_ENCOUNTER)
    applymovement(LOCALID_ORTHWORM_ATTACKING, moves(
        walk_in_place_up * 8
        face_up
    ))
    setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 2)
    setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 2)
    setvar(VAR_SHAKESCREEN_NUM_SHAKES, 20)
    setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
    special(ShakeScreen)
    waitmovement(LOCALID_ORTHWORM_RISING)
    waitmoncry
    applymovement(LOCALID_ORTHWORM_ATTACKING, moves(
        face_down
        delay_8
        face_left
    ))
    special(RemoveCameraObject)
    waitmovement(LOCALID_ORTHWORM_ATTACKING)
    seteventmon(SPECIES_ORTHWORM, 50)
    special(StartLegendaryBattle) //Celia comes in if you don't have a ball
    delay(30)
    fadescreenswapbuffers(FADE_TO_BLACK)
    removeobject(LOCALID_ORTHWORM_ATTACKING)
    fadescreenswapbuffers(FADE_FROM_BLACK)
        removeobject(LOCALID_ORTHWORM_ATTACKING)
        delay(60)
        special(SpawnCameraObject)
        applymovement(LOCALID_CAMERA, moves(
            walk_down * 8
        ))
        waitmovement(LOCALID_CAMERA)
        delay(30)
        applymovement(LOCALID_ORTHWORM_POTION, moves(
            set_visible
            walk_fast_down * 5
        ))
        delay(20)
        
        playse(SE_FALL)
        waitmovement(LOCALID_ORTHWORM_POTION)
        special(RemoveCameraObject)
        delay(20)
        waitmovement(0)
        setvar(VAR_TEMP_0, 2)
        release
    release

}

script Wormhole_Falling {
    lock
    msgbox(
	"it is implied that you fall\n"
	"", MSGBOX_DEFAULT)
    closemessage
    setobjectxy(LOCALID_PLAYER, 23, 30)
    warphole(MAP_SAFARI_ZONE_NORTH)
    release
}