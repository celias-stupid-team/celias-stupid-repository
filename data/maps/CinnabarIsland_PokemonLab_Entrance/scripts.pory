mapscripts CinnabarIsland_PokemonLab_Entrance_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		if(!flag(FLAG_TALKED_TO_SWORDFUCK)) {
			setflag(FLAG_TEMP_5)
			setflag(FLAG_TEMP_6) //The gun
		}
		if(flag(FLAG_CUT_GUNTHER)) {
			setflag(FLAG_TEMP_6)
		}

	}
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_TEMP_5, 1 {
			setvar(VAR_TEMP_5, 0)
			delay(45)
			playfanfare(MUS_LEVEL_UP)
			msgbox(
			"{PLAYER} got a new GUN!", MSGBOX_DEFAULT)
			waitfanfare
			setflag(FLAG_SHINY_CREATION)
			setflag(FLAG_SHINY_HAUNTER)
			setvar(VAR_USED_CUT, 0)
			setvar(VAR_CSR_GIFT_POKEMON, SPECIES_REMORAID)
			copyvar(VAR_TEMP_1, SPECIES_REMORAID)
			givemon(SPECIES_REMORAID, 30)
			clearflag(FLAG_SHINY_CREATION)
			switch(var(VAR_RESULT)) {
				case 0: //Mon goes to party
					bufferspeciesname(STR_VAR_1, SPECIES_REMORAID)
					
				case 1: //Mon goes to PC
					bufferspeciesname(STR_VAR_1, SPECIES_REMORAID) //Breaks here??
						
				case 2:
					goto(EventScript_NoMoreRoomForPokemon)
					
			}
	

			release
			end

		}
	]
}

script PokemonLab_BlockingTree {
	msgbox(
	"Hello!\n"
	"This is a very important room.\p"

	"…What?\n"
	"Of course you can't go in!\l"
	"What made you think you could?", MSGBOX_NPC)
}

script PokemonLab_WelcomeTree {
	msgbox(
	"Welcome to the CINNABAR ISLAND\n"
	"POKéMON LAB!\p"

	"We're on the cutting edge of\n"
	"research.\l"
	"I hope you enjoy your visit!", MSGBOX_NPC)
}


script PokemonLab_OtherTree {
	msgbox(
	"Hello!\n"
	"I'm a researcher here.\p"

	"This LAB is home to scientists from\n"
	"across the world!\p"

	"I'm so lucky to be a part of it.\n"
	"", MSGBOX_NPC)
}

script PokemonLab_OccupiedTree {
	msgbox(
	"This researcher seems occupied.\n"
	"It'd be unwise to distract him.", MSGBOX_NPC)
}

script PokemonLab_FocusedTree {
	msgbox(
	"This researcher seems focused.\n"
	"It's best not to interfere.", MSGBOX_NPC)
}

script PokemonLab_LockedIn {
	msgbox(
	"This researcher is locked in.\n"
	"Now his attacks won't miss.", MSGBOX_NPC)
}



script PokemonLab_ATree {
	msgbox(
	"This is a tree.\p"

	"It's very busy.\n"
	"", MSGBOX_NPC)
}


script PokemonLab_GoofingOff {
	msgbox(
	"This researcher is pretending to be\n"
	"busy, but is actually goofing off.\p"

	"You should play along so he doesn't\n"
	"get caught.", MSGBOX_NPC)
}
