mapscripts Ocean16_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		if(var(VAR_TRADING_QUEST_PHASE) > 2) {
			setflag(FLAG_TEMP_1)
		}
	}
}


script Desert_RelicCastle {
	msgbox(
	"RELIC CASTLE\n"
	"{PAUSE 30}Ruins", MSGBOX_SIGN)

}


script Desert_DMCAFuckhead {
	msgbox(
	"Serves them right.\n"
	"", MSGBOX_NPC)
}


script Desert_DavidHasselhoff {
	msgbox(
	"I am david hasselhoff\n"
	"", MSGBOX_NPC)
}


script Desert_AlienInDisguise {
	lock
	faceplayer
	msgbox(
	"I have forgotten everything\p"

	"Bring me STEEL WING so I can\n"
	"remember", MSGBOX_DEFAULT)
	if(checkitem(ITEM_TM02)) {
		msgbox(
		"That's STEEL WING\p"

		"Oh yeah I remember now\n"
		"I'm an alien"
		"", MSGBOX_DEFAULT)
		closemessage
		setobjectxy(LOCALID_DESERT_ALIEN, 24, 23)
		applymovement(VAR_LAST_TALKED, moves(
			set_invisible
		))
		applymovement(LOCALID_DESERT_ALIEN, moves(
			set_visible
		))
		waitmovement(0)
		delay(30)
		msgbox(
		"Goodbye\n"
		"", MSGBOX_DEFAULT)
		
		closemessage
		delay(30)
		removeitem(ITEM_TM02)
		giveitem_msg("{PLAYER} got a\nHOUSE VOUCHER!", ITEM_HOUSEVOUCHER)
		waitfanfare
		removeobject(VAR_LAST_TALKED)
		removeobject(LOCALID_DESERT_ALIEN)
		setvar(VAR_TRADING_QUEST_PHASE, 3)
		release
	}
	release
}


script Desert_SquidwardHouse {
	lock
	showmonpic(SPECIES_NOSEPASS, 10, 3)
	waitbuttonpress
	hidemonpic
	release
}


script Desert_YamaskGuy {
	lock
	msgbox(
	"Hey!\n"
	"Could you do me a favor?\p"

	"Could you please deal exactly\n"
	"37 damage to me?", MSGBOX_DEFAULT)
	release
}

script Desert_Bus {
	msgbox(
	"A bus is stalled on the side of\n"
	"the road.\p"

	"A single fly is squished on the\n"
	"windshield.\p"

	"The counter reads{PAUSE 30} “572.”\n"
	"", MSGBOX_SIGN)

}
