mapscripts Ocean16_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		if(var(VAR_TRADING_QUEST_PHASE) > 2) {
			setflag(FLAG_TEMP_1)
		}
		if(!flag(FLAG_POST_GAME) || flag(FLAG_REUNITED_HAKARI_AND_BLIZ)) {
			setflag(FLAG_TEMP_6)
		}
	}
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_TEMP_4, 1 {
			textcolor(NPC_TEXT_COLOR_BLUE)
			msgbox(
			"Perfect!\n"
			"That's exactly what I needed!\p"

			"Here's a present for you.\n"
			"Thanks!", MSGBOX_DEFAULT)
			if(checkitem(ITEM_JAW_FOSSIL)) {
				removeitem(ITEM_JAW_FOSSIL)
			}
			textcolor(NPC_TEXT_COLOR_NEUTRAL)
			giveitem_msg("{PLAYER} was given a\nshiny JAW FOSSIL!", ITEM_SHINY_FOSSIL)
			textcolor(NPC_TEXT_COLOR_BLUE)
			setvar(VAR_TEMP_4, 0)
			msgbox(
			"Now, time to test my hunch…\n"
			"", MSGBOX_DEFAULT)
			release
			end
			
		}
	]
}


script Desert_RelicCastle {
	msgbox(
	"RELIC CASTLE\n"
	"{PAUSE 30}Ruins", MSGBOX_SIGN)

}

script Desert_IceCream {
	lock
	faceplayer
	msgbox(
	"VANILISH: Vaa?\n"
	"", MSGBOX_DEFAULT)
	showmonpic(SPECIES_VANILLISH, 10, 3)
	waitbuttonpress
	hidemonpic
	release
}

script Desert_Appletun {
	lock
	playmoncry(SPECIES_APPLETUN, CRY_MODE_DEFAULT)
	waitmoncry
	delay(10)
	msgbox(
	"The Life of Pie…\n"
	"", MSGBOX_DEFAULT)
	release
}

script Desert_DMCAFuckhead {
	msgbox(
	"Serves them right.\n"
	"", MSGBOX_NPC)
}


script Desert_DavidHasselhoff {
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"I am David Hasselhoff.\n"
	"", MSGBOX_NPC)
}


script Desert_AlienInDisguise {
	lock
	faceplayer
	msgbox(
	"Hmmm…\n"
	"Excuse me, could I have a moment?\p"

	"I seem to have forgotten who I\n"
	"am, or where I've wound up.\p"

	"The only thing I know is that I\n"
	"have an oddly strong compatability\l"
	"with the move STEEL WING.", MSGBOX_DEFAULT)
	if(checkitem(ITEM_TM13)) {
		msgbox(
		"Oh, yes!\n"
		"Yes!\l"
		"STEEL WING!\p"

		"I-… I've remembered!\n"
		"I've remembered everything!", MSGBOX_DEFAULT)
		closemessage
		delay(60)
		playse(SE_M_SPIT_UP)
		setobjectxy(LOCALID_DESERT_ALIEN, 24, 23)
		applymovement(VAR_LAST_TALKED, moves(
			set_invisible
		))
		applymovement(LOCALID_DESERT_ALIEN, moves(
			set_visible
		))
		waitmovement(0)
		delay(30)
		msgbox(
		"Now, I must return home.\p"

		"Thank you, child.\p"

		"You've shown me who I truly am.\n"
		"And so, I'll leave you with the gift\l"
		"of knowledge!", MSGBOX_DEFAULT)
		
		closemessage
		removeitem(ITEM_TM13)
		giveitem_msg("{PLAYER} obtained\nUNDENIABLE PROOF OF ALIENS!", ITEM_ALIEN_PROOF)
		waitfanfare
		msgbox(
		"See ya later!\n"
		"", MSGBOX_DEFAULT)
		closemessage
		playse(SE_M_PSYBEAM)
		applymovement(LOCALID_DESERT_ALIEN, moves(
			face_right
			delay_2
			face_up
			delay_2
			face_left
			delay_2
			face_down
			delay_2
			face_right
			delay_2
			face_up
			delay_2
			face_left
			delay_2
			face_down
			delay_2
			face_right
			delay_2
			face_up
			delay_2
			face_left
			delay_2
			face_down
			delay_16 * 2
		))
		waitmovement(LOCALID_DESERT_ALIEN)
		playse(SE_FLEE)
		applymovement(LOCALID_DESERT_ALIEN, moves(
			walk_faster_up * 7
		))
		waitmovement(LOCALID_DESERT_ALIEN)
		removeobject(VAR_LAST_TALKED)
		removeobject(LOCALID_DESERT_ALIEN)
		setvar(VAR_TRADING_QUEST_PHASE, 3)
		release
	}
	release
}


script Desert_SquidwardHouse {
	lock
	showmonpic(SPECIES_NOSEPASS, 10, 3)
	waitbuttonpress
	hidemonpic
	release
}


script Desert_YamaskGuy {
	
	trainerbattle_single(TRAINER_YAMASK,
	"Hey!\n"
	"Could you do me a favor?\p"

	"Could you please deal exactly\n"
	"49 damage to me?", "Uh, that was a bit too much.")
	msgbox(
	"I don't know why, but I have a\n"
	"hunch that if I bring my YAMASK\l"
	"here and take exactly 49 damage,\l"
	"I'll evolve.\p"

	"Clearly this is something which I\n"
	"figured out organically.", MSGBOX_NPC)
	
}

script Desert_Bus {
	if(flag(FLAG_USED_GENDER_FLUID)) {
		msgbox(
			"Down with the cis!\n"
			"", MSGBOX_SIGN)
	} else {
		msgbox(
		"A bus is stalled on the side of\n"
		"the road.\p"

		"A single bug is squished on the\n"
		"windshield.\p"

		"The counter reads{PAUSE 30} “572.”\n"
		"", MSGBOX_SIGN)

	}

}


script Desert_Dessert {
	msgbox(
	"Confound those DMCA!\p"

	"This place was supposed to be\n"
	"DESSERT before they showed up!", MSGBOX_NPC)
}
