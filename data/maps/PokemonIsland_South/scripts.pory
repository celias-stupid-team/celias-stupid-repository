mapscripts PokemonIsland_South_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setflag(FLAG_CSR_MAP_POKEMON_ISLAND)
	}
}


script PokemonIsland_PhotoLabSign {
	msgbox(
	"POKéMON ISLAND\n"
	"PHOTO LAB", MSGBOX_SIGN)

}

script PokemonIsland_Gun {
	lock
	special(SpawnCameraObject)
	applymovement(LOCALID_CAMERA, moves(
		walk_fast_right * 4
	))
	waitmovement(0)
	if(flag(FLAG_TEMP_4)) {
		delay(60)
		applymovement(LOCALID_CAMERA, moves(
			walk_fast_left * 4
		))
		waitmovement(0)
		special(RemoveCameraObject)
		release
		end

	}
	delay(10)
	msgbox(
	"Shoot him?\n"
	"", MSGBOX_YESNO)
	if(var(VAR_RESULT)) {
		if(flag(FLAG_TEMP_3)) {
			playmoncry(SPECIES_REMORAID, CRY_MODE_DEFAULT)
			fadescreeninstant(FADE_TO_WHITE)
			delay(90)
			closemessage
			setflag(FLAG_TEMP_4)
			removeobject(LOCALID_POKEMON_ISLAND_GROWLITHE)
			fadescreenswapbuffers(FADE_FROM_WHITE)
			delay(45)

		} else {
			setflag(FLAG_TEMP_3)
			playse(MUS_PHOTO)
			dofieldeffect(FLDEFF_PHOTO_FLASH)
			delay(60)
			closemessage
			playmoncry(SPECIES_GROWLITHE, CRY_MODE_DEFAULT)
			waitmoncry

		}
		
	}
	applymovement(LOCALID_CAMERA, moves(
		walk_fast_left * 4
	))
	waitmovement(0)
	special(RemoveCameraObject)
	release
	end
}