mapscripts Zero_Island_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setworldmapflag(FLAG_CSR_MAP_ZERO_ISLAND)
        if(flag(FLAG_OPENED_ZERO_ISLAND)) {
            setmetatile(19, 17, 0x0A9, FALSE)
        } else {
            if(flag(FLAG_INSERTED_MYSTIC_SEAL) && flag(FLAG_INSERTED_INSTINCT_SEAL) && flag(FLAG_INSERTED_VALOR_SEAL)) {
                setvar(VAR_TEMP_0, 1)
            }
        }
        if(flag(FLAG_INSERTED_MYSTIC_SEAL)) {
            setobjectmovementtype(LOCALID_MYSTIC_PILLAR, MOVEMENT_TYPE_WALK_IN_PLACE_UP)
        }
        if(flag(FLAG_INSERTED_INSTINCT_SEAL)) {
            setobjectmovementtype(LOCALID_INSTINCT_PILLAR, MOVEMENT_TYPE_WALK_IN_PLACE_UP)
            
        }
        if(flag(FLAG_INSERTED_VALOR_SEAL)) {
            setobjectmovementtype(LOCALID_VALOR_PILLAR, MOVEMENT_TYPE_WALK_IN_PLACE_UP)
            
        }
    }
    MAP_SCRIPT_ON_LOAD {
        if(flag(FLAG_OPENED_ZERO_ISLAND)) {
            setmetatile(19, 17, 0x0A9, FALSE)
        }

    }
}


script ZeroIsland_InstinctPillar {
    lock
    msgbox(
	"There's an inscription…\p"

	"“THE PILLAR OF INSTINCT”\n"
	"", MSGBOX_DEFAULT)
    if(flag(FLAG_INSERTED_INSTINCT_SEAL)) {
        msgbox(
        "It glows a bright gold.\n"
        "", MSGBOX_DEFAULT)
    }
    release
}


