script ZeroIsland_OpenDoor {
    lock
    if(!(flag(FLAG_INSERTED_MYSTIC_SEAL) && flag(FLAG_INSERTED_INSTINCT_SEAL) && flag(FLAG_INSERTED_VALOR_SEAL))) {
        msgbox(
        "it's a door\p"

        "it is locked\n"
        "", MSGBOX_DEFAULT)
    } else {
        msgbox(
        "it's a door\p"

        "it is locked\n"
        "but it can stop being locked", MSGBOX_DEFAULT)
        closemessage
        delay(30)
    }
    release
}

script ZeroIsland_TryOpenDoor {
            setflag(FLAG_OPENED_ZERO_ISLAND)
            setvar(VAR_TEMP_0, 0)
        msgbox(
        "something cool happens\n"
        "", MSGBOX_DEFAULT)
        closemessage
        delay(30)
        setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 3)
        setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 3)
        setvar(VAR_SHAKESCREEN_NUM_SHAKES, 10)
        setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 3)

        special(ShakeScreen)
        playmoncry(SPECIES_MOLTRES, CRY_MODE_DEFAULT)
        waitmoncry
        playmoncry(SPECIES_ZAPDOS, CRY_MODE_DEFAULT)
        waitmoncry
        playmoncry(SPECIES_ARTICUNO, CRY_MODE_DEFAULT)
        waitmoncry
        delay(30)
        playse(SE_UNLOCK)
        setmetatile(19, 18, 0x0A9, FALSE)
        special(DrawWholeMapView)
        //setmetatile
        release

}