mapscripts Zero_Island_MapScripts {
}


script ZeroIsland_InstinctPillar {
    lock
    if(flag(FLAG_INSERTED_INSTINCT_SEAL)) {
        msgbox(
        "it's a instinct thing\p"

        "it's yellow\n"
        "", MSGBOX_DEFAULT)
    } else {
        msgbox(
        "it's a instinct thing\n"
        "", MSGBOX_DEFAULT)
    }
    release
}


