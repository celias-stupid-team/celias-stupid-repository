script ZeroIsland_OpenDoor {
    lock
    if(!(flag(FLAG_INSERTED_MYSTIC_SEAL) && flag(FLAG_INSERTED_INSTINCT_SEAL) && flag(FLAG_INSERTED_VALOR_SEAL))) {
        msgbox(
        "You feel the presence of a room\n"
        "behind the wall.", MSGBOX_DEFAULT)
    } else {
        msgbox(
        "You feel the presence of a room\n"
        "behind the opening.\p"

        "This is because you can see it.\n"
        "{PAUSE 30}With your eyes.", MSGBOX_DEFAULT)
        closemessage
    }
    release
}

script ZeroIsland_TryOpenDoor {
        setflag(FLAG_OPENED_ZERO_ISLAND)
        setvar(VAR_TEMP_0, 0)
        
        closemessage
        fadeoutbgm(0)
        setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 3)
        setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 3)
        setvar(VAR_SHAKESCREEN_NUM_SHAKES, 20)
        setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 3)

        special(ShakeScreen)
        delay(90)
        fadescreeninstant(FADE_TO_WHITE)
        playmoncry(SPECIES_MOLTRES, CRY_MODE_DEFAULT)
        delay(20)
        playmoncry(SPECIES_ZAPDOS, CRY_MODE_DEFAULT)
        delay(20)
        playmoncry(SPECIES_ARTICUNO, CRY_MODE_DEFAULT)
        delay(50)
        setmetatile(19, 17, 0x0A9, FALSE)
        fadescreeninstant(FADE_FROM_WHITE)
        delay(30)
        special(DrawWholeMapView)
        playse(SE_UNLOCK)
        //setmetatile
        fadeinbgm(1)
        release

}