mapscripts AetherParadise_Island_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_TEMP_9)
        if(flag(FLAG_BADGE05_GET)) {
            setflag(FLAG_CSR_MAP_AETHER_PARADISE)

        }
        if(flag(FLAG_POST_GAME) && flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
        setflag(FLAG_TEMP_1A)
        }
        if(!flag(FLAG_POST_GAME) && !flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
        setflag(FLAG_TEMP_1A)
        }
        if(!flag(FLAG_POST_GAME) && flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
        setflag(FLAG_TEMP_1A)
        }
        if(flag(FLAG_HIDE_POSTGAME_STARLIGHT)) {
        setflag(FLAG_TEMP_1A)
        }
        //if(flag(FLAG_HIDE_POSTGAME_STARLIGHT)) {
        //setflag(FLAG_TEMP_1A)
        //}
        //^ I know there's a better solution for this but I am too tired to do it the right way.
    }
    MAP_SCRIPT_ON_LOAD {        
        if(flag(FLAG_POST_GAME) && !flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
        setlayouttiles(
				LAYOUT_AETHER_PARADISE_ISLAND_LAYOUT_POST_GAME, 
				0,	// startingX
				0,	// startingY 
				51,	// x1 
				2,	// y1
				63, // x2
				19) // y2
        }
    }
}

script AetherParadise_LargeOak {
    lock
    textcolor(NPC_TEXT_COLOR_GREEN)
	famechecker(FAMECHECKER_GREAT_BAY, 2)

    msgbox(
	"SAMSON: Hello, there!\n"
	"My name is OAK.\p"

	"I hope you're having a wonderful\n"
	"day on this beautiful island!", MSGBOX_DEFAULT)
    release
}


script AetherParadise_LocationSign {
	msgbox(
	"AETHER PARADISE\n"
	"", MSGBOX_SIGN)

}


script AetherParadise_FindGroudon {
	msgbox(
	"Hmmm…\n"
	"Can you help me find GROUDON?", MSGBOX_NPC)
}


script AetherParadise_FoundGroudon {
    lock
	msgbox(
	"Oh!\n"
	"", MSGBOX_DEFAULT)
    playmoncry(SPECIES_GROUDON, CRY_MODE_DEFAULT)
    waitmoncry
    msgbox(
	"It's GROUDON!\n"
	"", MSGBOX_DEFAULT)
    
    if(!(flag(FLAG_GROUDON_NOTHING) || flag(FLAG_HIDDEN_ITEM_THREE_ISLAND_BOND_BRIDGE_MAX_REPEL))) {
        msgbox(
        "While you're at it, let's grab\n"
        "that NOTHING too.", MSGBOX_DEFAULT)
        removeobject(LOCALID_NOTHING_GROUDON)
        setflag(FLAG_HIDDEN_ITEM_THREE_ISLAND_BOND_BRIDGE_MAX_REPEL)
        setflag(FLAG_GROUDON_NOTHING)
        giveitem(ITEM_NOTHING)

    }
    release
    end

}


script AetherParadise_Groudon {
    msgbox(
	"Hmm…\n"
	"Nope!\l"
	"Nothing here!", MSGBOX_DEFAULT)
    release
}


script AetherParadise_Sophacles {
	msgbox(
	"Festival Plaza\n"
	"", MSGBOX_NPC)
}



script AetherParadise_SophaclesFindsYou {
    lock
    textcolor(NPC_TEXT_COLOR_BLUE)
    addobject(LOCALID_SOPHACLES)
    clearflag(FLAG_TEMP_9)
    getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
    setobjectxy(LOCALID_SOPHACLES, VAR_TEMP_1, 52)
    applymovement(LOCALID_SOPHACLES, moves(
        set_visible
        walk_down * 5
    ))
    waitmovement(0)
    msgbox("SOPHOCLES: Hello!\nWelcome to FESTIVAL PLAZA!\pWe're holding a festival where\nTRAINERS can meet with each other.\lCome, take a look around!\pIn fact, if you have a couple hours\nto spare, I'll give you a tour!", MSGBOX_YESNO)
    if(var(VAR_RESULT)) {
        msgbox("That's the spirit!\pCome along, now!\nThere's plenty to see!", MSGBOX_DEFAULT)
    } else {
        msgbox("Hahaha, that's cute.\nI bet you thought it was optional!\pNow, c'mon!\nThere's plenty to see!", MSGBOX_DEFAULT)
    }
    closemessage
    delay(20)
    special(SpawnCameraObject)
    applymovement(LOCALID_SOPHACLES, moves(
        walk_left * 5
        walk_down
        face_up
        delay_16 * 12
        walk_up
        walk_right * 10
        face_up
        delay_16 * 12
        walk_up
        walk_left * 5
        walk_up
        face_down
        delay_16 * 12
        walk_up * 4
        delay_16 * 3
        walk_fastest_down * 4

    ))
    applymovement(LOCALID_PLAYER, moves(
        walk_up
        walk_left * 4
        face_up
        delay_16 * 12
        delay_16 * 3
        walk_up
        walk_right * 8
        face_up
        delay_16 * 12
        delay_16 * 3
        walk_left * 4
        face_up
        delay_16 * 12
        walk_up * 4
        delay_16 * 3
        walk_fastest_down * 4
        face_up


    ))
    delay(60)
    message(
	"Now, over here is our COMMUNICATION\n"
	"CENTER.")
    delay(120)
    closemessage
    message(
	"This is where we go to welcome and\n"
	"connect with other TRAINERS!")
    delay(120)
    closemessage

    delay(120)
    message(
	"And over here is our THEATER."
	"")
    delay(120)
    closemessage
    message(
	"This is where we hold performances\n"
	"of classic plays and such!")
    delay(90)
    closemessage
    delay(90)
    message(
	"Now I know it's been a lot so far,\n"
	"but don't worry!")
    delay(120)
    closemessage
    message(
	"There's still tons more to see\n"
	"up ahead!")
    delay(120)
    closemessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    waitmovement(0)
    applymovement(LOCALID_CAMERA, moves(
        walk_fastest_up * 2
    ))
    waitmovement(LOCALID_CAMERA)
    special(RemoveCameraObject)
    textcolor(NPC_TEXT_COLOR_NEUTRAL)
    msgbox("Several hours later…\n", MSGBOX_DEFAULT)
    closemessage
    delay(60)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    textcolor(NPC_TEXT_COLOR_BLUE)
    msgbox("SOPHOCLES: …And that's just the\ntip of the iceberg!", MSGBOX_DEFAULT)
    setobjectmovementtype(LOCALID_SOPHACLES, MOVEMENT_TYPE_FACE_DOWN)
    setvar(VAR_FESTIVAL_PLAZA_TRIGGER, 1)
    release
    end

}


script AetherParadise_FestivalPlazaEstablishments {
    lock
    msgbox(
	"There are only two establishments\n"
	"on this island.", MSGBOX_DEFAULT)
    closemessage
    delay(60)
    msgbox(
	"You spent the entire time going\n"
	"between them.", MSGBOX_DEFAULT)
    closemessage
    delay(60)
    msgbox(
	"You would deeply prefer to never\n"
	"return here again.", MSGBOX_DEFAULT)
    release
}

script FestivalPlaza_Sophacles {
    textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"All men make mistakes, but good men\n"
	"yield when their course is wrong.\l"
	"The only crime is pride.\p"

	"…{PAUSE 30}Would you like to have\n"
	"another tour?", MSGBOX_NPC)
}


script StarlightIslandSign {
if(flag(FLAG_POST_GAME) && !flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
        msgbox(
	"Star-LightHouse"
    , MSGBOX_SIGN)

} else {
    msgbox(
	"Starlight's House", MSGBOX_SIGN)
    }
}

script StarlightPostGameOutside {
	textcolor(NPC_TEXT_COLOR_FEMALE)
    msgbox("I remodeled my house, what do you\nthink?", MSGBOX_NPC)
	closemessage
	//camera goes up
	delay(30)
    applymovement(POST_GAME_STARLIGHT, moves(
			face_up
    		))
	special(SpawnCameraObject)
	applymovement(LOCALID_CAMERA, Star_Lighthouse_CameraGoesUp)
	waitmovement(0)


	delay(120) //waiting on lighthouse sign
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox("Yup.\nDesigned it myself.", MSGBOX_NPC)
	closemessage
	delay(15)
	//camera goes down
	applymovement(LOCALID_CAMERA, Star_Lighthouse_CameraGoesDown)
	//NPC enters lighthouse
	delay(8) //delay to make it line up with the camera
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox("Truly an original work of art.", MSGBOX_NPC)
	closemessage
    delay(30)
	applymovement(STARLIGHT_POST_GAME_LIGHTHOUSE, moves(
			walk_up
    		))
    
    waitmovement(STARLIGHT_POST_GAME_LIGHTHOUSE)
    playse(SE_EXIT)
    removeobject(STARLIGHT_POST_GAME_LIGHTHOUSE)
	special(RemoveCameraObject)
    setflag(FLAG_HIDE_POSTGAME_STARLIGHT)
    delay(30)
	return
}

movement Star_Lighthouse_CameraGoesUp {
	walk_up * 4
}

movement Star_Lighthouse_CameraGoesDown {
	walk_down * 4
}