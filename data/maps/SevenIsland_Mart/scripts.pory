raw `
SevenIsland_Mart_MapScripts::
	.byte 0


	.align 2
SevenIsland_Mart_Items::
	.2byte ITEM_ULTRA_BALL
	.2byte ITEM_GREAT_BALL
	.2byte ITEM_FULL_RESTORE
	.2byte ITEM_MAX_ELIXIR
	.2byte ITEM_ELIXIR
	.2byte ITEM_REVIVE
	.2byte ITEM_FULL_HEAL
	.2byte ITEM_ESCAPE_ROPE
	.2byte ITEM_MAX_REPEL
	.2byte ITEM_NONE
	release
	end

SevenIsland_Mart_EventScript_Lass::
	msgbox SevenIsland_Mart_Text_MonHavePersonalitiesOfTheirOwn, MSGBOX_NPC
	end

SevenIsland_Mart_EventScript_Hiker::
	msgbox SevenIsland_Mart_Text_PreparationsCompleteForRuins, MSGBOX_NPC
	end

SevenIsland_Mart_EventScript_Fisher::
	msgbox SevenIsland_Mart_Text_NeedToFishOnSevenIsland, MSGBOX_NPC
	end
`
script SevenIsland_Mart_EventScript_Clerk {
	goto_if_questlog(EventScript_ReleaseEnd)
	lock
	faceplayer
	msgbox(
	"Hi, welcome to WAL-MART.\n"
	"What do you want?", MSGBOX_DEFAULT)
	waitmessage
	pokemart(Walmart_Mart)
	if(checkitem(ITEM_GUN)) {
		while(checkitem(ITEM_GUN)) {
			removeitem(ITEM_GUN)
		}
		closemessage
		playfanfare(MUS_LEVEL_UP)
		msgbox(
		"{PLAYER} bought a GUN!\n"
		"", MSGBOX_DEFAULT)
		waitfanfare
		setvar(VAR_CSR_GIFT_POKEMON, SPECIES_REMORAID)
		call(Common_Script_GiftPokemon)
	}
	msgbox(
	"I make minimum wage.\n"
	"", MSGBOX_DEFAULT)
	
	release
}

script WalMart_LightYears {
	specialvar(VAR_FACING, GetPlayerFacingDirection)
	if(var(VAR_FACING) == DIR_NORTH) {
		applymovement(LOCALID_PLAYER, Common_Movement_WalkUp2)
	} elif(var(VAR_FACING) == DIR_SOUTH) {
			applymovement(LOCALID_PLAYER, Common_Movement_WalkDown2)
	}
	fadescreenswapbuffers(FADE_TO_BLACK)
	waitmovement(0)
	lock
	msgbox("58,786,253,730,000,000 miles\nlater…", MSGBOX_DEFAULT)
	closemessage
		if(var(VAR_FACING) == DIR_NORTH) {
		applymovement(LOCALID_PLAYER, Common_Movement_WalkUp2)
	} elif(var(VAR_FACING) == DIR_SOUTH) {
			applymovement(LOCALID_PLAYER, Common_Movement_WalkDown2)
	}
	fadescreenswapbuffers(FADE_FROM_BLACK)
	waitmovement(0)
	switch(var(VAR_TEMP_0)) {
		case 0:
			setvar(VAR_TEMP_0, 1)
			break
		case 1:
			setvar(VAR_TEMP_0, 0)
			break
	}
	release
	
}

mart Walmart_Mart {
	ITEM_CIGARETTES
	ITEM_GUN
	ITEM_PEPSI
}


script Walmart_HamburgerGuy {
	msgbox(
	"I've been trying to stock up on\n"
	"HAMBURGERS since I ran out, but…\p"

	"I think there's been some sort\n"
	"of supply issue?\l"
	"I can't find them anywhere!", MSGBOX_NPC)
}

script Walmart_GunClue {
	msgbox(
	"If you ask me, second amendment\n"
	"rights aren't going far enough!\p"

	"If I had it my way, even my dog\n"
	"would be armed with a GUN!", MSGBOX_NPC)
}

script Walmart_WeightLoss {
	msgbox(
	"I've been trying to lose weight,\n"
	"so I visit WALMART every day.", MSGBOX_NPC)
}


script Walmart_NPC1 {
	lock
	msgbox(
	"Oh, wow!\n"
	"My favorite shirt!\p"

	"Let me buy twelve!\n"
	"", MSGBOX_DEFAULT)
	release
}

script Walmart_NPC2 {
	msgbox(
	"walmart placeholder npc 2\n"
	"", MSGBOX_NPC)
}

script Walmart_Jumpluff {
	lock
	faceplayer
	playmoncry(SPECIES_JUMPLUFF, CRY_MODE_DEFAULT)
	textcolor(NPC_TEXT_COLOR_MALE)
	msgbox(
	"JUMPLUFF: Plaa!\n"
	"", MSGBOX_DEFAULT)
	waitmoncry
	closemessage
	delay(20)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox(
	"It's a funny JUMPLUFF!\n"
	"", MSGBOX_DEFAULT)
	release
	end
}