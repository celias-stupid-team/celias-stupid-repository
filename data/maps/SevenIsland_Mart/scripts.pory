raw `
SevenIsland_Mart_MapScripts::
	.byte 0


	.align 2
SevenIsland_Mart_Items::
	.2byte ITEM_ULTRA_BALL
	.2byte ITEM_GREAT_BALL
	.2byte ITEM_FULL_RESTORE
	.2byte ITEM_MAX_ELIXIR
	.2byte ITEM_ELIXIR
	.2byte ITEM_REVIVE
	.2byte ITEM_FULL_HEAL
	.2byte ITEM_ESCAPE_ROPE
	.2byte ITEM_MAX_REPEL
	.2byte ITEM_NONE
	release
	end

SevenIsland_Mart_EventScript_Lass::
	msgbox SevenIsland_Mart_Text_MonHavePersonalitiesOfTheirOwn, MSGBOX_NPC
	end

SevenIsland_Mart_EventScript_Hiker::
	msgbox SevenIsland_Mart_Text_PreparationsCompleteForRuins, MSGBOX_NPC
	end

SevenIsland_Mart_EventScript_Fisher::
	msgbox SevenIsland_Mart_Text_NeedToFishOnSevenIsland, MSGBOX_NPC
	end
`
script SevenIsland_Mart_EventScript_Clerk {
	goto_if_questlog(EventScript_ReleaseEnd)
	lock
	faceplayer
	msgbox(
	"Hi, welcome to WAL-MART.\n"
	"What do you want?", MSGBOX_DEFAULT)
	waitmessage
	pokemart(Walmart_Mart)
	if(checkitem(ITEM_GUN)) {
		while(checkitem(ITEM_GUN)) {
			removeitem(ITEM_GUN)
		}
		closemessage
		playfanfare(MUS_LEVEL_UP)
		msgbox(
		"{PLAYER} bought a GUN!\n"
		"", MSGBOX_DEFAULT)
		waitfanfare
		setvar(VAR_CSR_GIFT_POKEMON, SPECIES_REMORAID)
		call(Common_Script_GiftPokemon)
	}
	msgbox(
	"I make minimum wage.\n"
	"", MSGBOX_DEFAULT)
	
	release
}

script WalMart_LightYears {
	specialvar(VAR_FACING, GetPlayerFacingDirection)
	if(var(VAR_FACING) == DIR_NORTH) {
		applymovement(LOCALID_PLAYER, Common_Movement_WalkUp2)
	} elif(var(VAR_FACING) == DIR_SOUTH) {
			applymovement(LOCALID_PLAYER, Common_Movement_WalkDown2)
	}
	fadescreenswapbuffers(FADE_TO_BLACK)
	waitmovement(0)
	lock
	msgbox("58,786,253,730,000,000 miles\nlater…", MSGBOX_DEFAULT)
	closemessage
		if(var(VAR_FACING) == DIR_NORTH) {
		applymovement(LOCALID_PLAYER, Common_Movement_WalkUp2)
	} elif(var(VAR_FACING) == DIR_SOUTH) {
			applymovement(LOCALID_PLAYER, Common_Movement_WalkDown2)
	}
	fadescreenswapbuffers(FADE_FROM_BLACK)
	waitmovement(0)
	switch(var(VAR_TEMP_0)) {
		case 0:
			setvar(VAR_TEMP_0, 1)
			break
		case 1:
			setvar(VAR_TEMP_0, 0)
			break
	}
	release
	
}

mart Walmart_Mart {
	ITEM_CIGARETTES
	ITEM_GUN
	ITEM_PEPSI
}


script Walmart_HamburgerGuy {
	if(checkitem(ITEM_HAMBURGER) && flag(FLAG_HAMBURGER_GUY)) {
		msgbox(
		"Oh, you brought a HAMBURGER here\n"
		"for me?\p"

		"Thanks, but…\n"
		"I'm just a one-off gag.\l"
		"My existence has no deeper meaning.\p"

		"Frankly, it's a little bit of a\n"
		"terrifying concept for me to grasp.\l"
		"I try not to think about it.\p"

		"Oh, right! HAMBURGER!\n"
		"Uhh\p"

		"You can keep it.\n"
		"", MSGBOX_NPC)
		end
	}
	setflag(FLAG_HAMBURGER_GUY)
	msgbox(
	"I've been trying to stock up on\n"
	"HAMBURGERS since I ran out, but…\p"

	"I think there's been some sort\n"
	"of supply issue?\l"
	"I can't find them anywhere!", MSGBOX_NPC)
}

script Walmart_GunClue {
	//famechecker(FAMECHECKER_GREAT_SEA_EAST, 5) //We'll see if I keep this
	msgbox(
	"If you ask me, second amendment\n"
	"rights aren't going far enough!\p"

	"If I had it my way, even my dog\n"
	"would be armed with a GUN!", MSGBOX_NPC)
}

script Walmart_WeightLoss {
	msgbox(
	"I've been trying to lose weight,\n"
	"so I visit WALMART every day.", MSGBOX_NPC)
}


script Walmart_NPC1 {
	lock
	msgbox(
	"Oh, wow!\n"
	"My favorite shirt!\p"

	"Let me buy twelve!\n"
	"", MSGBOX_DEFAULT)
	release
}

script Walmart_NPC2 {
	msgbox(
	"Y'know they call it WAL-MART, but\n"
	"I can't seem to buy any walls…", MSGBOX_NPC)
}

script Walmart_Jumpluff {
	lock
	faceplayer
	playmoncry(SPECIES_JUMPLUFF, CRY_MODE_DEFAULT)
	textcolor(NPC_TEXT_COLOR_MALE)
	msgbox(
	"JUMPLUFF: Plaa!\n"
	"", MSGBOX_DEFAULT)
	waitmoncry
	closemessage
	delay(20)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox(
	"It's a funny JUMPLUFF!\n"
	"", MSGBOX_DEFAULT)
	if(checkitem(ITEM_PEPSI)) {
		msgbox(
		"Feed it a PEPSI?\n"
		"", MSGBOX_YESNO)
		if(var(VAR_RESULT)) {
			waitse
			playmoncry(SPECIES_SKIPLOOM, CRY_MODE_DEFAULT)
			waitmoncry
			msgbox(
			"He's a baby boy!\n"
			"", MSGBOX_DEFAULT)
			removeitem(ITEM_PEPSI)
			release
			end
		}
	}
	release
	end
}

script Walmart_CashRegister {
	lock
	playse(SE_PIN)
	applymovement(LOCALID_WALMART_CLERK, moves(
		face_right
		emote_exclamation_mark
		delay_16 * 3
	))
	waitmovement(0)
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"Uh, hey.\n"
	"Please don't touch the register.\p"

	"My boss expects me to literally\n"
	"risk my life to protect it, and\l"
	"I'd really rather, uh, not.\p"

	"My life is literally worth less\n"
	"to this corporation than ¥247.\p"

	"So, uh…\n"
	"yeah.", MSGBOX_DEFAULT)
	closemessage
	applymovement(LOCALID_WALMART_CLERK, moves(
		face_down
	))
	release

}

script Walmart_Counter {
	lock
	waitse
	applymovement(LOCALID_WALMART_CLERK, moves(
		walk_right
	))
	textcolor(NPC_TEXT_COLOR_BLUE)
	waitmovement(0)
	goto_if_questlog(EventScript_ReleaseEnd)
	faceplayer
	msgbox(
	"Hi, welcome to WAL-MART.\n"
	"What do you want?", MSGBOX_DEFAULT)
	waitmessage
	pokemart(Walmart_Mart)
	if(checkitem(ITEM_GUN)) {
		while(checkitem(ITEM_GUN)) {
			removeitem(ITEM_GUN)
		}
		closemessage
		playfanfare(MUS_LEVEL_UP)
		msgbox(
		"{PLAYER} bought a GUN!\n"
		"", MSGBOX_DEFAULT)
		waitfanfare
		setvar(VAR_CSR_GIFT_POKEMON, SPECIES_REMORAID)
		call(Common_Script_GiftPokemon)
	}
	msgbox(
	"I really wish I had a chair.\n"
	"", MSGBOX_DEFAULT)
	closemessage
	applymovement(LOCALID_WALMART_CLERK, moves(
		walk_left
		face_down
	))
	waitmovement(0)
	release
}