mapscripts FushciaGym_TrainerRoom1_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        setvar(VAR_FUSHCIA_PREVIOUS_ROOM, FUSHCIA_ROOM_DURANT)
        if(flag(FLAG_DEFEATED_TRAINER_1)) {
            call(FushciaGym_TrainerRoom1_OpenDoors)
        }
        if(!flag(FLAG_FUSHCIA_GYM_RIGHT_FIRST)) {
            setflag(FLAG_FUSHCIA_GYM_LEFT_FIRST)
        }
        if(flag(FLAG_FUSHCIA_GYM_LEFT_FIRST)) {
            setflag(FLAG_TEMP_3)
        } else {
            setflag(FLAG_TEMP_2)
        }
        
        setrespawn(HEAL_LOCATION_FUSHCIA_GYM_TRAINER_ROOM_1)
    }
}

script FushciaGym_TrainerRoom1_Brandon {
    lock
    faceplayer
    textcolor(NPC_TEXT_COLOR_BLUE)
    if(flag(FLAG_DEFEATED_TRAINER_1)) {
        msgbox("…Huh?\nNo, I am BRANDON.\lBRENDAN is the kid next door.\pPeople get us mixed up all the\ntime.", MSGBOX_DEFAULT)
        call(FushciaGym_TrainerRoom1_OpenDoors)
        special(DrawWholeMapView)
    } else {
        msgbox("Young adventurer!\nWelcome to FUSHCIA GYM!\pI am your first challenge:\nPYRAMID KING BRANDON!\lShow me your courage in battle!", MSGBOX_DEFAULT)
        trainerbattle_no_intro(TRAINER_BATTLE_FRONTIER_BRANDON, "Haha!\nWell done!")
        setflag(FLAG_DEFEATED_TRAINER_1)

    }
    call(FushciaGym_TrainerRoom1_OpenDoors)
    special(DrawWholeMapView)
    release
    end
}

script FushciaGym_TrainerRoom1_Spenser {
    lock
    faceplayer
    textcolor(NPC_TEXT_COLOR_BLUE)
    if(flag(FLAG_DEFEATED_TRAINER_1)) {
        msgbox("SPENSER: Hrrm…\pI had the same luck in my\nlow-level challenge run.", MSGBOX_DEFAULT)
        call(FushciaGym_TrainerRoom1_OpenDoors)
        special(DrawWholeMapView)
    } else {
    
        msgbox("Hello, challenger!\nI am SPENSER of the BATTLE PALACE.\pI give my POKéMON freedom to\nchoose their own MOVES.\lI put full faith in their choices.", MSGBOX_DEFAULT)
        trainerbattle_no_intro(TRAINER_BATTLE_FRONTIER_SPENSER, "Darn.\n")
        setflag(FLAG_DEFEATED_TRAINER_1)
    }
    call(FushciaGym_TrainerRoom1_OpenDoors)
    special(DrawWholeMapView)
    release
    end
}

script FushciaGym_TrainerRoom1_OpenDoors {
    setmetatile(7, 7, 0x34F, TRUE)
    setmetatile(11, 7, 0x3BD, TRUE)
    setmetatile(7, 8, 0x357, TRUE)
    setmetatile(11, 8, 0x357, TRUE)
    return
}

script FushciaGym_TrainerRoom1_LeftDoor {
    lock
    if(flag(FLAG_DEFEATED_TRAINER_1)) {
        msgbox("GUTS ROOM\pThis room can easily be cheesed\nif you want.\pBut, like… please don't?\nThanks :)", MSGBOX_DEFAULT)
    } else {
        msgbox("The door is locked.\n", MSGBOX_DEFAULT)
    }
    release
}

script FushciaGym_TrainerRoom1_RightDoor {
    lock
    if(flag(FLAG_DEFEATED_TRAINER_1)) {
        msgbox("HEALING ROOM\nGive your POKéMON a full rest!\pNotice!\pThis room is found to be violating\nthe Geneva Conventions.\pPlease proceed with caution.\n", MSGBOX_DEFAULT)
    } else {
        msgbox("The door is locked.\n", MSGBOX_DEFAULT)
    }
    release
}