mapscripts Starlight_House6_MapScripts {

MAP_SCRIPT_ON_TRANSITION {
		if(flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
			setflag(FLAG_TEMP_8)
        }
            if(flag(FLAG_CSR_CELIA_BONUS)) {
			setflag(FLAG_TEMP_8)
		}
        if(flag(FLAG_DAK_HERE)) {
			setflag(FLAG_TEMP_8)
		}
		
	}

}

script Starlight_House3_Commentary_Rusty {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"I was surprised this game had no\n"
	"references to the YouTube show\l"
	"Pokemon Rusty.\p"

	"So I added one in lol.\n"
	"", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Cutscene {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"This was my first ever attempt at\n"
	"scripting a cutscene and I had some\l"
	"fun doing it! It reminds me of\l"
	"SkyTemple Cutscene Scripting", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Frame {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"This framed DMCA joke was actually\n"
	"inspired by something Celia said.\p"
	"I one time asked her what would she\l"
	"do if she ever received a cease and\l"
	"desist letter from Nintendo asking\l"
	"to take the Romhack down?\p"
	"She answered with:\l"
	"If I get a C&D from Nintendo I'm\l"
	"framing it on my wall", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Map_Table {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"Idk why I added this table.\p"

	"I thought it would be kind of cool\n"
	"to put the town map onto a map\l"
	"itself.", MSGBOX_NPC)
}

script Starlight_House3_Commentary_For_Outside {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"I didn't want to put commentary of\n"
	"my own out in the world because\l"
	"that is Celia's thing.\p"

	"So I am using this table as an\n"
	"opportunity to talk about\l"
	"stuff in different maps!", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Minnesota {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"Despite what Celia said about my\n"
	"early issues with big maps lol,\l"
	"I just wanted to make it accurate.\l"
	"and so I attempted to make the\l"
	"elevation, climate, and such accurate\l"
	"similarly to the real Minnesota.", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Porygons {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"Did you know I hid 2 porygons\n"
	"within the map tiles? It was going\l"
	"to be the original method for the\l"
	"shiny.\p"

	"You can still find them! If you've\n"
	"played the original Pokemon Snap\l"
	"you might know where to look.", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Cinnabar {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"With Cinnabar I did my best to make\n"
	"the destroyed version look like\l"
	"the island crashed into it.\p"
	"You can see dirt trails from the\n"
	"boulders that flew across the map.", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Thirty_Eight {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"Thirty Eight Island used to be\n"
	"to scale of the Johto route but I\l"
	"had to shrink it down slightly\l"
	"around 3 times for convenience.", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Favorite_Maps {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"Pirate Bay and the Desert above it\n"
	"are some of my favorite maps I've\l"
	"designed in this game!", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Sky_Tower {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"Sky Tower Extending beyond Yes was\n"
	"my idea and the first thing I ever\l"
	"did when I joined the dev team. I\l"
	"was screwing around and Celia\l"
	"liked the idea.", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Dak {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"This is Dak.\p"

	"We've been irl friends for over\n"
	"25 years.\p"

	"I needed a second character for the\n"
	"map house and was hoping putting\l"
	"him in this hack will get him to\l"
	"play it lol.", MSGBOX_NPC)
}

//main room

script Starlight_House_Commentary_Dev {
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"Celia offered me a chance to share\n"
	"any dev commentary here so I did!\p"

	"Some of it is for this house, some\n"
	"of it is for development overall.", MSGBOX_NPC)
}

script Starlight_House_Commentary_Good_As_Celia {
	msgbox(
	"When it comes to gameplay pacing\n"
	"and design, Celia is way better\l"
	"than me. I hope to be as good as her\l"
	"someday!\p"

	"I am proud of a few ideas, like the\n"
	"Gender Fluid item, Water Maze, Lass\l"
	"looping around the map bit, Pit\l"
	"Island, and more.", MSGBOX_NPC)
}
















