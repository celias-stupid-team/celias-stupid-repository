mapscripts Starlight_House6_MapScripts {

MAP_SCRIPT_ON_TRANSITION {
		if(flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
			setflag(FLAG_TEMP_8)
        }
            if(flag(FLAG_CSR_CELIA_BONUS)) {
			setflag(FLAG_TEMP_8)
		}
        if(flag(FLAG_DAK_HERE)) {
			setflag(FLAG_TEMP_8)
		}
		
	}

}

script Starlight_House3_Commentary_Rusty {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"I was surprised this game had no\n"
	"references to Pokemon Rusty.\p"

	"So I added one in.", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Cutscene {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"This was my first ever attempt at\n"
	"scripting a cutscene and I had some\l"
	"fun doing it! It reminds me of\l"
	"SkyTemple Cutscene Scripting.", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Frame {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"One time I asked Celia what she\n"
	"would do if Nintendo sent her a C&D\l"
	"letter.\p"

	"She said she would frame it on her\n"
	"wall.", MSGBOX_NPC)
}

script Starlight_House3_Commentary_For_Outside {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"I didn't want to put commentary of\n"
	"my own out in the world because\l"
	"that is Celia's thing.\p"

	"So I am using this table as an\n"
	"opportunity to talk about\l"
	"stuff in different maps.", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Minnesota {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"I tried my best to make\n"
	"Minnesota as accurate as possible.\p"

	"I even tried to make the elevation,\n"
	"water, and town locations based on\l"
	"certain buildings similar.\p"

	"I didn't have to, but I like those\n"
	"small details that nobody would\l"
	"likely notice", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Porygons {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"On Pokemon Island, I hid 2 Porygons\n"
	"within the map tiles.\l"
	"It was the original method for the\l"
	"shiny but since has been changed.\p"

	"You can still find them! If you've\n"
	"played Pokemon Snap you might know\l"
	"where to look.", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Cinnabar {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"With Cinnabar I did my best to make\n"
	"the destroyed version look like\l"
	"the island crashed into it.\p"
	"You can see dirt trails from the\n"
	"boulders that flew across the map.", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Thirty_Eight {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"Thirty Eight Island used to be 1x1\n"
	"scale of the original route but was\l"
	"shrinked down 3x for convenience.", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Favorite_Maps {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"Pirate Bay and the Desert above it\n"
	"are some of my favorite maps I've\l"
	"designed in this game!", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Sky_Tower {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"Sky Tower Extending beyond Yes was\n"
	"my idea and the first thing I ever\l"
	"did when I joined the dev team. I\l"
	"was screwing around and Celia\l"
	"liked the idea.", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Dak {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"Dak is my irl friend.\p"

	"I needed a second character for my\n"
	"cutscene test and I'm hoping that\l"
	"putting him in this game will\l"
	"interest him in trying this\l"
	"masterpiece of a romhack lol.", MSGBOX_NPC)
}

//main room

script Starlight_House_Commentary_Dev {
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"Celia offered me a chance to share\n"
	"any dev commentary here so I did!\p"

	"Some of it is for this house, some\n"
	"of it is for development overall.", MSGBOX_NPC)
}

script Starlight_House_Commentary_Good_As_Celia {
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"When it comes to pacing, jokes,\n"
	"storytelling and overall design,\l"
	"Celia has a lot of talent that I\l"
	"strive for someday.\p"

	"I am proud of a few ideas though.\p"

	"like the Gender Fluid item, Water\n"
	"Maze, Lass looping around the map,\l"
	"Pit Island, and more!", MSGBOX_NPC)
}

script Starlight_House_Commentary_Big_Maps {
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"I went through a learning curve\n"
	"for designing maps.\l"
	"When I started I always made them\l"
	"too big, even though I planned to\l"
	"make them detailed.\p"

	"When you have a birds eye view of\n"
	"the entire map zoomed out, it's\l"
	"easy to misinterpret the size\l"
	"to the actual gameplay experience.\p"
	closemessage
	delay(60)
	"At least for me at first...", MSGBOX_NPC)
}

script Starlight_House_Commentary_Purpose {
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"I made this house because I wanted\n"
	"to have some fun experimenting\l"
	"with different map features and\l"
	"ideas.", MSGBOX_NPC)
}

script Starlight_House_Commentary_Rant {
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox("Would you like to hear my dumb rant\n"
	"about Pokemon romhack mapping?", MSGBOX_YESNO)
		//closemessage
		if(var(VAR_RESULT)) {
			msgbox(
				"Are you sure? It's kind of long.", MSGBOX_YESNO)
				//closemessage
				if(var(VAR_RESULT)) {
			
			
			msgbox(
		
	"Mapping is such an under-\n"
	"appreciated and niche form of art.\p"

	"I always see such cool maps made\n"
	"but I don't often hear players\l"
	"say anything about them, if ever.\p"

	"It's nobody's fault though.\p"

    "It's not something people really\n"
	"think about, given they don't see\l"
	"that much of it within that tiny\l"
	"little screen.\p"

	"The only time I see compliments are\n"
	"when people post the whole map as a\l"
	"screenshot in some romhack\l"
	"communities.\p"

	"Usually it's the spritework,\n"
	"music, battle animation, and such\l"
	"that gets praised during gameplay.\p"

	"And as such! They absolutely\n"
	"deserve that appreciation.\p"

	"But mapping takes a lot of time,\n"
	"planning, and effort to do as well.\p"

	"It's unfortunate but it is what\n"
	"it is {JPN}へ{ENG}({JPN}ツ{ENG}){JPN}へ{ENG}", MSGBOX_NPC)
	closemessage
	delay(60)

msgbox(
	"Thank you for listening to that\n"
	"long BS rant."

	//"I can't give you much, but here\n"
	//"I heard this was rare.\p", MSGBOX_NPC)

	//giveitem_msg("{PLAYER} found\n1 RARE CANDY!", ITEM_RARE_CANDY, 1)

	//msgbox(
	//"Better than nothing I guess lol."
	, MSGBOX_NPC)

} else {
	msgbox("I don't blame you lol.", MSGBOX_NPC)
	}
		}
		else {
	msgbox("I don't blame you lol.", MSGBOX_NPC)
	}
	applymovement(VAR_LAST_TALKED, moves(
		face_original_direction
	))
	waitmovement(0)
	release
}
	




















