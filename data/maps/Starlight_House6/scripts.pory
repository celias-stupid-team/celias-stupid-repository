mapscripts Starlight_House6_MapScripts {

MAP_SCRIPT_ON_TRANSITION {
		if(flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
			setflag(FLAG_TEMP_8)
        }
            if(flag(FLAG_CSR_CELIA_BONUS)) {
			setflag(FLAG_TEMP_8)
		}
        if(flag(FLAG_DAK_HERE)) {
			setflag(FLAG_TEMP_8)
		}
		
	}

}

script Easter_Egg_Starlight_1 {//SKY TOWER
	if(!flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
	setvar(VAR_0x8000, VAR_BONUS_STARS)
    setvar(VAR_0x8001, 1)
    special(CheckStarlightEE)

    if (var(VAR_RESULT) == TRUE) {
        release
	end
    }

    addvar(VAR_BONUS_STARS, 1)
	release
	end
	}
	release
	end
}

