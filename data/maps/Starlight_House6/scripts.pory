mapscripts Starlight_House6_MapScripts {

MAP_SCRIPT_ON_TRANSITION {
		if(flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
			setflag(FLAG_TEMP_8)
        }
            if(flag(FLAG_CSR_CELIA_BONUS)) {
			setflag(FLAG_TEMP_8)
		}
        if(flag(FLAG_DAK_HERE)) {
			setflag(FLAG_TEMP_8)
		}
		
	}

}

script Starlight_House3_Commentary_Rusty {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"I am surprised Celia never made any\n"
	"references to Pokemon Rusty.\p"
	"either way I wanted to put this\n"
	"reference in lol.", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Cutscene {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"This was my first ever attempt at\n"
	"scripting a cutscene and I had some\l"
	"fun doing it! I caught on to it\l"
	"pretty quick because I had some\l"
	"experience with scripting\l"
	"cutscenes in SkyTemple, which is\l"
	"romhacking for Pokemon Mystery\l"
	"Dungeon Explorers of Sky.", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Frame {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"This framed DMCA joke was actually\n"
	"inspired by something Celia said.\l"
	"I one time asked her what would she\l"
	"do if she received a cease and\l"
	"desist letter from Nintendo asking\l"
	"to take the Romhack down.\l"
	"She answered with:\l"
	"If I get a C&D from Nintendo I'm\l"
	"framing it on my wall", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Map_Table {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"Idk why I added this table, I\n"
	"thought it would be kinda cool.", MSGBOX_NPC)
}

script Starlight_House3_Commentary_For_Outside {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"Celia didn't want me to put any map\n"
	"commentary out there so I feel in\l"
	"here is kind of a way to talk\l"
	"about a few things from other maps\l"
	"during my experience making them.", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Minnesota {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"Despite what Celia said about my\n"
	"early issues with big maps lol,\l"
	"I just wanted to make it accurate.\l"
	"and so I attempted to make the\l"
	"elevation, climate, and such accurate\l"
	"similarly to the real Minnesota.", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Porygons {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"Did you know I hid two Porygons on\n"
	"the Pokemon Island? It was the\l"
	"original method for obtaining the\l"
	"shiny, but that was changed.\p"
	"If you've played Pokemon Snap you\n"
	"might know where to look!", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Four_Island {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"Four Island was kind of fun to\n"
	"make. There's also a fun little\l"
	"flavored text I had the idea for\l"
	"if you attempt to talk to a\l"
	"certain npc.", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Cinnabar {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"With Cinnabar I did my best to make\n"
	"the destroyed version look like\l"
	"the island crashed into it.\p"
	"You can see dirt trails from the\n"
	"boulders that flew across the map.", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Fence_Maze {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"Thirty Eight Island was tough.\p"
	"The Water maze above though I am\n"
	"proud of that idea. It started\l"
	"with Celia wanting me to decorate\l"
	"the Great Sea and gave some ideas\l"
	"for decoration.\p"
	"One of the ideas was to place\n"
	"random fence islands around,\l"
	"then I had the idea to make an\l"
	"exact replica of the fence maze\l"
	"above but in the water.", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Favorite_Maps {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"Pirate Bay and the Desert above it\n"
	"are some of my favorite maps I've\l"
	"designed in this game!", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Sky_Tower {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"Sky Tower extending beyond Yes\n"
	"was my first ever idea when I\l"
	"became Celia's map designer.\p"
	"Literally within minutes of using\n"
	"Porymaps for her hack for the first\l"
	"time, I was screwing around and\l"
	"made that tower like that and\l"
	"thought it was funny so we kept it.", MSGBOX_NPC)
}

script Starlight_House3_Commentary_Dak {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"This is Dak.\n"
	"He is my Irl friend of 25 years\l"
	"so I wanted to honor him\l"
	"by putting him in this hack as\l"
	"a small cameo.\p"

	"I also am hoping that putting him\n"
	"in here will get him to try this\l"
	"romhack lol.\l"
	"He loves Yugioh, AVGN, Pokemon\l"
	"FireRed, humerous Romhacks,\l"
	"and so on.", MSGBOX_NPC)
}

//main room

script Script_Name {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"Hi!\p"

	"Celia suggested I put in some\n"
	"commentary here if I wanted to so\l"
	"I did!", MSGBOX_NPC)
}
















