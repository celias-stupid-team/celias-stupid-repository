raw `

	.byte 0

PokemonLeague_ChampionsRoom_OnResume::
	setvar VAR_0x8004, 4
	call PokemonLeague_EventScript_DoLightingEffect
	call_if_eq VAR_STARTER_MON, 2, PokemonLeague_ChampionsRoom_EventScript_CheckStopTriggerSquirtle
	call_if_eq VAR_STARTER_MON, 1, PokemonLeague_ChampionsRoom_EventScript_CheckStopTriggerBulbasaur
	call_if_eq VAR_STARTER_MON, 0, PokemonLeague_ChampionsRoom_EventScript_CheckStopTriggerCharmander
	end

PokemonLeague_ChampionsRoom_EventScript_CheckStopTriggerSquirtle::
	return

PokemonLeague_ChampionsRoom_EventScript_CheckStopTriggerBulbasaur::
	return

PokemonLeague_ChampionsRoom_EventScript_CheckStopTriggerCharmander::
	return

PokemonLeague_ChampionsRoom_EventScript_StopSceneTrigger::
	setvar VAR_TEMP_1, 1
	return

PokemonLeague_ChampionsRoom_OnWarp::
	map_script_2 VAR_TEMP_1, 0, PokemonLeague_ChampionsRoom_EventScript_TurnPlayerNorth
	.2byte 0



PokemonLeague_ChampionsRoom_OnFrame::
	map_script_2 VAR_TEMP_1, 0, PokemonLeague_ChampionsRoom_EventScript_EnterRoom
	.2byte 0


PokemonLeague_ChampionsRoom_EventScript_QuestLogEnd::
	call PokemonLeague_ChampionsRoom_EventScript_StopSceneTrigger
	releaseall
	end

PokemonLeague_ChampionsRoom_EventScript_Battle::
	call_if_eq VAR_STARTER_MON, 2, PokemonLeague_ChampionsRoom_EventScript_BattleSquirtle
	call_if_eq VAR_STARTER_MON, 1, PokemonLeague_ChampionsRoom_EventScript_BattleBulbasaur
	call_if_eq VAR_STARTER_MON, 0, PokemonLeague_ChampionsRoom_EventScript_BattleCharmander
	return

PokemonLeague_ChampionsRoom_EventScript_Rematch::
	call_if_eq VAR_STARTER_MON, 2, PokemonLeague_ChampionsRoom_EventScript_RematchSquirtle
	call_if_eq VAR_STARTER_MON, 1, PokemonLeague_ChampionsRoom_EventScript_RematchBulbasaur
	call_if_eq VAR_STARTER_MON, 0, PokemonLeague_ChampionsRoom_EventScript_RematchCharmander
	return

PokemonLeague_ChampionsRoom_EventScript_Intro::
	msgbox PokemonLeague_ChampionsRoom_Text_Intro
	return

PokemonLeague_ChampionsRoom_EventScript_RematchIntro::
	msgbox PokemonLeague_ChampionsRoom_Text_RematchIntro
	return

PokemonLeague_ChampionsRoom_EventScript_BattleSquirtle::
	trainerbattle_no_intro TRAINER_CHAMPION_FIRST_SQUIRTLE, PokemonLeague_ChampionsRoom_Text_Defeat
	return

PokemonLeague_ChampionsRoom_EventScript_BattleBulbasaur::
	trainerbattle_no_intro TRAINER_CHAMPION_FIRST_BULBASAUR, PokemonLeague_ChampionsRoom_Text_Defeat
	return

PokemonLeague_ChampionsRoom_EventScript_BattleCharmander::
	trainerbattle_no_intro TRAINER_CHAMPION_FIRST_CHARMANDER, PokemonLeague_ChampionsRoom_Text_Defeat
	return

PokemonLeague_ChampionsRoom_EventScript_RematchSquirtle::
	trainerbattle_no_intro TRAINER_CHAMPION_REMATCH_SQUIRTLE, PokemonLeague_ChampionsRoom_Text_Defeat
	return

PokemonLeague_ChampionsRoom_EventScript_RematchBulbasaur::
	trainerbattle_no_intro TRAINER_CHAMPION_REMATCH_BULBASAUR, PokemonLeague_ChampionsRoom_Text_Defeat
	return

PokemonLeague_ChampionsRoom_EventScript_RematchCharmander::
	trainerbattle_no_intro TRAINER_CHAMPION_REMATCH_CHARMANDER, PokemonLeague_ChampionsRoom_Text_Defeat
	return

PokemonLeague_ChampionsRoom_Movement_PlayerEnter::
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	step_end

PokemonLeague_ChampionsRoom_Movement_PlayerExit::
	delay_16
	walk_left
	walk_up
	walk_up
	walk_up
	walk_right
	walk_up
	walk_up
	walk_up
	walk_up
	delay_8
	set_invisible
	step_end

PokemonLeague_ChampionsRoom_Movement_PlayerWatchOakEnter::
	delay_8
	walk_in_place_faster_down
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	walk_in_place_faster_left
	step_end

PokemonLeague_ChampionsRoom_Movement_OakEnter::
	delay_16
	delay_16
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	walk_left
	walk_up
	walk_up
	walk_in_place_faster_down
	delay_16
	step_end

PokemonLeague_ChampionsRoom_Movement_OakExit::
	walk_up
	walk_up
	walk_right
	walk_up
	walk_up
	walk_up
	walk_up
	delay_8
	set_invisible
	step_end

PokemonLeague_ChampionsRoom_Movement_RivalWatchOakEnter::
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	walk_in_place_faster_left
	step_end
`

script PokemonLeague_ChampionsRoom_EventScript_TurnPlayerNorth {
	turnobject (LOCALID_PLAYER, DIR_NORTH)
	if(flag(FLAG_DEFEATED_FINAL_BOSS)) {
		setvar(VAR_TEMP_1, 0)
	}
	end
}

mapscripts PokemonLeague_ChampionsRoom_MapScripts {
	MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE: PokemonLeague_ChampionsRoom_OnWarp
	MAP_SCRIPT_ON_RESUME: PokemonLeague_ChampionsRoom_OnResume
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_TEMP_1, 0: PokemonLeague_ChampionsRoom_EventScript_EnterRoom
	]
}

script PokemonLeague_ChampionsRoom_EventScript_EnterRoom {
	lockall
	textcolor (NPC_TEXT_COLOR_MALE)
	if(flag(FLAG_DEFEATED_FINAL_BOSS)) {
		clearflag(FLAG_DEFEATED_FINAL_BOSS)
		goto(PokemonLeagueChampionsRoom_FinishedBattle)
	}
	setflag (FLAG_TEMP_2)
	applymovement (LOCALID_PLAYER, PokemonLeague_ChampionsRoom_Movement_PlayerEnter)
	waitmovement (0)
	delay (45)
	msgbox(
	"GARY: Hey, {PLAYER}!\p"

	"I was looking forward to seeing\n"
	"you again.\l"
	"It's been a minute.", MSGBOX_DEFAULT)
	closemessage
	delay(10)
	applymovement(LOCALID_CHAMPIONS_ROOM_LARRY, moves(
		walk_in_place_down * 2
		face_down
	))
	waitmovement(LOCALID_CHAMPIONS_ROOM_LARRY)
	delay(20)
	msgbox(
	"LARRY: I remember when you were\n"
	"just some kid on the road.\l"
	"You took down my ZAPDOS all alone.", MSGBOX_DEFAULT)
	closemessage
	
	delay(10)
	applymovement(LOCALID_CHAMPIONS_ROOM_JERRY, moves(
		walk_in_place_down * 2
		face_down
	))
	waitmovement(LOCALID_CHAMPIONS_ROOM_JERRY)
	delay(20)
	msgbox(
	"JERRY: But ever since we met up,\n"
	"we've all made some new friends.\p"

	"And all of us have one thing in\n"
	"common:\l"
	"A vendetta against you.", MSGBOX_DEFAULT)
	closemessage

	
	delay(10)
	applymovement(LOCALID_CHAMPIONS_ROOM_HARRY, moves(
		walk_in_place_down * 2
		face_down
	))
	waitmovement(LOCALID_CHAMPIONS_ROOM_HARRY)
	delay(20)
	msgbox(
	"HARRY: When my rat got killed,{PAUSE 20}\n"
	"you just stood there and watched.", MSGBOX_DEFAULT)
	closemessage

	
	delay(10)
	applymovement(LOCALID_CHAMPIONS_ROOM_LARRY_2, moves(
		walk_in_place_down * 2
		face_down
	))
	waitmovement(LOCALID_CHAMPIONS_ROOM_LARRY_2)
	delay(30)
	msgbox(
	"LARRY: You mildly inconvenienced\n"
	"me during my workday.", MSGBOX_DEFAULT)
	closemessage

	
	delay(10)
	applymovement(LOCALID_CHAMPIONS_ROOM_MARY, moves(
		walk_in_place_down * 2
		face_down
	))
	waitmovement(LOCALID_CHAMPIONS_ROOM_MARY)
	delay(20)
	msgbox(
	"PERRY: And I'll never forget what\n"
	"you did to me!", MSGBOX_DEFAULT)
	closemessage
	delay(10)
	applymovement(LOCALID_CHAMPIONS_ROOM_RIVAL, moves(
		walk_slow_down
		face_down
	))
	waitmovement(LOCALID_CHAMPIONS_ROOM_RIVAL)
	delay(20)
	message(
	"GARY: That's it!\p"

	"If you think you're CHAMPION\n"
	"material…")
	waitmessage
	fadenewbgm(MUS_NONE)
	delay(120)
	msgbox(
	"…{PAUSE 30}Then come here and prove it!\p"

	"Everyone!\n"
	"Let's go!", MSGBOX_DEFAULT)



	goto_if_questlog (PokemonLeague_ChampionsRoom_EventScript_QuestLogEnd)
	setflag (FLAG_TEMP_3)
	setflag (FLAG_TEMP_5)
	savebgm (MUS_VICTORY_GYM_LEADER)
	setvar(VAR_TEMP_1, 2)
	
	warpsilent(MAP_FINAL_BOSS_CUTSCENE, 0)
	//trainerbattle_no_intro(TRAINER_CHAMPION_FIRST_CHARMANDER, "i lose") Here's the actual fight, dummied out right now
	release

}


script PokemonLeagueChampionsRoom_FinishedBattle {
	lockall
	applymovement(LOCALID_PLAYER, moves(
		face_up
	))
	special(DrawWholeMapView)
	textcolor (NPC_TEXT_COLOR_MALE)
	setflag (FLAG_TEMP_2)
	setflag (FLAG_TEMP_3)
	setflag (FLAG_TEMP_5)
	setflag (FLAG_TEMP_4)
	clearflag (FLAG_TEMP_5)
	setflag (FLAG_DEFEATED_CHAMP)
	setflag (FLAG_TEMP_4)
	msgbox (PokemonLeague_ChampionsRoom_Text_PostBattle)
	addobject (LOCALID_CHAMPIONS_ROOM_PROF_OAK)
	fadenewbgm(MUS_NONE)
	applymovement (LOCALID_CHAMPIONS_ROOM_PROF_OAK, moves(
		delay_16 * 2
		walk_up * 8
		face_right
		delay_16 * 2
	))
	waitmovement(0)
	closemessage
	playse(SE_EFFECTIVE)
	applymovement(LOCALID_CHAMPIONS_ROOM_RIVAL, moves(
		face_left
		lock_facing_direction
		slide_right * 8
	))
	applymovement (LOCALID_CHAMPIONS_ROOM_PROF_OAK, moves(
		walk_right
		delay_16 * 4
		walk_down
		face_down
	))
	delay(10)
	playse(SE_FALL)
	waitmovement(LOCALID_CHAMPIONS_ROOM_RIVAL)
	waitmovement(LOCALID_CHAMPIONS_ROOM_PROF_OAK)
	
	delay (25)
	waitse
	playbgm (MUS_SLOW_PALLET, TRUE)
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"Hiya, {PLAYER}.\n"
	"It's me, CELIA.\p"

	"You've done it!\n"
	"That was your final trial!\p"

	"You navigated all my roadblocks;{PAUSE 10}\n"
	"you took on all my challenges…\p"

	"You've come so far.{PAUSE 30}\n"
	"You should be proud of yourself.\p"

	"And all those times I bullied you,{PAUSE 20}\n"
	"I did so I could build you up.\l"
	"I hope you can understand.\p"

	"Now, come along!{PAUSE 20}\n"
	"It's time to see the end.", MSGBOX_DEFAULT)
	closemessage
	applymovement (LOCALID_CHAMPIONS_ROOM_PROF_OAK, moves(
		walk_slow_left
		walk_slow_down
		face_up
		delay_16 * 2
	))
	waitmovement(LOCALID_CHAMPIONS_ROOM_PROF_OAK)
	applymovement (LOCALID_CHAMPIONS_ROOM_PROF_OAK, moves(
		walk_slow_up * 4
		face_right
	))
	applymovement (LOCALID_PLAYER, moves(
		walk_slow_up * 6
		face_up
		delay_8
		face_up
		delay_16 * 2
		face_down

	))
	applymovement(LOCALID_CHAMPIONS_ROOM_HARRY, moves(
		delay_16 * 1
		delay_8
		emote_exclamation_mark
		delay_16 * 2
		walk_fast_right * 2
		face_left
	))
	applymovement(LOCALID_CHAMPIONS_ROOM_LARRY, moves(
		delay_16
		delay_8
		face_right
	))
	applymovement(LOCALID_CHAMPIONS_ROOM_JERRY, moves(
		delay_16
		delay_8
		face_left
	))
	applymovement(LOCALID_CHAMPIONS_ROOM_LARRY_2, moves(
		delay_16 * 3
		delay_8
		face_right
	))
	applymovement(LOCALID_CHAMPIONS_ROOM_MARY, moves(
		delay_16 * 3
		delay_8
		face_left
	))
	waitmovement (LOCALID_PLAYER)
	delay(30)
	applymovement(LOCALID_CHAMPIONS_ROOM_PROF_OAK, moves(
		walk_right
		face_up
		delay_16
		walk_in_place_up * 2
		face_up
	))
	waitmovement (LOCALID_CHAMPIONS_ROOM_PROF_OAK)
	delay(30)
	applymovement(LOCALID_PLAYER, moves(
		face_up
		delay_16 * 3
		walk_up
	))
	waitmovement(LOCALID_PLAYER)
	setvar(VAR_TEMP_1, 2)
	warp(MAP_POKEMON_LEAGUE_HALL_OF_FAME, 5, 12)
	waitstate
	releaseall
}