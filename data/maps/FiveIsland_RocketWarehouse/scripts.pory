raw `
.equ PLAYER_X_POS, VAR_0x8004
.equ PLAYER_Y_POS, VAR_0x8005

FiveIsland_RocketWarehouse_MapScripts::
	map_script MAP_SCRIPT_ON_LOAD, FiveIsland_RocketWarehouse_OnLoad
	map_script MAP_SCRIPT_ON_TRANSITION, FiveIsland_RocketWarehouse_OnTransition
	.byte 0

FiveIsland_RocketWarehouse_OnTransition::
	setworldmapflag FLAG_WORLD_MAP_FIVE_ISLAND_ROCKET_WAREHOUSE
	end

FiveIsland_RocketWarehouse_OnLoad::
	setrespawn HEAL_LOCATION_FIVE_ISLAND_ROCKET_WAREHOUSE
	end

FiveIsland_RocketWarehouse_EventScript_SetArrowsForReEntry::
	setmetatile 26, 20, METATILE_SilphCo_Arrow_Up, 0
	setmetatile 27, 20, METATILE_SilphCo_Arrow_Up, 0
	return

FiveIsland_RocketWarehouse_EventScript_Cage::
	lockall
	goto_if_set FLAG_DEFEATED_ROCKETS_IN_WAREHOUSE, FiveIsland_RocketWarehouse_EventScript_CageUnlocked
	msgbox FiveIsland_RocketWarehouse_Text_ManyMonsLockedInPen
	releaseall
	end

FiveIsland_RocketWarehouse_EventScript_CageUnlocked::
	msgbox FiveIsland_RocketWarehouse_Text_PenUnlockedMonsFled
	releaseall
	end

FiveIsland_RocketWarehouse_EventScript_Computer::
	msgbox FiveIsland_RocketWarehouse_Text_ReportWithGraphsAndText, MSGBOX_SIGN
	end

FiveIsland_RocketWarehouse_EventScript_Admin2Trigger::
	lockall
	applymovement LOCALID_WAREHOUSE_ADMIN2, Common_Movement_WalkInPlaceFasterLeft
	waitmovement 0
	releaseall
	end

FiveIsland_RocketWarehouse_EventScript_Gideon::
	trainerbattle_single TRAINER_SCIENTIST_GIDEON, FiveIsland_RocketWarehouse_Text_GideonIntro, FiveIsland_RocketWarehouse_Text_GideonDefeat, FiveIsland_RocketWarehouse_EventScript_DefeatedGideon
	goto_if_set FLAG_SYS_CAN_LINK_WITH_RS, FiveIsland_RocketWarehouse_EventScript_MentionGiovannisKid
	msgbox FiveIsland_RocketWarehouse_Text_GetLostLeaveMeBe, MSGBOX_AUTOCLOSE
	end

FiveIsland_RocketWarehouse_EventScript_MentionGiovannisKid::
	msgbox FiveIsland_RocketWarehouse_Text_GiovannisKidHasRedHair, MSGBOX_AUTOCLOSE
	end

FiveIsland_RocketWarehouse_EventScript_DefeatedGideon::
	msgbox FiveIsland_RocketWarehouse_Text_GideonPostBattle
	setflag FLAG_RECOVERED_SAPPHIRE
	giveitem ITEM_SAPPHIRE
	release
	end

FiveIsland_RocketWarehouse_EventScript_Grunt2::
	trainerbattle_single TRAINER_DMCA_GRUNT_47, FiveIsland_RocketWarehouse_Text_Grunt2Intro, FiveIsland_RocketWarehouse_Text_Grunt2Defeat
	msgbox FiveIsland_RocketWarehouse_Text_Grunt2PostBattle, MSGBOX_AUTOCLOSE
	end

FiveIsland_RocketWarehouse_EventScript_Grunt3::
	trainerbattle_single TRAINER_DMCA_QW, FiveIsland_RocketWarehouse_Text_Grunt3Intro, FiveIsland_RocketWarehouse_Text_Grunt3Defeat
	msgbox FiveIsland_RocketWarehouse_Text_Grunt3PostBattle, MSGBOX_AUTOCLOSE
	end

FiveIsland_RocketWarehouse_EventScript_Admin2::
	trainerbattle_single TRAINER_TEAM_ROCKET_ADMIN, FiveIsland_RocketWarehouse_Text_Admin2Intro, FiveIsland_RocketWarehouse_Text_Admin2Defeat
	msgbox FiveIsland_RocketWarehouse_Text_Admin2PostBattle, MSGBOX_AUTOCLOSE
	end

FiveIsland_RocketWarehouse_EventScript_DefeatedAdmin2::
	getplayerxy PLAYER_X_POS, PLAYER_Y_POS
	call_if_le PLAYER_X_POS, 24, FiveIsland_RocketWarehouse_EventScript_PlayerFaceAdmin2
	msgbox FiveIsland_RocketWarehouse_Text_Admin2PostBattle
	closemessage
	fadescreen FADE_TO_BLACK
	removeobject LOCALID_WAREHOUSE_GRUNT2
	removeobject LOCALID_WAREHOUSE_GRUNT3
	removeobject LOCALID_WAREHOUSE_ADMIN2
	removeobject LOCALID_WAREHOUSE_ADMIN1
	setflag FLAG_HIDE_FIVE_ISLAND_ROCKETS
	fadescreen FADE_FROM_BLACK
	setflag FLAG_DEFEATED_ROCKETS_IN_WAREHOUSE
	release
	end

FiveIsland_RocketWarehouse_EventScript_PlayerFaceAdmin2::
	applymovement LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterRight
	waitmovement 0
	return

FiveIsland_RocketWarehouse_EventScript_Grunt1::
	trainerbattle_single TRAINER_DMCA_GRUNT_42, FiveIsland_RocketWarehouse_Text_Grunt1Intro, FiveIsland_RocketWarehouse_Text_Grunt1Defeat
	msgbox FiveIsland_RocketWarehouse_Text_Grunt1PostBattle, MSGBOX_AUTOCLOSE
	end

FiveIsland_RocketWarehouse_EventScript_Admin1::
	trainerbattle_single TRAINER_TEAM_ROCKET_ADMIN, FiveIsland_RocketWarehouse_Text_Admin1Intro, FiveIsland_RocketWarehouse_Text_Admin1Defeat, FiveIsland_RocketWarehouse_EventScript_DefeatedAdmin1
	msgbox FiveIsland_RocketWarehouse_Text_MadeItSoYouCanComeBackThrough, MSGBOX_AUTOCLOSE
	end

FiveIsland_RocketWarehouse_EventScript_DefeatedAdmin1::
	getplayerxy PLAYER_X_POS, PLAYER_Y_POS
	specialvar VAR_RESULT, GetPlayerFacingDirection
	call_if_eq VAR_RESULT, DIR_NORTH, FiveIsland_RocketWarehouse_EventScript_PlayerFaceAdmin1
	msgbox FiveIsland_RocketWarehouse_Text_Admin1PostBattle
	closemessage
	call_if_le PLAYER_X_POS, 24, FiveIsland_RocketWarehouse_EventScript_AdminWalkToSwitchFar
	call_if_eq PLAYER_X_POS, 25, FiveIsland_RocketWarehouse_EventScript_AdminWalkToSwitch
	call_if_eq PLAYER_X_POS, 26, FiveIsland_RocketWarehouse_EventScript_AdminFaceSwitch
	call_if_eq PLAYER_X_POS, 27, FiveIsland_RocketWarehouse_EventScript_AdminFaceSwitch
	playse SE_PIN
	call FiveIsland_RocketWarehouse_EventScript_SetArrowsForReEntry
	special DrawWholeMapView
	waitse
	call_if_le PLAYER_X_POS, 24, FiveIsland_RocketWarehouse_EventScript_AdminFacePlayerLeft
	call_if_eq PLAYER_X_POS, 25, FiveIsland_RocketWarehouse_EventScript_AdminFacePlayerLeft
	call_if_eq PLAYER_X_POS, 26, FiveIsland_RocketWarehouse_EventScript_AdminFacePlayerLeft
	call_if_eq PLAYER_X_POS, 27, FiveIsland_RocketWarehouse_EventScript_AdminFacePlayerDown
	msgbox FiveIsland_RocketWarehouse_Text_MadeItSoYouCanComeBackThrough
	release
	end

FiveIsland_RocketWarehouse_EventScript_PlayerFaceAdmin1::
	goto_if_eq PLAYER_X_POS, 27, EventScript_Return
	applymovement LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterRight
	waitmovement 0
	return

FiveIsland_RocketWarehouse_EventScript_AdminWalkToSwitchFar::
	applymovement LOCALID_WAREHOUSE_ADMIN1, FiveIsland_RocketWarehouse_Movement_AdminWalkToSwitchFar
	waitmovement 0
	return

FiveIsland_RocketWarehouse_EventScript_AdminWalkToSwitch::
	applymovement LOCALID_WAREHOUSE_ADMIN1, FiveIsland_RocketWarehouse_Movement_AdminWalkToSwitch
	waitmovement 0
	return

FiveIsland_RocketWarehouse_EventScript_AdminFaceSwitch::
	applymovement LOCALID_WAREHOUSE_ADMIN1, Common_Movement_WalkInPlaceFasterUp
	waitmovement 0
	return

FiveIsland_RocketWarehouse_EventScript_AdminFacePlayerLeft::
	applymovement LOCALID_WAREHOUSE_ADMIN1, Common_Movement_WalkInPlaceFasterLeft
	waitmovement 0
	return

FiveIsland_RocketWarehouse_EventScript_AdminFacePlayerDown::
	applymovement LOCALID_WAREHOUSE_ADMIN1, Common_Movement_WalkInPlaceFasterDown
	waitmovement 0
	return

FiveIsland_RocketWarehouse_Movement_AdminWalkToSwitchFar::
	walk_right
	walk_right
	walk_in_place_faster_up
	step_end

FiveIsland_RocketWarehouse_Movement_AdminWalkToSwitch::
	walk_right
	walk_in_place_faster_up
	step_end
`


script DMCAWarehouse_LetterY {
	finditem(ITEM_LETTER_Y)
}

script DMCAWarehouse_LetterW {
	finditem(ITEM_LETTER_W)
}


script DMCAWarehouse_ThievulFight {
	lock
	faceplayer
	msgbox(FiveIsland_RocketWarehouse_Text_Admin1Intro)
	setvar(VAR_TEMP_START_EVENT_BATTLE, EVENT_BATTLE_THIEVUL)
	trainerbattle_no_intro(TRAINER_DMCA_THIEVUL, FiveIsland_RocketWarehouse_Text_Admin1Defeat)
	if(checkpartymon(SPECIES_VICTINI)) {
		goto(DMCAWarehouse_AdminLeaves)
	} else {
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		msgbox(
		"The THIE UL is inexplicably\n"
		"immune to every attack you have.\p"

		"You lose.\n"
		"", MSGBOX_DEFAULT)
		
        goto(EventScript_FieldWhiteOutNoMoney)
	}
	msgbox(FiveIsland_RocketWarehouse_Text_MadeItSoYouCanComeBackThrough, MSGBOX_AUTOCLOSE)
	end

}

script DMCAWarehouse_AdminLeaves {
	msgbox(
	"Grr…\n"
	"Fine!\p"

	"You wanna know about that LETTER\n"
	"we confiscated?\l"
	"Ha!\p"

	"We took it cuz it was infringing on\n"
	"the copyright of both E and I!\p"

	"Whatever. It's time that we, the\n"
	"DMCA, finally take our leave.", MSGBOX_DEFAULT)
	closemessage
	playse(SE_M_EXPLOSION)
	removeobject(VAR_LAST_TALKED)
	delay(30)
	release
}


script DMCAWarehouse_AZStory {
	lock
	faceplayer
	fadenewbgm(MUS_NONE)
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"AZ: Hm?\n"
	"A trainer?\p"

	"I've grown too old to simply let\n"
	"the world pass me by.\l"
	"Please, listen to my tragic tale.", MSGBOX_DEFAULT)
	playbgm(MUS_LEDER_SONG, FALSE)
	delay(30)
	msgbox(
	"A long time ago,{PAUSE 60} I killed a bunch\n"
	"of POKéMON.\p"

	"{PAUSE 30}This made me very sad.\n"
	"", MSGBOX_DEFAULT)
	closemessage
	playbgm(MUS_NONE, TRUE)
	delay(60)
	fadedefaultbgm
	release
}

script DMCAWarehouse_MirorB {
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"MIROR B: Heh…\n"
	"Looks like I got caught.\p"

	"The DMCA's been after everyone who\n"
	"has a letter in their name.\p"

	"I really can't get down to this…\n"
	"", MSGBOX_NPC)
}

script DMCAWarehouse_N {
	textcolor(NPC_TEXT_COLOR_BLUE)
	//famechecker(FAMECHECKER_GREAT_BAY, 5)
	msgbox(
	"N: The DMCA has taken me hostage…\n"
	"It's such a shame.\p"

	"There's another letter being held\n"
	"here too.\l"
	"The one you've been seeking.\p"

	"Their POKéMON seems invincible.\n"
	"I wonder if you will get through…", MSGBOX_NPC)
}


script DMCAWarehouse_GrandpaWoman {
	msgbox(
	"Oh no!\n"
	"Grandpa's dad!", MSGBOX_NPC)
}

script DMCAWarehouse_Ass {
	msgbox(
	"ASS: Hey!{PAUSE 30}\n"
	"Don't ook at me!", MSGBOX_NPC)
}


script DMCAWarehouse_GrnadpaDad {
	lock
	faceplayer
	textcolor(0)
	msgbox(
	"Grandpa: Hmm? Who are you?\n"
	"What are you doing here?\p"

	"Well, never mind.\n"
	"I think I'm due for a rest.", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}


script DMCAWarehouse_Qbert {
	lock
	waitse
	playmoncry(SPECIES_JIGGLYPUFF, CRY_MODE_DEFAULT)
	applymovement(VAR_LAST_TALKED, moves(
		face_left
		delay_16 * 3
		face_up
	))
	waitmovement(0)
	waitmoncry
	delay(45)
	applymovement(VAR_LAST_TALKED, moves(
		face_down
	))
	waitmovement(0)
	special(DrawWholeMapView)
	release
}

script DMCAWarehouse_Polio {
	lock
	faceplayer
	if(checkitem(ITEM_PP_MAX) || flag(FLAG_TEMP_8)) {
		removeitem(ITEM_PP_MAX)
		setflag(FLAG_TEMP_8)
		playmoncry(SPECIES_POPPLIO, CRY_MODE_DEFAULT)
		msgbox(
		"POPP PLIO: Pla-plaaah!\n"
		"", MSGBOX_DEFAULT)
		waitmoncry
		closemessage
		delay(10)
		msgbox(
		"Hey!\n"
		"POLIO took your PP P!", MSGBOX_DEFAULT)
		release
		end

	} else {
		playmoncry(SPECIES_POPPLIO, CRY_MODE_DEFAULT)
		msgbox(
		"POLIO: Pla-plaaah!\n"
		"", MSGBOX_DEFAULT)
		waitmoncry
		closemessage
		delay(10)
		msgbox(
		"POLIO's PP dropped!\n"
		"", MSGBOX_DEFAULT)
		release
		end

	}
}

script DMCAWarehouse_Reactor {
	lock
	if(flag(FLAG_TEMP_3)) {
		
		msgbox(
		"Oh, shoot!\n"
		"The lights went out.", MSGBOX_DEFAULT)
		release
		end
	}
	msgbox(
	"“It is not wisdom but Authority\n"
	"that makes a law.”", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	msgbox(
	"It appears to be a HOBB-ist\n"
	"nuclear reactor.", MSGBOX_DEFAULT)
	closemessage
	delay(45)
	msgbox(
	"“Now I am about to take my last\n"
	"voyage,{PAUSE 20} a great leap in the dark.”", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	setweather(WEATHER_SHADE)
	playse(SE_CLICK)
	doweather
	delay(60)
	setflag(FLAG_TEMP_3)
	release

	

}

script DMCAWarehouse_Martphone {
	lock
	msgbox(
	"It's a wall-mounted martphone.\n"
	"", MSGBOX_DEFAULT)
	pokemart(WarehouseMart)
	msgbox(
	"{PLAYER} hung up.\n"
	"", MSGBOX_DEFAULT)
	release
	end
}

 mart WarehouseMart {
	ITEM_NEST_BALL
	ITEM_X_ATTACK
	ITEM_X_DEFEND
	ITEM_RARE_ANDY
	ITEM_PP_MAX
	ITEM_NONE
 }


 script DMCAWarehouse_NotOak {
	msgbox(
	"Hat's not OAK, silly!\n"
	"", MSGBOX_NPC)

}

script Warehouse_Earrat {
	lock
	showmonpic(SPECIES_EARRAT, 10, 3)
	waitbuttonpress
	hidemonpic
	release
	end
}

script Warehouse_PlatoClosetSign {
	msgbox(
	"PLATO's CLOSET\n"
	"", MSGBOX_SIGN)
}

script Warehouse_FavoriteShit {
	msgbox(
	"Twelve identical copies of your\n"
	"favorite shit.", MSGBOX_SIGN)

}


script Warehouse_PlatoCameo {
	if(checktrainerflag(TRAINER_PLASTO)) {
		textcolor(NPC_TEXT_COLOR_BLUE)
		msgbox(
		"PLATO: Dan is Celia's deadname.\n"
		"", MSGBOX_NPC)
		end
		
	}
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"Every heart sing a song, incomplete\n"
	"until another heart whispers back.\p"

	"Those who wish to sing always find\n"
	"a song.\p"

	"At the touch of a lover, everyone\n"
	"becomes a pot.\p"

	"Only the dad have seen the end of\n"
	"war.\p"

	"Those who are able to see beyond the\n"
	"shadows and lies of their culture\l"
	"will never be understood, let alone\l"
	"believed, by the asses.\p"

	"According to Geek mythology, humans\n"
	"were-\l"
	"okay fuck this bit let's just fight\l"
	"(this is going into the fight)", MSGBOX_DEFAULT)
	trainerbattle_no_intro(TRAINER_PLASTO, "Dan.")
	msgbox(
	"PLATO: Honestly?\n"
	"I'm really happy to be here.\p"

	"This project is probably the most\n"
	"fun I've had with any Pokemon\l"
	"related media, and that's saying\l"
	"something!\p"

	"I may not have done any of the code\n"
	"or contributed much artwise, but\l"
	"I can't help but feel a bit of pride\l"
	"knowing my name is attached to what\l"
	"is OBJECTIVELY the best Pokemon\l"
	"game ever created.\p"

	"Anyway sorry for yapping\n"
	"here's your prize", MSGBOX_DEFAULT)
	setflag(FLAG_SHINY_CREATION)
	setvar(VAR_CSR_GIFT_POKEMON, SPECIES_PINSIR)
	playfanfare(MUS_LEVEL_UP)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox(
	"{PLAYER} got a fancy PINSIR!\n"
	"", MSGBOX_DEFAULT)
	call(Common_Script_GiftPinsir)
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"PLASTO: We didn't like the original\n"
	"shiny pinsir bit, so we stuck it\l"
	"here instead.", MSGBOX_DEFAULT)
	
	release
	end
}



script Warehouse_PlastoSign {
	lock
	msgbox(
	"Totals wave.\n"
	"On Ruth, the old.", MSGBOX_DEFAULT)
	if(checkpartymon(SPECIES_ESPEON) && checkpartymove(MOVE_IRON_TAILS) != PARTY_SIZE) {
		closemessage
		delay(20)
		playse(SE_CLICK)
		setlayouttiles(LAYOUT_FIVE_ISLAND_LOST_CAVE_ROOM2_CLOSET, 0,0,0,0,10, 18)
		setmaplayoutindex(LAYOUT_FIVE_ISLAND_LOST_CAVE_ROOM2_CLOSET)
	}
	release
	end

}


script Common_Script_GiftPinsir {
	copyvar(VAR_TEMP_1, VAR_CSR_GIFT_POKEMON)
	givemon(VAR_CSR_GIFT_POKEMON, 30, ITEM_TM15)
	clearflag(FLAG_SHINY_CREATION)
	switch(var(VAR_RESULT)) {
		case 0: //Mon goes to party
			bufferspeciesname(STR_VAR_1, VAR_CSR_GIFT_POKEMON)
			msgbox(Text_GiveNicknameToThisMon, MSGBOX_YESNO)
			if(!var(VAR_RESULT)) {
				return
			}
			call(EventScript_GetGiftMonPartySlot)
			call(EventScript_ChangePokemonNickname)
			return
		case 1: //Mon goes to PC
				bufferspeciesname(STR_VAR_1, VAR_CSR_GIFT_POKEMON)
				msgbox(Text_GiveNicknameToThisMon, MSGBOX_YESNO)
				if(var(VAR_RESULT) == 0) {
					call(EventScript_TransferredToPC)
					return
				} else {
					call(EventScript_NameReceivedBoxMon)
					call(EventScript_TransferredToPC)
					return //This can be simplified; I'll deal with it later
				}
				
				return
		case 2:
			goto(EventScript_NoMoreRoomForPokemon)
			break
	}
}
