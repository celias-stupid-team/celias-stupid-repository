const MEAN_GIRL = 2
mapscripts PokemonTower_Math_4_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if(!flag(FLAG_LIMIT_NOT_EXIST)) {
            setflag(FLAG_TEMP_1)
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_5, 0 { //Correct
            switch(var(VAR_POKEMONTOWER_ANSWER)) {
                case 0:
                    break
                case 1:
                    playse(SE_SUCCESS)
                    waitse
                    setvar(VAR_POKEMONTOWER_ANSWER, 0)
                    
                case 2:
                    playse(SE_BOO)
                    waitse
                    setvar(VAR_POKEMONTOWER_ANSWER, 0)
                    
            }
            
            setvar(VAR_TEMP_5, 1)
            release
            end
        }

    ]   
}


script PokemonTower_MathQuestion_Four {
	lock
	msgbox("lim(x{RIGHT_ARROW}0) (ln(1-x) - sin{SQUARED}(x)) /\n         (1 + cos{SQUARED}(x)) = ?\l{LEFT_ARROW} 1  {UP_ARROW} 0  {RIGHT_ARROW} Limit does not exist", MSGBOX_SIGN)
	release
}

script PokemonTower_MeanGirlsGirl {
	msgbox("Aww, man!\pI thought watching MEAN GIRLS would\nmake me an expert at calculus.\pGuess it takes a little more than\nthat…", MSGBOX_NPC)
	end
}

script PokemonTower_MathQuestions_LimitDoesntExist {
    setflag(FLAG_LIMIT_NOT_EXIST)
    release
}

script PokemonTower_MathQuestions_ImposterTwin {
    trainerbattle_double(TRAINER_CHANNELER_EMILIA, "KHAKI: Okay, JACKIE!\nYou sure you're ready for the quiz?\pJACKIE?: Um, hello yes!\nI am, uh, ready for a quiz! haha","INEZ: Oh, no!\nWe should've studied harder!", "You are insufficient.")
    msgbox("JACKIE?: Ah, I'm such a sap.\n", MSGBOX_DEFAULT)

}

script PokemonTower_MathQuestions_TrickedTwin {
    trainerbattle_double(TRAINER_CHANNELER_EMILIA, "KHAKI: Okay, JACKIE!\nYou sure you're ready for the quiz?\pJACKIE?: Um, hello yes!\nI am, uh, ready for a quiz! haha","KHAKI: Oh, no!\nWe were a digit off!", "You are insufficient.")
    msgbox("KHAKI: Hey, JACKIE…\nAre you sure you're doing okay?", MSGBOX_DEFAULT)
}


script PokemonTower_MathQuestions_MultiplyTwin {
    trainerbattle_double(TRAINER_CHANNELER_JANAE, "PLACEHOLDER","PLACEHOLDER", "You are insufficient.")
    msgbox("BEANIE: Our mommy loved math too!\pWhen we were born, she did some\nmultiplication!", MSGBOX_DEFAULT)

}

script PokemonTower_MathQuestions_DivideTwin {
    trainerbattle_double(TRAINER_CHANNELER_JANAE, "PLACEHOLDER","PLACEHOLDER", "You are insufficient.")
    msgbox("PRA: Oh yeah, Math!\nI love that one.\pEspecially because there's no\nletters in it!", MSGBOX_DEFAULT)
}