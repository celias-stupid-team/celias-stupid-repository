mapscripts Minnesota_House1_MapScripts {

}


script Minnesota_House1_Oak {
	msgbox(
	"Nope!\n"
	"Nothing but OAK!", MSGBOX_SIGN)

}

script Minnesota_SurgeTV {
	lock
	msgbox(
	"Hey! This episode was banned in\n"
	"this country!\l"
	"…{PAUSE 30}Let's watch!", MSGBOX_DEFAULT)
	closemessage
	delay(60)
	removemoney(999999)
	while(checkitem(ITEM_POKE_DOLL)) {
		removeitem(ITEM_POKE_DOLL, 1)
	}
	if(checkpartymon(SPECIES_PORYGON_Z)) {
		checkpartymonslot(SPECIES_PORYGON_Z)
		callnative(CurePorygonVirus)
	}
	warpsilent(MAP_MINNESOTA_HOSPITAL, 1)
	delay(30)
	release
}