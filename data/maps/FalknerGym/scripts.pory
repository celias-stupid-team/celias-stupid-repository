mapscripts FalknerGym_MapScripts {

}


script FalknerGym_TeamSkyGrunt1 {
    if(checktrainerflag(TRAINER_TEAM_SKY_1)) {
        setvar(VAR_TEMP_0, 1)
        release
        end
    } else {
        playbgm(MUS_ENCOUNTER_ROCKET, FALSE)
        applymovement(LOCALID_TEAMSKY_1, moves(
            emote_exclamation_mark
            delay_16 * 4
            walk_right * 1
            face_right
        ))
        waitmovement(0)
        setvar(VAR_TEMP_0, 1)
        delay(10)
        textcolor(NPC_TEXT_COLOR_TREE)
        msgbox("Fwahaha, behold!\nI am a member of TEAM SKY!\pWe're a nefarious organization\ndedicated to the expansion of AIR!\lNone shall stand in our way!\pSoon we shall accomplish our goal\nto shrink both the LAND and the SEA!", MSGBOX_DEFAULT)
        playbgm(MUS_GYM, TRUE)
        trainerbattle_no_intro(TRAINER_TEAM_SKY_1, "All life depends on air!\nOur cause is just and right!")
        release
        end
    }
}


script FalknerGym_TeamSkyGrunt2 {
    if(flag(FLAG_TEAM_SKY_FALLS_DOWN)) {
        setvar(VAR_TEMP_1, 1)
        release
        end
    } else {
        playbgm(MUS_ENCOUNTER_ROCKET, FALSE)
        applymovement(LOCALID_TEAMSKY_2, moves(
            emote_exclamation_mark
            delay_16 * 4
            walk_left * 2
            face_left
        ))
        waitmovement(0)
        delay(30)
        playbgm(MUS_NONE, TRUE)
        playse(SE_FALL)
        applymovement(LOCALID_TEAMSKY_2, moves(
            lock_facing_direction
            slide_down * 3
        ))
        waitmovement(0)
        delay(60)
        playse(SE_WALL_HIT)
        
        setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 4)
        setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 4)
        setvar(VAR_SHAKESCREEN_NUM_SHAKES, 5)
        setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
        special(ShakeScreen)
        setflag(FLAG_TEAM_SKY_FALLS_DOWN)
        setvar(VAR_TEMP_1, 1)
        delay(60)
        
        playbgm(MUS_GYM, TRUE)
        release
        end
    }
}

script FalknerGym_Falkner {
    lock
    faceplayer
    famechecker(FAMECHECKER_GREAT_SEA_WEST, 5)
    if(flag(FLAG_FOUGHT_FALKNER)) {
        if(flag(FLAG_OBTAINED_ZEPHYRBADGE)) {
            msgbox(
            "Perhaps…{PAUSE 30} evolving my PIDGEY\n"
            "wasn't actually a very good idea.", MSGBOX_DEFAULT)
            release
            end
        } elif (checkmoncaught(SPECIES_PIDGEY)) {
            msgbox(
            "You… You've done it.\n"
            "You found the great BIRD POKéMON.\p"

            "I was wrong to doubt you.\p"

            "Take this.\n"
            "You've earned it.", MSGBOX_DEFAULT)
            playfanfare(MUS_OBTAIN_BADGE)
            msgbox(
            "{PLAYER} obtained the\n"
            "FEATHERBADGE!", MSGBOX_DEFAULT)
            waitfanfare
            setflag(FLAG_OBTAINED_ZEPHYRBADGE)
            msgbox(
            "Perhaps…{PAUSE 30} evolving my PIDGEY\n"
            "wasn't actually a very good idea.", MSGBOX_DEFAULT)
            release
            end

        } else {
            
            msgbox(
            "Behind this GYM is a cave.\p"

            "This cave is the start to finding\n"
            "a BIRD POKéMON spoken in legends.\p"

            "Meet with this POKéMON, and I'll\n"
            "relent and admit defeat.", MSGBOX_DEFAULT)
            release
            end


        }
    }
    msgbox(
	"FALKNER: Hello, challenger!\n"
	"I am the leader of VIOLET CITY GYM.\p"

	"Some say that I am the weakest\n"
	"LEADER in POKéMON history.\p"

	"Pah!\n"
	"I won't allow such insults!\p"

	"I've finally found the secret to\n"
	"making my PKOéMON more powerful:\l"
	"Actually evolving them!", MSGBOX_DEFAULT)
    trainerbattle_no_intro(TRAINER_LEADER_FALKNER, "No!\n"
	"My father's precious BIRD POKéMON!\p"

	"He gave them to me with such care…\n"
	"I cannot believe that I lost!")

    msgbox(
	"FALKNER: No!\n"
	"I refuse to believe this!\p"

	"My father cherished these POKéMON\n"
	"before passing them on to me.\l"
	"I can't have lost so readily!\p"

	"Thus, I'll partake in the honored\n"
	"tradition of the JOHTO region:\l"
	"Not fucking giving you the BADGE.", MSGBOX_DEFAULT)
    closemessage
    delay(60)
    msgbox(
	"FALKNER: Ahem.\n"
	"Behind this GYM is a cave.\p"

	"This cave is the start to finding\n"
	"a BIRD POKéMON spoken in legends.\p"

	"Meet with this POKéMON, and I'll\n"
	"relent and admit defeat.", MSGBOX_DEFAULT)
    setflag(FLAG_FOUGHT_FALKNER)
    if(checkmoncaught(SPECIES_PIDGEY)) {
        msgbox(
        "…What!?\n"
        "You've already been to SKY TOWER?\p"

        "For pity's sake…\n"
        "But a deal is a deal.\l"
        "Take this.", MSGBOX_DEFAULT)
        playfanfare(MUS_OBTAIN_BADGE)
        msgbox(
        "{PLAYER} obtained the\n"
        "FEATHERBADGE!", MSGBOX_DEFAULT)
        waitfanfare
        setflag(FLAG_OBTAINED_ZEPHYRBADGE)
        msgbox(
        "Perhaps…{PAUSE 30} evolving my PIDGEY\n"
        "wasn't actually a very good idea.", MSGBOX_DEFAULT)
    }
    release
}