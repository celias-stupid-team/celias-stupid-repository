mapscripts FalknerGym_MapScripts {

}


script FalknerGym_TeamSkyGrunt1 {
    if(checktrainerflag(TRAINER_TEAM_SKY_1)) {
        setvar(VAR_TEMP_0, 1)
        release
        end
    } else {
        playbgm(MUS_ENCOUNTER_ROCKET, FALSE)
        applymovement(LOCALID_TEAMSKY_1, moves(
            emote_exclamation_mark
            delay_16 * 4
            walk_right * 1
            face_right
        ))
        waitmovement(0)
        setvar(VAR_TEMP_0, 1)
        delay(10)
        textcolor(NPC_TEXT_COLOR_TREE)
        msgbox("Fwahaha, behold!\nI am a member of TEAM SKY!\pWe're a nefarious organization\ndedicated to the expansion of AIR!\lNone shall stand in our way!\pSoon we shall accomplish our goal\nto shrink both the LAND and the SEA!", MSGBOX_DEFAULT)
        playbgm(MUS_GYM, TRUE)
        trainerbattle_no_intro(TRAINER_TEAM_SKY_1, "All life depends on air!\nOur cause is just and right!")
        release
        end
    }
}


script FalknerGym_TeamSkyGrunt2 {
    if(flag(FLAG_TEAM_SKY_FALLS_DOWN)) {
        setvar(VAR_TEMP_1, 1)
        release
        end
    } else {
        playbgm(MUS_ENCOUNTER_ROCKET, FALSE)
        applymovement(LOCALID_TEAMSKY_2, moves(
            emote_exclamation_mark
            delay_16 * 4
            walk_left * 2
            face_left
        ))
        waitmovement(0)
        delay(30)
        playbgm(MUS_NONE, TRUE)
        playse(SE_FALL)
        applymovement(LOCALID_TEAMSKY_2, moves(
            lock_facing_direction
            slide_down * 3
        ))
        waitmovement(0)
        delay(60)
        playse(SE_WALL_HIT)
        
        setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 4)
        setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 4)
        setvar(VAR_SHAKESCREEN_NUM_SHAKES, 5)
        setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
        special(ShakeScreen)
        setflag(FLAG_TEAM_SKY_FALLS_DOWN)
        setvar(VAR_TEMP_1, 1)
        delay(60)
        
        playbgm(MUS_GYM, TRUE)
        release
        end
    }
}

script FalknerGym_Falkner {
    lock
    faceplayer
    if(flag(FLAG_FOUGHT_FALKNER)) {
        if(flag(FLAG_OBTAINED_ZEPHYRBADGE)) {
            msgbox(
            "birds\n"
            "", MSGBOX_DEFAULT)
        } else {
            msgbox(
            "I refuse to believe this!\p"

            "Go to the cave behind the city.\n"
            "something something start a quest", MSGBOX_DEFAULT)


        }
    }
    msgbox(
	"FALKNER: words\p"

	"I've found the secret to making\n"
	"my POKéMON more powerful:\l"
	"Actually evolving them!", MSGBOX_DEFAULT)
    trainerbattle_no_intro(TRAINER_LEADER_FALKNER, "damn")
    msgbox(
	"I refuse to believe this!\p"

	"Go to the cave behind the city.\n"
	"something something start a quest", MSGBOX_DEFAULT)
    setflag(FLAG_FOUGHT_FALKNER)
    if(checkmoncaught(SPECIES_PIDGEY)) {
        msgbox(
        "Darn you did it already\n"
        "", MSGBOX_DEFAULT)
        playfanfare(MUS_OBTAIN_BADGE)
        msgbox(
        "{PLAYER} obtained the\n"
        "FEATHERBADGE!", MSGBOX_DEFAULT)
        waitfanfare
        setflag(FLAG_OBTAINED_ZEPHYRBADGE)
    }
    release
}