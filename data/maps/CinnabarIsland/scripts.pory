	msgbox(
	"Cinnabar Mart NPC 1\n"
	"", MSGBOX_NPC)
}


script CinnabarIsland_AbsolFisher {
	trainerbattle_single(
		TRAINER_ABSOL_FISHER, 
		"Whoa, there!\n"
		"Check out the POKéMON I fished up!",

		"Hoo, nelly!"
	)
	msgbox(
	"I KNOW ABSOL SUCKS ASS.{PAUSE 30}\n"
	"I KNOW THE OTHER ABSOL SUCKS ASS.\p"

	"I KNOW USING THEM PUTS ME AT A\n"
	"DISADVANTAGE FOR NO REASON AT ALL.\p"

	"I WILL NOT BE CHANGING THE SPECIES.\n"
	"I KNOW MY TEAM SUCKS ASS.\p"

	"I MIGHT CHANGE DRAGAPULT.\n"
	"AND ONLY DRAGAPULT.\p"

	"AND IF I CHANGE IT, I WILL PROBABLY\n"
	"CHANGE IT{PAUSE 30} TO ABSOL.", MSGBOX_NPC)
}


script CinnabarIsland_Camper {
	msgbox(
	"Say, wasn't there a MANSION here\n"
	"a minute ago?", MSGBOX_NPC)
}

script CinnabarIsland_BlueFridge {
	msgbox(
	"The BLUE fridge is full of BLUE\n"
	"cheese.\p"

	"There are no bodies.\n"
	"", MSGBOX_SIGN)

}


script CinnabarIsland_BlueBookshelf {
	lock
	msgbox(
	"Let's see if the BLUE bookshelf\n"
	"has anything interesting…", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(Text_Bookshelf)
	closemessage
	delay(60)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox(
	"Well, the text was blue.\n"
	"", MSGBOX_DEFAULT)
	release
}