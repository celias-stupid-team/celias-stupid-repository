raw `
.equ NUM_BOULDERS_PRESENT, VAR_TEMP_2



SeafoamIslands_B3F_OnTransition::
	call_if_unset FLAG_STOPPED_SEAFOAM_B3F_CURRENT, SeafoamIslands_B3F_EventScript_CheckStoppedCurrent
	end

SeafoamIslands_B3F_EventScript_CheckStoppedCurrent::
	setvar NUM_BOULDERS_PRESENT, 0
	call_if_unset FLAG_HIDE_SEAFOAM_B3F_BOULDER_1, SeafoamIslands_B3F_EventScript_AddBoulderPresent
	call_if_unset FLAG_HIDE_SEAFOAM_B3F_BOULDER_2, SeafoamIslands_B3F_EventScript_AddBoulderPresent
	call_if_eq NUM_BOULDERS_PRESENT, 2, SeafoamIslands_B3F_EventScript_StoppedCurrent
	return

SeafoamIslands_B3F_EventScript_StoppedCurrent::
	setflag FLAG_STOPPED_SEAFOAM_B3F_CURRENT
	return

SeafoamIslands_B3F_EventScript_SetNoCurrentLayout::
	setmaplayoutindex LAYOUT_SEAFOAM_ISLANDS_B3F_CURRENT_STOPPED
	return

SeafoamIslands_B3F_OnFrame::
	map_script_2 VAR_TEMP_1, 1, SeafoamIslands_B3F_EventScript_EnterByFalling
	.2byte 0

SeafoamIslands_B3F_EventScript_EnterByFalling::
	lockall
	setvar NUM_BOULDERS_PRESENT, 0
	call_if_unset FLAG_HIDE_SEAFOAM_B3F_BOULDER_1, SeafoamIslands_B3F_EventScript_AddBoulderPresent
	call_if_unset FLAG_HIDE_SEAFOAM_B3F_BOULDER_2, SeafoamIslands_B3F_EventScript_AddBoulderPresent
	goto_if_eq NUM_BOULDERS_PRESENT, 2, SeafoamIslands_B3F_EventScript_CurrentBlocked
	getplayerxy VAR_0x8008, VAR_0x8009
	call_if_lt VAR_0x8008, 24, SeafoamIslands_B3F_EventScript_RideCurrentFar
	call_if_ge VAR_0x8008, 24, SeafoamIslands_B3F_EventScript_RideCurrentClose
	warp MAP_SEAFOAM_ISLANDS_B4F, 27, 21
	waitstate
	releaseall
	end

SeafoamIslands_B3F_EventScript_AddBoulderPresent::
	addvar NUM_BOULDERS_PRESENT, 1
	return

SeafoamIslands_B3F_EventScript_RideCurrentFar::
	applymovement LOCALID_PLAYER, SeafoamIslands_B3F_Movement_RideCurrentFar
	waitmovement 0
	return

SeafoamIslands_B3F_EventScript_RideCurrentClose::
	applymovement LOCALID_PLAYER, SeafoamIslands_B3F_Movement_RideCurrentClose
	waitmovement 0
	return

SeafoamIslands_B3F_EventScript_CurrentBlocked::
	setvar VAR_TEMP_1, 0
	releaseall
	end

SeafoamIslands_B3F_Movement_RideCurrentFar::
	walk_fast_down
	walk_fast_down
	walk_fast_down
	walk_fast_down
	walk_fast_right
	walk_fast_right
	walk_fast_right
	walk_fast_down
	walk_fast_down
	walk_fast_down
	walk_fast_down
	walk_fast_down
	walk_fast_down
	step_end

SeafoamIslands_B3F_Movement_RideCurrentClose::
	walk_fast_down
	walk_fast_down
	walk_fast_down
	walk_fast_down
	walk_fast_right
	walk_fast_right
	walk_fast_down
	walk_fast_down
	walk_fast_down
	walk_fast_down
	walk_fast_down
	walk_fast_down
	step_end
`


mapscripts SeafoamIslands_B3F_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setflag(FLAG_TEMP_2)
		if(!flag(FLAG_CAPTAIN_DIRECTS_SPHEALS)) {
			setflag(FLAG_TEMP_1)
		}
	}
}

script SeafoamIslands_B3F_CaptainGetsTheSpheals {
	lock
	msgbox(
	"Ah, there we go.\n"
	"It seems the cave is just up there.", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	faceplayer
	delay(30)
	msgbox(
	"Thank you for getting me this far.\p"

	"I can take it from here.\n"
	"", MSGBOX_DEFAULT)
	closemessage
	specialvar(VAR_RESULT, GetPlayerFacingDirection)
	switch(var(VAR_RESULT)) {
		case DIR_NORTH:
			applymovement(LOCALID_PLAYER, moves(
				walk_slow_right
				walk_slow_up
				walk_slow_right
				face_left
			))
		case DIR_SOUTH:
			applymovement(LOCALID_PLAYER, moves(
				walk_slow_right
				walk_slow_down
				walk_slow_right
				face_left
			))
		case DIR_WEST:
			applymovement(LOCALID_PLAYER, moves(
				walk_slow_right
				face_left
			))
		case DIR_EAST:
			applymovement(LOCALID_PLAYER, moves(
				walk_slow_down
				walk_slow_right * 2
				walk_slow_up
				walk_slow_right
				face_left
			))
	}
	fadenewbgm(MUS_NONE)
	waitmovement(LOCALID_PLAYER)
	applymovement(LOCALID_B3F_CAPTAIN, moves(
		delay_16 * 3
		face_up
	))
	waitmovement(LOCALID_B3F_CAPTAIN)
	delay(30)
	msgbox(
	"My crew!\n"
	"{PAUSE 30}I let you down as your captain!\p"

	"But now it's time that I make it\n"
	"right!\l"
	"Fall in!", MSGBOX_DEFAULT)
	closemessage
	special(SpawnCameraObject)
	applymovement(LOCALID_B3F_CAPTAIN, moves(
		lock_facing_direction
		walk_slower_down
		face_up
		unlock_facing_direction
		delay_16 * 4
		walk_fast_up * 2
	))
	fadenewbgm(MUS_NONE)
	waitmovement(LOCALID_B3F_CAPTAIN)
	fadescreeninstant(FADE_TO_WHITE)
	playse(SE_LEDGE)
	applymovement(LOCALID_B3F_CAPTAIN, moves(
		jump_2_up
	))
	applymovement(LOCALID_CAMERA, moves(
		walk_fastest_up
	))
	applymovement(LOCALID_PLAYER, moves(
		face_up
	))
	waitmovement(LOCALID_CAMERA)
	
	fadescreeninstant(FADE_FROM_WHITE)
	waitmovement(LOCALID_B3F_CAPTAIN)
    setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 3)
    setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 3)
    setvar(VAR_SHAKESCREEN_NUM_SHAKES, 5)
    setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 3)
	special(ShakeScreen)
	delay(90)
	applymovement(LOCALID_B3F_CAPTAIN, moves(
		walk_right
		face_up
	))
	waitmovement(LOCALID_B3F_CAPTAIN)
	msgbox(
	"Wahaha!\p"

	"So that's where you rascals have\n"
	"been hiding!\p"

	"Come on, now!\n"
	"There's no time to play!", MSGBOX_DEFAULT)
	closemessage
	applymovement(LOCALID_B3F_CAPTAIN, moves(
		walk_up * 2
		delay_8
		set_invisible
	))
	waitmovement(LOCALID_B3F_CAPTAIN)
	playse(SE_EXIT)
	waitse
	delay(30)
	playmoncry(SPECIES_SPHEAL, CRY_MODE_DEFAULT)
	waitmoncry
	delay(20)
	playmoncry(SPECIES_SPHEAL, CRY_MODE_DEFAULT)
	waitmoncry
	playmoncry(SPECIES_SPHEAL, CRY_MODE_DEFAULT)
	waitmoncry
	delay(20)
	playse(SE_EXIT)
	playbgm(MUS_SEVII_ROUTE, TRUE)
	applymovement(LOCALID_B3F_CAPTAIN, moves(
		face_down
		set_visible
		delay_8
		walk_down
		delay_16 * 2
		walk_left
		face_right
	))
	waitmovement(LOCALID_B3F_CAPTAIN)
	applymovement(LOCALID_B3F_CAPTAIN, moves(
		delay_16
		delay_8
		walk_left
		walk_down
		face_right
	))
	applymovement(LOCALID_SPHEAL_LAND_1, moves(
		set_visible
		delay_8
		walk_down
		walk_left
		walk_down
	))
	waitmovement(LOCALID_SPHEAL_LAND_1)
	playse(SE_LEDGE)
	applymovement(LOCALID_SPHEAL_LAND_1, moves(
		jump_2_down
		delay_8
		walk_down
		walk_left
		jump_2_down
		walk_down * 3
		walk_left * 2

	))
	applymovement(LOCALID_B3F_CAPTAIN, moves(
		delay_16 * 4
		jump_2_down
		delay_16 * 3
		walk_down
		walk_left
		walk_down
		jump_2_down
		delay_8
		walk_down
		face_right

		
	))
	
	applymovement(LOCALID_CAMERA, moves(
		delay_16 * 3
		walk_slow_down * 3
		walk_slow_left * 2
		delay_16 * 5
		walk_slow_down * 2
	))
	applymovement(LOCALID_PLAYER, moves(
		delay_16 * 2
		face_left
	))
	
	applymovement(LOCALID_SPHEAL_LAND_2, moves(
		set_visible
		delay_8
		walk_down
		walk_left
		walk_down
	))
	waitmovement(LOCALID_SPHEAL_LAND_2)
	playse(SE_LEDGE)
	applymovement(LOCALID_SPHEAL_LAND_2, moves(
		jump_2_down
		delay_8
		walk_down * 2
		jump_2_down
		walk_down * 2
		walk_left

	))
	applymovement(LOCALID_SPHEAL_LAND_3, moves(
		set_visible
		delay_8
		walk_down
		walk_left
		walk_down
	))
	waitmovement(LOCALID_SPHEAL_LAND_3)
	playse(SE_LEDGE)
	applymovement(LOCALID_SPHEAL_LAND_3, moves(
		jump_2_down
		delay_8
		walk_down * 2
		jump_2_down
		walk_down * 2
		walk_right
		walk_down
		face_left

	))
	applymovement(LOCALID_SPHEAL_LAND_4, moves(
		set_visible
		delay_8
		walk_down
		walk_left
		walk_down
	))
	waitmovement(LOCALID_SPHEAL_LAND_4)
	playse(SE_LEDGE)
	applymovement(LOCALID_SPHEAL_LAND_4, moves(
		jump_2_down
		delay_8
		walk_down 
		walk_right
		walk_in_place_right * 3
		walk_down
		walk_right
		face_up
		walk_in_place_up * 3
		delay_16
		face_left
		delay_16
		face_right
		delay_16
		face_left
		delay_16
		face_down
		emote_exclamation_mark
		delay_16 * 3
		jump_2_down
		walk_fast_down
		walk_left
		face_left 

	))
	applymovement(LOCALID_SPHEAL_LAND_5, moves(
		set_visible
		delay_8
		walk_down
		walk_left
		walk_down
	))
	waitmovement(LOCALID_SPHEAL_LAND_5)
	playse(SE_LEDGE)
	applymovement(LOCALID_SPHEAL_LAND_5, moves(
		jump_2_down
		delay_8
		walk_down * 2
		jump_2_down
		walk_down * 2
		walk_right * 3
		walk_up
		face_left

	))
	addobject(LOCALID_SPHEAL_LAND_6)
	setobjectxy(LOCALID_SPHEAL_LAND_6, 29, 3)
	delay(60)
	playse(SE_LEDGE)
	applymovement(LOCALID_SPHEAL_LAND_6, moves(
		set_visible
		jump_2_down
		delay_8
		walk_down * 2
		jump_2_down
		walk_down * 2
		walk_right * 3
		walk_down
		face_left

	))
	waitmovement(LOCALID_SPHEAL_LAND_4)
	delay(60)
	applymovement(LOCALID_SPHEAL_LAND_1, moves(
		walk_left
	))
	waitmovement(LOCALID_SPHEAL_LAND_1)
	playse(SE_LEDGE)
	applymovement(LOCALID_SPHEAL_LAND_1, moves(
		jump_2_left
	))
	delay(20)
	applymovement(LOCALID_B3F_CAPTAIN, moves(
		walk_left
	))
	waitmovement(LOCALID_SPHEAL_LAND_1)
	removeobject(LOCALID_SPHEAL_LAND_1)
	addobject(LOCALID_SPHEAL_6)
	setobjectxy(LOCALID_SPHEAL_6, 23, 11)
	playse(SE_M_WATERFALL)
	waitse
	applymovement(LOCALID_B3F_CAPTAIN, moves(
		walk_left
	))
	waitmovement(LOCALID_B3F_CAPTAIN)
	playse(SE_LEDGE)
	applymovement(LOCALID_B3F_CAPTAIN, moves(
		jump_2_left
		delay_16
		walk_in_place_right * 4
	))
	delay(16)
	applymovement(LOCALID_SPHEAL_6, moves(
		face_right
	))
	waitmovement(LOCALID_B3F_CAPTAIN)
	delay(30)
	applymovement(LOCALID_SPHEAL_6, moves(
		walk_left * 5
	))
	applymovement(LOCALID_B3F_CAPTAIN, moves(
		walk_left * 5
	))
	waitmovement(LOCALID_B3F_CAPTAIN)
	fadedefaultbgm
	applymovement(LOCALID_PLAYER, moves(
		walk_down
		jump_2_down
		walk_down * 2
		walk_left * 3
	))
	waitmovement(LOCALID_PLAYER)
	removeobject(LOCALID_SPHEAL_LAND_1)
	removeobject(LOCALID_SPHEAL_LAND_2)
	removeobject(LOCALID_SPHEAL_LAND_3)
	removeobject(LOCALID_SPHEAL_LAND_4)
	removeobject(LOCALID_SPHEAL_LAND_5)
	removeobject(LOCALID_SPHEAL_LAND_6)
	removeobject(LOCALID_SPHEAL_LAND_6)
	removeobject(LOCALID_B3F_CAPTAIN)
	clearflag(FLAG_TEMP_1)
	addobject(LOCALID_SPHEAL_1)
	addobject(LOCALID_SPHEAL_2)
	addobject(LOCALID_SPHEAL_3)
	addobject(LOCALID_SPHEAL_4)
	addobject(LOCALID_SPHEAL_5)
	addobject(LOCALID_SPHEAL_6)
	special(RemoveCameraObject)
	setflag(FLAG_CAPTAIN_DIRECTS_SPHEALS)
	release
}

script SeafoamIslands_ZubatWall {
	lock
	msgbox(
	"There is a brick wall in the way.\n"
	"", MSGBOX_DEFAULT)
	playmoncry(SPECIES_ZUBAT, CRY_MODE_DEFAULT)
	waitmoncry
	msgbox(
	"Breaking this wall will release\n"
	"whatever is behind it.", MSGBOX_DEFAULT)
	playmoncry(SPECIES_ZUBAT, CRY_MODE_DEFAULT)
	delay(20)
	playmoncry(SPECIES_ZUBAT, CRY_MODE_DEFAULT)
	waitmoncry
	msgbox(
	"Would you like to break it, even\n"
	"despite knowing the consequences?", MSGBOX_YESNO)
	if(var(VAR_RESULT)) {
		msgbox(
		"wall breaks\n"
		"", MSGBOX_DEFAULT)
		closemessage
		
		removeobject(LOCALID_ZUBAT_WALL)
		delay(30)
		msgbox(
		"it is implied that zubat comes out\n"
		"", MSGBOX_DEFAULT)
		closemessage
		playmoncry(SPECIES_ZUBAT, CRY_MODE_ENCOUNTER)
		setwildbattle(SPECIES_ZUBAT, 30)
		dowildbattle
		release
		end
	} else {
		release
		end
	}
}


script SeafoamIslands_SphealBounce_1 { //these need other direction too, eventually
	lock
	playmoncry(SPECIES_SPHEAL, CRY_MODE_DEFAULT)
	delay(20)
	release
}


script SeafoamIslands_SphealBounce_2 {
	lock
	applymovement(LOCALID_SPHEAL_1, moves(face_left))
	waitmovement(0)
	playmoncry(SPECIES_SPHEAL, CRY_MODE_DEFAULT)
	delay(20)
	release
}


script SeafoamIslands_SphealBounce_3 {
	lock
	applymovement(LOCALID_SPHEAL_2, moves(face_left))
	waitmovement(0)
	playmoncry(SPECIES_SPHEAL, CRY_MODE_DEFAULT)
	delay(20)
	release
}


