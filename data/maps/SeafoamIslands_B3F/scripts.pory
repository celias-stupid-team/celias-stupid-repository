	waitmovement(0)
	playmoncry(SPECIES_SPHEAL, CRY_MODE_DEFAULT)
	delay(20)
	release
}


script SeafoamIslands_SphealBounce_5 {
	lock
	playmoncry(SPECIES_SPHEAL, CRY_MODE_DEFAULT)
	delay(20)
	release
}


script SeafoamIslands_SphealBounce_6 {
	lock
	applymovement(LOCALID_SPHEAL_5, moves(face_left))
	waitmovement(0)
	playmoncry(SPECIES_SPHEAL, CRY_MODE_DEFAULT)
	delay(20)
	release
