script SeafoamIslands_SphealBounce_7 {
	lock
	applymovement(LOCALID_SPHEAL_6, moves(face_left))
	applymovement(LOCALID_SPHEAL_5, moves(face_left))
	applymovement(LOCALID_SPHEAL_4, moves(face_left))
	applymovement(LOCALID_SPHEAL_3, moves(face_left))
	waitmovement(0)
	delay(30)
	applymovement(LOCALID_SPHEAL_6, SphealsDance)
	applymovement(LOCALID_SPHEAL_5, SphealsDance)
	applymovement(LOCALID_SPHEAL_4, SphealsDance)
	applymovement(LOCALID_SPHEAL_3, SphealsDance)
	waitmovement(0)
	playmoncry(SPECIES_SPHEAL, CRY_MODE_ROAR_1)
	waitmoncry
	applymovement(LOCALID_SPHEAL_6, moves(face_down))
	applymovement(LOCALID_SPHEAL_5, moves(face_down))
	applymovement(LOCALID_SPHEAL_4, moves(face_down))
	applymovement(LOCALID_SPHEAL_3, moves(face_down))
	waitmovement(0)
	release
}

movement SphealsDance {
	face_down
	delay_4
	face_left
	delay_4
	face_up
	delay_4
	face_right
	delay_4
	face_down
	delay_4
	face_left
	delay_4
	face_up
	delay_4
	face_right
	delay_4
	face_down
	delay_4
	face_left
	delay_16

}