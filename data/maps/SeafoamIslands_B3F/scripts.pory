}


script SeafoamIslands_SphealBounce_4 {
	lock
	applymovement(LOCALID_SPHEAL_3, moves(face_left))
	waitmovement(0)
	playmoncry(SPECIES_SPHEAL, CRY_MODE_DEFAULT)
	delay(20)
