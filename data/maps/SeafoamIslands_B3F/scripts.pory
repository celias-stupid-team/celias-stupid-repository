script Seafoam3F_DrawThingy {
	setmetatile(20, 11, 0x386, TRUE)
	special(DrawWholeMapView)
	return
}

script SeafoamIslands_Battle_wiz1989 { // tbc wiz1989
	trainerbattle_single(TRAINER_WIZ1989,
	"You're trying to mess with us?\p"

	"You'd better be ready for our\n"
	"LEADER!",
	//
	"No!\n"
	"LEADER! I let you down!")


	msgbox(
	"The LEADER of the SHORTS GANG is\n"
	"way tougher than me!\p"

	"When he gets whipped into a frenzy,\n"
	"there's no stopping him!", MSGBOX_NPC)
}
