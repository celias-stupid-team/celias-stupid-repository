raw `
FiveIsland_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, FiveIsland_OnTransition
	.byte 0


FiveIsland_EventScript_IslandSign::
	msgbox FiveIsland_Text_IslandSign, MSGBOX_SIGN
	end

FiveIsland_EventScript_BugCatcher::
	msgbox FiveIsland_Text_WeirdBuildingInMeadow, MSGBOX_NPC
	end

FiveIsland_EventScript_Fisher::
	msgbox FiveIsland_Text_BeenGettingBusierAroundHere, MSGBOX_NPC
	end
`

script FiveIsland_OnTransition {
	setworldmapflag(FLAG_CSR_MAP_YES)
	if(!flag(FLAG_YES_MAN_TRAVELING)){
		setflag(FLAG_TEMP_1)

	}
	
		if(!flag(FLAG_FOUND_Y) || flag(FLAG_REUNITED_HAKARI_AND_BLIZ)) {
			setflag(FLAG_TEMP_6)
		}
	end
}


script Yes_TravelerInside {
	lock
	faceplayer
	msgbox(
	"Ah, I've spent so much of my\n"
	"life here in this town.\p"

	"Perhaps I should finally stretch\n"
	"my wings and travel the world!\p"
	
	"Where should I go, young one?", MSGBOX_YESNO)
	if(var(VAR_RESULT)) {
		msgbox(
		"Excellent idea!\n"
		"", MSGBOX_DEFAULT)
		closemessage
		specialvar(VAR_RESULT, GetPlayerFacingDirection)
		if(var(VAR_RESULT) == DIR_NORTH) {
			applymovement(VAR_LAST_TALKED, moves(
				walk_left * 2
				walk_down * 2
			))
		} else {
			applymovement(VAR_LAST_TALKED, moves(
				walk_down
				walk_left * 2
				walk_down * 2
			))

		}
		waitmovement(VAR_LAST_TALKED)
		delay(20)
		playse(SE_EXIT)
		removeobject(VAR_LAST_TALKED)

	} else {
		msgbox(
		"Hmm…\n"
		"That's quite far away.\p"

		"I don't know if I'm ready for\n"
		"such a journey.", MSGBOX_DEFAULT)
	}
	release
	end
}

script Yes_Adventurer {
	msgbox(
	"Phew!\n"
	"What an adventure!\p"

	"Thanks for the suggestion, young\n"
	"one!\l"
	"It was worth the journey.", MSGBOX_NPC)
}



script Yes_WhereAreYouFrom {
	lock
	faceplayer
	msgbox(
	"Hey, kid!\n"
	"Where are you from?", MSGBOX_YESNO)
	if(var(VAR_RESULT)) {
		msgbox(
		"Really?\n"
		"You don't strike me as a local.", MSGBOX_DEFAULT)
	} else {
		msgbox(
		"Oh, you're from NO?\n"
		"I've heard about that place!\p"

		"I hear it's lovely this time of\n"
		"year.", MSGBOX_DEFAULT)
	}
	release
}

script Yes_ChanseyNPC {
	lock
	faceplayer
	famechecker(FAMECHECKER_GREAT_BAY, 4)
	if(flag(FLAG_LEARNED_YES_NAH_CHANSEY)) {
		msgbox(
		"You're really happy CHANSEY's\n"
		"journeying by accompanying you,\l"
		"yeah?", MSGBOX_DEFAULT)
		release
		end
	}
	msgbox(
	"Hi, there!\n"
	"I'm giving away a free CHANSEY!\l"
	"Would you like it?", MSGBOX_DEFAULT)
	fadescreenswapbuffers(FADE_TO_BLACK)
	callnative(SayYesForChansey)
	waitstate
	switch(var(VAR_RESULT)) {
		case 0:
			lock
			faceplayer
			msgbox(
			"…What was that?\n"
			"I couldn't quite understand you.\p"

			"I'll wait here until you're ready\n"
			"to give a proper answer.", MSGBOX_DEFAULT)
			release
		case 1:
			lock
			faceplayer
			msgbox(
			"Glad to hear it!\p"

			"Here you go!\n"
			"", MSGBOX_DEFAULT)
			playfanfare(MUS_LEVEL_UP)
			msgbox(
			"{PLAYER} was gifted a CHANSEY!\n"
			"Yes!", MSGBOX_DEFAULT)
			setflag(FLAG_LEARNED_YES_NAH_CHANSEY)
			setvar(VAR_CSR_GIFT_POKEMON, SPECIES_CHANSEY)
			call(Common_Script_GiftPokemon)
			release
			end
		case 2:
			lock
			faceplayer
			msgbox(
			"Oh, I'm sorry.\n"
			"I don't speak Italian.\p"

			"I'll wait here until you're ready\n"
			"to give a proper answer.", MSGBOX_DEFAULT)
			release
	}
}

