script Yes_TM {
	lock
	playfanfare(MUS_LEVEL_UP)
	msgbox(
	"{PLAYER} found TM12!\n"
	"It contains TAUNT!", MSGBOX_DEFAULT)
	waitfanfare
	closemessage
	delay(10)
	playse(SE_PIN)
	applymovement(LOCALID_YES_NERD, moves(
		face_left
		emote_exclamation_mark
	))
	waitmovement(0)
	delay(20)
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"Hey!\n"
	"", MSGBOX_DEFAULT)
	closemessage
	delay(20)
	applymovement(LOCALID_YES_NERD, moves(
		walk_left * 2
	))
	waitmovement(0)
	delay(30)
	message(
	"That's my TM!\n"
	"Thanks for finding it!\p"

	"Here, give it back.\n"
	"")
	waitmessage
	dynmultichoice(19, 8, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "YES  ", "YES  ")
	msgbox(
	"Thanks!\n"
	"", MSGBOX_DEFAULT)
	closemessage
	applymovement(LOCALID_YES_NERD, moves(
		walk_left * 6
		walk_down * 3
	))
	waitmovement(LOCALID_YES_NERD)
	applymovement(LOCALID_YES_NERD, moves(
		walk_down * 4
	))
	fadescreenswapbuffers(FADE_TO_BLACK)
	waitmovement(LOCALID_YES_NERD)
	removeobject(LOCALID_YES_NERD)
	delay(10)
	removeobject(VAR_LAST_TALKED)
	fadescreenswapbuffers(FADE_FROM_BLACK)
	release
	end

}


