raw `
FiveIsland_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, FiveIsland_OnTransition
	.byte 0

FiveIsland_OnTransition::
	setworldmapflag FLAG_CSR_MAP_YES
	end

FiveIsland_EventScript_IslandSign::
	msgbox FiveIsland_Text_IslandSign, MSGBOX_SIGN
	end

FiveIsland_EventScript_BugCatcher::
	msgbox FiveIsland_Text_WeirdBuildingInMeadow, MSGBOX_NPC
	end

FiveIsland_EventScript_Fisher::
	msgbox FiveIsland_Text_BeenGettingBusierAroundHere, MSGBOX_NPC
	end
`


script Yes_WhereAreYouFrom {
	lock
	faceplayer
	msgbox(
	"Hey, kid!\n"
	"Where are you from?", MSGBOX_YESNO)
	if(var(VAR_RESULT)) {
		msgbox(
		"Really?\n"
		"You don't strike me as a local.", MSGBOX_DEFAULT)
	} else {
		msgbox(
		"Oh, yeah?\n"
		"I've heard about that place.\p"

		"They say it's got beautiful\n"
		"beaches!", MSGBOX_DEFAULT)
	}
	release
}

script Yes_ChanseyNPC {
	lock
	faceplayer
	msgbox(
	"Hi, there!\n"
	"I'm giving away a free CHANSEY!\l"
	"Would you like it?", MSGBOX_DEFAULT)
	fadescreenswapbuffers(FADE_TO_BLACK)
	callnative(SayYesForChansey)
	waitstate
	if(var(VAR_RESULT)) {
		msgbox(
		"here\n"
		"", MSGBOX_DEFAULT)
		playfanfare(MUS_LEVEL_UP)
		msgbox(
		"{PLAYER} was gifted a CHANSEY!\n"
		"Yes!", MSGBOX_DEFAULT)
		setvar(VAR_CSR_GIFT_POKEMON, SPECIES_CHANSEY)
		call(Common_Script_GiftPokemon)
		release
		end
	} else {
		msgbox(
		"…What was that?\n"
		"I couldn't quite understand you.\p"

		"I'll wait here until you're ready\n"
		"to give a proper answer.", MSGBOX_DEFAULT)
		release
	}
}

script Yes_SewerSign {
	msgbox(
	"CELADON CITY\n"
	"SEWERS", MSGBOX_SIGN)

}


script Yes_SewerSignGirl {
	msgbox(
	"Oh, please don't do any vandalism.\p"

	"I can't stand to see another soul\n"
	"commit SEWER SIGN.", MSGBOX_NPC)

}

script Yes_Brendan {
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_BLUE)
	if(var(VAR_TRADING_QUEST_PHASE) > 0) {
		msgbox(
		"BRENDAN: I love my hat.\n"
		"", MSGBOX_DEFAULT)
	}
	if(flag(FLAG_TALKED_TO_BRENDAN)) {
		if(checkitem(ITEM_HAT)) {
			msgbox(
			"BRENDAN: Oh, wow!\n"
			"That's my HAT!\p"

			"Thanks so much!\n"
			"Let me just…", MSGBOX_DEFAULT)
			closemessage
			delay(10)
			setobjectxy(LOCALID_BRENDANHAT, 8, 4)
			applymovement(VAR_LAST_TALKED, moves(
				face_left
				delay_16 * 2
			))
			waitmovement(0)
			applymovement(VAR_LAST_TALKED, moves(
				face_left
				set_invisible
			))
			applymovement(LOCALID_BRENDANHAT, moves(
				face_down
				set_visible
				delay_16
				face_up
				delay_4
				face_left
				delay_16
				delay_8
				
			))
			waitmovement(LOCALID_BRENDANHAT)
			applymovement(LOCALID_BRENDANHAT, moves(
				set_invisible
			))
			applymovement(VAR_LAST_TALKED, moves(
				set_visible
			))
			playse(SE_M_SPIT_UP)
			delay(45)
			faceplayer
			removeitem(ITEM_HAT)
			setvar(VAR_TRADING_QUEST_PHASE, 1)
			msgbox(
			"Ah, perfect!\n"
			"Fits like a glove!\p"

			"Thank you for finding that for me.\p"

			"By the way, I have one more favor.\p"

			"I was supposed to deliver a letter\n"
			"to a man called STEVEN STONE.\l"
			"He's on CINNABAR right now.\p"

			"Here, you can have it.\n"
			"I wanna enjoy my hat for a bit.", MSGBOX_DEFAULT)
			giveitem_msg("{PLAYER} was given the\nLETTER!", ITEM_LETTER_W)
			waitfanfare
			release
			end

		}
		msgbox(
		"BRENDAN: My family just moved away,\n"
		"but they left me behind.\l"
		"They took my favorite hat, though.\p"

		"Could you go to their new house\n"
		"and find it for me?", MSGBOX_YESNO)

	} else {
		msgbox(
		"BRENDAN: Oh…\n"
		"Hey, there.\l"
		"My name's BRENDAN.\p"

		"My family just moved out, but it\n"
		"looks like they forgot me…\p"

		"Say, could you do me a favor?\p"

		"They took my favorite hat there.\n"
		"I don't feel right without it.\p"

		"Could you go to my family's new\n"
		"house and find it for me?", MSGBOX_YESNO)

	}
	if(var(VAR_RESULT)) {
		msgbox(
		"No,{PAUSE 30} it's in FUSHCIA CITY actually.\p"

		"Because they{PAUSE 30} moved.\n"
		"{PAUSE 60}Away from here.", MSGBOX_DEFAULT)
		release
	} else {
		msgbox(
		"Aww, darn.\n"
		"I understand, though.\p"

		"I guess…{PAUSE 30} I'm back to being\n"
		"alone and forgotten.\l"
		"Sigh…", MSGBOX_DEFAULT)
	}
	setflag(FLAG_TALKED_TO_BRENDAN)
	release
}



script Yes_BrendanShirt {
	msgbox(
	"They didn't even leave him a\n"
	"copy of his favorite shirt…", MSGBOX_SIGN)

}


