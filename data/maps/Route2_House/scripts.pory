raw `


Route2_House_EventScript_Scientist::
	lock
	faceplayer
	famechecker FAMECHECKER_VIRIDIAN, 5
	setflag FLAG_CSR_HINT_ABRA_TRADE
	call SetPlayerPokedexValues
	msgbox Route2_House_Text_FaintedMonsCanUseFieldMoves, MSGBOX_DEFAULT
	release
	end



Route2_House_EventScript_DeclineTrade::
	msgbox Trade_Text_AwwOhWell
	release
	end

Route2_House_EventScript_NotRequestedMon::
	bufferspeciesname STR_VAR_1, VAR_0x8009
	msgbox Trade_Text_WhatThatsNoMon
	release
	end

Route2_House_EventScript_AlreadyTraded::
	msgbox Trade_Text_IsntMyOldMonGreat
	release
	end
`

mapscripts Route2_House_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setflag(FLAG_TEMP_1)
	}
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_TEMP_1, 1 {
			addobject(LOCALID_ROUTE2_HOUSE_DAD)
			checkpartymonslot(SPECIES_ALAKAZAM)
			
			copyvar(VAR_0x8000, VAR_RESULT)
			setvar(VAR_0x8001, 0)
			setvar(VAR_0x8002, FALSE)
			setvar(VAR_TEMP_1, 0)
			callnative(EvolvePartyMon)
			release
			end
		}
	]
}

script Route2_House_EventScript_Reyley {
	lock
	faceplayer
	setvar(VAR_0x8008, INGAME_TRADE_MR_MIME)
	call(EventScript_GetInGameTradeSpeciesInfo)
	goto_if_set(FLAG_DID_MIMIEN_TRADE, Route2_House_EventScript_AlreadyTraded)
	msgbox(Trade_Text_LookingForMonWannaTradeForMon, MSGBOX_YESNO)
	goto_if_eq(VAR_RESULT, NO, Route2_House_EventScript_DeclineTrade)
	call(EventScript_ChooseMonForInGameTrade)
	callnative(SaveDadTradeNickname)
	goto_if_ge(VAR_0x8004, PARTY_SIZE, Route2_House_EventScript_DeclineTrade)
	call(EventScript_GetInGameTradeSpecies)
	goto_if_ne(VAR_RESULT, VAR_0x8009, Route2_House_EventScript_NotRequestedMon)
	setvar(VAR_TEMP_1, 1)
	clearflag(FLAG_TEMP_1)
	setflag(FLAG_DID_MIMIEN_TRADE)
	call(EventScript_DoInGameTrade)
	
	
	release
}

script Route2_House_BonusDad {
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_FEMALE)
	callnative(GetDadTradeNickname)
	msgbox(
	"{STR_VAR_3}: {PLAYER}!\n"
	"What are you doing out here?\p"

	"It was lovely getting to see you\n"
	"again.\l"
	"Your father raised you well!\p"

	"Well, never mind that.\n"
	"Why don't you take a rest?", MSGBOX_DEFAULT)
		fadescreenswapbuffers(FADE_TO_BLACK)
	closemessage
	playfanfare(MUS_HEAL)
	waitfanfare
	special(HealPlayerParty)
	fadescreenswapbuffers(FADE_FROM_BLACK)
	msgbox(("{STR_VAR_3}: There!\nBest of luck to you!"), MSGBOX_DEFAULT)

	release
	end
}