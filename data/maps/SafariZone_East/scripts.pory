raw `


SafariZone_East_EventScript_RestHouseSign::
	msgbox SafariZone_East_Text_RestHouse, MSGBOX_SIGN
	end

SafariZone_East_EventScript_TrainerTips::
	msgbox SafariZone_East_Text_TimeDeclinesOnlyWhileYouWalk, MSGBOX_SIGN
	end

SafariZone_East_EventScript_AreaSign::
	msgbox SafariZone_East_Text_AreaSign, MSGBOX_SIGN
	end
`
mapscripts SafariZone_East_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setbench(BENCH_SAFARIZONE_EAST)
	}
}

script SafariZone_TauntTM {
	lock
	if(!flag(FLAG_NO_TM_CASE)) {
		finditem(ITEM_TM12)
	} else {
		msgbox("{PLAYER} found a TM12!\nIt contains TAUNT.", MSGBOX_DEFAULT)
		msgbox("Too bad!\nThere's no TM CASE…", MSGBOX_DEFAULT)
		release
	}
}

script SafariZone_TauntGuy {
	msgbox("There was a nifty TM on the\nground over here.\lIt looked useful, too!\pI made sure to snag it before\nanyone else noticed.\lHa ha!", MSGBOX_NPC)
	end
}

script SafariZone_UndergroundPathHint {
	famechecker(FAMECHECKER_KANTO_SHORELINE, 5)
	msgbox("People often lose things in the\ndarkness of the UNDERGROUND PATH.", MSGBOX_NPC)
	end
}

script SafariZone_MazeSign {
	msgbox("Behold!\pThe SAFARI ZONE's incredible\n600-Step Maze!", MSGBOX_SIGN)
	end
}

script SafariZone_WaterGunTM {
	lock
	if(!flag(FLAG_NO_TM_CASE)) {
		setflag(FLAG_SHINY_CREATION) // GUN
		playfanfare(MUS_LEVEL_UP)
		removeobject(VAR_LAST_TALKED)
		msgbox("{PLAYER} found the TM11!\nIt contained WATER GUN!", MSGBOX_DEFAULT)
		waitfanfare
		delay(20)
		msgbox("…Wait, no!\nThis is just a regular GUN!", MSGBOX_DEFAULT)
		playfanfare(MUS_LEVEL_UP)
		msgbox("{PLAYER} found a fucking GUN!\n", MSGBOX_DEFAULT)
		waitfanfare
		setvar(VAR_CSR_GIFT_POKEMON, SPECIES_REMORAID)
		call(Common_Script_GiftPokemon)
		release

	} else {
		msgbox("{PLAYER} found a TM11!\nIt contains WATER GUN.", MSGBOX_DEFAULT)
		msgbox("Too bad!\nThere's no TM CASE…", MSGBOX_DEFAULT)
		release
	}
}