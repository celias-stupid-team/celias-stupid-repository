raw `
PokemonTower_1F_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, PokemonTower_1F_OnTransition
	.byte 0



PokemonTower_1F_EventScript_Channeler::
	msgbox PokemonTower_1F_Text_SenseSpiritsUpToMischief, MSGBOX_NPC
	end

PokemonTower_1F_EventScript_Woman1::
	msgbox PokemonTower_1F_Text_GrowlitheWhyDidYouDie, MSGBOX_NPC
	end

PokemonTower_1F_EventScript_BaldingMan::
	msgbox PokemonTower_1F_Text_CameToPrayForDepartedClefairy, MSGBOX_NPC
	end

PokemonTower_1F_EventScript_Woman2::
	lock
	faceplayer
	checkplayergender
	goto_if_eq VAR_RESULT, MALE, PokemonTower_1F_EventScript_Woman2MalePlayer
	msgbox PokemonTower_1F_Text_ComeToPayRespectsGirl
	release
	end

PokemonTower_1F_EventScript_Woman2MalePlayer::
	msgbox PokemonTower_1F_Text_ComeToPayRespectsSon
	release
	end

PokemonTower_1F_EventScript_WorkerF::
	msgbox PokemonTower_1F_Text_ErectedInMemoryOfDeadMons, MSGBOX_NPC
	end
`
script PokemonTower_1F_OnTransition {
	setworldmapflag(FLAG_WORLD_MAP_POKEMON_TOWER_1F)
	if(var(VAR_CSR_GHOST_FIGHT) != 0) {
		setflag(FLAG_TEMP_5)
	}
}

script PokemonTower_BlackMarket { //Clean up this dialogue; it's a little weak
	lock
	faceplayer
	famechecker(FAMECHECKER_LAVENDER, 1)
	msgbox("Welcome, young traveler.\nI see you have an eye for rarities.\pI offer many wares that those in\npower may find… objectionable.", MSGBOX_DEFAULT)
	message("Come, browse my collection…")
	waitmessage
	pokemart(PokemonTower_Market)
	msgbox("I hope our paths cross again.")
	release
}

script PokemonTower_LostTowerSign {
	msgbox("LOST TOWER\n", MSGBOX_SIGN)
	end
}

script PokemonTower_LostTowerLady {
	msgbox("Ohhh…\pSo THAT'S where the tower went.\n", MSGBOX_NPC)
	end
}

mart PokemonTower_Market {
	ITEM_TM04
	ITEM_TM08
	ITEM_TM21
	ITEM_TM28
	ITEM_TM39
	ITEM_TM47
	ITEM_TM48
}

script PokemonTower_ShortcutSign {
	msgbox("POKéMON TOWER\nShortcut {LEFT_ARROW}", MSGBOX_SIGN)
	end
}

script PokemonTower_ShortcutBlocker {
	msgbox("I'm sorry, but this staircase\nis broken right now.\lWe need some time to repair it.", MSGBOX_NPC)
	end
}

script PokemonTower_ShortcutBlockerCelia {
	msgbox("Very sneaky of you to find here!\pDon't worry about this - you'll\nunderstand eventually.", MSGBOX_NPC)
	end
}


script PokemonTower_ShortcutCelia {
	msgbox("Two of my all-time favorite games,\nTUNIC and OUTER WILDS, hide\lshortcuts like this.\pThat feeling of “Was this always\nthere???” is great.", MSGBOX_NPC)
}

script PokemonTower_LostTower {
	msgbox("Don't worry about this yet.\pWe'll get there when we get there.\n", MSGBOX_NPC)
}

script PokemonTower_LostTowerBit {
	msgbox("Stay tuned!\n", MSGBOX_NPC)
}



script PokemonTower_GhostReceptionist {
	msgbox(
	"This is the reception desk for\n"
	"ghosts.\p"

	"If your heartrate is above 3,\n"
	"please use the other desk.\l"
	"Thank you!", MSGBOX_NPC)
}
