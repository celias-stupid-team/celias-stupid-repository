
const MAN = 1
const DUSCLOPS = 2
mapscripts FushciaGym_BurnDusclopsRoom_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        if(flag(FLAG_GOT_BURNED_ONCE)) {
            setvar(VAR_TEMP_1, 1)
            setobjectxyperm(MAN, 6, 11)
            setobjectxyperm(DUSCLOPS, 7, 11)
        }
        setrespawn(HEAL_LOCATION_FUSHCIA_GYM_BURN_DUSCLOPS_ROOM)
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_1, 0 {
            playse(SE_PIN)
            setvar(VAR_TEMP_1, 2)
            applymovement(MAN, Common_Movement_ExclamationMark)
            applymovement(DUSCLOPS, DusclopsAttacksYou_Left)
            waitmovement(DUSCLOPS)
            playmoncry(SPECIES_DUSCLOPS, CRY_MODE_DEFAULT)
            msgbox("DUSCLOPS: Cloooops!\n", MSGBOX_DEFAULT)
            waitmoncry
            closemessage
            msgbox("DUSCLOPS used WILL-O-WISP!\n", MSGBOX_DEFAULT)
            setstatus1(STATUS1_BURN, 0)
            setflag(FLAG_GOT_BURNED_ONCE)
            release
        }
    ]
}

movement DusclopsAttacksYou_Left {  
    walk_fast_down
    Walk_fast_right
    walk_fast_down
    face_down
}


script FushciaGym_BurnDusclops {
    lock
    faceplayer
    if(var(VAR_TEMP_1) == 1) {
            playmoncry(SPECIES_DUSCLOPS, CRY_MODE_DEFAULT)
            msgbox("DUSCLOPS: Cloooops!\n", MSGBOX_DEFAULT)
            waitmoncry
            closemessage
            msgbox("DUSCLOPS used WILL-O-WISP!\n", MSGBOX_DEFAULT)
            setstatus1(STATUS1_BURN, 0)
            setflag(FLAG_GOT_BURNED_ONCE)
            setvar(VAR_TEMP_1, 2)

    } else {
            playmoncry(SPECIES_DUSCLOPS, CRY_MODE_DEFAULT)
            msgbox("DUSCLOPS: Cloooops!\n", MSGBOX_DEFAULT)
            waitmoncry
    }
    release
    end
}

script FushciaGym_BurnDusclopsMan {
	msgbox("bad dusclops\n", MSGBOX_NPC)
	end
}