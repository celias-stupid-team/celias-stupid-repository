raw `


SaffronCity_Dojo_EventScript_TriggerMasterBattleLeft::
	lockall
	applymovement LOCALID_KARATE_MASTER, Common_Movement_WalkInPlaceFasterLeft
	waitmovement 0
	textcolor NPC_TEXT_COLOR_BLUE
	goto SaffronDojo_James
	releaseall
	end

SaffronCity_Dojo_EventScript_TriggerMasterBattleRight::
	lockall
	applymovement LOCALID_KARATE_MASTER, Common_Movement_WalkInPlaceFasterRight
	waitmovement 0
	textcolor NPC_TEXT_COLOR_BLUE
	goto SaffronDojo_James
	releaseall
	end

SaffronCity_Dojo_EventScript_HitmonleeBall::
	lock
	faceplayer
	goto_if_set FLAG_GOT_HITMON_FROM_DOJO, SaffronCity_Dojo_EventScript_AlreadyGotHitmon
	showmonpic SPECIES_HITMONLEE, 10, 3
	setvar VAR_TEMP_1, SPECIES_HITMONLEE
	applymovement LOCALID_KARATE_MASTER, Common_Movement_WalkInPlaceFasterUp
	waitmovement 0
	textcolor NPC_TEXT_COLOR_MALE
	msgbox SaffronCity_Dojo_Text_YouWantHitmonlee, MSGBOX_YESNO
	call EventScript_RestorePrevTextColor
	goto_if_eq VAR_RESULT, YES, SaffronCity_Dojo_EventScript_GiveHitmon
	hidemonpic
	release
	end

SaffronCity_Dojo_EventScript_AlreadyGotHitmon::
	msgbox SaffronCity_Dojo_Text_BetterNotGetGreedy
	release
	end

SaffronCity_Dojo_EventScript_HitmonchanBall::
	lock
	faceplayer
	goto_if_set FLAG_GOT_HITMON_FROM_DOJO, SaffronCity_Dojo_EventScript_AlreadyGotHitmon
	showmonpic SPECIES_HITMONCHAN, 10, 3
	setvar VAR_TEMP_1, SPECIES_HITMONCHAN
	applymovement LOCALID_KARATE_MASTER, Common_Movement_WalkInPlaceFasterUp
	waitmovement 0
	textcolor NPC_TEXT_COLOR_MALE
	msgbox SaffronCity_Dojo_Text_YouWantHitmonchan, MSGBOX_YESNO
	call EventScript_RestorePrevTextColor
	goto_if_eq VAR_RESULT, YES, SaffronCity_Dojo_EventScript_GiveHitmon
	hidemonpic
	release
	end

SaffronCity_Dojo_EventScript_GiveHitmon::
	hidemonpic
	givemon VAR_TEMP_1, 25
	goto_if_eq VAR_RESULT, 0, SaffronCity_Dojo_EventScript_ReceivedHitmonParty
	goto_if_eq VAR_RESULT, 1, SaffronCity_Dojo_EventScript_ReceivedHitmonPC
	goto_if_eq VAR_RESULT, 2, EventScript_NoMoreRoomForPokemon
	release
	end

SaffronCity_Dojo_EventScript_ReceivedHitmonParty::
	removeobject VAR_LAST_TALKED
	bufferspeciesname STR_VAR_1, VAR_TEMP_1
	playfanfare MUS_LEVEL_UP
	message SaffronCity_Dojo_Text_ReceivedMonFromKarateMaster
	waitmessage
	waitfanfare
	setflag FLAG_GOT_HITMON_FROM_DOJO
	msgbox Text_GiveNicknameToThisMon, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, SaffronCity_Dojo_EventScript_EndGiveMon
	call EventScript_GetGiftMonPartySlot
	call EventScript_ChangePokemonNickname
	goto SaffronCity_Dojo_EventScript_EndGiveMon
	end

SaffronCity_Dojo_EventScript_ReceivedHitmonPC::
	removeobject VAR_LAST_TALKED
	bufferspeciesname STR_VAR_1, VAR_TEMP_1
	playfanfare MUS_LEVEL_UP
	message SaffronCity_Dojo_Text_ReceivedMonFromKarateMaster
	waitmessage
	waitfanfare
	setflag FLAG_GOT_HITMON_FROM_DOJO
	msgbox Text_GiveNicknameToThisMon, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, SaffronCity_Dojo_EventScript_TransferredHitmonToPC
	call EventScript_NameReceivedBoxMon
	goto SaffronCity_Dojo_EventScript_TransferredHitmonToPC
	end

SaffronCity_Dojo_EventScript_TransferredHitmonToPC::
	call EventScript_TransferredToPC
	goto SaffronCity_Dojo_EventScript_EndGiveMon
	end

SaffronCity_Dojo_EventScript_EndGiveMon::
	release
	end

SaffronCity_Dojo_EventScript_Statue::
	msgbox SaffronCity_Dojo_Text_FightingDojo, MSGBOX_SIGN
	end

SaffronCity_Dojo_EventScript_LeftScroll::
	msgbox SaffronCity_Dojo_Text_EnemiesOnEverySide, MSGBOX_SIGN
	end

SaffronCity_Dojo_EventScript_RightScroll::
	msgbox SaffronCity_Dojo_Text_GoesAroundComesAround, MSGBOX_SIGN
	end

SaffronCity_Dojo_EventScript_Hitoshi::
	trainerbattle_single TRAINER_BLACK_BELT_HITOSHI, SaffronCity_Dojo_Text_HitoshiIntro, SaffronCity_Dojo_Text_HitoshiDefeat
	msgbox SaffronCity_Dojo_Text_HitoshiPostBattle, MSGBOX_AUTOCLOSE
	end

SaffronCity_Dojo_EventScript_Hideki::
	trainerbattle_single TRAINER_BLACK_BELT_HIDEKI, SaffronCity_Dojo_Text_HidekiIntro, SaffronCity_Dojo_Text_HidekiDefeat
	msgbox SaffronCity_Dojo_Text_HidekiPostBattle, MSGBOX_AUTOCLOSE
	end

SaffronCity_Dojo_EventScript_Aaron::
	trainerbattle_single TRAINER_BLACK_BELT_AARON, SaffronCity_Dojo_Text_AaronIntro, SaffronCity_Dojo_Text_AaronDefeat
	msgbox SaffronCity_Dojo_Text_AaronPostBattle, MSGBOX_AUTOCLOSE
	end

SaffronCity_Dojo_EventScript_Mike::
	trainerbattle_single TRAINER_BLACK_BELT_MIKE, SaffronCity_Dojo_Text_MikeIntro, SaffronCity_Dojo_Text_MikeDefeat
	msgbox SaffronCity_Dojo_Text_MikePostBattle, MSGBOX_AUTOCLOSE
	end

SaffronCity_Dojo_EventScript_MasterKoichi::
	trainerbattle_single TRAINER_BLACK_BELT_KOICHI, SaffronCity_Dojo_Text_MasterKoichiIntro, SaffronCity_Dojo_Text_MasterKoichiDefeat, SaffronCity_Dojo_EventScript_DefeatedMasterKoichi
	goto_if_set FLAG_GOT_HITMON_FROM_DOJO, SaffronCity_Dojo_EventScript_MasterKoichiAlreadyGotHitmon
	msgbox SaffronCity_Dojo_Text_ChoosePrizedFightingMon, MSGBOX_AUTOCLOSE
	end

SaffronCity_Dojo_EventScript_MasterKoichiAlreadyGotHitmon::
	msgbox SaffronCity_Dojo_Text_StayAndTrainWithUs
	release
	end

SaffronCity_Dojo_EventScript_DefeatedMasterKoichi::
	setvar VAR_MAP_SCENE_SAFFRON_CITY_DOJO, 1
	release
	end
`

mapscripts SaffronCity_Dojo_MapScripts {
	MAP_SCRIPT_ON_LOAD {
		setflag(FLAG_TEMP_4)
		setflag(FLAG_TEMP_5)
		if(flag(FLAG_JASON_IS_IN_ROOM) && !flag(FLAG_JASON_WAS_KILLED)) {
			playbgm(MUS_NONE, TRUE)
			
			
		} else {
			setflag(FLAG_TEMP_1)
			setflag(FLAG_TEMP_2)
		}
		if(flag(FLAG_JASON_WAS_KILLED)) {
			clearflag(FLAG_TEMP_5)
			setflag(FLAG_TEMP_6)
		}
	}

	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_READY_FOR_TORNADO, 2 {
			
			fadenewbgm(MUS_NONE)
			delay(60)
			playse(SE_M_BLIZZARD)
			applymovement(LOCALID_SIMON_TORNADO, moves(
				walk_up * 2
				walk_left * 8
			))
			waitmovement(LOCALID_SIMON_TORNADO)
			applymovement(LOCALID_PLAYER, moves(
				set_invisible
			))
			applymovement(LOCALID_SIMON_TORNADO, moves(
				walk_left * 8
			))
			waitmovement(LOCALID_SIMON_TORNADO)
			setvar(VAR_READY_FOR_TORNADO, 3)
			playse(SE_M_BLIZZARD2)
			warpsilent(MAP_ONIX_ROOM, 0)
			end
		}
	]

}

script SaffronDojo_ApproachJason {
	lock
	getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
	if(var(VAR_TEMP_0) == 6) {
		applymovement(LOCALID_PLAYER, moves(
			walk_down * 2
		))
	} else {
		applymovement(LOCALID_PLAYER, moves(
			walk_down
			walk_left
			walk_down
		))
		
	}
	waitmovement(LOCALID_PLAYER)
	delay(90)
	applymovement(LOCALID_JASON_VORHEES, moves(
		face_up
		delay_16 * 6
		face_up
		walk_slower_up
		face_up
		delay_16 * 3
		walk_slower_up
		face_up
		delay_16 * 3
	))
	waitmovement(LOCALID_JASON_VORHEES)
	special(SpawnCameraObject)
	applymovement(LOCALID_CAMERA, moves(
		walk_slower_down
		face_down
	))
	applymovement(LOCALID_PLAYER, moves(
		walk_slower_left
		face_left
		delay_16 * 3
		walk_slower_down
		face_down
		delay_16 * 4
		face_right
	))
	applymovement(LOCALID_JASON_VORHEES, moves(
		walk_slower_right
		face_right
		delay_16 * 3
		walk_slower_up
		face_up
		delay_16 * 4
		face_left
	))
	waitmovement(LOCALID_PLAYER)
	delay(60)
	addobject(LOCALID_HADOUKEN_PROMPT)
	delay(30)

	waitbuttonpress
	playse(SE_SELECT)
	applymovement(LOCALID_HADOUKEN_PROMPT, moves(
		face_left
	))
	delay(60)
	removeobject(LOCALID_HADOUKEN_PROMPT)
	delay(30)

	applymovement(LOCALID_PLAYER, moves(
		set_invisible
	))
	if(checkplayergender == MALE) {
		addobject(LOCALID_HADOUKEN_BOY_1)
		applymovement(LOCALID_HADOUKEN_BOY_1, moves(
			set_visible
			delay_16
			face_up
			delay_16
			face_left
			delay_16 * 2
		))
	} else {
		addobject(LOCALID_HADOUKEN_GIRL_1)
		applymovement(LOCALID_HADOUKEN_GIRL_1, moves(
			set_visible
			delay_16
			face_up
			delay_16
			face_left
			delay_16 * 2
		))

	}
	waitmovement(LOCALID_HADOUKEN_BOY_1)
	waitmovement(LOCALID_HADOUKEN_GIRL_1)
	playmoncry(SPECIES_HITMONLEE, CRY_MODE_DEFAULT)
	if(checkplayergender == MALE) {
		addobject(LOCALID_HADOUKEN_BOY_2)
		
		applymovement(LOCALID_HADOUKEN_BOY_1, moves(
			set_invisible
		))
		applymovement(LOCALID_HADOUKEN_BOY_2, moves(
			set_visible
			delay_16
			face_up
			delay_8
			face_left
		))
	} else {
		addobject(LOCALID_HADOUKEN_GIRL_2)
		
		applymovement(LOCALID_HADOUKEN_GIRL_1, moves(
			set_invisible
		))
		applymovement(LOCALID_HADOUKEN_GIRL_2, moves(
			set_visible
			delay_16
			face_up
			delay_8
			face_left
		))

	}
	addobject(LOCALID_HADOUKEN_SPRITE)
	setobjectsubpriority(LOCALID_HADOUKEN_SPRITE, MAP_SAFFRON_CITY_DOJO, 0)
	applymovement(LOCALID_HADOUKEN_SPRITE, moves(
			set_visible
			walk_slower_right * 3
	))
	waitmovement(LOCALID_HADOUKEN_GIRL_2)
	waitmovement(LOCALID_HADOUKEN_BOY_2)
	delay(10)

	fadescreenswapbuffers(FADE_TO_WHITE)
	delay(80)
	removeobject(LOCALID_JASON_VORHEES)
	removeobject(LOCALID_HADOUKEN_BOY_1)
	removeobject(LOCALID_HADOUKEN_BOY_2)
	removeobject(LOCALID_HADOUKEN_GIRL_1)
	removeobject(LOCALID_HADOUKEN_GIRL_2)
	removeobject(LOCALID_HADOUKEN_SPRITE)
	applymovement(LOCALID_PLAYER, moves(
		set_visible
	))
	delay(7)
	playse(SE_EFFECTIVE)
	delay(3)
	fadescreeninstant(FADE_FROM_WHITE)
    setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 3)
    setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 3)
    setvar(VAR_SHAKESCREEN_NUM_SHAKES, 5)
    setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
    special(ShakeScreen)
	delay(90)
	applymovement(LOCALID_CAMERA, moves(
		walk_left
	))
	setvar(VAR_MAP_SCENE_SAFFRON_CITY_DOJO, 3)
	fadedefaultbgm
	waitmovement(0)
	setflag(FLAG_JASON_WAS_KILLED)
	special(RemoveCameraObject)
	release

	
}

script SaffronDojo_DeadNerd {
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox(
	"He's dead.\p"

	"His friends are dead.\p"

	"His family's dead.\p"

	"His fucking pets are being skinned\n"
	"alive.\p"

	"His mom's a fucking whore.\p"

	"He sucks at life.\p"

	"The whole world hates him.\p"

	"He's going to hell.\p"

	"Deal with it.\n"
	"", MSGBOX_SIGN)

}

script SaffronDojo_ReadyForTornado {
	setvar(VAR_READY_FOR_TORNADO, 1)
	release
}
script SaffronDojo_NoTornado {
	setvar(VAR_READY_FOR_TORNADO, 0)
	release
}

script SaffronDojo_James {
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_BLUE)
	if(var(VAR_MAP_SCENE_SAFFRON_CITY_DOJO) > 0) {
		setflag(FLAG_TEMP_A)
		msgbox(
		"JAMES: I've never seen such horse\n"
		"shit before in my life.\p"

		"But guess what!\n"
		"That's not even all you gotta do!\p"

		"That's right: There's ANOTHER\n"
		"fucking GYM LEADER.\p"

		"If you want the GYM BADGE, you'll\n"
		"need to go into the back room and\l"
		"defeat the biggest nerd of all!", MSGBOX_DEFAULT)
		if(!flag(FLAG_TEMP_A)) {
			closemessage
			delay(10)
			applymovement(VAR_LAST_TALKED, moves(
				walk_right
				face_left
			))
			waitmovement(0)
			
		}
		setflag(FLAG_TEMP_A)
		release
		end
	}
	msgbox(
	"JAMES: Who the fuck are you?\p"

	"I'm sick and tired of this shit!\n"
	"Shitty games, day in and day out!\p"

	"But none of them - and I mean\n"
	"NONE of them - compare to this!\p"

	"Get your ass over here!\n"
	"I'm dead fucking serious!\p"

	"Get ready for a taste of the\n"
	"shittiest game I've ever played!", MSGBOX_DEFAULT)
	setvar(VAR_TEMP_START_EVENT_BATTLE, EVENT_BATTLE_JAMES)
	trainerbattle_no_intro(TRAINER_AVGN_4, "What a shitload of fuck!\p"

	"I'd rather have diarrhea come pouring\n"
	"out of my eyeballs!\l"
	"I'd rather be shitting from my nostrils!\p"

	"I'd rather pour gasoline on the undead\n"
	"carcass of a racoon and blend it all\l"
	"into a fucking breakfast smoothie!")
	closemessage
	setvar(VAR_MAP_SCENE_SAFFRON_CITY_DOJO, 1)
	msgbox(
	"JAMES: I've never seen such fucking\n"
	"horseshit before in my life.\p"

	"But guess what!\n"
	"That's not even all you gotta do!\p"

	"That's right: There's ANOTHER\n"
	"fucking GYM LEADER.\p"

	"If you want the GYM BADGE, you'll\n"
	"have to go into the back room and\l"
	"defeat the biggest nerd of all!", MSGBOX_DEFAULT)
	applymovement(LOCALID_KARATE_MASTER, moves(
		face_down
	))
	waitmovement(LOCALID_KARATE_MASTER)
	release
}

script SaffronDojo_Toaster {
	lock
	msgbox(
	"It looks like a toaster, but it's\n"
	"actually very a fancy NES!\l"
	"Wanna jump in?", MSGBOX_YESNO)
	if(var(VAR_RESULT)) {
		closemessage
		special(SpawnCameraObject)
		delay(45)
		playse(SE_LEDGE)
		setobjectsubpriority(LOCALID_PLAYER, MAP_BRUNO_BACK_ROOM, 0)
		specialvar(VAR_RESULT, GetPlayerFacingDirection)
		switch(var(VAR_RESULT)) {
			case DIR_NORTH:
				applymovement(LOCALID_PLAYER, moves(
					jump_up
					set_invisible
				))
			case DIR_WEST:
				applymovement(LOCALID_PLAYER, moves(
					jump_left
					set_invisible
				))

			case DIR_EAST:
				applymovement(LOCALID_PLAYER, moves(
					jump_right
					set_invisible
				))

		}
		waitmovement(0)
		if(flag(FLAG_JASON_IS_IN_ROOM)) {
			warp(MAP_BRUNO_BACK_ROOM, 0)
			end
		}
		setvar(VAR_MAP_SCENE_SAFFRON_CITY_DOJO, 2)
		fadenewbgm(MUS_NONE)
		delay(120)
		applymovement(LOCALID_CAMERA, moves(
			walk_slow_down * 10
		))
		delay(60)
		playse(SE_PIN)
		applymovement(LOCALID_KARATE_MASTER, moves(
			face_down
			emote_exclamation_mark
		))
		delay(60)
		playse(SE_PIN)
		applymovement(LOCALID_ANGRY_NERD_3, moves(
			face_down
			emote_exclamation_mark
		))
		delay(20)
		playse(SE_PIN)
		applymovement(LOCALID_ANGRY_NERD_2, moves(
			face_down
			emote_exclamation_mark
		))
		delay(40)
		playse(SE_PIN)
		applymovement(LOCALID_ANGRY_NERD_1, moves(
			face_down
			emote_exclamation_mark
		))
		waitmovement(LOCALID_CAMERA)
		delay(90)
		playse(SE_EXIT)
		delay(5)
		fadescreeninstant(FADE_TO_BLACK)
		applymovement(LOCALID_CAMERA, moves(
			walk_fastest_down * 10
		))
		setflag(FLAG_JASON_IS_IN_ROOM)
		waitmovement(LOCALID_CAMERA)
		delay(30)
		warpsilent(MAP_BRUNO_BACK_ROOM, 0)
	}
	release
	end
}

script SaffronDojo_IrateGamer {
	if(flag(FLAG_JASON_IS_IN_ROOM)) {
		msgbox(
		"I am the IRATE GAMER.\n"
		"{PAUSE 30}…Oh?\l"
		"How am I still alive?\p"

		"Ha! I never did an episode covering\n"
		"FRIDAY THE 13th.", MSGBOX_NPC)
		end
	}
	msgbox(
	"THE IRATE GAMER: Oh, boy!\p"

	"Now that the DMCA is gone, I can\n"
	"keep doing my show!", MSGBOX_NPC)
}

