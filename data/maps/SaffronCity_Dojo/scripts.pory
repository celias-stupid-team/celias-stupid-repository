	trainerbattle_single(TRAINER_AVGN_2, "Sixty-four bit...",
	
	"THE WRIST GAAAAAAAAAAAAMES!")
	msgbox(
	"I am a nerd.\n"
	"", MSGBOX_NPC)
}

script SaffronDojo_Nerd3 {
	trainerbattle_single(TRAINER_AVGN_3, "Hoargh!\n"
	"Take your shoes off!",
	
	"Oh my god!\pI'm drinking ROLLIN' ROCK...\n{PAUSE 30}on my ROGGENROLA!", SaffronDojo_RemoveShoes)
	msgbox(
	"Yeeeah!\n"
	"ROLLIN ROCK!\l"
	"On the ROGGENROLA!", MSGBOX_NPC)
}

script SaffronDojo_RemoveShoes {
	if(checkpartymon(SPECIES_TOEDSCOOL)) {
		msgbox(
		"…But seriously.\n"
		"Take those shoes off!", MSGBOX_DEFAULT)
		closemessage
		delay(30)
		checkpartymonslot(SPECIES_TOEDSCOOL)
		bufferpartymonnick(STR_VAR_1, VAR_RESULT)
		checkpartymonslot(SPECIES_TOEDSCOOL)
		callnative(RemoveShoesFromToedy)
		playfanfare(MUS_TOO_BAD)
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		msgbox(
		"{PLAYER} removed the shoes from\n"
		"{STR_VAR_1}…", MSGBOX_DEFAULT)
		waitfanfare
		textcolor(NPC_TEXT_COLOR_MALE)
		msgbox(
		"But anyway!\p"

		"Yeeeah!\n"
		"ROLLIN ROCK!\l"
		"On the ROGGENROLA!", MSGBOX_DEFAULT)
		

	}
	release
	end
}

script SaffronGym_CleaningLady {
	msgbox(
	"Huh?\n"
	"Yeah, I'm the CLEANING LADY.\p"

	"This room was a mess, so I moved\n"
	"everything to storage.", MSGBOX_NPC)
	end
}