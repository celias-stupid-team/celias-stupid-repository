mapscripts SkyTower_3F_MapScripts {
    //Drampa 
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_TEMP_B)
    }
    MAP_SCRIPT_ON_LOAD {
        if(flag(FLAG_SKY_TOWER_HURL_ORB)) {
            setobjectxyperm(LOCALID_SKY_TOWER_DRAMPA, 45, 35)
            
            setobjectmovementtype(LOCALID_SKY_TOWER_DRAMPA, MOVEMENT_TYPE_FACE_UP)
        }
    }
}


script SkyTower_KecleonShop2 {
	lock
	textcolor(NPC_TEXT_COLOR_BLUE)
    if(flag(FLAG_SKY_TOWER_HURL_ORB)) {
        msgbox(
        "KECLEON: … … … {PAUSE 30}\n"
        "I hate thieves.", MSGBOX_DEFAULT)
        release
        end
    }
	msgbox(
	"Kecleon Shop 2\n"
	"", MSGBOX_DEFAULT)
	release
}

script SkyTower_3FShop_Orb {
	lock
	msgbox(
	"HURL ORB\p"
    "Buy the HURL ORB?"
	"", MSGBOX_YESNO)
    if(var(VAR_RESULT)) {
        msgbox(
        "You can't afford it and you\n"
        "fucking die", MSGBOX_DEFAULT)
    } else {
        msgbox(
        "HURL the HURL ORB?\n"
        "", MSGBOX_YESNO)
        if(var(VAR_RESULT)) {
            closemessage
            delay(30)
            playse(SE_FALL)
            applymovement(LOCALID_PLAYER, moves(
                face_right
            ))
            applymovement(LOCALID_SKY_TOWER_3F_KECLEON_1, moves(
                delay_8
                face_right
            ))
            applymovement(VAR_LAST_TALKED, moves(
                walk_faster_right * 4
            ))
            waitmovement(VAR_LAST_TALKED)
            special(SpawnCameraObject)
            applymovement(VAR_LAST_TALKED, moves(
                walk_faster_right * 17
                set_invisible
            ))
            applymovement(LOCALID_CAMERA, moves(
                walk_faster_right * 21
            ))
            waitmovement(VAR_LAST_TALKED)
            playse(SE_CLICK)
            applymovement(LOCALID_SKY_TOWER_DRAMPA, moves(
                face_left
            ))
            waitmovement(LOCALID_CAMERA)
            addobject(LOCALID_SKY_TOWER_3F_KECLEON_1)
            setobjectxy(LOCALID_SKY_TOWER_3F_KECLEON_1, 31, 36)
            copyobjectxytoperm(LOCALID_SKY_TOWER_3F_KECLEON_1)
            delay(60)


            applymovement(LOCALID_SKY_TOWER_3F_KECLEON_1, moves(
                walk_fastest_right * 6
                walk_faster_down
                walk_faster_right * 2
            ))
            
            addobject(LOCALID_SKY_TOWER_3F_KECLEON_2)
            applymovement(LOCALID_SKY_TOWER_3F_KECLEON_2, moves(
                delay_16 * 2
                set_visible
                walk_faster_down * 5
            ))

            addobject(LOCALID_SKY_TOWER_3F_KECLEON_3)
            applymovement(LOCALID_SKY_TOWER_3F_KECLEON_3, moves(
                delay_16 * 4
                set_visible
                walk_faster_down * 5
            ))

            addobject(LOCALID_SKY_TOWER_3F_KECLEON_4)
            applymovement(LOCALID_SKY_TOWER_3F_KECLEON_4, moves(
                delay_16 * 2
                delay_8
                set_visible
                walk_faster_down
                walk_faster_left
                walk_faster_down
                walk_faster_left * 3
            ))

            addobject(LOCALID_SKY_TOWER_3F_KECLEON_5)
            applymovement(LOCALID_SKY_TOWER_3F_KECLEON_5, moves(
                delay_16 * 2
                delay_8
                set_visible
                walk_faster_up * 4
                walk_faster_right * 2
                walk_faster_up * 2
                face_up

            ))

            addobject(LOCALID_SKY_TOWER_3F_KECLEON_6)
            applymovement(LOCALID_SKY_TOWER_3F_KECLEON_6, moves(
                delay_16 * 2
                set_visible
                walk_faster_left * 3
                walk_faster_up * 2
                face_up
            ))
            waitmovement(LOCALID_SKY_TOWER_3F_KECLEON_1)
            applymovement(LOCALID_SKY_TOWER_DRAMPA, moves(
                
                face_left
                delay_8
                face_right
                delay_8
                face_left
                delay_8
                face_right
                delay_8
                face_right
                delay_8
                face_left
                delay_8
                face_down
                delay_8
                face_right
                delay_8
                face_left
                delay_8
                face_down
                delay_8
                face_left
                delay_8
                face_right
                delay_8
                face_down
                delay_8
                face_right
                delay_8
                face_down
                delay_8
                face_left
                delay_8
                face_right
                delay_8
                face_down
                delay_8
                face_left
                delay_8
                face_right
                delay_8
                face_down
                delay_8
                face_left
                delay_8
                face_right
            ))
            playse(SE_M_DOUBLE_SLAP)
            waitse
            playse(SE_M_DOUBLE_SLAP)
            waitse
            playse(SE_M_DOUBLE_SLAP)
            waitse
            playse(SE_M_DOUBLE_SLAP)
            waitse
            playse(SE_M_DOUBLE_SLAP)
            waitse
            playse(SE_M_DOUBLE_SLAP)
            waitse
            playse(SE_M_DOUBLE_SLAP)
            waitse
            playse(SE_M_DOUBLE_SLAP)
            
            fadescreenswapbuffers(FADE_TO_WHITE)
            waitmovement(LOCALID_SKY_TOWER_DRAMPA)
            removeobject(LOCALID_SKY_TOWER_3F_KECLEON_2)
            removeobject(LOCALID_SKY_TOWER_3F_KECLEON_3)
            removeobject(LOCALID_SKY_TOWER_3F_KECLEON_4)
            removeobject(LOCALID_SKY_TOWER_3F_KECLEON_5)
            removeobject(LOCALID_SKY_TOWER_3F_KECLEON_6)
            removeobject(VAR_LAST_TALKED)
            setobjectxy(LOCALID_SKY_TOWER_DRAMPA, 45, 35)
            copyobjectxytoperm(LOCALID_SKY_TOWER_DRAMPA)
            applymovement(LOCALID_SKY_TOWER_DRAMPA, moves(
                face_up
            ))
            setobjectmovementtype(LOCALID_SKY_TOWER_DRAMPA, MOVEMENT_TYPE_FACE_UP)
            applymovement(LOCALID_CAMERA, moves(
                walk_faster_left * 21
            ))
            setobjectxy(LOCALID_SKY_TOWER_3F_KECLEON_1, 35, 36)
            applymovement(LOCALID_SKY_TOWER_3F_KECLEON_1, moves(
                face_down
            ))
            waitmovement(LOCALID_CAMERA)
            special(RemoveCameraObject)
            fadescreeninstant(FADE_FROM_WHITE)
            release
            end

        } else {
            release
            end
        }
    }

	release
}



script SkyTower_Drampa {
    if(flag(FLAG_SKY_TOWER_HURL_ORB)) {
        msgbox(
        "Oh, no!\n"
        "DRAMPA's dead!", MSGBOX_SIGN)

    } else {
        msgbox(
        "Oh, no!\n"
        "DRAMPA's in the way!", MSGBOX_SIGN)
    }
    
}


script SkyTower_Shortcut {
	msgbox(
	"SKY TOWER\n"
	"Shortcut {RIGHT_ARROW}", MSGBOX_SIGN)

}


script SkyTower_3F_WarpTrap {
    lock
    playse(SE_CLICK)
    call(EventScript_PlayerJumpInPlace)
    setplayermetatile(METATILE_NavelRock_WarpTrap, FALSE)
    special(DrawWholeMapView)
    waitse
    delay(30)
    waitmovement(0)
    playse(SE_WARP_OUT)
    fadescreen(FADE_TO_WHITE)
    applymovement(LOCALID_PLAYER, moves(
        walk_fastest_right * 11
        face_down
    ))
    waitmovement(0)
    waitse
    playse(SE_WARP_IN)
    fadescreen(FADE_FROM_WHITE)
    release
    end

}



script SkyTower_3F_ThePit {
    playse(SE_CLICK)
    addobject(LOCALID_SKY_TOWER_3F_FRIEND_OAK)
    removeobject(LOCALID_SKY_TOWER_3F_UNFRIEND)
    setlayouttiles(LAYOUT_SKY_TOWER_3F_PIT, 0,0,0,0,67, 62)

    release
}


script SkyTower_3F_KillThePit {
    setlayouttiles(LAYOUT_SKY_TOWER_3F, 0,0,0,0,67, 62)
    setmetatile(22, 49, METATILE_NavelRock_PitTrap, FALSE)
    removeobject(LOCALID_SKY_TOWER_3F_FRIEND_OAK)
    addobject(LOCALID_SKY_TOWER_3F_UNFRIEND)
    clearflag(FLAG_TEMP_A)
    special(DrawWholeMapView)
    setvar(VAR_TEMP_4, 1)
    release
}


script SkyTower_3F_DeadThePit {
	lock
	
	setplayermetatile(METATILE_NavelRock_PitTrap, FALSE)
	call(EventScript_PlayerJumpInPlace)
	special(DrawWholeMapView)
	playse(SE_CLICK)
	waitse
	delay(30)
	
		msgbox(
		"The THE PIT trap had no effect…\n"
		"", MSGBOX_DEFAULT)

	release
}


