}



script SkyTower_3F_Smeargle {
    textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox("At long last, I have completed\nmy life's work!\pI've painted photorealistic traps\nall along the floor of this room!\lMy artistic genius knows no limits!", MSGBOX_NPC)
	end
}

