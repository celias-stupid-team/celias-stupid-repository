script Starlight_House_jukebox_MapReset {
    lock
    textcolor(NPC_TEXT_COLOR_NEUTRAL)
    msgbox("Would you like to reset\nthe room?", MSGBOX_YESNO)
		closemessage
		if(var(VAR_RESULT)) {
			//fadescreen(FADE_TO_WHITE)
            warp(MAP_STARLIGHT_HOUSE_10, 0, 8, 10) // Map, Warp ID, X, Y
            waitstate
            //delay(120)
            //fadescreen(FADE_FROM_WHITE)
		}
    release
    end
}

script Starlight_Jukebox_0 {
    playbgm(MUS_NONE, TRUE)
    
	msgbox(
    "Music OFF", MSGBOX_SIGN)
    end
}

