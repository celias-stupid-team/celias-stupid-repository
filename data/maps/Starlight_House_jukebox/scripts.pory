mapscripts Starlight_House_jukebox_MapScripts {
MAP_SCRIPT_ON_TRANSITION {
 if(checkplayergender == FEMALE) {
            setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_PLAYFIRE)
        } else {
            setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_PLAYGREEN)

        }
//if (var(VAR_RESULT) == FEMALE) {
        //setobjectsprite (DANCER1, SPRITE_GFX_PLAYGREEN)
    //} else {
        //setobjectsprite (DANCER1, SPRITE_GFX_PLAYFIRE)
    //}
}
}


script Starlight_Jukebox_Notice {
	textcolor(NPC_TEXT_COLOR_FEMALE)
    msgbox(
	"STARLIGHT: I'm amazed you managed\n"
	"to find this place! Congrats!\p"

	"This was the old Jukebox room I\n"
	"did. It was scrapped because it was\l"
	"pretty combersome compared to\l"
	"the actual Jukebox we use now.\p"

	"I have no idea why I made it this\n"
	"way originally, but I figured\l"
	"since I went to the work to make\l"
	"this, I might as well let people\l"
	"use it if they can figure out how\l"
	"to get here!\p"

	"It does have the base FireRed music\n"
	"and sounds also, as well as any\l"
	"music you can't find in the other\l"
	"jukebox so there's at least that!\p"

	"Also keep in mind, this was a beta\n"
	"map, so there might be bugs,\l"
	"issues or unfinished features, and\l"
	"we don't intend on fixing any of\l"
	"this.", MSGBOX_NPC)
}


