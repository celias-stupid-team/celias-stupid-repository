mapscripts SkyTower_2F_MapScripts {
    //On transition froslass on revisit
    MAP_SCRIPT_ON_TRANSITION {
        if(flag(FLAG_GOT_WIDE_CUT)) {
            setflag(FLAG_TEMP_A)
            setflag(FLAG_TEMP_B)
            setobjectxy(LOCALID_SKY_TOWER_FROSLASS, 18, 27)
        }
        setflag(FLAG_TEMP_B)
    }
}


script SkyTower_TeamForretress {
    lock
    playmoncry(SPECIES_FORRETRESS, CRY_MODE_DEFAULT)
    waitmoncry
    msgbox(
	"Woah!\n"
	"It's TEAM FORRETRESS!", MSGBOX_DEFAULT)
    release
}

script SkyTower_TeamForretress2 {
    lock
    playmoncry(SPECIES_FORRETRESS, CRY_MODE_DEFAULT)
    waitmoncry
    msgbox(
	"Wow!\n"
	"It's TEAM FORRETRESS 2!", MSGBOX_DEFAULT)
    release
}

script SkyTower_SentryHole {
    lock
    playse(SE_ITEMFINDER)
    textcolor(NPC_TEXT_COLOR_BLUE)
    msgbox(
	"POKéMON Detected!\n"
	"", MSGBOX_DEFAULT)
    specialvar(VAR_RESULT, GetPlayerAvatarBike)
    if(!var(VAR_RESULT)) {
        msgbox(
        "…{PAUSE 20}Wait a sec!\n"
        "That's no POKéMON!\l"
        "That's a HUMAN!\p"

        "HUMANS aren't allowed up here!\n"
        "Go away!", MSGBOX_DEFAULT)
        closemessage
        delay(20)
        applymovement(LOCALID_PLAYER, moves(
            walk_down
        ))
        waitmovement(0)
        release
        end
    } else {
        msgbox(
        "…{PAUSE 20}It's KORAIDON!\p"

        "Okay, you're good!\n"
        "Come on through!", MSGBOX_DEFAULT)
        setvar(VAR_TEMP_3, 1)
        release
        end
    }
}

script SkyTower_BikeHole {
    setplayermetatile(METATILE_NavelRock_Hole, FALSE)
    special(DrawWholeMapView)
    specialvar(VAR_RESULT, GetPlayerAvatarBike)
    if(var(VAR_RESULT)) {
        setvar(VAR_TEMP_1, 1)
        release
    } else {
        lock
        playse(SE_M_STRENGTH)
        waitse
        delay(30)
        playse(SE_FALL)
        applymovement(LOCALID_PLAYER, moves(
            set_invisible
        ))
        waitse
        setobjectxy(LOCALID_PLAYER, 8, 52)
        warphole(MAP_SKY_TOWER_1F)
        release
    }
}

script SkyTower_BikeHoleOutside {
    special(DrawWholeMapView)
    setvar(VAR_TEMP_1, 0)
    release
}


script SkyTower_TeamTeamHeroes {
    lock
    waitse
    playse(SE_LEDGE)
    applymovement(LOCALID_SKY_TOWER_SQUIRTLE_1, moves(
        jump_in_place_down
    ))
    waitse
    playse(SE_LEDGE)
    applymovement(LOCALID_SKY_TOWER_SQUIRTLE_2, moves(
        jump_in_place_down
    ))
    waitse
    playse(SE_LEDGE)
    applymovement(LOCALID_SKY_TOWER_SQUIRTLE_3, moves(
        jump_in_place_down
    ))
    waitse
    waitmovement(LOCALID_SKY_TOWER_SQUIRTLE_3)
    delay(20)
    textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"What's up?\n"
	"We're TEAM {PAUSE 10}TEAMHEROES!\p"

	"…{PAUSE 20}We wanted to just call ourselves\n"
	"“TEAM HEROES”, but…\l"
	"The application form was confusing.", MSGBOX_DEFAULT)
    release
}

script SkyTower_BikeHoles {
    setplayermetatile(METATILE_NavelRock_Hole, FALSE)
    special(DrawWholeMapView)
    release

}


script SkyTower_2F_Itemizer {
	lock
	
	setplayermetatile(METATILE_NavelRock_Itemizer, FALSE)
	call(EventScript_PlayerJumpInPlace)
	special(DrawWholeMapView)
	playse(SE_CLICK)
	waitse
	delay(30)
	if(!flag(FLAG_TEMP_C) || !flag(FLAG_GOT_WIDE_CUT)) {
		playse(SE_M_SPIT_UP)
        setflag(FLAG_TEMP_C)
		removeobject(LOCALID_SKY_TOWER_TRAP_FINDER)
		addobject(LOCALID_SKY_TOWER_ITEMIZER_ITEM)
	} else {
		msgbox(
		"The ITEMIZER trap had no effect…\n"
		"", MSGBOX_DEFAULT)
	}
	release
}

script SkyTower_2F_FindWideCut {
    setflag(FLAG_GOT_WIDE_CUT)
    finditem(ITEM_TM26)
}

script SkyTower_Sentry {
	msgbox(
	"I'm on SENTRY duty today.\p"

	"No HUMANS are gonna slip past me!\n"
	"", MSGBOX_NPC)
}

script SkyTower_2F_ThePit {
    playse(SE_CLICK)
    setlayouttiles(LAYOUT_SKY_TOWER_2F_PIT, 0,0,0,0,63, 51)
					setmaplayoutindex(LAYOUT_SKY_TOWER_2F_PIT)

    release
}


script SkyTower_2F_KillThePit {
    setlayouttiles(LAYOUT_SKY_TOWER_2F, 0,0,0,0,63, 51)
					setmaplayoutindex(LAYOUT_SKY_TOWER_2F)
    setmetatile(39, 20, METATILE_NavelRock_PitTrap, FALSE)
    special(DrawWholeMapView)
    setvar(VAR_TEMP_4, 1)
    release
}


script SkyTower_2F_DeadThePit {
	lock
	
	setplayermetatile(METATILE_NavelRock_PitTrap, FALSE)
	call(EventScript_PlayerJumpInPlace)
	special(DrawWholeMapView)
	playse(SE_CLICK)
	waitse
	delay(30)
	
		msgbox(
		"The THE PIT trap had no effect…\n"
		"", MSGBOX_DEFAULT)

	release
}

script SkyTower_2F_WideOak {
    lock
    textcolor(NPC_TEXT_COLOR_GREEN)
    msgbox(
	"O {PAUSE 3}A{PAUSE 3} K{PAUSE 3} :{PAUSE 3} H{PAUSE 3} I{PAUSE 3} ,{PAUSE 3} {PLAYER}{PAUSE 3}!\n"
    "H {PAUSE 3}O {PAUSE 3}W {PAUSE 3}' {PAUSE 3}S  {PAUSE 3}Y {PAUSE 3}O{PAUSE 3} U {PAUSE 3}R  {PAUSE 3}P {PAUSE 3}O {PAUSE 3}K {PAUSE 3}é {PAUSE 3}D {PAUSE 3}E {PAUSE 3}X {PAUSE 3}?"
	"", MSGBOX_DEFAULT)
    if(checkpartymove(MOVE_WIDE_SLASH) != PARTY_SIZE) {
        msgbox(
        "W {PAUSE 3}A {PAUSE 3}I {PAUSE 3}T {PAUSE 3},   {PAUSE 3}N {PAUSE 3}O {PAUSE 3}!\n"
        "S {PAUSE 3}T {PAUSE 3}O {PAUSE 3}P{PAUSE 3}!   {PAUSE 3}P{PAUSE 3} L {PAUSE 3}E {PAUSE 3}A {PAUSE 3}S {PAUSE 3}E {PAUSE 3}!", MSGBOX_DEFAULT)
        textcolor(NPC_TEXT_COLOR_NEUTRAL)
        msgbox(
	    "…Ignore him?\n"
        "", MSGBOX_YESNO)
        if(var(VAR_RESULT)) {
            checkpartymove(MOVE_WIDE_SLASH)
            setfieldeffectargument(0, VAR_RESULT)
            bufferpartymonnick(STR_VAR_1, VAR_RESULT)
            buffermovename(STR_VAR_2, MOVE_CUT)
            msgbox(Text_MonUsedMove)
            closemessage
            dofieldeffect(FLDEFF_USE_CUT_ON_TREE)
            waitstate
            applymovement(VAR_LAST_TALKED, moves(
                cut_tree
                set_invisible
            ))
            waitmovement(0)
            
            delay(10)
            applymovement(LOCALID_SKY_TOWER_OAK_1, moves(
                cut_tree
                set_invisible
            ))
            playse(SE_M_CUT)
            delay(15)
            applymovement(LOCALID_SKY_TOWER_OAK_2, moves(
                cut_tree
                set_invisible
            ))
            playse(SE_M_CUT)
            delay(15)
            applymovement(LOCALID_SKY_TOWER_OAK_3, moves(
                cut_tree
                set_invisible
            ))
            playse(SE_M_CUT)
            delay(15)
            applymovement(LOCALID_SKY_TOWER_OAK_4, moves(
                cut_tree
                set_visible
                face_down
            ))
            playse(SE_M_CUT)
            delay(15)
            applymovement(LOCALID_SKY_TOWER_OAK_5, moves(
                cut_tree
                set_invisible
            ))
            playse(SE_M_CUT)
            delay(15)
            applymovement(LOCALID_SKY_TOWER_OAK_6, moves(
                cut_tree
                set_invisible
            ))
            waitse
            removeobject(LOCALID_SKY_TOWER_OAK_1)
            removeobject(LOCALID_SKY_TOWER_OAK_2)
            removeobject(LOCALID_SKY_TOWER_OAK_3)
            removeobject(LOCALID_SKY_TOWER_OAK_5)
            removeobject(LOCALID_SKY_TOWER_OAK_6)
            removeobject(VAR_LAST_TALKED)
            waitmovement(LOCALID_SKY_TOWER_OAK_4)
            removeobject(LOCALID_SKY_TOWER_OAK_4)
            addobject(LOCALID_SKY_TOWER_OAK_4)
            applymovement(LOCALID_SKY_TOWER_OAK_4, moves(
                face_down
                set_visible
                jump_in_place_down
            ))
            waitmovement(LOCALID_SKY_TOWER_OAK_4)
            delay(20)
            msgbox(
            "Hey! OAK wants to join your team!\n"
            "Will you accept OAK as a member?", MSGBOX_YESNO)
            if(var(VAR_RESULT)) {
                playfanfare(MUS_LEVEL_UP)
                msgbox(
                "OAK joined your team!\n"
                "", MSGBOX_DEFAULT)
                removeobject(LOCALID_SKY_TOWER_OAK_4)
                msgbox(
                "OAK left to wait for you in\n"
                "the FRIEND AREA.", MSGBOX_DEFAULT)
                setflag(FLAG_OAK_IN_FRIEND_AREA)
                release
                end
            } else {
                removeobject(LOCALID_SKY_TOWER_OAK_4)
                release
                end
            }
        }

    }
    release
    end
}

script SkyTower_EnableHoles {
    setvar(VAR_TEMP_6, 1)
    release
}