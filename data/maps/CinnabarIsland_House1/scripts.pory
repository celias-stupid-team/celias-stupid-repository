mapscripts CinnabarIsland_House1_MapScripts {

}


script CinnabarIsland_ColorblindNPC {
	lock
	faceplayer
	msgbox("Bah, kids these days.\p"

	"All I wanted was for someone\n"
	"to bring me a GREEN POKéMON.\p"

	"Day after day, they give me\n"
	"GARDEVOIRS or SEWADDLES.\p"

	"Not ONCE have they given me a\n"
	"BRONZOR, or an APPLIN, or even\l"
	"a DRAGAPULT!\p"

	"I guess that's just the price\n"
	"of colorblindness…", MSGBOX_DEFAULT)
	if(checkpartymonslot(SPECIES_GOLURK) == 0) {
		bufferpartymonnick(STR_VAR_1, 0)
		msgbox(
		"Ah, I see your GOLURK there!\p"

		"You're a fellow purveyor of GREEN\n"
		"POKéMON, I take it?\l"
		"Lovely to hear!\p"

		"I found a lovely GREEN POKéMON in\n"
		"the wild just yesterday, in fact.\p"

		"Would you be open to a trade?\n"
		"My GREEN POKéMON for your GOLURK?", MSGBOX_YESNO)
		if(var(VAR_RESULT)) {
			
		} else {
			msgbox(
			"Ah, what a shame!\p"

			"Let me know if you change your\n"
			"mind.", MSGBOX_DEFAULT)
			release
			end
		}
	} else {
		release
		end
	}
}

script CinnabarIsland_ColorblindNPC_2 {
	msgbox("I've always wanted to see a RED\n"
	"POKéMON.\p"

	"There was one kid who tried to show\n"
	"me a GYARADOS he caught in a LAKE.\l"
	"Pah!\p"

	"He said it's special, but he\n"
	"can't fool me!\p"

	"I know that GYARADOS is BLUE, and\n"
	"nothing can change that!", MSGBOX_NPC)
}

script CinnabarIsland_ColorblindOak {
	msgbox(
	"It's not quite OAK.\n"
	"", MSGBOX_SIGN)

}

script CinnabarIsland_NotOak {
	msgbox(
	"It's not OAK.\n"
	"", MSGBOX_SIGN)

}
