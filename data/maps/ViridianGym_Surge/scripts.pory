mapscripts ViridianGym_Surge_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if(var(VAR_CURRENT_DMCA_PHASE) < 3) {
            setvar(VAR_CURRENT_DMCA_PHASE, 3)
        }
        setrespawn(HEAL_LOCATION_VIRIDIAN_GYM_SURGE)
        switch(var(VAR_CURRENT_DMCA_PHASE)) {
            case 1:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM, 3)
            case 2:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_2, 3)
            case 3:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_3, 3)
            case 4:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_4, 3)
            case 5:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_5, 3)
            case 6:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_6, 3)
            case 7:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_7, 3)
            case 8:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_8, 3)
            case 9:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_9, 3)
        }
        if(flag(FLAG_DMCA_SURGE_FIRST_GATE)) {
            call(ViridianGym_Surge_DrawFirstGateOpen)
        }
        if(flag(FLAG_DMCA_SURGE_SECOND_GATE)) {
            call(ViridianGym_Surge_DrawSecondGateOpen)

        }
    }
}


script ViridianGym_Surge_Grunt {
	msgbox(
	"Those trash cans were all copies\n"
	"of each other!", MSGBOX_NPC)
}


script ViridianGym_Surge_TrashCan {
    lock
    if(flag(FLAG_DMCA_SURGE_FIRST_GATE)) {
        msgbox(
        "trash\n"
        "", MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(
    "Hey!\n"
    "There's a secret switch!\p"

    "…Well, maybe it's not THAT secret.\n"
    "", MSGBOX_DEFAULT)
    //unlock stuff
    playse(SE_UNLOCK)
    setflag(FLAG_DMCA_SURGE_FIRST_GATE)
    call(ViridianGym_Surge_DrawFirstGateOpen)
    special(DrawWholeMapView)
    release
}




script ViridianGym_SurgeBattle {
    lock
    textcolor(NPC_TEXT_COLOR_BLUE)
    msgbox(
	"I am the lightning japanese person\n"
	"", MSGBOX_DEFAULT)
    trainerbattle_no_intro(TRAINER_DMCA_SURGE, ViridianGym_SurgeBattle_End)
    if(checkpartymon(SPECIES_PORYGON_Z) != PARTY_SIZE) {
        textcolor(NPC_TEXT_COLOR_NEUTRAL)
        msgbox(
        "He sends out a DIGIMON, which uses\n"
        "ADOBE FLASH.\p"

        "ADOBE FLASH will obviously go\n"
        "through SICK SHADES.\p"

        "You did not have the solution to\n"
        "the fight.\l"
        "You will die now.", MSGBOX_DEFAULT)
        goto(EventScript_FieldWhiteOutNoMoney)
        end
    }
    call(ViridianGym_Surge_DrawSecondGateOpen)
    msgbox(
	"i'm dead\n"
	"", MSGBOX_NPC)
}

text ViridianGym_SurgeBattle_Start {
    "Ah\n"
}


text ViridianGym_SurgeBattle_End {
   "oh no\n"
	"dead"
}

script ViridianGym_Surge_DrawFirstGateOpen {
    setmetatile(4, 14, METATILE_VermilionGym_Beam_Node_TopLeft_Off, FALSE)
    setmetatile(4, 15, METATILE_VermilionGym_Beam_Node_BottomLeft_Off, FALSE)
    setmetatile(5, 14, METATILE_VermilionGym_Beam_Node_TopLeft_Edge_Off, FALSE)
    setmetatile(5, 15, METATILE_VermilionGym_Beam_Node_BottomLeft_Edge_Off, FALSE)
    setmetatile(6, 14, METATILE_VermilionGym_Floor, FALSE)
    setmetatile(6, 15, METATILE_VermilionGym_Floor, FALSE)
    setmetatile(7, 14, METATILE_VermilionGym_Beam_Node_TopRight_Edge_Off, FALSE)
    setmetatile(7, 15, METATILE_VermilionGym_Beam_Node_BottomRight_Edge_Off, FALSE)
    setmetatile(8, 14, METATILE_VermilionGym_Beam_Node_TopRight_Off, FALSE)
    setmetatile(8, 15, METATILE_VermilionGym_Beam_Node_BottomRight_Off, FALSE)
    
    return
}


script ViridianGym_Surge_DrawSecondGateOpen {
    setflag(FLAG_DMCA_SURGE_SECOND_GATE)
    setmetatile(4, 6, METATILE_VermilionGym_Beam_Node_TopLeft_Off, FALSE)
    setmetatile(4, 7, METATILE_VermilionGym_Beam_Node_BottomLeft_Off, FALSE)
    setmetatile(5, 6, METATILE_VermilionGym_Beam_Node_TopLeft_Edge_Off, FALSE)
    setmetatile(5, 7, METATILE_VermilionGym_Beam_Node_BottomLeft_Edge_Off, FALSE)
    setmetatile(6, 6, METATILE_VermilionGym_Floor, FALSE)
    setmetatile(6, 7, METATILE_VermilionGym_Floor, FALSE)
    setmetatile(7, 6, METATILE_VermilionGym_Beam_Node_TopRight_Edge_Off, FALSE)
    setmetatile(7, 7, METATILE_VermilionGym_Beam_Node_BottomRight_Edge_Off, FALSE)
    setmetatile(8, 6, METATILE_VermilionGym_Beam_Node_TopRight_Off, FALSE)
    setmetatile(8, 7, METATILE_VermilionGym_Beam_Node_BottomRight_Off, FALSE)
    special(DrawWholeMapView)
    return
}