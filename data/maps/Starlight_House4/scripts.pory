mapscripts Starlight_House4_MapScripts {

MAP_SCRIPT_ON_TRANSITION {
		if(flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
			setflag(FLAG_TEMP_8)
        }
            if(flag(FLAG_CSR_CELIA_BONUS)) {
			setflag(FLAG_TEMP_8)
		}
		if(flag(FLAG_DAK_HERE)) {
			setflag(FLAG_TEMP_8)
		}
		random(75)
		setflag(FLAG_TEMP_19)
		if(var(VAR_RESULT) == 22 && !flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
			clearflag(FLAG_TEMP_19)
		}
		if (var(VAR_BONUS_STARS) == 1023) {
		random(90)
		if(var(VAR_RESULT) == 22 && !flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
			clearflag(FLAG_TEMP_19)
		}
		}
	}


    
MAP_SCRIPT_ON_LOAD {
	if(flag(FLAG_POST_GAME)) {
		setmetatile(22, 2, METATILE_Starlight_Interior_StarlightFloor, FALSE)
	}
}

}

script Starlight_House4_Post_Game {
	if(flag(FLAG_POST_GAME)) {
	msgbox(
		"Come back now.", MSGBOX_SIGN)

	} else {
	msgbox(
		"Come back post game.", MSGBOX_SIGN)

	}

}