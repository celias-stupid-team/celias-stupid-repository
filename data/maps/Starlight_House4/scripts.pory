mapscripts Starlight_House4_MapScripts {

MAP_SCRIPT_ON_TRANSITION {
		if(flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
			setflag(FLAG_TEMP_8)
        }
            if(flag(FLAG_CSR_CELIA_BONUS)) {
			setflag(FLAG_TEMP_8)
		}
		if(flag(FLAG_DAK_HERE)) {
			setflag(FLAG_TEMP_8)
		}
		
	}
MAP_SCRIPT_ON_LOAD {
	if(flag(FLAG_POST_GAME)) {
		setmetatile(22, 2, METATILE_Starlight_Interior_StarlightFloor, FALSE)
	}
}

}

script Starlight_House4_Under_Construction {
	msgbox(
	"This room is under construction.", MSGBOX_SIGN)

}

script StarlightHouse_YouForgotSomething {
	msgbox(
	"This used to be under construction\n"
	"but Starlight forgot to remove the\l"
	"sign here.", MSGBOX_SIGN)

}
//*.* whoops lol - Starlight

script Starlight_House4_Post_Game_Scrapped {
	msgbox(
	"Come back when you are ready.\p"
	"When that will be is determined by\n"
	"your experience.\p"
	"See you at the finish line!", MSGBOX_SIGN)

}

script Starlight_House4_Post_Game {
	if(flag(FLAG_POST_GAME)) {
	msgbox(
		"Come back now.\p", MSGBOX_SIGN)

	} else {
	msgbox(
		"Come back post game.\p", MSGBOX_SIGN)

	}

}