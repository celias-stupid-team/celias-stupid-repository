mapscripts PalletTown_BobOmb_Battlefield_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        if(flag(FLAG_RELEASED_CHOMP)) {
            setobjectmovementtype(VAR_LAST_TALKED, MOVEMENT_TYPE_FACE_UP)

        }
    }

}


script BobOmbBattlefield_ChainChomp {
	lock
    waitse
    playmoncry(SPECIES_STOUTLAND, CRY_MODE_ENCOUNTER)
    waitmoncry
    release
	end
}

script BobOmbBattlefield_Stump {
    if(flag(FLAG_RELEASED_CHOMP)) {
        msgbox("A pounded-in stump.\n", MSGBOX_SIGN)
        end
    } else {
        lockall
        msgbox("A stump sits in front of the\ngate.", MSGBOX_DEFAULT)
        if(checkpartymove(MOVE_GROUND_POUND) < PARTY_SIZE) {
            
            msgbox("Would you like to pound it using\nGROUND POUND?", MSGBOX_YESNO)
            if(var(VAR_RESULT)) {
                checkpartymove(MOVE_GROUND_POUND)
                bufferpartymonnick(STR_VAR_1, VAR_RESULT)
                buffermovename(STR_VAR_2, MOVE_GROUND_POUND)
                msgbox(Text_MonUsedMove)
                closemessage
                delay(30)
                applymovement(VAR_LAST_TALKED, Common_Movement_FaceUp)
                waitmovement(0)
                delay(30)
                removeobject(LOCALID_CHOMP)
                delay(40)
                applymovement(LOCALID_STAR, StarComesDown)
                waitmovement(0)
                setflag(FLAG_RELEASED_CHOMP)
                setobjectmovementtype(VAR_LAST_TALKED, MOVEMENT_TYPE_FACE_UP)
            }
        }
        releaseall
        end

    }
}

movement ChompRunsOff {
    walk_fast_up * 6
}

script BobOmbBattlefield_CeliaSecretEmpty {
	msgbox("Why'd I leave a big empty space\nwith nothing in it?\pGood question!\n", MSGBOX_NPC)
	end
}

script BobOmbBattlefield_CeliaSecretCoins {
	msgbox("I wanted to have Game Corner\nCoins under the bridge, as a\lsilly way to call attention to the\lgenre mismatch here.\pAlas, I couldn't figure out how to\nmake it not break getting 9999\lcoins in the game corner.", MSGBOX_NPC)
	end
}

script BobOmbBattlefield_CeliaSecretRock {
	msgbox("This rock is here cuz the orange\ncliff color looked awful under\lthe wire fence.\pI covered it up with a rock instead\nand hoped no one would notice.", MSGBOX_NPC)
	end
}

script BobOmbBattlefield_Star {
    lock
    removeobject(VAR_LAST_TALKED)
    playfanfare(MUS_LEVEL_UP)
    msgbox("{PLAYER} found a STARMIE!\n", MSGBOX_DEFAULT)
    waitfanfare
    setflag(FLAG_SHINY_CREATION) // Starmie
    setvar(VAR_CSR_GIFT_POKEMON, SPECIES_STARMIE)
    call(Common_Script_GiftPokemonStarmie)
    release
    end
}


script Common_Script_GiftPokemonStarmie {
	copyvar(VAR_TEMP_1, VAR_CSR_GIFT_POKEMON)
	givemon(VAR_CSR_GIFT_POKEMON, 30, ITEM_STAR_PIECE)
	clearflag(FLAG_SHINY_CREATION)
	switch(var(VAR_RESULT)) {
		case 0: //Mon goes to party
			bufferspeciesname(STR_VAR_1, VAR_CSR_GIFT_POKEMON)
			msgbox(Text_GiveNicknameToThisMon, MSGBOX_YESNO)
			if(!var(VAR_RESULT)) {
				return
			}
			call(EventScript_GetGiftMonPartySlot)
			call(EventScript_ChangePokemonNickname)
			return
		case 1: //Mon goes to PC
				bufferspeciesname(STR_VAR_1, VAR_CSR_GIFT_POKEMON)
				msgbox(Text_GiveNicknameToThisMon, MSGBOX_YESNO)
				if(var(VAR_RESULT) == 0) {
					call(EventScript_TransferredToPC)
					return
				} else {
					call(EventScript_NameReceivedBoxMon)
					call(EventScript_TransferredToPC)
					return //This can be simplified; I'll deal with it later
				}
				
				return
		case 2:
			goto(EventScript_NoMoreRoomForPokemon)
			break
	}
}



movement StarComesDown {
    walk_down * 3
}

script BoB_Buddy1 {
	msgbox("Hey, there!\nWelcome to BOB-OMB BATTLEFIELD!\p…What's that?\pYou think you've stumbled into\nthe wrong game?\lUh huh.\pWell, I hope you enjoy your stay!", MSGBOX_NPC)
	end
}

script BoB_Buddy2 {
	msgbox("Down this hole is a CANNON.\nWe use it to launch our friends!\pIf you need to leave, just jump\nin!", MSGBOX_NPC)
	end
}


script BobOmbBattlefield_EventScript_Cannon {
	lock
	msgbox("There's a cannon down the hole.\nWould you like to launch yourself?", MSGBOX_YESNO)
	if(var(VAR_RESULT) == YES) {
		closemessage
		delay(15)
		playse(SE_LEDGE)
		switch(var(VAR_FACING)) {
			case DIR_NORTH:
				applymovement(LOCALID_PLAYER, JumpUp)
				break
			case DIR_SOUTH:
				applymovement(LOCALID_PLAYER, JumpDown)
				break
			case DIR_EAST:
				applymovement(LOCALID_PLAYER, JumpRight)
				break
			case DIR_WEST:
				applymovement(LOCALID_PLAYER, JumpLeft)
				break
		}
		waitmovement(0)
		setmetatile(31,32,0x075,0)
        special(SpawnCameraObject)
		applymovement(LOCALID_PLAYER, FallIntoHole)
		waitmovement(0)
		delay(30)
        addobject(LOCALID_CANNON)
        setobjectxy(LOCALID_CANNON, 31, 37)
        applymovement(LOCALID_CANNON, BoB_CannonLaunch)
        waitmovement(0)
        delay(30)
        playse(SE_BANG)
        applymovement(OBJ_EVENT_ID_PLAYER, BoB_PlayerIsLaunched)
        waitmovement(0)
		
		fadescreenswapbuffers(FADE_TO_BLACK)

		//player faces down
		//spawn camera
		//camera locks in place
		//cannon comes up out of the ground
		//player locks facing direction
		//player slides up very quickly until off screen
		
		warp(MAP_PALLET_TOWN_RIVALS_HOUSE, 3)

	}
	release
	end
}

movement BoB_PlayerIsLaunched {
    face_up
    set_visible
    walk_fastest_up * 7
}

movement BoB_CannonLaunch {
    walk_slow_up
    delay_16
    face_right
    delay_8
    face_down
    delay_16
}

movement JumpUp {
	jump_up
	set_invisible
}
movement JumpDown {
	jump_down
	set_invisible
}
movement JumpLeft {
	jump_left
	set_invisible
}
movement JumpRight {
	jump_right
	set_invisible
}


