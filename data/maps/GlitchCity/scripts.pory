mapscripts GlitchCity_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        if(flag(FLAG_CELIA_SECRET_FUCHSIA)) {
            call(GlitchCity_DrawNoItem)
        }
        setflag(FLAG_SHINY_CREATION)
    }
}

script GlitchCity_CeliaItem {
    if(flag(FLAG_CELIA_SECRET_FUCHSIA)) {
        msgbox("    ???\n", MSGBOX_SIGN)
        end
    } else {
        lock
        call(GlitchCity_DrawNoItem)
        special(DrawWholeMapView)
        setflag(FLAG_CELIA_SECRET_FUCHSIA)
        playfanfare(MUS_OBTAIN_ITEM)
        msgbox("{PLAYER} found 1    ?>?>\n+RRHKé NNCCKé2i9()_éJ{UP_ARROW}f fjklo0IIO< jfld\n{SUPER_ER}{SUPER_ER}{SUPER_ER}{SUPER_ER}{SUPER_ER}{SUPER_ER}{SUPER_ER}{SUPER_ER}{SUPER_ER}{SUPER_ER}{SUPER_ER}{SUPER_ER}{SUPER_ER}", MSGBOX_DEFAULT)
        delay(40)
        setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 4)
        setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 4)
        setvar(VAR_SHAKESCREEN_NUM_SHAKES, 30)
        setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
        special(ShakeScreen)
        delay(120)
        closemessage
        delay(60)
        addobject(LOCALID_8BIT_CELIA)
        applymovement(LOCALID_8BIT_CELIA, moves(
            walk_slow_down * 3
            face_right
            delay_4
            set_invisible
            delay_4
            set_visible
            face_right
            delay_4
            walk_slow_down
            delay_16
            walk_slow_down * 2
            face_down
        ))
        waitmovement(0)
        textcolor(NPC_TEXT_COLOR_FEMALE)
        delay(20)
        msgbox("Hiya!\nUh, I'm CELIA the creator.\pI think that ITEM isn't playing\nnicely with your BAG.\lD'ya mind if I have it back?", MSGBOX_DEFAULT)
        closemessage
        textcolor(NPC_TEXT_COLOR_NEUTRAL)
        delay(20)
        msgbox("CELIA took the     ?>?>\n+RRHKé NNCCKé2i9()_éJ{UP_ARROW}f fjklo0IIO<", MSGBOX_DEFAULT)
        closemessage
        delay(30)
        textcolor(NPC_TEXT_COLOR_FEMALE)
        msgbox("Ah, there we go.\nDon't want anything bad to happen!\pBut! While you're here, how about\nI give you somewhere else to go…", MSGBOX_DEFAULT)
        closemessage
        setvar(VAR_CSR_CURRENT_CELIA_SECRET, CELIA_SECRET_FUCHSIA)
        call(CeliaSecrets_CeliaTellsYouNextHint)
        delay(20)
        applymovement(LOCALID_8BIT_CELIA, moves(
            walk_slow_up * 2
            walk_slow_right
            delay_16
            face_up
            delay_4
            set_invisible
            delay_4
            set_visible
            face_up
            delay_4
            walk_slow_right
            delay_16 * 3
            set_invisible
        ))
        waitmovement(0)
        delay(60)
        release
        end

    }
}

script GlitchCity_DrawNoItem {
    setmetatile(17, 25, 0x280, FALSE)
    return
}