raw `

`
mapscripts MtMoon_B1F_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setbench(BENCH_MT_MOON_BASEMENT)
		setflag(FLAG_CSR_MAP_MT_MOON_BASEMENT)
		call(SetPlayerPokedexValues)
		if(flag(FLAG_DRILLED_MT_MOON_HOLE)) {
			setmaplayoutindex(LAYOUT_MT_MOON_B1F_LAYOUT_DRILLED)
		}
	}
}
	

script MtMoon_Basement_DrillWall {
	lock
	if(!checkitem(ITEM_DRILL_DOZER)) {
		msgbox(
		"There's a hole in the wall…\n"
		"", MSGBOX_DEFAULT)
		release
		end
	}
	msgbox(
	"There's a hole in the wall…\n"
	"Would you like to DRILL it?", MSGBOX_YESNO)
	if(var(VAR_RESULT)) {
					fadescreenswapbuffers(FADE_TO_BLACK)
					setflag(FLAG_DRILLED_MT_MOON_HOLE)
					removeobject(VAR_LAST_TALKED)
					setlayouttiles(LAYOUT_MT_MOON_B1F_LAYOUT_DRILLED, 0, 0, 0, 0, 62, 39)
					special(DrawWholeMapView)
					playse(SE_M_HORN_ATTACK)
					delay(10)
					playse(SE_M_HORN_ATTACK)
					delay(10)
					playse(SE_M_HORN_ATTACK)
					delay(10)
					playse(SE_M_HORN_ATTACK)
					delay(10)
					playse(SE_M_HORN_ATTACK)
					delay(30)
					fadescreenswapbuffers(FADE_FROM_BLACK)
					release
					end

	}
	msgbox(
	"Who the fuck says No here?\n"
	"", MSGBOX_DEFAULT)	
	release
}

script MtMoon_EventScript_DadWeather {
	lock
	faceplayer
	textcolor(0)
	msgbox("DAD: {PLAYER}!\nWhat are you doing out here?\pGee, it's such a lovely day\nwe're having down here!\lIt's so bright and sunny!\pWell, never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	setflag(FLAG_DAD_MTMOON_B1F)
	release
	end
}

script MtMoon_EventScript_BasementSign {
	lock
	if(flag(FLAG_CSR_MT_MOON_BASEMENT_SIGN)) {
		msgbox("MT MOON BASEMENT\nNEW WILD POKéMON: 1\p(yes, it's the same as the others)\n", MSGBOX_SIGN)
	} else {
		msgbox("MT MOON BASEMENT\nNEW WILD POKéMON: 1", MSGBOX_SIGN)
		setflag(FLAG_CSR_MT_MOON_BASEMENT_SIGN)
		end
	}
}


script MtMoon_EventScript_MoveLass {
	if(!defeated(TRAINER_CSR_MT_MOON_END_LASS)) {
		addobject(LOCALID_MOON_LASS)
		setobjectxy(LOCALID_MOON_LASS, 53, 19)
	}
	setvar(VAR_TEMP_1, 1)
}

script MtMoon_EventScript_AetherShortcut {
	msgbox(
	"MT. MOON\n"
	"Shortcut {RIGHT_ARROW}", MSGBOX_SIGN)

}


script MtMoon_EventScript_HyperDrill {
	trainerbattle_single(TRAINER_PORYGON22, "I learned this neat move\ncalled HYPER DRILL.\pCheck out the POKéMON I evolved!", "Whoa now!")
	msgbox(
	"I've been stuck in this part of\n"
	"the cave for weeks.\p"

	"No clue how I'm supposed to get\n"
	"out.", MSGBOX_NPC)
}


script MtMoon_Lichen {
	textcolor(NPC_TEXT_COLOR_RED)
	lock
	waitse
	playse(SE_LEDGE)
	applymovement(VAR_LAST_TALKED, moves(
		set_visible
		jump_in_place_down
	))
	waitmovement(0)
	delay(20)
	faceplayer
	if(checktrainerflag(TRAINER_LICHEN)) {
		msgbox(
		"Hey, hey!\n"
		"Let me sleep!\p"

		"I've been working on this game so\n"
		"late that I forgot to…", MSGBOX_DEFAULT)
		release
		end
		}
	msgbox(
	"LICHEN: Whoa, you found me!\p"

	"You're some kinda secret hunter\n"
	"completionist type, aren't cha?\p"

	"You wanna see ALL the sprites I\n"
	"made, huh?\l"
	"Let's tussle!", MSGBOX_DEFAULT)
	trainerbattle_no_intro(TRAINER_LICHEN, "Yessssss")

		msgbox(
		"Damn, I really thought that one\n"
		"would stump you.\p"

		"I fell for the “SUNKERN Cost\n"
		"Fallacy” a little there.\p"

		"Anyway, good work!\n"
		"I have a gift for you…", MSGBOX_DEFAULT)
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		giveitem_msg("{PLAYER} got the\nSCOPE CREEP!", ITEM_SCOPE_CREEP, 1)
		textcolor(NPC_TEXT_COLOR_RED)
		msgbox(
	"My sprites gave thsi game so much\n"
	"SCOPE CREEP, but now that we're\l"
	"done, we don't need it anymore.\p"

	"I'm sure there's something you\n"
	"can use this for…", MSGBOX_DEFAULT)


	release
	end
	
}
