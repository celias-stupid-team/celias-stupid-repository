raw `

`
mapscripts MtMoon_B1F_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setbench(BENCH_MT_MOON_BASEMENT)
		setflag(FLAG_CSR_MAP_MT_MOON_BASEMENT)
		call(SetPlayerPokedexValues)
	}
}
	



script MtMoon_EventScript_DadWeather {
	lock
	faceplayer
	textcolor(0)
	msgbox("DAD: {PLAYER}!\nWhat are you doing out here?\pGee, it's such a lovely day\nwe're having down here!\lIt's so bright and sunny!\pWell, never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	setflag(FLAG_DAD_MTMOON_B1F)
	release
	end
}

script MtMoon_EventScript_BasementSign {
	lock
	if(flag(FLAG_CSR_MT_MOON_BASEMENT_SIGN)) {
		msgbox("MT MOON BASEMENT\nNEW WILD POKéMON: 1\p(yes, it's the same as the others)\n", MSGBOX_SIGN)
	} else {
		msgbox("MT MOON BASEMENT\nNEW WILD POKMON: 1", MSGBOX_SIGN)
		setflag(FLAG_CSR_MT_MOON_BASEMENT_SIGN)
		end
	}
}


const LASS = 4
script MtMoon_EventScript_MoveLass {
	if(!defeated(TRAINER_CSR_MT_MOON_END_LASS)) {
		addobject(LASS)
		setobjectxy(LASS, 39, 18)
	}
	setvar(VAR_TEMP_1, 1)
}

