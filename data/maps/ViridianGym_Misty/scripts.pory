mapscripts ViridianGym_Misty_MapScripts {
        MAP_SCRIPT_ON_TRANSITION {
        if(var(VAR_CURRENT_DMCA_PHASE) < 2) {
            setvar(VAR_CURRENT_DMCA_PHASE, 2)
        }
        if(var(VAR_CURRENT_DMCA_PHASE) > 2) {
            setmaplayoutindex(LAYOUT_VIRIDIAN_GYM_MISTY_BRIDGE)
            setobjectxy(LOCALID_DMCA_YUGIOH, 5, 2)
            setvar(VAR_TEMP_0, 1)
        }

        setrespawn(HEAL_LOCATION_VIRIDIAN_GYM_MISTY)
        switch(var(VAR_CURRENT_DMCA_PHASE)) {
            case 1:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM, 2)
            case 2:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_2, 2)
            case 3:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_3, 2)
            case 4:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_4, 2)
            case 5:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_5, 2)
            case 6:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_6, 2)
            case 7:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_7, 2)
            case 8:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_8, 2)
            case 9:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_9, 2)
        }
    }
}

script ViridianGym_MistyDead {
    textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox(
	"Her mind has been crushed.\n"
	"", MSGBOX_SIGN)

}


script ViridianGym_MistyBattle {
    lock
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(
        walk_slow_up * 5
    ))
    waitmovement(0)
    delay(30)
    textcolor(NPC_TEXT_COLOR_FEMALE)
    msgbox(
	"ARIANA: Hello, child.\n"
	"You think you can defeat us?\p"

	"I hear you've proven yourself in\n"
	"the POKéMON TCG?\l"
	"Very well.\p"

	"How about you try THIS game on\n"
	"for size?", MSGBOX_DEFAULT)
    special(RemoveCameraObject)
    trainerbattle_no_intro(TRAINER_DMCA_MISTY, ViridianGym_MistyBattle_End)
    if(checkpartymove(MOVE_TRUMP_CARD) == PARTY_SIZE) {
        textcolor(NPC_TEXT_COLOR_NEUTRAL)
        msgbox(
        "She sends out three BLUE EYES\n"
        "WHITE DRAGONS.\p"

        "Her WHITE LIGHTNING ATTACK will\n"
        "destroy all POKéMON you use.\p"

        "You did not have the solution to\n"
        "the fight.\l"
        "You will die now.", MSGBOX_DEFAULT)
        goto(EventScript_FieldWhiteOutNoMoney)
    } else {
        msgbox(
        "Gah-!\n"
        "", MSGBOX_DEFAULT)
        closemessage
        playse(SE_M_REVERSAL)
        waitse
        fadescreeninstant(FADE_TO_WHITE)
        delay(5)
        fadescreeninstant(FADE_FROM_WHITE)
        playse(SE_M_MEGA_KICK2)
        applymovement(LOCALID_DMCA_YUGIOH, moves(
            lock_facing_direction
            slide_up * 3
        ))
        waitmovement(LOCALID_DMCA_YUGIOH)
        waitse
        delay(60)
        special(SpawnCameraObject)
        applymovement(LOCALID_CAMERA, moves(
            walk_slow_down * 5
        ))
        waitmovement(0)
        setobjectxy(LOCALID_DMCA_YUGIOH, 5, 2)
        copyobjectxytoperm(LOCALID_DMCA_YUGIOH)
        delay(30)
        playse(SE_CLICK)
        setvar(VAR_TEMP_0, 1)
        setlayouttiles(LAYOUT_VIRIDIAN_GYM_MISTY_BRIDGE, 0,0,0,0,19, 20)
        special(RemoveCameraObject)
        release
        end

    }
}

text ViridianGym_MistyBattle_Start {
    "yugioh me\n"
}


text ViridianGym_MistyBattle_End {
	"HOOPA-UNBOUND!?\n"
    "That's impossible!"
}