mapscripts ViridianGym_Misty_MapScripts {
        MAP_SCRIPT_ON_TRANSITION {
        if(var(VAR_CURRENT_DMCA_PHASE) < 2) {
            setvar(VAR_CURRENT_DMCA_PHASE, 2)
        }
        setrespawn(HEAL_LOCATION_VIRIDIAN_GYM_MISTY)
        switch(var(VAR_CURRENT_DMCA_PHASE)) {
            case 1:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM, 2)
            case 2:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_2, 2)
            case 3:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_3, 2)
            case 4:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_4, 2)
            case 5:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_5, 2)
            case 6:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_6, 2)
            case 7:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_7, 2)
            case 8:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_8, 2)
            case 9:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_9, 2)
        }
    }
}

script ViridianGym_MistyBattle {
    trainerbattle_single(TRAINER_DMCA_MISTY, ViridianGym_MistyBattle_Start, ViridianGym_MistyBattle_End)
    msgbox(
	"i'm dead\n"
	"", MSGBOX_DEFAULT)
}

text ViridianGym_MistyBattle_Start {
    "yugioh me\n"
}


text ViridianGym_MistyBattle_End {
   "oh no\n"
	"exodia"
}