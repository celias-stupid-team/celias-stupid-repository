raw `
FushciaCity_House1_MapScripts::
	.byte 0

FushciaCity_House1_EventScript_Woman::
	msgbox FushciaCity_House1_Text_WardenIsOldHasFalseTeeth, MSGBOX_NPC
	end

FushciaCity_House1_EventScript_OldMan::
	lock
	faceplayer
	msgbox FushciaCity_House1_Text_BillIsMyGrandson
	release
	end

FushciaCity_House1_EventScript_LittleBoy::
	msgbox FushciaCity_House1_Text_BillFilesHisOwnMonData, MSGBOX_NPC
	end
`
script FushciaCity_House1_PorygonHint {
	lock
	waitse
	playse(SE_PIN)
	setflag(FLAG_CSR_HINT_SPAM)
	call(SetPlayerPokedexValues)
	applymovement(VAR_LAST_TALKED, Common_Movement_ExclamationMark)
	delay(60)
	famechecker(FAMECHECKER_FUSHCIA, 3)
	msgbox("Ah, confound it!")
	closemessage
	faceplayer
	msgbox("I clicked on one of those darned\npop-up windows.\pRats, I hope I didn't install a\nvirus on my POKéMON again…", MSGBOX_DEFAULT)
	applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
}

script FushciaCity_House1_Kid {
	msgbox("Technology is incredible!\pNow even grandpa can put POKéMON\nin the PC!", MSGBOX_NPC)
	end
}