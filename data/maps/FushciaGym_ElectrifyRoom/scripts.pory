mapscripts FushciaGym_ElectrifyRoom_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        if(checktrainerflag(TRAINER_FUSHCIA_GYM_LANCE) || flag(FLAG_MURDERED_LANCE)) {
            call(FushciaGym_ElectrifyRoom_OpenDoor)

        } else {
            setflag(FLAG_TEMP_4)
        }
        if(flag(FLAG_MURDERED_LANCE)) {
            setflag(FLAG_TEMP_4)

        }
        setrespawn(HEAL_LOCATION_FUSHCIA_GYM_ELECTRIFY_ROOM)
    }
}

script FushciaGym_ElectrifyRoom_OpenDoor {
    setmetatile(10, 6, 0x3A6, TRUE)
    setmetatile(10, 7, 0x357, TRUE)
    return
}

script FushciaGym_ElectrifyRoom_Lance {
    lock
    faceplayer

    
    
    if(!(checkpartymove(MOVE_HYPER_BEAM) == PARTY_SIZE)) {
        msgbox("I am LANCE of the ELITE FOUR!\n{PAUSE 30}…Wait-! No!\lDon't!", MSGBOX_DEFAULT)
        textcolor(NPC_TEXT_COLOR_NEUTRAL)
            fadenewbgm(MUS_NONE)
        msgbox("Your TAUROS looks excited.\pWould you like to use\nHYPER BEAM?", MSGBOX_YESNO)
        if(var(VAR_RESULT)) {
            // Hyper Beam Happens
            closemessage
            fadescreen(FADE_TO_BLACK)
            delay(30)
            playmoncry(SPECIES_TAUROS, CRY_MODE_DEFAULT)
            waitmoncry
            setflag(FLAG_MURDERED_LANCE)
            removeobject(VAR_LAST_TALKED)
            settrainerflag(TRAINER_FUSHCIA_GYM_LANCE)
            call(FushciaGym_ElectrifyRoom_OpenDoor)
            special(DrawWholeMapView)
            fadedefaultbgm
            fadescreen(FADE_FROM_BLACK)
            delay(30)
            playfanfare(MUS_LEVEL_UP)
            msgbox("{PLAYER} obtained the\nleftover GYARADOS!", MSGBOX_DEFAULT)

            setvar(VAR_CSR_GIFT_POKEMON, SPECIES_GYARADOS)
            setflag(FLAG_SHINY_CREATION)
            call(Common_Script_GiftPokemon)
            release
            end
        } else {
            fadedefaultbgm
            textcolor(NPC_TEXT_COLOR_MALE)
            msgbox("LANCE: Ah…\nAhem.", MSGBOX_DEFAULT)

        }
    }

    if(checktrainerflag(TRAINER_FUSHCIA_GYM_LANCE)) {
        call(FushciaGym_ElectrifyRoom_OpenDoor)
        special(DrawWholeMapView)
        msgbox("Impossible!\nYou must have cheated!", MSGBOX_DEFAULT)
        release
        end

    }
    msgbox("I am LANCE of the ELITE FOUR!\n{PAUSE 30}…Or well, I was.\pI got kicked out for using an\n“illegal” POKéMON.\lPah!\pI've moved on to a format more\nsuited to my strenghs:\lBalanced Hackmons!")
    trainerbattle_no_intro(TRAINER_FUSHCIA_GYM_LANCE, "But how!\n")
    addobject(LOCALID_REGIDRAGO)
    call(FushciaGym_ElectrifyRoom_OpenDoor)
    special(DrawWholeMapView)
    release
    end
}

script FushciaGym_ElectrifyRoom_DoorSign {
    if(checktrainerflag(TRAINER_FUSHCIA_GYM_LANCE)) {
        msgbox("MAY'S ROOM\pA private bedroom for the GYM\nLEADER's child, given with the\lutmost of care.", MSGBOX_SIGN)
    } else {
        msgbox("The door is locked…\n", MSGBOX_SIGN)
    }
}

script FushciaGym_ElectrifyRoom_Regidrago {
    lock
    faceplayer
    playmoncry(SPECIES_REGIDRAGO, CRY_MODE_FAINT)
    msgbox("REGIDRAGO: Draa-!\n", MSGBOX_DEFAULT)
    waitmoncry
    closemessage
    delay(20)
    msgbox("Hmm, looks like we forgot about\nhim.", MSGBOX_DEFAULT)
    release
    end
}