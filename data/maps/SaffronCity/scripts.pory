raw `
SaffronCity_EventScript_MoveDoorGuardGrunt::
	setobjectxyperm LOCALID_SAFFRON_DOOR_GUARD_GRUNT, 33, 31
	return

SaffronCity_EventScript_RocketGrunt1::
	msgbox SaffronCity_Text_WhatDoYouWantGetLost, MSGBOX_NPC
	end

SaffronCity_EventScript_RocketGrunt2::
	msgbox SaffronCity_Text_BossTakeTownForTeamRocket, MSGBOX_NPC
	end

SaffronCity_EventScript_RocketGrunt3::
	msgbox SaffronCity_Text_DontGetDefiantOrIllHurtYou, MSGBOX_NPC
	end

SaffronCity_EventScript_RocketGrunt4::
	msgbox SaffronCity_Text_SaffronBelongsToTeamRocket, MSGBOX_NPC
	end

SaffronCity_EventScript_RocketGrunt5::
	msgbox SaffronCity_Text_CriminalLifeMakesMeFeelAlive, MSGBOX_NPC
	end

SaffronCity_EventScript_RocketGrunt6::
	msgbox SaffronCity_Text_WatchWhereYoureWalking, MSGBOX_NPC
	end

SaffronCity_EventScript_RocketGrunt7::
	msgbox SaffronCity_Text_WeCanExploitMonsAroundWorld, MSGBOX_NPC
	end

SaffronCity_EventScript_DoorGuardGrunt::
	lock
	goto_if_set FLAG_RESCUED_CUBONES_MOM, SaffronCity_EventScript_DoorGuardAsleep
	applymovement LOCALID_SAFFRON_DOOR_GUARD_GRUNT, Common_Movement_FacePlayer
	waitmovement 0
	msgbox SaffronCity_Text_ImASecurityGuard
	release
	end

SaffronCity_EventScript_DoorGuardAsleep::
	textcolor NPC_TEXT_COLOR_NEUTRAL
	msgbox SaffronCity_Text_HesTakingASnooze
	release
	end

SaffronCity_EventScript_WorkerM::
	msgbox SaffronCity_Text_YouBeatTeamRocket, MSGBOX_NPC
	end

SaffronCity_EventScript_Youngster::
	msgbox SaffronCity_Text_SafeToGoOutAgain, MSGBOX_NPC
	end

SaffronCity_EventScript_Lass::
	msgbox SaffronCity_Text_PeopleComingBackToSaffron, MSGBOX_NPC
	end

SaffronCity_EventScript_Boy::
	msgbox SaffronCity_Text_FlewHereOnPidgeot, MSGBOX_NPC
	end

SaffronCity_EventScript_Pidgeot::
	lock
	faceplayer
	waitse
	playmoncry SPECIES_PIDGEOT, CRY_MODE_NORMAL
	msgbox SaffronCity_Text_Pidgeot
	waitmoncry
	release
	end

SaffronCity_EventScript_Man::
	msgbox SaffronCity_Text_SawRocketBossEscaping, MSGBOX_NPC
	end

SaffronCity_EventScript_CitySign::
	msgbox SaffronCity_Text_CitySign, MSGBOX_SIGN
	end

SaffronCity_EventScript_DojoSign::
	msgbox SaffronCity_Text_FightingDojo, MSGBOX_SIGN
	end

SaffronCity_EventScript_GymSign::
	lockall
	msgbox SaffronCity_Text_GymSign
	releaseall
	end

SaffronCity_EventScript_TrainerTips1::
	msgbox SaffronCity_Text_FullHealCuresStatus, MSGBOX_SIGN
	end

SaffronCity_EventScript_TrainerTips2::
	msgbox SaffronCity_Text_GreatBallImprovedCatchRate, MSGBOX_SIGN
	end

SaffronCity_EventScript_SilphCoSign::
	msgbox SaffronCity_Text_SilphCoSign, MSGBOX_SIGN
	end

SaffronCity_EventScript_MrPsychicsHouseSign::
	msgbox SaffronCity_Text_MrPsychicsHouse, MSGBOX_SIGN
	end

SaffronCity_EventScript_SilphProductSign::
	msgbox SaffronCity_Text_SilphsLatestProduct, MSGBOX_SIGN
	end

SaffronCity_EventScript_TrainerFanClubSign::
	msgbox SaffronCity_Text_TrainerFanClubSign, MSGBOX_SIGN
	end
`


const SneakyGuy = 20
mapscripts SaffronCity_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
	if(var(VAR_CURRENT_CHAPTER) == 7 && !flag(FLAG_CHAPTER_7_CHAPTER_2)) {
		setdynamicwarp(MAP_CHAPTER7_CHAPTER2, 1)
	} else {
		setdynamicwarp(MAP_SILPH_CO_1F, 1)
	}
	setworldmapflag(FLAG_WORLD_MAP_SAFFRON_CITY)
	if(flag(FLAG_SAFFRON_IS_TRAINS)) {
		setmaplayoutindex(LAYOUT_SAFFRON_CITY_TRAINS)
	} else {
		if(checkmoncaught(SPECIES_MIMIKYU)) {
			setvar(VAR_TEMP_9, 1)
			setflag(FLAG_SAFFRON_IS_TRAINS)
		}
	}

	}
	MAP_SCRIPT_ON_LOAD {


	}
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_TEMP_9, 1 {
			delay(30)
			setlayouttiles(LAYOUT_SAFFRON_CITY_TRAINS, 0, 0, 0, 0, 65, 54)
			playse(SE_CLICK)
			setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 3)
			setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 3)
			setvar(VAR_SHAKESCREEN_NUM_SHAKES, 5)
			setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
			special(ShakeScreen)
			delay(60)
			setvar(VAR_TEMP_9, 0)
			release
		}
	]
}


script SaffronCity_EventScript_EntryDMCA {
	msgbox("Haha! Welcome to SAFFRON CITY!\nNow officially under DMCA control!\p...Huh?\nWhere's the music?\pThat song was infringing on both\nPEWTER and FUSHCIA!\lIt had to go!", MSGBOX_NPC)
	end
}

script SaffronCity_EventScript_ThinIceDMCA {
	msgbox("Hrrrrm...\nThis guy's on thin ice!", MSGBOX_NPC)
	end
}

script SaffronCity_EventScript_FloorTilesDMCA {
	msgbox("These floor tiles are all illegal\ncopies of each other!", MSGBOX_NPC)
	end
}

script SaffronCity_EventScript_MartDMCA {
	msgbox("This MART was selling the same\nitems as all the others!", MSGBOX_NPC)
	end
}

script SaffronCity_EventScript_RichFromPatentsDMCA {
	msgbox("SILPH has been putting out so many\nfake patents!\pWith all the revenue from the\ncopyright claims, we're gonna be so\lrich!", MSGBOX_NPC)
	end
}

script SaffronCity_EventScript_GymDMCA {
	msgbox("This GYM is violating the copyright\nof the GYM next door!", MSGBOX_NPC)
	end
}

script SaffronCity_EventScript_CopycatDMCA {
	msgbox("The girl inside this house won't\nstop illegally copying materials!", MSGBOX_NPC)
	end
}

script SaffronCity_EventScript_BootlickerDMCA {
	msgbox("My life as a corporate bootlicker\nmakes me feel so alive!", MSGBOX_NPC)
	end
}

script SaffronCity_EventScript_HiddenDad {
	lock
	faceplayer
	textcolor(0)
	msgbox("DAD: {PLAYER}!\nWhat are you doing out here?\pI'm hiding under this building\nfor now.\lThese DMCA people are scary!\pWell, never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	setflag(FLAG_SAFFRON_HIDDEN)
	release
	end
}

script SaffronCity_EventScript_CenterSign {
	if(flag(FLAG_HIDE_SAFFRON_ROCKETS)) {
		lock
		msgbox(
		"NOTICE!\n"
		"The DMCA have been defeated!\p"

		"However, due to the shutdown it was\n"
		"discovered that this POKéMON CENTER\l"
		"was embezzling funding for years!\p"

		"As such, SAFFRON CITY has demanded\n"
		"the end of its operations.\p"

		"Thank you for understanding.\n"
		"", MSGBOX_DEFAULT)
		release
		end
	}
	msgbox("NOTICE!\pThis POKéMON Center has been found\nto be an illegal copy of all other\lPOKéMON Centers.\pAs such, the DMCA has demanded the\nend of its operations.\pThank you for understanding.\n", MSGBOX_SIGN)
	end
}

script SaffronCity_EventScript_CSR2Sign {
	msgbox("Planning meeting for\nCelia's Stupid Romhack 2!\pOnly those who are related to this\nproject are allowed to enter.\l-Celia's Stupid Dev Company", MSGBOX_SIGN)
	end
}

script SaffronCity_EventScript_SaffronSign {
	msgbox("This sign's contents have been\ntaken down due to copyright.", MSGBOX_SIGN)
	end
}

script SaffronCity_EventScript_SneakyGuy {
	msgbox("Pssst…\nHey! C'mere!\pDon't tell any of the DMCA guys,\nbut I have a secret!\pThere's a way into SILPH CO. from\nbehind.\lYou just gotta find the back door!\pIf you need somewhere safe, you\ncan duck in!", MSGBOX_NPC)
	end
}


script SaffronCity_CardboardCutout {
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	if(flag(FLAG_PUSHED_CARDBOARD_CUTOUT)) {

	} else {
		lock
		
		msgbox("It seems this DMCA GRUNT is simply\na detailed cardboard cut-out.\pYou push it aside.\n", MSGBOX_DEFAULT)
		closemessage
		delay(10)
		playse(SE_LEDGE)
		applymovement(VAR_LAST_TALKED, moves(
			jump_down
			set_invisible
		))
		waitmovement(0)
		playse(SE_M_WATERFALL)
		removeobject(VAR_LAST_TALKED)
		setflag(FLAG_PUSHED_CARDBOARD_CUTOUT)
		release
		end
		

	}

}

script SaffronCity_CarDad {
	lock
	faceplayer
	textcolor(0)
	msgbox(
	"DAD: {PLAYER}!\n"
	"What are you doing out here?\p"

	"Say, wanna come with me for a\n"
	"ride in the car?\l"
	"I have room for five more!\p"

	"Well, never mind that.\n"
	"Why don't you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}

script SaffronCity_TheLeek {
	msgbox(
	"THE LEEK\n"
	"{PAUSE 30}Publishing House", MSGBOX_SIGN)

}


script SaffronCity_ExistentialDude {
	lock
	faceplayer
	msgbox(
	"Y'know, sometimes I wonder if\n"
	"my whole life is a lie.\p"

	"Like, we think we're in a big city\n"
	"connected to the outside world.\p"

	"But what if we're actually enclosed\n"
	"in our own map, cut off from KANTO.\p"

	"What if in the “real” world,\n"
	"there's an identical copy of\l"
	"SAFFRON right here, but empty?\p"

	"What if those gates just serve as\n"
	"convenient loading zones to stop\l"
	"you from noticing the difference?\p"

	"Ah, well.\n"
	"Maybe I'm just being silly.", MSGBOX_DEFAULT)
	closemessage
	applymovement(VAR_LAST_TALKED, moves(
		face_original_direction
	))
	waitmovement(0)
	release
}


script SaffronCity_TheLeekMan {
	lock
	faceplayer
	if(var(VAR_TRADING_QUEST_PHASE) >= 4) {
		call(TheLeek_ProofOfAliens)
		msgbox(
		"Look kid, we're running a business\n"
		"here.\p"

		"Next thing I know, you'll be askin\n"
		"for paid time off, or benefits!\p"

		"I gotta keep your expectations\n"
		"low so you stay grateful!", MSGBOX_DEFAULT)
		release
		end
	}
	if(flag(FLAG_TALKED_TO_THE_LEEK)) {
		msgbox(
		"Hey again, kid.\n"
		"Have you found proof of ALIENS?\p"

		"You might be able to find something\n"
		"in the DESERT.\l"
		"Y'know, the one west of VERMILION?\p"

		"If you can find me that, I'll pay\n"
		"you back at full market rate!", MSGBOX_DEFAULT)
	} else {
		msgbox(
		"Busy! Busy! Busy!\n"
		"There's so much to do!\p"

		"I'm the lead JOURNALIST here at\n"
		"the LEEK.\l"
		"No one tracks a story like me.\p"

		"But… After the DMCA tried to take\n"
		"us down, we lost a ton of cash.\p"

		"That's where you come in.\n"
		"I need a real good story.\l"
		"How about this:\p"

		"“UNDENIABLE PROOF OF ALIENS!”\n"
		"Catchy headline. It's perfect.\p"

		"If you can find me that, I'll pay\n"
		"you back at full market rate!", MSGBOX_DEFAULT)
		call(TheLeek_ProofOfAliens)

	}
}

script TheLeek_ProofOfAliens {
	
	if(var(VAR_TRADING_QUEST_PHASE) == 3) {
		if(checkitem(ITEM_ALIEN_PROOF)) {
			removeitem(ITEM_ALIEN_PROOF)
		}
		msgbox(
		"Oh! Oh! Oh!\n"
		"That's it!\l"
		"Undeniable proof of aliens!\p"

		"Thanks so much, kid!\n"
		"This will make a great story!\p"

		"Here, take this.\n"
		"Full market rate!", MSGBOX_DEFAULT)
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		giveitem_msg("{PLAYER} was awarded\n25 CENTS!", ITEM_QUARTER)
		waitfanfare
		textcolor(NPC_TEXT_COLOR_BLUE)

		msgbox(
		"What?\n"
		"I said I'd give full market rate.\p"

		"I never promised that we'd pay\n"
		"you a living wage!\l"
		"Ha!", MSGBOX_DEFAULT)
		setvar(VAR_TRADING_QUEST_PHASE, 4)
		release
		end
	}
	return
}

script TheLeek_Report1 {
	msgbox(
	"BREAKING NEWS!{PAUSE 20}\n"
	"MEGA EVOLUTION exists again!?\p"

	"This phenomenon famous for randomly\n"
	"phasing out of existence has made\l"
	"a shocking return!\p"

	"Trainers report satisfaction with\n"
	"their POKéMON's newfound power.\p"

	"How long will it be until MEGA\n"
	"EVOLUTION vanishes again?\l"
	"Only time will tell!", MSGBOX_SIGN)

}
script TheLeek_Report2 {
	msgbox(
	"THIS JUST IN!\n"
	"A new TYPE has been classified!\p"

	"After much research, scientists\n"
	"have documented a new POKéMON TYPE.\p"

	"When FAIRY was first documented,\n"
	"previous sanctioned battle results\l"
	"came into question.\p"

	"LANCE was accused of cooking the\n"
	"books after his historic win with\l"
	"his DRAGONITE against a CLEFABLE.\p"

	"Stay tuned for updates on the\n"
	"situation!", MSGBOX_SIGN)

}
script TheLeek_Report3 {
	msgbox(
	"SPECIAL REPORT!\n"
	"Thunderstones do WHAT?!\p"

	"It's been common knowledge that\n"
	"MAGNETON evolves using a special\l"
	"field, but not anymore!\p"

	"It has recently been learned that\n"
	"a simple THUNDERSTONE does the job.\p"

	"Tourism in SINNOH has taken a hit,\n"
	"as TRAINERS no longer need to\l"
	"travel to evolve their POKéMON.\p"

	"How did nobody discover this fact\n"
	"sooner? No one knows!", MSGBOX_SIGN)

}


script SaffronCity_NPC1 {
	msgbox(
	"SAFFRON is free!\n"
	"Yay!\p"

	"My family went on a trip aboard the\n"
	"SS ANNE to keep out of trouble.\p"

	"Do you have any idea where it is?\n"
	"I hope they come back soon!\n"
	"", MSGBOX_NPC)
}


script SaffronCity_NPC2 {
	msgbox(
	"Saffron NPC 2\n"
	"", MSGBOX_NPC)
}


script SaffronCity_NPC3 {
	if(flag(FLAG_SAFFRON_IS_TRAINS)) {
		msgbox(
			"Wow, neat!\n"
			"A new TRAIN STATION!", MSGBOX_NPC)
	} else {
		msgbox(
		"I hear they're building a fancy\n"
		"TRAIN STATION here soon.\p"
		""

		"I'm not totally sure where they\n"
		"plan to put it, but hey!\l"
		"They'll find room for it somehow.", MSGBOX_NPC)
	}
}


script SaffronCity_NPC4 {
	msgbox(
	"Now that I think about it, why does\n"
	"SAFFRON have two GYMS anyway?", MSGBOX_NPC)
}


script SaffronCity_NPC5 {
	lock
	msgbox(
	"Hmm.\n"
	"", MSGBOX_DEFAULT)
	closemessage
	faceplayer
	msgbox(
	"You might think this is someone's\n"
	"house, but I'm not so sure.\p"

	"They don't even have a front door…\n"
	"Who built this thing, anyway?", MSGBOX_DEFAULT)
	release
}





script SaffronCity_Furrets {
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_FEMALE)
	waitse
	playmoncry(SPECIES_FURRET, CRY_MODE_NORMAL)
	msgbox("FURRET: Bwaah!\n", MSGBOX_DEFAULT)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox(
	"FURRET is violating the copyright\n"
	"of the ones in PEWTER and FUSHCIA!", MSGBOX_DEFAULT)
	release
}
