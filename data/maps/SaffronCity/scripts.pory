}


script SaffronCity_TrainHouses {
	if(flag(FLAG_SAFFRON_IS_TRAINS)) {
		msgbox(
		"Oh cool!\n"
		"A new TRAIN STATION!\p"

		"Good thing no one important\n"
		"lived there.", MSGBOX_SIGN)
	} else {
		msgbox(
		"Oh wow, a perfectly normal house.\n"
		"", MSGBOX_SIGN)

	}

}


script SaffronCity_TrainSign {
	if(!flag(FLAG_SAFFRON_IS_TRAINS)) {
		lock
		msgbox(
		"A particularly un-noteworthy\n"
		"patch of tiles.\l"
		"There isn't anything here.", MSGBOX_DEFAULT)
		release
	}
	msgbox(
	"MAGNET TRAIN\n"
	"SAFFRON CITY - GOLDEN ROD", MSGBOX_SIGN)

}
