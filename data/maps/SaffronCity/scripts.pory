const SneakyGuy = 20
mapscripts SaffronCity_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
	if(var(VAR_CURRENT_CHAPTER) == 7 && !flag(FLAG_CHAPTER_7_CHAPTER_2)) {
		setdynamicwarp(MAP_CHAPTER7_CHAPTER2, 1)
	} else {
		setdynamicwarp(MAP_SILPH_CO_1F, 1)
	}
	setworldmapflag(FLAG_WORLD_MAP_SAFFRON_CITY)
	if(flag(FLAG_SAFFRON_IS_TRAINS)) {
		setmaplayoutindex(LAYOUT_SAFFRON_CITY_TRAINS)
	} else {
		if(checkmoncaught(SPECIES_MIMIKYU)) {
			setvar(VAR_TEMP_9, 1)
			setflag(FLAG_SAFFRON_IS_TRAINS)
		}
	}

	}
	MAP_SCRIPT_ON_LOAD {


	}
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_TEMP_9, 1 {
			delay(30)
			setlayouttiles(LAYOUT_SAFFRON_CITY_TRAINS, 0, 0, 0, 0, 65, 54)
			playse(SE_CLICK)
			setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 3)
			setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 3)
			setvar(VAR_SHAKESCREEN_NUM_SHAKES, 5)
			setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
			special(ShakeScreen)
			delay(60)
			setvar(VAR_TEMP_9, 0)
			release
		}
	]
}


script SaffronCity_EventScript_EntryDMCA {
	msgbox("Haha! Welcome to SAFFRON CITY!\nNow officially under DMCA control!\p...Huh?\nWhere's the music?\pThat song was infringing on both\nPEWTER and VIRIDIAN!\lIt had to go!", MSGBOX_NPC)
	end
}

script SaffronCity_EventScript_ThinIceDMCA {
	msgbox("Hrrrrm...\nThis guy's on thin ice!", MSGBOX_NPC)
	end
}

script SaffronCity_EventScript_FloorTilesDMCA {
	msgbox("These floor tiles are all illegal\ncopies of each other!", MSGBOX_NPC)
	end
}

script SaffronCity_EventScript_MartDMCA {
	msgbox("This MART was selling the same\nitems as all the others!", MSGBOX_NPC)
	end
}

script SaffronCity_EventScript_RichFromPatentsDMCA {
	msgbox("SILPH has been putting out so many\nfake patents!\pWith all the revenue from the\ncopyright claims, we're gonna be so\lrich!", MSGBOX_NPC)
	end
}

script SaffronCity_EventScript_GymDMCA {
	msgbox("This GYM is violating the copyright\nof the GYM next door!", MSGBOX_NPC)
	end
}

script SaffronCity_EventScript_CopycatDMCA {
	msgbox("The girl inside this house won't\nstop illegally copying materials!", MSGBOX_NPC)
	end
}

script SaffronCity_EventScript_BootlickerDMCA {
	msgbox("My life as a corporate bootlicker\nmakes me feel so alive!", MSGBOX_NPC)
	end
}

script SaffronCity_EventScript_HiddenDad {
	lock
	faceplayer
	textcolor(0)
	msgbox("DAD: {PLAYER}!\nWhat are you doing out here?\pI'm hiding under this building\nfor now.\lThese DMCA people are scary!\pWell, never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	setflag(FLAG_SAFFRON_HIDDEN)
	release
	end
}

script SaffronCity_EventScript_CenterSign {
	msgbox("NOTICE!\pThis POKéMON Center has been found\nto be an illegal copy of all other\lPOKéMON Centers.\pAs such, the DMCA has demanded the\nend of its operations.\pThank you for understanding.\n", MSGBOX_SIGN)
	end
}

script SaffronCity_EventScript_CSR2Sign {
	msgbox("Planning meeting for\nCelia's Stupid Romhack 2!\pOnly those who are related to this\nproject are allowed to enter.\l-Celia's Stupid Dev Company", MSGBOX_SIGN)
	end
}

script SaffronCity_EventScript_SaffronSign {
	msgbox("This sign's contents have been\ntaken down due to copyright.", MSGBOX_SIGN)
	end
}

script SaffronCity_EventScript_SneakyGuy {
	msgbox("Pssst…\nHey! C'mere!\pDon't tell any of the DMCA guys,\nbut I have a secret!\pThere's a way into SILPH CO. from\nbehind.\lYou just gotta find the back door!\pIf you need somewhere safe, you\ncan duck in!", MSGBOX_NPC)
	end
}


script SaffronCity_CardboardCutout {
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	if(flag(FLAG_PUSHED_CARDBOARD_CUTOUT)) {

	} else {
		lock
		
		msgbox("It seems this DMCA GRUNT is simply\na detailed cardboard cut-out.\pYou push it aside.\n", MSGBOX_DEFAULT)
		closemessage
		delay(10)
		playse(SE_LEDGE)
		applymovement(VAR_LAST_TALKED, moves(
			jump_down
			set_invisible
		))
		waitmovement(0)
		playse(SE_M_WATERFALL)
		removeobject(VAR_LAST_TALKED)
		setflag(FLAG_PUSHED_CARDBOARD_CUTOUT)
		release
		end
		

	}

}

script SaffronCity_CarDad {
	lock
	faceplayer
	textcolor(0)
	msgbox(
	"DAD: {PLAYER}!\n"
	"What are you doing out here?\p"

	"Say, wanna come with me for a\n"
	"ride in the car?\l"
	"I have room for five more!\p"

	"Well, never mind that.\n"
	"Why don't you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}

script SaffronCity_TheLeek {
	msgbox(
	"THE LEEK\n"
	"{PAUSE 30}Publishing House", MSGBOX_SIGN)

}


script SaffronCity_ExistentialDude {
	lock
	faceplayer
	msgbox(
	"Y'know, sometimes I wonder if\n"
	"my whole life is a lie.\p"

	"Like, we think we're in a big city\n"
	"connected to the outside world.\p"

	"But what if we're actually enclosed\n"
	"in our own map, cut off from KANTO.\p"

	"What if in the “real” world,\n"
	"there's an identical copy of\l"
	"SAFFRON right here, but empty?\p"

	"What if those gates just serve as\n"
	"convenient loading zones to stop\l"
	"you from noticing the difference?\p"

	"Ah, well.\n"
	"Maybe I'm just being silly.", MSGBOX_DEFAULT)
	closemessage
	applymovement(VAR_LAST_TALKED, moves(
		face_original_direction
	))
	waitmovement(0)
	release
}


