script Starlight_House2_Table_Plans {

	getplayerxy(VAR_TEMP_5, VAR_TEMP_6)
            if(var(VAR_TEMP_6) == 13 && var(VAR_TEMP_5) == 17) {
                msgbox(
	"It's map plans laid out for the\n"
	"whole region.\p"

	"Looking high you can't see\n"
	"anything because you have glasses\l"
	"in your face.", MSGBOX_SIGN)
                release
                end
            } else {
                msgbox(
	"It's map plans laid out for the\n"
	"whole region.\p"

	"Looking closely you see a map\n"
	"called “Ocean11”...", MSGBOX_SIGN)

                release
                end
            }

}

