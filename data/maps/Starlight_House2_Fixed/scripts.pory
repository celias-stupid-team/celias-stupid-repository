script Starlight_House2_Swap_Layouts {
delay(30)
	setlayouttiles(
				LAYOUT_STARLIGHT_HOUSE2_LAYOUT_2, 
				0,	// startingX
				0,	// startingY 
				5,	// x1 
				20,	// y1
				5, // x2
				16) // y2
	delay(3)
	setlayouttiles(
				LAYOUT_STARLIGHT_HOUSE2_LAYOUT_3, 
				0,	// startingX
				0,	// startingY 
				5,	// x1 
				20,	// y1
				5, // x2
				16) // y2
	delay(3)
	setlayouttiles(
				LAYOUT_STARLIGHT_HOUSE2_LAYOUT_4, 
				0,	// startingX
				0,	// startingY 
				5,	// x1 
				20,	// y1
				5, // x2
				16) // y2
	delay(3)
	setlayouttiles(
				LAYOUT_STARLIGHT_HOUSE2_LAYOUT_5, 
				0,	// startingX
				0,	// startingY 
				5,	// x1 
				20,	// y1
				5, // x2
				16) // y2
	delay(3)
	setlayouttiles(
				LAYOUT_STARLIGHT_HOUSE2_LAYOUT_6, 
				0,	// startingX
				0,	// startingY 
				5,	// x1 
				20,	// y1
				5, // x2
				16) // y2
	delay(3)
	setlayouttiles(
				LAYOUT_STARLIGHT_HOUSE2_FIXED, 
				0,	// startingX
				0,	// startingY 
				5,	// x1 
				20,	// y1
				5, // x2
				16) // y2
}

