mapscripts Starlight_House2_Fixed_MapScripts {

	MAP_SCRIPT_ON_TRANSITION {
		//setbench(BENCH_STARLIGHTS_HOUSE)
		if(!flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
			setflag(FLAG_TEMP_3)
		}
		if(flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
			setflag(FLAG_TEMP_8)
        }
            if(flag(FLAG_CSR_CELIA_BONUS)) {
			setflag(FLAG_TEMP_8)
		}
		if(flag(FLAG_DAK_HERE)) {
			setflag(FLAG_TEMP_8)
		}
        //setbench(BENCH_STARLIGHTS_HOUSE)
		
	}
	MAP_SCRIPT_ON_LOAD {
		setbench(BENCH_STARLIGHTHOUSE)
		
	}
}

script Starlight_House2_Post_Battle {
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"STARLIGHT: It's nice to meet you!\p"

	"My name is KaizenStarlight but I\n"
	"go by Starlight for short.\p"

	"I'm the one who builds the maps you\n"
	"walk around on.", MSGBOX_DEFAULT)

playse(SE_CLICK)
setlayouttiles(
				LAYOUT_STARLIGHT_HOUSE2_LAYOUT_2, 
				0,	// startingX
				0,	// startingY 
				0,	// x1 
				0,	// y1
				38, // x2
				19) // y2
	delay(20)
	playse(SE_CLICK)
	setlayouttiles(
				LAYOUT_STARLIGHT_HOUSE2_LAYOUT_3, 
				0,	// startingX
				0,	// startingY 
				0,	// x1 
				0,	// y1
				38, // x2
				19) // y2
	delay(20)
	playse(SE_CLICK)
	setlayouttiles(
				LAYOUT_STARLIGHT_HOUSE2_LAYOUT_4, 
				0,	// startingX
				0,	// startingY 
				0,	// x1 
				0,	// y1
				38, // x2
				19) // y2
	delay(20)
	playse(SE_CLICK)
	setlayouttiles(
				LAYOUT_STARLIGHT_HOUSE2_LAYOUT_5, 
				0,	// startingX
				0,	// startingY 
				0,	// x1 
				0,	// y1
				38, // x2
				19) // y2
	delay(20)
	playse(SE_CLICK)
	setlayouttiles(
				LAYOUT_STARLIGHT_HOUSE2_LAYOUT_6, 
				0,	// startingX
				0,	// startingY 
				0,	// x1 
				0,	// y1
				38, // x2
				19) // y2
	delay(20)
	playse(SE_CLICK)
	setlayouttiles(
				LAYOUT_STARLIGHT_HOUSE2, 
				0,	// startingX
				0,	// startingY 
				0,	// x1 
				0,	// y1
				38, // x2
				19) // y2
	delay(40)

	msgbox(
	"So if you ever see me out of bounds\n"
	"around The Great Sea, I am just\l"
	"working, pay no attention to me!\p"

	"Oh! If you see my friend DAK\n"
	"hanging about in this house, tell\l"
	"him I need him. Thanks!", MSGBOX_NPC)
	closemessage
	clearflag(FLAG_HIDE_BONUS_STARLIGHTS)
	applymovement(VAR_LAST_TALKED, moves(
		face_up
	))
	waitmovement(0)
	release
}

script Starlight_House2_Battle {
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_FEMALE)
	if(!flag(FLAG_POST_GAME)) {
		trainerbattle_single(TRAINER_STARLIGHT,
	"STARLIGHT: Oh hi!\p"
	"I thought I hid this map.",
	"That was fun!", Starlight_House2_Post_Battle)
	} else {
		trainerbattle_single(TRAINER_STARLIGHT,
	"STARLIGHT: Oh hi!\p"
	"Where have you been this whole\n"
	"time? I was here before post game!",
	"That was fun!", Starlight_House2_Post_Battle)
	}
	release
	end

	msgbox(
	"It's nice to meet you!\p"
	
	"If you ever see me out of bounds\n"
	"just ignore me. I am working around\l"
	"here and there.\p"

	"Also, if you see my friend DAK\n"
	"hanging about in this house, tell\l"
	"him I need him. Thanks!", MSGBOX_DEFAULT)
	closemessage
	clearflag(FLAG_HIDE_BONUS_STARLIGHTS)
	applymovement(LOCALID_STARLIGHT_NPC, moves(
		face_up
	))
	waitmovement(0)
	release
}

script Starlight_House2_Phone { //figure out yesno setup for reading messages.
	msgbox(
	"You have 3 missed calls.\p" 
	"Celia - 2 voicemails\n"
	"Dak - 1 voicemail\p"
	"Play Messages?\n"
	"", MSGBOX_YESNO)
	if(var(VAR_RESULT)) {
		msgbox(
	"First Message:\l"
	"CELIA: Hey Star, could you fix the\n"
	"tile collision in Aether? Thanks!\p"
	"Second Message:\l"
	"CELIA: Great work with Seafoam and\n"
	"Silph Co Layout!\p"
	"Third Message:\l"
	"DAK: WHAAAAAADDUUUUUUUUUUUUUUUUUUU\n"
	"UUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUPP\p"
	"End of messages.", MSGBOX_SIGN)
	closemessage
	} else {
		closemessage
	}
	

}

