raw `



FiveIsland_MemorialPillar_EventScript_MemorialMan::
	lock
	goto_if_set FLAG_GOT_TM42_AT_MEMORIAL_PILLAR, FiveIsland_MemorialPillar_EventScript_AlreadyGotTM42
	goto_if_set FLAG_NO_ROOM_FOR_TM42_AT_MEMORIAL_PILLAR, FiveIsland_MemorialPillar_EventScript_ReturnedForTM42
	msgbox FiveIsland_MemorialPillar_Text_ScrubScrub
	closemessage
	applymovement LOCALID_MEMORIAL_MAN, Common_Movement_FacePlayer
	waitmovement 0
	delay 45
	msgbox FiveIsland_MemorialPillar_Text_YourMonsLookHealthy
	applymovement LOCALID_MEMORIAL_MAN, Common_Movement_WalkInPlaceFasterUp
	waitmovement 0
	msgbox FiveIsland_MemorialPillar_Text_ThisIsWhereIBuriedMyOnix
	release
	end

FiveIsland_MemorialPillar_EventScript_AlreadyGotTM42::
	msgbox FiveIsland_MemorialPillar_Text_ScrubScrubTectonix
	release
	end

FiveIsland_MemorialPillar_EventScript_ReturnedForTM42::
	msgbox FiveIsland_MemorialPillar_Text_StillHaveThingAsMyThanks
	giveitem ITEM_TM42
	goto_if_eq VAR_RESULT, FALSE, FiveIsland_MemorialPillar_EventScript_NoRoomForTM42
	call FiveIsland_MemorialPillar_EventScript_ReceivedTM42
	release
	end

FiveIsland_MemorialPillar_EventScript_Memorial::
	goto_if_questlog EventScript_ReleaseEnd
	special QuestLog_CutRecording
	lockall
	goto_if_set FLAG_GOT_TM42_AT_MEMORIAL_PILLAR, FiveIsland_MemorialPillar_EventScript_MemorialLemonadeAlreadyPlaced
	goto_if_set FLAG_NO_ROOM_FOR_TM42_AT_MEMORIAL_PILLAR, FiveIsland_MemorialPillar_EventScript_MemorialLemonadeAlreadyPlaced
	msgbox FiveIsland_MemorialPillar_Text_HereLiesTectonixLemonadeOffering
	checkitem ITEM_LEMONADE
	goto_if_eq VAR_RESULT, TRUE, FiveIsland_MemorialPillar_EventScript_AskPlaceLemonade
	releaseall
	end

FiveIsland_MemorialPillar_EventScript_AskPlaceLemonade::
	msgbox FiveIsland_MemorialPillar_Text_LeaveAnotherLemonadeOffering, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, FiveIsland_MemorialPillar_EventScript_PlaceLemonade
	releaseall
	end

FiveIsland_MemorialPillar_EventScript_PlaceLemonade::
	removeitem ITEM_LEMONADE
	msgbox FiveIsland_MemorialPillar_Text_PlacedCanOfLemonade
	closemessage
	applymovement LOCALID_MEMORIAL_MAN, Common_Movement_WalkInPlaceFasterRight
	waitmovement 0
	delay 45
	applymovement LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterLeft
	waitmovement 0
	textcolor NPC_TEXT_COLOR_MALE
	msgbox FiveIsland_MemorialPillar_Text_ThankYouPleaseTakeThis
	giveitem ITEM_TM42
	goto_if_eq VAR_RESULT, FALSE, FiveIsland_MemorialPillar_EventScript_NoRoomForTM42
	call FiveIsland_MemorialPillar_EventScript_ReceivedTM42
	releaseall
	end

FiveIsland_MemorialPillar_EventScript_ReceivedTM42::
	msgbox FiveIsland_MemorialPillar_Text_BeGoodToYourMonsToo
	applymovement LOCALID_MEMORIAL_MAN, Common_Movement_WalkInPlaceFasterUp
	waitmovement 0
	setflag FLAG_GOT_TM42_AT_MEMORIAL_PILLAR
	return

FiveIsland_MemorialPillar_EventScript_NoRoomForTM42::
	setflag FLAG_NO_ROOM_FOR_TM42_AT_MEMORIAL_PILLAR
	msgbox FiveIsland_MemorialPillar_Text_DontHaveRoomForIt
	releaseall
	end

FiveIsland_MemorialPillar_EventScript_MemorialLemonadeAlreadyPlaced::
	msgbox FiveIsland_MemorialPillar_Text_HereLiesTectonix
	releaseall
	end
`

mapscripts FiveIsland_MemorialPillar_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		if(!checktrainerflag(TRAINER_BACKPACK_SWIMMER)) {
			setflag(FLAG_SHINY_CREATION)
		}
		
		
	}
}

script MemorialPillar_OnixSign {
	lock
	setflag(FLAG_WORLD_MAP_MEMORIAL_PILLAR)
	famechecker(FAMECHECKER_GREAT_SEA_EAST, 0)
	if(flag(FLAG_ONIX_TAIL_SIGN)) {
		msgbox(
		"The butt of an extraordinarily\n"
		"large ONIX.", MSGBOX_DEFAULT)
		release
		end
	}
	msgbox(
	"A POKéMON is buried deep into\n"
	"the ground.", MSGBOX_DEFAULT)

	if(!flag(FLAG_SPAWN_VERMILION_ONIX)) {
		playfanfare(MUS_HALF_SIGN)
		setflag(FLAG_SPAWN_VERMILION_ONIX)
		msgbox(
		"{PLAYER} discovered the bottom\n"
		"half of a POKéMON SIGN!", MSGBOX_DEFAULT)
		waitfanfare
		closemessage
		delay(10)
	}
	msgbox(
	"Hmm, I wonder where the rest of\n"
	"him wound up.", MSGBOX_DEFAULT)
	
	release
}


script MemorialPillar_Guy {
	if(checkitem(ITEM_LEMONADE) && !flag(FLAG_TEMP_5) && !flag(FLAG_ONIX_TAIL_SIGN)) {
		lock
		faceplayer
		msgbox(
		"This is where I buried my ONIX.\p"

		"I think I did an excellent job\n"
		"burying him.", MSGBOX_DEFAULT)
		closemessage
		playse(SE_PIN)
		applymovement(VAR_LAST_TALKED, moves(
			emote_exclamation_mark
			delay_16 * 3
		))
		waitmovement(0)
		msgbox(
		"Hey! You have LEMONADE!\p"

		"That was my ONIX's favorite drink.\n"
		"I wanna leave it as an offering.\l"
		"May I please have one?", MSGBOX_YESNO)
		if(var(VAR_RESULT)) {
			setflag(FLAG_TEMP_5)
			removeitem(ITEM_LEMONADE)
			msgbox(
			"Thank you.\p"

			"Say… When I buried him, we popped\n"
			"out of the other side of the world.\p"

			"I think there was construction\n"
			"equipment around?\l"
			"Dunno where that'd be.", MSGBOX_DEFAULT)
			release
			end
		} else {
			msgbox(
			"Wow.\p"

			"Okay, asshole.\n"
			"", MSGBOX_DEFAULT)
			release
			end
		}
	}
	msgbox(
	"This is where I buried my ONIX.\p"

	"Some kid snuck up on us with a\n"
	"BUTTERFREE.\l"
	"He didn't even stand a chance…\p"

	"I think I did an excellent job\n"
	"burying him.", MSGBOX_NPC)
}

script MemorialPillar_ShinyFlag {
	setflag(FLAG_SHINY_CREATION)
	release
}

script GreatSea_PokeBallStorage {
	if(!checktrainerflag(TRAINER_BACKPACK_SWIMMER) && !flag(FLAG_TEMP_2)) {
		lock
		msgbox(
		"FEMININE POKé BALL STORAGE DEVICE\n"
		"", MSGBOX_DEFAULT)
		closemessage
		msgbox(
		"Hey!\n"
		"There's still a POKé BALL in here!", MSGBOX_DEFAULT)
		playfanfare(MUS_LEVEL_UP)
		setflag(FLAG_SHINY_CREATION)
		msgbox(
		"{PLAYER} reached deep in the\n"
		"DEVICE and retrieved CLOYSTER!", MSGBOX_DEFAULT)
		setvar(VAR_CSR_GIFT_POKEMON, SPECIES_CLOYSTER)
		call(Common_Script_GiftPokemon30)
		setflag(FLAG_TEMP_2)
		release
		end
	} else {
		msgbox(
		"FEMININE POKé BALL STORAGE DEVICE\n"
		"", MSGBOX_SIGN)

	}

}


script GreatSea_WomensSecret { // Swimmer Victoria
	trainerbattle_single(TRAINER_BACKPACK_SWIMMER, "If I'm wearing a bikini…\n"
	"where do I put my POKé BALLS?", "Ah!")
	msgbox(
	"Where do I keep my POKé BALLS?\p"

	"Tee hee!\n"
	"Woman's secret!", MSGBOX_NPC)
}