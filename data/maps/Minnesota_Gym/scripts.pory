}

script MinnesotaGym_Attendant {
    lock
    faceplayer
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    if(var(VAR_RESULT) == DIR_EAST) {
        msgbox(
        "Listen, man.\n"
        "I make minimum wage.\p"

        "I don't have the energy to tell you\n"
        "not to talk to me from here.\l"
        "Please go away.", MSGBOX_DEFAULT)
        closemessage
        applymovement(VAR_LAST_TALKED, moves(
            face_original_direction
        ))
        waitmovement(0)
        release
    } else {
        if(flag(FLAG_GOT_GYM_MEMBERSHIP_BADGE)) {
            msgbox(
            "Hello!\n"
            "Welcome to PLANET FITNESS!\p"

            "We have an exclusive business deal\n"
            "with the HOSPITAL down the road.\p"

            "We provide an endless supply of new\n"
            "patients for them.\l"
            "I hope you enjoy our services!", MSGBOX_DEFAULT)
            release
            end
        }
        msgbox(
        "Hello!\n"
        "Welcome to PLANET FITNESS!\p"

        "Would you like to sign up for a\n"
        "free MEMBERSHIP?", MSGBOX_YESNO)
        if(var(VAR_RESULT)) {
            msgbox(
            "All righty, then!\p"

            "I just need you to sign a few\n"
            "waivers and releases, and we'll be\l"
            "good to go!", MSGBOX_DEFAULT)
            closemessage
            fadescreenswapbuffers(FADE_TO_BLACK)
            textcolor(NPC_TEXT_COLOR_NEUTRAL)
            delay(30)
            msgbox(
            "{PLAYER} signed their name upwards\n"
            "of 74 times.", MSGBOX_DEFAULT)
            closemessage
            fadescreenswapbuffers(FADE_FROM_BLACK)
            textcolor(NPC_TEXT_COLOR_RED)
            msgbox(
            "Excellent!\n"
            "Thank you for your patronage.\p"

            "Here's your membership badge to\n"
            "show you're welcome here.", MSGBOX_DEFAULT)
            closemessage
            delay(10)
            textcolor(NPC_TEXT_COLOR_NEUTRAL)

            msgbox(
            "{PLAYER} obtained the\n"
            "GYM MEMBERSHIP BADGE!{PAUSE_MUSIC}{PLAY_BGM}{MUS_OBTAIN_BADGE}{PAUSE 0xFE}{PAUSE 0x56}{RESUME_MUSIC}", MSGBOX_DEFAULT)
            waitfanfare
            closemessage
            delay(30)
            textcolor(NPC_TEXT_COLOR_RED)
            msgbox(
            "Our facilities are over to the\n"
            "left.\p"

            "Feel free to use them however\n"
            "you'd like!", MSGBOX_DEFAULT)
            setflag(FLAG_GOT_GYM_MEMBERSHIP_BADGE)
            release
            end

        } else {
            msgbox(
            "Oh, uh…\n"
            "Okay.\p"

            "Goodbye, then?\n"
            "", MSGBOX_DEFAULT)
            release
        }

    }
}

