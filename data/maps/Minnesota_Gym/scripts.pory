script MinnesotaGym_SafetySign {
    if(flag(FLAG_SENT_BIKER_FLYING)) {
        msgbox( 
        "Days since last injury:{PAUSE 30}\n"
        "0\l"
        ":(", MSGBOX_SIGN)
    } else {
        msgbox(
        "Days since last injury:{PAUSE 30}\n"
        "4", MSGBOX_SIGN)
    }
}

script MinnesotaGym_BenchClue {
	msgbox(
	"One thing I hate about this gym\n"
	"is how crowded it gets.\p"

	"Everyone's hoping to get their\n"
	"turn using the BENCH press.\p"

	"Why's there only one setup anyway?", MSGBOX_NPC)
}



script MinnesotaGym_WeightLine {
    lock
    faceplayer
    msgbox(
	"Line starts back there, bub.\n"
	"", MSGBOX_DEFAULT)
    closemessage
    applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    release
}

script MinnesotaGym_BikingKid {
    lock
    msgbox(
	"I keep…{PAUSE 30} huff{PAUSE 30}\n"
	"…pedaling…{PAUSE 30} huff\p"

	"But I never…{PAUSE 30} huff{PAUSE 30}\n"
	"…get…{PAUSE 30} huff{PAUSE 30} …anywhere!…{PAUSE 30} huff", MSGBOX_DEFAULT)
    closemessage
    //sound effect
    applymovement(VAR_LAST_TALKED, moves(
        walk_in_place_faster_right * 20
    ))
    delay(60)
    playse(SE_M_TAKE_DOWN)
    waitmovement(0)
    applymovement(VAR_LAST_TALKED, moves(
        walk_faster_right * 9
    ))
    waitmovement(0)
    setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 3)
    setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 3)
    setvar(VAR_SHAKESCREEN_NUM_SHAKES, 5)
    setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
    special(ShakeScreen)
    delay(60)
    setflag(FLAG_SENT_BIKER_FLYING)
    
    setmetatile(19, 14, METATILE_MinnesotaGym_UpdatedGymSignTop, TRUE)
    setmetatile(19, 15, METATILE_MinnesotaGym_UpdatedGymSignBottom, TRUE)
    special(DrawWholeMapView)
    release
}

script MinnesotaGym_BikingWall {
    if(flag(FLAG_SENT_BIKER_FLYING)) {
        msgbox(
        "There is a hole in the wall.\p"

        "Surrounding this hole are seven\n"
        "identical holes.", MSGBOX_SIGN)

    } else {
        setflag(FLAG_READ_SAFE_CODE)
        msgbox(
        "Seven identical holes line the\n"
        "wall.\p"

        "In the spot immediately in front\n"
        "of the middle bike, there is a\l"
        "safe combination written.\p"

        "It says{PAUSE 30} “999”.\n"
        "", MSGBOX_SIGN)
    }

}



script MinnesotaGym_Biker {
    lock
    faceplayer
    msgbox(
	"Pff.\p"

	"Ameteur.\n"
	"", MSGBOX_DEFAULT)
    closemessage
    applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
