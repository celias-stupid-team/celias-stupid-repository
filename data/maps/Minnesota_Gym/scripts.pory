script MinnesotaGym_Treadmill {
    lock
    applymovement(LOCALID_PLAYER, moves(
        face_left
        delay_16 * 2
        walk_in_place_left * 5
        walk_in_place_fast_left * 5
        walk_in_place_faster_left * 10
    ))
    delay(60)
    playse(SE_M_TAKE_DOWN)
    waitse
    waitmovement(LOCALID_PLAYER)
    if(!flag(FLAG_TEMP_2)) {
        applymovement(LOCALID_PLAYER, moves(
            walk_in_place_faster_left * 70
        ))
        applymovement(LOCALID_GYM_COP, moves(
            set_visible
            walk_down
            walk_left * 6
            face_left
        ))
        waitmovement(LOCALID_GYM_COP)

        //cop moves
        textcolor(NPC_TEXT_COLOR_BLUE)
        setflag(FLAG_TEMP_2)
        message(
        "Hey, kid!\n"
        "Stop right there!")
        delay(80)
        message(
        "Where's your goddamn\n"
        "RUNNING SHOES!?")

    } else {
        setflag(FLAG_TEMP_3)
        applymovement(LOCALID_PLAYER, moves(
            walk_in_place_faster_left * 20
        ))
        applymovement(LOCALID_GYM_COP, moves(
            set_visible
            walk_down
            walk_left * 4
            face_left
        ))
        waitmovement(LOCALID_GYM_COP)

    }
    waitmovement(LOCALID_PLAYER)
    closemessage
    if(!flag(FLAG_TEMP_3)) {
        applymovement(LOCALID_PLAYER, moves(
            walk_in_place_fast_left * 5
            walk_in_place_left * 5
            face_left
            delay_16 * 3
            face_up
            delay_16 *2
            face_down
            delay_16 *2
            face_up
            delay_16 *2
            face_down
            delay_16 *2
            face_left * 4
        ))

    } else {
        applymovement(LOCALID_PLAYER, moves(
            walk_in_place_fast_left * 5
            walk_in_place_left * 5
            face_left
            delay_16 *3
            face_left * 4
        ))

    }
    waitmovement(LOCALID_PLAYER)
    applymovement(LOCALID_PLAYER, moves(
        walk_slow_right
        walk_slow_down
        face_down
    ))
    if(!flag(FLAG_TEMP_3)) {
        applymovement(LOCALID_GYM_COP, moves(
            delay_16 * 2
            walk_right * 4
            walk_down * 2
            walk_right * 3
            walk_fastest_up * 3
            walk_fastest_right
            set_invisible
        ))

    } else {
        clearflag(FLAG_TEMP_3)
        applymovement(LOCALID_GYM_COP, moves(
            delay_16 * 2
            walk_right * 4
            walk_fastest_up * 1
            set_invisible
        ))

    }
    waitmovement(LOCALID_GYM_COP)
    release


}

