raw `
CeruleanCave_B1F_MapScripts::
	map_script MAP_SCRIPT_ON_RESUME, CeruleanCave_B1F_OnResume
	map_script MAP_SCRIPT_ON_TRANSITION, CeruleanCave_B1F_OnTransition
	.byte 0

CeruleanCave_B1F_OnResume::
	call_if_set FLAG_SYS_SPECIAL_WILD_BATTLE, CeruleanCave_B1F_EventScript_TryRemoveMewtwo
	end

CeruleanCave_B1F_EventScript_TryRemoveMewtwo::
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_ne VAR_RESULT, B_OUTCOME_CAUGHT, EventScript_Return
	removeobject VAR_LAST_TALKED
	return

CeruleanCave_B1F_OnTransition::
	setflag FLAG_TEMP_10
	call_if_set FLAG_FOUGHT_MEWTWO, CeruleanCave_B1F_EventScript_ShowMewtwo
	end

CeruleanCave_B1F_EventScript_ShowMewtwo::
	clearflag FLAG_TEMP_10
	return

CeruleanCave_B1F_EventScript_Mewtwo::
	goto_if_questlog EventScript_ReleaseEnd
	special QuestLog_CutRecording
	lock
	faceplayer
	waitse
	playmoncry SPECIES_ARCANINE, CRY_MODE_ENCOUNTER
	message CeruleanCave_B1F_Text_Mew
	waitmessage
	waitmoncry
	delay 20
	playbgm MUS_ENCOUNTER_GYM_LEADER, 0
	waitbuttonpress
	setwildbattle SPECIES_ARCANINE, 70
	setflag FLAG_SYS_SPECIAL_WILD_BATTLE
	special StartLegendaryBattle
	waitstate
	clearflag FLAG_SYS_SPECIAL_WILD_BATTLE
	specialvar VAR_RESULT, GetBattleOutcome
	addobject LOCALID_ARCANINE_GUN
	clearflag FLAG_TEMP_10
	goto_if_eq VAR_RESULT, B_OUTCOME_WON, CeruleanCave_B1F_EventScript_DefeatedMewtwo
	goto_if_eq VAR_RESULT, B_OUTCOME_RAN, CeruleanCave_B1F_EventScript_RanFromMewtwo
	goto_if_eq VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED, CeruleanCave_B1F_EventScript_RanFromMewtwo
	setflag FLAG_FOUGHT_MEWTWO
	release
	end

CeruleanCave_B1F_EventScript_DefeatedMewtwo::
	setflag FLAG_FOUGHT_MEWTWO
	goto EventScript_RemoveStaticMon
	end

CeruleanCave_B1F_EventScript_RanFromMewtwo::
	setvar VAR_0x8004, SPECIES_ARCANINE
	goto EventScript_MonFlewAway
	end
`


script CeruleanCave_ShortsGang1 {
	trainerbattle_single(TRAINER_SHORTS_GANG_2,
	"Hey!\n"
	"This is our hideout!\l"
	"You can't be in here!",

	"Darn you!\n")
	msgbox(
	"Grr…\n"
	"We're the SHORTS GANG!\p"

	"Don't mess with us, or we'll\n"
	"take you down!", MSGBOX_NPC)
}

script CeruleanCave_ShortsGang2 {
	trainerbattle_single(TRAINER_SHORTS_GANG_1,
	"We're the SHORTS GANG, and don't\n"
	"you forget it!",
	//
	"I bet you think I'm weak,\n"
	"don't you?")

	msgbox(
	"We've been after the LEGENDARY\n"
	"POKéMON in this cave.\p"

	"You'll have to take down our\n"
	"LEADER if you want it!", MSGBOX_NPC)
}


script CeruleanCave_ShortsGang3 {
	trainerbattle_single(TRAINER_SHORTS_GANG_3,
	"You're trying to mess with us?\p"

	"You'd better be ready for our\n"
	"LEADER!",
	//
	"No!\n"
	"LEADER! I let you down!")


	msgbox(
	"The LEADER of the SHORTS GANG is\n"
	"way tougher than me!\p"

	"When he gets whipped into a frenzy,\n"
	"there's no stopping him!", MSGBOX_NPC)
}


script CeruleanCave_BerserkGene {
	trainerbattle_single(TRAINER_BERSERK_JEANS,
	"GRAAAAAAH!\p"

	"I am the leader of the SHORTS GANG!\n"
	"How dare you mess with us!\p"

	"BAH!\n"
	"This makes me FURIOUS!\l"
	"I'm gonna go BERSERK on you!",

	///defeat
	"Grrraaah! "
	"These fucking ducks\nwon't leave me alone!")

	//After battle
	msgbox(
	"GRAAAH!\n"
	"I-…{PAUSE 30} I-…\p"

	"… … …\p"

	"I heard{PAUSE 30} they're not inviting\n"
	"me back for Gen 3.\p"

	"Sniff…\n"
	"{PAUSE 30}How could this happen to me…?", MSGBOX_NPC)
}

script CeruleanCave_Shortcut {
	msgbox(
	"Shorts Cut\n"
	"{LEFT_ARROW}", MSGBOX_SIGN)

}


script CeruleanCave_ShortsDad {
	lock
	faceplayer
	textcolor(0)
	msgbox(
	"DAD: Yo, {PLAYER}!\n"
	"What're you doing out here?\p"

	"Didn't you know I'm a proud member\n"
	"of the SHORTS GANG?\l"
	"I'm comfy and easy to wear!\p"

	"Well, never mind that.\n"
	"How about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}

script CeruleanCave_Gun {
	lock
	faceplayer
	playmoncry(SPECIES_REMORAID, CRY_MODE_DEFAULT)
	waitmoncry
	msgbox(
	"{PAUSE 30}Gang violence…\n"
	"", MSGBOX_DEFAULT)
	release
}