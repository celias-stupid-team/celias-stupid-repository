
const LASS = 1

mapscripts FushciaGym_ThePitRoom_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if(flag(FLAG_LASS_BROKE_WALL)) {
            call(FushciaGym_ThePitRoom_SetBrokenWall)

        }
        if(!flag(FLAG_MEMORIZED_SCROLL)) {
            setflag(FLAG_TEMP_3)
        }
        
        setrespawn(HEAL_LOCATION_FUSHCIA_GYM_THE_PIT_ROOM)
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        // VAR_FUSHCIA_GYM_PIT_STATE is set to 1 in FieldGetPlayerInput()
        VAR_FUSHCIA_GYM_PIT_STATE, 1: FushciaGym_ThePitRoom_OnFrame_CheckDirection
	    ]
}

script FushciaGym_ThePitRoom_OnFrame_CheckDirection {
    setvar(VAR_FUSHCIA_GYM_PIT_STATE, 0)
    if(!flag(FLAG_LASS_BROKE_WALL)) {
        goto(FushciaGym_ThePitRoom_LassBreaksWall)
    }
}

script FushciaGym_ThePitRoom_Sign {
    lock
    msgbox("TRAINER TIPS!\pPress start to save the game!\n", MSGBOX_DEFAULT)
    closemessage
    release
}

script FushciaGym_ThePitRoom_Lass {
	msgbox("The GYM LEADER set up the\ninvisible walls all over the GYM.\lBut…\pThey make me so anxious!\nAnyone could be looking at me!", MSGBOX_NPC)
	end
}


movement FushciaGym_PlayerJumpsBack {
    face_left
    lock_facing_direction
    jump_right
    unlock_facing_direction
}

script FushciaGym_ThePitRoom_LassBreaksWall {
    lock
    waitse
    textcolor(NPC_TEXT_COLOR_FEMALE)
    playbgm(MUS_LASS_INTRO, FALSE)
    delay(90)
    playbgm(MUS_NONE, TRUE)
    playse(SE_M_STRENGTH)
    setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 2)
    setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 2)
    setvar(VAR_SHAKESCREEN_NUM_SHAKES, 3)
    setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
    special(ShakeScreen)
    delay(60)
    playse(SE_M_STRENGTH)
    setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 4)
    setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 4)
    setvar(VAR_SHAKESCREEN_NUM_SHAKES, 5)
    setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
    special(ShakeScreen)
    delay(60)
    playse(SE_M_STRENGTH)
    setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 4)
    setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 4)
    setvar(VAR_SHAKESCREEN_NUM_SHAKES, 5)
    setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
    special(ShakeScreen)
    delay(60)
    playse(SE_EFFECTIVE)
    setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 4)
    setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 4)
    setvar(VAR_SHAKESCREEN_NUM_SHAKES, 5)
    setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
    special(ShakeScreen)
    call(FushciaGym_ThePitRoom_SetBrokenWall)
    setobjectxy(LASS, 11, 12)
    setobjectxyperm(LASS, 11, 12)
    special(DrawWholeMapView)
    getplayerxy(VAR_TEMP_3, VAR_TEMP_4)
    if(var(VAR_TEMP_3) == 11) {
        applymovement(LOCALID_PLAYER, FushciaGym_PlayerJumpsBack)
    }
    delay(120)
    msgbox("…\pYou knew you were looking at me,\ndidn't you?", MSGBOX_DEFAULT)
    playbgm(MUS_BATTLE_FRONTIER, TRUE)
    trainerbattle_no_intro(TRAINER_LASS_PIT, "Stop it!")
    setflag(FLAG_LASS_BROKE_WALL)
    applymovement(LASS, LassMovesAway)
    waitmovement(0)
    copyobjectxytoperm(LASS)
    setobjectmovementtype(LASS, MOVEMENT_TYPE_FACE_DOWN)
    release
    end

}

movement LassMovesAway {
    walk_up
    face_down
}

script FushciaGym_ThePitRoom_SetBrokenWall {
    setmetatile(5, 12, 0x39E, TRUE)
    setmetatile(6, 12, 0x39E, TRUE)
    setmetatile(7, 12, 0x39E, TRUE)
    setmetatile(8, 12, 0x39E, TRUE)
    setmetatile(9, 12, 0x39E, TRUE)
    setmetatile(10, 12, 0x39E, TRUE)
    setmetatile(11, 12, 0x3A9, FALSE)
    return
}