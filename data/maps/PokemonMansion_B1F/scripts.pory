raw `
	.byte 0

PokemonMansion_B1F_OnLoad::
	end

PokemonMansion_B1F_EventScript_Statue::
	lockall
	setvar VAR_0x8004, 3
	call PokemonMansion_EventScript_SecretSwitch
	playse SE_UNLOCK
	special DrawWholeMapView
	waitse
	releaseall
	end

PokemonMansion_B1F_EventScript_DiarySep1st::
	msgbox PokemonMansion_B1F_Text_MewtwoIsFarTooPowerful, MSGBOX_SIGN
	end

PokemonMansion_B1F_EventScript_Lewis::
	trainerbattle_single TRAINER_BURGLAR_LEWIS, PokemonMansion_B1F_Text_LewisIntro, PokemonMansion_B1F_Text_LewisDefeat
	msgbox PokemonMansion_B1F_Text_LewisPostBattle, MSGBOX_AUTOCLOSE
	end

PokemonMansion_B1F_EventScript_Ivan::
	trainerbattle_single TRAINER_SCIENTIST_IVAN, PokemonMansion_B1F_Text_IvanIntro, PokemonMansion_B1F_Text_IvanDefeat
	msgbox PokemonMansion_B1F_Text_IvanPostBattle, MSGBOX_AUTOCLOSE
	end
`
mapscripts PokemonMansion_B1F_MapScripts {
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_POKEMON_MANSION_LAVAFALL, 1 {
			delay(20)
			playbgm(MUS_NONE, TRUE)
			playse(SE_M_EMBER)
			fadescreeninstant(FADE_TO_WHITE)
			waitse
			delay(60)
			msgbox(
			"{PLAYER} fucking died!\n"
			"", MSGBOX_DEFAULT)
			closemessage
			setvar(VAR_POKEMON_MANSION_LAVAFALL, 0)
			warpsilent(MAP_POKEMON_MANSION_2F, 4)
			release
		}
	]
	MAP_SCRIPT_ON_TRANSITION {
		setflag(FLAG_WORLD_MAP_POKEMON_MANSION_1F)
	}
}

script PokemonMansion_Regice {
	lock
	faceplayer
	playmoncry(SPECIES_REGICE, CRY_MODE_DEFAULT)
	msgbox(
	"REGICE: Regiiiii!\n"
	"", MSGBOX_DEFAULT)
	waitmoncry
	closemessage
	delay(10)
	msgbox(
	"He's enjoying a warm bath.\n"
	"", MSGBOX_DEFAULT)
	release
}

script PokemonMansion_CoolLava {
	msgbox(
	"The lava here is pleasantly cool\n"
	"to the touch.", MSGBOX_SIGN)

}


script PokemonMansion_ResearcherTree {
	lock
	textcolor(NPC_TEXT_COLOR_TREE)
	msgbox(
	"Phew…\p"

	"I've been trying to do research\n"
	"here, but the heat is overwhelming!", MSGBOX_DEFAULT)
	closemessage
	delay(45)
	playse(SE_M_EMBER)
	applymovement(VAR_LAST_TALKED, moves(
		cut_tree
	))
	waitmovement(0)
	removeobject(VAR_LAST_TALKED)
	release
}

script PokemonMansion_Diary3 {
	lock
	
	msgbox(
	"Diary 3, February 6th:\n"
	"Wait! No!\l"
	"This baby is a demon child!", MSGBOX_DEFAULT)
	closemessage
	delay(45)
	playse(SE_M_EMBER)
	applymovement(VAR_LAST_TALKED, moves(
		cut_tree
	))
	waitmovement(0)
	removeobject(VAR_LAST_TALKED)
	release
}


script PokemonMansion_CookingMarshmallows {
	lock
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"Ahh…\p"

	"See, the secret to roasting the\n"
	"perfect marshmallow is holding it in\l"
	"juuuuuuust the right spot!", MSGBOX_DEFAULT)
	closemessage
	delay(45)
	playse(SE_M_EMBER)
	applymovement(LOCALID_MARSHMALLOW_1, moves(
		cut_tree
	))
	waitmovement(0)
	removeobject(LOCALID_MARSHMALLOW_1)
	delay(45)
	playse(SE_M_EMBER)
	applymovement(LOCALID_MARSHMALLOW_2, moves(
		cut_tree
	))
	waitmovement(0)
	removeobject(LOCALID_MARSHMALLOW_2)
	release
}


script PokemonMansion_Tabatha {
	textcolor(NPC_TEXT_COLOR_RED)
	msgbox(
	"I'm TABITHA of TEAM MAGMA!\n"
	"Soon this volcano will erupt and-\l"
	"Hey, wait!\p"

	"Why's my text red?\n"
	"", MSGBOX_NPC)
}

script PokemonMansion_Eruption {
	msgbox(
	"A meteorite has been placed in\n"
	"the machine.\l"
	"There's no stopping it now.\p"

	"A progress bar is displayed on the\n"
	"screen.\p"

	"TIME UNTIL ERUPTION:{PAUSE 30}\n"
	"TWO YEARS", MSGBOX_SIGN)

}


script PokemonMansion_MrFlamethrower {
	msgbox(
	"Here lies MR. FLAMETHROWER.\p"

	"We have left a TM here in his\n"
	"honor.", MSGBOX_SIGN)

}
script PokemonMansion_MrFlamethrowerGrave {
	msgbox(
	"mr flamethrower\n"
	"", MSGBOX_SIGN)

}

script PokemonMansion_FujiPhoto {
	msgbox(
	"It's a photograph of the MANSION's\n"
	"owner…\l"
	"…MR. FUJI?!", MSGBOX_SIGN)

}

script PokemonMansion_Pedestal {
	if(checkitem(ITEM_FUJI_BALL)) {
		lock
		msgbox(
		"A pedestal sits on the wall.\p"

		"{PLAYER} set MR. FUJI into the\n"
		"indent.", MSGBOX_DEFAULT)
		playse(SE_CLICK)
		waitse
		closemessage
		delay(30)
		playmoncry(SPECIES_MOLTRES, CRY_MODE_ENCOUNTER)
		addobject(LOCALID_MOLTRES_2)
		applymovement(LOCALID_MOLTRES_2, moves(
			walk_slow_down * 6
		))
		closemessage
		setflag(FLAG_SHINY_CREATION)
		setwildbattle(SPECIES_MOLTRES, 50)
		dowildbattle
		removeobject(LOCALID_MOLTRES_2)
		removeitem(ITEM_FUJI_BALL)

		release
		end
	}
	msgbox(
	"A pedestal sits on the wall.\p"

	"There's a small indent to set\n"
	"something in.", MSGBOX_SIGN)

}

script PokemonMansion_FireFlyingSign {
	msgbox(
	"For Fire/Flying, use Ice!\p"

	"This message was brought to you\n"
	"by the RBY Type Chart.", MSGBOX_SIGN)

}


script PokemonMansion_MoltresEgg {
	lock
	msgbox(
	"A large egg has been soft-boiling\n"
	"in the heat of the volcano.", MSGBOX_DEFAULT)
	closemessage
	delay(40)
	playse(SE_M_EMBER)
	applymovement(LOCALID_MOLTRES_EGG, moves(
		cut_tree
	))
	delay(40)
	applymovement(LOCALID_MOLTRES, moves(
		set_visible
	))
	waitmovement(LOCALID_MOLTRES_EGG)
	delay(20)
	playse(SE_EGG_HATCH)
	goto_if_questlog (EventScript_ReleaseEnd)
	special (QuestLog_CutRecording)
	
	setwildbattle (SPECIES_MOLTRES, 50, ITEM_VALOR_SEAL)
	waitse
	delay(10)
	playmoncry (SPECIES_MOLTRES, CRY_MODE_ENCOUNTER)
	
	waitmessage
	waitmoncry
	delay (10)
	playbgm (MUS_ENCOUNTER_GYM_LEADER, 0)
	delay(45)
	setflag (FLAG_SYS_SPECIAL_WILD_BATTLE)
	special (StartLegendaryBattle)
	waitstate
	clearflag (FLAG_SYS_SPECIAL_WILD_BATTLE)
	specialvar (VAR_RESULT, GetBattleOutcome)
	setflag(FLAG_TEMP_5)
	removeobject(LOCALID_MOLTRES_EGG)
	removeobject(LOCALID_MOLTRES)
	goto_if_eq (VAR_RESULT, B_OUTCOME_WON, MtEmber_Summit_EventScript_DefeatedMoltres)
	goto_if_eq (VAR_RESULT, B_OUTCOME_RAN, MtEmber_Summit_EventScript_RanFromMoltres)
	goto_if_eq (VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED, MtEmber_Summit_EventScript_RanFromMoltres)
	setflag (FLAG_FOUGHT_MOLTRES)
	release
	end

}

script PokemonMansion_Chapter3 {
	msgbox(
	"Shelf after shelf plasters the\n"
	"walls, all bearing the telltale\l"
	"title of “My Secret Life.”\p"

	"You feel overcome with a sense of\n"
	"deep understanding.\p"

	"Truly, you've found yourself in\n"
	"the depths of THREE{PAUSE 20} ISLAND.", MSGBOX_SIGN)

}

script PokemonMansion_Statues {
	msgbox(
	"The remains of a scrapped puzzle.\n"
	"", MSGBOX_SIGN)

}
