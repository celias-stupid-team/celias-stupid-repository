script TwoIsland_WaitThreeMinutes {
	lock
	if(var(VAR_TEMP_5) < 5) {
		addvar(VAR_TEMP_5, 1)
	} else {
		delay(10800)
		msgbox(
		"Hey!\n"
		"That's the secret code!\p"

		"C'mon in!\n"
		"", MSGBOX_DEFAULT)
		warp(MAP_TWO_ISLAND_WATERFALL_CAVE, 0)
	}
	release
}

script TwoIsland_FallingObjects {
	setvar(VAR_TEMP_1, 1)
	msgbox(
	"WARNING!\n"
	"Beware of falling objects!", MSGBOX_SIGN)

}


script TwoIsland_ThePit {
	setvar(VAR_TEMP_1, 2)
	hideobjectat(LOCALID_TWO_ISLAND_PENCIL, MAP_TWO_ISLAND)
	hideobjectat(LOCALID_TWO_ISLAND_MUSHROOM_KID, MAP_TWO_ISLAND)
	setlayouttiles(LAYOUT_TWO_ISLAND_PIT, 0, 0, 0, 0, 67, 28)
	release
}

script TwoIsland_NoThePit {
	setvar(VAR_TEMP_1, 0)
	if(!flag(FLAG_TWO_ISLAND_PENCIL)) {
		showobjectat(LOCALID_TWO_ISLAND_PENCIL, MAP_TWO_ISLAND)
	}
	showobjectat(LOCALID_TWO_ISLAND_MUSHROOM_KID, MAP_TWO_ISLAND)

	setlayouttiles(LAYOUT_TWO_ISLAND, 0, 0, 0, 0, 67, 28)
	release
}


