script TwoIsland_PencilHippie {
	famechecker(FAMECHECKER_GREAT_SEA_CENTER, 3)
	textcolor(NPC_TEXT_COLOR_MALE)
	if(flag(FLAG_TWO_ISLAND_PENCIL)) {
		msgbox(
		"Uhhh…\n"
		"Where'd my PENCILS go?", MSGBOX_NPC)
		end
	}
	msgbox(
	"Hey, hey!\n"
	"I'm selling PENCILS!\p"

	"A good friend of mine working at\n"
	"SILPH CO just placed a huge order.\p"

	"Apparently he needed them to test\n"
	"a cool invention he's making.\l"
	"I can't wait to see what he made!", MSGBOX_NPC)
}


script TwoIsland_HamburgerGuy {
	lock
	faceplayer
	//logic here
	if(!flag(FLAG_GOT_HAMBURGER)) {

	
		msgbox("Uh, hi!\pI work at the DRUGSTORE, and I was\nsupposed to be handing out free\lHAMBURGERS.\pHowever, it seems this is the last\nHAMBURGER in the known universe.\pUh, I guess you can have it.\n", MSGBOX_DEFAULT)
		//give item
		giveitem_msg("{PLAYER} obtained the\nHAMBURGER.", ITEM_HAMBURGER)
		waitfanfare
		setflag(FLAG_GOT_HAMBURGER)
		//set flag
	} else {
		msgbox("Come visit us if you need, uh,\nnot HAMBURGERS.", MSGBOX_DEFAULT)
	}
	release
	end
}

