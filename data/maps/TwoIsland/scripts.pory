	end
`
mapscripts TwoIsland_MapScripts {
	MAP_SCRIPT_ON_LOAD {
		if(flag(FLAG_CSR_HINT_MOVE_REMINDER) && !flag(FLAG_CSR_BERRY_POWDER_MAN) && !flag(FLAG_CHAPTER_7_CHAPTER_2_INTERMISSION_1)) {
			setvar(VAR_TEMP_A, 1)
			setflag(FLAG_CHAPTER_7_CHAPTER_2_INTERMISSION_1)
		}
	}
	MAP_SCRIPT_ON_TRANSITION: TwoIsland_OnTransition
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_TEMP_A, 1 {
			message(
			"Chapter 7 -{PAUSE 30} Chapter 2\n"
			"{PAUSE 60}Intermission 1")
			delay(200)
			message("The Quest for the\nBERRY POWDER MAN!")
			delay(200)
			setvar(VAR_TEMP_A, 0)
			release
		}
	]
}

script TwoIsland_OnTransition {
	setworldmapflag(FLAG_WORLD_MAP_TWO_ISLAND)
	setflag(FLAG_VISITED_TWO_ISLAND)
	if(flag(FLAG_TWO_ISLAND_DRAGONITE_PRESENT)) {
		setobjectmovementtype(LOCALID_DRAGONITE_PRESENT, MOVEMENT_TYPE_FACE_LEFT)
	}
	if(flag(FLAG_TWO_ISLAND_FUCK_PRESENT)) {
		setobjectmovementtype(LOCALID_HBOX_PRESENT, MOVEMENT_TYPE_FACE_LEFT)
	}
	if(flag(FLAG_TWO_ISLAND_OTHER_PRESENT)) {
		setobjectmovementtype(LOCALID_MUSIC_PRESENT, MOVEMENT_TYPE_FACE_LEFT)
	}
	if(flag(FLAG_TWO_ISLAND_BOMB_PRESENT)) {
		setobjectmovementtype(LOCALID_BOMB_PRESENT, MOVEMENT_TYPE_FACE_LEFT)
	}
}

script TwoIsland_PencilStatue {
	lock
	if(!checkitem(ITEM_PENCIL_ERASER)) {
		msgbox("A large statue of a PENCIL blocks\nthe way.", MSGBOX_DEFAULT)
		release
		end
	} else {
		msgbox("A large statue of a PENCIL blocks\nthe way.\pWould you like to use the PENCIL\nERASER?", MSGBOX_YESNO)
		if(var(VAR_RESULT)) {
			msgbox("{PLAYER} used the PENCIL ERASER.\n", MSGBOX_DEFAULT)
			// sound effect
			closemessage
			setflag(FLAG_TWO_ISLAND_PENCIL)
			//animation?
			removeobject(VAR_LAST_TALKED)
			removeitem(ITEM_PENCIL_ERASER)
			release
			end
		} else {
			release
			end
		}
	}
}

script TwoIsland_DragonitePresent {
	lock
	if(flag(FLAG_TWO_ISLAND_DRAGONITE_PRESENT)) {
		msgbox("The present is empty.\n", MSGBOX_DEFAULT)
		release
		end
	}
	applymovement(VAR_LAST_TALKED, moves(
		face_left
	))
	setobjectmovementtype(VAR_LAST_TALKED, MOVEMENT_TYPE_FACE_LEFT)
	msgbox("{PLAYER} opened the present.\n", MSGBOX_DEFAULT)
	playfanfare(MUS_LEVEL_UP)
	msgbox(
	"There was a\n"
	"BAG OF DRAGONITE!", MSGBOX_DEFAULT)
	waitfanfare
	setflag(FLAG_TWO_ISLAND_DRAGONITE_PRESENT)
	release
	end
}

script TwoIsland_BombPresent {
	lock
	if(flag(FLAG_TWO_ISLAND_BOMB_PRESENT)) {
		msgbox("The present is empty.\n", MSGBOX_DEFAULT)
		release
		end
	}
	applymovement(VAR_LAST_TALKED, moves(
		face_left
	))
	setobjectmovementtype(VAR_LAST_TALKED, MOVEMENT_TYPE_FACE_LEFT)
	msgbox("{PLAYER} opened the present.\n", MSGBOX_DEFAULT)
	msgbox(
	"There was a BOMB inside!\n"
	"", MSGBOX_DEFAULT)
	playbgm(MUS_NONE, TRUE)
	fadescreeninstant(FADE_TO_WHITE)
	closemessage
	playse(SE_M_EXPLOSION)
	waitse
	setflag(FLAG_TWO_ISLAND_BOMB_PRESENT)
	msgbox(
	"{PLAYER} fucking died!\n"
	"", MSGBOX_DEFAULT)
	warpsilent(MAP_TWO_ISLAND, 2)

	release
	end
}
script TwoIsland_MusicPresent {
	lock
	if(flag(FLAG_TWO_ISLAND_OTHER_PRESENT)) {
		msgbox("The present is empty.\n", MSGBOX_DEFAULT)
		release
		end
	}
	applymovement(VAR_LAST_TALKED, moves(
		face_left
	))
	setobjectmovementtype(VAR_LAST_TALKED, MOVEMENT_TYPE_FACE_LEFT)
	msgbox("{PLAYER} opened the present.\n", MSGBOX_DEFAULT)
	msgbox(
	"(insert good music here)\n"
	"", MSGBOX_DEFAULT)
	closemessage
	delay(60)
	msgbox(
	"Ah.\n"
	"", MSGBOX_DEFAULT)
	setflag(FLAG_TWO_ISLAND_OTHER_PRESENT)
	release
	end
}
script TwoIsland_HboxPresent {
	lock
	if(flag(FLAG_TWO_ISLAND_FUCK_PRESENT)) {
		msgbox("The present is empty.\n", MSGBOX_DEFAULT)
		release
		end
	}
	applymovement(VAR_LAST_TALKED, moves(
		face_left
	))
	setobjectmovementtype(VAR_LAST_TALKED, MOVEMENT_TYPE_FACE_LEFT)
	msgbox("{PLAYER} opened the present.\n", MSGBOX_DEFAULT)
	playmoncry(SPECIES_JIGGLYPUFF, CRY_MODE_ENCOUNTER)
	waitmoncry
	setwildbattle(SPECIES_JIGGLYPUFF, 30)
	dowildbattle
	setflag(FLAG_TWO_ISLAND_FUCK_PRESENT)
	release
	end
}

