script TwoIsland_GenevaConvention {
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox("Shh! Don't tell anyone, but we used\nto have a HOSPITAL here.\pSadly we literally committed war\ncrimes, so it got shut down!", MSGBOX_NPC)

}

script TwoIsland_DadPhone {
	lock
	textcolor(0)
	applymovement(VAR_LAST_TALKED, moves(
		walk_in_place_down * 8
	))
	playse(SE_ITEMFINDER)
	waitse
	playse(SE_ITEMFINDER)
	waitse
	playse(SE_ITEMFINDER)
	waitse
	waitmovement(0)
	delay(20)
	addmoney(5000)
	msgbox("DAD: {PLAYER}!\nWhat are you doing out here?\pI've deposited ¥5000 into your\nbank account.\lWould you like to SAVE your game?", MSGBOX_YESNO) 
	if(var(VAR_RESULT)) {
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		call(EventScript_AskSaveGame)
	}
	textcolor(0)
	msgbox("Well, never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}

