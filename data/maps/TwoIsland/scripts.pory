script TwoIsland_TerritorialOak {
	lock
	applymovement(LOCALID_TWOISLAND_TERRITORIALOAK, moves(
		face_up
	))
	textcolor(NPC_TEXT_COLOR_TREE)
	delay(60)
	msgbox(
	"{FONT_SMALL}Whazzat?\n"
	"Hey!\p"

	"Get off my property!\n"
	"", MSGBOX_DEFAULT)
	trainerbattle_no_intro(TRAINER_TERRITORIAL_OAK, "{FONT_SMALL}ow")
	closemessage
	delay(30)
	playse(SE_M_EXPLOSION)
	removeobject(LOCALID_TWOISLAND_TERRITORIALOAK)
	removeobject(LOCALID_TWO_ISLAND_FAKE_KID_1)
	removeobject(LOCALID_TWO_ISLAND_FAKE_KID_2)
	removeobject(LOCALID_TWO_ISLAND_FAKE_KID_1)
	removeobject(LOCALID_TWO_ISLAND_FAKE_KID_2)
	removeobject(LOCALID_TWO_ISLAND_FAKE_KID_3)
	removeobject(LOCALID_TWO_ISLAND_FAKE_KID_4)
	waitse
	release
}

script TwoIsland_HouseSalesman {
	lock
	faceplayer
	famechecker(FAMECHECKER_GREAT_SEA_CENTER, 4)
	if(flag(FLAG_BOUGHT_A_HOUSE)) {
		msgbox(
		"Wha-\n"
		"Hey!\l"
		"This HOUSE VOUCHER is expired!\p"

		"…{PAUSE 30}I think I'm homeless now.\n"
		"", MSGBOX_DEFAULT)
		release
		end
	}
	msgbox(
	"Hey, hey!\n"
	"Would you like to buy a HOUSE?\l"
	"I'm selling one for 7500 Dollars.\p"

	"It's right on the mainland, and\n"
	"there's a lovely bench out front!\l"
	"You can have a place of your own!\p"

	"So?\n"
	"How about it?", MSGBOX_DEFAULT)
	if(checkitem(ITEM_HOUSEVOUCHER)) {
		msgbox(
		"Hey!\n"
		"That's a HOUSE VOUCHER!\p"

		"Give it here!\n"
		"", MSGBOX_DEFAULT)
		removeitem(ITEM_HOUSEVOUCHER)
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		playfanfare(MUS_LEVEL_UP)
		msgbox(
		"{PLAYER} became a homeowner!\n"
		"", MSGBOX_DEFAULT)
		waitfanfare
		msgbox(
		"Go visit your house on\n"
		"ROUTE 5!\l"
		"South of CERULEAN CITY!", MSGBOX_DEFAULT)
		setflag(FLAG_BOUGHT_A_HOUSE)
	} else {
		closemessage
		delay(30)
		msgbox(
		"…What?\n"
		"A POKéDOLLAR?\l"
		"What kinda nonsense is that?\p"

		"Here on TWO ISLAND, we only accept\n"
		"real dollars!\p"

		"Come back when you can afford it!\n"
		"", MSGBOX_DEFAULT)
	}
	release
	end
}

