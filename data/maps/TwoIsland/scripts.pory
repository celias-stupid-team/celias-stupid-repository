script TwoIsland_EventScript_SansTest {
	lock
	faceplayer
	fadenewbgm(MUS_NONE)
	msgbox("{FONT_COMIC_SANS}hello .\peat shit thief", MSGBOX_DEFAULT)
	playbgm(MUS_MEGALOVANIA, TRUE)
	delay(60)
	if(flag(FLAG_GOT_ODDISH)) {
		fadedefaultbgm
		giveitem_msg("burn heal", ITEM_BURN_HEAL)
		waitfanfare
	}
	release
	end
}

script TwoIsland_HamburgerGuy {
	lock
	faceplayer
	//logic here
		msgbox("Uh, hi!\pI work at the DRUGSTORE, and I was\nsupposed to be handing out free\lHAMBURGERS\pHowever, it seems this is the last\nHAMBURGER in the known universe.\pUh, I guess you can have it.\n", MSGBOX_DEFAULT)
		//give item
		playfanfare(MUS_OBTAIN_ITEM)
		msgbox("{PLAYER} obtained the\nHAMBURGER.", MSGBOX_DEFAULT)
		waitfanfare
		//set flag
	//else
	msgbox("Come visit us if you need, uh,\nnot HAMBURGERS.", MSGBOX_DEFAULT)
	release
	end
}

