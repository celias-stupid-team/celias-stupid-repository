script TwoIsland_BlueBlue {
	lock
	msgbox(
	"Blue, blue…\n"
	"", MSGBOX_DEFAULT)
	closemessage
	faceplayer
	msgbox(
	"That's the color I'm painting\n"
	"the OCEAN.\p"
