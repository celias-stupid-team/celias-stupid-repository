script TwoIsland_BlueBlue {
	lock
	textcolor(NPC_TEXT_COLOR_MALE)
	msgbox(
	"Blue, blue…\n"
	"", MSGBOX_DEFAULT)
	closemessage
	faceplayer
	msgbox(
	"That's the color I'm painting\n"
	"the OCEAN.\p"
	"It's dyed a deep blue…", MSGBOX_DEFAULT)
	closemessage
	applymovement(VAR_LAST_TALKED, moves(
		face_original_direction
	))
	msgbox(
	"Blue, blue…\n"
	"", MSGBOX_DEFAULT)
	release
}

script TwoIsland_BurnHeal {
	lock
	playfanfare(MUS_LEVEL_UP)
	applymovement(VAR_LAST_TALKED, moves(
		set_invisible
	))
	setrespawn(HEAL_LOCATION_TWO_ISLAND)
	msgbox(
	"{PLAYER} found a\n"
	"BURN HEAL!", MSGBOX_DEFAULT)
	waitfanfare
	closemessage
	fadenewbgm(MUS_NONE)
	delay(60)
	applymovement(LOCALID_TWO_ISLAND_SANS, moves(
		walk_slower_right
		face_down
	))
	waitmovement(LOCALID_TWO_ISLAND_SANS)
	delay(60)
	msgbox(
	"{FONT_COMIC_SANS}hey.\p"

	"that burn heal costs 300 dollars\p"

	"is that acceptable to you?\n"
	"", MSGBOX_YESNO)
	if(var(VAR_RESULT)) {
		msgbox(
		"{FONT_COMIC_SANS}okay{PAUSE 50}\n"
		"one small problem\p"

		"you dont seem to have any\n"
		"dollars\p"

		"do you want to take it anyway?\n"
		"", MSGBOX_YESNO)
	} else {
		msgbox(
		"{FONT_COMIC_SANS}well\p"

		"if you can't afford it…\p"

		"…why did you pick it up?\p"

		"are you gonna take it anyway?\n"
		"", MSGBOX_YESNO)
	}
	if(var(VAR_RESULT)) {
		msgbox(
			"{FONT_COMIC_SANS}oh\n"
			"{PAUSE 60}i see\p"

			"i think{PAUSE 30} that kids like you{PAUSE 60}\p"

			"{PAUSE 30}should be burning in hell.\n"
			"", MSGBOX_DEFAULT)
		closemessage
		delay(30)
		msgbox(
		"{FONT_COMIC_SANS}eat shit and die, thief\n"
		"", MSGBOX_DEFAULT)
		
		trainerbattle_no_intro(TRAINER_SANS, "darn")
		if(checkpartymove(MOVE_MAGICAL_LEAF) != PARTY_SIZE) {
			fadedefaultbgm
			msgbox(
			"{FONT_COMIC_SANS}I am dead\n"
			"", MSGBOX_DEFAULT)
			giveitem(ITEM_BURN_HEAL)
			release
			end
		}
		msgbox(
		"Foe KECLEON dodges all of your\n"
		"attacks.", MSGBOX_DEFAULT)
		closemessage
		delay(120)
		msgbox(
		"{FONT_COMIC_SANS}you lose\p"

		"no burn heal for you\n"
		"", MSGBOX_DEFAULT)
		goto(EventScript_FieldWhiteOut)
		release
		end
	} else {
		msgbox(
		"{FONT_COMIC_SANS}okay\p"

		"put it back then\n"
		"", MSGBOX_DEFAULT)
		closemessage
		delay(30)
		applymovement(LOCALID_TWO_ISLAND_SANS, moves(
			walk_slower_left
			face_down
		))
		waitmovement(LOCALID_TWO_ISLAND_SANS)
		delay(30)
		playse(SE_BALL)
		applymovement(VAR_LAST_TALKED, moves(
			set_visible
		))
		applymovement(LOCALID_PLAYER, moves(
			walk_in_place_up
		))
		delay(60)
		msgbox(
		"{FONT_COMIC_SANS}thanks\n"
		"", MSGBOX_DEFAULT)
		fadedefaultbgm
		release
	}
}


