raw `
ViridianCity_Mart_MapScripts::
	map_script MAP_SCRIPT_ON_LOAD, ViridianCity_Mart_OnLoad
	map_script MAP_SCRIPT_ON_FRAME_TABLE, ViridianCity_Mart_OnFrame
	.byte 0

ViridianCity_Mart_OnLoad::
	goto_if_unset FLAG_SYS_POKEDEX_GET, ViridianCity_Mart_EventScript_HideQuestionnaire
	end

ViridianCity_Mart_EventScript_HideQuestionnaire::
	setmetatile 1, 3, METATILE_Mart_CounterMid_Top, 1
	setmetatile 1, 4, METATILE_Mart_CounterMid_Bottom, 1
	end

ViridianCity_Mart_OnFrame::
	map_script_2 VAR_MAP_SCENE_VIRIDIAN_CITY_MART, 0, ViridianCity_Mart_EventScript_ParcelScene
	.2byte 0

ViridianCity_Mart_EventScript_ParcelScene::
	lockall
	textcolor NPC_TEXT_COLOR_MALE
	applymovement LOCALID_VIRIDIAN_MART_CLERK, Common_Movement_WalkInPlaceFasterDown
	waitmovement 0
	msgbox ViridianCity_Mart_Text_YouCameFromPallet
	closemessage
	applymovement LOCALID_VIRIDIAN_MART_CLERK, ViridianCity_Mart_Movement_FacePlayer
	applymovement LOCALID_PLAYER, ViridianCity_Mart_Movement_ApproachCounter
	waitmovement 0
	msgbox ViridianCity_Mart_Text_TakeThisToProfOak
	setvar VAR_MAP_SCENE_VIRIDIAN_CITY_MART, 1
	giveitem_msg ViridianCity_Mart_Text_ReceivedOaksParcelFromClerk, ITEM_OAKS_PARCEL, 1, MUS_OBTAIN_KEY_ITEM
	setvar VAR_MAP_SCENE_PALLET_TOWN_PROFESSOR_OAKS_LAB, 5
	//increment VAR_ROUTE01_SHINY_RAT2 so the second shiny Rattata triggers
	setvar VAR_ROUTE01_SHINY_RAT2, 1
	releaseall
	end

ViridianCity_Mart_Movement_ApproachCounter::
	walk_up
	walk_up
	walk_up
	walk_up
	walk_in_place_faster_left
	step_end

ViridianCity_Mart_Movement_FacePlayer::
	delay_16
	delay_16
	delay_16
	delay_16
	walk_in_place_faster_right
	step_end

ViridianCity_Mart_EventScript_Clerk::
	lock
	faceplayer
	goto_if_eq VAR_MAP_SCENE_VIRIDIAN_CITY_MART, 1, ViridianCity_Mart_EventScript_SayHiToOak
	goto_if_questlog EventScript_ReleaseEnd
	message Text_MayIHelpYou
	waitmessage
	pokemart ViridianCity_Mart_Items
	msgbox Text_PleaseComeAgain
	release
	end

	.align 2
ViridianCity_Mart_Items::
	.2byte ITEM_POKE_BALL
	.2byte ITEM_ETHER
	.2byte ITEM_ANTIDOTE
	.2byte ITEM_PARALYZE_HEAL
	.2byte ITEM_NONE
	release
	end

ViridianCity_Mart_EventScript_SayHiToOak::
	msgbox ViridianCity_Mart_Text_SayHiToOakForMe
	release
	end

ViridianCity_Mart_EventScript_Woman::
	msgbox ViridianCity_Mart_Text_ShopDoesGoodBusinessInAntidotes, MSGBOX_NPC
	end

ViridianCity_Mart_EventScript_Youngster::
	msgbox ViridianCity_Mart_Text_GotToBuySomePotions, MSGBOX_NPC
	end
`


script EventScript_Questionnaire {
	lockall
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	setvar(VAR_0x8002, 2)
	setvar(VAR_0x8004, 2)
	setvar(VAR_0x8005, 2)
	setvar(VAR_0x8006, 0)
	msgbox(Text_FillOutQuestionnaire, MSGBOX_YESNO)
	goto_if_eq(VAR_RESULT, NO, EventScript_DeclineQuestionnaire)
	setvar(VAR_0x8004, EASY_CHAT_TYPE_QUESTIONNAIRE)
	call(Common_ShowEasyChatScreen)
	lock
	faceplayer
	specialvar(VAR_0x8008, GetMartClerkObjectId)
	textcolor(NPC_TEXT_COLOR_MALE)
	if(var(VAR_0x8005) == 0 && !flag(FLAG_GOT_PSYCHIC_KEY)) {
		fadenewbgm(MUS_DUMMY)
		delay(30)
		playse(SE_PIN)
		applymovement(VAR_0x8008, PokeMart_FaceDownExclamation)
		waitmovement(0)
		delay(30)
		textcolor(NPC_TEXT_COLOR_MALE)
		msgbox("Hey! Wait!\nHow did you know those words?\pI… {PAUSE 30}I've been waiting a long time\nfor someone like you to come.\lI think it must finally be time.\pHere, take this.\nYou've earned it.", MSGBOX_DEFAULT)
		closemessage
		giveitem_msg("{PLAYER} was given the\nPSYCHIC KEY!", ITEM_PSYCHIC_KEY)
		setflag(FLAG_GOT_PSYCHIC_KEY)
		msgbox("You'll know what to do with it.\nI believe in you.", MSGBOX_DEFAULT)
		closemessage
		applymovement(VAR_0x8008, Common_Movement_FaceOriginalDirection)
		waitmovement(0)
		fadedefaultbgm
		release
		end

	}
	if(var(VAR_0x8006)) {
		if(flag(FLAG_GOT_SHINY_CHANSEY)) {
			goto(EventScript_TookQuestionnaire)
		}
		
		
		playse(SE_PIN)
		applymovement(VAR_0x8008, PokeMart_FaceDownExclamation)
		waitmovement(0)
		delay(30)
		textcolor(NPC_TEXT_COLOR_MALE)
		msgbox(
		"Oh!\n"
		"Are you a courier from YES?\l"
		"We've been waiting for you.\p"

		"Here, take this POKéMON.\n"
		"", MSGBOX_DEFAULT)
		closemessage
		setflag(FLAG_SHINY_CREATION)
		setvar(VAR_CSR_GIFT_POKEMON, SPECIES_CHANSEY)
		playfanfare(MUS_LEVEL_UP)
		msgbox("{PLAYER} was given a\nCHANSEY!", MSGBOX_DEFAULT)
		waitfanfare
		call(Common_Script_GiftPokemon)
		setflag(FLAG_GOT_SHINY_CHANSEY)
		msgbox(
		"Ah yes, good.\n"
		"", MSGBOX_DEFAULT)
		closemessage
		applymovement(VAR_0x8008, Common_Movement_FaceOriginalDirection)
		waitmovement(0)
		fadedefaultbgm
		release
		end

	}
	
	goto_if_eq(VAR_0x8002, 0, PokeMart_ShinyVulpix)
	goto_if_eq(VAR_0x8004, 0, EventScript_EnableMysteryGift)
	goto_if_eq(VAR_RESULT, 0, EventScript_DeclineQuestionnaire)
	goto_if_eq(VAR_RESULT, 1, EventScript_TookQuestionnaire)
}

script PokeMart_ShinyVulpix {
	if(flag(FLAG_GOT_SHINY_VULPIX)) {
		goto(EventScript_TookQuestionnaire)
	} else {
		fadenewbgm(MUS_DUMMY)
		delay(30)
		playse(SE_PIN)
		applymovement(VAR_0x8008, PokeMart_FaceDownExclamation)
		waitmovement(0)
		delay(30)
		textcolor(NPC_TEXT_COLOR_MALE)
		msgbox("Oh, hey!\nThat's a valid password!\pIt's not quite as good as\nNARPAS SWORD, but hey!\lIt'll do in a pinch.\pHere's what you've unlocked.\nEnjoy!", MSGBOX_DEFAULT)
		closemessage
		setflag(FLAG_SHINY_CREATION)
		setvar(VAR_CSR_GIFT_POKEMON, SPECIES_VULPIX)
		playfanfare(MUS_LEVEL_UP)
		msgbox("{PLAYER} was given two E TANKS,\nMISSILES, and a VULPIX!", MSGBOX_DEFAULT)
		waitfanfare
		call(Common_Script_GiftPokemon)
		setflag(FLAG_GOT_SHINY_VULPIX)
		msgbox("Hey, best of luck with that.\pI'm sure you'll be able to beat\nMOTHER BRAIN!", MSGBOX_DEFAULT)
		closemessage
		applymovement(VAR_0x8008, Common_Movement_FaceOriginalDirection)
		waitmovement(0)
		fadedefaultbgm
		release
		end
	}
}


movement PokeMart_FaceDownExclamation {
	face_down
	emote_exclamation_mark
}
