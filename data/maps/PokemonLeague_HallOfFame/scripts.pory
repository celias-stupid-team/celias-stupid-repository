raw `
PokemonLeague_HallOfFame_MapScripts::
	map_script MAP_SCRIPT_ON_FRAME_TABLE, PokemonLeague_HallOfFame_OnFrame
	map_script MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE, PokemonLeague_HallOfFame_OnWarp
	.byte 0

PokemonLeague_HallOfFame_OnWarp::
	map_script_2 VAR_TEMP_1, 0, PokemonLeague_HallOfFame_EventScript_TurnPlayerNorth
	.2byte 0


PokemonLeague_HallOfFame_OnFrame::
	map_script_2 VAR_TEMP_1, 2, PokemonLeague_HallOfFame_EventScript_EnterRoom
	.2byte 0



PokemonLeague_HallOfFame_Movement_EnterRoom::
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	step_end
`

script PokemonLeague_HallOfFame_EventScript_EnterRoom {
	lockall
	textcolor(NPC_TEXT_COLOR_TREE)
	applymovement(LOCALID_PLAYER, PokemonLeague_HallOfFame_Movement_EnterRoom)
	waitmovement(0)
	applymovement(LOCALID_HALL_OF_FAME_PROF_OAK, Common_Movement_WalkInPlaceFasterLeft)
	applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterRight)
	waitmovement(0)
	delay(18)
	setvar(VAR_RESULT, 0)
	msgbox(PokemonLeague_HallOfFame_Text_OakCongratulations)
	while(var(VAR_RESULT) != 2) {
		dynmultichoice(19, 6, TRUE, 3, 0, DYN_MULTICHOICE_CB_NONE, "BOY", "GIRL", "CUT")
		if(var(VAR_RESULT) != 2) {
			waitse
		}
	}
	closemessage
	playbgm(MUS_NONE, TRUE)
	playse(SE_M_CUT)
	applymovement(LOCALID_HALL_OF_FAME_PROF_OAK, Movement_CutTreeDown)
	waitmovement(0)
	removeobject(LOCALID_HALL_OF_FAME_PROF_OAK)
	delay(60)
	setvar(VAR_TEMP_1, 1)
	clearflag(FLAG_DEFEATED_CHAMP)
	call(EventScript_SetDefeatedEliteFourFlagsVars)
	setrespawn(HEAL_LOCATION_PALLET_TOWN)
	fadescreenspeed(FADE_TO_BLACK, 0)
	setvar(VAR_CSR_CYNTHIA_BATTLE, 0)
	setvar(VAR_LANCE_LASS_ATTACK, 0)
	setvar(VAR_CSR_FINAL_BATTLE_TURN, 0)
	setvar(VAR_CSR_FINAL_BATTLE_PHASE, 0)
	clearflag(FLAG_KILLED_E4_OAK)
	 clearflag (FLAG_DEFEATED_LORELEI)
	clearflag (FLAG_DEFEATED_BRUNO)
	clearflag (FLAG_DEFEATED_AGATHA)
	clearflag (FLAG_DEFEATED_LANCE)
	clearflag (FLAG_DEFEATED_CHAMP)

	special(EnterHallOfFame)
	waitstate
	releaseall
}

script HallOfFame_Toaster {
	lock
	msgbox("It looks like the HALL OF FAME, but\nit's actually a very fancy toaster.", MSGBOX_DEFAULT)
	call(Common_ToastYourDonut)
	release
	end
}

script HallOfFame_NotReady {
	msgbox("Oh!\nHello there, {PLAYER}!\pLooks like you're here a little\nearly.\pUhh, we actually aren't quite ready\nfor you yet.\pI don't suppose you could go and\nfinish the rest of the game while\lwe get everything set up?", MSGBOX_NPC)
	end
}
script PokemonLeague_HallOfFame_EventScript_TurnPlayerNorth {
	turnobject(LOCALID_PLAYER, DIR_NORTH)
	if(flag(FLAG_DEFEATED_CHAMP)) { //At some point make this a better flag, but it'll do for now
		setvar(VAR_TEMP_1, 2)
		//playbgm(MUS_SLOW_PALLET, TRUE)
	}
}
