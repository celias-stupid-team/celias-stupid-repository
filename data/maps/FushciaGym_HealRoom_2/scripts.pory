
const NURSE = 1
mapscripts FushciaGym_HealRoom_2_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        getplayerxy(VAR_TEMP_2, VAR_TEMP_3)
        switch(var(VAR_TEMP_2)) {
            case 13:
                setobjectxyperm(NURSE, 13, 10)
                setvar(VAR_TEMP_1, 1)
            case 16:
                setobjectxyperm(NURSE, 16, 10)
            default:
                setobjectxyperm(NURSE, 10, 10)
        }
        setrespawn(HEAL_LOCATION_FUSHCIA_GYM_HEAL_ROOM_2)
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_1, 0 {
            setvar(VAR_TEMP_1, 1)
            applymovement(NURSE, Common_Movement_WalkDown)
            waitmovement(0)
            call(FushciaGym_HealNurse)
            
        }
    ]
}