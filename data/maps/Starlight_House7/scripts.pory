mapscripts Starlight_House7_MapScripts {

}

script Starlight_House_Infinite_Stairs_Test {
	specialvar(VAR_RESULT, GetPlayerAvatarBike)
	if(var(VAR_RESULT)) {
		lock
		delay(20)
		getplayerxy(VAR_RESULT, VAR_TEMP_2)
		switch(var(VAR_RESULT)) {
			case 7:
				applymovement(LOCALID_PLAYER, StarlightHouse_PlayerRepositionsRight_1)
				waitmovement(0)
			case 9:
				applymovement(LOCALID_PLAYER, StarlightHouse_PlayerRepositionsLeft_1)
				waitmovement(0)
			default:
				applymovement(LOCALID_PLAYER, Common_Movement_FaceDown)
				waitmovement(0)
				delay(16)
		}
		fadeoutbgm(1)
		delay(10)
		//Blj sound, cry?
		playmoncry(SPECIES_XERNEAS, CRY_MODE_NORMAL)
		playse(SE_LEDGE)
		applymovement(LOCALID_PLAYER, StarlightHouse_PlayerJumpsInPlace)
		waitmovement(0)
		waitmoncry
		playmoncry(SPECIES_XERNEAS, CRY_MODE_NORMAL)
		playse(SE_LEDGE)
		applymovement(LOCALID_PLAYER, StarlightHouse_PlayerJumpsInPlace)
		waitmovement(0)
		waitmoncry
		playmoncry(SPECIES_MIRAIDON, CRY_MODE_NORMAL)
		applymovement(LOCALID_PLAYER, StarlightHouse_PlayerJumpsUp)
		waitmovement(0)
		applymovement(LOCALID_PLAYER, StarlightHouse_JumpUpEnd)
		closemessage
		fadescreenswapbuffers(FADE_TO_BLACK)
		fadeoutbgm(2)
		delay(60)
		playse(SE_WARP_OUT)
		warp(MAP_STARLIGHT_HOUSE5, 4)
		playbgm(MUS_DUMMY, TRUE)
		delay(120)
		fadescreenswapbuffers(FADE_FROM_BLACK)
		release
		end
	}
	release
}

movement StarlightHouse_JumpUpEnd {
	jump_2_up * 4

}

movement StarlightHouse_PlayerJumpsUp {
	jump_in_place_down
	jump_up * 3
}

movement StarlightHouse_PlayerJumpsInPlace {
	lock_facing_direction
	jump_in_place_down
}

movement StarlightHouse_PlayerRepositionsRight_1 {
	face_right
	delay_16
	walk_slower_right
	face_down
}

movement StarlightHouse_PlayerRepositionsLeft_1 {
	face_left
	delay_16
	walk_slower_left
	face_down
}