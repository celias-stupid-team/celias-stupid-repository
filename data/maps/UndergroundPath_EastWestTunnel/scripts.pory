mapscripts UndergroundPath_EastWestTunnel_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setworldmapflag(FLAG_WORLD_MAP_UNDERGROUND_PATH_EAST_WEST_TUNNEL)
		setflag(FLAG_TEMP_2)
		if(flag(FLAG_CSR_HINT_GOLD_TEETH) && !flag(FLAG_GOT_GOLD_TEETH)) {
			addvar(VAR_CANT_FIND_TEETH, 1)
		}
		if(var(VAR_CANT_FIND_TEETH) > 1) {
			setmaplayoutindex(LAYOUT_UNDERGROUND_PATH_EAST_WEST_TUNNEL_LAYOUT_2)
			if(flag(FLAG_GOT_GOLD_TEETH)) {
				clearflag(FLAG_TEMP_2)
			}
		}

	}
}

script UndergroundPath_GoldTeeth {
	if(!flag(FLAG_GOT_GOLD_TEETH)) {
		setflag(FLAG_GOT_GOLD_TEETH)
		finditem(ITEM_GOLD_TEETH)
	} else {
		lock
		msgbox("Who manages to drop their teeth\nanyway?", MSGBOX_DEFAULT)
		release
	}
}

script UndergroundPath_Lass {
	msgbox("…\pThis disturbs me.\n", MSGBOX_NPC)
}

script UndergroundPath_CeliaSecret {
	msgbox("People had a LOT of trouble\nfinding the gold teeth.\pIf you keep coming in here and\nnot finding them, a giant sign\lappears pointing at them.", MSGBOX_NPC)
}

