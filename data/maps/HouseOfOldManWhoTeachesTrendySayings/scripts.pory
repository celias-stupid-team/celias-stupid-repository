mapscripts HouseOfOldManWhoTeachesTrendySayings_MapScripts {

}


script OldManWhoTeachesTrendySayings {
    random(6)
    lock
    faceplayer
    switch(var(VAR_RESULT)) {
        case 0:
            msgbox(
            "Kerflumpleton!\n"
            "", MSGBOX_DEFAULT)
        case 1:
            msgbox(
            "Jas-kerilla!\n"
            "", MSGBOX_DEFAULT)
        case 2:
            msgbox(
            "Bon-dongulus!\n"
            "", MSGBOX_DEFAULT)
        case 3:
            msgbox(
            "Ginorgol-dagong!\n"
            "", MSGBOX_DEFAULT)
        case 4:
            msgbox(
            "Frentilliary!\n"
            "", MSGBOX_DEFAULT)
        case 5:
            msgbox(
            "Myriatolus!\n"
            "", MSGBOX_DEFAULT)

    }
    copyvar(VAR_TEMP_1, VAR_RESULT)
    closemessage
    delay(40)
    msgbox(
	"…{PAUSE 30}That is all.\n"
	"", MSGBOX_DEFAULT)
    closemessage
    applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    release
}