raw `
Route23_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, Route23_OnTransition
	.byte 0

Route23_OnTransition::
	clearflag FLAG_HIDE_VICTORY_ROAD_3F_BOULDER
	setflag FLAG_HIDE_VICTORY_ROAD_2F_BOULDER
	end

Route23_EventScript_CascadeBadgeGuard::
	lock
	faceplayer
	setvar VAR_TEMP_1, 2
	bufferstdstring STR_VAR_1, STDSTRING_CASCADE_BADGE
	goto Route23_EventScript_BadgeGuard
	end

Route23_EventScript_ThunderBadgeGuard::
	lock
	faceplayer
	setvar VAR_TEMP_1, 3
	bufferstdstring STR_VAR_1, STDSTRING_THUNDER_BADGE
	goto Route23_EventScript_BadgeGuard
	end

Route23_EventScript_RainbowBadgeGuard::
	lock
	faceplayer
	setvar VAR_TEMP_1, 4
	bufferstdstring STR_VAR_1, STDSTRING_RAINBOW_BADGE
	goto Route23_EventScript_BadgeGuard
	end

Route23_EventScript_SoulBadgeGuard::
	lock
	faceplayer
	setvar VAR_TEMP_1, 5
	bufferstdstring STR_VAR_1, STDSTRING_SOUL_BADGE
	goto Route23_EventScript_BadgeGuard
	end

Route23_EventScript_MarshBadgeGuard::
	lock
	faceplayer
	setvar VAR_TEMP_1, 6
	bufferstdstring STR_VAR_1, STDSTRING_MARSH_BADGE
	goto Route23_EventScript_BadgeGuard
	end

Route23_EventScript_VolcanoBadgeGuard::
	lock
	faceplayer
	setvar VAR_TEMP_1, 7
	bufferstdstring STR_VAR_1, STDSTRING_VOLCANO_BADGE
	goto Route23_EventScript_BadgeGuard
	end

Route23_EventScript_EarthBadgeGuard::
	lock
	faceplayer
	setvar VAR_TEMP_1, 8
	bufferstdstring STR_VAR_1, STDSTRING_EARTH_BADGE
	goto Route23_EventScript_BadgeGuard
	end

Route23_EventScript_CascadeBadgeGuardTrigger::
	lockall
	setvar VAR_TEMP_1, 2
	setvar VAR_0x8009, LOCALID_CASCADE_BADGE_GUARD
	bufferstdstring STR_VAR_1, STDSTRING_CASCADE_BADGE
	goto Route23_EventScript_BadgeGuardTrigger
	end


Route23_EventScript_VictoryRoadGateSign::
	msgbox Route23_Text_VictoryRoadGateSign, MSGBOX_SIGN
	end
`
script Route23_EventScript_CeliaZapdos {
	msgbox("The idea of just casually dropping\nZAPDOS to anyone who decides to\lactually come back here is so good.\pI don't have much to say - I just\nthink it's extremely funny.", MSGBOX_NPC)
	end
}

//Add logic so that he has new dialogue if you come here early
script Route23_EventScript_Child {
	lock
	faceplayer
	if(flag(FLAG_BADGE04_GET)) {
		
		msgbox(("Yup, ZAPDOS really is that easy\nto find.\pI'm surprised you didn't come\nback here sooner!"), MSGBOX_DEFAULT)
	} else {
		msgbox("Yup, ZAPDOS really is that easy\nto find.\pGood job remembering to come back\nto check!", MSGBOX_DEFAULT)
	}
	release
}

script PowerPlant_EventScript_Zapdos {
	goto_if_questlog(EventScript_ReleaseEnd)
	special(QuestLog_CutRecording)
	lock
	faceplayer
	setwildbattle(SPECIES_ZAPDOS, 50, ITEM_INSTINCT_SEAL)
	waitse
	playmoncry(SPECIES_ZAPDOS, CRY_MODE_ENCOUNTER)
	message(Text_Gyaoo)
	waitmessage
	waitmoncry
	delay(10)
	playbgm(MUS_ENCOUNTER_GYM_LEADER, 0)
	waitbuttonpress
	setflag(FLAG_SYS_SPECIAL_WILD_BATTLE)
	special(StartLegendaryBattle)
	waitstate
	clearflag(FLAG_SYS_SPECIAL_WILD_BATTLE)
	specialvar(VAR_RESULT, GetBattleOutcome)
	goto_if_eq(VAR_RESULT, B_OUTCOME_WON, PowerPlant_EventScript_DefeatedZapdos)
	goto_if_eq(VAR_RESULT, B_OUTCOME_RAN, PowerPlant_EventScript_RanFromZapdos)
	goto_if_eq(VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED, PowerPlant_EventScript_RanFromZapdos)
	setflag(FLAG_FOUGHT_ZAPDOS)
	release
	end
}


script Route23_GetNationalDexRotomLeaves {
	//walk into explicit frame
	closemessage
	specialvar(VAR_RESULT, GetPlayerFacingDirection)
	fadenewbgm(MUS_NONE)
	switch(var(VAR_RESULT)) {
		case DIR_NORTH:
			applymovement(LOCALID_PLAYER, moves(
				walk_slow_right
				walk_slow_up
				face_left

			))
			waitmovement(LOCALID_PLAYER)
		case DIR_SOUTH:
			applymovement(LOCALID_PLAYER, moves(
				walk_slow_right
				walk_slow_down
				face_left

			))
			waitmovement(LOCALID_PLAYER)
		case DIR_EAST:
			applymovement(LOCALID_PLAYER, moves(
				walk_slow_down
				walk_slow_right * 2
				walk_slow_up
				face_left

			))
			waitmovement(LOCALID_PLAYER)
	}
	applymovement(VAR_LAST_TALKED, moves(
		face_right
	))

	msgbox(
	"And also, I have one more surprise\n"
	"for you!\p"

	"Because you've caught every single\n"
	"POKéMON found in the KANTO region,\l"
	"your POKéDEX can now be upgraded!\p"

	"Let me see it for a moment, and I\n"
	"can install the NATIONAL DEX!", MSGBOX_DEFAULT)
	closemessage
	delay(20)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox(
	"{PLAYER} gave away the POKéDEX\n"
	"for an upgrade…", MSGBOX_DEFAULT)
	closemessage
	textcolor(NPC_TEXT_COLOR_BLUE)
	delay(30)
	msgbox(
	"…{PAUSE 30}Aha! Excellent!\n"
	"The upgrade was successful!\l"
	"Here you are!", MSGBOX_DEFAULT)
	closemessage
	delay(10)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	playfanfare(MUS_SLOTS_JACKPOT)
	msgbox(
	"{PLAYER} obtained the\n"
	"NATIONAL POKéDEX!", MSGBOX_DEFAULT)
	waitfanfare
	closemessage
	delay(20)
	playmoncry(SPECIES_ROTOM, CRY_MODE_FAINT)
	waitmoncry
	msgbox(
	"… … …?\n"
	"", MSGBOX_DEFAULT)
	closemessage
	clearflag(FLAG_SYS_ROTOM_MENU)
	special(EnableNationalPokedex)
	fadescreeninstant(FADE_TO_WHITE)
	applymovement(VAR_LAST_TALKED, moves(
		walk_fastest_left
		face_right
	))
	addobject(LOCALID_ROUTE23_ROTOM)
	setobjectxy(LOCALID_ROUTE23_ROTOM, 18, 11)
	applymovement(LOCALID_ROUTE23_ROTOM, moves(
		set_visible
	))
	waitmovement(VAR_LAST_TALKED)
	fadescreen(FADE_FROM_WHITE)
	delay(30)
	//rotom moves out of the dex
	playmoncry(SPECIES_ROTOM, CRY_MODE_DEFAULT)
	msgbox(
	"Oh no!\p"

	"ROTOM isn't compatible with the\n"
	"new firmware!\l"
	"He's been uninstalled!", MSGBOX_DEFAULT)
	closemessage
	applymovement(LOCALID_ROUTE23_ROTOM, moves(
		walk_slow_up * 6
		set_invisible
	))
	applymovement(LOCALID_PLAYER, moves(
		delay_16 * 3
		face_up
	))
	waitmovement(LOCALID_ROUTE23_ROTOM)
	applymovement(LOCALID_PLAYER, moves(
		face_left
	))
	//rotom runs away
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"Ah, looks like there's a few apps\n"
	"that don't work anymore.\l"
	"Sorry about that!\p"

	"Oh, well.\n"
	"I'm sure they weren't important!", MSGBOX_DEFAULT)
	fadedefaultbgm
	release
	end
}


script IndigoPlateau_RockClimbUp {
	lockall
	msgbox("Jagged rocks line the wall.\n", MSGBOX_DEFAULT)
	if(checkfieldmove(MOVE_ROCK_CLIMB) != PARTY_SIZE) {
		msgbox("Would you like to use\nROCK CLIMB?", MSGBOX_YESNO)
		closemessage
		if(var(VAR_RESULT)) {
			applymovement(LOCALID_PLAYER, moves(
				walk_fast_up * 4
				jump_up
			))
			waitmovement(0)
		}
	}
	releaseall

}
script IndigoPlateau_RockClimbDown {
	lockall
	msgbox("Jagged rocks line the wall.\n", MSGBOX_DEFAULT)
	if(checkfieldmove(MOVE_ROCK_CLIMB) != PARTY_SIZE) {
		msgbox("Would you like to use\nROCK CLIMB?", MSGBOX_YESNO)
		closemessage
		if(var(VAR_RESULT)) {
			applymovement(LOCALID_PLAYER, moves(
				walk_fast_down * 4
				jump_down
			))
			waitmovement(0)
		}
	}
	releaseall

}


script IndigoPlateau_Theater {
	msgbox(
	"Coming soon!\n"
	"", MSGBOX_SIGN)

}

script IndigoPlateau_TheaterSign {
	msgbox(
	"VICTORY ROAD{PAUSE 60}\n"
	"Performed by the EMBER SPA PLAYERS!", MSGBOX_SIGN)

}


script IndigoPlateau_Lucca {
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_GREEN)
	if(flag(FLAG_TEMP_1)) {
		msgbox(
		"LUCCA: No… No, I got this.\n"
		"I don't need any help.\p"

		"Just gotta…\n"
		"", MSGBOX_DEFAULT)
	} else {
		msgbox(
		"LUCCA: So, I get that this place\n"
		"is for the pinnacle of TRAINERS.\p"

		"But…{PAUSE 30} don'tcha think they could've\n"
		"installed a few ramps?", MSGBOX_DEFAULT)
		setflag(FLAG_TEMP_1)
	}
	closemessage
	specialvar(VAR_RESULT, GetPlayerFacingDirection)
	if(var(VAR_RESULT) == DIR_SOUTH) {
		applymovement(LOCALID_PLAYER, moves(
			walk_left
			face_right
		))
	}
	applymovement(VAR_LAST_TALKED, moves(
		face_up
		delay_16 * 2
		walk_up
		walk_slow_up
		face_up
		walk_in_place_up * 2
		walk_slow_up
		face_up
		walk_in_place_up * 2
		walk_slower_up
		walk_in_place_up * 2
		walk_in_place_slow_up * 3
		lock_facing_direction
	))
	waitmovement(VAR_LAST_TALKED)
	playse(SE_FALL)
	applymovement(VAR_LAST_TALKED, moves(
		walk_faster_down * 5

	))
	specialvar(VAR_RESULT, GetPlayerFacingDirection)
	if(var(VAR_RESULT) == DIR_NORTH) {
		applymovement(LOCALID_PLAYER, moves(
			delay_16
			face_right
			lock_facing_direction
			walk_left
			face_right
		))
	}

	waitmovement(VAR_LAST_TALKED)
	playse(SE_LEDGE)
	applymovement(VAR_LAST_TALKED, moves(
		jump_up
		unlock_facing_direction

	))
	waitmovement(VAR_LAST_TALKED)
	setobjectmovementtype(VAR_LAST_TALKED, MOVEMENT_TYPE_FACE_UP)
	release
	end
}




script Route23_EventScript_ThunderBadgeGuardTrigger {
	lockall
	textcolor(NPC_TEXT_COLOR_BLUE)
	setvar (VAR_TEMP_1, 3)
	msgbox(
	"You can pass here only if you have\n"
	"the PHOTOSENSITIVE BADGE.", MSGBOX_DEFAULT)
	if(flag(FLAG_BADGE03_GET)) {
		msgbox(
		"Oh!\n"
		"That is the PHOTOSENSITIVE BADGE!{PAUSE_MUSIC}{PLAY_BGM}{MUS_LEVEL_UP}{PAUSE 0x60}{RESUME_MUSIC}\p"

		"Okay, then.\n"
		"Please, go right ahead.", MSGBOX_DEFAULT)
		setvar(VAR_MAP_SCENE_ROUTE23, 3)
	} else {
		msgbox(
		"You don't have the\n"
		"PHOTOSENSITIVE BADGE yet.\p"

		"You have to have it to get to\n"
		"the POKéMON LEAGUE.", MSGBOX_DEFAULT)
		waitmessage
		playse(SE_BOO)
		waitbuttonpress
		closemessage
		waitse
		applymovement(LOCALID_PLAYER, moves(
			walk_down
		))
		waitmovement(0)
	}
	release
	end
}

