raw `
CeladonCity_Gym_MapScripts::
	.byte 0

CeladonCity_Gym_EventScript_DefeatedErika::
	clearflag FLAG_HIDE_FAME_CHECKER_ERIKA_JOURNALS
	setflag FLAG_DEFEATED_ERIKA
	setflag FLAG_BADGE04_GET
	set_gym_trainers 4
	goto CeladonCity_Gym_EventScript_GiveTM19
	end

CeladonCity_Gym_EventScript_GiveTM19::
	famechecker FAMECHECKER_CELADON, 5
	msgbox CeladonCity_Gym_Text_ExplainRainbowBadgeTakeThis
	checkitemspace ITEM_TM30
	goto_if_eq VAR_RESULT, FALSE, CeladonCity_Gym_EventScript_NoRoomForTM19
	giveitem_msg CeladonCity_Gym_Text_ReceivedTM19FromErika, ITEM_TM30
	setflag FLAG_GOT_TM19_FROM_ERIKA
	msgbox CeladonCity_Gym_Text_ExplainTM19
	release
	end

CeladonCity_Gym_EventScript_NoRoomForTM19::
	msgbox CeladonCity_Gym_Text_ShouldMakeRoomForThis
	release
	end

CeladonCity_Gym_EventScript_Kay::
	trainerbattle_single TRAINER_LASS_KAY, CeladonCity_Gym_Text_KayIntro, CeladonCity_Gym_Text_KayDefeat
	msgbox CeladonCity_Gym_Text_KayPostBattle, MSGBOX_AUTOCLOSE
	end

CeladonCity_Gym_EventScript_Lisa::
	trainerbattle_single TRAINER_LASS_LISA, CeladonCity_Gym_Text_LisaIntro, CeladonCity_Gym_Text_LisaDefeat
	msgbox CeladonCity_Gym_Text_LisaPostBattle, MSGBOX_AUTOCLOSE
	end

CeladonCity_Gym_EventScript_Tina::
	trainerbattle_single TRAINER_PICNICKER_TINA, CeladonCity_Gym_Text_TinaIntro, CeladonCity_Gym_Text_TinaDefeat
	msgbox CeladonCity_Gym_Text_TinaPostBattle, MSGBOX_AUTOCLOSE
	end

CeladonCity_Gym_EventScript_Bridget::
	trainerbattle_single TRAINER_BEAUTY_BRIDGET, CeladonCity_Gym_Text_BridgetIntro, CeladonCity_Gym_Text_BridgetDefeat
	msgbox CeladonCity_Gym_Text_BridgetPostBattle, MSGBOX_AUTOCLOSE
	end

CeladonCity_Gym_EventScript_Tamia::
	trainerbattle_single TRAINER_BEAUTY_TAMIA, CeladonCity_Gym_Text_TamiaIntro, CeladonCity_Gym_Text_TamiaDefeat
	msgbox CeladonCity_Gym_Text_TamiaPostBattle, MSGBOX_AUTOCLOSE
	end

CeladonCity_Gym_EventScript_Lori::
	trainerbattle_single TRAINER_BEAUTY_LORI, CeladonCity_Gym_Text_LoriIntro, CeladonCity_Gym_Text_LoriDefeat
	msgbox CeladonCity_Gym_Text_LoriPostBattle, MSGBOX_AUTOCLOSE
	end

CeladonCity_Gym_EventScript_Mary::
	trainerbattle_single TRAINER_COOLTRAINER_MARY, CeladonCity_Gym_Text_MaryIntro, CeladonCity_Gym_Text_MaryDefeat
	msgbox CeladonCity_Gym_Text_MaryPostBattle, MSGBOX_AUTOCLOSE
	end

CeladonCity_Gym_EventScript_GymStatue::
	lockall
	goto_if_set FLAG_BADGE04_GET, CeladonCity_Gym_EventScript_GymStatuePostVictory
	msgbox CeladonCity_Gym_Text_GymStatue
	releaseall
	end

CeladonCity_Gym_EventScript_GymStatuePostVictory::
	msgbox CeladonCity_Gym_Text_GymStatuePlayerWon
	releaseall
	end
`
script CeladonCity_Gym_EventScript_DMCAGrunt {
	msgbox("I don't understand this.\pIf you're a man, and your\npartner is also a man, wouldn't\lhe be violating your copyright?", MSGBOX_NPC)
    end
}


const GIOVANNI = 10
const ERIKA = 7
const TopRightTrainer = 8
const TopLeftTrainer = 4
const BottomRightTrainer = 1 // Fuck.
const BottomLeftTrainer = 2 // I don't know my left from my right and I got these two mixed up.



script CeladonCity_Gym_EventScript_Erika {
	lockall
	faceplayer
	
	famechecker(FAMECHECKER_CELADON, FCPICKSTATE_COLORED, UpdatePickStateFromSpecialVar8005)
	if(!flag(FLAG_DEFEATED_ERIKA)) {
		msgbox(CeladonCity_Gym_Text_ErikaIntro, MSGBOX_DEFAULT)
		if(flag(FLAG_CSR_ERIKA_CUTSCENE_SKIP)) {
			closemessage
			textcolor(NPC_TEXT_COLOR_NEUTRAL)
			msgbox("Hey! You've already seen this\ncutscene.\lWould you like to skip it?", MSGBOX_YESNO)
			if(var(VAR_RESULT)) {

				//Cutscene Skip
				setweather(WEATHER_NONE)
				doweather
				fadescreen(FADE_TO_BLACK)
				fadeoutbgm(1)
				applymovement(OBJ_EVENT_ID_PLAYER, PlayerGetsInPosition)
				addobject(TopLeftTrainer)
				addobject(TopRightTrainer)
				applymovement(TopLeftTrainer, Common_Movement_FaceDown)
				applymovement(TopRightTrainer, Common_Movement_FaceDown)
				addobject(BottomRightTrainer)
				addobject(BottomLeftTrainer)
				applymovement(BottomLeftTrainer, Common_Movement_FaceDown)
				applymovement(BottomRightTrainer, Common_Movement_FaceDown)
				setobjectxy(BottomRightTrainer, 3, 10)
				setobjectxy(BottomLeftTrainer, 9, 10)
				setobjectxy(TopRightTrainer, 4, 7)
				setobjectxy(TopLeftTrainer, 8, 7)
				addobject(ERIKA)
				setobjectxy(ERIKA, 5, 11)
				addobject(GIOVANNI)
				setobjectxy(GIOVANNI, 6, 13)
				applymovement(GIOVANNI, GiovanniVisible)
				applymovement(ERIKA, Common_Movement_FaceRight)
				
				textcolor(NPC_TEXT_COLOR_MALE)
				
				waitmovement(OBJ_EVENT_ID_PLAYER)
				waitmovement(0)
				delay(10)
				special(SpawnCameraObject)
				fadescreen(FADE_FROM_BLACK)
				goto(CeladonGym_GiovanniBattles)
			} 
		}
			applymovement(BottomLeftTrainer, Common_Movement_FaceLeft)
			applymovement(BottomRightTrainer, Common_Movement_FaceRight)
			setobjectxy(BottomLeftTrainer, 9, 10)
			setobjectxy(BottomRightTrainer, 3, 10)
			closemessage
			lockall
			fadeoutbgm(2)

			//Lights Flicker
			playse(SE_SWITCH)
			setweather(WEATHER_NONE)
			doweather
			delay(10)
			setweather(WEATHER_SHADE)
			doweather
			delay(10)
			playse(SE_M_THUNDERBOLT2)
			setweather(WEATHER_NONE)
			doweather
			delay(15)
			playse(SE_M_THUNDERBOLT2)
			setweather(WEATHER_SHADE)
			doweather
			delay(20)
			setweather(WEATHER_NONE)
			doweather
			delay(20)
			setweather(WEATHER_SHADE)
			doweather
			delay(20)
			setweather(WEATHER_NONE)
			doweather
			delay(20)

			//Everyone looks down
			playse(SE_PIN)
			applymovement(ERIKA, Common_Movement_ExclamationMark)
			delay(15)
			playse(SE_PIN)
			applymovement(OBJ_EVENT_ID_PLAYER, Player_Looks_Down)
			delay(20)
			special(SpawnCameraObject)
			applymovement(OBJ_EVENT_ID_CAMERA, CameraGoesDown)
			waitmovement(0)
			delay(20)
			setobjectxy(GIOVANNI, 6, 18)
			playse(SE_EXIT)
			applymovement(GIOVANNI, GiovanniEnters)
			waitmovement(0)
			textcolor(0)
			msgbox(("...Ha!\nFinally!\pSo THIS is where that copyrighted\nmusic was coming from!"), MSGBOX_DEFAULT)
			closemessage
			delay(20)

			//Player and Erika walk down
			addobject(ERIKA)
			setobjectxy(ERIKA, 2, 9)	
			setobjectxy(OBJ_EVENT_ID_PLAYER, 10,9)
			applymovement(ERIKA, ErikaDown)
			applymovement(OBJ_EVENT_ID_PLAYER, PlayerDown)
			waitmovement(0)
			applymovement(OBJ_EVENT_ID_CAMERA, CameraUp)
			waitmovement(0)
			applymovement(TopRightTrainer, Common_Movement_FaceDown)
			applymovement(TopLeftTrainer, Common_Movement_FaceDown)
			setobjectxy(TopRightTrainer, 4, 6)
			setobjectxy(TopLeftTrainer, 8, 6)
			delay(20)

			//Giovanni approaches
			applymovement(GIOVANNI, GiovanniApproaches)
			waitmovement(0)
			msgbox(("I am GIOVANNI.\nLeader of the DMCA!\pI am the scourge of copyright\ninfringers across all of KANTO!"), MSGBOX_DEFAULT)
			closemessage
			playse(SE_PIN)
			applymovement(ERIKA, ErikaShocked)
			waitmovement(0)
			textcolor(1)
			msgbox(("Wait!\nThe DMCA?\pThat means-!\n"), MSGBOX_DEFAULT)
			closemessage
			delay(15)
			playse(SE_PIN)
			applymovement(BottomLeftTrainer, Player_Looks_Down)
			waitmovement(0)
			delay(15)
			playse(SE_PIN)
			applymovement(BottomRightTrainer, Player_Looks_Down)
			waitmovement(0)
			delay(48)
			applymovement(BottomRightTrainer, Talking)
			waitmovement(0)
			textcolor(NPC_TEXT_COLOR_FEMALE)
			msgbox(("Oh, no!\nMS. ERIKA!\pAre they gonna send their\nlawyers after our GYM?"), MSGBOX_DEFAULT)
			closemessage
			delay(32)
			applymovement(BottomLeftTrainer, Talking)
			waitmovement(0)
			textcolor(NPC_TEXT_COLOR_MALE)
			msgbox(("If they file a lawsuit against us,\nhow are we gonna afford it?\lWe need the cash for our shelter..."), MSGBOX_DEFAULT)
			closemessage
			applymovement(ERIKA, Common_Movement_FaceUp)
			delay(10)
			textcolor(NPC_TEXT_COLOR_FEMALE)
			msgbox(("Don't worry, everyone!\pWe'll figure out how to keep\neverybody safe. I'm sure of it.\lSomehow..."), MSGBOX_DEFAULT)
			closemessage

			//Player walks up
			delay(30)
			applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
			delay(48)
			applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceDown)
			delay(64)
			applymovement(OBJ_EVENT_ID_PLAYER, PlayerStepsUp)
			delay(16)
			applymovement(ERIKA, Common_Movement_FaceRight)
			waitmovement(ERIKA)
			playse(SE_PIN)
			applymovement(ERIKA, Common_Movement_ExclamationMark)
			waitmovement(OBJ_EVENT_ID_PLAYER)
			delay(32)
			applymovement(ERIKA, ErikaLooksAtYou)
			waitmovement(0)
			msgbox(("Oh! You...\n"), MSGBOX_DEFAULT)
			closemessage
			applymovement(OBJ_EVENT_ID_CAMERA, CameraCenters)
			waitmovement(0)
			delay(20)

			//Giovanni gets ready
			textcolor(0)
			applymovement(GIOVANNI, GiovanniTalksBack)
			waitmovement(0)
			msgbox(("Oh?\nYou want to stand up for them?\lAgainst ME?"), MSGBOX_DEFAULT)
			closemessage
			delay(16)
			applymovement(GIOVANNI, CameraCenters)
			waitmovement(0)
			applymovement(GIOVANNI, Common_Movement_FaceUp)
			delay(20)
			setflag(FLAG_CSR_ERIKA_CUTSCENE_SKIP)
			goto(CeladonGym_GiovanniBattles)


		
	}
	else {
		//todo after battle
		msgbox("{PLAYER}...\nThank you so much, again.\pYou truly showed what it means\nto be an ally to our community.", MSGBOX_DEFAULT)
	}
	
	releaseall
	end
}

movement GiovanniVisible {
	face_up
	set_visible
}

movement PlayerGetsInPosition {
	walk_faster_down * 7
}

script CeladonGym_GiovanniBattles {
	msgbox(("Ha!\nFine, then."), MSGBOX_DEFAULT)
	setvar(VAR_TEMP_START_EVENT_BATTLE, 8)
	trainerbattle_single(TRAINER_BOSS_GIOVANNI, CeladonCity_Gym_Text_GiovanniIntro, CeladonCity_Gym_Text_GiovanniDefeat, CeladonGym_GiovanniDefeat)
	releaseall
	end
}

script CeladonGym_GiovanniDefeat {
	delay(30)
	applymovement(GIOVANNI, GiovanniHit)
	waitmovement(0)
	delay(40)

	playse(SE_PIN)
	applymovement(ERIKA, Player_Looks_Down)
	waitmovement(0)
	delay(20)
	playse(SE_PIN)
	applymovement(BottomRightTrainer, Player_Looks_Down)
	waitmovement(0)
	applymovement(BottomLeftTrainer, Player_Looks_Down)
	waitmovement(0)
	delay(20)
	applymovement(GIOVANNI, GiovanniShocked)
	waitmovement(0)

	textcolor(NPC_TEXT_COLOR_MALE)
	msgbox("Wha-!?\pBut my POKéMON was invincible!\nHow did you-?", MSGBOX_DEFAULT)
	closemessage
	delay(20)
	applymovement(ERIKA, ErikaApproaches)
	waitmovement(0)
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox("Invincible?\nNo, GIOVANNI, leader of the DMCA.\pThere was one thing that you'd\nfailed to account for.\lSo listen up!\pWe aren't just a POKéMON GYM!\n", MSGBOX_DEFAULT)
	closemessage
	delay(30)

	applymovement(BottomRightTrainer, ErikaApproaches)
	waitmovement(0)
	msgbox("We are a community!\nOne full of passion and love!", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	applymovement(BottomLeftTrainer, TrainerApproaches)
	waitmovement(0)
	delay(40)
	textcolor(NPC_TEXT_COLOR_MALE)
	msgbox("And we will always have each\nothers' backs!\lNo matter what!", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	applymovement(GIOVANNI, GiovanniCornered)
	waitmovement(0)
	textcolor(NPC_TEXT_COLOR_MALE)
	msgbox("Grr...\nD-darn you!", MSGBOX_DEFAULT)
	closemessage
	delay(60)
	applymovement(GIOVANNI, GiovanniAbsconds)
	waitmovement(0)
	removeobject(GIOVANNI)
	playse(SE_EXIT)
	special(RemoveCameraObject)
	delay(30)
	set_gym_trainers(4)
	delay(30)
	applymovement(ERIKA, Common_Movement_FaceRight)
	waitmovement(0)
	applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
	waitmovement(0)
	delay(30)
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox("Thank you.\nWhat was your name, again?\p{PLAYER}?\n...\l...{PLAYER}, okay!\pWell, {PLAYER}, thank you.\pYou've stood with us in solidarity,\nand you're helping us thrive.\pYou truly understand what it means\nto be an ALLY of our community.\pAs thanks for this, I'd be honored\nto present you with this:\lThe RAINBOWBADGE!", MSGBOX_DEFAULT)
	closemessage
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	playfanfare(MUS_OBTAIN_BADGE)
	message("{PLAYER} recieved the RAINBOWBADGE\nfrom ERIKA!")
	waitmessage
	waitfanfare
	setflag(FLAG_DEFEATED_ERIKA)
	setflag(FLAG_BADGE04_GET)
	//todo Give badge
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(CeladonCity_Gym_Text_ExplainRainbowBadgeTakeThis)
	if(!checkitemspace(ITEM_TM30)) {

	} else {
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		msgreceiveditem("{PLAYER} received TM30\nfrom ERIKA.", ITEM_TM30, 1)
		setflag(FLAG_GOT_TM19_FROM_ERIKA)
		famechecker(FAMECHECKER_CELADON, 5)
		
		textcolor(NPC_TEXT_COLOR_FEMALE)
		msgbox("TM30 contains MAGICAL LEAF.\pIt's a move that I absolutely\nlove to use!\pThere aren't many POKéMON that\ncan use it, but keep it in mind!\pI'm sure you'll find it very\nuseful in the near future!", MSGBOX_DEFAULT)
	}
	closemessage
	applymovement(ERIKA, Common_Movement_FaceUp)
	msgbox("All right, everyone!\nLet's get back to it!", MSGBOX_DEFAULT)
	closemessage
	delay(15)
	applymovement(BottomLeftTrainer, DancersAgree)
	applymovement(BottomRightTrainer, DancersAgree)
	waitmovement(0)
	delay(4)
	msgbox("Hooray!\n", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	applymovement(ERIKA, ErikaReturns)
	waitmovement(0)
	setobjectxy(ERIKA, 6, 4)
	applymovement(BottomRightTrainer, Common_Movement_WalkRight)
	waitmovement(0)

	setobjectmovementtype(TopRightTrainer, MOVEMENT_TYPE_ROTATE_COUNTERCLOCKWISE)
	setobjectmovementtype(TopLeftTrainer, MOVEMENT_TYPE_ROTATE_CLOCKWISE)

	releaseall
	end
}

script CeladonGym_Receptionist {
	if(flag(FLAG_BADGE04_GET)) {
		msgbox("Hey!\nYou did it!\pYou really saved us from\nGIOVANNI!\lNice going!", MSGBOX_NPC)
	} else { 
		msgbox("Hey there, Champ in the making!\nI'm glad you found our club!\pWelcome to the LGBT Community\nCenter, otherwise known as\lCELADON GYM!\pOur president and chairwoman is\nERIKA.\pShe's been keeping our community\naffirming and inclusive while\lalso being an expert at POKéMON!\pShe's not one to be taken\nlightly!", MSGBOX_NPC)
	}
}


// ported these movement scripts directly from binary; not gonna go back through and consolidate them :(
movement ErikaReturns {
	walk_up
	walk_right
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	face_down
}

movement DancersAgree {
	walk_in_place_down
	walk_in_place_down
}

movement GiovanniAbsconds {
	lock_facing_direction
	walk_slower_down
	delay_16 * 3
	unlock_facing_direction
	walk_fast_down
	walk_fast_down
	walk_fast_down
	walk_fast_down
	set_invisible
}

movement GiovanniCornered {
	face_left
	delay_16
	delay_16
	face_right
	delay_16
	delay_16
	face_up
	delay_16
	delay_16
}

movement TrainerApproaches {
	walk_slow_left
	walk_slow_down
	face_down
}

movement GiovanniHit {
	lock_facing_direction
	slide_down
	face_up
	unlock_facing_direction
}

movement ErikaApproaches {
	walk_slow_down
	face_down
}

movement GiovanniShocked {
	face_left
	delay_16
	delay_16
	face_right
	delay_16
	delay_16
	face_up
	delay_16
	delay_16
}

movement Player_Looks_Down {
	face_down
	emote_exclamation_mark
}
movement CameraGoesDown {
	walk_fast_down
	walk_faster_down * 5
	walk_fast_down * 2
	walk_fast_down
	walk_slow_down
}
movement GiovanniEnters {
	face_up
	set_visible
	delay_16
	delay_16
	delay_16
	delay_2
	walk_slow_up * 3
	face_up
}

movement ErikaDown {
	walk_down
	walk_down
	walk_right
	walk_right
	walk_right
	face_down
}

movement PlayerDown {
	walk_down
	walk_down
	walk_left
	walk_left
	walk_left
	face_down
}

movement CameraUp {
	walk_slow_up
	walk_slow_up
}

movement GiovanniApproaches {
	walk_slow_up
	face_up
}

movement ErikaShocked {
	emote_exclamation_mark
	delay_16
	delay_4
	walk_in_place_down
	walk_in_place_down
	face_down
	delay_16
	delay_4
}

movement Talking {
	walk_in_place_down
	walk_in_place_down
	face_down
}

movement PlayerStepsUp {
	walk_slower_left //slowest?
	walk_slower_down
	face_down
}

movement ErikaLooksAtYou {
	walk_in_place_right
	walk_in_place_right
	face_right
}

movement CameraCenters {
	walk_slower_up //slowest?
}

movement GiovanniTalksBack {
	walk_in_place_up
	walk_in_place_up
	face_up
}