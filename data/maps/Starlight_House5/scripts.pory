}

script Starlight_House5_Sign {
	msgbox(
	"You can reset the room by leaving\n"
	"and re-entering.", MSGBOX_SIGN)

}

script Starlight_House5_Secret {
	lock
	if(flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
		msgbox(
	"Come back after you've talked to\n"
	"Starlight.", MSGBOX_SIGN)
	} else {
    textcolor(NPC_TEXT_COLOR_NEUTRAL)
    msgbox("Enter?", MSGBOX_YESNO)
		closemessage
		if(var(VAR_RESULT)) {
			//fadescreen(FADE_TO_WHITE)
            warp(MAP_STARLIGHT_HOUSE3, 1, 9, 22) // Map, Warp ID, X, Y
            waitstate
            //delay(120)
            //fadescreen(FADE_FROM_WHITE)
		}
	}
    release
    end
}

script Starlight_House5_Pit_Sign {
	msgbox(
	"TRAINER TIPS!\p"
	"Press START to save the game!", MSGBOX_SIGN)
	delay(90)
	msgbox(
	"…Dumbass.", MSGBOX_SIGN)

}
