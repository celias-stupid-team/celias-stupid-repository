mapscripts Starlight_House5_MapScripts {
MAP_SCRIPT_ON_TRANSITION {
		if(flag(FLAG_HIDE_BONUS_STARLIGHTS) || !flag(FLAG_DAK_HERE)) {
    setflag(FLAG_TEMP_4)
	setflag(FLAG_TEMP_3)
}
		if(flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
			setflag(FLAG_TEMP_8)
        }
            if(flag(FLAG_CSR_CELIA_BONUS)) {
			setflag(FLAG_TEMP_8)
		}
		if(flag(FLAG_DAK_HERE)) {
			setflag(FLAG_TEMP_8)
		}
		
	
setflag(FLAG_TEMP_5)
	}
}

script Starlight_House5_Dak_Pit { //test
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_MALE)
    if(flag(FLAG_TEMP_3)) {
			msgbox(
				"DAK: Why would you take my light\n"
				"source?\p"

				"How will I find my stuff in the\n"
				"dark now?", MSGBOX_NPC)
		closemessage
				} else {
	msgbox(
	"DAK: This is a nice fun map!", MSGBOX_NPC)
	closemessage
				}
	applymovement(VAR_LAST_TALKED, moves(
		face_original_direction
	))
	waitmovement(0)
	release
}

script Starlight_House5_Charizard_Doll {
	finditem(ITEM_POKE_DOLL)
	removeobject(Charizard)
	setflag(FLAG_TEMP_3)
}

script Starlight_House5_Todo_List {
	msgbox(
	"Starlight's Todo List:\n"
    "-Fix the collision on this map.", MSGBOX_SIGN)

}

script Starlight_House5_Blue_Tiles {
	lock
	if(flag(FLAG_TEMP_A)) {
			 msgbox("Room is already set to\n"
	"the BLUE palette theme.", MSGBOX_SIGN)
		closemessage
				}
	if(!flag(FLAG_TEMP_A)) {
    //textcolor(NPC_TEXT_COLOR_NEUTRAL)
    msgbox("Would you like to set the room\n"
	"to a BLUE palette theme?", MSGBOX_YESNO)
		closemessage
		if(var(VAR_RESULT)) {
			//wall
			setmetatile(27, 1, 0x345, TRUE)
			setmetatile(28, 1, 0x346, TRUE)
			setmetatile(27, 2, 0x34D, TRUE)
			setmetatile(28, 2, 0x34E, TRUE)

			//row1
