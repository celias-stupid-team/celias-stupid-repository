			setmetatile(24, 6, 0x2C3, FALSE)//Daisy
			setmetatile(25, 6, 0x2C3, TRUE)//top left cliff
			setmetatile(26, 6, 0x2C3, TRUE)
			setmetatile(27, 6, 0x2C3, TRUE)//top right cliff
			setmetatile(28, 6, 0x2C3, FALSE)//grass3
			
			//row5
			setmetatile(19, 7, 0x2C3, TRUE)
