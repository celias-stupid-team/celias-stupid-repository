raw `


FushciaCity_House2_EventScript_FishingGurusBrother::
	lock
	faceplayer
	goto_if_set FLAG_GOT_GOOD_ROD, FushciaCity_House2_EventScript_AlreadyGotGoodRod
	msgbox FushciaCity_House2_Text_DoYouLikeToFish, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, FushciaCity_House2_EventScript_GiveGoodRod
	msgbox FushciaCity_House2_Text_OhThatsDisappointing
	release
	end

FushciaCity_House2_EventScript_AlreadyGotGoodRod::
	msgbox FushciaCity_House2_Text_HowAreTheFishBiting
	release
	end

FushciaCity_House2_EventScript_GiveGoodRod::
	msgbox FushciaCity_House2_Text_LikeYourStyleTakeThis
	checkitemspace ITEM_GOOD_ROD
	goto_if_eq VAR_RESULT, FALSE, FushciaCity_House2_EventScript_NoRoomForGoodRod
	giveitem_msg FushciaCity_House2_Text_ReceivedGoodRod, ITEM_GOOD_ROD
	msgbox FushciaCity_House2_Text_GoodRodCanCatchBetterMons
	setflag FLAG_GOT_GOOD_ROD
	release
	end

FushciaCity_House2_EventScript_NoRoomForGoodRod::
	msgbox FushciaCity_House2_Text_YouHaveNoRoomForGift
	release
	end
`

mapscripts FushciaCity_House2_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		if(!flag(FLAG_HIDE_DMCA_IN_SAFARI_ZONE)) {
			setflag(FLAG_TEMP_1)
		}
	}
}
script FushciaCity_FishingGuruDMCA {
	msgbox("This FISHING GURU was a rip-off\nof all the other ones!", MSGBOX_NPC)
	end
}

script FushciaCity_FishingGuru {
	lock
	faceplayer
	if(checkitem(ITEM_CHARCOAL)) {
		msgbox("FISHING GURU'S BROTHER: That OLD\nROD is a family heirloom.\pIt's been passed down since my\nbrother's father's sister's\lhusband's son's brother's cousin.\pTake good care of it, y'hear?\n", MSGBOX_DEFAULT)
	} else {
		msgbox("FISHING GURU'S BROTHER: Hey there,\n{PLAYER}!\lHow're you doing?\pThank you again for all your help.\nYou've earned a reward.\pHere, take this. It was my brother's\nfather's prized posession.\lI pass it onto you with pride!", MSGBOX_DEFAULT)
		closemessage
		giveitem_msg("{PLAYER} obtained the OLD ROD!", ITEM_CHARCOAL, 1)
		waitfanfare
		msgbox("FISHING GURU'S BROTHER: That OLD\nROD is a family heirloom.\pIt's been passed down since my\nbrother's father's sister's\lhusband's son's brother's cousin.\pTake good care of it, y'hear?\n", MSGBOX_DEFAULT)
	}
	release
	end
}