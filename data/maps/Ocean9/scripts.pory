mapscripts Ocean9_MapScripts {

}



script GreatSea_MudkipA {
    if(flag(FLAG_TEMP_1)) {
        compare_var_to_var(VAR_TEMP_1, VAR_LAST_TALKED)
        if(var(VAR_RESULT)) {
            goto(GreatSea_Mudkip_1)
        }
        compare_var_to_var(VAR_TEMP_2, VAR_LAST_TALKED)
        if(var(VAR_RESULT)) {
            goto(GreatSea_Mudkip_2)
        }
        compare_var_to_var(VAR_TEMP_3, VAR_LAST_TALKED)
        if(var(VAR_RESULT)) {
            goto(GreatSea_Mudkip_3)
        }

    } else {
        setflag(FLAG_TEMP_1)
        addvar(VAR_TEMP_0, 1)
        switch(var(VAR_TEMP_0)) {
            case 1:
                copyvar(VAR_TEMP_1, VAR_LAST_TALKED)
                goto(GreatSea_Mudkip_1)
            case 2:
                copyvar(VAR_TEMP_2, VAR_LAST_TALKED)
                goto(GreatSea_Mudkip_2)
            case 3:
                copyvar(VAR_TEMP_3, VAR_LAST_TALKED)
                goto(GreatSea_Mudkip_3)
        }
    }


}

