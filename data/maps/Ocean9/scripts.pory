script GreatSea_Mudkip_1 {
    lock
    faceplayer
    textcolor(NPC_TEXT_COLOR_BLUE)
    playmoncry(SPECIES_MUDKIP, CRY_MODE_DEFAULT)
    msgbox(
	"Mud!\n"
	"", MSGBOX_DEFAULT)
    waitmoncry
    release
}
script GreatSea_Mudkip_2 {
    lock
    faceplayer
    textcolor(NPC_TEXT_COLOR_RED)
    playmoncry(SPECIES_MUDKIP, CRY_MODE_ENCOUNTER)
    msgbox(
	"Kip!\n"
	"", MSGBOX_DEFAULT)
    waitmoncry
    release
}
script GreatSea_Mudkip_3 {
    lock
    faceplayer
    textcolor(NPC_TEXT_COLOR_GREEN)
    playmoncry(SPECIES_MUDKIP, CRY_MODE_FAINT)
    msgbox(
	"Thomas Jefferson.\n"
	"", MSGBOX_DEFAULT)
    waitmoncry
    clearflag(FLAG_TEMP_1)
    clearflag(FLAG_TEMP_2)
    clearflag(FLAG_TEMP_3)
    setvar(VAR_TEMP_1, 0)
    setvar(VAR_TEMP_2, 0)
    setvar(VAR_TEMP_3, 0)
    setvar(VAR_TEMP_0, 0)
    release
}