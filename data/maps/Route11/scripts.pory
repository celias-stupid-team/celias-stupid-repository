script Route11_Celia_Loss {
	msgbox("The Loss route will never not be\nfunny.", MSGBOX_NPC)
	call(CeladonCity_GameCorner_EventScript_FaceSlotMachine)
}

script Route11_Celia_LossEnd {
	msgbox("I don't wanna make a “Celia\nLaying Down” sprite.", MSGBOX_NPC)
	call(CeladonCity_GameCorner_EventScript_FaceSlotMachine)
}

script Route11_Route1 {
