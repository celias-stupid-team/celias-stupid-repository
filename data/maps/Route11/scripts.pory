raw `


Route11_EventScript_DiglettsCaveSign::
	msgbox Route11_Text_DiglettsCave, MSGBOX_SIGN
	end
`
mapscripts Route11_MapScripts {
	MAP_SCRIPT_ON_TRANSITION: Route11_OnTransition
}
script Route11_OnTransition {
	setbench(BENCH_VERMILION)
	setflag(FLAG_CSR_MAP_ROUTE_11)
	call(SetPlayerPokedexValues)
}
script Route11_Man1 {
	trainerbattle_single(TRAINER_LOSS_MAN_1, Route11_Text_Man, Route11_Text_JasperDefeat)
	msgbox(Route11_Text_Man, MSGBOX_AUTOCLOSE)
}

script Route11_Man2 {
	trainerbattle_single(TRAINER_LOSS_MAN_2, Route11_Text_Man, Route11_Text_EddieDefeat)
