raw `
Route16_MapScripts::
	map_script MAP_SCRIPT_ON_RESUME, Route16_OnResume
	map_script MAP_SCRIPT_ON_TRANSITION, Route16_OnTransition
	map_script MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE, Route16_OnWarp
	.byte 0

Route16_OnResume::
	call_if_set FLAG_SYS_SPECIAL_WILD_BATTLE, Route16_EventScript_RemoveSnorlax
	end

Route16_EventScript_RemoveSnorlax::
	removeobject VAR_LAST_TALKED
	return

Route16_OnTransition::
	setbench BENCH_ROUTE16
	end

Route16_OnTransitionCyclingRoad::
	setflag FLAG_SYS_ON_CYCLING_ROAD
	return

Route16_OnWarp::
	map_script_2 VAR_MAP_SCENE_ROUTE16, 1, Route16_OnWarpCyclingRoad
	.2byte 0

Route16_OnWarpCyclingRoad::
	special ForcePlayerOntoBike
	end

Route16_EventScript_Snorlax::
	lock
	faceplayer
	goto Route16_EventScript_SnorlaxNoPokeFlute
	goto_if_questlog EventScript_ReleaseEnd
	special QuestLog_CutRecording
	msgbox Text_WantToUsePokeFlute, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, Route16_EventScript_DontUsePokeFlute
	call EventScript_AwakenSnorlax
	setwildbattle SPECIES_SNORLAX, 30
	waitse
	playmoncry SPECIES_SNORLAX, CRY_MODE_ENCOUNTER
	delay 40
	waitmoncry
	setflag FLAG_HIDE_ROUTE_16_SNORLAX
	setflag FLAG_SYS_SPECIAL_WILD_BATTLE
	dowildbattle
	clearflag FLAG_SYS_SPECIAL_WILD_BATTLE
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_eq VAR_RESULT, B_OUTCOME_WON, Route16_EventScript_FoughtSnorlax
	goto_if_eq VAR_RESULT, B_OUTCOME_RAN, Route16_EventScript_FoughtSnorlax
	goto_if_eq VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED, Route16_EventScript_FoughtSnorlax
	release
	end

Route16_EventScript_DontUsePokeFlute::
	release
	end

Route16_EventScript_FoughtSnorlax::
	msgbox Text_SnorlaxReturnedToMountains
	release
	end

Route16_EventScript_SnorlaxNoPokeFlute::
	msgbox Route16_Text_MonSprawledOutInSlumber
	release
	end

Route16_EventScript_CyclingRoadSign::
	msgbox Route16_Text_CyclingRoadSign, MSGBOX_SIGN
	end

Route16_EventScript_RouteSign::
	msgbox Route16_Text_RouteSign, MSGBOX_SIGN
	end
`
script Route16_StrandedBiker {
	msgbox("Aww man…\pRight when I got ready to go for\na ride, this tiny little lake\lspontaneously appeared here.\pTo make things worse, I can't\neven go back through the gate!\p…Huh? Why can't I just turn\naround and go back home?\pBecause I'm not allowed inside\nnormal buildings!\lI don't have a walking sprite!", MSGBOX_NPC)
	end
}

script Route16_OakLover {
	if(!flag(FLAG_TEMP_12)) {
		lock
		msgbox("Oh, OAK!\nYour branches are so... girthy.", MSGBOX_DEFAULT)
		release
	} else
	{
		msgbox("No...\pH-How could you?\nSob...", MSGBOX_NPC)
	}
}

script Route16_EventScript_Jed {
	trainerbattle_double(TRAINER_YOUNG_COUPLE_LEA_JED, Route16_Text_JedIntro, Route16_Text_JedDefeat, Route16_Text_JedNotEnoughMons)
	if(flag(FLAG_TEMP_12)) {
	msgbox("Woah, there!\nNot cool!\pI didn't ask for that!\n", MSGBOX_AUTOCLOSE)
	} else {
		msgbox(Route16_Text_JedPostBattle, MSGBOX_AUTOCLOSE)
	}
}

script Route16_Ligma {
	finditem(ITEM_BIG_PEARL)
}

script Route16_Dad {
	lock
	faceplayer
	textcolor(0)
	msgbox("DAD: {PLAYER}!\nWhat are you doing out here?\pHey, there sure are a lot of\npolicemen out here.\lBetter not break the law!\pWell, never mind that.\nHow about you take arrest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}

script Route16_RoadWorkGirl {
	lock
	msgbox("Damn, I sure hope so.", MSGBOX_DEFAULT)
	release
}

script Route16_RoadWorkSign {
	msgbox("ROAD WORK AHEAD\n", MSGBOX_SIGN)
	end
}

script Route16_Cop1 {
	trainerbattle_single(TRAINER_COP_1, "I'm feeling hungry and mean!\nI need a punching bag!", "Don't make me mad!\n")
	msgbox("I get my kicks by harassing people\nwith my stinking POKéMON.\pThey're great for startling people.\nAnd, they bite, too.", MSGBOX_NPC)
}

script Route16_Cop2 {
	trainerbattle_single(TRAINER_COP_2, "Nice BIKE!\nHand it over!", "Hey!")
	msgbox("It's Civil Asset Forfeiture, baby!\nNothing illegal about that!\pWhazzat?\nYou got a problem with it?\lHa!\pWhat're you gonna do about it?\nCall the cops?", MSGBOX_NPC)


}

script Route16_Cop3 {
	trainerbattle_single(TRAINER_COP_3, "There's a dangerous criminal hiding\nout in that house.\lNo one's allowed through!", "Don't make me mad!")
	msgbox("Grr…\pAt times like these, kids like you\nshould be locked in a room getting\lwhalloped by the CAPTAIN!", MSGBOX_NPC)
	end
}


script Route16_Cop4 {
	trainerbattle_single(TRAINER_COP_4, "FREEZE!\nHands where I can see them!\pI have literally zero qualms about\nthreatening children!", "Kaboom!")
	msgbox("My buddy here lost his GUN.\nSomeone from FUSHCIA picked it up.\pI don't care, though.\nIt's not my problem.\pWe have bigger things to worry about\nthan a rando with a deadly weapon.", MSGBOX_NPC)
	end
}


script Route16_Cop5 {
	trainerbattle_single(TRAINER_COP_5, "Some dumb couple was speeding down\nthe turnpike the other day.\pThe wife was pregnant, so I took\nher kid too!", "Knockout!")
	msgbox("Ha, maybe I should write a book\nabout the experience.\pHmm…\nOn second thought, nah.\lWho'd read a book like that anyway?", MSGBOX_NPC)
	end
}