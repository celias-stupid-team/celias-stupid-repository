raw `
ViridianForest_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, ViridianForest_OnTransition
	.byte 0

ViridianForest_OnTransition::
	setworldmapflag FLAG_WORLD_MAP_VIRIDIAN_FOREST
	setbench BENCH_VIRIDIAN_FOREST
	call SetPlayerPokedexValues
	end

ViridianForest_EventScript_Youngster::
	msgbox ViridianForest_Text_FriendsItchingToBattle, MSGBOX_NPC
	end

ViridianForest_EventScript_Boy::
	msgbox ViridianForest_Text_RanOutOfPokeBalls, MSGBOX_NPC
	end

ViridianForest_EventScript_TrainerTips1::
	msgbox ViridianForest_Text_AvoidGrassyAreasWhenWeak, MSGBOX_SIGN
	end

ViridianForest_EventScript_TrainerTips2::
	setflag FLAG_CSR_HINT_FOREST_CANDIES
	call SetPlayerPokedexValues
	msgbox ViridianForest_Text_UseAntidoteForPoison, MSGBOX_SIGN
	end

ViridianForest_EventScript_TrainerTips3::
	msgbox ViridianForest_Text_ContactOakViaPCToRatePokedex, MSGBOX_SIGN
	end

ViridianForest_EventScript_TrainerTips4::
	msgbox ViridianForest_Text_CantCatchOwnedMons, MSGBOX_SIGN
	end

ViridianForest_EventScript_TrainerTips5::
	msgbox ViridianForest_Text_WeakenMonsBeforeCapture, MSGBOX_SIGN
	end

ViridianForest_EventScript_ExitSign::
	msgbox ViridianForest_Text_LeavingViridianForest, MSGBOX_SIGN
	end

ViridianForest_EventScript_Rick::
	trainerbattle_single TRAINER_BUG_CATCHER_RICK, ViridianForest_Text_RickIntro, ViridianForest_Text_RickDefeat
	msgbox ViridianForest_Text_RickPostBattle, MSGBOX_AUTOCLOSE
	end

ViridianForest_EventScript_Doug::
	trainerbattle_single TRAINER_BUG_CATCHER_DOUG, ViridianForest_Text_DougIntro, ViridianForest_Text_DougDefeat
	msgbox ViridianForest_Text_DougPostBattle, MSGBOX_AUTOCLOSE
	end

ViridianForest_EventScript_Sammy::
	trainerbattle_single TRAINER_BUG_CATCHER_SAMMY, ViridianForest_Text_SammyIntro, ViridianForest_Text_SammyDefeat
	msgbox ViridianForest_Text_SammyPostBattle, MSGBOX_AUTOCLOSE
	end

ViridianForest_EventScript_Anthony::
	trainerbattle_single TRAINER_BUG_CATCHER_ANTHONY, ViridianForest_Text_AnthonyIntro, ViridianForest_Text_AnthonyDefeat
	msgbox ViridianForest_Text_AnthonyPostBattle, MSGBOX_AUTOCLOSE
	end

ViridianForest_EventScript_Charlie::
	trainerbattle_single TRAINER_BUG_CATCHER_CHARLIE, ViridianForest_Text_CharlieIntro, ViridianForest_Text_CharlieDefeat
	msgbox ViridianForest_Text_CharliePostBattle, MSGBOX_AUTOCLOSE
	end
`
script ViridianForest_MapScript_SetObtainable {
	setobtainable(SPECIES_CATERPIE, SPECIES_METAPOD, SPECIES_KAKUNA)
	
}

script EventScript_DadHeal {
	fadescreenswapbuffers(FADE_TO_BLACK)
	closemessage
	playfanfare(MUS_HEAL)
	waitfanfare
	special(HealPlayerParty)
	fadescreenswapbuffers(FADE_FROM_BLACK)
	msgbox(("DAD: There!\nBest of luck to you!"), MSGBOX_DEFAULT)
	return
}

script ViridianForest_EventScript_Dad2 {
	lock
	faceplayer
	textcolor(0)
	msgbox(("DAD: {PLAYER}!\nWhat are you doing out here?\p...Wait, didn't I see you\nearlier in this forest?\lGood job making it over!\pWell, never mind that.\nHow about you take a rest?"), MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	setflag(FLAG_DAD_VIRIDIAN_EXIT)
	release
}

script ViridianForest_EventScript_Dad {
	lock
	faceplayer
	textcolor(0)
	msgbox(("DAD: {PLAYER}!\nWhat are you doing out here?\pWell, never mind that.\nHow about you take a rest?"), MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	setflag(FLAG_DAD_VIRIDIAN_ENTRANCE)
	release
	end
}

script ViridianForest_EventScript_CeliaHack {
	msgbox("In RBY, this guy says “CATERPIE\ncan't cut it!”\pIn FRLG, this guy says “CATERPIE\ncan't hack it!”\pI simply continued the trend.\n", MSGBOX_NPC)
	end
}

script ViridianForest_EventScript_Celia10U {
	msgbox("For those who don't know, 10U is\na competitive Pokemon format.\p10U is the lowest tier of RBY, where\nonly 6 Pokemon are left to be legal.\pEvery single team is the same, and\nit's extremely unfun.\lCheck out Big Yellow's video on it!\lI simply continued the trend.", MSGBOX_NPC)
	end
}

script ViridianForest_EventScript_CeliaCandy {
	msgbox("I had so much trouble getting folks\nto believe me about candies.\pThe only reason I put them in is\nto save you time!!!\lNot everything I do is evil!!", MSGBOX_NPC)
	end
}

script ViridianForest_EventScript_CeliaDad2 {
	msgbox("I have a second DAD here for a very\nspecific purpose:\pIn the upcoming AJ fight, I need\nthe player to try WATER GUN on\lthe Sandshrew.\pHowever, many players will have a\nfainted Charmander by now.\pThus, DAD is here to make sure you\ncan get annoyed by Water Absorb.", MSGBOX_NPC)
	end
}

script ViridianForest_EventScript_Flowers1 {
	setvar(VAR_TEMP_1, 1)
	release
}

script ViridianForest_EventScript_Flowers2 {
	setvar(VAR_TEMP_1, 2)
	release
}

script ViridianForest_EventScript_Flowers3 {
	setvar(VAR_TEMP_1, 3)
	release
}

script ViridianForest_EventScript_FlowersClear {
	setvar(VAR_TEMP_1, 0)
	release
}

script ViridianForest_EventScript_Flowers4 {
	lock
	setvar(VAR_TEMP_1, 0)
	if(!flag(FLAG_WALKED_THROUGH_GRASS)) {
		setflag(FLAG_SHINY_CREATION) // Metapod
	}
	setwildbattle(SPECIES_METAPOD, 5, ITEM_REPEL)
	dowildbattle
	release
}

script ViridianForest_EventScript_CeliaAJ {
	msgbox("This guy's a reference to AJ from\nthe anime.\pHe chucked his SANDSHREW in the\nriver until it wasn't weak to WATER.\pKinda fucked up, ngl.\pHowever, many players will have a\nfainted Charmander by now.\pThus, DAD is here to make sure you\ncan get annoyed by Water Absorb.", MSGBOX_NPC)
	end
}


const CELIA_FOREST = 20
script ViridianForest_EventScript_CeliaChecksDex {
	setvar(VAR_CSR_CELIA_IN_FOREST, 1)
	if(!checkmoncaught(SPECIES_MANKEY) || !checkmoncaught(SPECIES_WEEDLE) || !(checkmoncaught(SPECIES_CATERPIE) || checkmoncaught(SPECIES_METAPOD))) { // at least one major area not accounted for
		lock

		getplayerxy(VAR_TEMP_3, VAR_TEMP_4)
		addobject(CELIA_FOREST)
		setobjectxy(CELIA_FOREST,VAR_TEMP_3,18)
		applymovement(CELIA_FOREST, CeliaApproaches)
		waitmovement(0)
		playse(SE_PIN)
		applymovement(LOCALID_PLAYER, PlayerSeesHer)
		waitmovement(0)
		delay(15)
		textcolor(1)
		msgbox("Hi, there!\nI'm CELIA, this hack's creator.\pSorry to inturrupt, but I noticed\nsomething and had to pop in.", MSGBOX_DEFAULT)
		
		specialvar(VAR_RESULT, GetPokedexCount)
		copyvar(VAR_0x8008, VAR_0x8005)
		copyvar(VAR_0x8009, VAR_0x8006)
		buffernumberstring(STR_VAR_1, VAR_0x8008)
		buffernumberstring(STR_VAR_2, VAR_0x8009)

		if((var(VAR_0x8009) > 4) ) { // Rattata plus Caterpie is bare minimum for having an acceptable dex
			msgbox("I see you've been making good\nprogress on your POKéDEX.\pThat's good to see!\nThat's what you should be doing!\pHowever, I think there's something\nyou missed.", MSGBOX_DEFAULT)
			if(!(checkmoncaught(SPECIES_MANKEY) && checkmoncaught(SPECIES_NIDORAN_F) && checkmoncaught(SPECIES_NIDORAN_M))) {
				if(!(checkmoncaught(SPECIES_MANKEY) || checkmoncaught(SPECIES_NIDORAN_F) || checkmoncaught(SPECIES_NIDORAN_M))) {
					msgbox("Did you remember to check out\nROUTE 22?\lIt's west of VIRIDIAN.\pThere's some POKéMON there to\ncatch as well!", MSGBOX_DEFAULT)
					setflag(FLAG_TEMP_3) //Flag temp 3 used to track if she's already said something in the dialogue.
				} else {
					//You missed something on Route 22
					msgbox("When you went to ROUTE 22 earlier,\ndid you catch all 3 POKéMON there?\pI think there might be one that\nyou're missing!", MSGBOX_DEFAULT)
					setflag(FLAG_TEMP_3)
				}
			}
			if(!checkmoncaught(SPECIES_WEEDLE)) {
				if(flag(FLAG_TEMP_3)) {
					msgbox("Also, don't forget to check the\ngrass in VIRIDIAN CITY!\pThere's something to catch there\ntoo!", MSGBOX_DEFAULT)
				} else {
					msgbox("Do you remember the grass by the\nOLD MAN in VIRIDIAN CITY?\pThere's actually a POKéMON to\ncatch in there!", MSGBOX_DEFAULT)
				}
			

			}
		} else {
			msgbox("It looks like you haven't really\nmade too much of an effort to\lfill in your POKéDEX.\pUh, I wasn't kidding earlier when I\nsaid you really should fill it out!", MSGBOX_DEFAULT)
			
			specialvar(VAR_RESULT, GetPokedexCount)
			if((var(VAR_0x8009) < 2)) { //If you haven't caught anything, she's PISSED
				msgbox("I understand that you probably\njust wanna mash through text,\lespecially if you have speedup.\pBut this is not a normal vanilla-\nstyle romhack.\lYou really can't play it like one.", MSGBOX_DEFAULT)
			} else { // General advice for players who clearly don't understand this game.
				msgbox("I strongly recommend going around\nand catching as much as you can.\pPOKé BALLS have guaranteed catch\nrates in this hack, so it's easy!\pTrust me, you'll thank me later.\n", MSGBOX_DEFAULT)
			}
		}
		call(SetPlayerPokedexValues)
		msgbox("Anyway, sorry for stopping you!\nThat's just some friendly advice.\lHave fun, and good luck vs BROCK!", MSGBOX_DEFAULT)
		closemessage
		delay(15)

		applymovement(CELIA_FOREST, CeliaAbsconds)
		waitmovement(0)
		copyobjectxytoperm(CELIA_FOREST)
		release
	}
}

script ViridianForest_EventScript_CeliaGotCaught {
	lock
	faceplayer
	if(var(VAR_TEMP_5) > 15) {
		msgbox("All right, that should be more\nthan enough CANDY.\pYou're on your own from here.\nGood luck!", MSGBOX_DEFAULT)
		release
		end
	}
	if(flag(FLAG_TEMP_7)) {
		msgbox("You want another one?\nSure!", MSGBOX_DEFAULT)
		addvar(VAR_TEMP_5, 1)
	} else {
		msgbox("Oh, hey there!\pI was planning on leaving, but\nI got tired.\pThanks for catching back up with\nme, though!\lHere's a gift!", MSGBOX_DEFAULT)
	}
	giveitem(ITEM_RARE_CANDY)
	setflag(FLAG_TEMP_7)
	goto_if_eq(VAR_RESULT, FALSE, EventScript_BagIsFull)
	release

}

movement CeliaApproaches {
	set_visible
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	face_up
}

movement PlayerSeesHer {
	face_down
	emote_exclamation_mark
}

movement CeliaAbsconds {
	walk_right * 8
}

script ViridianForest_BuffOak {
	lock
	if(checkitem(ITEM_WAILMER_PAIL)) {
		msgbox("This tree looks extraordinarily\nbuff.\lIts biceps could crush your skull.\pWould you like to dump water on it?\n", MSGBOX_YESNO)
		if(!var(VAR_RESULT)) {
			msgbox("{PLAYER} decided not to risk\ninternal hemmorage.", MSGBOX_DEFAULT)
			release
			end
		}
		fadenewbgm(MUS_NONE)
		msgbox("{PLAYER} watered the tree…\n", MSGBOX_DEFAULT)
		closemessage
		removeitem(ITEM_WAILMER_PAIL)
		additem(ITEM_EMPTY_PAIL)
		closemessage
		delay(10)
		playbgm(MUS_CSR_IMPOSTER_OAK, FALSE)
		delay(20)
		applymovement(VAR_LAST_TALKED, Common_Movement_FaceUp) // open eyes
		waitmovement(0)
		delay(60)
		applymovement(VAR_LAST_TALKED, Common_Movement_FaceLeft)
		delay(10)
		applymovement(VAR_LAST_TALKED, Common_Movement_FaceUp)
		delay(20)
		applymovement(VAR_LAST_TALKED, Common_Movement_FaceLeft)
		delay(10)
		applymovement(VAR_LAST_TALKED, Common_Movement_FaceUp)
		delay(60)
		textcolor(NPC_TEXT_COLOR_TREE)
		msgbox("{FONT_SMALL}OAK?: Huuu-ah!!\nHey, kid!\lWhat's the big idea?\pWhat's that?\nYou like my gains?\pHa, ha! Yeah, I get it.\nYou want a bod like mine!\pBut you can't just go chuckin'\nwater on anyone you're jealous of.\lDon't let envy turn ya green!\pBut here - you want a boost?\nTry this!", MSGBOX_DEFAULT)
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		giveitem_msg("{PLAYER} was gifted the\nMACHO BRACE from the large tree!", ITEM_MACHO_BRACE, 1)
		textcolor(NPC_TEXT_COLOR_TREE)
		msgbox("{FONT_SMALL}OAK?: Aight, kid.\nMake some good use outta that!\pAnyway, I'm leavin.\nI got bigger fish to fry!\pPeace out!\n", MSGBOX_DEFAULT)
		closemessage
		fadescreenswapbuffers(FADE_TO_BLACK)
		removeobject(VAR_LAST_TALKED)
		setflag(FLAG_HIDE_BUFF_OAK)
		fadenewbgm(MUS_NONE)
		playse(SE_EXIT)
		fadescreenswapbuffers(FADE_FROM_BLACK)
		fadedefaultbgm
		release
		end
	} else {
		msgbox("For some reason, this tree in\nparticular feels… off.", MSGBOX_DEFAULT)
		playmoncry(SPECIES_SUDOWOODO, CRY_MODE_DEFAULT)
		waitmoncry
	}
	release
}

script ViridianForest_ClearGrassFlag {
	clearflag(FLAG_WALKED_THROUGH_GRASS)
	release
}


script ViridianForest_SetGrassFlag {
	setflag(FLAG_WALKED_THROUGH_GRASS)
	release
}

script ViridianForest_10UGuyFuckYou {
	if(flag(FLAG_CSR_CELIA_BONUS)) {
		applymovement(LOCALID_10U_GUY, moves(
			face_up
		))
		waitmovement(0)
	}
	release
}

script ViridianForest_SpawnCaterpie {
	lock
	setvar(VAR_VIRIDIAN_FOREST_CATERPIE, 1)
	setwildbattle(SPECIES_CATERPIE, 6, ITEM_NONE)
	dowildbattle
	release

}