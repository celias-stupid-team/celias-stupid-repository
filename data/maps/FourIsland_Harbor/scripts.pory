raw `
FourIsland_Harbor_MapScripts::
	.byte 0

FourIsland_Harbor_EventScript_Sailor::
	end
`

script FourIsland_Mesprit {
	lock
	faceplayer
	playmoncry(SPECIES_MESPRIT, CRY_MODE_ENCOUNTER)
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"MESPRIT: Mrraah!\n"
	"", MSGBOX_DEFAULT)
	waitmoncry
	delay(30)
	closemessage
	fadescreenswapbuffers(FADE_TO_BLACK)
	playse(SE_FLEE)
	removeobject(VAR_LAST_TALKED)
	waitse
	fadescreenswapbuffers(FADE_FROM_BLACK)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	delay(30)
	msgbox(
	"MESPRIT left to roam SINNOH!\p"

	"{PAUSE 30}(…which is not here.)\n"
	"", MSGBOX_DEFAULT)
	release
	end
	

}
