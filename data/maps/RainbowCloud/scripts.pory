mapscripts RainbowCloud_MapScripts {
	MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
		VAR_TEMP_1, 0 {
			turnobject(LOCALID_PLAYER, DIR_NORTH)
		}
	]
	MAP_SCRIPT_ON_TRANSITION {
		if(flag(FLAG_FINAL_SHINY)) {
			setmaplayoutindex(LAYOUT_RAINBOW_CLOUD_FINAL_SHINY)
		}
	}
}

script RainbowCloud_Thesis {
	msgbox(
	"Creativity is the spark of the\n"
	"human soul!\p"

	"Break past the flimsy walls of your\n"
	"expectations!\l"
	"Abandon your fear of taking a risk!\p"

	"Train yourself to see the world not\n"
	"for what you think it is, but for\l"
	"what you believe it can become.\p"

	"All art is an extension of your own\n"
	"unique perspective, and your voice\l"
	"is worth hearing regardless of skill!\p"

	"I believe in the intrinsic value of\n"
	"of the audacity of creation, and I\l"
	"will empower others to feel the same!", MSGBOX_SIGN)

}


script RainbowCloud_FindTheShinies {
	
	if(flag(FLAG_POST_GAME)) {
		lock
		msgbox(
		"{FONT_SMALL}The rainbow hides {PAUSE 30}within its skies\n"
		"{PAUSE 25}A brilliant stellar hue               \p"

		"Indulge the quest {PAUSE 10}and seek the rest\n"
		"{PAUSE 20}The veil soon {PAUSE 5}shall rise               \p"

		"To find the one {PAUSE 5}for all you've done\n"
		"{PAUSE 25}My final test to you:{PAUSE 10}               \p"

		"Unravel the puzzle within {PAUSE 5}the puzzle\n"
		"{PAUSE 30}and claim your shining prize.", MSGBOX_DEFAULT)
		closemessage
		delay(20)
		special(GetShinyCount)
		
		buffernumberstring(STR_VAR_3, VAR_0x8006)
		msgbox(
		"PROGRESS:{PAUSE 30}\n"
		"{STR_VAR_3}/150", MSGBOX_DEFAULT)
		if(var(VAR_0x8006) == 150) {
			fadenewbgm(MUS_NONE)
			delay(120)
			playse(SE_M_MEGA_KICK)
			fadescreenspeed(FADE_TO_WHITE, 10)
			waitse
			setlayouttiles(LAYOUT_RAINBOW_CLOUD_FINAL_SHINY,0,0,0,0,28,50)
			delay(60)
			setflag(FLAG_FINAL_SHINY)
			fadescreeninstant(FADE_FROM_WHITE)
			playse(SE_SHINY)
			release
			end

		}
		release
		end

	}
		msgbox(
		"{FONT_SMALL}The rainbow hides {PAUSE 30}within its skies\n"
		"{PAUSE 25}A brilliant stellar hue               \p"

		"Indulge the quest {PAUSE 10}and seek the rest\n"
		"{PAUSE 20}The veil soon {PAUSE 5}shall rise               \p"

		"To find the one {PAUSE 5}for all you've done\n"
		"{PAUSE 25}My final test to you:{PAUSE 10}               \p"

		"Unravel the puzzle within {PAUSE 5}the puzzle\n"
		"{PAUSE 30}and claim your shining prize.", MSGBOX_SIGN)

}

script RainbowCloud_JourneysEnd {
	msgbox(
	"Hi!\n"
	"I'm CELIA, the creator.\p"

	"Congratulations - You've finally\n"
	"found the last secret in the game!\p"

	"The reward for you - and for all\n"
	"who love this game - waits ahead.\p"

	"Read the message on the sign, and\n"
	"copy it verbatim into a message on\l"
	"my Discord server.\p"

	"You've reached the end now.\n"
	"Be proud of yourself!", MSGBOX_NPC)
}

script RainbowCloud_CastformFight {
    lock
    faceplayer
	setflag(FLAG_FOUGHT_CASTFORM)
    setwildbattle(SPECIES_CASTFORM, 50)
	dowildbattle
	removeobject(VAR_LAST_TALKED)
    release
    end
}

script RainbowCloud_ShinyCastformFight {
    lock
    faceplayer
	setflag(FLAG_SHINY_CREATION)
    setwildbattle(SPECIES_CASTFORM, 50)
	dowildbattle
	removeobject(VAR_LAST_TALKED)
    release
    end
}