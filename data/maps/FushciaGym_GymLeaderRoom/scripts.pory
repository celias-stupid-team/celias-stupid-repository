mapscripts FushciaGym_GymLeaderRoom_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        setvar(VAR_FUSHCIA_PREVIOUS_ROOM, FUSHCIA_ROOM_GYM_LEADER)
        if(!flag(FLAG_REVEALED_DAD)) {
            setflag(FLAG_TEMP_1)
        } else {
            
            setrespawn(HEAL_LOCATION_FUSHCIA_GYM_GYM_LEADER_ROOM)
        }
        if(flag(FLAG_DEFEATED_TRAINER_1)) {
            setmetatile(3, 8, 0x357, TRUE)
        }
        if(flag(FLAG_DEFEATED_TRAINER_2)) {
            setmetatile(21, 8, 0x357, TRUE)
        }
    }
}

const KOGA = 1
const DAD = 2
script FushciaGym_GymLeaderRoom_Koga {
    lock
    faceplayer
    setrespawn(HEAL_LOCATION_FUSHCIA_GYM_GYM_LEADER_ROOM)
    msgbox("Fufufufu…\nWelcome, {PLAYER}!\lI am the LEADER of this GYM.\pOh? What's that?\nHow did I know your name?\pHa!\nThat's because you've been misled.\lYou see, this is merely a disguise!\pIn truth, my real identity is…\n", MSGBOX_DEFAULT)
    applymovement(KOGA, FushciaGymLeaderSpin)
    waitmovement(0)
    removeobject(KOGA)
    addobject(DAD)
    setflag(FLAG_REVEALED_DAD)
    applymovement(DAD, FushciaGymLeaderSpin)
    waitmovement(0)
    setvar(VAR_TEMP_START_EVENT_BATTLE, EVENT_BATTLE_DAD)
    msgbox("DAD!{PAUSE 30}\nHey, {PLAYER}!\lWhat are you doing out here?\pDon't you know I'm the LEADER of\nFUSHCIA GYM?\lMy INVISIBLE WALLS are strong!\pWell, never mind that.\nHow about we battle?", MSGBOX_DEFAULT)
    trainerbattle_no_intro(TRAINER_LEADER_KOGA, "Hey!\nNicely done!\lI'm so proud of you, {PLAYER}.\pSaving a mother from those nasty\nDMCA guys…\lYou make your father proud!\pTake this - you've earned it.\nIt's the DAD BADGE!")
    release
}

script FushciaGym_GymLeaderRoom_Dad {
    if(flag(FLAG_DEFEATED_KOGA)) {
        goto(FushciaGym_GymLeaderRoom_Dad_Heal)
    }
    lock
    faceplayer
    msgbox("DAD!\nHey, {PLAYER}!\lWhat are you doing out here?\pDon't you know I'm the LEADER of\nFUSHCIA GYM?\lMy INVISIBLE WALLS are strong!\pWell, never mind that.\nHow about we battle?", MSGBOX_DEFAULT)
    setvar(VAR_TEMP_START_EVENT_BATTLE, EVENT_BATTLE_DAD)
    trainerbattle_no_intro(TRAINER_LEADER_KOGA, "Hey!\nNicely done!\lI'm so proud of you, {PLAYER}.\pSaving a mother from those nasty\nDMCA guys…\lYou make your father proud!\pTake this - you've earned it.\nIt's the DAD BADGE!")
    release

}

script FushciaGym_GymLeaderRoom_Dad_Defeat {
    playfanfare(MUS_OBTAIN_BADGE)
    msgbox("{PLAYER} obtained the\nDAD BADGE!", MSGBOX_DEFAULT)
    waitfanfare
	setflag(FLAG_DEFEATED_KOGA)
	setflag(FLAG_BADGE05_GET)

    msgbox("DAD: The DAD BADGE will allow\nyou to use SURF outside of battle.\pNow you can explore the KANTO\nGREAT SEA!\l(…in the next demo. Sorry!)\pBut never mind that.\nHow about you take REST?", MSGBOX_DEFAULT)
    giveitem_msg("Obtained the TM44!\n", ITEM_TM44, 1)
    msgbox("DAD: There you are!\nGood luck on your adventure!", MSGBOX_DEFAULT)
    
    release
    end
}

script FushciaGym_GymLeaderRoom_Dad_Heal {
	lock
	faceplayer
	textcolor(0)
	msgbox("DAD: {PLAYER}!\nWhat are you doing out here?\pComing back to visit me after\nyour victory?\lThat's so sweet of you!\pBut never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}

script FushciaGymLeaderSpin {
    face_left
    delay_1
    face_up
    delay_1
    face_right
    delay_1
    face_down
    delay_1
    face_left
    delay_1
    face_up
    delay_1
    face_right
    delay_1
    face_down
    delay_1
    face_left
    delay_1
    face_up
    delay_1
    face_right
    delay_1
    face_down
    delay_1
    step_end
}