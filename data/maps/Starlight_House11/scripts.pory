mapscripts Starlight_House11_MapScripts {
MAP_SCRIPT_ON_TRANSITION {
    random(50)
		setflag(FLAG_TEMP_19)
		if(var(VAR_RESULT) == 22 && !flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
			clearflag(FLAG_TEMP_19)
		}
        if (var(VAR_BONUS_STARS) == 1023) {
		random(30)
		if(var(VAR_RESULT) == 22 && !flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
			clearflag(FLAG_TEMP_19)
		}
		}
}
}

script Starlight_House11_Cry {
	if(flag(FLAG_TEMP_1)) {
    playmoncry(SPECIES_PIKACHU_SNAP_CLOSE, CRY_MODE_DEFAULT)
    clearflag(FLAG_TEMP_1)
    }
    release
    end

}

script Starlight_House11_Flag {
	setflag(FLAG_TEMP_1)
    release
    end

}

script Starlight_House_Star_Character1 {
	lock
    faceplayer
    //playmoncry(SPECIES_GARDEVOIR, CRY_MODE_DEFAULT)
    playse(SE_PIN)
	applymovement(LOCALID_STAR_GARDEVOIR1, moves(
		emote_exclamation_mark
	))
    delay(30)
    playse(SE_M_TELEPORT)
    fadescreeninstant(FADE_TO_WHITE)
    removeobject(LOCALID_STAR_GARDEVOIR1)
    setflag(FLAG_TEMP_19)
    fadescreenswapbuffers(FADE_FROM_WHITE)
    release
    end
}

