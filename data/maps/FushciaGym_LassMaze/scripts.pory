mapscripts FushciaGym_LassMaze_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        setflag(FLAG_LASS_MAZE)
        setrespawn(HEAL_LOCATION_FUSHCIA_GYM_LASS_MAZE)
    }
}

script FushciaGym_DoorBlockingLass {
    textcolor(NPC_TEXT_COLOR_RED)
    msgbox("Hey!\nDon't look at me!", MSGBOX_DEFAULT)
    closemessage
    warp(MAP_FUSHCIA_GYM_LASS_MAZE, 3)
    release
    end
}

script FushciaGym_LassMaze_Sign {
	msgbox("don't let her see you.\nsavestate frequently", MSGBOX_SIGN)
	end
}