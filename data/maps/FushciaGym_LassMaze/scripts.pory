mapscripts FushciaGym_LassMaze_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        clearflag(FLAG_LASS_MAZE) // add a condition in case the flag NPCs should no longer be reset after a certain event
        setrespawn(HEAL_LOCATION_FUSHCIA_GYM_LASS_MAZE)
    }
}

script FushciaGym_DoorBlockingLass {
    textcolor(NPC_TEXT_COLOR_RED)
    msgbox("Hey!\nDon't look at me!", MSGBOX_DEFAULT)
    closemessage
    warp(MAP_FUSHCIA_GYM_LASS_MAZE, 3)
    release
    end
}

script FushciaGym_LassMaze_Sign {
	msgbox("don't let her see you.\nsavestate frequently", MSGBOX_SIGN)
	end
}

script FushciaGym_LassMaze_FriendRoom {
	msgbox("FRIEND ROOM\pA room to connect with a kind\nacquaintance", MSGBOX_SIGN)
	end
}

script FushciaGym_LassMaze_DrillSign {
	msgbox("DRILL ROOM\pYou know the drill.\p…Y'know.\n{PAUSE 30}The drill.", MSGBOX_SIGN)
	end
}