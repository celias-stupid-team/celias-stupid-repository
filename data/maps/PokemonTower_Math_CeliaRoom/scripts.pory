const CELIA = 2
mapscripts PokemonTower_Math_CeliaRoom_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_1, 0 {
            setvar(VAR_TEMP_1, 1)
            if(!flag(FLAG_CELIA_SECRET_LAVENDER)) {
                applymovement(LOCALID_PLAYER, moves(
                    walk_left * 2
                ))
                waitmovement(0)
                applymovement(LOCALID_PLAYER, Common_Movement_FaceLeft)
                delay(60)
                playse(SE_EXIT)
                setobjectxy(CELIA, 13, 15)
                setflag(FLAG_CELIA_SECRET_LAVENDER)
                applymovement(CELIA, CeliaEnters)
                waitmovement(0)
                delay(120)
                textcolor(NPC_TEXT_COLOR_FEMALE)
                msgbox("Y{PAUSE 5}o{PAUSE 5}u{PAUSE 5}'{PAUSE 5}r{PAUSE 5}e{PAUSE 5} n{PAUSE 5}o{PAUSE 5}t{PAUSE 5} t{PAUSE 5}h{PAUSE 5}e {PAUSE 5}o{PAUSE 5}n{PAUSE 5}e{PAUSE 5}…\n", MSGBOX_DEFAULT)
                closemessage
                delay(60)
                applymovement(CELIA, CeliaMiddle)
                waitmovement(0)
                playse(SE_PIN)
                applymovement(CELIA, Common_Movement_ExclamationMark)
                delay(60)
                msgbox("…Buuuuuuuut!\pBecause you found me here, I'll\ntell you a secret!", MSGBOX_DEFAULT)
                closemessage
                delay(20)
                setvar(VAR_CSR_CURRENT_CELIA_SECRET, 4)
                call(CeliaSecrets_CeliaTellsYouNextHint)
                delay(60)
                applymovement(CELIA, CeliaLeaves)
                waitmovement(0)
                release
                
            }
        }
    ]
}

movement CeliaEnters {
    face_left
    set_visible
    delay_16 * 2
    walk_slower_left
    face_left
}

movement CeliaMiddle {
    walk_slower_up
    walk_slower_left * 2
    walk_slower_up
    delay_16 * 2
    face_down
}

movement CeliaMiddle2 {
    walk_down
    face_right
}

movement CeliaLeaves {
    walk_up
    walk_right * 6
    set_invisible
}

script PokemonTower_CeliaRoom_Shorts {
    lock
    faceplayer
    msgbox("Death is an illusion.\nAnd so are pants.", MSGBOX_DEFAULT)
    closemessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    removeobject(VAR_LAST_TALKED)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    release
}


script PokemonTower_CeliaRoom_Smitty {
	msgbox(
	"HERE LIES SMITTY WERBENMANJENSEN\p"

	"HE WAS {PAUSE 30}THE ONE.\n"
	"", MSGBOX_SIGN)

}


script PokemonTower_CeliaRoom_BerryPowder {
    lock
    if(flag(FLAG_BERRIED_ALIVE)) {
	    msgbox("Here lied the BERRY POWDER MAN.\pMay his jest increase.\n", MSGBOX_DEFAULT)

    } else {
	    msgbox("Here lies the BERRY POWDER MAN.\pMay he rest in peace.\n", MSGBOX_DEFAULT)

    }

    if(checkitem(ITEM_BERRYLEGION) && !flag(FLAG_BERRIED_ALIVE)) {
        msgbox(
        "{PLAYER} laid the BERRYLEGION\n"
        "at the grave to pay LAST RESPECTS.", MSGBOX_DEFAULT)
        closemessage
        removeitem(ITEM_BERRYLEGION)
        fadenewbgm(MUS_NONE)
        setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 2)
        setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 2)
        setvar(VAR_SHAKESCREEN_NUM_SHAKES, 10)
        setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 1)
        special(ShakeScreen)
        textcolor(NPC_TEXT_COLOR_BLUE)
        msgbox(
        "I… … …{PAUSE 30}\n"
        "AM… … …\l"
        "{PAUSE 30}A {PAUSE 20}L {PAUSE 20}I {PAUSE 20}V {PAUSE 20}E {PAUSE 20} !", MSGBOX_DEFAULT)
        playbgm(MUS_POKE_TOWER, TRUE)
        setflag(FLAG_SHINY_CREATION)
        trainerbattle_no_intro(TRAINER_BERRIED_ALIVE, "AaaAaAAAaaAHhHHHHH-!")
        delay(60)
        applymovement(LOCALID_BERRY_POWDER_MAN, moves(
            walk_fastest_down
            set_visible
            jump_in_place_down
        ))
        delay(5)
        playse(SE_LEDGE)
        waitmovement(0)
        delay(30)
        msgbox(
        "Aha!\n"
        "There we go!\l"
        "Thank you for digging me back up.\p"

        "Everyone kept saying, “Oh, no!\n"
        "Grandpa's dead!”\p"

        "Nobody listened to my arguments\n"
        "to the contrary.\p"

        "Anyway, I suppose I'll be off now.\p"

        "I wonder what my good friend the\n"
        "MUSHROOM MANIAC has been up to?", MSGBOX_DEFAULT)
        closemessage
        fadescreen(FADE_TO_BLACK)
        setflag(FLAG_BERRIED_ALIVE)
        clearflag(FLAG_SHINY_CREATION)
        removeobject(LOCALID_BERRY_POWDER_MAN)
        fadescreen(FADE_FROM_BLACK)
        release
        end



    }
    release
	end
}