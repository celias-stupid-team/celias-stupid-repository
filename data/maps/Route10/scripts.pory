raw `
Route10_MapScripts::
	map_script MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE Route10_Warp_Script
	map_script MAP_SCRIPT_ON_TRANSITION Route10_OnTransition
	.byte 0

Route10_EventScript_Unused::
	end

Route10_EventScript_NorthRockTunnelSign::
	msgbox Route10_Text_RockTunnelDetourToLavender, MSGBOX_SIGN
	end

Route10_EventScript_SouthRockTunnelSign::
	msgbox Route10_Text_RockTunnel, MSGBOX_SIGN
	end

Route10_EventScript_PowerPlantSign::
	msgbox Route10_Text_PowerPlant, MSGBOX_SIGN
	end
`
script Route10_OnTransition {
	setflag(FLAG_CSR_MAP_ROUTE_10)
	call(SetPlayerPokedexValues)
}

script Route10_Warp_Script {
	map_script_2(VAR_TEMP_1, 0, Route10_Play_Music)
}

script Route10_Play_Music {
	//playbgm(MUS_ROUTE3, TRUE)
	//fadedefaultbgm
	//fadenewbgm(MUS_ROUTE3)
	
	//fadeoutbgm
	//playbgm(MUS_ROUTE3, TRUE)

	//Literally none of these worked the way I wanted them to, so fuck it.
	//I'm going with the stupid option.
}

script Route10_Imprint {
	msgbox("There's a suspiciously POKéMON\nCENTER-shaped imprint in the ground.", MSGBOX_SIGN)
	end
}


script Route10_Youngster {
	famechecker(FAMECHECKER_ROCK_TUNNEL, 0)
	msgbox("Wait, wasn't there a POKéMON\nCENTER here a minute ago?\pDarn, that's inconvenient.\pI guess I'm gonna have to run back\nto town after every fight.\lROCK TUNNEL's gonna be a pain...", MSGBOX_NPC)
	end
}


const DAD = 8
script Route10_TrappedDad {
	lock
	applymovement(DAD, Common_Movement_FaceUp)
	waitmovement(0)
	textcolor(NPC_TEXT_COLOR_MALE)
	msgbox("DAD: {PLAYER}!\nWhat are you doing out here?\pI was just on my way to ROCK\nTUNNEL, but I got stuck.\lI can't get out!\pI'd love to let you rest up, but\nsadly you're on your own for this.\lSorry!", MSGBOX_DEFAULT)
	setflag(FLAG_DAD_ROCKTUNNEL)
	release
}

script Route10_SecretDad {
	lock
	faceplayer
	textcolor(0)
	msgbox("DAD: {PLAYER}!\nWhat are you doing out here?\pActually, yeah.\nWhat are you doing?\lYou're not supposed to get here!\pWell, never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}

const LASS = 9

script Route10_LassAttack {
	lock
	playbgm(MUS_ENCOUNTER_GIRL, TRUE)
	delay(90)
	playse(SE_EXIT)
	addobject(LASS)
	setobjectxy(LASS, 8, 19)
	applymovement(LASS, LassFindsYou)
	waitmovement(0)
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox("Aww man…\pI was really enjoying being\nin that cave.\pIt was so dark in there, no one\ncould look at me!\pWhy did you have to come along\nand ruin everything…", MSGBOX_DEFAULT)
	playbgm(MUS_ROUTE3, TRUE)
	trainerbattle_no_intro(TRAINER_LASS_ROCK_TUNNEL, Route10_Text_LassDefeat)
	setvar(VAR_ROUTE10_LASS, 1)
	msgbox("A whole bunch of guys dressed\nas POKéMON ran into that cave!\pI didn't mind, though.\nNone of them looked at me.", MSGBOX_DEFAULT)
	closemessage
	delay(20)
	msgbox("Maybe I should just go back in\nthere…", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	applymovement(LASS, LassAbsconds)
	waitmovement(0)
	playse(SE_EXIT)
	removeobject(LASS)
}

movement LassFindsYou{
	set_visible
	face_down
	delay_4 * 3
	walk_down
	delay_16 * 2
	face_left
	delay_8 * 5
	face_right
	delay_8 * 5
	walk_left * 3
	walk_slow_left * 2
	walk_slow_down
	face_down
	delay_4 * 3
	face_player
}

movement LassAbsconds{
	face_right
	delay_8 * 5
	face_left
	delay_8 * 5
	walk_up
	walk_right * 3
	walk_slow_right * 2
	walk_slow_up
}