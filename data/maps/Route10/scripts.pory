	//fadenewbgm(MUS_ROUTE3)
	
	//fadeoutbgm
	//playbgm(MUS_ROUTE3, TRUE)

	//Literally none of these worked the way I wanted them to, so fuck it.
	//I'm going with the stupid option.
}

script Route10_Imprint {
	msgbox("There's a suspiciously POKéMON\nCENTER-shaped imprint in the ground.", MSGBOX_SIGN)
	end
}

script Route10_NothingToLookAt {
	msgbox("There isn't anything to look at.\pYou feel scammed.\n", MSGBOX_SIGN)
	end
}


script Route10_Youngster {
	famechecker(FAMECHECKER_ROCK_TUNNEL, 0)
	msgbox("Wait, wasn't there a POKéMON\nCENTER here a minute ago?\pDarn, that's inconvenient.\pI guess I'm gonna have to run back\nto town after every fight.\lROCK TUNNEL's gonna be a pain...", MSGBOX_NPC)
	end
}

script Route10_RouteSign {
	lock
	specialvar(VAR_RESULT, GetPlayerFacingDirection)
	if(var(VAR_RESULT) == DIR_SOUTH) {
		msgbox("There's graffiti on the back of the\nsign…", MSGBOX_DEFAULT)
		closemessage
		textcolor(NPC_TEXT_COLOR_FEMALE)
		msgbox("Thank you for taking the time to\nread this sign.\p… … …\n… … …\pThis sign loves you.\n", MSGBOX_SIGN)
	} else {
		msgbox("ROUTE 10\nNEW WILD POKéMON: 1", MSGBOX_SIGN)
	}
	end
}

const DAD = 7
script Route10_TrappedDad {
	lock
	applymovement(DAD, Common_Movement_FaceUp)
	waitmovement(0)
	textcolor(NPC_TEXT_COLOR_MALE)
	msgbox("DAD: {PLAYER}!\nWhat are you doing out here?\pI was just on my way to ROCK\nTUNNEL, but I got stuck.\lI can't get out!\pI'd love to let you rest up, but\nsadly you're on your own for this.\lSorry!", MSGBOX_DEFAULT)
	setflag(FLAG_DAD_ROCKTUNNEL)
	release
}

script Route10_SecretDad {
	lock
	faceplayer
	textcolor(0)
	setflag(FLAG_GOT_HORSEA_FROM_DAD)
	if(flag(FLAG_GOT_HORSEA_FROM_DAD)) {
		msgbox("DAD: {PLAYER}!\nWhat are you doing back here?\pBe careful not to get stuck.\nOnce you jump down here, that's it!\pWell, never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)
			call(EventScript_DadHeal)
			release
			end

	}
	msgbox("DAD: {PLAYER}!\nWhat are you doing back here?\pBe careful not to get stuck.\nOnce you jump down here, that's it!\pSay, one of the kind young men in\nthat cave came by.\lHe had this POKéMON with him.\pHe seemed to really like it.\nI think you would too!\pHere, catch!", MSGBOX_DEFAULT)
	setvar(VAR_CSR_GIFT_POKEMON, SPECIES_HORSEA)
	setflag(FLAG_SHINY_CREATION) //Horsea
	closemessage
	playfanfare(MUS_LEVEL_UP)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox("{PLAYER} caught the gracefully-thrown\nHORSEA!", MSGBOX_DEFAULT)
	waitfanfare
	call(Common_Script_GiftPokemon)
	closemessage
	textcolor(NPC_TEXT_COLOR_MALE)
	msgbox("DAD: Well, never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)
	setflag(FLAG_GOT_HORSEA_FROM_DAD)
	call(EventScript_DadHeal)
	release
	end
}

const LASS = 8

script Route10_LassAttack {
	lock
	playbgm(MUS_ENCOUNTER_GIRL, TRUE)
	delay(90)
	playse(SE_EXIT)
	addobject(LASS)
	setobjectxy(LASS, 9, 19)
	applymovement(LASS, LassFindsYou)
	waitmovement(0)
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox("Aww man…\pI was really enjoying being\nin that cave.\pIt was so dark in there, no one\ncould look at me!", MSGBOX_DEFAULT)
	playbgm(MUS_ROUTE3, TRUE)
	trainerbattle_no_intro(TRAINER_LASS_ROCK_TUNNEL, Route10_Text_LassDefeat)
	setvar(VAR_ROUTE10_LASS, 1)
	msgbox("A whole bunch of guys dressed\nas POKéMON ran into that cave!\pI didn't mind, though.\nNone of them looked at me.", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	applymovement(LASS, LassAbsconds)
	waitmovement(0)
	playse(SE_EXIT)
	removeobject(LASS)
}

movement LassFindsYou{
	set_visible
	face_down
	delay_4 * 3
	walk_down
	delay_16 * 2
	face_left
	delay_8 * 5
	face_right
	delay_8 * 5
	walk_left * 3
	walk_slow_left * 2
	walk_slow_down
	face_down
	delay_4 * 3
	face_player
}

movement LassAbsconds{
	face_right
	delay_8 * 5
	face_left
	delay_8 * 5
	walk_up
	walk_right * 3
	walk_slow_right * 2
	walk_slow_up
}


script Route10_DrifloonHbox {
	goto_if_questlog(EventScript_ReleaseEnd)
	lock
	faceplayer
	setwildbattle(SPECIES_JIGGLYPUFF, 25)
	waitse
	playmoncry(SPECIES_JIGGLYPUFF, CRY_MODE_ENCOUNTER)
	delay(40)
	waitmoncry
	setflag(FLAG_SYS_SPECIAL_WILD_BATTLE)
	dowildbattle
	clearflag(FLAG_SYS_SPECIAL_WILD_BATTLE)
	special(QuestLog_CutRecording)
	specialvar(VAR_RESULT, GetBattleOutcome)
	goto_if_eq(VAR_RESULT, B_OUTCOME_WON, PowerPlant_EventScript_FoughtElectrode1)
	goto_if_eq(VAR_RESULT, B_OUTCOME_RAN, PowerPlant_EventScript_FoughtElectrode1)
	goto_if_eq(VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED, PowerPlant_EventScript_FoughtElectrode1)
	setflag(FLAG_TEMP_7)
	setflag(FLAG_CSR_DRIFLOON_APPEARS)
	release
	end
}

script Route10_PowerGridRepair {
	
	famechecker(FAMECHECKER_ROCK_TUNNEL, 3)
	msgbox("Hello!\nAre you in charge around here?\pI'm from the KANTO LIGHTHOUSE\nPOWER GRID REPAIR SERVICE.\lI'm here to fix the electricity.\p…Oh, you've already fixed the\npower problem?\lUh\pGreat to hear!\nLess work for me.\pI'm sure the folks down at the\nLIGHTHOUSE are back in business!", MSGBOX_NPC)
	end
}


script Route10_DirtPatch {
	msgbox("This patch of dirt is\ninteractable!", MSGBOX_NPC)
	end
}

script Route10_TwoMaps {
	msgbox("In order to get the music to stop\nand restart in a funny way, I had\lto make a copy of this route.\pWhen you go into the cave, you get\nsent to the other copy.\pThen, that map is set to play a\nduplicate of the Route 10 music.\pThat way, the music stops and\nstarts back up, instead of just\lplaying nonstop.", MSGBOX_NPC)
	end
}

script Route10_Trees {
	msgbox("In vanilla, these are cut trees.\pI couldn't let you skip the setup\nto skipping Rock Tunnel, so I\lmade you go around to fight th\ltrainer.", MSGBOX_NPC)
	end
}


script Route10_CeliaLook {
	msgbox("This girl is here to get you to\nnotice the odd candy up there.\pWhether she's actually looking at\nsomething is immaterial.", MSGBOX_NPC)
	end
}

script Route10_CeliaDadSecret {
	msgbox(
	"This used to be the spot for a\n"
	"shiny, but the method sucked so\l"
	"I changed it.\p"

	"Now it's just a fun easter egg.\n"
	"", MSGBOX_NPC)
	end
}