raw `
CeladonCity_Condominiums_3F_MapScripts::
	.byte 0

CeladonCity_Condominiums_3F_EventScript_Programmer::
	msgbox CeladonCity_Condominiums_3F_Text_ImTheProgrammer, MSGBOX_NPC
	end

CeladonCity_Condominiums_3F_EventScript_GraphicArtist::
	msgbox CeladonCity_Condominiums_3F_Text_ImTheGraphicArtist, MSGBOX_NPC
	end

CeladonCity_Condominiums_3F_EventScript_Writer::
	msgbox CeladonCity_Condominiums_3F_Text_IWroteTheStory, MSGBOX_NPC
	end

CeladonCity_Condominiums_3F_EventScript_Designer::
	lock
	faceplayer
	specialvar VAR_RESULT, HasAllKantoMons
	goto_if_eq VAR_RESULT, TRUE, CeladonCity_Condominiums_3F_EventScript_CompletedPokedex
	msgbox CeladonCity_Condominiums_3F_Text_ImGameDesignerShowMeFinishedPokedex
	release
	end

CeladonCity_Condominiums_3F_EventScript_CompletedPokedex::
	goto CeladonCity_Condominiums_3F_EventScript_ShowDiploma
	end

CeladonCity_Condominiums_3F_EventScript_ShowDiploma::
	message CeladonCity_Condominiums_3F_Text_CompletedPokedexCongratulations
	waitmessage
	delay 60
	goto_if_questlog EventScript_ReleaseEnd
	special ShowDiploma
	waitstate
	release
	end

CeladonCity_Condominiums_3F_EventScript_DevelopmentRoomSign::
	msgbox CeladonCity_Condominiums_3F_Text_GameFreakDevelopmentRoom, MSGBOX_SIGN
	end

CeladonCity_Condominiums_3F_EventScript_Computer1::
	msgbox CeladonCity_Condominiums_3F_Text_ItsTheGameProgram, MSGBOX_SIGN
	end

CeladonCity_Condominiums_3F_EventScript_Computer2::
	msgbox CeladonCity_Condominiums_3F_Text_SomeonesPlayingGame, MSGBOX_SIGN
	end

CeladonCity_Condominiums_3F_EventScript_Computer3::
	msgbox CeladonCity_Condominiums_3F_Text_ItsScriptBetterNotLookAtEnding, MSGBOX_SIGN
	end
`

script CeladonCity_CeliaOffice_DMCA {
	msgbox("Making a ROMhack!?\pI can't believe such illegal\nactivities were going on, and\lright under our noses!\pThe BOSS will be sure to shut this\nstudio down!\p…Uh, right as soon as I figure out\nhow to get to him.", MSGBOX_NPC)
	end
}

script CeladonCity_CeliaOffice_Girl {
	msgbox("Y'know, this randomness was\nreally fun for a minute, but\lnow I just wanna go outside…\pWho even did this, anyway?\n", MSGBOX_NPC)
	end
}

script CeladonCity_CeliaOffice_Boxes {
	msgbox("Boxes and boxes of unused ideas!\n", MSGBOX_SIGN)
	end
}

script CeladonCity_CeliaOffice_Bookshelf {
	msgbox("Shelf after shelf filled with\nvarious copies of My Secret Life.", MSGBOX_SIGN)
	end
}


const CELIABOSS = 2
script CeladonCity_CeliaOffice_Staircase {
	lock
	textcolor(NPC_TEXT_COLOR_FEMALE)
	playse(SE_PIN)
	applymovement(CELIABOSS, CeliaNotices)
	waitmovement(0)
	waitse
	delay(10)
	switch(var(VAR_TEMP_2)) {
		case 0: 
			msgbox("That's the basement.\pIt's where we keep everyone else\nwho's helped us out!", MSGBOX_DEFAULT)
			closemessage
			delay(30)
			msgbox("Trust me, it's best if you don't\ngo down there.", MSGBOX_DEFAULT)
		case 1:
			msgbox("That's the basement.\nTrust me, you don't wanna go down.", MSGBOX_DEFAULT)
			closemessage
			delay(30)
			msgbox("...But you're gonna try anyway,\naren't you?", MSGBOX_DEFAULT)
		case 2:
			msgbox("Believe me, going into the basement\nis a mistake.\pThere's a reason I keep everyone\ndown there!", MSGBOX_DEFAULT)
			closemessage
			delay(30)
			msgbox("...\pStep away now, please.\n", MSGBOX_DEFAULT)
		case 3:
			msgbox("Uh, wow!\nYou really wanna go down there.\pAll right, if you insist!\pJust remember to savestate\nfrequently!", MSGBOX_DEFAULT)
			setvar(VAR_TEMP_0, 1)
			addvar(VAR_TEMP_2, 1)
			setflag(FLAG_ROUTE1_OBJECTS_RETREAT)
			clearflag(FLAG_CSR_CELIA_DEV_CREW)
			release
			end

		
	}
	addvar(VAR_TEMP_2, 1)
	closemessage
	delay(15)
	applymovement(OBJ_EVENT_ID_PLAYER, PlayerLeaves)
	waitmovement(0)
	applymovement(CELIABOSS, CeliaReturns)
	waitmovement(0)
	release
}

movement CeliaNotices {
	face_left
	emote_exclamation_mark
}

movement PlayerLeaves {
	walk_right
}

movement CeliaReturns {
	face_down
}