mapscripts FushciaCity_BrendanMay_1F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_CSR_MAP_BRENDANMAY)
        call(SetPlayerPokedexValues)
    }
    MAP_SCRIPT_ON_LOAD {
        if(flag(FLAG_WATERED_BRENDANMAY_OAK)) {
            call(BrendanMay_DrawStaircase)
        }
    }
}

script BrendanMay_Machoke {
    lock
    removeobject(VAR_LAST_TALKED)
    playfanfare(MUS_OBTAIN_ITEM)
    msgbox("{PLAYER} obtained the MACHOKE!\n", MSGBOX_DEFAULT)
    waitfanfare
    setvar(VAR_CSR_GIFT_POKEMON, SPECIES_MACHOKE)
    if(!flag(FLAG_GOT_MACHOKE)) {
        setflag(FLAG_GOT_MACHOKE)
        call(BrendanMay_GiveMachokeWithBrick)

    } else {
        call(Common_Script_GiftPokemon)

    }
    release
    end
}



script BrendanMay_GiveMachokeWithBrick {
	copyvar(VAR_TEMP_1, VAR_CSR_GIFT_POKEMON)
	givemon(VAR_CSR_GIFT_POKEMON, 25, ITEM_BRICK_PIECE)
	clearflag(FLAG_SHINY_CREATION)
	switch(var(VAR_RESULT)) {
		case 0: //Mon goes to party
            setflag(FLAG_GOT_MACHOKE)
			bufferspeciesname(STR_VAR_1, VAR_CSR_GIFT_POKEMON)
			msgbox(Text_GiveNicknameToThisMon, MSGBOX_YESNO)
			if(!var(VAR_RESULT)) {
				return
			}
			call(EventScript_GetGiftMonPartySlot)
			call(EventScript_ChangePokemonNickname)
			return
		case 1: //Mon goes to PC
                setflag(FLAG_GOT_MACHOKE)
				bufferspeciesname(STR_VAR_1, VAR_CSR_GIFT_POKEMON)
				msgbox(Text_GiveNicknameToThisMon, MSGBOX_YESNO)
				if(var(VAR_RESULT) == 0) {
					call(EventScript_TransferredToPC)
					return
				} else {
					call(EventScript_NameReceivedBoxMon)
					call(EventScript_TransferredToPC)
					return //This can be simplified; I'll deal with it later
				}
				
				return
		case 2:
			goto(EventScript_NoMoreRoomForPokemon)
			break
	}
}

script BrendanMay_Mom {
    textcolor(NPC_TEXT_COLOR_FEMALE)
    if(flag(FLAG_TEMP_1)) {
        msgbox("Oh, wasn't there a POKéMON over\nthere helping us move in?\pI wonder what happened to it.\n", MSGBOX_NPC)
    } else {
	    msgbox("Hello.\nAre you a visitor?\pMy family recently moved here.\nMy SON should be arriving shortly.\lHis FATHER is the GYM LEADER, see.\pI hope his trip went safely…\n", MSGBOX_NPC)
    }
}

script BrendanMay_ImposterOak {
    lock
    if(flag(FLAG_WATERED_BRENDANMAY_OAK)) {
        msgbox("It seems the tree has moved on.\n", MSGBOX_DEFAULT)
        release
        end
    }
    if(checkitem(ITEM_WAILMER_PAIL)) {
        msgbox("Something about this tree in\nparticular feels… off.\pWould you like to water it?\n", MSGBOX_YESNO)
        if(var(VAR_RESULT)) {
            fadenewbgm(MUS_NONE)
            msgbox("{PLAYER} watered the tree…\n", MSGBOX_DEFAULT)
            closemessage
            setflag(FLAG_WATERED_BRENDANMAY_OAK)
            removeitem(ITEM_WAILMER_PAIL)
		    additem(ITEM_EMPTY_PAIL)
            setmetatile(8, 2, 0x2DF, FALSE)
            setmetatile(8, 3, 0x2E7, TRUE)
            special(DrawWholeMapView)
            playbgm(MUS_CSR_IMPOSTER_OAK, TRUE)
            delay(50)
            textcolor(NPC_TEXT_COLOR_TREE)
            msgbox("{FONT_SMALL}OAK?: Wha-\nHey!\lHow'd you get in here?\pI found this nice empty home to\nmove to, livin' all by myself.\pAnd then some self-important jerk\nshoves in and drenches me in water!\lWhat's up with that?\pMan, forget this.\nYou wanna go upstairs? Fine!\pI'll spread my roots somewhere\nelse!", MSGBOX_DEFAULT)
            fadescreenswapbuffers(FADE_TO_BLACK)
            fadedefaultbgm
            playse(SE_EXIT)
            call(BrendanMay_DrawStaircase)
            special(DrawWholeMapView)
            waitse
            fadescreenswapbuffers(FADE_FROM_BLACK)
            release
            end
        } else {
            msgbox("{PLAYER} refused to water the\ntree.\pThe tree appears grateful.\n", MSGBOX_DEFAULT)
            release
            end
        }
    }
    msgbox("Something about this tree in\nparticular feels… off.", MSGBOX_DEFAULT)
    playmoncry(SPECIES_SUDOWOODO, CRY_MODE_NORMAL)
    waitmoncry
    release
}

script BrendanMay_DrawStaircase {
    setmetatile(8, 2, 0x28B, FALSE)
    setmetatile(8, 3, 0x280, FALSE)
    return
}

script BrendanMay_Fridge {
	msgbox(
	"It's a refrigerator.\p"

	"Two and a half cheeses are stored\n"
	"inside.\p"

	"There is nobody.\n"
	"", MSGBOX_SIGN)

}

script BrendanMay_Arranging {
    lock
    waitse
    playse(SE_PIN)
    applymovement(LOCALID_BRENDAN_MOM, moves(
        face_up
        emote_exclamation_mark
        delay_16 * 3
    ))
    waitmovement(0)
    textcolor(NPC_TEXT_COLOR_FEMALE)
    msgbox(
	"That's the arranging we have\n"
	"for me. Quite adept, no?\l"
	"Volcano Bakemeat!", MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_BRENDAN_MOM, moves(
        face_original_direction
    ))
    waitmovement(0)
    release
}

script BrendanMay_TVDownstairs {
    if(var(VAR_LANCE_LASS_ATTACK) == 2 && !flag(FLAG_GOT_SHINY_LATIAS)) {
        waitse
        playse(SE_PIN)
        applymovement(LOCALID_BRENDAN_MOM, moves(
            face_up
            emote_exclamation_mark
            delay_16 * 3
        ))
        waitmovement(0)
        textcolor(NPC_TEXT_COLOR_FEMALE)
        msgbox(
        "Oh, what color was that?\n"
        "", MSGBOX_DEFAULT)
        setflag(FLAG_SHINY_CREATION)
        setvar(VAR_CSR_GIFT_POKEMON, SPECIES_LATIAS)
        playfanfare(MUS_LEVEL_UP)
        textcolor(NPC_TEXT_COLOR_NEUTRAL)
        msgbox(
        "latias happens\n"
        "", MSGBOX_DEFAULT)
        setflag(FLAG_GOT_SHINY_LATIAS)
        call(Common_Script_GiftPokemon30)
        release
        end
    } else {
        msgbox(
        "It's a TV, but all the channels\n"
        "are different.", MSGBOX_SIGN)

    }

}
