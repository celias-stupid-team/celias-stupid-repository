mapscripts FushciaCity_BrendanMay_1F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_CSR_MAP_BRENDANMAY)
        call(SetPlayerPokedexValues)
    }
}

script BrendanMay_Machoke {
    lock
    removeobject(VAR_LAST_TALKED)
    playfanfare(MUS_OBTAIN_ITEM)
    msgbox("{PLAYER} obtained the MACHOKE!\n", MSGBOX_DEFAULT)
    waitfanfare
    setvar(VAR_CSR_GIFT_POKEMON, SPECIES_MACHOKE)
    call(Common_Script_ObtainedPokemon)
    release
    end
}

script BrendanMay_Mom {
    textcolor(NPC_TEXT_COLOR_FEMALE)
    if(flag(FLAG_TEMP_1)) {
        msgbox("Oh, wasn't there a POKéMON over\nthere helping us move in?\pI wonder what happened to it.\n", MSGBOX_NPC)
    } else {
	    msgbox("Hello.\nAre you a visitor?\pMy family recently moved here.\nMy SON should be arriving shortly.\lHis FATHER is the GYM LEADER, see.\pI hope his trip went safely…\n", MSGBOX_NPC)
    }
}

script BrendanMay_ImposterOak {
    lock
    msgbox("Something about this tree in\nparticular feels… off.", MSGBOX_DEFAULT)
    playmoncry(SPECIES_SUDOWOODO, CRY_MODE_NORMAL)
    waitmoncry
    release
}