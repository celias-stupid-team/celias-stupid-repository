raw `



Route18_OnTransitionCyclingRoad::
	setflag FLAG_SYS_ON_CYCLING_ROAD
	return

Route18_OnWarp::
	map_script_2 VAR_MAP_SCENE_ROUTE16, 1, Route18_OnWarpCyclingRoad
	.2byte 0



Route18_EventScript_RouteSign::
	msgbox Route18_Text_RouteSign, MSGBOX_SIGN
	end

Route18_EventScript_CyclingRoadSign::
	msgbox Route18_Text_CyclingRoadSign, MSGBOX_SIGN
	end
`

mapscripts Route18_MapScripts {
	MAP_SCRIPT_ON_TRANSITION: Route18_OnTransition
	MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE: Route18_OnWarp
	MAP_SCRIPT_ON_LOAD {
		if(flag(FLAG_INSERTED_INSTINCT_SEAL)) {
			call(Route18_SetZapdosStatue)
		}
		
	}
}

script Route18_OnWarpCyclingRoad {
	if(checkitem(ITEM_SHINY_BIKE)) {
		setflag(FLAG_SYS_ON_SHINY_BIKE)
	}
	special(ForcePlayerOntoBike)

}

script Route18_OnTransition {
	call_if_eq(VAR_MAP_SCENE_ROUTE16, 1, Route18_OnTransitionCyclingRoad)
	if(!flag(FLAG_TRIED_SLOPE)) {
			setflag(FLAG_TEMP_5)
	}
	setbench(BENCH_FUSHCIA)
	setflag(FLAG_TEMP_4)
	if(checkitem(ITEM_MAP)) {
		clearflag(FLAG_TEMP_4)
	}
}

script Route18_TiredBiker {
	msgbox("Man!\nThis slope is something else.\pI tried to tackle it, but I'm\nfamished!\lCan't do this on an empty stomach.\pMaybe I should make myself a little\nsomething to eat before trying again.", MSGBOX_NPC)
	end
}

const BIRD_CULTIST = 6

script Route18_BirdCultistStopsYouTrigger {
	lock
	playse(SE_PIN)
	applymovement(BIRD_CULTIST, Common_Movement_ExclamationMark)
	delay(60)
	textcolor(NPC_TEXT_COLOR_MALE)
	msgbox("Halt there!\n", MSGBOX_DEFAULT)
	closemessage
	applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
	msgbox("That way goes to a sacred site of\nthe BIRD CULTISTS.\lDo not test us!\pIf you wish to proceed, you must\nearn the trust of our PRIEST.", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	applymovement(LOCALID_PLAYER, Common_Movement_WalkLeft)
	waitmovement(0)
	release
}


script Route18_BeachBoy {
	msgbox("Huh?\nA bird cult ceremony?\pNah, man.\nEddie's my uncle.\lHe lets me through for free!", MSGBOX_NPC)
	end
}

script Route18_KrabbyTM {
	msgbox("Every so often, a peculiar TM\nwill wash up on the beach.\pIt's said that to use the move,\nyour POKéMON needs to be prepared\lfor the final evolutionary step.\pI wonder if I'll ever truly\nsee what that means…", MSGBOX_NPC)
	end
}

script Route18_SheSellsSeashells {
	setflag(FLAG_SHE_SELLS_SEASHELLS)
	call(SetPlayerPokedexValues)
	famechecker(FAMECHECKER_KANTO_SHORELINE, 2)
	msgbox("SALLY: Hiya!\nI'm SALLY.\pI'm looking on the seashore for\nthings to sell.\lIt's fun!", MSGBOX_NPC)
	end
}


const BirdCultLeader = 2
script Route18_BirdCultistCeremony {
	lock
	getplayerxy(VAR_TEMP_2, VAR_TEMP_3)
	switch(var(VAR_TEMP_2)) {
		case 36:
			applymovement(BirdCultLeader, BirdCult_Left)
		case 37:
			applymovement(BirdCultLeader, BirdCult_Mid)
		default:
			applymovement(BirdCultLeader, BirdCult_Right)
	}
	waitmovement(0)
	textcolor(NPC_TEXT_COLOR_MALE)
	msgbox("birds idk\n", MSGBOX_DEFAULT)
	setvar(VAR_CSR_BIRD_CULTISTS_TRUST_YOU, 1)
	applymovement(BirdCultLeader, BirdCult_WalkAway)
	waitmovement(0)
	release

}

script Route18_BirdCultistLeader {
	msgbox("I like birds\n", MSGBOX_NPC)
	end
}

movement BirdCult_Left {
	walk_down
	face_down
}
movement BirdCult_Mid {
	walk_down
	walk_right
	face_down
}
movement BirdCult_Right {
	walk_down
	walk_right * 2
	face_down
}

movement BirdCult_WalkAway {
	walk_left
	face_right
}

script Route18_InstinctSealPedestal {
	lock
	if(flag(FLAG_INSERTED_INSTINCT_SEAL)) {
		msgbox("The INSTINCT SEAL has been\ninserted.", MSGBOX_DEFAULT)
	} else {
		msgbox("The pedestal is engraved with\nthe number two.", MSGBOX_DEFAULT)
		if(checkitem(ITEM_INSTINCT_SEAL)) {
			msgbox("Would you like to insert the\nINSTINCT SEAL?", MSGBOX_YESNO)
			if(var(VAR_RESULT)) {
				setflag(FLAG_INSERTED_INSTINCT_SEAL)
				removeitem(ITEM_INSTINCT_SEAL)
				msgbox("{PLAYER} inserted the\nINSTINCT SEAL…", MSGBOX_DEFAULT)
				closemessage
				fadeoutbgm(1)
				playse(SE_SWITCH)
				delay(30)
				playse(SE_M_EARTHQUAKE)
				setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 3)
				setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 3)
				setvar(VAR_SHAKESCREEN_NUM_SHAKES, 30)
				setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
				special(ShakeScreen)
				waitse
				delay(20)
				call(Route18_SetZapdosStatue)
				special(DrawWholeMapView)
				playmoncry(SPECIES_ZAPDOS, CRY_MODE_NORMAL)
				fadeinbgm(1)
				waitmoncry
			}
		}
	}
	release
}

script Route18_SetZapdosStatue {
	setmetatile(25, 14, METATILE_Route18_SkyPillar_ZAPDOS_TOP_LEFT, TRUE)
	setmetatile(26, 14, METATILE_Route18_SkyPillar_ZAPDOS_TOP_MIDDLE, TRUE)
	setmetatile(27, 14, METATILE_Route18_SkyPillar_ZAPDOS_TOP_RIGHT, TRUE)
	
	setmetatile(25, 15, METATILE_Route18_SkyPillar_ZAPDOS_MIDDLE_LEFT, TRUE)
	setmetatile(26, 15, METATILE_Route18_SkyPillar_ZAPDOS_MIDDLE_MIDDLE, TRUE)
	setmetatile(27, 15, METATILE_Route18_SkyPillar_ZAPDOS_MIDDLE_RIGHT, TRUE)
	
	setmetatile(25, 16, METATILE_Route18_SkyPillar_ZAPDOS_BOTTOM_LEFT, TRUE)
	setmetatile(26, 16, METATILE_Route18_SkyPillar_ZAPDOS_BOTTOM_MIDDLE, TRUE)
	setmetatile(27, 16, METATILE_Route18_SkyPillar_ZAPDOS_BOTTOM_RIGHT, TRUE)
	return
}

script Route18_FloatyRockKid {
	lock
	faceplayer
	if(flag(FLAG_GOT_FLOAT_STONE)) {
		msgbox("Oh…\nYou took the cool floaty rock?\l{PAUSE 30}Yeah, understandable.", MSGBOX_DEFAULT)
	} else {
		msgbox("Ooooh…\pLook at this cool floaty\nrock!", MSGBOX_DEFAULT)
	}
	applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
	end
}

script Route18_BirdCultistLeft {
	msgbox("Glory to the Wing!\nPraise to the Talon!\pMay we soar forevermore above the\nplains of despair!", MSGBOX_NPC)
	end
}

script Route18_BirdCultistRight {
	msgbox("We are the BIRD CULTISTS.\nOur herald has been called!\pIn the presence of the FLOAT STONE\nwe are given peace and power.", MSGBOX_NPC)
	end
}


script Route18_BirdCultistBottom {
	famechecker(FAMECHECKER_KANTO_SHORELINE, 4)
	textcolor(NPC_TEXT_COLOR_MALE)
	msgbox("Have you come to pray at the\naltar of the LIGHTNING ARCHBIRD?\pThey say that one who encounters\nall three is holy and blessed.\lFor the GLORY of the SKIES!\pI pray calm for you, o traveler.\n", MSGBOX_NPC)
	end
}


script Route18_FindShellder {
	lock
	if(flag(FLAG_TEMP_2)) {
		msgbox(
		"I wonder how much these\n"
		"sell for…", MSGBOX_DEFAULT)
		release
	}
	setmetatile(35, 22, 0x115, FALSE)
	special(DrawWholeMapView)
	setvar(VAR_CSR_GIFT_POKEMON, SPECIES_SHELLDER)
	playfanfare(MUS_LEVEL_UP)
	msgbox("{PLAYER} picked up a SHELLDER!\n", MSGBOX_DEFAULT)
	waitfanfare
	call(Common_Script_GiftPokemon)
	setflag(FLAG_TEMP_2)
	release
}


script Route18_Treasure {
	lock
	msgbox(
	"This is it!\n"
	"X marks the spot!\l"
	"It's buried treasure!", MSGBOX_DEFAULT)
	if(checkpartymove(MOVE_DIG) == PARTY_SIZE && checkpartymove(MOVE_DIG_CANCEL) == PARTY_SIZE) {
		msgbox(
		"But… it's underground.\n"
		"You need a way to DIG it up.", MSGBOX_DEFAULT)
		release
		end
	}
	fadescreenswapbuffers(FADE_TO_BLACK)
	removeobject(VAR_LAST_TALKED)
	playse(SE_M_DIG)
	waitse
	closemessage
	delay(10)
	playse(SE_M_DIG)
	waitse
	delay(10)
	playse(SE_M_DIG)
	waitse
	delay(10)
	fadescreenswapbuffers(FADE_FROM_BLACK)
	showmoneybox(0,0)
	msgbox(
	"Wow!\n"
	"Inside the treasure chest…\p"

	"Were two GOLD doubloons!\n"
	"", MSGBOX_DEFAULT)
	playse(SE_SHOP)
	removeitem(ITEM_MAP)
	addmoney(2)
	updatemoneybox
	waitse
	delay(30)
	closemessage
	hidemoneybox
	delay(60)
	msgbox(
	"…And you decide to keep the\n"
	"X itself as a treat!", MSGBOX_DEFAULT)
	setflag(FLAG_SHINY_CREATION)
	setvar(VAR_CSR_GIFT_POKEMON, SPECIES_PORYGON_Z)
	call(Common_Script_GiftPokemon30)
	release
	end
}