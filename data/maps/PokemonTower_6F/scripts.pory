script PokemonTower_6F_WorriedAboutCuboneMom {
	lock
	faceplayer
	if(flag(FLAG_GOT_MATH_CLUB)) {
		msgbox("CUBONE's MOTHER was a lovely\nvolunteer at the school.\lShe'd come in if MR. FUJI got sick.\pI'd be distraught if anything\nhappened to her.", MSGBOX_DEFAULT)
	} else {
		msgbox("CUBONE was one of my students after\nschool.\lI ran the extra-curriculars, see.\pThis one was always his favorite.\nYou should take it.", MSGBOX_DEFAULT)
		setflag(FLAG_GOT_MATH_CLUB)
		waitse
		closemessage
		giveitem_msg("{PLAYER} recieved the MATH CLUB.\n", ITEM_MATH_CLUB, 1, FANFARE_LEVEL_UP)
		msgbox("CUBONE's MOTHER was a lovely\nvolunteer at the school.\lShe'd come in if MR. FUJI got sick.\pI'd be distraught if anything\nhappened to her.", MSGBOX_DEFAULT)
	}
	release
}

script PokemonTower_6F_Fuji {
	end
}

script PokemonTower_6F_SpellingKid {
	trainerbattle_single(TRAINER_CHANNELER_JENNIFER, PokemonTower_6F_Text_JenniferIntro, PokemonTower_6F_Text_JenniferDefeat)
	
}

script PokemonTower_6F_MoveTutor {
	lockall
	faceplayer
	if(!flag(FLAG_TEMP_1)) {
			msgbox("MR. FUJI: Oh, goodness…\nMy name is MR. FUJI.\lI am the schoolteacher here.\pThose miserable DMCA are waiting\nupstairs.\lThey've taken CUBONE'S MOTHER.\pShe was always supportive of the\nstories our students would write.\p…Oh?\nYou're planning to help her?\pAll right.\nEven now, I'm still a TEACHER.\lI'll help your POKéMON learn moves.", MSGBOX_DEFAULT)
			setflag(FLAG_TEMP_1)
	} else {
		msgbox("MR. FUJI: CUBONE's MOTHER has\nbeen taken away by the DMCA.\lEven still, I'll help you.", MSGBOX_DEFAULT)
	}
	msgbox("Would you like me to help your\nPOKéMON learn a MOVE?", MSGBOX_YESNO)
	if(var(VAR_RESULT)) {
			msgbox(TwoIsland_House_Text_TutorWhichMon)
			special(ChooseMonForMoveRelearner)
			waitstate
			goto_if_ge(VAR_0x8004, PARTY_SIZE, TwoIsland_House_EventScript_EndTutorMove)
			special(IsSelectedMonEgg)
			goto_if_eq(VAR_RESULT, TRUE, TwoIsland_House_EventScript_CantTutorEgg)
			goto_if_eq(VAR_0x8005, 0, "MR. FUJI: This POKéMON doesn't\nhave any MOVES it can learn.")
			goto(TwoIsland_House_EventScript_ChooseMoveToTeach)

				msgbox(TwoIsland_House_Text_TeachWhichMove)
				special(TeachMoveRelearnerMove)
				waitstate
				goto_if_eq(VAR_0x8004, 0, TwoIsland_House_EventScript_ChooseMonToTutor)
				call(EventScript_RestorePrevTextColor)
				msgbox("Come back here if you'd like\nto teach your POKéMON a MOVE.", MSGBOX_DEFAULT)
				release
				end


	} else {
			msgbox("Come back here if you'd like\nto teach your POKéMON a move.", MSGBOX_DEFAULT)
	}
	releaseall
	end
}

script PokemonTower_6F_Cubone {
	lock
	faceplayer
	playmoncry(SPECIES_CUBONE, CRY_MODE_DEFAULT)
	msgbox("CUBONE: Cu-Curraa!\n", MSGBOX_DEFAULT)
	waitmoncry
	closemessage
	delay(10)
	msgbox("He's worried for his MOTHER.\n", MSGBOX_DEFAULT)
	release
}


script PokemonTower_6F_SpellingTrainer {
	trainerbattle_single(TRAINER_SCHOOL_KID_SAMMY, "Wow!\nI aced my math test!\pI spent all weak studying nothing\nbut math, but it sure payed off!", "Hay!\nThat hurt!")
	msgbox("I was never very good at langage\narts.\lWriting class is the hardest!\pI hope CUBONE'S MOM can come in\nto help learn me…", MSGBOX_NPC)
}

script PokemonTower_6F_Savestate {
	msgbox("TRAINER TIPS!\pRemember to savestate frequently!\n", MSGBOX_SIGN)
	end
}



