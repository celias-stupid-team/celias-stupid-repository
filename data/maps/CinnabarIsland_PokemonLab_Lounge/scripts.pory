raw `


CinnabarIsland_PokemonLab_Lounge_EventScript_Scientist::
	msgbox CinnabarIsland_PokemonLab_Lounge_Text_FoundFossilInMtMoon, MSGBOX_NPC
	end

CinnabarIsland_PokemonLab_Lounge_EventScript_Clifton::
	lock
	faceplayer
	setflag FLAG_CSR_TALKED_TO_MINDY
	setvar VAR_0x8008, INGAME_TRADE_HAUNTER
	call EventScript_GetInGameTradeSpeciesInfo
	goto_if_set FLAG_DID_ESPHERE_TRADE, CinnabarIsland_PokemonLab_Lounge_EventScript_CliftonAlreadyTraded
	msgbox Trade_Text_DoYouHaveMonWouldYouTradeForMon, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, CinnabarIsland_PokemonLab_Lounge_EventScript_CliftonDeclineTrade
	call EventScript_ChooseMonForInGameTrade
	goto_if_ge VAR_0x8004, PARTY_SIZE, CinnabarIsland_PokemonLab_Lounge_EventScript_CliftonDeclineTrade
	call EventScript_GetInGameTradeSpecies
	goto_if_ne VAR_RESULT, VAR_0x8009, CinnabarIsland_PokemonLab_Lounge_EventScript_CliftonNotRequestedMon
	call EventScript_DoInGameTrade
	msgbox Trade_Text_Thanks
	setflag FLAG_DID_ESPHERE_TRADE
	release
	end

CinnabarIsland_PokemonLab_Lounge_EventScript_CliftonDeclineTrade::
	msgbox Trade_Text_WellIfYouDontWantTo
	release
	end

CinnabarIsland_PokemonLab_Lounge_EventScript_CliftonNotRequestedMon::
	bufferspeciesname STR_VAR_1, VAR_0x8009
	msgbox Trade_Text_ThisIsntMon
	release
	end

CinnabarIsland_PokemonLab_Lounge_EventScript_CliftonAlreadyTraded::
	msgbox Trade_Text_HasTradedMonGrownStronger
	release
	end


CinnabarIsland_PokemonLab_Lounge_EventScript_NormaDeclineTrade::
	msgbox Trade_Text_ThatsTooBad
	release
	end

CinnabarIsland_PokemonLab_Lounge_EventScript_NormaNotRequestedMon::
	bufferspeciesname STR_VAR_1, VAR_0x8009
	msgbox Trade_Text_ThisIsNoMon
	release
	end

CinnabarIsland_PokemonLab_Lounge_EventScript_NormaAlreadyTraded::
	msgbox Trade_Text_HowIsMyOldMon
	release
	end
`

mapscripts CinnabarIsland_PokemonLab_Lounge_MapScripts {
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_USED_ROCK_SMASH, 1 {
			if(flag(FLAG_CELIA_SECRET_CINNABAR)) {
				setvar(VAR_USED_ROCK_SMASH, 0)
				release
				end
			}
			setflag(FLAG_CELIA_SECRET_CINNABAR)
			msgbox(
			"Celia comes in\n"
			"does some stuff", MSGBOX_DEFAULT)
			setvar(VAR_CSR_CURRENT_CELIA_SECRET, CELIA_SECRET_CINNABAR)
			call(CeliaSecrets_CeliaTellsYouNextHint)
			msgbox(
			"Celia leaves\n"
			"", MSGBOX_DEFAULT)


		}
	]
}

script CinnabarIslandLab_Shelgon {
	lock
	playmoncry(SPECIES_SHELGON, CRY_MODE_DEFAULT)
	waitmoncry
	delay(10)
	playse(SE_PIN)
	applymovement(LOCALID_SHELGON, Common_Movement_ExclamationMark)
	waitmovement(0)
	delay(60)
	applymovement(LOCALID_SHELGON, moves(
		face_left
		delay_2
		face_up
	))
	delay(90)
	applymovement(LOCALID_SHELGON, Common_Movement_QuestionMark)
	waitmovement(0)
	delay(45)
	msgbox(
	"…\n"
	"", MSGBOX_DEFAULT)
	closemessage
	delay(20)
	applymovement(LOCALID_SHELGON, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
}

script CinnabarIslandLab_StevenStone {
	lock
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"Hello, there!\n"
	"My name is STEVEN STONE.\p"

	"It's a pleasure to meet you.\n"
	"", MSGBOX_DEFAULT)
	if(checkitem(ITEM_LETTER_W)) {
		msgbox(
		"STEVEN: Ah, a letter for me?\p"

		"something something\p"

		"Take this\n"
		"", MSGBOX_DEFAULT)
		closemessage
		removeitem(ITEM_LETTER_W)
		giveitem_msg("{PLAYER} received the\n"
		"TM29!", ITEM_TM38, 1, MUS_LEVEL_UP)
		waitfanfare
		closemessage
		msgbox(
		"STEVEN: That is STEEL WING.\n"
		"", MSGBOX_DEFAULT)
		setvar(VAR_TRADING_QUEST_PHASE, 2)
	}
	release
}


script CinnabarIslandLab_AmberTree {
	famechecker(FAMECHECKER_GREAT_SEA_WEST, 2)
	msgbox(
	"Have you heard of OLD AMBER?\n"
	"PEWTER MUSEUM has some.\p"

	"It's made of the same sap our\n"
	"ancient ancestors once had.\p"

	"In the next room over, they're\n"
	"researching it.\l"
	"No one's allowed in, though.", MSGBOX_NPC)
}


script CinnabarIslandLab_FujiPainting {
	msgbox(
	"Hey!\n"
	"That's a funny-lookin' tree!", MSGBOX_SIGN)

}

