mapscripts ViridianGym_HubRoom_MapScripts {
    
}


script ViridianGym_HintManSwitch {
    lock
    textcolor(NPC_TEXT_COLOR_BLUE)
    msgbox(
	"HINT MAN: {PLAYER}!\n"
	"What are you doing out here?\p"

	"It looks like you weren't ready\n"
	"for that fight.\l"
	"Would you like to have a hint?", MSGBOX_YESNO)
    if(var(VAR_RESULT)) {
        switch(var(VAR_CURRENT_DMCA_PHASE)){
            case 0:
                msgbox(
                "I think you should try stepping\n"
                "on the warp panel.", MSGBOX_DEFAULT)
            case 1:
                msgbox(
                "That warp tile sent you ten\n"
                "thousand light years away!\p"

                "Have you been to an area that looks\n"
                "like that before?\p"

                "If not, maybe AETHER PARADISE has\n"
                "something you need…", MSGBOX_DEFAULT)
            case 2:
                msgbox(
                "Legends speak of a POKéMON so\n"
                "powerful, it had to be Sealed away.\p"

                "Perhaps if you could Break the\n"
                "Seal, you'd be able to get through!", MSGBOX_DEFAULT)
            case 3:
                msgbox(
                "Did you ever talk to the PHISHING\n"
                "GURU in VERMILION CITY?\l"
                "He'll give you something neat!\p"

                "Only thing is, I hear it might be\n"
                "infected with a virus…", MSGBOX_DEFAULT)
            case 4:
                msgbox(
                "Have you traveled up the waterfall\n"
                "on TWO ISLAND?\l"
                "There's a lone house up there.\p"

                "I hear the owner can teach your\n"
                "POKéMON some very special moves.", MSGBOX_DEFAULT)
            case 5:
                msgbox(
                "Hey!\n"
                "That's my brother in there!\p"

                "Uh, I mean…\n"
                "Yes, quite a formidable foe.\p"

                "That SNOVER is especially irksome.\n"
                "Maybe you could block him in?", MSGBOX_DEFAULT)
            case 6:
                msgbox(
                "There's a milk farm on THIRTY EIGHT\n"
                "ISLAND you should check out.\p"

                "If you get something from them,\n"
                "there may be a way to churn it.", MSGBOX_DEFAULT)
            case 7:
                msgbox(
                "You were right!\n"
                "", MSGBOX_DEFAULT)
            case 8:
                msgbox(
                "Think back to everything you've\n"
                "seen in the GREAT SEA.\l"
                "Put all the pieces together.\p"

                "You're looking for an undeniable\n"
                "violation of copyright.\p"

                "Incidentally, have you visited\n"
                "CERULEAN CAVE yet?", MSGBOX_DEFAULT)
            case 9:
                msgbox(
                "I don't think I'm supposed to be\n"
                "in this room.", MSGBOX_DEFAULT)
        }
        msgbox(
        "Well, never mind that.\n"
        "Why don't you take a rest?", MSGBOX_DEFAULT)
        fadescreenswapbuffers(FADE_TO_BLACK)
        closemessage
        playfanfare(MUS_HEAL)
        waitfanfare
        special(HealPlayerParty)
        fadescreenswapbuffers(FADE_FROM_BLACK)
        msgbox(("HINT MAN: There!\nBest of luck to you!"), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(
	"Okay, then never mind that.\n"
	"Why don't you take a rest?", MSGBOX_DEFAULT)
	fadescreenswapbuffers(FADE_TO_BLACK)
	closemessage
	playfanfare(MUS_HEAL)
	waitfanfare
	special(HealPlayerParty)
	fadescreenswapbuffers(FADE_FROM_BLACK)
	msgbox(("HINT MAN: There!\nBest of luck to you!"), MSGBOX_DEFAULT)
	release
	end

}
