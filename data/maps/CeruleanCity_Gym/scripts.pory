raw `
CeruleanCity_Gym_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION CeruleanClub_MapScripts
	.byte 0

CeruleanCity_Gym_EventScript_Misty::

	famechecker FAMECHECKER_CERULEAN, FCPICKSTATE_COLORED, UpdatePickStateFromSpecialVar8005
	trainerbattle_single TRAINER_LEADER_MISTY, CeruleanCity_Gym_Text_MistyIntro, CeruleanCity_Gym_Text_MistyDefeat, CeruleanCity_Gym_EventScript_MistyDefeated, NO_MUSIC
	msgbox CeruleanCity_Gym_Text_ExplainTM03
	release
	end

CeruleanCity_Gym_EventScript_MistyDefeated::
	setflag FLAG_DEFEATED_MISTY
	setflag FLAG_BADGE02_GET
	setrespawn SPAWN_CERULEAN_CITY
	set_gym_trainers 2
	goto CeruleanCity_Gym_EventScript_GiveTM03
	end



CeruleanCity_Gym_EventScript_NoRoomForTM03::
	msgbox CeruleanCity_Gym_Text_BetterMakeRoomForThis
	release
	end

CeruleanCity_Gym_EventScript_Diana::
	trainerbattle_single TRAINER_PICNICKER_DIANA, CeruleanCity_Gym_Text_DianaIntro, CeruleanCity_Gym_Text_DianaDefeat
	msgbox CeruleanCity_Gym_Text_DianaPostBattle, MSGBOX_AUTOCLOSE
	end

CeruleanCity_Gym_EventScript_Luis::
	trainerbattle_single TRAINER_SWIMMER_MALE_LUIS, CeruleanCity_Gym_Text_LuisIntro, CeruleanCity_Gym_Text_LuisDefeat
	msgbox CeruleanCity_Gym_Text_LuisPostBattle, MSGBOX_AUTOCLOSE
	end

CeruleanCity_Gym_EventScript_GymGuy::
	lock
	faceplayer
	goto_if_set FLAG_DEFEATED_MISTY, CeruleanCity_Gym_EventScript_GymGuyPostVictory
	msgbox CeruleanCity_Gym_Text_GymGuyAdvice
	release
	end

CeruleanCity_Gym_EventScript_GymGuyPostVictory::
	msgbox CeruleanCity_Gym_Text_WeMakePrettyGoodTeam
	release
	end

CeruleanCity_Gym_EventScript_GymStatue::
	lockall
	goto_if_set FLAG_BADGE02_GET, CeruleanCity_Gym_EventScript_GymStatuePostVictory
	msgbox CeruleanCity_Gym_Text_GymStatue
	releaseall
	end

CeruleanCity_Gym_EventScript_GymStatuePostVictory::
	msgbox CeruleanCity_Gym_Text_GymStatuePlayerWon
	releaseall
	end
`
script CeruleanClub_MapScripts {
	setbench(BENCH_CERULEAN_CLUB)
	setflag(FLAG_CSR_MAP_CERULEAN_GYM)
	call(SetPlayerPokedexValues)
}

script CeruleanClub_UpdateBench {
	setbench(BENCH_CERULEAN)
	setvar(VAR_TEMP_1, 1)
	release
}


script CeruleanCity_Gym_EventScript_GiveTM03 {
	msgbox(CeruleanCity_Gym_Text_ExplainCascadeBadge)
	checkitemspace(ITEM_TM18)
	goto_if_eq(VAR_RESULT, FALSE, CeruleanCity_Gym_EventScript_NoRoomForTM03)
	giveitem_msg(CeruleanCity_Gym_Text_ReceivedTM03FromMisty, ITEM_TM18)
	setflag(FLAG_GOT_TM03_FROM_MISTY)
	msgbox(CeruleanCity_Gym_Text_ExplainTM03)
	release
}


script CeruleanCity_Gym_EventScript_PsychicTrainer {
	trainerbattle_single(TRAINER_CERULEAN_CLUB_PSYCHIC, CeruleanCity_Gym_Text_PsychicTrainerIntro, CeruleanCity_Gym_Text_PsychicTrainerDefeat)
	msgbox(("Where's MISTY?\nShe's in the back room.\pThey say she was actually banned\nfrom TCG tournaments.\lI wonder why!"), MSGBOX_DEFAULT)
	release
end
}

script CeruleanCity_Gym_EventScript_ElectricTrainer {
	trainerbattle_single(TRAINER_CERULEAN_CLUB_ELECTRIC, CeruleanCity_Gym_Text_ElectricTrainerIntro, CeruleanCity_Gym_Text_ElectricTrainerDefeat)
	msgbox(("I only have the budget to enter one\ntournament per year, so...\pMay as well make it count.\n"), MSGBOX_DEFAULT)
	release
end
}

script CeruleanCity_Gym_EventScript_FightingTrainer {
	trainerbattle_single(TRAINER_CERULEAN_CLUB_FIGHTING, CeruleanCity_Gym_Text_FightingTrainerIntro, CeruleanCity_Gym_Text_FightingTrainerDefeat)
	msgbox(("I heard that BRUNO got demoted\nfrom the ELITE FOUR.\pHow could they do something like\nthat?"), MSGBOX_DEFAULT)
	release
end
}

script CeruleanCity_Gym_EventScript_PoisonTrainer {
	trainerbattle_single(TRAINER_CERULEAN_CLUB_POISON, CeruleanCity_Gym_Text_PoisonTrainerIntro, CeruleanCity_Gym_Text_PoisonTrainerDefeat)
	msgbox(("Look, I never played the games.\pHow am I supposed to know which\nones are actually POISON?"), MSGBOX_DEFAULT)
	release
end
}

script CeruleanCity_Gym_EventScript_Imakuni {
	trainerbattle_single(TRAINER_CERULEAN_CLUB_IMAKUNI, CeruleanCity_Gym_Text_ImakuniIntro, CeruleanCity_Gym_Text_ImakuniDefeat)
	msgbox(("In both cards and dance,\nsoul and rhythm are the secret.\pHey, that sounds pretty cool!\nMaybe I'll become a poet!"), MSGBOX_DEFAULT)
	release
end
}

script CeruleanCity_Gym_EventScript_GrassTrainer {
	lock
	faceplayer
	if(!flag(FLAG_CSR_GOT_SCYTHER)) {
		msgbox("Managing your ENERGY is super\nimportant!\pThat's why CARDS with free\nRETREAT are so strong.\pHere, let me show you!\n", MSGBOX_DEFAULT)
		trainerbattle_no_intro(TRAINER_CERULEAN_CLUB_GRASS, CeruleanCity_Gym_Text_GrassTrainerDefeat)
		msgbox("Hey, that was a good game!", MSGBOX_DEFAULT)
		setflag(FLAG_CSR_GOT_SCYTHER)
		call(CeruleanCity_Gym_EventScript_GivesScyther)
	} else {
		call(CeruleanCity_Gym_EventScript_GivesScyther)
	}
	
	release
}

script CeruleanCity_Gym_EventScript_GivesScyther {
	msgbox("Here, how about you learn the\npower of RETREAT for yourself?", MSGBOX_DEFAULT)
	if(getpartysize <= 5) {
		givemon(SPECIES_SCYTHER, 18, ITEM_NONE)
		goto_if_eq(VAR_RESULT, 2, EventScript_NoMoreRoomForPokemon) //literally copying this from vanilla code don't be mad at me for magic numbers pls <3
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		playfanfare(MUS_LEVEL_UP)
		msgbox("{PLAYER} received SCYTHER from the\nTCG player!", MSGBOX_DEFAULT)
		waitfanfare
		delay(30)
		textcolor(NPC_TEXT_COLOR_MALE)
		msgbox(("That CARD is really powerful!\pPack it with HITMONCHAN and\nELECTABUZZ and you'll be set!\pAnd hey, come back to me any time\nyou want another one!\pSCYTHER actually completely fell\nout of the meta, so I don't need it."), MSGBOX_DEFAULT)
	} else {
		msgbox("Oh wait, your deck's full…\pMake some room and then come back!\n", MSGBOX_DEFAULT)
		release
		end
	}
}

script CeruleanCity_Gym_EventScript_DragonTrainer {
	msgbox("Haha!\nI'm the DRAGON-type trainer!\p...Or at least, I would be if\nDRAGON cards existed in Gen 3.", MSGBOX_NPC)
}

script CeruleanCity_Gym_EventScript_FairyTrainer {
	msgbox("FAIRY-type?\nWhat's a FAIRY-type?\pNope, there's never been a type\nlike that before!\lYou must be misremembering!", MSGBOX_NPC)
}

script CeruleanCity_Gym_EventScript_Dad {
	lock
	faceplayer
	textcolor(0)
	msgbox(("DAD: {PLAYER}!\nWhat are you doing out here?\pDidn't you know I'm actually\na star in the TCG?\lInvisible Wall is strong!\pWell, never mind that.\nHow about you take a rest?"), MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	setflag(FLAG_DAD_CERULEAN_CLUB)
	release
	end
}

script CeruleanCity_Gym_EventScript_BackSign {
	msgbox(format("Nope!\nSadly, this isn't the answer.\lGood guess, though!\pHere's a hint:\nTalk to everyone in the CLUB!\pAfter you do that, be sure to check\nyour POKéMON carefully!\pGood luck!\nI believe in you!"), MSGBOX_NPC)
	end
}

script CeruleanCity_Gym_EventScript_CeliaSecretSign {
	msgbox(format("Nope!\nThis isn't the right back room!\lGood guess, though!\pThe other one is right above us!\nIt's not too hard to get into.\lI'm waiting for you there!\pBest of luck!\n-CELIA"), MSGBOX_NPC)
	end
}
