`
script GameCorner_FindCoins {
	lock
	checkcoins(VAR_RESULT)
	if(var(VAR_RESULT) > 1) {
		playfanfare(MUS_LEVEL_UP)
		msgbox("{PLAYER} found\n9999 COINS!", MSGBOX_DEFAULT)
		waitfanfare
		closemessage
		msgbox("Too bad!\nThe COIN CASE is full!", MSGBOX_DEFAULT)
	} else {
		addcoins(9999)
		playfanfare(MUS_LEVEL_UP)
		msgbox("{PLAYER} found\n9999 COINS!", MSGBOX_DEFAULT)
		waitfanfare
		msgbox("{PLAYER} put the COINS away in\nthe COIN CASE.\lHow convenient!", MSGBOX_DEFAULT)
		
	}
	release
	end
}

script CeladonCity_GameCorner_EventScript_Gentleman {
	lock
	faceplayer
	msgbox("Want me to let you in on\na secret?\pI don't think any of these\nslot machines actually work.\pI'm pretty sure they're just\npainted over with pretty colors.", MSGBOX_DEFAULT)
	goto(CeladonCity_GameCorner_EventScript_FaceSlotMachine)
}

script CeladonCity_GameCorner_EventScript_Scientist {
	lock
	faceplayer
	msgbox("The guy at the desk isn't selling\nCOINS anymore…\pGuess you'll just have to scrounge\naround 'til you find some!", MSGBOX_DEFAULT)
	goto(CeladonCity_GameCorner_EventScript_FaceSlotMachine)
}

script CeladonCity_GameCorner_EventScript_OldMan {
	lock
	faceplayer
	msgbox("Huh?\nWhat's going on outside?\pI've been playing slots for\na week straight - I don't\lhave time to go outside!", MSGBOX_DEFAULT)
	goto(CeladonCity_GameCorner_EventScript_FaceSlotMachine)
}

script CeladonCity_GameCorner_EventScript_GymGuy {
	lock
	faceplayer
	msgbox("Huh? The GYM?\pSorry, I'm a little busy right now.\pGo do something else.\nTrade your POKéMON or whatever.", MSGBOX_DEFAULT)
	goto(CeladonCity_GameCorner_EventScript_FaceSlotMachine)
}

script CeladonCity_GameCorner_EventScript_Fisher {
	lock
	faceplayer
	msgbox("If you think about it, fishing is\njust gambling with extra steps.", MSGBOX_DEFAULT)
	goto(CeladonCity_GameCorner_EventScript_FaceSlotMachine)
}

script CeladonCity_GameCorner_EventScript_BaldingMan {
	lock
	faceplayer
	msgbox("I'm gonna be honest:\nI don't actually have a COIN CASE.\pI'm just hanging out here because\nI like the music.", MSGBOX_DEFAULT)
	goto(CeladonCity_GameCorner_EventScript_FaceSlotMachine)
}

script CeladonCity_GameCorner_EventScript_OldMan2 {
	lock
	faceplayer
	msgbox("Fact: 90% of gambling addicts\nquit right before they hit big.\pI've been at this for 80 years\nand I'm not giving up yet!", MSGBOX_DEFAULT)
	goto(CeladonCity_GameCorner_EventScript_FaceSlotMachine)
}

script CeladonCity_GameCorner_EventScript_CoinsClerk {
	msgbox("Welcome to the DMCA GAME CORNER!\pUnfortunately, all of our machines\nmysteriously malfunctioned,\land we had to remove them all.\pThankfully it appears that the\nreplacements we've put out are\lconvincing enough for our regulars!", MSGBOX_NPC)
	end
}


script CeladonCity_GameCorner_Text_DefeatedGrunt{
	msgbox(CeladonCity_GameCorner_Text_GruntPostBattle, MSGBOX_DEFAULT)
	closemessage
	call_if_eq(VAR_FACING, DIR_WEST, CeladonCity_GameCorner_Text_GruntExitWest)
	call_if_ne(VAR_FACING, DIR_WEST, CeladonCity_GameCorner_Text_GruntExit)
	setobjectxy(LOCALID_GRUNT, 9, 9)
	delay(90)
	applymovement(LOCALID_GRUNT, DMCA_Confused)
	waitmovement(0)
	delay(50)
	msgbox("Um.\pThat didn't quite work as\nplanned.", MSGBOX_DEFAULT)
	release
}

movement DMCA_Confused {
	walk_up
	walk_up
	walk_up
	walk_slower_up
	walk_slower_up
	face_up
	delay_16
	delay_16
	face_right
}

script CeladonCity_GameCorner_FancyToaster {
	msgbox("This looks like a SLOT MACHINE, but\nit's actually a very fancy toaster.", MSGBOX_SIGN)
	end
}

script CeladonCity_GameCorner_CeliaMachine {
	msgbox("CELIA: Welcome!\pI'd just like to draw your\nattention to this machine, which\lI have literally never seen\lanybody use in my life.", MSGBOX_NPC)
	end
}
