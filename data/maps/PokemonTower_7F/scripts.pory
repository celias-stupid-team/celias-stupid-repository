	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	step_end
`
mapscripts PokemonTower_7F_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setbench(BENCH_LAVENDER_TOWER)
	}
}

script PokemonTower_LeftWalkUp {
	lock
	applymovement(OBJ_EVENT_ID_PLAYER, PokemonTowerWalkUpLeft)
	waitmovement(0)
	call(PokemonTower_Trailer)
}

script PokemonTower_CenterWalkUp {
	lock
	applymovement(OBJ_EVENT_ID_PLAYER, PokemonTowerWalkUp)
	waitmovement(0)
	call(PokemonTower_Trailer)

}

script PokemonTower_RightWalkUp {
	lock
	applymovement(OBJ_EVENT_ID_PLAYER, PokemonTowerWalkUpRight)
	waitmovement(0)
	call(PokemonTower_Trailer)

}

movement PokemonTowerWalkUp {
	walk_up * 2
}
movement PokemonTowerWalkUpLeft {
	walk_up
	walk_right
	walk_up
}
movement PokemonTowerWalkUpRight {
	walk_up
	walk_left
	walk_up
}
movement PokemonTower_CameraSlowUp {
	walk_slow_up * 2
}

const ARIANA = 4
const KANGA = 1
const LEFT_GRUNT = 2
const RIGHT_GRUNT = 3
const PURE_KANGA = 5
const FUJI = 6
script PokemonTower_Trailer {
	special(SpawnCameraObject)
	setweather(WEATHER_NONE)
	applymovement(OBJ_EVENT_ID_CAMERA, PokemonTower_CameraSlowUp)
	doweather
	waitmovement(0)
	special(DrawWholeMapView)
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox("ARIANA: Oh?\nWho are you?\pYet another kid with a copyright-\nplagued story for us to take down?", MSGBOX_DEFAULT)
	closemessage
	applymovement(ARIANA, Common_Movement_FaceRight)
	delay(30)
	waitmovement(0)
	msgbox("ARIANA: …Or are you here for her?", MSGBOX_DEFAULT)
	closemessage
	applymovement(ARIANA, Common_Movement_FaceDown)
	delay(20)
	applymovement(LEFT_GRUNT, WalkInPlaceDown)
	waitmovement(0)
	textcolor(NPC_TEXT_COLOR_MALE)
	msgbox("You wanna try to help this POKéMON?\nAfter all it's done?", MSGBOX_DEFAULT)
	closemessage
	delay(20)
	applymovement(RIGHT_GRUNT, WalkInPlaceDown)
	waitmovement(0)
	msgbox("It encouraged kids to write with\ncopyrighted characters.\lKids!", MSGBOX_DEFAULT)
	closemessage
	applymovement(ARIANA, Common_Movement_WalkLeft)
	waitmovement(0)
	applymovement(ARIANA, Common_Movement_FaceDown)
	delay(20)
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox("ARIANA: It's no use trying to save\nher now.\lCUBONE's mom belongs to us!\n", MSGBOX_DEFAULT)
	closemessage
	applymovement(ARIANA, Common_Movement_FaceRight)
	waitmovement(0)
	delay(10)
	msgbox("Isn't that right?\n", MSGBOX_DEFAULT)
	closemessage
	delay(20)
	textcolor(NPC_TEXT_COLOR_MON)
	setvar(VAR_0x8004, 4)
	setvar(VAR_0x8005, 8)
	setvar(VAR_0x8006, 5)
	setvar(VAR_0x8007, 2)
	special(ShakeScreen)
	delay(30)
	playmoncry(SPECIES_KANGASKHAN, CRY_MODE_FAINT)
	msgbox("KANGASKHAN: Gaaah!\n", MSGBOX_DEFAULT)
	waitmoncry
	closemessage
	applymovement(KANGA, KangaApproaches)
	delay(16)
	setvar(VAR_0x8004, 2)
	setvar(VAR_0x8005, 4)
	setvar(VAR_0x8006, 3)
	setvar(VAR_0x8007, 3)
	special(ShakeScreen)
	delay(48)
	
	special(ShakeScreen)
	delay(48)
	
	special(ShakeScreen)
	
	applymovement(ARIANA, Common_Movement_FaceDown)
	delay(48)
	setvar(VAR_0x8006, 5)
	special(ShakeScreen)
	waitmovement(0)
	playmoncry(SPECIES_KANGASKHAN, CRY_MODE_FAINT)
	delay(45)
	msgbox("KANGASKHAN: Gah! Gah!\n", MSGBOX_DEFAULT)
	waitmoncry
	closemessage
	delay(10)
	msgbox("The KANGASKHAN's heart has a\nSHADOW AURA!", MSGBOX_DEFAULT)
	closemessage
	
	setvar(VAR_0x8006, 10)
	special(ShakeScreen)
	delay(60)
	playmoncry(SPECIES_KANGASKHAN, CRY_MODE_FAINT)
	msgbox("KANGASKHAN: Graaaah!\n", MSGBOX_DEFAULT)
	closemessage
	delay(15)
	applymovement(KANGA, KangAttacks)
	applymovement(OBJ_EVENT_ID_CAMERA, KangAttacks)
	waitmovement(0)
	special(RemoveCameraObject)

	setwildbattle(SPECIES_KANGASKHANTEACHER, 30)
	playbgm(MUS_DUMMY, TRUE)
	dowildbattle
	specialvar(VAR_RESULT, GetBattleOutcome)
	switch(var(VAR_RESULT)) {
		case B_OUTCOME_WON:
			playbgm(MUS_DUMMY, TRUE)
			setvar(VAR_POKEMON_TOWER_SCENE, 1)
			delay(30)
			
			setvar(VAR_0x8004, 2)
			setvar(VAR_0x8005, 4)
			setvar(VAR_0x8006, 3)
			setvar(VAR_0x8007, 3)
			special(ShakeScreen)
			delay(20)
			playmoncry(SPECIES_KANGASKHAN, CRY_MODE_FAINT)
			msgbox("KANGASKHAN: K-khaaaa!")
			special(ShakeScreen)
			delay(20)
			setvar(VAR_0x8004, 4)
			setvar(VAR_0x8005, 8)
			setvar(VAR_SHAKESCREEN_NUM_SHAKES, 5)
			setvar(VAR_0x8007, 2)
			special(ShakeScreen)
			delay(20)
			fadescreen(FADE_TO_WHITE)
			delay(30)
			applymovement(KANGA, Common_Movement_SetInvisible)
			applymovement(PURE_KANGA, Common_Movement_SetVisible)
			playmoncry(SPECIES_KANGASKHAN, CRY_MODE_DEFAULT)
			fadescreen(FADE_FROM_WHITE)
			delay(10)
			playbgm(MUS_SEVII_ROUTE, TRUE)
			textcolor(NPC_TEXT_COLOR_FEMALE)
			msgbox("KANGASKHAN: Kan-GAAAAA!")
			closemessage
			playse(SE_PIN)
			applymovement(ARIANA, Common_Movement_ExclamationMark)
			delay(30)
			playse(SE_PIN)
			applymovement(LEFT_GRUNT, GruntsScared)
			delay(10)
			playse(SE_PIN)
			applymovement(RIGHT_GRUNT, GruntsScared)
			delay(60)
			applymovement(PURE_KANGA, Common_Movement_WalkSlowDown)
			waitmovement(0)
			applymovement(PURE_KANGA, Common_Movement_FaceUp)
			waitmovement(0)
			delay(30)
			applymovement(ARIANA, WalkInPlaceDown)
			waitmovement(0)
			msgbox("ARIANA: What? No!\nHow is this possible?", MSGBOX_DEFAULT)
			closemessage
			special(SpawnCameraObject)
			applymovement(PURE_KANGA, Common_Movement_WalkSlowUp)
			applymovement(OBJ_EVENT_ID_PLAYER, PlayerGoesUp)
			waitmovement(0)
			playmoncry(SPECIES_KANGASKHAN, CRY_MODE_DEFAULT)
			msgbox("KANGASKHAN: Krraaaaa!")
			waitmoncry
			closemessage
			applymovement(ARIANA, ArianaBackup)
			delay(10)
			applymovement(RIGHT_GRUNT, RightGruntConsiders)
			applymovement(LEFT_GRUNT, LeftGruntConsiders)
			waitmovement(0)
			msgbox("ARIANA: Grr…\nEveryone!\pWe need to RETREAT!\nLet's get out of here!", MSGBOX_DEFAULT)
			closemessage
			fadescreen(FADE_TO_BLACK)
			fadedefaultbgm
			playse(SE_WARP_OUT)
			removeobject(ARIANA)
			removeobject(LEFT_GRUNT)
			removeobject(RIGHT_GRUNT)
			applymovement(OBJ_EVENT_ID_CAMERA, Common_Movement_WalkLeft)
			waitmovement(0)
			applymovement(PURE_KANGA, Common_Movement_FaceDown)
			fadescreen(FADE_FROM_BLACK)
			delay(60)
			addobject(FUJI)
			setobjectxy(FUJI, 11, 14)
			playse(SE_EXIT)
			applymovement(FUJI, FujiEnters)
			applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceDown)
			waitmovement(0)
			textcolor(NPC_TEXT_COLOR_MALE)
			msgbox("MR. FUJI: Ah, my dear\nKANGASKHAN!\lYou're finally safe.", MSGBOX_DEFAULT)
			closemessage
			applymovement(FUJI, FujiGoesToYou)
			waitmovement(0)
			applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
			msgbox("And you, there.\n{PLAYER}, was it?\pThank you, {PLAYER}.\nYou've done a great deed.\pBut I must ask:\nHow were you able to save her?", MSGBOX_DEFAULT)
			closemessage
			textcolor(NPC_TEXT_COLOR_MON)
			msgbox("… … … … …\n … … … … …")
			closemessage
			textcolor(NPC_TEXT_COLOR_MALE)
			msgbox("…Ah.\nI understand.\pIt was the PARENTAL BOND between\nher and CUBONE that called to her.\lThat must've kept her safe.\pCome, this is no place to have\nconversation.\lLet's return to the SCHOOL.", MSGBOX_DEFAULT)
			closemessage
			special(QuestLog_CutRecording)
			special(RemoveCameraObject)
			setflag(FLAG_HIDE_DMCA_IN_LAVENDER)
			clearflag(FLAG_HIDE_POKEHOUSE_FUJI)
			setflag(FLAG_RESCUED_CUBONES_MOM)
			closemessage
			warp(MAP_LAVENDER_TOWN_VOLUNTEER_POKEMON_HOUSE, 4, 7)
			waitstate
			release
			end

		case B_OUTCOME_RAN:
		case B_OUTCOME_PLAYER_TELEPORTED:
			break
	}
	release
}

movement FujiGoesToYou {
	walk_up
	face_left
}

movement KangaApproaches {
	walk_slow_down
	delay_16
	delay_16
	walk_slow_down
	delay_16
	delay_16
	walk_slow_left
	delay_16
	delay_16
	face_down
}

movement KangAttacks {
	walk_fast_down
	face_down
}

movement WalkInPlaceDown {
	walk_in_place_down * 2
	face_down
}

movement ArianaScared {
	face_left
	delay_16 * 2
	face_right
	delay_16 * 2
	face_down
}
movement PlayerGoesUp {
	walk_left
	walk_up
	face_up
}

movement FujiEnters {
	face_up
	set_visible
	walk_up * 4
}

movement GruntsScared {
	emote_exclamation_mark
	delay_16
	lock_facing_direction
	walk_slow_up
	face_down
	unlock_facing_direction
}
movement ArianaBackup {
	lock_facing_direction
	walk_up
	face_down
	unlock_facing_direction
}

movement RightGruntConsiders {
	face_left
	delay_16
	face_up
}
movement LeftGruntConsiders {
	face_right
	delay_16
	face_up
}