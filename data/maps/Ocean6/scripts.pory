mapscripts Ocean6_MapScripts {

}

script GreatSea_UndyedBlue {
	msgbox(
	"The water is an ugly gray.\p"

	"Looks like the deep blue dye\n"
	"hasn't quite made it over!", MSGBOX_SIGN)

}


script GreatSea_StrandedMan {
	msgbox(
	"Wha-\n"
	"Wazzat?\p"

	"Another person?\n"
	"Here?\p"

	"No…\n"
	"No, it's just my imagination.\p"

	"After I blink, it'll be gone again.\n"
	"", MSGBOX_NPC)
}


script GreatSea_PitIslandSign {
	msgbox(
	"PIT ISLAND\n"
	"", MSGBOX_SIGN)

}
