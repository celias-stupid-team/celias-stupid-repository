mapscripts PalletTown_WestField_MapScripts {
    
}


script WestField_LookGirlLass {
	    lock
		msgbox(format("Hmm...\nIs that right..."), MSGBOX_DEFAULT)
		applymovement(VAR_LAST_TALKED, Common_Movement_FacePlayer)
		waitmovement(0)
		playse(SE_PIN)
		applymovement(VAR_LAST_TALKED, DT_exclmark)
		waitmovement(0)
		delay(48)
		msgbox(format("Oh!\nLook, look!"), MSGBOX_DEFAULT)
		closemessage
		switch(var(VAR_FACING)) {
			case DIR_EAST:
					applymovement(VAR_LAST_TALKED, DT_walkbackRight)
					waitmovement(0)
					break
				default:
					applymovement(VAR_LAST_TALKED, DT_walkbackLeft)
					waitmovement(0)
					break
        }
        if(!flag(FLAG_LOOK_GIRL_LASS)) {
            delay(30)
            applymovement(LOCALID_LASS, Common_Movement_ExclamationMark)
            playbgm(MUS_ENCOUNTER_GIRL, TRUE)
            waitmovement(0)
            delay(45)
            applymovement(LOCALID_LASS, WestField_LassWalkDown)
            waitmovement(0)
            msgbox("Hey!\n", MSGBOX_DEFAULT)
            closemessage
            playbgm(MUS_PALLET, TRUE)
            //battle
            trainerbattle_no_intro(TRAINER_LASS_JOANA, "No way!")
            textcolor(NPC_TEXT_COLOR_FEMALE)
            msgbox("Ugh, fine.\pIf you take this, will you leave\nme alone?", MSGBOX_DEFAULT)
            playfanfare(MUS_LEVEL_UP)
            textcolor(NPC_TEXT_COLOR_NEUTRAL)
            msgbox("{PLAYER} obtained the DODUO\nfrom the LASS!", MSGBOX_DEFAULT)
            waitfanfare
            setflag(FLAG_SHINY_CREATION) // Doduo
            setvar(VAR_CSR_GIFT_POKEMON, SPECIES_DODUO)
            call(Common_Script_GiftPokemon)
            msgbox("This POKéMON is the worst.\pCompared to everyone else, it\nlooks at me twice as hard!", MSGBOX_DEFAULT)
            closemessage
            fadescreenswapbuffers(FADE_TO_BLACK)
            setflag(FLAG_LOOK_GIRL_LASS)
            removeobject(LOCALID_LASS)
            playse(SE_FLEE)
            fadescreenswapbuffers(FADE_FROM_BLACK)

        }
    copyobjectxytoperm(VAR_LAST_TALKED)
	release
}

movement WestField_LassWalkDown {
    walk_down * 3
    face_down
}



# Deleted
script PalletTown_WestField_Looker {
    lock
    faceplayer
    fadenewbgm(MUS_LOOKER_THEME)
    playse(SE_PIN)
    applymovement(VAR_LAST_TALKED, Common_Movement_ExclamationMark)
    delay(60)
    msgbox("LOOKER: Gah!\nA civilian's found my camp?\pThis isn't good…\nOur mission has been compromised.\lUnless…", MSGBOX_DEFAULT)
    fadedefaultbgm
    release
    end
}

script PalletTown_WestField_LookerTent {
	msgbox("A small research tent has been\nhaphazardly set up.\pIt's not much of a looker.\n", MSGBOX_SIGN)
	end
}