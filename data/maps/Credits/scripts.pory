mapscripts Credits_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_0, 0 {
            setvar(VAR_TEMP_0, 1)
            lock
            setlayouttiles(LAYOUT_CREDITS_FRAME2, 0, 0, 0, 0, 14, 10)
            special(DrawWholeMapView)
            delay(50)
            setlayouttiles(LAYOUT_CREDITS_FRAME3, 0, 0, 0, 0, 14, 10)
            special(DrawWholeMapView)
            delay(45)
            setlayouttiles(LAYOUT_CREDITS_FRAME4, 0, 0, 0, 0, 14, 10)
            special(DrawWholeMapView)
            delay(20)
            setlayouttiles(LAYOUT_CREDITS_FRAME5, 0, 0, 0, 0, 14, 10)
            special(DrawWholeMapView)
            delay(20)
            setlayouttiles(LAYOUT_CREDITS_FRAME6, 0, 0, 0, 0, 14, 10)
            special(DrawWholeMapView)
            delay(20)
            setlayouttiles(LAYOUT_CREDITS_Frame1, 0, 0, 0, 0, 14, 10)
            special(DrawWholeMapView)
            if(flag(FLAG_CREDITS_FAKEOUT)) { 
                playbgm(MUS_DUMMY, TRUE)
                msgbox(
                "(jk)\n"
                "", MSGBOX_DEFAULT)
                clearflag(FLAG_CREDITS_FAKEOUT)
                setvar(VAR_MAP_SCENE_ROUTE24, 1)
                setflag(FLAG_CSR_MAP_ROUTE_24_FAR)
                call(SetPlayerPokedexValues)
                warpsilent(MAP_CERULEAN_CITY, 3)
                release
                end
            }
            delay(30)
            applymovement(LOCALID_CREDITS_CELIA, moves(
                walk_down * 4
                face_down
                delay_16 * 6
                walk_left * 3
                jump_2_left
            ))
            delay(30)
            message(
            "            Celia Dawn{PAUSE 30}\n"
            "           Creative Lead")
            waitmovement(LOCALID_CREDITS_CELIA)
            applymovement(LOCALID_CREDITS_CELIA, moves(
                delay_16
                walk_up
                face_down
            ))
            closemessage
            waitmovement(LOCALID_CREDITS_CELIA)
            delay(40)
            applymovement(LOCALID_CREDITS_WIZ, moves(
                walk_down * 4
                face_down
                delay_16 * 6
                walk_left * 2
                face_left
                emote_exclamation_mark
                delay_16 * 2
                face_up
                delay_16
                face_down
                delay_16
                face_up
                delay_16
                face_down
                delay_16          
            ))
            delay(60)
            message(
            "              wiz1989{PAUSE 30}\n"
            "      Code work, Battle Mechanics")
            waitmovement(LOCALID_CREDITS_WIZ)
            closemessage
            applymovement(LOCALID_CREDITS_WIZ, moves(
                walk_faster_right * 7
                jump_up
                delay_16
                face_down  

            ))
            waitmovement(LOCALID_CREDITS_WIZ)
            delay(30)
            applymovement(LOCALID_CREDITS_LICHEN, moves(
                walk_down * 4
                face_down
                delay_16 * 6
                walk_fast_right * 8
            ))
            delay(60)
            message(
	        "             lichen{PAUSE 30}\n"
	        "      Spritework and Tilesets")
            waitmovement(LOCALID_CREDITS_LICHEN)
            applymovement(LOCALID_CREDITS_LICHEN_2, moves(
                walk_fast_right * 2

            ))
            waitmovement(LOCALID_CREDITS_LICHEN_2)
            closemessage
            applymovement(LOCALID_CREDITS_LICHEN_2, moves(
                walk_fast_right * 4
                walk_fast_up
                face_down

            ))
            waitmovement(LOCALID_CREDITS_LICHEN_2)
            delay(40)
            applymovement(LOCALID_CREDITS_RAVE, moves(
                walk_down * 4
                face_down
                delay_16 * 6
                walk_up
                walk_right * 4
                face_right     
            ))
            
            delay(60)
            message(
            "             RavePossum{PAUSE 30}\n"
            "         UI and General Coding")
            waitmovement(LOCALID_CREDITS_RAVE)
            applymovement(LOCALID_CREDITS_WIZ, moves(
                face_left
                delay_16 * 3
                walk_in_place_left * 3
                delay_16 * 3
                face_down
            ))
            applymovement(LOCALID_CREDITS_RAVE, moves(
                face_right
                walk_in_place_right * 3
                delay_16
                walk_in_place_right * 3
                face_right
            ))
            waitmovement(LOCALID_CREDITS_RAVE)
            closemessage
            applymovement(LOCALID_CREDITS_RAVE, moves(
                
                delay_16
                walk_left * 2
                face_down
            ))            
            waitmovement(LOCALID_CREDITS_RAVE)
            closemessage
            applymovement(LOCALID_CREDITS_PLASTO, moves(
                walk_slowest_down * 4
                walk_slowest_right * 3
                walk_slowest_down
                walk_slowest_right * 2
                face_down
            ))
            delay(70)
            message(
            "               Plasto{PAUSE 30}\n"
            "          Story Consultation")
            delay(330)
            closemessage
            applymovement(LOCALID_CREDITS_SWI, moves(
                slide_down * 5
            ))
            waitmovement(LOCALID_CREDITS_SWI)
            delay(60)
            message(
            "             Swiwious{PAUSE 30}\n"
            "              Music")
            delay(200)
            closemessage
            delay(60)
            applymovement(LOCALID_CREDITS_STARLIGHT, moves(
                walk_down * 4
                face_down
                delay_16 * 6
                walk_left
                face_left
                delay_16
                face_right
                delay_16 * 2
                emote_question_mark
                delay_16
            ))
            delay(30)
            
            message(
            "           KaizenStarlight{PAUSE 30}\n"
            "             Map Design")
            waitmovement(LOCALID_CREDITS_STARLIGHT)
            applymovement(LOCALID_CREDITS_CELIA, moves(
                face_right
                emote_exclamation_mark
                delay_16 * 2
                walk_fast_right
                walk_fast_down
                walk_fast_right * 2
            ))
            waitmovement(LOCALID_CREDITS_CELIA)
            closemessage
            applymovement(LOCALID_CREDITS_STARLIGHT, moves(
                face_left
                delay_16 * 2
                delay_4
                walk_left
                walk_down
                face_left
                delay_16 * 2
                face_down
            ))
            applymovement(LOCALID_CREDITS_CELIA, moves(
                delay_16
                walk_down
                walk_left
                face_right
                delay_16 * 4
                walk_fast_left
                walk_fast_up * 2
                walk_fast_left
                face_down
            ))
            waitmovement(LOCALID_CREDITS_CELIA)
            delay(60)
            applymovement(LOCALID_HAKARI, moves(
                walk_down * 4

                delay_16 * 6
                walk_right * 2
                walk_down
                face_down
            ))
            message(
            "       Hakari and Blizihguh{PAUSE 30}\n"
            "       like a bunch of shit")

            waitmovement(LOCALID_HAKARI)
            delay(30)
            closemessage
            delay(20)
            applymovement(LOCALID_CREDITS_CHRIS, moves(
                walk_slow_down * 4
                delay_16 * 6

            ))
            delay(30)
            message(
            "            MasterFoF{PAUSE 30}\n"
            "        Closing the Parade!")
            waitmovement(LOCALID_CREDITS_CHRIS)
            delay(20)
            closemessage
            applymovement(LOCALID_CREDITS_CHRIS, moves(
                face_left
                delay_4
                face_up
                delay_4
                face_right
                delay_4
                face_down
                delay_4
                face_left
                delay_4
                face_up
                delay_4
                face_right
                delay_2
                face_down
                delay_2
                face_left
                delay_2
                face_up
                delay_2
                face_right
                delay_2
                jump_in_place_down

            ))
            waitmovement(LOCALID_CREDITS_CHRIS)
            delay(60)
            textcolor(NPC_TEXT_COLOR_FEMALE)
            message(
            "Indulge your inner childlike glee!\n"
            "{PAUSE 30}Unshackle yourself from irony!")
            delay(180)
            message(
            "Celia's Stupid Romhack!\n")
            delay(60)
            applymovement(LOCALID_CREDITS_CHRIS, moves(
                walk_slow_up * 5
            ))
            applymovement(LOCALID_CREDITS_STARLIGHT, moves(
                delay_16 * 3
                walk_right
                walk_up * 6
            ))
            applymovement(LOCALID_CREDITS_STARLIGHT, moves(
                delay_16 * 3
                walk_right
                walk_up * 6
            ))
            applymovement(LOCALID_HAKARI, moves(
                delay_16 * 3
                walk_left
                walk_up * 6
            ))
            applymovement(LOCALID_CREDITS_LICHEN_2, moves(
                delay_16 * 8
                walk_right
                walk_up * 6
            ))
            applymovement(LOCALID_CREDITS_RAVE, moves(
                delay_16 * 8
                walk_left
                walk_up * 6
            ))
            applymovement(LOCALID_CREDITS_SWI, moves(
                delay_16 * 5
                lock_facing_direction
                walk_right * 4
                walk_up * 6
            ))
            applymovement(LOCALID_CREDITS_PLASTO, moves(
                delay_16 * 5
                walk_slowest_left
                walk_fastest_left * 3
                walk_fastest_up * 6
            ))
            applymovement(LOCALID_CREDITS_WIZ, moves(
                delay_16 * 10
                walk_left * 4
                walk_up
                face_left
                lock_facing_direction
                jump_right
                unlock_facing_direction
                delay_16 * 3
                walk_up * 6
            ))
            applymovement(LOCALID_CREDITS_CELIA, moves(
                delay_16 * 10
                walk_slow_right * 5
                face_up
                delay_16 * 4
                walk_slow_down
                face_down
                delay_16 * 3
            ))
            //Everyone walks up
            waitmovement(LOCALID_CREDITS_CELIA)
            message("Thank you for playing!")
            delay(150)
            applymovement(LOCALID_CREDITS_CELIA, moves(
                walk_slow_up * 5
            ))
            delay(30)
            fadescreenspeed(FADE_TO_BLACK, 10) //Make this fade music too
            fadenewbgm(MUS_NONE)
            //goto title screen
            delay(120)
            special(DoSoftReset)

        }
    ]
}

script CreditsDummy {
    msgbox("hi")
    release
}