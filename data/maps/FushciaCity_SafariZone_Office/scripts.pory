raw `
FushciaCity_SafariZone_Office_MapScripts::
	.byte 0

FushciaCity_SafariZone_Office_EventScript_Worker1::
	msgbox FushciaCity_SafariZone_Office_Text_NicknamedWardenSlowpoke, MSGBOX_NPC
	end

FushciaCity_SafariZone_Office_EventScript_Worker2::
	msgbox FushciaCity_SafariZone_Office_Text_WardenIsVeryKnowledgeable, MSGBOX_NPC
	end

FushciaCity_SafariZone_Office_EventScript_Worker3::
	msgbox FushciaCity_SafariZone_Office_Text_CouldntUnderstandWarden, MSGBOX_NPC
	end

FushciaCity_SafariZone_Office_EventScript_Worker4::
	msgbox FushciaCity_SafariZone_Office_Text_PrizeInSafariZone, MSGBOX_NPC
	end
`
script FushciaCity_SlowpokeGuy {
	lock
	faceplayer
	if(flag(FLAG_CSR_GOT_SLOWPOKE)) {
		msgbox("…Huh?\pOf course I wasn't gonna give you\none with a TAIL attached.\lThis ain't a charity!\pI just didn't need the rest of it.\nFigured I'd do a good deed.", MSGBOX_DEFAULT)
	} else {
		msgbox("Hey there, kid!\nAre you looking to get rich quick?\pLet me tell ya:\nSLOWPOKETAIL is the way to go.\pHere, let me start you out.\nI have a gift for you!", MSGBOX_DEFAULT)
		setvar(VAR_CSR_GIFT_POKEMON, SPECIES_SLOWPOKE)
		playfanfare(MUS_LEVEL_UP)
		msgbox("{PLAYER} received a SLOWPOKE!\n", MSGBOX_DEFAULT)
		waitfanfare
		call(Common_Script_GiftPokemon)
		setflag(FLAG_CSR_GOT_SLOWPOKE)
		msgbox("Trust me - You'll thank me later!\n", MSGBOX_DEFAULT)
	}
	release
}

script FushciaCity_SlowpokeGuys_Bookshelf {
	msgbox("I invested thousands of dollars\ninto copies of this book.\lNo one believed me, but I had faith.\pNow suddenly it's everywhere, and\nI made out with millions!\pI'm telling you, this is the way to\nget rich quick!", MSGBOX_NPC)
	end
}

script FushciaCity_SlowpokeGuys_TrashCan {
	msgbox("Lodged in the trash can are dozens\nand dozens of BICYCLES.", MSGBOX_SIGN)
	end
}