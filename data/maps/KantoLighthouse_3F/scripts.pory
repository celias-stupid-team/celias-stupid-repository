mapscripts KantoLighthouse_3F_MapScripts {
    
}

script KantoLighthouse_3F_FallDownHole {
    lock
	call(DrawHoleFloorCovers)
	special(SpawnCameraObject)
	applymovement(LOCALID_PLAYER, PlayerFallsDownHole)
	delay(46)
	playse(SE_FALL)
	waitmovement(0)
    warphole(MAP_KANTO_LIGHTHOUSE_2F)
    release
    end
}


movement PlayerFallsDownHole {
	delay_16 * 2
	slide_down * 4
}

script KantoLighthouse_3F_LeftHole {
    lock
	setflag(FLAG_LIGHTHOUSE_FALLING_FROM_ABOVE)
    goto(KantoLighthouse_3F_FallDownHole)

}


script KantoLighthouse_3F_RightHole {
    lock
    goto(KantoLighthouse_3F_FallDownHole)

}

script DrawHoleFloorCovers {
	setmetatile(37, 37, 0x378, TRUE)
	setmetatile(37, 38, 0x380, TRUE)
	setmetatile(37, 39, 0x380, TRUE)
	setmetatile(37, 40, 0x380, TRUE)
	
	setmetatile(47, 37, 0x378, TRUE)
	setmetatile(47, 38, 0x380, TRUE)
	setmetatile(47, 39, 0x380, TRUE)
	setmetatile(47, 40, 0x380, TRUE)
	special(DrawWholeMapView)
	return
}

script KantoLighthouse_3F_Dad {
	lock
	faceplayer
	textcolor(0)
	msgbox("DAD: {PLAYER}!\nWhat are you doing out here?\pHey, you'd better watch out for\nthe holes in the floor.\lI wouldn't want you to get hurt!\pAnyway, never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}

script KantoLighthouse_3F_Ampharos {
    lock
    setwildbattle(SPECIES_AMPHAROS_MEGA, 30, ITEM_SECRETETHER)
	waitse
	playmoncry(SPECIES_AMPHAROS_MEGA, CRY_MODE_ENCOUNTER)
	delay(40)
	waitmoncry
	setflag(FLAG_SYS_SPECIAL_WILD_BATTLE)
	dowildbattle
	specialvar(VAR_RESULT, GetBattleOutcome)
    fadescreen(FADE_TO_BLACK)
    removeobject(VAR_LAST_TALKED)
    fadescreen(FADE_FROM_BLACK)
    release
}

//Gonna put the common encounter script here just to see if it works 

script Common_EventScript_StaticEncounter {
    goto_if_questlog(EventScript_ReleaseEnd)
	lock
	faceplayer
    callnative(GetObjectEventTrainerRangeFromTemplate)
	setwildbattle(VAR_RESULT, 25)
	waitse
	playmoncry(VAR_RESULT, CRY_MODE_ENCOUNTER)
	delay(40)
	waitmoncry
	setflag(FLAG_SYS_SPECIAL_WILD_BATTLE)
	dowildbattle
	clearflag(FLAG_SYS_SPECIAL_WILD_BATTLE)
	special(QuestLog_CutRecording)
	specialvar(VAR_RESULT, GetBattleOutcome)
    fadescreen(FADE_TO_BLACK)
    removeobject(VAR_LAST_TALKED)
    fadescreen(FADE_FROM_BLACK)
	release
	end
}

const WindowLeft = 41
const WindowMiddle = 42
const WindowRight = 43
const WindowTop = 30
const WindowBottom = 31

script Lighthouse_3F_Window {
	lock
	fadenewbgm(MUS_DUMMY)
	if(flag(FLAG_JUMPED_FROM_LIGHTHOUSE)) {
		msgbox("A thin piece of paper covers a\n{PLAYER}-shaped hole in the glass.\pWould you like to jump?\n", MSGBOX_YESNO)
	} else {
		msgbox("The window overlooks a 70-foot\ndrop down to the ground below.\pWould you like to jump?\n", MSGBOX_YESNO)
	}
	if(!var(VAR_RESULT)) {
		msgbox("{PLAYER} decided to be a fucking\npussy.", MSGBOX_DEFAULT)
		closemessage
		fadedefaultbgm
		release 
		end
	} else {
		closemessage
		delay(30)
		special(SpawnCameraObject)
		applymovement(LOCALID_PLAYER, JumpToDeath_1)
		waitmovement(0)
		playse(SE_LEDGE)
		applymovement(LOCALID_PLAYER, JumpToDeath_2)
		waitmovement(0)
		playse(SE_ICE_BREAK)
		special(RemoveCameraObject)
		setmetatile(WindowLeft, WindowTop, 0x37B, TRUE)
		setmetatile(WindowMiddle, WindowTop, 0x37C, TRUE)
		setmetatile(WindowRight, WindowTop, 0x37D, TRUE)
		setmetatile(WindowLeft, WindowBottom, 0x383, TRUE)
		setmetatile(WindowMiddle, WindowBottom, 0x384, TRUE)
		setmetatile(WindowRight, WindowBottom, 0x385, TRUE)
		special(DrawWholeMapView)
		delay(120)
		setflag(FLAG_JUMPED_FROM_LIGHTHOUSE)
		warphole(MAP_ROUTE15)



	}
}

movement JumpToDeath_1 {
	lock_facing_direction
	walk_slow_down
	face_up
	delay_16 * 2
	walk_slow_down
	face_up
	delay_16 * 2
	walk_slow_down
	face_up
	delay_16 * 4
	unlock_facing_direction
	player_run_up * 2
}
movement JumpToDeath_2 {
	jump_2_up
	set_invisible
}