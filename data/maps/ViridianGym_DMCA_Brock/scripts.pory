mapscripts ViridianGym_DMCA_Brock_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if(var(VAR_CURRENT_DMCA_PHASE) < 1) {
            setvar(VAR_CURRENT_DMCA_PHASE, 1)
        }
    }

}

script DMCA_Brock_Wolff {
    trainerbattle_single(TRAINER_DMCA_BROCK, "WOLFF: Grr…\pThat joke was used in a different\nromhack!\lYou'll pay for this!", "lol")
    release
    end
}