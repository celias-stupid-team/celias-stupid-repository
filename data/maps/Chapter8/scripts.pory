mapscripts Chapter8_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_0, 0 {
            if(var(VAR_CURRENT_CHAPTER) == 8) {
                warp(MAP_VIRIDIAN_GYM_ENTRANCE, 0)

            }
            setvar(VAR_CURRENT_CHAPTER, 8)
            setvar(VAR_TEMP_0, 1)
            delay(3)
            playbgm(MUS_CHAPTER_8, TRUE)
            setlayouttiles(LAYOUT_CHAPTER8_FRAME2, 0, 0, 0, 0, 14, 10) //chapter
            delay(94)
            setlayouttiles(LAYOUT_CHAPTER8_FRAME3, 0, 0, 0, 0, 14, 10) //8
            delay(94)
            setlayouttiles(LAYOUT_CHAPTER8_FRAME4, 0, 0, 0, 0, 14, 10) //nonstupidity
            delay(94)
            setlayouttiles(LAYOUT_CHAPTER8_FRAME5, 0, 0, 0, 0, 14, 10) //and
            delay(85)
            setlayouttiles(LAYOUT_CHAPTER8, 0, 0, 0, 0, 14, 10) //sense
            delay(210)
            warp(MAP_VIRIDIAN_GYM_ENTRANCE, 0)

        }
    ]
}