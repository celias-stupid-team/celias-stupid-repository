script StarlightHouse_MusicMenu {
	setvar(VAR_RESULT, 0)
	//closemessage
	dynmultichoice(2, 1, FALSE, 3, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"Music Tracks",
				"Dance Floor",
				"Dancers"
				//"BACK"
				,)
				
		closemessage
		call(StarlightHouse_CallMusicMenuOptions)
	

	
	release
}

script StarlightHouse_CallMusicMenuOptions {
			switch(var(VAR_RESULT)) {
				case 0:
					call(StarlightHouse_Jukebox)
				case 1:
					call(StarlightHouse_Floorbox)
				case 2:
					call(StarlightHouse_Dancebox)
				//case 3:
					//call(StarlightHouse_MainMenu)
				default:
				//call(StarlightHouse_MainMenu)
					setvar(VAR_RESULT, 0)
					release
					end
	}
}

























script StarlightHouse_Floorbox {
	lock
	//closemessage
	setvar(VAR_RESULT, 0)
	dynmultichoice(2, 1, FALSE, 9, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"Colored",
				"The Cooler Colored",
				"Gay Pride",
				"Trans Pride",
				"Progressive",
				"Professor Oak's Lab",
				"Checkerboard",
				"Dance Theater",				
				"BACK",)
				
		//closemessage
		call(StarlightHouse_CallFloor)
	
	release
}

