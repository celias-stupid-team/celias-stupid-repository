script Starlight_House_12_Remove_Dancers {
if(flag(FLAG_TEMP_1C)) {
			removeobject(D1)
			removeobject(D2)
			removeobject(D3)
			removeobject(D4)
			removeobject(D5)
			removeobject(D6)
			removeobject(DO1)
			removeobject(DO2)
			removeobject(DO3)
			removeobject(DO4)
			removeobject(DO5)
			removeobject(DO6)	
	}
	if(flag(FLAG_TEMP_1D)) {
			removeobject(DO1)
			removeobject(DO2)
			removeobject(DO3)
			removeobject(DO4)
			removeobject(DO5)
			removeobject(DO6)	
    }
	if(flag(FLAG_TEMP_1E)) {
			removeobject(D1)
			removeobject(D3)
			removeobject(D4)
			removeobject(D6)
			removeobject(DO2)
			removeobject(DO3)
			removeobject(DO4)
			removeobject(DO5)
    }
	if(flag(FLAG_TEMP_1F)) {
			removeobject(D1)
			removeobject(D6)
    }
	release
}


