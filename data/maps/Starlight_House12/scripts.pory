script StarlightHouse_Dancebox {
	//lock
	//msgbox(
	//"Hey look, friends!")
	//setvar(VAR_RESULT, 0)
	//closemessage
	if(flag(FLAG_CSR_CELIA_BONUS)) {
	dynmultichoice(2, 1, FALSE, 8, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"Don't tell the DMCA",//All are the player
				"Trans rights!",//All are the opposite gender of the player
				"Who drank the genderfluid?",//Mixed genders both sides
				"Each Side",//Male and Female split up on each side
				"Familiar faces",//CSR Re-occuring bits (Lass, Oak, Gary, Chuck, etc.)
				"Where did the Y go?",//All of the Rivals (Or what about "Ljhlgary" or "Erm, what was his name now?"?)
				"Gotta pay those Bills somehow",//All Pokedolls
				"Theater Show",//The Lavender Town Dancers
				"Gay Baby Jailers",//The Dev Team
				"???????????????????",//All Dev Commentary Celias
				"Flying Solo",)//Nobody
				
		//closemessage
		call(StarlightHouse_CallDancer)
	} else {
	dynmultichoice(2, 1, FALSE, 8, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"Don't tell the DMCA",//All are the player
				"Trans rights!",//All are the opposite gender of the player
				"Who drank the genderfluid?",//Mixed genders both sides
				"Each Side",//Male and Female split up on each side
				"Familiar faces",//CSR Re-occuring bits (Lass, Oak, Gary, Chuck, etc.)
				"Where did the Y go?",//All of the Rivals (Or what about "Ljhlgary" or "Erm, what was his name now?"?)
				"Gotta pay those Bills somehow",//All Pokedolls
				"Theater Show",//The Lavender Town Dancers
				"Gay Baby Jailers",//The Dev Team
				"They're everywhere!",//All Dev Commentary Celias
				"Flying Solo",)//Nobody
				
		//closemessage
		call(StarlightHouse_CallDancer)	
	}

	
	release
}

script StarlightHouse_CallDancer {
	switch(var(VAR_TEMP_0)) {
		case 0:
		
			switch(var(VAR_RESULT)) {
				case 0:
			setobjectmovementtype(D1, MOVEMENT_TYPE_COPY_PLAYER)
			setobjectmovementtype(D2, MOVEMENT_TYPE_COPY_PLAYER)
			setobjectmovementtype(D3, MOVEMENT_TYPE_COPY_PLAYER)
			setobjectmovementtype(D4, MOVEMENT_TYPE_COPY_PLAYER)
			setobjectmovementtype(D5, MOVEMENT_TYPE_COPY_PLAYER)
			setobjectmovementtype(D6, MOVEMENT_TYPE_COPY_PLAYER)
			setobjectmovementtype(DO1, MOVEMENT_TYPE_COPY_PLAYER_OPPOSITE)
			setobjectmovementtype(DO2, MOVEMENT_TYPE_COPY_PLAYER_OPPOSITE)
