					playbgm(MUS_INCOMPATIBLE_EMULATOR, TRUE)
				case 7:
				case 8:
					return
				default:
					setvar(VAR_RESULT, 0)
					call(StarlightHouse_MusicMenu)
					release
					end
			}
		case 2:
			switch(var(VAR_RESULT)) {
				case 0:
					playbgm(MUS_TCG_ISLAND, TRUE)
				case 1:
					playbgm(MUS_CERULEAN_CENTER, TRUE)
				case 2:
					playbgm(MUS_BATTLE_REVOLUTION, TRUE)
				case 3:
