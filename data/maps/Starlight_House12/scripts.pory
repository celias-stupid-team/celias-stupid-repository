mapscripts Starlight_House12_MapScripts {

MAP_SCRIPT_ON_TRANSITION {
		if(flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
			setflag(FLAG_TEMP_8)
        }
            if(flag(FLAG_CSR_CELIA_BONUS)) {
			setflag(FLAG_TEMP_8)
		}
		if(flag(FLAG_DAK_HERE)) {
			setflag(FLAG_TEMP_8)
		}
 if(checkplayergender == FEMALE) {

            setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_PLAYFIRE)
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_PLAYGREEN)
        } else {
            setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_PLAYGREEN)
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_PLAYFIRE)

        }
		
	}

}

script Starlight_Jukebox_Test {
    playbgm(MUS_CSR_POKERAP, TRUE)
    
	msgbox(
    "Music: MUS_CSR_POKERAP\n"
	"Made by: ???", MSGBOX_SIGN)
    end
}

