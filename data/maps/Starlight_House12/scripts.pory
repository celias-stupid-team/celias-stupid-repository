					end
			}
		case 10:
			switch(var(VAR_RESULT)) {
				case 0:
					playbgm(MUS_CSR_MT_MOON_SQUARE, TRUE)
				case 1:
					playbgm(MUS_CSR_CLEFAIRY_DANCE, TRUE)
				case 2:
					playbgm(MUS_PISCES_GYM, TRUE)
				case 3:
					playbgm(MUS_KENYA, TRUE)
				case 4:
					playbgm(MUS_CSR_POKERAP, TRUE)
				case 5:
					playbgm(MUS_CSR_CYNTHIA, TRUE)
				case 6:
					playbgm(MUS_THE_MOON, TRUE)
				case 7:
				case 8:
					return
				default:
					setvar(VAR_RESULT, 0)
					release
					end
			}
		case 11:
			switch(var(VAR_RESULT)) {
				case 0:
					playbgm(MUS_PRELUDE_TO_FINALE, TRUE)
				case 1:
					playbgm(MUS_SV_ELITE_FOUR, TRUE)
				case 2:
					playbgm(MUS_CYNTHIA_BATTLE, TRUE)
				case 3:
					playbgm(MUS_THE_GAME_IS_AFOOT, TRUE)
				case 4:
					playbgm(MUS_GRAND_FINALE, TRUE)
				case 5:
					playbgm(MUS_STUPID_CREDITS, TRUE)
				case 6:
					playbgm(MUS_STUPID_ENDING, TRUE)
				case 7:
				case 8:
					return
				default:
					setvar(VAR_RESULT, 0)
					release
					end
			}
	}
}