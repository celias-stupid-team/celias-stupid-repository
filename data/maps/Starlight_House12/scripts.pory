script Starlight_House_12_Go_Dance {
    lock
    textcolor(NPC_TEXT_COLOR_NEUTRAL)
    msgbox("Would you like to dance?", MSGBOX_YESNO)
		closemessage
		if(var(VAR_RESULT)) {
			//fadescreen(FADE_TO_WHITE)
            warp(MAP_STARLIGHT_HOUSE12, 1, 19, 12) // Map, Warp ID, X, Y
            waitstate
            //delay(120)
            //fadescreen(FADE_FROM_WHITE)
		}
    release
    end
}

script Starlight_House_12_MapReset {
    lock
    textcolor(NPC_TEXT_COLOR_NEUTRAL)
    msgbox("Would you like to reset\nthe room?", MSGBOX_YESNO)
		closemessage
		if(var(VAR_RESULT)) {
			//fadescreen(FADE_TO_WHITE)
			//setobjectmovementtype(D1, MOVEMENT_TYPE_COPY_PLAYER)
	//setmetatile(25, 12, 0x2BB, FALSE)
	//setobjectmovementtype(DO1, MOVEMENT_TYPE_COPY_PLAYER)
	//setobjectmovementtype(DO2, MOVEMENT_TYPE_COPY_PLAYER)
	//setobjectmovementtype(DO3, MOVEMENT_TYPE_COPY_PLAYER)
	//setobjectmovementtype(DO4, MOVEMENT_TYPE_COPY_PLAYER)
	//setobjectmovementtype(DO5, MOVEMENT_TYPE_COPY_PLAYER)
	//setobjectmovementtype(DO6, MOVEMENT_TYPE_COPY_PLAYER)
	//setobjectmovementtype(D1, MOVEMENT_TYPE_COPY_PLAYER_OPPOSITE)
	//setobjectmovementtype(D2, MOVEMENT_TYPE_COPY_PLAYER_OPPOSITE)
	//setobjectmovementtype(D3, MOVEMENT_TYPE_COPY_PLAYER_OPPOSITE)
	//setobjectmovementtype(D4, MOVEMENT_TYPE_COPY_PLAYER_OPPOSITE)
	//setobjectmovementtype(D5, MOVEMENT_TYPE_COPY_PLAYER_OPPOSITE)
	//setobjectmovementtype(D6, MOVEMENT_TYPE_COPY_PLAYER_OPPOSITE)
	setmetatile(19, 11, 0x2B1, TRUE)
	setmetatile(21, 11, 0x2B3, TRUE)
	setmetatile(23, 11, 0x2B1, TRUE)
	setmetatile(27, 11, 0x2B1, TRUE)
	setmetatile(29, 11, 0x2B3, TRUE)
	setmetatile(31, 11, 0x2B1, TRUE)
	setmetatile(18, 12, 0x2B8, TRUE)
	setmetatile(20, 12, 0x2BA, TRUE)
	setmetatile(22, 12, 0x2B8, TRUE)
	setmetatile(24, 12, 0x2BA, TRUE)
	setmetatile(26, 12, 0x2B8, TRUE)
	setmetatile(28, 12, 0x2BA, TRUE)
	setmetatile(30, 12, 0x2B8, TRUE)
	setmetatile(32, 12, 0x2BA, TRUE)
			setflag(FLAG_TEMP_6)
            warp(MAP_STARLIGHT_HOUSE12, 0, 19, 12) // Map, Warp ID, X, Y
            waitstate
            //delay(120)
            //fadescreen(FADE_FROM_WHITE)
		}
    release
    end
}

script Starlight_House_12_Dad {
	lock
	faceplayer
	textcolor(0)
	msgbox(
	"DAD: {PLAYER}!\n"
	"What are you doing out here?\p"

	"Y'know, I was supposed to have a\n"
	"DANCE scene in CELADON GYM.\l"
	"Now I'm gettin' my groove on here!\p"

	"Well, never mind that.\n"
	"Why don't you take a breather?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}

