					return
				default:
					setvar(VAR_RESULT, 0)
					release
					end
			}
		case 3:
			switch(var(VAR_RESULT)) {
				case 0:
					playbgm(MUS_CSR_CELADON_GYM, TRUE)
				case 1:
					playbgm(MUS_CSR_DANCE_THEATER, TRUE)
				case 2:
