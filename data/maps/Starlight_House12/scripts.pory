script Starlight_House_12_Go_Dance {
    lock
    textcolor(NPC_TEXT_COLOR_NEUTRAL)
    msgbox("Would you like to dance?", MSGBOX_YESNO)
		closemessage
		if(var(VAR_RESULT)) {
			//fadescreen(FADE_TO_WHITE)
            warp(MAP_STARLIGHT_HOUSE12, 1, 19, 12) // Map, Warp ID, X, Y
            waitstate
            //delay(120)
            //fadescreen(FADE_FROM_WHITE)
		}
    release
    end
}

script Starlight_House_12_MapReset {
    lock
    textcolor(NPC_TEXT_COLOR_NEUTRAL)
    msgbox("Would you like to reset\nthe room?", MSGBOX_YESNO)
		closemessage
		if(var(VAR_RESULT)) {
			//fadescreen(FADE_TO_WHITE)
			//setobjectmovementtype(D1, MOVEMENT_TYPE_COPY_PLAYER)
	//setmetatile(25, 12, 0x2BB, FALSE)
	//setobjectmovementtype(DO1, MOVEMENT_TYPE_COPY_PLAYER)
	//setobjectmovementtype(DO2, MOVEMENT_TYPE_COPY_PLAYER)
	//setobjectmovementtype(DO3, MOVEMENT_TYPE_COPY_PLAYER)
	//setobjectmovementtype(DO4, MOVEMENT_TYPE_COPY_PLAYER)
	//setobjectmovementtype(DO5, MOVEMENT_TYPE_COPY_PLAYER)
	//setobjectmovementtype(DO6, MOVEMENT_TYPE_COPY_PLAYER)
	//setobjectmovementtype(D1, MOVEMENT_TYPE_COPY_PLAYER_OPPOSITE)
	//setobjectmovementtype(D2, MOVEMENT_TYPE_COPY_PLAYER_OPPOSITE)
	//setobjectmovementtype(D3, MOVEMENT_TYPE_COPY_PLAYER_OPPOSITE)
	//setobjectmovementtype(D4, MOVEMENT_TYPE_COPY_PLAYER_OPPOSITE)
	//setobjectmovementtype(D5, MOVEMENT_TYPE_COPY_PLAYER_OPPOSITE)
	//setobjectmovementtype(D6, MOVEMENT_TYPE_COPY_PLAYER_OPPOSITE)
	setmetatile(19, 11, 0x2B1, TRUE)
	setmetatile(21, 11, 0x2B3, TRUE)
	setmetatile(23, 11, 0x2B1, TRUE)
	setmetatile(27, 11, 0x2B1, TRUE)
	setmetatile(29, 11, 0x2B3, TRUE)
	setmetatile(31, 11, 0x2B1, TRUE)
	setmetatile(18, 12, 0x2B8, TRUE)
	setmetatile(20, 12, 0x2BA, TRUE)
	setmetatile(22, 12, 0x2B8, TRUE)
	setmetatile(24, 12, 0x2BA, TRUE)
	setmetatile(26, 12, 0x2B8, TRUE)
	setmetatile(28, 12, 0x2BA, TRUE)
	setmetatile(30, 12, 0x2B8, TRUE)
	setmetatile(32, 12, 0x2BA, TRUE)
			setflag(FLAG_TEMP_6)
            warp(MAP_STARLIGHT_HOUSE12, 0, 19, 12) // Map, Warp ID, X, Y
            waitstate
            //delay(120)
            //fadescreen(FADE_FROM_WHITE)
		}
    release
    end
}

script Starlight_House_12_Dad {
	lock
	faceplayer
	textcolor(0)
	msgbox(
	"DAD: {PLAYER}!\n"
	"What are you doing out here?\p"

	"Y'know, I was supposed to have a\n"
	"DANCE scene in CELADON GYM.\l"
	"Now I'm gettin' my groove on here!\p"

	"Well, never mind that.\n"
	"Why don't you take a breather?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}

script Starlight_House_12_Clefairy {
	finditem(ITEM_POKE_DOLL, 1)
	end
}


const JUKEBOX_PAGES = 12
const JUKEBOX_PAGES_MINUS_ONE = JUKEBOX_PAGES - 1
script StarlightHouse_Jukebox {
	//lock
	//msgbox(
	//"It's a JUKEBOX!\n"
	//"")
	setvar(VAR_RESULT, 0)
	closemessage
	
	while(var(VAR_RESULT) != 254) {
		if(var(VAR_RESULT) == 7) {
			addvar(VAR_TEMP_0, 1)
			if(var(VAR_TEMP_0) == JUKEBOX_PAGES) {
				setvar(VAR_TEMP_0, 0)
			}
		}
		if(var(VAR_RESULT) == 8) {
			
			if(var(VAR_TEMP_0) == 0) {
				setvar(VAR_TEMP_0, JUKEBOX_PAGES_MINUS_ONE)
			} else {
				subvar(VAR_TEMP_0, 1)
			}
		}
		switch(var(VAR_TEMP_0)) {
			case 0:
				dynmultichoice(2, 1, FALSE, 9, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"A Gruel Angle's Thesis",
				"Celia's Stupid Romhack",
				"Chapter Zero",
				"Stupidity and Nonsense!",
				"Defeat the DMCA!",
				"My Secret Life",
				"Nonstupidity and Sense!",
				"NEXT",
				"PREVIOUS")
			case 1:
				dynmultichoice(2, 1, FALSE, 9, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"That's The Way Through!",
				"That's a Fancy Bike",
				"{COLOR GREEN}Too Much Water",
				"I'm walkin here!",
				"Buy somethin', will ya?",
				"{COLOR GREEN}Ooh, a Korok!",
				"Something went wrong",
				"NEXT",
				"PREVIOUS")
			case 2:
				dynmultichoice(2, 1, FALSE, 9, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"TCG Town",
				"Let's Trade!",
				"{COLOR GREEN}Competitive Community",
				"What kinda club?",
				"Just kick it.19",
				"Quick! Mash Buttons!",
				"Can't Stop Lookin'",
				"NEXT",
				"PREVIOUS")
			case 3:
				dynmultichoice(2, 1, FALSE, 9, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"Gay People",
				"No Eating in the Theater",
				"Ceremonial Dance",
				"Big Yellow and Friends",
				"{COLOR GREEN}Don't listen to the music!",
				"Stay dry, ya jerk",
				"The Pattern in the Grass",
				"NEXT",
				"PREVIOUS")
			case 4:
				dynmultichoice(2, 1, FALSE, 9, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"Copyright Gangsters",
				"Takedown Notice",
				"Safari March",
				"Safari Showdown",
				"Last pathetic card!",
				"Straight People",
				"Shorts Gang Hideout",
				"NEXT",
				"PREVIOUS")
			case 5:
				dynmultichoice(2, 1, FALSE, 9, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"Slavery Capital",
				"The Center of Town",
				"Want Some Mulch?",
				"A New World, A New Look",
				"Furnace Fun",
				"Let's Get Gold!",
				"Fucking Horse Shit",
				"NEXT",
				"PREVIOUS")
			case 6:
				dynmultichoice(2, 1, FALSE, 9, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"It's a snap!",
				"Welcome Back!",
				"Celia Soundtrack (Free Download)",
				"{COLOR GREEN}Noterday?",
				"It's a pretty great Bay",
				"Isn't it Paradise?",
				"A Tragic Tale",
				"NEXT",
				"PREVIOUS")
			case 7:
				dynmultichoice(2, 1, FALSE, 9, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"A Long Way From Home",
				"Corporate Paradise",
				"How tall could it be?",
				"{COLOR RED}Girl Meets Boy",
				"We sell drugs.",
				"TMT2 beat me to the punch",
				"{COLOR GREEN}Chips and Salsa",
				"NEXT",
				"PREVIOUS")
			case 8:
				dynmultichoice(2, 1, FALSE, 9, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"Just a few more",
				"Surely it's not a trap",
				"Through the Mountains",
				"In the Safari Zone",
				"Underground",
				"Unused!",
				"Last Time on Stupid Romhack",
				"NEXT",
				"PREVIOUS")
			case 9:
				dynmultichoice(2, 1, FALSE, 9, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"The Rainbow Hides",
				"Star wanted this",
				"Yoshi Victory!",
				"Story of Creation",
				"Where's his head?",
				"Starlight House",
				"How'd we get here?",
				"NEXT",
				"PREVIOUS")
			case 10:
				dynmultichoice(2, 1, FALSE, 9, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"Moon Altar",
				"Can I sell them?",
				"Massive Flex",
				"Spare Pillar",
				"The Joy of Creation",
				"oh shit",
				"{COLOR GREEN}Claim Your Shining Prize",
				"NEXT",
				"PREVIOUS")
			case 11:
				dynmultichoice(2, 1, FALSE, 9, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"Prelude to Finale",
				"Memory Leak",
				"Everything You Need",
				"You've Had All Along",
				"Grand Finale",
				"A Gruel Angle's Finale",
				"Thank You For Playing!",
				"NEXT",
				"PREVIOUS")
			default:
				release
				end
		}
		call(StarlightHouse_CallJukeboxSong)




	}
	release
}

script StarlightHouse_CallJukeboxSong {
	switch(var(VAR_TEMP_0)) {
		case 0:
			switch(var(VAR_RESULT)) {
				case 0:
					playbgm(MUS_INTRO_FIGHT, TRUE)
				case 1:
					playbgm(MUS_TITLE, TRUE)
				case 2:
					playbgm(MUS_GAME_FREAK, TRUE)
				case 3:
					playbgm(MUS_CSR_CHAPTER_1, TRUE)
				case 4:
					playbgm(MUS_CSR_CHAPTER_2, TRUE)
				case 5:
					playbgm(MUS_CSR_CHAPTER_3, TRUE)
				case 6:
					playbgm(MUS_CHAPTER_8, TRUE)
				case 7:
				case 8:
					return
				default:
					setvar(VAR_RESULT, 0)
					call(StarlightHouse_MusicMenu)
					release
					end
			}
		case 1:
			switch(var(VAR_RESULT)) {
				case 0:
					playbgm(MUS_CSR_DRILL_DOZER, TRUE)
				case 1:
					playbgm(MUS_CYCLING, TRUE)
				case 2:
					playbgm(MUS_SURF, TRUE)
				case 3:
					playbgm(MUS_CSR_FURRET, TRUE)
				case 4:
					playbgm(MUS_CSR_MART, TRUE)
				case 5:
					playbgm(MUS_KOROK_SEED, TRUE)
