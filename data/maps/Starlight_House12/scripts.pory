            warp(MAP_STARLIGHT_HOUSE12, 0, 30, 32) // Map, Warp ID, X, Y
            waitstate
		}
    }
	if(flag(FLAG_TEMP_13)) {//SPLIT GENDERS OPTION
		msgbox("Would you like to reload\nthe floor?", MSGBOX_YESNO)
		closemessage
		if(var(VAR_RESULT)) {
            warp(MAP_STARLIGHT_HOUSE12, 0, 30, 32) // Map, Warp ID, X, Y
            waitstate
		}
    }
	if(flag(FLAG_TEMP_14)) {//CSR BITS OPTION
			msgbox(
	"(CSR bits) template.", MSGBOX_NPC)
    }
	if(flag(FLAG_TEMP_15)) {//ALL RIVALS OPTION
			msgbox(
	"(All rivals) template.", MSGBOX_NPC)
    }
	if(flag(FLAG_TEMP_16)) {//POKEDOLL OPTION
		finditem(ITEM_POKE_DOLL, 1)
		end
    }
	if(flag(FLAG_TEMP_17)) {//DANCE THEATER OPTION
			msgbox(
	"(Dance Theater) template.", MSGBOX_NPC)
    }
	if(flag(FLAG_TEMP_18)) {//DEV TEAM OPTION
			msgbox(
	"(Dev Team) template.", MSGBOX_NPC)
    }
	if(flag(FLAG_TEMP_19)) {//CELIA DEV COMMENTARY OPTION
			msgbox(
	"(Celia Dev Commentary) template.", MSGBOX_NPC)
    }
	if(flag(FLAG_TEMP_1A)) {//NOBODY OPTION
			msgbox(
	"(Solo) template.", MSGBOX_NPC)
    }
	release
    end
}

