script Starlight_House_12_Clefairy {
	finditem(ITEM_POKE_DOLL, 1)
	setflag(FLAG_CSR_GOT_BILL)
	if(var(VAR_CSR_BILLS_TAKEN) < 999) {
		addvar(VAR_CSR_BILLS_TAKEN, 1)
	}
	end
}