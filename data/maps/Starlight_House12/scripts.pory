const JUKEBOX_PAGES = 12
const JUKEBOX_PAGES_MINUS_ONE = JUKEBOX_PAGES - 1
script StarlightHouse_Jukebox {
	lock
	msgbox(
	"It's a JUKEBOX!\n"
	"")
	setvar(VAR_RESULT, 0)
	closemessage
	
	while(var(VAR_RESULT) != 254) {
		if(var(VAR_RESULT) == 7) {
			addvar(VAR_TEMP_0, 1)
			if(var(VAR_TEMP_0) == JUKEBOX_PAGES) {
				setvar(VAR_TEMP_0, 0)
			}
		}
		if(var(VAR_RESULT) == 8) {
			
			if(var(VAR_TEMP_0) == 0) {
				setvar(VAR_TEMP_0, JUKEBOX_PAGES_MINUS_ONE)
			} else {
				subvar(VAR_TEMP_0, 1)
			}
		}
		switch(var(VAR_TEMP_0)) {
			case 0:
				dynmultichoice(2, 1, FALSE, 9, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"A Gruel Angle's Thesis",
				"Celia's Stupid Romhack",
				"Chapter Zero",
				"Stupidity and Nonsense!",
				"Defeat the DMCA!",
				"My Secret Life",
				"Nonstupidity and Sense!",
				"NEXT",
				"BACK")
			case 1:
				dynmultichoice(2, 1, FALSE, 9, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"That's The Way Through!",
				"That's a Fancy Bike",
				"Too Much Water",
				"I'm walkin here!",
				"Buy somethin', will ya?",
				"Ooh, a Korok!",
				"Something went wrong",
				"NEXT",
				"BACK")
			case 2:
				dynmultichoice(2, 1, FALSE, 9, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"TCG Town",
				"Let's Trade!",
				"Competitive Community",
				"What kinda club?",
				"Just kick it.19",
				"Quick! Mash Buttons!",
				"Can't Stop Lookin'",
				"NEXT",
				"BACK")
			case 3:
				dynmultichoice(2, 1, FALSE, 9, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"Gay People",
				"No Eating in the Theater",
				"Ceremonial Dance",
				"Big Yellow and Friends",
				"Don't listen to the music!",
				"Stay dry, ya jerk",
				"The Pattern in the Grass",
				"NEXT",
				"BACK")
			case 4:
				dynmultichoice(2, 1, FALSE, 9, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"Copyright Gangsters",
				"Takedown Notice",
				"Safari March",
				"Safari Showdown",
				"Last pathetic card!",
				"Straight People",
				"Shorts Gang Hideout",
				"NEXT",
				"BACK")
			case 5:
				dynmultichoice(2, 1, FALSE, 9, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"Slavery Capital",
				"The Center of Town",
				"Want Some Mulch?",
				"A New World, A New Look",
				"Furnace Fun",
				"Let's Get Gold!",
				"Fucking Horse Shit",
				"NEXT",
				"BACK")
			case 6:
				dynmultichoice(2, 1, FALSE, 9, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"It's a snap!",
				"Welcome Back!",
				"Celia Soundtrack (Free Download)",
				"Noterday?",
				"It's a pretty great Bay",
				"Isn't it Paradise?",
				"A Tragic Tale",
				"NEXT",
				"BACK")
			case 7:
				dynmultichoice(2, 1, FALSE, 9, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"A Long Way From Home",
				"Corporate Paradise",
				"How tall could it be?",
				"Girl Meets Boy (CELADONK)",
				"We sell drugs.",
				"TMT2 beat me to the punch",
				"Chips and Salsa",
				"NEXT",
				"BACK")
			case 8:
				dynmultichoice(2, 1, FALSE, 9, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"Just a few more",
				"Surely it's not a trap",
				"Through the Mountains",
				"In the Safari Zone",
				"Underground",
				"Unused!",
				"Last Time on Stupid Romhack",
				"NEXT",
				"BACK")
			case 9:
				dynmultichoice(2, 1, FALSE, 9, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"The Rainbow Hides",
				"Star wanted this",
				"Yoshi Victory!",
				"Story of Creation",
				"Where's his head?",
				"Starlight House",
				"How'd we get here?",
				"NEXT",
				"BACK")
			case 10:
				dynmultichoice(2, 1, FALSE, 9, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"Moon Altar",
				"Can I sell them?",
				"Massive Flex",
				"Spare Pillar",
				"The Joy of Creation",
				"oh shit",
				"Claim Your Shining Prize",
				"NEXT",
				"BACK")
			case 11:
				dynmultichoice(2, 1, FALSE, 9, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"Prelude to Finale",
				"Memory Leak",
				"Everything You Need",
				"You've Had All Along",
				"Grand Finale",
				"A Gruel Angle's Finale",
				"Thank You For Playing!",
				"NEXT",
				"BACK")
			default:
				release
				end
		}
		call(StarlightHouse_CallJukeboxSong)




	}
	release
}

script StarlightHouse_CallJukeboxSong {
	switch(var(VAR_TEMP_0)) {
		case 0:
			switch(var(VAR_RESULT)) {
				case 0:
					playbgm(MUS_INTRO_FIGHT, TRUE)
				case 1:
					playbgm(MUS_TITLE, TRUE)
				case 2:
					playbgm(MUS_GAME_FREAK, TRUE)
				case 3:
					playbgm(MUS_CSR_CHAPTER_1, TRUE)
				case 4:
					playbgm(MUS_CSR_CHAPTER_2, TRUE)
				case 5:
					playbgm(MUS_CSR_CHAPTER_3, TRUE)
				case 6:
					playbgm(MUS_CHAPTER_8, TRUE)
				case 7:
				case 8:
					return
				default:
					setvar(VAR_RESULT, 0)
					release
					end
			}
		case 1:
			switch(var(VAR_RESULT)) {
				case 0:
					playbgm(MUS_CSR_DRILL_DOZER, TRUE)
				case 1:
					playbgm(MUS_CYCLING, TRUE)
				case 2:
					playbgm(MUS_SURF, TRUE)
				case 3:
					playbgm(MUS_CSR_FURRET, TRUE)
				case 4:
					playbgm(MUS_CSR_MART, TRUE)
				case 5:
					playbgm(MUS_KOROK_SEED, TRUE)
