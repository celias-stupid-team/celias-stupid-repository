			setvar(VAR_OBJ_GFX_ID_B, OBJ_EVENT_GFX_GREEN_NORMAL)
			setflag(FLAG_TEMP_10)
			if(!flag(FLAG_TEMP_3) && !flag(FLAG_TEMP_4) && !flag(FLAG_TEMP_5) && !flag(FLAG_TEMP_6) && !flag(FLAG_TEMP_7) && !flag(FLAG_TEMP_8) && !flag(FLAG_TEMP_9) && !flag(FLAG_TEMP_2)) {
			setflag(FLAG_TEMP_3)
					setlayouttiles(
