    .string "from the PRESIDENT!$"

SilphCo_11F_Text_ThatsOurSecretPrototype::
    .string "PRESIDENT: You can't buy that\n"
    .string "anywhere.\p"
    .string "It's our secret prototype MISTER\n"
    .string "BALL.\p"
    .string "It will catch any MISTER without\n"
	.string "fail!$"

