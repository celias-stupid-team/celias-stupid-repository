raw `
::


SilphCo_11F_EventScript_President::
	lock
	faceplayer
	goto_if_set FLAG_GOT_MASTER_BALL_FROM_SILPH, SilphCo_11F_EventScript_AlreadyGotMasterBall
	checkplayergender
	call_if_eq VAR_RESULT, MALE, SilphCo_11F_EventScript_PresidentThanksMale
	call_if_eq VAR_RESULT, FEMALE, SilphCo_11F_EventScript_PresidentThanksFemale
	checkitemspace ITEM_MASTER_BALL
	goto_if_eq VAR_RESULT, FALSE, SilphCo_11F_EventScript_NoRoomForMasterBall
	giveitem_msg SilphCo_11F_Text_ObtainedMasterBallFromPresident, ITEM_MASTER_BALL, 1, MUS_OBTAIN_KEY_ITEM
	msgbox SilphCo_11F_Text_ThatsOurSecretPrototype
	setflag FLAG_GOT_MASTER_BALL_FROM_SILPH
	release
	end

SilphCo_11F_EventScript_PresidentThanksMale::
	msgbox SilphCo_11F_Text_ThanksForSavingMeDearBoy
	return

SilphCo_11F_EventScript_PresidentThanksFemale::
	msgbox SilphCo_11F_Text_ThanksForSavingMeDearGirl
	return

SilphCo_11F_EventScript_NoRoomForMasterBall::
	msgbox SilphCo_11F_Text_YouHaveNoRoomForThis
	release
	end





SilphCo_11F_EventScript_GiovanniTriggerLeft::
	lockall
	setvar VAR_TEMP_1, 0
	goto SilphCo_11F_EventScript_BattleGiovanni
	end

SilphCo_11F_EventScript_GiovanniTriggerRight::
	lockall
	setvar VAR_TEMP_1, 1
	goto SilphCo_11F_EventScript_BattleGiovanni
	end



SilphCo_11F_EventScript_GiovanniApproachLeft::
	applymovement LOCALID_SILPH_CO_GIOVANNI, SilphCo_11F_Movement_GiovanniApproachLeft
	applymovement LOCALID_PLAYER, SilphCo_11F_Movement_PlayerFaceGiovanni
	waitmovement 0
	return

SilphCo_11F_EventScript_GiovanniApproachRight::
	applymovement LOCALID_SILPH_CO_GIOVANNI, SilphCo_11F_Movement_GiovanniApproachRight
	waitmovement 0
	return

SilphCo_11F_Movement_GiovanniApproachLeft::
	walk_down
	walk_down
	walk_down
	walk_in_place_faster_left
	step_end

SilphCo_11F_Movement_GiovanniApproachRight::
	walk_down
	walk_down
	step_end

SilphCo_11F_Movement_PlayerFaceGiovanni::
	delay_16
	delay_16
	delay_16
	delay_8
	delay_4
	walk_in_place_faster_right
	step_end

@ Unused
SilphCo_11F_EventScript_Monitor::
	msgbox SilphCo_11F_Text_MonitorHasMonsOnIt, MSGBOX_SIGN
	end

SilphCo_11F_EventScript_FloorSign::
	msgbox SilphCo_11F_Text_FloorSign, MSGBOX_SIGN
	end

SilphCo_11F_EventScript_Grunt1::
	trainerbattle_single TRAINER_DMCA_GRUNT_40, SilphCo_11F_Text_Grunt1Intro, SilphCo_11F_Text_Grunt1Defeat
	msgbox SilphCo_11F_Text_Grunt1PostBattle, MSGBOX_AUTOCLOSE
	end

SilphCo_11F_EventScript_Grunt2::
	trainerbattle_single TRAINER_DMCA_GRUNT_41, SilphCo_11F_Text_Grunt2Intro, SilphCo_11F_Text_Grunt2Defeat
	msgbox SilphCo_11F_Text_Grunt2PostBattle, MSGBOX_AUTOCLOSE
	end
`
mapscripts SilphCo_11F_MapScripts {
	MAP_SCRIPT_ON_LOAD {
		setrespawn(HEAL_LOCATION_SILPH_CO_11F)
	}
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_USED_CUT, 1 {
			if(flag(FLAG_SHINY_HAUNTER)) {
				setvar(VAR_USED_CUT, 0)
				end
			}
			delay(60)
			playfanfare(MUS_LEVEL_UP)
			msgbox(
			"{PLAYER} removed a\n"
			"PARASITE's head!", MSGBOX_DEFAULT)
			waitfanfare
			setflag(FLAG_SHINY_CREATION)
			setflag(FLAG_SHINY_HAUNTER)
			setvar(VAR_USED_CUT, 0)
			setvar(VAR_CSR_GIFT_POKEMON, SPECIES_HAUNTER)
			copyvar(VAR_TEMP_1, SPECIES_HAUNTER)
			givemon(SPECIES_HAUNTER, 100)
			clearflag(FLAG_SHINY_CREATION)
			switch(var(VAR_RESULT)) {
				case 0: //Mon goes to party
					bufferspeciesname(STR_VAR_1, SPECIES_HAUNTER)
					
				case 1: //Mon goes to PC
					bufferspeciesname(STR_VAR_1, SPECIES_HAUNTER) //Breaks here??
						
				case 2:
					goto(EventScript_NoMoreRoomForPokemon)
					
			}
	

			release
			end
		}
	]
}


script SilphCo_11F_EventScript_ElevatorDoor {
	msgbox("Rats!\nThe elevator door's been glued shut!", MSGBOX_SIGN)

}



script SilphCo_11F_EventScript_BattleGiovanni {
	textcolor(NPC_TEXT_COLOR_MALE)
	applymovement(LOCALID_SILPH_CO_GIOVANNI, Common_Movement_WalkInPlaceFasterDown)
	waitmovement(0)
	delay(25)
	msgbox(
	"GIOVANNI: Oh?\n"
	"You again?\p"

	"I was simply discussing my plans\n"
	"with the PRESIDENT of SILPH.\l"
	"He's a brainless ideologue.\p"

	"But soon, I'll be in control of this\n"
	"company's intellectual property!", MSGBOX_DEFAULT)
	closemessage
	call_if_eq(VAR_TEMP_1, 0, SilphCo_11F_EventScript_GiovanniApproachLeft)
	call_if_eq(VAR_TEMP_1, 1, SilphCo_11F_EventScript_GiovanniApproachRight)
	setvar(VAR_LAST_TALKED, LOCALID_SILPH_CO_GIOVANNI)
	
	setvar(VAR_TEMP_START_EVENT_BATTLE, EVENT_BATTLE_GIOVANNI_2)
	trainerbattle_no_intro(TRAINER_BOSS_GIOVANNI_2, SilphCo_11F_Text_GiovanniDefeat)
	msgbox(
	"GIOVANNI: Foolish child!\n"
	"Can you not see the world as it is?\p"

	"Art isn't owed to those who create\n"
	"and consume it!\l"
	"It belongs solely to corporations!\p"

	"What is the purpose of creation if\n"
	"not to amass wealth and power!?\p"

	"Hmph.\n"
	"You're young and naive.\l"
	"You can't possibly understand us.\p"

	"I'm wasting my time on you.\n"
	"", MSGBOX_DEFAULT)
	closemessage
	fadenewbgm(MUS_NONE)
	fadescreenswapbuffers(FADE_TO_BLACK)
	removeobject(LOCALID_SILPH_CO_GIOVANNI)
	removeobject(LOCALID_SILPH_CO_11F_GRUNT1)
	removeobject(LOCALID_SILPH_CO_11F_GRUNT2)
	fadescreenswapbuffers(FADE_FROM_BLACK)
	setvar(VAR_CSR_DUMMY_3, 1)
	setflag(FLAG_SILPH_DMCA_DEFEATED)
	setflag(FLAG_HIDE_SAFFRON_ROCKETS)
	clearflag(FLAG_HIDE_SAFFRON_CIVILIANS)
	playbgm(MUS_CYBER_WORLD, TRUE)
	releaseall
	end
}


script SilphCo_11F_EventScript_AlreadyGotMasterBall {
	if(!checkmoncaught(SPECIES_MR_MIME) && !checkitem(ITEM_MASTER_BALL)) { // and not victory road
		msgbox(
		"What's that?\n"
		"You need another MISTER BALL?\p"

		"How'd you manage to lose it?\n"
		"Hrrm.\p"

		"Well, fine.\n"
		"Here's another!", MSGBOX_DEFAULT)
		giveitem_msg("{PLAYER} got another\nMISTER BALL!",ITEM_MASTER_BALL)
	} else {
		msgbox(SilphCo_11F_Text_ThatsOurSecretPrototype) //Add logic if you wasted the Mister Ball

	}
	release
}

script SilphCo_StartSilphMusic {
	setvar(VAR_START_SILPH_MUSIC, 2)
	playbgm(MUS_CYBER_WORLD, TRUE)
}

script SilphCo_11F_EventScript_Secretary {
	if(flag(FLAG_TEMP_5)) {
		msgbox(
		"Oh, no!\n"
		"Grandpa's dead!\p"

		"I only got this position because of\n"
		"nepotism!\l"
		"How will I ever survive!?", MSGBOX_NPC)
	} elif(flag(FLAG_SHINY_HAUNTER)) {
		msgbox(
		"A few minutes ago, the PRESIDENT\n"
		"was dead.\p"

		"Thankfully, we got a new one!\n"
		"", MSGBOX_NPC)
	} else {
		msgbox (SilphCo_11F_Text_ThanksForRescuingUs, MSGBOX_NPC)

	}
}