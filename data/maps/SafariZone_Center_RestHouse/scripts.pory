raw `

SafariZone_Center_RestHouse_EventScript_Sara::
	msgbox SafariZone_Center_Text_WhereDidErikGo, MSGBOX_NPC
	end

SafariZone_Center_RestHouse_EventScript_Scientist::
	msgbox SafariZone_Center_Text_CatchingMonsAsGifts, MSGBOX_NPC
	end
`

mapscripts SafariZone_Center_RestHouse_MapScripts {
	MAP_SCRIPT_ON_LOAD {
		if(!flag(FLAG_SANDWICH_GOT_SESAME_SEED)) {
			setflag(FLAG_TEMP_3)
		}
	}
}
script SafariZone_RestDad {
	lock
	faceplayer
	textcolor(0)
	msgbox("DAD: {PLAYER}!\nWhat are you doing out here?\pI'm enjoying some sightseeing here\nin the SAFARI ZONE.\lThe wildlife seems sparse, though.\pWell, never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}

script SafariZone_RestDad2 {
	lock
	faceplayer
	textcolor(0)
	msgbox("DAD: {PLAYER}!\nWhat are you doing out here?\pWhat?\nOf course I'm in all of these.\lWhy d'ya think it's a REST house?\pWell, never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}

script SafariZone_Rest_Scientist {
	msgbox("The SAFARI ZONE doesn't have any\nwild POKéMON anymore.\pYou'd think it's the DMCA's fault,\nbut they actually didn't do it.\pSome kid caught tons and tons of one\nsingle POKéMON.\lThat threw off the whole ecosystem.\pHopefully it'll recover someday…\n", MSGBOX_NPC)
	end
}

script SafariZone_WhiteSesameSeed {
	if(flag(FLAG_SANDWICH_GOT_SESAME_SEED)) {
		removeobject(VAR_LAST_TALKED)
		playfanfare(MUS_LEVEL_UP)
		msgbox("{PLAYER} reunited the\nSESAME SEEDS!", MSGBOX_DEFAULT)
		waitfanfare
		msgbox("{PLAYER} put the other SESAME SEED\nin the SANDWICH CASE.", MSGBOX_DEFAULT)
		release
		end
	}
	if(flag(FLAG_TALKED_TO_SARA)) {
		msgbox("SARA: ERIK and I are together, see.\nBut…{PAUSE 20} I'm not so sure anymore.\pHe always forgets about our plans.\nMaybe it's best if we move on.\pIf you see him, could you bring\nhim to me?\lWe need to talk through this.", MSGBOX_SIGN)
		end
	} else {
	setflag(FLAG_TALKED_TO_SARA)
	msgbox("SARA: Oh, where could he be…?\n{PAUSE 20}Ah!\pHello, there. I didn't see you.\nMy name is SARA.\lI am a humble white sesame seed.\pSay, by chance have you run into a\nblack sesame seed?\pHis name is ERIK, and I had\nplanned to meet him here.\lBut…\pLooks like he forgot again.\nJust like last year…\pMaybe the two of us aren't meant\nfor each other after all...", MSGBOX_SIGN)
	}
}

script SafariZone_SesameStealingNerd {
	msgbox("Hey, did you know you only need\none SESAME SEED for a SANDWICH?\pI got lucky and spotted one on\nthe ground over here.\lScore!", MSGBOX_NPC)
	end
}