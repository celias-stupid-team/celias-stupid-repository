mapscripts IndigoPlateauUsed_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setworldmapflag(FLAG_WORLD_MAP_INDIGO_PLATEAU_EXTERIOR) //Tie to fly location eventually
        if(flag(FLAG_SYS_ROTOM_MENU)) {
            setvar(VAR_TEMP_1, 1)
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_1, 1 {
            clearflag(FLAG_SYS_ROTOM_MENU)
            getplayerxy(VAR_TEMP_2, VAR_TEMP_3)
            playmoncry(SPECIES_ROTOM, CRY_MODE_FAINT)
            waitmoncry
            msgbox(
            "Oh, no!\p"

            "The POKéMON LEAGUE's ANTI-ROTOM\n"
            "FORCE FIELD disabled the POKéDEX!", MSGBOX_DEFAULT)
            closemessage
            setvar(VAR_TEMP_1, 0)
            if(var(VAR_TEMP_3) <= 30) {
                applymovement(LOCALID_PLAYER, moves(
                    jump_2_down
                    
                    
                ))
                waitmovement(0)
            }
            release

        }
    ]    
}

script IndigoPlateau_FieldMovesNeededSign {
	msgbox(
	"FIELD MOVES NEEDED:\p"

	"FLY\n"
	"SURF\l"
	"WATERFALL\l"
	"STRENGTH\l"
	"CUT\l"
	"ROCK SMASH\l"
	"ROCK CLIMB\l"
	"RETREAT\l"
	"GROWL", MSGBOX_SIGN)

}

script IndigoPlateau_CharmanderGrowl {
    lock
    textcolor(NPC_TEXT_COLOR_NEUTRAL)
    msgbox(
	"A small girl is in the way.\p"
	"It looks like she's afraid of dragons\n"
	"and dragon-adjacent creatures.", MSGBOX_DEFAULT)
    if(checkpartymove(MOVE_GROWL_CHARMANDER) != PARTY_SIZE) {
        msgbox(
        "Would you like to scare her away\n"
        "with GROWL?", MSGBOX_YESNO)
        if(var(VAR_RESULT)) {
            playmoncry(SPECIES_CHARIZARD, CRY_MODE_DEFAULT)
            waitmoncry
            closemessage
            delay(10)
            playse(SE_PIN)
            applymovement(VAR_LAST_TALKED, moves(
                emote_exclamation_mark
                delay_16 * 3
                lock_facing_direction
                walk_slow_up
                unlock_facing_direction
                delay_16 * 3
            ))
            waitmovement(VAR_LAST_TALKED)
            playse(SE_FLEE)
            applymovement(VAR_LAST_TALKED, moves(
                walk_fast_left * 10
            ))
            waitmovement(VAR_LAST_TALKED)
            removeobject(VAR_LAST_TALKED)
        }
    }
    release
}

script IndigoPlateau_FlySign {
	msgbox(
	"Fly, you fool!\n"
	"", MSGBOX_SIGN)

}
