mapscripts ViridianGym_Falkner_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if(var(VAR_CURRENT_DMCA_PHASE) < 8) {
            setvar(VAR_CURRENT_DMCA_PHASE, 8)
        }
        setrespawn(HEAL_LOCATION_VIRIDIAN_GYM_FALKNER)
        switch(var(VAR_CURRENT_DMCA_PHASE)) {
            case 1:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM, 8)
            case 2:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_2, 8)
            case 3:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_3, 8)
            case 4:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_4, 8)
            case 5:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_5, 8)
            case 6:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_6, 8)
            case 7:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_7, 8)
            case 8:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_8, 8)
            case 9:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_9, 8)
        }
        if(flag(FLAG_BEAT_DMCA_SILVER)) {
            setmaplayoutindex(LAYOUT_VIRIDIAN_GYM_FALKNER_BRIDGE)
        }
    }
}


script ViridianGym_Falkner {
    lock
    textcolor(NPC_TEXT_COLOR_MALE)
	msgbox(
	"???: So.\n"
	"You've come all this way."

    , MSGBOX_DEFAULT)
    closemessage
    delay(30)
    faceplayer
    msgbox("The leader of the DMCA waits in\n"
	"the room behind us.\l"
	"I won't allow you to face him.\p"

	"Your silly bullets won't work on\n"
	"me.\p"

	"You'll need something with REAL\n"
	"IP Infringement to take me down!", MSGBOX_DEFAULT)
    trainerbattle_no_intro(TRAINER_DMCA_FALKNER, "W-wait-!\n"
	"No! Don't-!")
    if(checkpartymon(SPECIES_POKEMON_GUN)) {
        playbgm(MUS_NONE, TRUE)
        delay(60)
        fadescreenswapbuffers(FADE_TO_BLACK)
        delay(20)
        playmoncry(SPECIES_REMORAID, CRY_MODE_DEFAULT)
        delay(60)
        playmoncry(SPECIES_REMORAID, CRY_MODE_DEFAULT)
        delay(30)
        playmoncry(SPECIES_REMORAID, CRY_MODE_DEFAULT)
        delay(120)
        removeobject(LOCALID_DMCA_SILVER)
        removeobject(LOCALID_SILVER_ROADBLOCK)
        fadescreenswapbuffers(FADE_FROM_BLACK)
        delay(60)
        playse(SE_CLICK)
        setlayouttiles(LAYOUT_VIRIDIAN_GYM_FALKNER_BRIDGE, 0,0,0,0,19,39)
					setmaplayoutindex(LAYOUT_VIRIDIAN_GYM_FALKNER_BRIDGE)
        release
        end

    } else {
        msgbox(
        "SHOOT kills you.\n"
        "", MSGBOX_DEFAULT)
        release
    }
}
