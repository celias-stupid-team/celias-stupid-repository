raw `
RockTunnel_1F_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, RockTunnel_1F_OnTransition
	map_script MAP_SCRIPT_ON_LOAD, RockTunnel_1F_OnLoad
	.byte 0



RockTunnel_1F_EventScript_RouteSign::
	msgbox RockTunnel_1F_Text_RouteSign, MSGBOX_SIGN
	end

RockTunnel_1F_EventScript_Lenny::
	trainerbattle_single TRAINER_HIKER_LENNY, RockTunnel_1F_Text_LennyIntro, RockTunnel_1F_Text_LennyDefeat
	msgbox RockTunnel_1F_Text_LennyPostBattle, MSGBOX_AUTOCLOSE
	end

RockTunnel_1F_EventScript_Oliver::
	trainerbattle_single TRAINER_HIKER_OLIVER, RockTunnel_1F_Text_OliverIntro, RockTunnel_1F_Text_OliverDefeat
	msgbox RockTunnel_1F_Text_OliverPostBattle, MSGBOX_AUTOCLOSE
	end

RockTunnel_1F_EventScript_Lucas::
	trainerbattle_single TRAINER_HIKER_LUCAS, RockTunnel_1F_Text_LucasIntro, RockTunnel_1F_Text_LucasDefeat
	msgbox RockTunnel_1F_Text_LucasPostBattle, MSGBOX_AUTOCLOSE
	end

RockTunnel_1F_EventScript_Ashton::
	trainerbattle_single TRAINER_POKEMANIAC_ASHTON, RockTunnel_1F_Text_AshtonIntro, RockTunnel_1F_Text_AshtonDefeat
	msgbox RockTunnel_1F_Text_AshtonPostBattle, MSGBOX_AUTOCLOSE
	end

RockTunnel_1F_EventScript_Leah::
	trainerbattle_single TRAINER_PICNICKER_LEAH, RockTunnel_1F_Text_LeahIntro, RockTunnel_1F_Text_LeahDefeat
	msgbox RockTunnel_1F_Text_LeahPostBattle, MSGBOX_AUTOCLOSE
	end

RockTunnel_1F_EventScript_Ariana::
	trainerbattle_single TRAINER_PICNICKER_ARIANA, RockTunnel_1F_Text_ArianaIntro, RockTunnel_1F_Text_ArianaDefeat
	msgbox RockTunnel_1F_Text_ArianaPostBattle, MSGBOX_AUTOCLOSE
	end

RockTunnel_1F_EventScript_Dana::
	trainerbattle_single TRAINER_PICNICKER_DANA, RockTunnel_1F_Text_DanaIntro, RockTunnel_1F_Text_DanaDefeat
	msgbox RockTunnel_1F_Text_DanaPostBattle, MSGBOX_AUTOCLOSE
	end
`
const X1 = 18
const X2 = 19
const X3 = 20
const X4 = 21
const X5 = 22

const Y1 = 8
const Y2 = 9
const Y3 = 10
const Y4 = 11

script RockTunnel_1F_OnTransition {
	setworldmapflag(FLAG_WORLD_MAP_ROCK_TUNNEL_1F)
	if(!checktrainerflag(TRAINER_POKEMANIAC_STEVE)) {
		setflag(FLAG_TEMP_5)
	}
	if(!flag(FLAG_ELECTIVIRE_SIGN)) {
		setflag(FLAG_TEMP_1)
	}
}

script RockTunnel_1F_OnLoad {
	if(var(VAR_CSR_TURNED_ON_POWER) == 1) { //POWER_ON
		setflashlevel(0)
	} else {
		call(RockTunnel_DrawBlankScreen)
		//special(DrawWholeMapView)
		setflag(FLAG_TEMP_2)
		setflag(FLAG_TEMP_6)
		setflag(FLAG_TEMP_7)
		setflag(FLAG_TEMP_8)
		setflag(FLAG_TEMP_9)
	}
}

script RockTunnel_SoldOut {
	msgbox("Sold out!\nGuess you should come back later.", MSGBOX_SIGN)
	end
}

script RockTunnel_ClefableHint {
	setflag(FLAG_CSR_HINT_CLEFABLE_SHADOW)
	msgbox("I hear that sometimes when CLEFAIRY\nevolves, its SHADOW comes to life.", MSGBOX_NPC)
	end
}

script RockTunnel_DrawBlankScreen {
	
		setmetatile(X1, Y1, 0x31B, TRUE)
		setmetatile(X2, Y1, 0x33D, TRUE)
		setmetatile(X3, Y1, 0x33D, TRUE)
		setmetatile(X4, Y1, 0x33D, TRUE)
		setmetatile(X5, Y1, 0x33A, TRUE)
		
		setmetatile(X1, Y2, 0x31B, TRUE)
		setmetatile(X2, Y2, 0x33D, TRUE)
		setmetatile(X3, Y2, 0x33D, TRUE)
		setmetatile(X4, Y2, 0x33D, TRUE)
		setmetatile(X5, Y2, 0x33A, TRUE)
		
		setmetatile(X1, Y3, 0x31B, TRUE)
		setmetatile(X2, Y3, 0x33D, TRUE)
		setmetatile(X3, Y3, 0x33D, TRUE)
		setmetatile(X4, Y3, 0x33D, TRUE)
		setmetatile(X5, Y3, 0x33A, TRUE)
		
		setmetatile(X1, Y4, 0x31B, TRUE)
		setmetatile(X2, Y4, 0x33D, TRUE)
		setmetatile(X3, Y4, 0x33D, TRUE)
		setmetatile(X4, Y4, 0x33D, TRUE)
		setmetatile(X5, Y4, 0x33A, TRUE)
		return
}

const HINT_GIRL = 1
script RockTunnel_PokemonSign {
	lock
	if(var(VAR_CSR_TURNED_ON_POWER) == 0) { //POWER_OFF
		msgbox("A projector screen is set up\nagainst the wall of the cave.", MSGBOX_DEFAULT)
		release
		end
	}
	msgbox("A silhouette can be seen projected\nfrom behind.\pIt looks to be a shadow of its\nformer self.", MSGBOX_DEFAULT)
	if(!flag(FLAG_ELECTIVIRE_SIGN)) {
		closemessage
		playfanfare(MUS_SLOTS_WIN)
		msgbox("{PLAYER} discovered a POKéMON SIGN!\n", MSGBOX_DEFAULT)
		waitfanfare
		setflag(FLAG_ELECTIVIRE_SIGN)
		addobject(HINT_GIRL)

		clearflag(FLAG_TEMP_1)
	}
	release
	end
}

script RockTunnel_CavePeople {
	lock
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox("He's transfixed by the shadow on\nthe wall.\pHe does not consider your presence.\n", MSGBOX_DEFAULT)
	release
	end
}

script RockTunnel_LightsOutlet {
	if(var(VAR_CSR_TURNED_ON_POWER) == 1) { //POWER_ON
		msgbox("A perfectly-sized fork recepticle.\n", MSGBOX_SIGN)
	} else {
		msgbox("The lights are plugged in, but\nthe power is off.", MSGBOX_SIGN)
	}
}


script RockTunnel_LightsOut {
	if(var(VAR_CSR_TURNED_ON_POWER)) {
		msgbox("Oh, yay!\nThe POWER's back on!\pWe have a great display down there.\nWhy don't you check it out?", MSGBOX_NPC)
	} else {
		msgbox("Hmm…\pWe had a special show set up\nwith our light stands.\lWithout POWER, we can't do it.\pHopefully the POWER PLANT will\ncome back on soon…", MSGBOX_NPC)
	}
	end
}

script RockTunnel_Statistician {
	msgbox("Why, hello!\nI'm a STATISTICIAN!\pI'm conducting a survey to analyze\naverage annual spider consumption.\pDo you have a minute to answer\nsome questions?", MSGBOX_NPC)
	end
}

script RockTunnel_Lucario {
	lock
	playmoncry(SPECIES_LUCARIO, CRY_MODE_DEFAULT)
	msgbox("LUCARIO: Carrr?\n", MSGBOX_DEFAULT)
	waitmoncry
	playse(SE_PIN)
	applymovement(VAR_LAST_TALKED, Movement_QuestionMark)
	closemessage
	delay(60)
	msgbox("The POKéMON looks exceedingly\nconfused.", MSGBOX_DEFAULT)
	release
}

movement Movement_QuestionMark {
	emote_question_mark
}

script RockTunnel_ImpressedNerd {
	lock
	msgbox("Wow!\nThat's an awesome costume!\pWhere'd you get it?\n", MSGBOX_DEFAULT)
	release
}

script RockTunnel_MaidPsyduck {
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox("I'm dressed like a MAID as\nPROF. OAK's POKéMON.", MSGBOX_NPC)
	end
}

script RockTunnel_BillNerd {
	msgbox("Have you heard of a POKéMANIAC\nnamed BILL?\lHe's a legend around here.\pThey say he even turned himself\ninto a POKéMON!\pBut…\nNo one's heard from him in a while.\pI hope he's okay.\n", MSGBOX_NPC)
	end
}

const BUYER = 26

const MERCHANT = 21
const CLEFAIRY1 = 23
const CLEFAIRY2 = 22
const CLEFAIRY3 = 20
script RockTunnel_MerchSeller {
	lock
	faceplayer
	msgbox("Hey hey!\nWelcome to the MERCH table!\pWanna buy a life-sized CLEFAIRY\ndoll?\lThey're perfect for snuggling!\pWe've got a discount right now.\nOnly ¥100,000,000 each!", MSGBOX_YESNO)
	closemessage
	
	setobjectxy(BUYER, 16, 27)
	applymovement(BUYER, RockTunnel_NerdBuysStuff)
	applymovement(CLEFAIRY1, RockTunnel_Clefairy1)
	applymovement(CLEFAIRY2, RockTunnel_Clefairy2)
	applymovement(CLEFAIRY3, RockTunnel_Clefairy3)
	msgbox("Oh… You can't afford one?\nDarn!\pThat's okay, though.\nMaybe you'll get one next time!", MSGBOX_DEFAULT)
	closemessage
	waitmovement(BUYER)
	delay(10)
	applymovement(BUYER, RockTunnel_WalkInPlace)
	delay(16)
	applymovement(MERCHANT, Common_Movement_FaceRight)
	waitmovement(BUYER)
	delay(10)
	textcolor(NPC_TEXT_COLOR_MALE)
	msgbox("Hi! I have a bit of spending money\nleft over.\pI'll just take a few DOLLS.\nThe craftsmanship is lovely!", MSGBOX_DEFAULT)
	closemessage
	delay(10)
	applymovement(VAR_LAST_TALKED, Common_Movement_FaceRight)
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox("Aha!\nAnother passionate CLEFAIRY fan!\lHere you are!", MSGBOX_DEFAULT)
	playse(SE_SHOP)
	waitse
	msgbox("Thanks for the support!\n", MSGBOX_DEFAULT)
	closemessage
	fadescreen(FADE_TO_BLACK)
	setobjectxy(BUYER, 14, 17)
	applymovement(MERCHANT, Common_Movement_FaceDown)
	applymovement(CLEFAIRY1, Common_Movement_SetVisible)
	applymovement(CLEFAIRY2, Common_Movement_SetVisible)
	applymovement(CLEFAIRY3, Common_Movement_SetVisible)
	applymovement(BUYER, Common_Movement_SetInvisible)
	delay(20)
	fadescreen(FADE_FROM_BLACK)
	msgbox("There!\nAll stocked up!", MSGBOX_DEFAULT)
	release
	end
}

movement RockTunnel_WalkInPlace {
	walk_in_place_left * 2
	face_left
}

movement RockTunnel_NerdBuysStuff {
	set_visible
	walk_up * 7
	face_up
	delay_16
	walk_left
	face_up
	delay_16
	walk_left
	face_up
	delay_16
	face_left
}

movement RockTunnel_Clefairy1 {
	delay_16 * 8
	delay_8
	set_invisible

}

movement RockTunnel_Clefairy2 {
	delay_16 * 10
	delay_8
	set_invisible

}

movement RockTunnel_Clefairy3 {
	delay_16 * 12
	delay_8
	set_invisible
}


script RockTunnel_Pokemaniac {
	msgbox("Another year, another successful\nPOKéMANIAC CONVENTION!\pHopefully next time they won't\nshove us all into a cave.", MSGBOX_NPC)
	end
}


script RockTunnel_PokeDoll {
	lock
	playfanfare(MUS_LEVEL_UP)
	applymovement(VAR_LAST_TALKED, Common_Movement_SetInvisible)
	msgbox("{PLAYER} found a POKé DOLL!\n", MSGBOX_DEFAULT)
	waitfanfare
	closemessage
	delay(10)
	playse(SE_PIN)
	applymovement(MERCHANT, RockTunnel_MerchantLooksOver)
	textcolor(NPC_TEXT_COLOR_FEMALE)
	delay(45)
	msgbox("Hey!\n", MSGBOX_DEFAULT)
	closemessage
	getplayerxy(VAR_TEMP_4, VAR_TEMP_5)
	switch(var(VAR_TEMP_4)) {
		case 15:
			applymovement(MERCHANT, RockTunnel_WalkRightTwo)
		case 16:
			applymovement(MERCHANT, RockTunnel_WalkRightThree)
		default:
			applymovement(MERCHANT, Common_Movement_WalkRight)
	}
	delay(16)
	applymovement(LOCALID_PLAYER, Common_Movement_FaceLeft)
	waitmovement(MERCHANT)
	msgbox("Those DOLLS aren't free!\nYou can't just take one!", MSGBOX_DEFAULT)
	closemessage
	delay(15)
	applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
	delay(30)
	playse(SE_BALL)
	applymovement(VAR_LAST_TALKED, Common_Movement_SetVisible)
	delay(30)
	switch(var(VAR_TEMP_4)) {
		case 15:
			applymovement(MERCHANT, RockTunnel_WalkLeftTwo)
		case 16:
			applymovement(MERCHANT, RockTunnel_WalkLeftThree)
		default:
			applymovement(MERCHANT, Common_Movement_WalkLeft)
	}
	waitmovement(MERCHANT)
	applymovement(MERCHANT, Common_Movement_FaceDown)
	waitmovement(0)
	release

}

movement RockTunnel_MerchantLooksOver {
	face_right
	emote_exclamation_mark
}

movement RockTunnel_WalkRightTwo {
	walk_right * 2
	face_right
}


movement RockTunnel_WalkLeftTwo {
	walk_left * 2
}

movement RockTunnel_WalkRightThree {
	walk_right * 3
	face_right
}


movement RockTunnel_WalkLeftThree {
	walk_left * 3
}

movement RockTunnel_Buyer {

}

