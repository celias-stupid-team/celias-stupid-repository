raw `
RockTunnel_1F_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, RockTunnel_1F_OnTransition
	.byte 0



RockTunnel_1F_EventScript_RouteSign::
	msgbox RockTunnel_1F_Text_RouteSign, MSGBOX_SIGN
	end

RockTunnel_1F_EventScript_Lenny::
	trainerbattle_single TRAINER_HIKER_LENNY, RockTunnel_1F_Text_LennyIntro, RockTunnel_1F_Text_LennyDefeat
	msgbox RockTunnel_1F_Text_LennyPostBattle, MSGBOX_AUTOCLOSE
	end

RockTunnel_1F_EventScript_Oliver::
	trainerbattle_single TRAINER_HIKER_OLIVER, RockTunnel_1F_Text_OliverIntro, RockTunnel_1F_Text_OliverDefeat
	msgbox RockTunnel_1F_Text_OliverPostBattle, MSGBOX_AUTOCLOSE
	end

RockTunnel_1F_EventScript_Lucas::
	trainerbattle_single TRAINER_HIKER_LUCAS, RockTunnel_1F_Text_LucasIntro, RockTunnel_1F_Text_LucasDefeat
	msgbox RockTunnel_1F_Text_LucasPostBattle, MSGBOX_AUTOCLOSE
	end

RockTunnel_1F_EventScript_Ashton::
	trainerbattle_single TRAINER_POKEMANIAC_ASHTON, RockTunnel_1F_Text_AshtonIntro, RockTunnel_1F_Text_AshtonDefeat
	msgbox RockTunnel_1F_Text_AshtonPostBattle, MSGBOX_AUTOCLOSE
	end

RockTunnel_1F_EventScript_Leah::
	trainerbattle_single TRAINER_PICNICKER_LEAH, RockTunnel_1F_Text_LeahIntro, RockTunnel_1F_Text_LeahDefeat
	msgbox RockTunnel_1F_Text_LeahPostBattle, MSGBOX_AUTOCLOSE
	end

RockTunnel_1F_EventScript_Ariana::
	trainerbattle_single TRAINER_PICNICKER_ARIANA, RockTunnel_1F_Text_ArianaIntro, RockTunnel_1F_Text_ArianaDefeat
	msgbox RockTunnel_1F_Text_ArianaPostBattle, MSGBOX_AUTOCLOSE
	end

RockTunnel_1F_EventScript_Dana::
	trainerbattle_single TRAINER_PICNICKER_DANA, RockTunnel_1F_Text_DanaIntro, RockTunnel_1F_Text_DanaDefeat
	msgbox RockTunnel_1F_Text_DanaPostBattle, MSGBOX_AUTOCLOSE
	end
`
const X1 = 18
const X2 = 19
const X3 = 20
const X4 = 21
const X5 = 22

const Y1 = 8
const Y2 = 9
const Y3 = 10
const Y4 = 11

script RockTunnel_1F_OnTransition {
	setworldmapflag(FLAG_WORLD_MAP_ROCK_TUNNEL_1F)
	if(!checktrainerflag(TRAINER_POKEMANIAC_STEVE)) {
		setflag(FLAG_TEMP_5)
	}
	if(var(VAR_CSR_TURNED_ON_POWER)) {
		setflashlevel(0)
	} else {
		setmetatile(X1, Y1, 0x31B, TRUE)
		setmetatile(X2, Y1, 0x33D, TRUE)
		setmetatile(X3, Y1, 0x33D, TRUE)
		setmetatile(X4, Y1, 0x33D, TRUE)
		setmetatile(X5, Y1, 0x33A, TRUE)
		
		setmetatile(X1, Y2, 0x31B, TRUE)
		setmetatile(X2, Y2, 0x33D, TRUE)
		setmetatile(X3, Y2, 0x33D, TRUE)
		setmetatile(X4, Y2, 0x33D, TRUE)
		setmetatile(X5, Y2, 0x33A, TRUE)
		
		setmetatile(X1, Y3, 0x31B, TRUE)
		setmetatile(X2, Y3, 0x33D, TRUE)
		setmetatile(X3, Y3, 0x33D, TRUE)
		setmetatile(X4, Y3, 0x33D, TRUE)
		setmetatile(X5, Y3, 0x33A, TRUE)
		
		setmetatile(X1, Y4, 0x31B, TRUE)
		setmetatile(X2, Y4, 0x33D, TRUE)
		setmetatile(X3, Y4, 0x33D, TRUE)
		setmetatile(X4, Y4, 0x33D, TRUE)
		setmetatile(X5, Y4, 0x33A, TRUE)

		setflag(FLAG_TEMP_2)
	}
	setflag(FLAG_TEMP_1)
}

script RockTunnel_ClefableHint {
	msgbox("I hear that sometimes when CLEFABLE\nevolves, its SHADOW comes to life.", MSGBOX_NPC)
	end
}


const HINT_GIRL = 1
script RockTunnel_PokemonSign {
	lock
	if(!var(VAR_CSR_TURNED_ON_POWER)) {
		msgbox("A projector screen is set up\nagainst the wall of the cave.", MSGBOX_DEFAULT)
		release
		end
	}
	msgbox("A silhouette can be seen projected\nfrom behind.\pIt looks to be a shadow of its\nformer self.", MSGBOX_DEFAULT)
	if(!flag(FLAG_ELECTIVIRE_SIGN)) {
		closemessage
		playfanfare(MUS_SLOTS_WIN)
		msgbox("{PLAYER} discovered a POKéMON SIGN!\n", MSGBOX_DEFAULT)
		waitfanfare
		setflag(FLAG_ELECTIVIRE_SIGN)
		addobject(HINT_GIRL)

		clearflag(FLAG_TEMP_1)
	}
	release
	end
}

script RockTunnel_CavePeople {
	lock
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox("He's transfixed by the shadow on\nthe wall.\pHe does not consider your presence.\n", MSGBOX_DEFAULT)
	release
	end
}

script RockTunnel_LightsOutlet {
	if(var(VAR_CSR_TURNED_ON_POWER)) {
		msgbox("A perfectly-sized fork recepticle.\n", MSGBOX_SIGN)
	} else {
		msgbox("The lights are plugged in, but\nthe power is off.", MSGBOX_SIGN)
	}
}


script RockTunnel_LightsOut {
	if(var(VAR_CSR_TURNED_ON_POWER)) {
		msgbox("the lights are on yay\n", MSGBOX_NPC)
	} else {
		msgbox("Oh hey, thanks for lighting\nthe cave up with your POKéMON!\lBut…\pWell, we had a special show set\nup with our light stands.\lWithout POWER, we can't do it!\pHopefully the POWER PLANT will\ncome back on soon…", MSGBOX_NPC)
	}
	end
}

script RockTunnel_Statistician {
	msgbox("Why, hello!\nI'm a STATISTICIAN!\pI'm conducting a survey to analyze\nhow many spiders people eat.\pDo you have a minute to answer\nsome questions?", MSGBOX_NPC)
	end
}

script RockTunnel_Lucario {
	lock
	playmoncry(SPECIES_LUCARIO, CRY_MODE_DEFAULT)
	msgbox("LUCARIO: Carrr?\n", MSGBOX_DEFAULT)
	waitmoncry
	playse(SE_PIN)
	applymovement(VAR_LAST_TALKED, Movement_QuestionMark)
	closemessage
	delay(60)
	msgbox("The POKéMON looks exceedingly\nconfused.", MSGBOX_DEFAULT)
	release
}

movement Movement_QuestionMark {
	emote_question_mark
}

script RockTunnel_ImpressedNerd {
	lock
	msgbox("Wow!\nThat's an awesome costume!\pWhere'd you get it?\n", MSGBOX_DEFAULT)
	release
}

script RockTunnel_MaidPsyduck {
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox("I'm dressed like a MAID as\nPROF. OAK's POKéMON.", MSGBOX_NPC)
	end
}

script RockTunnel_BillNerd {
	msgbox("Have you heard of a POKéMANIAC\nnamed BILL?\lHe's a legend around here.\pThey say he even turned himself\ninto a POKéMON!\pBut…\nNo one's heard from him in a while.\pI hope he's okay.\n", MSGBOX_NPC)
	end
}

script RockTunnel_MerchSeller {
	msgbox("I've been making bank off my\nlife-sized CLEFAIRY DOLLS.", MSGBOX_NPC)
	end
}

script RockTunnel_Pokemaniac {
	msgbox("Another year, another successful\nPOKéMANIAC CONVENTION!\pHopefully next time they won't\nshove us all into a cave.", MSGBOX_NPC)
	end
}