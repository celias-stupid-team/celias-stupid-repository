raw `


PokemonLeague_LancesRoom_OnResume::
	setvar VAR_0x8004, 3
	call PokemonLeague_EventScript_DoLightingEffect
	end

PokemonLeague_LancesRoom_OnLoad::
	setflag FLAG_TEMP_6
	setflag FLAG_SHINY_CREATION
	call_if_eq VAR_POKEMON_LEAGUE_PHASE, 4, PokemonLeague_LancesRoom_EventScript_CloseEntry
	call_if_set FLAG_DEFEATED_LANCE, PokemonLeague_LancesRoom_EventScript_SetDoorOpen
	end

PokemonLeague_LancesRoom_EventScript_CloseEntry::
	call PokemonLeague_LancesRoom_EventScript_SetEntryClosed
	return

PokemonLeague_LancesRoom_EventScript_SetDoorOpen::
	call PokemonLeague_EventScript_SetDoorOpenLance
	return

PokemonLeague_LancesRoom_OnWarp::
	map_script_2 VAR_TEMP_1, 0, PokemonLeague_LancesRoom_EventScript_TurnPlayerNorth
	.2byte 0

PokemonLeague_LancesRoom_EventScript_TurnPlayerNorth::
	turnobject LOCALID_PLAYER, DIR_NORTH
	end

PokemonLeague_LancesRoom_OnFrame::
	map_script_2 VAR_POKEMON_LEAGUE_PHASE, 3, PokemonLeague_LancesRoom_EventScript_EnterRoom
	.2byte 0

PokemonLeague_LancesRoom_EventScript_EnterRoom::
	lockall
	applymovement LOCALID_PLAYER, PokemonLeague_LancesRoom_Movement_WalkThroughCorridor
	waitmovement 0
	setflag FLAG_TEMP_2
	call PokemonLeague_LancesRoom_EventScript_SetEntryClosed
	delay 30
	playse SE_UNLOCK
	special DrawWholeMapView
	waitse
	setvar VAR_POKEMON_LEAGUE_PHASE, 4
	releaseall
	end

PokemonLeague_LancesRoom_EventScript_SetEntryClosed::
	setmetatile 5, 21, METATILE_PokemonLeague_Entry_TopLeft_Closed, 1
	setmetatile 6, 21, METATILE_PokemonLeague_Entry_TopMid_Closed, 1
	setmetatile 7, 21, METATILE_PokemonLeague_Entry_TopRight_Closed, 1
	setmetatile 5, 22, METATILE_PokemonLeague_Entry_BottomLeft_Closed, 1
	setmetatile 6, 22, METATILE_PokemonLeague_Entry_BottomMid_Closed, 1
	setmetatile 7, 22, METATILE_PokemonLeague_Entry_BottomRight_Closed, 1
	setmetatile 6, 23, METATILE_PokemonLeague_Floor_ShadeFull_Lance, 0
	setmetatile 7, 23, METATILE_PokemonLeague_Floor_ShadeFull_Lance, 0
	return

PokemonLeague_LancesRoom_Movement_WalkThroughCorridor::
	walk_up
	walk_up
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	step_end



PokemonLeague_LancesRoom_EventScript_Intro::
	msgbox PokemonLeague_LancesRoom_Text_Intro
	return

PokemonLeague_LancesRoom_EventScript_RematchIntro::
	msgbox PokemonLeague_LancesRoom_Text_Intro
	return

PokemonLeague_LancesRoom_EventScript_Battle::
	trainerbattle_no_intro TRAINER_ELITE_FOUR_LANCE, PokemonLeague_LancesRoom_Text_Defeat
	return

PokemonLeague_LancesRoom_EventScript_Rematch::
	trainerbattle_no_intro TRAINER_ELITE_FOUR_LANCE, PokemonLeague_LancesRoom_Text_Defeat
	return

PokemonLeague_LancesRoom_EventScript_PostBattle::
	msgbox PokemonLeague_LancesRoom_Text_PostBattle
	release
	end


PokemonLeague_LancesRoom_EventScript_LanceMoveOutOfWayLeft::
	applymovement LOCALID_LANCE, PokemonLeague_LancesRoom_Movement_LanceMoveOutOfWayLeft
	waitmovement 0
	return

PokemonLeague_LancesRoom_EventScript_LanceMoveOutOfWayRight::
	applymovement LOCALID_LANCE, PokemonLeague_LancesRoom_Movement_LanceMoveOutOfWayRight
	waitmovement 0
	return

PokemonLeague_LancesRoom_Movement_LanceMoveOutOfWayLeft::
	walk_left
	walk_in_place_faster_right
	step_end

PokemonLeague_LancesRoom_Movement_LanceMoveOutOfWayRight::
	walk_right
	walk_in_place_faster_left
	step_end
`

mapscripts PokemonLeague_LancesRoom_MapScripts {
	MAP_SCRIPT_ON_RESUME: PokemonLeague_LancesRoom_OnResume
	MAP_SCRIPT_ON_LOAD: PokemonLeague_LancesRoom_OnLoad
	MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE: PokemonLeague_LancesRoom_OnWarp
	MAP_SCRIPT_ON_FRAME_TABLE: PokemonLeague_LancesRoom_OnFrame
	MAP_SCRIPT_ON_TRANSITION {
		setflag(FLAG_TEMP_A)
	}

}
script PokemonLeague_LancesRoom_EventScript_Lance {
	lock
	faceplayer
	clearflag(FLAG_SHINY_CREATION)
	
	textcolor(NPC_TEXT_COLOR_FEMALE)
	goto_if_set(FLAG_DEFEATED_LANCE, PokemonLeague_LancesRoom_EventScript_PostBattle)
	playbgm(MUS_ENCOUNTER_MAY, TRUE)
	call_if_unset(FLAG_SYS_GAME_CLEAR, PokemonLeague_LancesRoom_EventScript_Intro)
	call_if_set(FLAG_SYS_GAME_CLEAR, PokemonLeague_LancesRoom_EventScript_Intro)
	setflag(FLAG_TEMP_3)
	setflag(FLAG_TEMP_5)
	call_if_unset(FLAG_SYS_CAN_LINK_WITH_RS, PokemonLeague_LancesRoom_EventScript_Battle)
	call_if_set(FLAG_SYS_CAN_LINK_WITH_RS, PokemonLeague_LancesRoom_EventScript_Rematch)
	clearflag(FLAG_TEMP_5)
	goto(PokemonLeague_LancesRoom_EventScript_DefeatedLance)
}

script PokemonLeague_LancesRoom_EventScript_DefeatedLance {
	textcolor(NPC_TEXT_COLOR_FEMALE)
	setvar(VAR_0x8004, 0)
	//special(Script_TryGainNewFanFromCounter)
	setflag(FLAG_DEFEATED_LANCE)
	call(PokemonLeague_EventScript_OpenDoorLance)
	msgbox(
	"MAY: {PLAYER}, you've been busy\n"
	"training, too, haven't you?\p"

	"I think you deserve a reward!\n"
	"This is from me!", MSGBOX_DEFAULT)
	giveitem_msg("{PLAYER} got the ITEMFINDER!\n", ITEM_ITEMFINDER, 1)
	waitfanfare
	setvar(VAR_LANCE_LASS_ATTACK, 1)
	msgbox(
	"MAY: That's an ITEMFINDER.\p"

	"Try it out. If there is an item that's\n"
	"not visible, it emits a sound.\p"

	"Okay, {PLAYER}, let's meet again!\p"

	"I know it's a little silly coming from\n"
	"me, but I think you should train a\l"
	"lot harder for the next time.", MSGBOX_DEFAULT)
	fadenewbgm(MUS_NONE)
	setflag(FLAG_SHINY_CREATION)
	closemessage
	release
}

script MayRoom_LassAttack {
    lock
    waitse
	setflag(FLAG_POST_GAME)
    textcolor(NPC_TEXT_COLOR_FEMALE)
    setvar(VAR_LANCE_LASS_ATTACK, 2)
    textcolor(NPC_TEXT_COLOR_FEMALE)
    addobject(LANCE_LASS)
    applymovement(LANCE_LASS, moves(
        face_up
    ))
    playbgm(MUS_NONE, TRUE)    
	setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 2)
    setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 2)
    setvar(VAR_SHAKESCREEN_NUM_SHAKES, 3)
    setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
    special(ShakeScreen)
    delay(60)
	special(SpawnCameraObject)
	applymovement(LOCALID_CAMERA, moves(
		walk_slow_down * 9
	))
	delay(45)
    playse(SE_M_STRENGTH)
    setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 4)
    setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 4)
    setvar(VAR_SHAKESCREEN_NUM_SHAKES, 5)
    setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
    special(ShakeScreen)
    delay(60)
    playse(SE_M_STRENGTH)
    setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 4)
    setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 4)
    setvar(VAR_SHAKESCREEN_NUM_SHAKES, 5)
    setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
    special(ShakeScreen)
    delay(60)
    setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 4)
    setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 4)
    setvar(VAR_SHAKESCREEN_NUM_SHAKES, 5)
    setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
    special(ShakeScreen)
	waitmovement(0)
	delay(30)
    playse(SE_EFFECTIVE)
	fadescreeninstant(FADE_TO_WHITE)
	addobject(LANCE_LASS)
	setobjectxy(LANCE_LASS, 6, 19)
	setlayouttiles(LAYOUT_POKEMON_LEAGUE_LANCES_ROOM, 0, 0, 0, 0, 26, 29)
	setmaplayoutindex(LAYOUT_POKEMON_LEAGUE_LANCES_ROOM)
	special(DrawWholeMapView)
	applymovement(LANCE_LASS, moves(
		face_up
		set_visible
	))
	delay(10)
	fadescreeninstant(FADE_FROM_WHITE)
	//sound effect
	playse(SE_BANG)
	delay(60)
	applymovement(LANCE_LASS, moves(
		walk_slow_up * 2
		face_up
		delay_16 * 2
		walk_slow_up * 2
		face_up
		delay_16 * 2
		walk_slow_up * 2
		face_up
		delay_16
	))
	applymovement(LOCALID_CAMERA, moves(
		delay_16 * 10
		walk_slow_up * 2
		delay_16
		)
	)
	textcolor(NPC_TEXT_COLOR_FEMALE)
	delay(30)
	message(
		"Don't…{PAUSE 60} look…{PAUSE 60} at…{PAUSE 60}\n"
		"")
	waitmovement(LANCE_LASS)
	waitmovement(0)
	delay(30)
	closemessage
	delay(30)
	//sound effect
	fadescreeninstant(FADE_TO_WHITE)
	delay(40)
	removeobject(LANCE_LASS)
	addobject(LOCALID_LANCE_FALLENLASS)
	clearflag(FLAG_TEMP_6)
	//add fallen lass
	playse(SE_EFFECTIVE)
	fadescreeninstant(FADE_FROM_WHITE)
	delay(120)
	waitmovement(LOCALID_CAMERA)
	call(PokemonLeague_LancesRoom_EventScript_SetEntryClosed)
	call(PokemonLeague_EventScript_OpenDoorLance)
	applymovement(LOCALID_CAMERA, moves(
		walk_slow_up * 7
	))
	waitmovement(LOCALID_CAMERA)
	special(RemoveCameraObject)
	release
}

script MayRoom_LassDead {
	msgbox(
	"She's not moving…\p"

	"Now you can look at her!\n"
	"", MSGBOX_SIGN)

}


script MayRoom_Dad {
	lock
	faceplayer
	textcolor(0)
	msgbox(
	"DAD: {PLAYER}!\n"
	"There you are!\l"
	"I saw you a minute ago.\p"

	"That girl who ran through here\n"
	"really made a mess.\l"
	"I think all the doors are open!\p"

	"Well, never mind that.\n"
	"How about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}