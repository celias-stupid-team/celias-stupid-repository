mapscripts Minnesota_Hospital_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setrespawn(HEAL_LOCATION_MINNESOTA)
	}
}


script MinnesotaHospital_Billionaires {
	msgbox(
	"The POKéMON world has universal\n"
	"healthcare for animals, but America\l"
	"only has it for billionaires!", MSGBOX_NPC)
}

script MinnesotaHospital_Nurse {
    lock
	textcolor(NPC_TEXT_COLOR_RED)
    msgbox(
	"Welcome to the MINNESOTA Hospital.\n"
	"Would you like an appointment?", MSGBOX_YESNO)
    if(var(VAR_RESULT)) {
        msgbox(
        "Are you sure?\n"
        "", MSGBOX_YESNO)
        if(var(VAR_RESULT)) {
            msgbox(
            "Are you REALLY sure?\n"
            "", MSGBOX_YESNO)
            if(var(VAR_RESULT)) {
                msgbox(
                "All right, if you insist.\p"

                "That'll be ¥2,000,000.\n"
                "{PAUSE 30}Cash or card?", MSGBOX_DEFAULT)
                release
                end
            }
        }
    }
    
	msgbox(
	"As an American healthcare worker,\n"
	"I fucking hate your guts.\l"
	"Good bye.", MSGBOX_DEFAULT)
    release
}


script Hospital_ColorTheory {
	msgbox(
	"Wow!\p"

	"The color in this corner is giving\n"
	"plenty of positive associations!", MSGBOX_SIGN)

}

script Hospital_BudgetCuts {
    textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"Due to budget cuts, we've moved\n"
	"all patients to the waiting room.\p"

	"I know you may be concerned, but\n"
	"don't worry.\p"

	"This is all done for the health\n"
	"and safety of our shareholders!", MSGBOX_NPC)
}

script Hospital_Dad {
	lock
	faceplayer
	textcolor(0)
	msgbox(
	"DAD: {PLAYER}!{PAUSE 30} cough…\n"
	"What are you doing here?\p"

	"It seems I caught the flu.\n"
	"cough…\l"
	"I need some time to recover.\p"

	"But never mind that.\n"
	"How about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}

script Hospital_AshDreams {
    lock
    faceplayer
    textcolor(NPC_TEXT_COLOR_FEMALE)
    msgbox(
	"I swear, this patient has\n"
	"the wildest dreams-!", MSGBOX_DEFAULT)
    closemessage
    applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    release
}

script Hospital_AshComa {
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox(
	"He's in a coma…\n"
	"", MSGBOX_SIGN)

}


script Hospital_BedSniff {
	msgbox(
	"{PLAYER} laid in the bed…\p"

	"Mmm…\n"
	"Smells like antiseptic!\p"

	"That'll be ¥100,000.\n"
	"Pay up.", MSGBOX_SIGN)

}

script Hospital_IV_Drip {
	msgbox(
	"This one's an IV Drip!\n"
	"", MSGBOX_SIGN)

}

script Hospital_EV_Drip {
	msgbox(
	"This one's an EV Drip!\n"
	"", MSGBOX_SIGN)

}


script Hospital_XRay {
	msgbox(
	"It's a MOON STONE-powered\n"
	"X-Ray machine!", MSGBOX_SIGN)

}


script Hospital_Gentleman {
	msgbox(
	"Hmm, there's no free-to-use PC\n"
	"here in the hospital.\p"

	"I guess they got tired of removing\n"
	"all the viruses on it!", MSGBOX_NPC)
}

script Hospital_Stunfisk {
	msgbox(
	"Oh, no!\n"
	"The patient is flat", MSGBOX_SIGN)

}

script Hospital_Duck {
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"I'm giving FIRST AID as PROF.\n"
	"OAK's POKéMON.", MSGBOX_NPC)
}


script Hospital_GrandpaWoman {
	lock
	if(flag(FLAG_TEMP_1)) {
		msgbox(
		"…{PAUSE 30}Oh, no!\n"
		"", MSGBOX_DEFAULT)
	} else {
		msgbox(
		"C'mon, grandpa!\n"
		"I know you can make it!", MSGBOX_DEFAULT)
	}
	release
}

script Hospital_Grandpa {
	lock
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	if(flag(FLAG_TEMP_1)) {
		msgbox(
			"The old man is now dead."
			"", MSGBOX_DEFAULT)
	} else {
		msgbox(
		"An old man lays in the bed.\p"

		"It appears he's suffering from\n"
		"severe EXPLOSION wounds.", MSGBOX_DEFAULT)
	}
	release
}

script Hospital_GrandpaMachine {
	lock
	if(flag(FLAG_TEMP_1)) {
		msgbox(
		"The fancy medical device seems to\n"
		"have stopped working.", MSGBOX_DEFAULT)
		release
		end
	}
	msgbox(
	"A fancy medical device is hooked\n"
	"up to the patient.", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	playse(SE_PC_LOGIN)
	specialvar(VAR_TEMP_0, GetPlayerFacingDirection)
	switch(var(VAR_TEMP_0)) {
		case DIR_NORTH: 
			applymovement(LOCALID_PLAYER, moves(
				walk_in_place_up * 2
				face_up
			))

		
		case DIR_SOUTH: 
			applymovement(LOCALID_PLAYER, moves(
				walk_in_place_down * 2
				face_up
			))

		
		case DIR_WEST: 
			applymovement(LOCALID_PLAYER, moves(
				walk_in_place_left * 2
				face_up
			))

		
		case DIR_EAST: 
			applymovement(LOCALID_PLAYER, moves(
				walk_in_place_right * 2
				face_up
			))

		
	}
	msgbox(
	"{PLAYER} kicked the machine.\n"
	"", MSGBOX_DEFAULT)
	setflag(FLAG_TEMP_1)
	waitmovement(0)
	release
}