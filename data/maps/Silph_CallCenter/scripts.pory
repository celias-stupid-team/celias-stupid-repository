script Silph_NervousOfficeWorker {
	lock
	faceplayer
	msgbox(
	"Despite how the WARPS make it seem,\n"
	"we're directly below R&D right now.\p"

	"Their experiments regularly make\n"
	"the whole floor shake.\p"

	"Some days, I'm scared the ceiling\n"
	"is gonna cave in…", MSGBOX_DEFAULT)
	closemessage
	applymovement(VAR_LAST_TALKED, moves(
		face_original_direction
	))
	waitmovement(0)
	release

}

script Silph_TourGuide {
	lock
	faceplayer
	msgbox(
	"Wha-?\n"
	"Oh, um. Hello.", MSGBOX_DEFAULT)
	closemessage
	applymovement(VAR_LAST_TALKED, moves(
		face_up
	))
	delay(45)
	msgbox(
	"W{PAUSE 2}e{PAUSE 2}l{PAUSE 2}c{PAUSE 2}o{PAUSE 2}m{PAUSE 2}e{PAUSE 2} t{PAUSE 2}o S{PAUSE 2}I{PAUSE 2}L{PAUSE 2}P{PAUSE 2}H {PAUSE 4}C{PAUSE 2}O{PAUSE 2}.\p"

	"I {PAUSE 2}h{PAUSE 2}o{PAUSE 2}p{PAUSE 2}e{PAUSE 2} y{PAUSE 2}o{PAUSE 2}u{PAUSE 2}r{PAUSE 2} d{PAUSE 2}a{PAUSE 2}y {PAUSE 2}i{PAUSE 2}s{PAUSE 8} m{PAUSE 2}a{PAUSE 2}g{PAUSE 2}n{PAUSE 2}i{PAUSE 2}f{PAUSE 2}i{PAUSE 2}c{PAUSE 2}e{PAUSE 2}n{PAUSE 2}t{PAUSE 2}l{PAUSE 2}y{PAUSE 2}\n"
	"m{PAUSE 2}a{PAUSE 2}g{PAUSE 2}i{PAUSE 2}c{PAUSE 2}a{PAUSE 2}l{PAUSE 2},{PAUSE 8} {PAUSE 2}T{PAUSE 6} M{PAUSE 2} .", MSGBOX_DEFAULT)
	closemessage
	delay(20)
	faceplayer
	msgbox(
	"We've changed the slogan six times\n"
	"already.\p"

	"I always need a moment to check.\n"
	"", MSGBOX_DEFAULT)
	release
	end
}

