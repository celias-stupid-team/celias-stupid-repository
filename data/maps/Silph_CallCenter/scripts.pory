mapscripts Silph_CallCenter_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		if(!flag(FLAG_FINANCIAL_REPORT_TOSSED)) {
			setflag(FLAG_TEMP_1)
		}
		setvar(VAR_TEMP_5, 22)
	}
}

script Silph_CallCenter_Sign {
	msgbox(
	"SILPH CO\n"
	"MARKETING", MSGBOX_SIGN)

}

script Silph_CallCenter_NPC1 {
	lock
	msgbox(
	"Hello, you have reached the\n"
	"YOUNGSTER JOEY CALL CENTER.\p"

	"To hear an update on our RATTATA,\n"
	"please press One.\l"
	"Para Español, oprima Dos.", MSGBOX_DEFAULT)
	release
}

script Silph_CallCenter_SlowpoketailMarketingGuy {
	lock
	faceplayer
	if(flag(FLAG_CRASHED_SLOWPOKE_MARKET)) {
		msgbox(
		"The secret to marketing is tricking\n"
		"people into spending money on\l"
		"shit they don't actually want.\p"

		"I'm contributing so much value to\n"
		"the world.", MSGBOX_DEFAULT)
		release
		end
	}
	setflag(FLAG_CRASHED_SLOWPOKE_MARKET)
	msgbox(
	"Looking at the numbers, it seems\n"
	"our SLOWPOKETAIL market investments\l"
	"have finally taken off!\p"

	"Now all we gotta do is crash the\n"
	"market, and we'll be rich!\l"
	"Nice!", MSGBOX_DEFAULT)
	closemessage
	applymovement(VAR_LAST_TALKED, moves(
		face_original_direction
	))
	waitmovement(0)
	delay(20)
	playse(SE_CLICK)
	waitse
	msgbox(
	"Aaaand done!\n"
	"{PAUSE 30}The value has now sunk to zero!", MSGBOX_DEFAULT)
	closemessage
	faceplayer
	delay(20)
	msgbox(
	"Now, what do you think we should\n"
	"market next?\l"
	"It's gotta be something worthless.", MSGBOX_DEFAULT)
	release
}


