script Silph_WallSign {
	lock
	msgbox(
	"NOTICE!\n"
	"Updated reception guidelines!\p"

	"Our new line for greeting guests:\p"

	"“Welcome to SILPH CO.”\p"

	"“I hope your day is marvelously\n"
	"magical!”", MSGBOX_DEFAULT)
	closemessage
	delay(20)
	msgbox(
	"Peeling back the poster, you see a\n"
	"different poster underneath.", MSGBOX_DEFAULT)
	delay(20)
	msgbox(
	"NOTICE!\n"
	"Updated reception guidelines!\p"

	"Our new line for greeting guests:\p"

	"“Welcome to SILPH CO!{PAUSE 45}\n"
	"We are not evil!”", MSGBOX_DEFAULT)
	closemessage
	msgbox(
	"The poster has been scribbled over\n"
	"with the word “OUTDATED!”", MSGBOX_DEFAULT)
	release


}

script Silph_BathroomCall {
	lock
	getplayerxy(VAR_TEMP_4, VAR_TEMP_5)
	setvar(VAR_SILPH_ELEVATOR_SCENE, 1)
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"WAAAAAAAAAAAAIT!\n"
	"", MSGBOX_DEFAULT)
	closemessage
	addobject(LOCALID_BATHROOM_GUY)
	if(var(VAR_TEMP_4) == 53) {
		applymovement(LOCALID_BATHROOM_GUY, moves(
			set_visible
			walk_faster_down * 2
			walk_faster_right * 2
			walk_faster_down * 7
			walk_faster_right * 5
			face_up
		))
	} else {
		applymovement(LOCALID_BATHROOM_GUY, moves(
			set_visible
			walk_faster_down * 2
			walk_faster_right
			walk_faster_down * 7
			walk_faster_right * 6
			face_up
		))

	}
	playse(SE_FLEE)
	waitmovement(LOCALID_BATHROOM_GUY)
	playse(SE_SLIDING_DOOR)
	opendoor(59, 22)
	delay(30)
	applymovement(LOCALID_BATHROOM_GUY, moves(
		walk_up
		delay_4
		set_invisible
	))
	waitmovement(LOCALID_BATHROOM_GUY)
	playse(SE_SLIDING_DOOR)
	removeobject(LOCALID_BATHROOM_GUY)
	closedoor(59, 22)
	delay(30)
	release
	end
}

script Silph_SmallKid {
	msgbox(
	"small kid\n"
	"", MSGBOX_NPC)
}


script Silph_LookGirl {
	    lock
	
		msgbox(format("Hmm...\nIs that down..."), MSGBOX_DEFAULT)
		applymovement(VAR_LAST_TALKED, Common_Movement_FacePlayer)
		waitmovement(0)
		playse(SE_PIN)
		applymovement(VAR_LAST_TALKED, DT_exclmark)
		waitmovement(0)
		delay(48)
		msgbox(format("Oh!\nLook, look!"), MSGBOX_DEFAULT)
		closemessage
		switch(var(VAR_FACING)) {
			case DIR_SOUTH:
                    addvar(VAR_TEMP_5, 1)
					applymovement(VAR_LAST_TALKED, moves(
						face_up
						lock_facing_direction
						walk_down
					))
					waitmovement(0)
					break
				default:
                    subvar(VAR_TEMP_5, 1)
					applymovement(VAR_LAST_TALKED, moves(
						face_down
						lock_facing_direction
						walk_up
					))
					waitmovement(0)
					break
        }
	if(var(VAR_TEMP_5) == 15) {
		playse(SE_WARP_OUT)
		applymovement(VAR_LAST_TALKED, moves(
			face_down
			lock_facing_direction
			walk_fast_up * 7
		))
		setflag(FLAG_SENT_SILPH_LOOK_GIRL)
		waitmovement(0)
		setvar(VAR_SILPH_LOOK_GIRL, 1)
		removeobject(VAR_LAST_TALKED)
		
	}
	if(var(VAR_TEMP_5) == 24) {
		delay(20)
		applymovement(LOCALID_SILPH_LOOK_CHUCKSTER, moves(
			walk_in_place_right * 2
		))
		waitmovement(0)
		delay(10)
		textcolor(NPC_TEXT_COLOR_BLUE)
		msgbox(
		"I'm a CHUCKSTER!\n"
		"", MSGBOX_DEFAULT)
		closemessage
		delay(30)
		applymovement(VAR_LAST_TALKED, moves(
			face_up
			lock_facing_direction
			walk_slow_down
			delay_16 * 2
			walk_fast_up * 2
			jump_2_up
			delay_16
			unlock_facing_direction
			face_down
		))
		applymovement(LOCALID_SILPH_LOOK_CHUCKSTER, moves(
			face_up
			lock_facing_direction
			walk_slow_down
			delay_16 * 2
			walk_fast_up * 2
			face_up
		))
		waitmovement(LOCALID_SILPH_LOOK_CHUCKSTER)
		playse(SE_LEDGE)
		waitmovement(VAR_LAST_TALKED)
		applymovement(LOCALID_PLAYER, moves(
			face_up
		))
		applymovement(LOCALID_SILPH_LOOK_CHUCKSTER, moves(
			unlock_facing_direction
			walk_down
			face_right
		))
		waitmovement(LOCALID_SILPH_LOOK_CHUCKSTER)
		setvar(VAR_TEMP_5, 21)

	}
    copyobjectxytoperm(VAR_LAST_TALKED)
	release
}

