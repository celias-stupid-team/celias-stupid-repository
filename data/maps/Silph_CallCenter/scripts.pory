mapscripts Silph_CallCenter_MapScripts {

}

script Silph_CallCenter_Sign {
	msgbox(
	"SILPH CO\n"
	"MARKETING", MSGBOX_SIGN)

}

script Silph_CallCenter_NPC1 {
	lock
	msgbox(
	"Hello, you have reached the\n"
	"YOUNGSTER JOEY CALL CENTER.\p"

	"To hear an update on our RATTATA,\n"
	"please press One.\l"
	"Para Español, oprima Dos.", MSGBOX_DEFAULT)
	release
}

script Silph_CallCenter_SlowpoketailMarketingGuy {
	setflag(FLAG_CRASHED_SLOWPOKE_MARKET)
	msgbox(
	"Let's crash the slowpoketail\n"
	"market.", MSGBOX_NPC)
}


script Silph_CallCenter_Elevator {
	lock
	msgbox(
	"{PLAYER} knocked on the door…\n"
	"", MSGBOX_DEFAULT)
	closemessage
	delay(10)
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"Rats!\n"
	"I didn't make it!", MSGBOX_DEFAULT)
	closemessage
}

script Silph_ProductDeveloper {
	msgbox(
	"Finally!\p"

	"After months of development, we've\n"
	"finally crafted the single most\l"
	"marketable man in the world!", MSGBOX_NPC)
}


script Silph_Leon {
	lock
	showmonpic(SPECIES_DRIZZILE, 10, 3)
	waitbuttonpress
	hidemonpic
	release
}