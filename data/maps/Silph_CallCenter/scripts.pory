mapscripts Silph_CallCenter_MapScripts {

}

script Silph_CallCenter_Sign {
	msgbox(
	"SILPH CO\n"
	"CALL CENTER", MSGBOX_SIGN)

}

script Silph_CallCenter_Elevator {
	lock
	msgbox(
	"{PLAYER} knocked on the door…\n"
	"", MSGBOX_DEFAULT)
	closemessage
	delay(10)
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"Rats!\n"
	"I didn't make it!", MSGBOX_DEFAULT)
	closemessage
}