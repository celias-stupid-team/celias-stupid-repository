mapscripts AetherParadise_NebbyRoom_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setbench(BENCH_AETHER_PARADISE)
    }
}


script AetherParadise_Nebby {
    finditem(ITEM_NEBBY)
    lock
    waitfanfare
    playmoncry(SPECIES_COSMOG, CRY_MODE_DEFAULT)
    msgbox(
	"NEBBY: Pew! Pew!\n"
	"", MSGBOX_DEFAULT)
    waitmoncry
    release
    
}

script AetherParadise_NebbyEscapes {
    lock
    msgbox(
	"Wha-?\p"

	"NEBBY escaped from your bag!\n"
	"", MSGBOX_DEFAULT)
    setvar(VAR_TEMP_9, 0)
    removeitem(ITEM_NEBBY)
    clearflag(FLAG_HIDE_NEBBY)
    waitbuttonpress
    playmoncry(SPECIES_COSMOG, CRY_MODE_DEFAULT)
    msgbox(
	"NEBBY: Pew! Pew!\n"
	"", MSGBOX_DEFAULT)
    waitmoncry
    closemessage
    release
}