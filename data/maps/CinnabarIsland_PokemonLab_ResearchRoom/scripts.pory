raw `


CinnabarIsland_PokemonLab_ResearchRoom_EventScript_MetronomeTutor::
	goto EventScript_MetronomeTutor
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_Scientist::
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_EeveeCanEvolveIntroThreeMons, MSGBOX_NPC
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_Computer::
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_LegendaryBirdEmail, MSGBOX_SIGN
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_AmberPipe::
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_AnAmberPipe, MSGBOX_SIGN
	end
`
mapscripts CinnabarIsland_PokemonLab_ResearchRoom_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setflag(FLAG_HIDE_CINNABAR_YANMEGA)
		if(flag(FLAG_REVIVED_YANMEGA) && !checkmoncaught(SPECIES_SUDOWOODO)) {
			clearflag(FLAG_HIDE_CINNABAR_YANMEGA)
		}
		if(!flag(FLAG_REVIVED_YANMEGA)) {
			clearflag(FLAG_REMOVED_CINNABAR_SCIENTIST)
		}
	}
}

script PokemonLab_Yanmega {
	lock
	playfanfare(MUS_LEVEL_UP)
	removeobject(VAR_LAST_TALKED)
	msgbox(
	"{PLAYER} obtained the\n"
	"SUDOWOODO!", MSGBOX_DEFAULT)
	setvar(VAR_CSR_GIFT_POKEMON, SPECIES_SUDOWOODO)
	waitfanfare
	call(Common_Script_GiftPokemon)
	setflag(FLAG_HIDE_CINNABAR_YANMEGA)
	release
	end
}

script PokemonLab_AmberGuardian {
	lock
	faceplayer
	if(flag(FLAG_REVIVED_YANMEGA)) {
		msgbox(
		"It was a success!\n"
		"The fossil contained a POKéMON!\p"

		"…What?\n"
		"Of course you can't take it!\l"
		"What made you think you could?", MSGBOX_DEFAULT)
	} else {
		msgbox(
		"Heya, there!\n"
		"Welcome to the lab.\l"
		"I'm a new intern here.\p"

		"My capstone project has been to\n"
		"make a device that can revive life\l"
		"from a sample of OLD AMBER.", MSGBOX_DEFAULT)
		if(checkitem(ITEM_OLD_AMBER)) {
			msgbox(
			"I know it sounds ambitious, but I\n"
			"believe I can do it.\l"
			"I've been working my whole life!\p"

			"Hey!\n"
			"You have some OLD AMBER with you!\l"
			"Wanna try to revive it?", MSGBOX_YESNO)
			if(var(VAR_RESULT)) {
				msgbox(
				"Yes!\n"
				"Oh boy!\p"

				"I can't wait to put my theories to\n"
				"the test!\l"
				"Now, let's begin.", MSGBOX_DEFAULT)
				closemessage

				setflag(FLAG_REVIVED_YANMEGA)
				removeitem(ITEM_OLD_AMBER)
				fadescreenswapbuffers(FADE_TO_BLACK)
				delay(30)
				clearflag(FLAG_TEMP_1)
				addobject(LOCALID_YANMEGABALL)
				fadescreenswapbuffers(FADE_FROM_BLACK)
				msgbox(
				"Oh, golly!\n"
				"The experiment was successful!\p"

				"We've revived a POKéMON from the\n"
				"AMBER!\p"

				"Thank you for this valuable\n"
				"experience!\l"
				"You've been a gift to science!", MSGBOX_DEFAULT)
				release
				end

			} else {	
				release
				end
			}
		} else {
			msgbox(
			"I know it sounds ambitious, but I\n"
			"believe I can do it.\p"

			"I think the MUSEUM in PEWTER CITY\n"
			"has some.\p"

			"Could you go ask if they'll let us\n"
			"use it?", MSGBOX_DEFAULT)
		}
	}
	release
}

script PokemonLab_Gadaffi {
	lock
	faceplayer
	msgbox(
	"MUTASSIM GADAFFI: Hrrm…\p"

	"I've taken an interest in the\n"
	"sciences, and I've been trying to\l"
	"give away my massive fortune.\p"

	"Sadly, no one's responding to my\n"
	"emails…", MSGBOX_DEFAULT)
	closemessage
	applymovement(VAR_LAST_TALKED, moves(
		face_original_direction
	))
	waitmovement(0)
	release
}

script PokemonLab_GadaffiEmail {
	lock
	msgbox(
	"A draft of an email is left open…\n"
	"", MSGBOX_DEFAULT)
	closemessage
	delay(5)
	msgbox(
	"Greetings, friend!\p"

	"It is indeed my pleasure to write\n"
	"to you this letter!", MSGBOX_DEFAULT)
	closemessage
}

script PokemonLab_HobbyistReactorMan {
	msgbox(
	"Y'know, I think it's really cool\n"
	"that the lab converted to NUCLEAR.\l"
	"But…\p"

	"Maybe they should've invested in\n"
	"a reactor that's not for hobbyists…", MSGBOX_NPC)
}

script PokemonLab_AidsResearch {
	msgbox(
	"AIDS Research Committee\n"
	"{PAUSE 30}Now hiring!\p"

	"Looking for POKéMON with 3-5\n"
	"years experience!\l"
	"Apply now!", MSGBOX_SIGN)

}


script PokemonLab_Keyboard {
	msgbox(
	"It's a particularly innovative\n"
	"keyboard.", MSGBOX_SIGN)

}

script PokemonLab_BackupReactor {
	msgbox(
	"It's a backup nuclear reactor.\n"
	"{PAUSE 30}Hobbyist-grade.", MSGBOX_SIGN)

}

script PokemonLab_BusyResearcher {
	msgbox(
	"This researcher looks busy.\n"
	"It's best not to bother him.", MSGBOX_SIGN)

}
