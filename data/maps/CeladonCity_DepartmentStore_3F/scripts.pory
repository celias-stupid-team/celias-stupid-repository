const DAD = 8
script DepartmentStore_GameShop_TVDad {
	lock
	msgbox("A sports game!\nDad'll like that!", MSGBOX_DEFAULT)
	closemessage
	delay(25)
	addobject(DAD)
	special(SpawnCameraObject)
	applymovement(OBJ_EVENT_ID_CAMERA, CeladonCity_DepartmentStore_3F_CameraUp)
	waitmovement(0)
	delay(10)
	setobjectxy(DAD, 9, 2)
	playse(SE_EXIT)
	delay(10)
	applymovement(DAD, DadIn)
	waitmovement(0)
	delay(35)
	applymovement(DAD, Common_Movement_FaceDown)
	waitmovement(0)
	delay(10)
	textcolor(NPC_TEXT_COLOR_MALE)
	msgbox("DAD: You're right!\nI sure would!", MSGBOX_DEFAULT)
	closemessage
	delay(20)
	applymovement(DAD, DadOut)
	waitmovement(0)
	delay(10)
	playse(SE_EXIT)
	setobjectxy(DAD, 5, 0)
	removeobject(DAD)
	applymovement(OBJ_EVENT_ID_CAMERA, CeladonCity_DepartmentStore_3F_CameraDown)
	waitmovement(0)
	special(RemoveCameraObject)
	release
	end

}

script CeladonCity_DepartmentStore_3F_EventScript_FloorSign {
	msgbox("3F: TV GAME SHOP\n", MSGBOX_SIGN)
	end
}

movement CeladonCity_DepartmentStore_3F_CameraUp {
	walk_fast_up * 3
}

movement CeladonCity_DepartmentStore_3F_CameraDown {
	walk_fast_down * 3
}

movement DadIn {
	face_left
	set_visible
}

movement DadOut {
	face_right
	delay_4 * 2
	delay_2
	set_invisible
}

