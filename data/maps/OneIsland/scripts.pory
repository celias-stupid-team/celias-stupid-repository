raw `
OneIsland_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, OneIsland_OnTransition
	map_script MAP_SCRIPT_ON_LOAD, OneIsland_OnLoad
	map_script MAP_SCRIPT_ON_FRAME_TABLE, OneIsland_OnFrame
	.byte 0



OneIsland_OnFrame::
	.2byte 0

OneIsland_EventScript_EnterOneIslandFirstTime::
	lockall
	textcolor NPC_TEXT_COLOR_MALE
	applymovement LOCALID_PLAYER, OneIsland_Movement_PlayerExitHarbor
	waitmovement 0
	msgbox OneIsland_Text_BillLetsGoSeeCelio
	closemessage
	applymovement LOCALID_ONE_ISLAND_BILL, OneIsland_Movement_BillWalkToPokeCenter
	applymovement LOCALID_PLAYER, OneIsland_Movement_PlayerWalkToPokeCenter
	waitmovement 0
	opendoor 14, 5
	waitdooranim
	applymovement LOCALID_ONE_ISLAND_BILL, OneIsland_Movement_BillEnterPokeCenter
	applymovement LOCALID_PLAYER, OneIsland_Movement_PlayerEnterPokeCenter
	waitmovement 0
	closedoor 14, 5
	waitdooranim
	removeobject LOCALID_ONE_ISLAND_BILL
	warp MAP_ONE_ISLAND_POKEMON_CENTER_1F, 9, 9
	waitstate
	releaseall
	end

	.macro walk_to_pokecenter
	walk_up
	walk_up
	walk_up
	walk_up
	walk_right
	walk_right
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	.endm

OneIsland_Movement_PlayerWalkToPokeCenter::
	walk_up
	walk_to_pokecenter
	step_end

OneIsland_Movement_PlayerEnterPokeCenter::
	walk_up
	walk_up
	set_invisible
	step_end

OneIsland_Movement_PlayerExitHarbor::
	walk_up
	step_end

OneIsland_Movement_BillWalkToPokeCenter::
	walk_to_pokecenter
	walk_up
	step_end

OneIsland_Movement_BillEnterPokeCenter::
	walk_up
	set_invisible
	step_end

OneIsland_EventScript_OldMan::
	lock
	faceplayer
	goto_if_set FLAG_SYS_CAN_LINK_WITH_RS, OneIsland_EventScript_OldManLinkHoenn
	goto_if_set FLAG_SEVII_DETOUR_FINISHED, OneIsland_EventScript_OldManLinkKanto
	msgbox OneIsland_Text_LuckyToHaveCelioHere
	release
	end

OneIsland_EventScript_OldManLinkKanto::
	msgbox OneIsland_Text_HavePCLinkageWithKanto
	release
	end

OneIsland_EventScript_OldManLinkHoenn::
	msgbox OneIsland_Text_HavePCLinkageWithHoenn
	release
	end

OneIsland_EventScript_BaldingMan::
	msgbox OneIsland_Text_IsntWarmClimateHereGreat, MSGBOX_NPC
	end

OneIsland_EventScript_IslandSign::
	msgbox OneIsland_Text_IslandSign, MSGBOX_SIGN
	end

OneIsland_EventScript_PokemonNetCenterSign::
	msgbox OneIsland_Text_PokemonNetCenterSign, MSGBOX_SIGN
	end
`
//Putting this here for now until we get the linker script figured out
//PLACEHOLDER Remember to remove later!!


script OneIsland_OnTransition {
	setworldmapflag(FLAG_WORLD_MAP_ONE_ISLAND)
	setflag(FLAG_TEMP_5)
	if(checkmoncaught(SPECIES_ARTICUNO)) {
		clearflag(FLAG_TEMP_5)
	}
}

script OneIsland_OnLoad {
	
	if(flag(FLAG_INSERTED_MYSTIC_SEAL)) {
		call(OneIsland_SetArticunoStatue)
	}
}

script OneIsland_BirdCultist {
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"This island is the resting place\n"
	"of one of the LEGENDARY BIRDS!\l"
	"We stand upon hallowed ground!\p"

	"Across the whirlpools yonder lies\n"
	"the fabeled ZERO ISLAND.\p"

	"It's said to be the final stop for\n"
	"one who has encountered all three.\p"

	"Steel your nerves, and make the\n"
	"pilgrimage west.\l"
	"Your final prize awaits.", MSGBOX_NPC)
}



script OneIsland_MysticCrestPedestal {
	lock
	if(flag(FLAG_INSERTED_MYSTIC_SEAL)) {
		msgbox("The MYSTIC SEAL has been\ninserted.", MSGBOX_DEFAULT)
	} else {
		msgbox("The pedestal is engraved with\nthe number one.", MSGBOX_DEFAULT)
		if(checkitem(ITEM_MYSTIC_SEAL)) {
			msgbox("Would you like to insert the\nMYSTIC SEAL?", MSGBOX_YESNO)
			if(var(VAR_RESULT)) {
				setflag(FLAG_INSERTED_MYSTIC_SEAL)
				removeitem(ITEM_MYSTIC_SEAL)
				msgbox("{PLAYER} inserted the\nMYSTIC SEAL…", MSGBOX_DEFAULT)
				closemessage
				fadeoutbgm(1)
				playse(SE_SWITCH)
				delay(30)
				playse(SE_M_EARTHQUAKE)
				setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 3)
				setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 3)
				setvar(VAR_SHAKESCREEN_NUM_SHAKES, 30)
				setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
				special(ShakeScreen)
				waitse
				delay(20)
				//call(Route18_SetZapdosStatue) Change the thingy
				call(OneIsland_SetArticunoStatue)
				special(DrawWholeMapView)
				playmoncry(SPECIES_ARTICUNO, CRY_MODE_NORMAL)
				fadeinbgm(1)
				waitmoncry
			}
		}
	}
	release
}

script OneIsland_SetArticunoStatue {
	setmetatile(25, 9, 0x394, FALSE)
	setmetatile(26, 9, 0x395, FALSE)
	setmetatile(27, 9, 0x396, FALSE)
	
	setmetatile(25, 10, 0x39C, FALSE)
	setmetatile(26, 10, 0x39D, FALSE)
	setmetatile(27, 10, 0x39E, FALSE)
	
	setmetatile(25, 11, 0x3A4, FALSE)
	setmetatile(26, 11, 0x3A5, FALSE)
	setmetatile(27, 11, 0x3A6, FALSE)
	return
}

script OneIsland_Whirlpool {
	lockall
	checkfieldmove(MOVE_WHIRLPOOL)
	if(var(VAR_RESULT) == PARTY_SIZE) {
		msgbox(
		"A torrent of water is swirling\n"
		"in the path.", MSGBOX_SIGN)

	} else {
		msgbox(
		"A torrent of water is swirling\n"
		"in the path.\l"
		"Would you like to use WHIRLPOOL?", MSGBOX_YESNO)
		if(var(VAR_RESULT)) {
			specialvar(VAR_RESULT, GetPlayerFacingDirection)
			closemessage
			switch(var(VAR_RESULT)) {
				case DIR_NORTH: 
					applymovement(LOCALID_PLAYER, moves(
						walk_faster_up * 4
					))
				case DIR_SOUTH: 
					applymovement(LOCALID_PLAYER, moves(
						walk_faster_down * 4
					))
				case DIR_EAST: 
					applymovement(LOCALID_PLAYER, moves(
						walk_faster_right * 4
					))
				case DIR_WEST: 
					applymovement(LOCALID_PLAYER, moves(
						walk_faster_left * 4
					))
			}
			waitmovement(0)
		}
	}
	releaseall
}


script OneIsland_Kaylee {
	lock
	if(checkmoncaught(SPECIES_ARTICUNO)) {
		if(!checkitem(ITEM_SOOTHE_BELL) && !checkmoncaught(SPECIES_ESPEON)) {
			msgbox(
			"KAYLEE: Here\n"
			"", MSGBOX_DEFAULT)
			giveitem_msg("{PLAYER} received the\nTIDAL BELL!", ITEM_SOOTHE_BELL)
			waitfanfare
			msgbox(
			"Treat that BELL as a gift from\n"
			"one dancer to another.\p"

			"Who knows?\n"
			"Maybe you'll need it someday.", MSGBOX_DEFAULT)
			release
			end

		}
		faceplayer
		msgbox(
		"Treat that BELL as a gift from\n"
		"one dancer to another.\p"

		"Who knows?\n"
		"Maybe you'll need it someday.", MSGBOX_DEFAULT)
		closemessage
		applymovement(LOCALID_PLAYER, moves(
			walk_down
		))
		waitmovement(0)
		release
		end
	}
	if(!flag(FLAG_TEMP_3)) {
		applymovement(LOCALID_KAILEE, moves(
			face_down
		))
		msgbox(
		"KAILEE: Why, hello!\n"
		"", MSGBOX_DEFAULT)
		closemessage
		applymovement(LOCALID_KAILIE, moves(
			face_down
		))
		delay(10)
		msgbox(
		"KAILIE: We're dancers from the\n"
		"land of MINNESOTA.", MSGBOX_DEFAULT)
		closemessage
		applymovement(LOCALID_KAYLEE, moves(
			face_down
		))
		delay(10)
		msgbox(
		"KAYLEE: We hear that if a crew of\n"
		"five dancers comes together…", MSGBOX_DEFAULT)
		closemessage
		applymovement(LOCALID_KAYLEIGH, moves(
			face_down
		))
		delay(10)
		msgbox(
		"KAYLEIGH: …A rare POKéMON will\n"
		"hatch from this egg.", MSGBOX_DEFAULT)
		delay(10)
		closemessage
	} else {
		applymovement(LOCALID_KAILEE, moves(
			face_down
		))
		msgbox(
		"KAILEE: Welcome back!\n"
		"", MSGBOX_DEFAULT)
		closemessage
		applymovement(LOCALID_KAILIE, moves(
			face_down
		))
		delay(10)
		msgbox(
		"KAILIE: Have you found another\n"
		"dancer to join us?", MSGBOX_DEFAULT)
		closemessage
		applymovement(LOCALID_KAYLEE, moves(
			face_down
		))
		delay(10)
		msgbox(
		"KAYLEE: We need just one more.\n"
		"", MSGBOX_DEFAULT)
		closemessage
		applymovement(LOCALID_KAYLEIGH, moves(
			face_down
		))
		delay(10)
		msgbox(
		"KAYLEIGH: I'm sure you have\n"
		"someone.", MSGBOX_DEFAULT)
		delay(10)
		closemessage
	}

	setflag(FLAG_TEMP_3)
	special(IsPlayerNameKaylee)
	if(var(VAR_RESULT) && checkplayergender == FEMALE) {
		msgbox(
		"KAYLEE: Oh! You…\n"
		"You're just like us!", MSGBOX_DEFAULT)
		closemessage
		msgbox(
		"KAILEE: That's so great to see!\n"
		"Let's all dance together!", MSGBOX_DEFAULT)


		closemessage
		fadescreenswapbuffers(FADE_TO_BLACK)
		delay(40)
		fadescreenswapbuffers(FADE_FROM_BLACK)
		delay(30)
		setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 3)
		setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 3)
		setvar(VAR_SHAKESCREEN_NUM_SHAKES, 15)
		setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 3)
		special(ShakeScreen)
		playse(SE_M_MEGA_KICK)
		fadescreenswapbuffers(FADE_TO_WHITE)
		waitse
		delay(10)
		applymovement(LOCALID_ONE_ISLAND_ARTICUNO_EGG, moves(
			set_invisible
		))
		applymovement(LOCALID_ONE_ISLAND_ARTICUNO, moves(
			set_visible
		))
		playse(SE_EGG_HATCH)
		fadescreeninstant(FADE_FROM_WHITE)
		waitse
		delay(20)



		additem(ITEM_POKE_BALL, 1)
		playmoncry(SPECIES_ARTICUNO, CRY_MODE_ENCOUNTER)
		setwildbattle(SPECIES_ARTICUNO, 50, ITEM_MYSTIC_SEAL)
		dowildbattle
		delay(40)
		while(!checkmoncaught(SPECIES_ARTICUNO)) {
			giveitem_msg("Try again", ITEM_POKE_BALL, 1)
			dowildbattle
			delay(60)
		}
		removeobject(LOCALID_ONE_ISLAND_ARTICUNO)
		setvar(VAR_TEMP_0, 1)
		msgbox(
		"KAYLEE: Wow!\n"
		"What a good show!\l"
		"But y'know, thinking about it…\p"

		"I think we had the fifth dancer\n"
		"with us all along.\p"

		"Here, you can have her.\n"
		"Thank you for dancing with us.", MSGBOX_DEFAULT)
		setvar(VAR_CSR_GIFT_POKEMON, SPECIES_JYNX)
		setflag(FLAG_SHINY_CREATION)
		playfanfare(MUS_LEVEL_UP)
		msgbox(
		"{PLAYER} was given yet another\n"
		"white woman!", MSGBOX_DEFAULT)
		waitfanfare
		call(OneIsland_GiveJynx)
		textcolor(NPC_TEXT_COLOR_RED)
		msgbox(
		"The TIDAL BELL that she's holding?\n"
		"Treat it as a gift to you.\p"

		"Who knows?\n"
		"Maybe you'll need it someday.", MSGBOX_DEFAULT)


		release
		end

	}
	if(checkpartymon(SPECIES_JYNX)) {
		msgbox(
		"KAYLEE: Oh, wonderful!\n"
		"You've brought a fifth dancer!\p"

		"Come along, now.\n"
		"It's time to dance!", MSGBOX_DEFAULT)
		setflag(FLAG_SHINY_CREATION)
		trainerbattle_no_intro(TRAINER_DANCERS, "Wow!\nWhat a show!")
		applymovement(LOCALID_KAILEE, moves(
			face_up
		))
		applymovement(LOCALID_KAILIE, moves(
			face_up
		))
		applymovement(LOCALID_KAYLEE, moves(
			face_right
		))
		applymovement(LOCALID_KAYLEIGH, moves(
			face_left
		))
		delay(30)
		setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 3)
		setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 3)
		setvar(VAR_SHAKESCREEN_NUM_SHAKES, 15)
		setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 3)
		special(ShakeScreen)
		playse(SE_M_MEGA_KICK)
		fadescreenswapbuffers(FADE_TO_WHITE)
		waitse
		delay(10)
		applymovement(LOCALID_ONE_ISLAND_ARTICUNO_EGG, moves(
			set_invisible
		))
		applymovement(LOCALID_ONE_ISLAND_ARTICUNO, moves(
			set_visible
		))
		playse(SE_EGG_HATCH)
		fadescreeninstant(FADE_FROM_WHITE)
		waitse
		delay(20)



		additem(ITEM_POKE_BALL, 1)
		playmoncry(SPECIES_ARTICUNO, CRY_MODE_ENCOUNTER)
		setwildbattle(SPECIES_ARTICUNO, 50, ITEM_MYSTIC_SEAL)
		dowildbattle
		delay(40)
		while(!checkmoncaught(SPECIES_ARTICUNO)) {
			giveitem_msg("Try again", ITEM_POKE_BALL, 1)
			dowildbattle
			delay(60)
		}
		removeobject(LOCALID_ONE_ISLAND_ARTICUNO)
		setvar(VAR_TEMP_0, 1)
		
		applymovement(LOCALID_KAILEE, moves(
			face_down
		))
		applymovement(LOCALID_KAILIE, moves(
			face_down
		))
		applymovement(LOCALID_KAYLEE, moves(
			face_down
		))
		applymovement(LOCALID_KAYLEIGH, moves(
			face_down
		))
		msgbox(
		"What an incredible sight!\n"
		"Thank you for the show.\p"

		"Take this as well.\n"
		"", MSGBOX_DEFAULT)
		removeobject(LOCALID_ONE_ISLAND_ARTICUNO_EGG)
		giveitem_msg("{PLAYER} received the\nTIDAL BELL!", ITEM_SOOTHE_BELL)
		waitfanfare
		msgbox(
		"Treat that BELL as a gift from\n"
		"one dancer to another.\p"

		"Who knows?\n"
		"Maybe you'll need it someday.", MSGBOX_DEFAULT)
	} else {
		msgbox(
		"KAYLEE: We need one more friend\n"
		"to join us in our dance.", MSGBOX_DEFAULT)
		closemessage
		delay(10)
		msgbox(
		"KAILEE: Have you by chance found\n"
		"someone like us?", MSGBOX_DEFAULT)
		closemessage
		delay(10)
		applymovement(LOCALID_PLAYER,moves(
			walk_down
		))
		waitmovement(0)
		applymovement(LOCALID_KAILEE, moves(
			face_original_direction
		))
		applymovement(LOCALID_KAILIE, moves(
			face_original_direction
		))
		applymovement(LOCALID_KAYLEE, moves(
			face_original_direction
		))
		applymovement(LOCALID_KAYLEIGH, moves(
			face_original_direction
		))
		waitmovement(0)
	}
	release
}

script OneIsland_ArticunoEgg {
	msgbox(
	"A deep indigo egg sits on\n"
	"the stage.", MSGBOX_SIGN)

}

script OneIsland_RockClimbUp {
	lockall
	msgbox("Jagged rocks line the wall.\n", MSGBOX_DEFAULT)
	if(checkfieldmove(MOVE_ROCK_CLIMB) != PARTY_SIZE) {
		msgbox("Would you like to use\nROCK CLIMB?", MSGBOX_YESNO)
		closemessage
		if(var(VAR_RESULT)) {
			applymovement(LOCALID_PLAYER, moves(
				walk_fast_up * 2
				jump_up
			))
			waitmovement(0)
		}
	}
	releaseall

}
script OneIsland_RockClimbDown {
	lockall
	msgbox("Jagged rocks line the wall.\n", MSGBOX_DEFAULT)
	if(checkfieldmove(MOVE_ROCK_CLIMB) != PARTY_SIZE) {
		msgbox("Would you like to use\nROCK CLIMB?", MSGBOX_YESNO)
		closemessage
		if(var(VAR_RESULT)) {
			applymovement(LOCALID_PLAYER, moves(
				walk_fast_down * 2
				jump_down
			))
			waitmovement(0)
		}
	}
	releaseall

}

script OneIsland_ClamperlTrainer {
	lock
	faceplayer
	if(checkpartymove(MOVE_WHIRLPOOL) != PARTY_SIZE) {
		msgbox(
		"JACK: Wha-\n"
		"Hey!", MSGBOX_DEFAULT)
		release
		end
	}
	if(flag(FLAG_TRIED_WHIRLPOOL_BATTLE)) {
		msgbox(
		"JACK: What, did you think I was\n"
		"gonna let you LEARN the move?\l"
		"Pfft, nope!\p"

		"But c'mon, let's go again.\n"
		"I want you to really savor it.", MSGBOX_DEFAULT)
	} else {
		setflag(FLAG_TRIED_WHIRLPOOL_BATTLE)
		msgbox(
		"Ahahaha!\n"
		"Sup, loser!\p"

		"That's right: I know how to\n"
		"get past those WHIRLPOOLS!\p"

		"How about you take a look?\n"
		"", MSGBOX_DEFAULT)

	}
	if(checkpartymon(SPECIES_SMEARGLE)) {
		trainerbattle_no_intro(TRAINER_WHIRLPOOL_GUY, "Wha-\nHey!")
		if(checkpartymove(MOVE_WHIRLPOOL) == PARTY_SIZE) {
			msgbox(
			"JACK: Heh.\n"
			"Pretty cool, right?\p"

			"I'll happily let you watch the\n"
			"technique anytime you want.", MSGBOX_DEFAULT)

		} else {
			msgbox(
			"JACK: Wait-!\n"
			"Did you just…?", MSGBOX_DEFAULT)

		}
		applymovement(VAR_LAST_TALKED, moves(
			face_original_direction
		))
		waitmovement(0)
		release
		end

	} else {
		trainerbattle_no_intro(TRAINER_WHIRLPOOL_GUY, "Haha!\pIsn't that cool?")
		msgbox(
		"JACK: Heh.\n"
		"Pretty cool, right?\p"

		"I'll happily let you watch the\n"
		"technique anytime you want.", MSGBOX_DEFAULT)
		applymovement(VAR_LAST_TALKED, moves(
			face_original_direction
		))
		waitmovement(0)
		release
		end
	}
}

script OneIsland_ClamperlGirl {
	famechecker(FAMECHECKER_GREAT_SEA_CENTER, 0)
	msgbox(
	"That guy up there's a real\n"
	"jerk!\p"

	"He knows how to cross WHIRLPOOLS,\n"
	"but he won't teach anyone else!", MSGBOX_NPC)
}


script OneIsland_BrickBreak {
	lock
	if(flag(FLAG_ONE_ISLAND_WALL)) {
		msgbox("The BRICKS have been BREAKED.\n", MSGBOX_DEFAULT)
		release
		end
		
	}
	call(Common_Script_BrickBreak)
	//wall breaks
	if(var(VAR_RESULT) == 1) {
		
		setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 1)
		setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 1)
		setvar(VAR_SHAKESCREEN_NUM_SHAKES, 1)
		setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 1)
		special(DrawWholeMapView)
		special(ShakeScreen)
		removeobject(VAR_LAST_TALKED)
		setflag(FLAG_ONE_ISLAND_WALL)
		delay(60)
		giveitem_msg("{PLAYER} found the\nONE PIECE!\n", ITEM_ONE_PIECE, 1)
		release
		end
	}
	release
}


script OneIsland_LugiaSwimmer {
	msgbox(
	"Down there is ONE ISLAND, or also\n"
	"known as the WHIRL ISLAND.\p"

	"There's a POKéMON which lives\n"
	"deep in the basement.\p"

	"Despite what everyone seems to\n"
	"think, the POKéMON is PSYCHIC-TYPE…\l"
	"for some reason.", MSGBOX_NPC)
}

script OneIsland_Sign {
	msgbox(
	"ONE ISLAND\n"
	"", MSGBOX_SIGN)

}


script OneIsland_GiveJynx {
	copyvar(VAR_TEMP_1, VAR_CSR_GIFT_POKEMON)
	givemon(VAR_CSR_GIFT_POKEMON, 25, ITEM_SOOTHE_BELL)
	clearflag(FLAG_SHINY_CREATION)
	switch(var(VAR_RESULT)) {
		case 0: //Mon goes to party
			bufferspeciesname(STR_VAR_1, VAR_CSR_GIFT_POKEMON)
			msgbox(Text_GiveNicknameToThisMon, MSGBOX_YESNO)
			if(!var(VAR_RESULT)) {
				return
			}
			call(EventScript_GetGiftMonPartySlot)
			call(EventScript_ChangePokemonNickname)
			return
		case 1: //Mon goes to PC
				bufferspeciesname(STR_VAR_1, VAR_CSR_GIFT_POKEMON)
				msgbox(Text_GiveNicknameToThisMon, MSGBOX_YESNO)
				if(var(VAR_RESULT) == 0) {
					call(EventScript_TransferredToPC)
					return
				} else {
					call(EventScript_NameReceivedBoxMon)
					call(EventScript_TransferredToPC)
					return //This can be simplified; I'll deal with it later
				}
				
				return
		case 2:
			goto(EventScript_NoMoreRoomForPokemon)
			break
	}
}

script OneIsland_PreReleaseWarning {
	msgbox(
	"WARNING!\p"

	"Here in the pre-release, this\n"
	"event is liable to softlock.\p"

	"If you do it right, nothing bad\n"
	"will happen.\p"

	"Please savestate before you\n"
	"proceed!", MSGBOX_SIGN)

}
