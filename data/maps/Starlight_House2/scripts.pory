mapscripts Starlight_House2_MapScripts {

	MAP_SCRIPT_ON_TRANSITION {
		if(!flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
			setflag(FLAG_TEMP_3)
		}
		if(flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
			setflag(FLAG_TEMP_8)
        }
            if(flag(FLAG_CSR_CELIA_BONUS)) {
			setflag(FLAG_TEMP_8)
		}
		if(flag(FLAG_DAK_HERE)) {
			setflag(FLAG_TEMP_8)
		}
		
	}
}

script Starlight_House2_Post_Battle {
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"It's nice to meet you!\p"

	"My name is KaizenStarlight.\n"
	"or Starlight for short.\p"

	"You might see me around from time\n"
	"to time, don't worry about me if\l"
	"you do. I am just doing some work\l"
	"outside of bounds.\p"

	"Also my friend is somewhere around\n"
	"here. If you see him, tell him I\l"
	"need him, thanks!", MSGBOX_NPC)
	closemessage
	clearflag(FLAG_HIDE_BONUS_STARLIGHTS)
	applymovement(VAR_LAST_TALKED, moves(
		face_original_direction
	))
	waitmovement(0)
	release
}

script Starlight_House2_Battle { //test
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_FEMALE)
	trainerbattle_single(TRAINER_STARLIGHT,
	"Oh hi!\p"
	"I thought I hid this map.",
	//
	"That was fun!", Starlight_House2_Post_Battle)


	msgbox(
	"It was nice to meet you!", MSGBOX_NPC)
	closemessage
	applymovement(VAR_LAST_TALKED, moves(
		face_original_direction
	))
	waitmovement(0)
	release
}

script Starlight_House2_Phone { //figure out yesno setup for reading messages.
	msgbox(
	"You have 3 missed calls.\p"
	"Celia - 2 voicemails\n"
	"Dak - 1 voicemail\p"
	"First Message:\l"
	"Celia: Hey Star, could you fix the\n"
	"tile collision in Aether? Thanks!\p"
	"Second Message:\l"
	"Celia: Great work with Seafoam and\n"
	"Silph Co Layout!\p"
	"Third Message:\l"
	"Dak: WHAAAAAADDUUUUUUUUUUUUUUUUUUU\n"
	"UUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUPP\p"
	"End of messages.", MSGBOX_SIGN)

}

script Starlight_House2_Garbage1 {
	msgbox(
	"There's nothing in the trash\n"
	"Except a crumpled up paper showing\l"
	"plans for recreating the entire map\l"
	"of Zelda BotW for a small bit.", MSGBOX_SIGN)

}

script Starlight_House2_Garbage2 {
	msgbox(
	"There's scrapped paper containing a\n"
	"schedule for PMD Team Hack Event.\p"
	"There's also something scratched out\n"
	"at the bottom.\p"
	"-r---c- -vr-n\p"
	"...\n"
	"\l"
	"Probably unrelated to this hack.", MSGBOX_SIGN)
	setflag(FLAG_TEMP_5)

}

