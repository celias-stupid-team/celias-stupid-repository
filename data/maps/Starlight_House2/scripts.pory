mapscripts Starlight_House2_MapScripts {

	MAP_SCRIPT_ON_TRANSITION {
		if(!flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
			setflag(FLAG_TEMP_3)

		}
		
	}
}

script Starlight_House2_Post_Battle {
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"My name is KaizenStarlight!\n"
    "But everybody calls me Starlight\l"
    "for short.\p"

	"I am the map designer for\n"
    "Celia's Stupid Romhack.\p"

	"I created just about everything\n"
	"you will find in the Great Sea!\p"

	"Well...\n"
	"The visual world itself that is...\l"
	"I placed most of the tiles you walk\l"
	"Around on.\p"
    "You might see me around working\n"
    "out of bounds from time to time.\p"
    "But hey, it was nice to meet you!\n"
	"Feel free to explore around the\l"
    "place before you go.\p"
	"Just as a disclaimer:\l"
	"Nothing here is related to any\l"
	"puzzles or secrets, there are also\l"
	"no rewards, this was just a bonus\l"
	"place I had a lot of fun making!\p"
	"Also if you see my friend hanging\n"
	"around here could you let me know?\l"
	"Thanks!", MSGBOX_DEFAULT)
	closemessage
	clearflag(FLAG_HIDE_BONUS_STARLIGHTS)
	applymovement(VAR_LAST_TALKED, moves(
		face_original_direction
	))
	waitmovement(0)
	release
}

script Starlight_House2_Battle { //test
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_FEMALE)
	trainerbattle_single(TRAINER_STARLIGHT,
	"Oh hi!\p"
	"I thought I hid this map.",
	//
	"I... am not the best at coding...", Starlight_House2_Post_Battle)


	msgbox(
    "It was nice to meet you!\l"
	"Feel free to explore around the\l"
    "place before you go.\p"
	"Just as a disclaimer:\l"
	"Nothing here is related to any\l"
	"puzzles or secrets, there are also\l"
	"no rewards. This was just a bonus\l"
	"place I had a lot of fun making!\p"
	"Also if you see my friend hanging\n"
	"around here could you let me know?\l"
	"Thanks!", MSGBOX_DEFAULT)
	closemessage
	applymovement(VAR_LAST_TALKED, moves(
		face_original_direction
	))
	waitmovement(0)
	release
}

script Starlight_House2_Phone { //figure out yesno setup for reading messages.
	msgbox(
	"You have 3 missed calls.\p"
	"Celia - 2 voicemails\n"
	"Dak - 1 voicemail\p"
	"First Message:\l"
	"Celia: Hey Star can you fix the\n"
	"collision in Aether? Thanks!\p"
	"Second Message:\l"
	"Celia: Great work with Seafoam and\n"
	"Silph Co Layout!\p"
	"Third Message:\l"
	"Dak: WHAAAAAADDUUUUUUUUUUUUUUUUUUU\n"
	"UUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUPP\p"
	"End of messages.", MSGBOX_SIGN)

}

script Starlight_House2_Garbage1 {
	msgbox(
	"There's nothing in the trash\n"
	"Except a crumpled up paper showing\l"
	"plans for recreating the entire map\l"
	"of Zelda BotW for a bit.", MSGBOX_SIGN)

}

script Starlight_House2_Garbage2 {
	msgbox(
	"There's scrapped paper containing a\n"
	"schedule for PMD Team Hack Event.\p"
	"There's also something scratched out\n"
	"at the bottom.\p"
	"-r---c- -vr-n", MSGBOX_SIGN)

}

