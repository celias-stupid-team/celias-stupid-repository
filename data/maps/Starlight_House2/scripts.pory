mapscripts Starlight_House2_MapScripts {

	MAP_SCRIPT_ON_TRANSITION {
		if(!flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
			setflag(FLAG_TEMP_3)
		}
		if(flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
			setflag(FLAG_TEMP_8)
        }
            if(flag(FLAG_CSR_CELIA_BONUS)) {
			setflag(FLAG_TEMP_8)
		}
		if(flag(FLAG_DAK_HERE)) {
			setflag(FLAG_TEMP_8)
		}
		
	}
}

script Starlight_House2_Post_Battle {
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"My name is KaizenStarlight!\n"
	"I'm the map designer for CSR.\p"

	"I created the maps, routes, towns\n"
	"and so on that's out in the Great\l"
	"Sea. As well as some other maps\l"
	"here or there in the region.\p"

	"You might see me around from time\n"
	"to time, don't worry about me if\l"
	"you do. I am just doing some work\l"
	"outside of bounds.\p"

	"Also my friend is somewhere around\n"
	"here, if you see him let me know.\p"

	"Thanks! It was nice to meet you!\n"
	"", MSGBOX_NPC)
	closemessage
	clearflag(FLAG_HIDE_BONUS_STARLIGHTS)
	applymovement(VAR_LAST_TALKED, moves(
		face_original_direction
	))
	waitmovement(0)
	release
}

script Starlight_House2_Battle { //test
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_FEMALE)
	trainerbattle_single(TRAINER_STARLIGHT,
	"Oh hi!\p"
	"I thought I hid this map.",
	//
	"My team is a mess...", Starlight_House2_Post_Battle)


	msgbox(
	"It was nice to meet you!\p"

	"You might see me around from time\n"
	"to time, don't worry about me if\l"
	"you do. I am just doing some work\l"
	"outside of bounds.\p"

	"Also my friend is somewhere around\n"
	"here, if you see him would you let\l"
	"me know? Thanks!", MSGBOX_NPC)
	closemessage
	applymovement(VAR_LAST_TALKED, moves(
		face_original_direction
	))
	waitmovement(0)
	release
}

script Starlight_House2_Phone { //figure out yesno setup for reading messages.
	msgbox(
	"You have 3 missed calls.\p"
	"Celia - 2 voicemails\n"
	"Dak - 1 voicemail\p"
	"First Message:\l"
	"Celia: Hey Star can you fix the\n"
	"collision in Aether? Thanks!\p"
	"Second Message:\l"
	"Celia: Great work with Seafoam and\n"
	"Silph Co Layout!\p"
	"Third Message:\l"
	"Dak: WHAAAAAADDUUUUUUUUUUUUUUUUUUU\n"
	"UUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUPP\p"
	"End of messages.", MSGBOX_SIGN)

}

