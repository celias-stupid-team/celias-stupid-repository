raw `
IndigoPlateau_PokemonCenter_1F_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, IndigoPlateau_PokemonCenter_1F_OnTransition
	map_script MAP_SCRIPT_ON_RESUME, CableClub_OnResume
	.byte 0



IndigoPlateau_PokemonCenter_1F_EventScript_CheckBlockDoor::
	goto_if_set FLAG_SYS_CAN_LINK_WITH_RS, EventScript_Return
	setobjectxyperm LOCALID_LEAGUE_DOOR_GUARD, 4, 2
	return

IndigoPlateau_PokemonCenter_1F_EventScript_DoorGuard::
	lock
	faceplayer
	specialvar VAR_RESULT, IsNationalPokedexEnabled
	goto_if_eq VAR_RESULT, TRUE, IndigoPlateau_PokemonCenter_1F_EventScript_CheckSeviiIslandComplete
	msgbox IndigoPlateau_PokemonCenter_1F_Text_FaceEliteFourGoodLuck
	release
	end

IndigoPlateau_PokemonCenter_1F_EventScript_CheckSeviiIslandComplete::
	goto_if_set FLAG_SYS_CAN_LINK_WITH_RS, IndigoPlateau_PokemonCenter_1F_EventScript_SeviiIslandComplete
	msgbox IndigoPlateau_PokemonCenter_1F_Text_LoreleiIsAbsentClosedForTimeBeing
	release
	end

IndigoPlateau_PokemonCenter_1F_EventScript_SeviiIslandComplete::
	msgbox IndigoPlateau_PokemonCenter_1F_Text_FaceEliteFourGoodLuck
	release
	end

IndigoPlateau_PokemonCenter_1F_EventScript_GymGuy::
	msgbox IndigoPlateau_PokemonCenter_1F_Text_GymGuyAdvice, MSGBOX_NPC
	end

IndigoPlateau_PokemonCenter_1F_EventScript_Clerk::
	goto_if_questlog EventScript_ReleaseEnd
	lock
	faceplayer
	message Text_MayIHelpYou
	waitmessage
	pokemart IndigoPlateau_PokemonCenter_1F_Items
	msgbox Text_PleaseComeAgain
	release
	end

	.align 2
IndigoPlateau_PokemonCenter_1F_Items::
	.2byte ITEM_ULTRA_BALL
	.2byte ITEM_GREAT_BALL
	.2byte ITEM_FULL_RESTORE
	.2byte ITEM_MAX_ELIXIR
	.2byte ITEM_REVIVE
	.2byte ITEM_FULL_HEAL
	.2byte ITEM_MAX_REPEL
	.2byte ITEM_NONE
	release
	end

IndigoPlateau_PokemonCenter_1F_EventScript_Nurse::
	lock
	faceplayer
	call EventScript_PkmnCenterNurse
	release
	end
`

script IndigoPlateau_PokemonCenter_1F_OnTransition {
	setrespawn(HEAL_LOCATION_INDIGO_PLATEAU)
	if(!(checkpartymon(SPECIES_SMEARGLE) || checkpartymon(SPECIES_KRABBY))) {
		setflag(FLAG_TEMP_A)
	}
	specialvar (VAR_RESULT, IsNationalPokedexEnabled)
	call_if_eq (VAR_RESULT, TRUE, IndigoPlateau_PokemonCenter_1F_EventScript_CheckBlockDoor)
}

script PokemonLeague_SmeargleCelia {
	msgbox(
	"Hiya. I see that you've managed to\n"
	"smuggle a SMEARGLE in!\p"

	"Just be warned:\n"
	"I hope you know what you're doing.\l"
	"I will not save you from a softlock.\p"

	"Make a backup savestate right here\n"
	"just in case you're wrong.\p"

	"Anyway, good luck!\n"
	"", MSGBOX_NPC)
}



script PokemonLeague_GiveHistoryBook {
	lock
	faceplayer
	if(checkitem(ITEM_HISTORY_BOOK)) {
		msgbox(
		"Remember to read that HISTORY BOOK\n"
		"you have.\p"

		"Looking into the past is the best\n"
		"way to move forward.\p"

		"Remember all that you've learned,\n"
		"and the next step will come easily.", MSGBOX_DEFAULT)
	} else {
		msgbox(
		"Take this\n"
		"placeholder", MSGBOX_DEFAULT)
		giveitem_msg("{PLAYER} recieved the\nHISTORY BOOK!", ITEM_HISTORY_BOOK)
		msgbox(
		"Looking into the past is the best\n"
		"way to move forward.\p"

		"Remember all that you've learned,\n"
		"and the next step will come easily.", MSGBOX_DEFAULT)
	}
	closemessage
	applymovement(VAR_LAST_TALKED, moves(
		face_original_direction
	))
	waitmovement(0)
	release
}


script PokemonLeague_GiveCandyDispenser {
	lock
	faceplayer
	if(checkitem(ITEM_CANDY_DISPENSER)) {
		msgbox(
		"That CANDY DISPENSER will help\n"
		"your POKéMON grow.\p"

		"If you ever feel that you aren't\n"
		"up to a challenge, take a few\l"
		"steps back and re-evaluate.\p"

		"Oftentimes, you'll find that you\n"
		"have what it takes all along.", MSGBOX_DEFAULT)
	} else {
		msgbox(
		"Take this\n"
		"placeholder", MSGBOX_DEFAULT)
		giveitem_msg("{PLAYER} recieved the\nCANDY DISPENSER!", ITEM_CANDY_DISPENSER)
		msgbox(
		"That CANDY DISPENSER will help\n"
		"your POKéMON grow.\p"

		"If you ever feel that you aren't\n"
		"up to a challenge, take a few\l"
		"steps back and re-evaluate.\p"

		"Oftentimes, you'll find that you\n"
		"have what it takes all along.", MSGBOX_DEFAULT)
	}
	closemessage
	release
}

script PokemonLeague_DadHeal {
	lock
	faceplayer
	textcolor(0)
	msgbox(
	"DAD: {PLAYER}!\n"
	"What are you doing out here?\p"

	"Wow! You've made it all the way\n"
	"to the POKéMON LEAGUE!\p"

	"As your father, I couldn't be more\n"
	"proud of you.\p"

	"Now, come along.\n"
	"Let's take one final rest.", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}





script EventScript_FinalCutTree {
	goto_if_questlog(EventScript_ReleaseEnd)
	lockall
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	if(!flag(FLAG_BADGE02_GET)) {
		goto(EventScript_CantCutTree)
	}
	checkpartymove(MOVE_CUT)
	goto_if_eq(VAR_RESULT, PARTY_SIZE, EventScript_CantCutFinalTree)
	setfieldeffectargument(0, VAR_RESULT)
	bufferpartymonnick(STR_VAR_1, VAR_RESULT)
	buffermovename(STR_VAR_2, MOVE_CUT)
	msgbox(
	"A lone tree stands in the path.\p"

	"Would you like to use CUT?\n"
	"", MSGBOX_YESNO)
	goto_if_eq(VAR_RESULT, NO, EventScript_DontCutTree)
	msgbox(Text_MonUsedMove)
	closemessage
	dofieldeffect(FLDEFF_USE_CUT_ON_TREE)
	waitstate
	goto(EventScript_CutTreeDown)
}

script EventScript_CantCutFinalTree {
	msgbox(
	"A lone tree stands in the path.\n"
	"", MSGBOX_SIGN)
	releaseall
}

script PokemonLeague_FinalBookshelf {
	msgbox(IndigoPlateau_FinalChapter, MSGBOX_SIGN)
}