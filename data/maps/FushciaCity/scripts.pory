`

script FushciaCity_OnTransition {
	setworldmapflag(FLAG_WORLD_MAP_FUSHCIA_CITY)
	setworldmapflag(FLAG_WORLD_MAP_ROUTE10_POKEMON_CENTER_1F)
	setbench(BENCH_FUSHCIA)
	call(SetPlayerPokedexValues)
	clearflag(FLAG_IN_FUSHCIA_GYM)
	call_if_set(FLAG_GOT_DOME_FOSSIL, FushciaCity_EventScript_SetOmanyteGfx)
	call_if_unset(FLAG_GOT_DOME_FOSSIL, FushciaCity_EventScript_SetKabutoGfx)
	if(flag(FLAG_SANDWICH_GOT_LETTUCE)) {
		setflag(FLAG_FUSCHIA_CUT_TREE)
	} else {
		clearflag(FLAG_FUSCHIA_CUT_TREE)
	}
	if(flag(FLAG_FUSCHIA_BROKE_WALL)) {
		call(FushciaCity_DrawBrokenWall)
	}
	if(flag(FLAG_SANDWICH_GOT_SESAME_SEED)) {
		call(FuschiaCity_RemoveErik)
	}
	if(!flag(FLAG_BADGE05_GET)) {
		setflag(FLAG_TEMP_3)
	}
}

script FuschiaCity_BrickBreak {
	call(Common_Script_BrickBreak)
	//wall breaks
	if(var(VAR_RESULT) == 1) {
		
		call(FushciaCity_DrawBrokenWall)
		special(DrawWholeMapView)
		setflag(FLAG_FUSCHIA_BROKE_WALL)
	}
	release
}

script FushciaCity_DrawBrokenWall {
	setmetatile(46, 9, 0x0CD, FALSE)
	setmetatile(47, 9, 0x0CE, FALSE)
	setmetatile(48, 9, 0x0CE, FALSE)
	setmetatile(49, 9, 0x0CE, FALSE)
	setmetatile(50, 9, 0x0CF, FALSE)

	
	setmetatile(46, 10, 0x010, FALSE)
	setmetatile(47, 10, 0x011, FALSE)
	setmetatile(48, 10, 0x010, FALSE)
	setmetatile(49, 10, 0x011, FALSE)
	setmetatile(50, 10, 0x28F, TRUE)
	return
}

script FushciaCity_Fishing {
	lock
	faceplayer
	msgbox("I hate fish.\pFishing is a farce.", MSGBOX_DEFAULT)
	closemessage
	applymovement(VAR_LAST_TALKED, Common_Movement_FaceUp)
	waitmovement(0)
	release
}

script Common_Script_BrickBreak {
	lock
	if(!(checkpartymove(MOVE_BRICK_BREAK) == PARTY_SIZE)) {
		msgbox("There's a BRICK wall in the way.\nWould you like to BREAK it?", MSGBOX_YESNO)
		if(!var(VAR_RESULT)) {
			bufferpartymonnick(STR_VAR_1, VAR_RESULT)
			setfieldeffectargument(0, VAR_RESULT)
			dofieldeffect(FLDEFF_USE_ROCK_SMASH)
			setvar(VAR_RESULT, 1)
			return
			release
			end
		} else {
			msgbox("{PLAYER} decided against property damage.\n", MSGBOX_DEFAULT)
		}

	} else {
		msgbox("There's a BRICK wall in the way.", MSGBOX_DEFAULT)
	}
	release
}

script FushciaCity_TaurosGuy {
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_MALE)
	if(flag(FLAG_GOT_TAUROSES)) {
		msgbox("If I'm being honest, I didn't\nreally need more than one.\lOh well!", MSGBOX_DEFAULT)
	} else {
		msgbox("I caught some cool POKéMON in the\nSAFARI ZONE!\pHere, I have a few extra.\nWhy don't you take some?", MSGBOX_DEFAULT)
		closemessage
		
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		playfanfare(MUS_LEVEL_UP)
		msgbox("{PLAYER} received 29 TAUROS!", MSGBOX_DEFAULT)
		waitmessage
		waitfanfare
		setvar(VAR_TEMP_F, 0)
		random(29)
		copyvar(VAR_TEMP_E, VAR_RESULT)
		setvar(VAR_RESULT, 0)
		while(var(VAR_RESULT) != 2 && var(VAR_TEMP_F) < 29) {
			clearflag(FLAG_SHINY_CREATION)
			setflag(FLAG_GOT_TAUROSES)
			if (var(VAR_TEMP_F) == VAR_TEMP_E) {
				setflag(FLAG_SHINY_CREATION) //Tauros
			}
			givemon(SPECIES_TAUROS, 30)
			addvar(VAR_TEMP_F, 1)
		}
		clearflag(FLAG_SHINY_CREATION)
		if(var(VAR_RESULT) == 2) {
			goto(EventScript_NoMoreRoomForPokemon)
		}
	}
	release
	end
}

script FushciaCity_ReturnTMCase {
	if(flag(FLAG_NO_TM_CASE)) {
		lock
		additem(ITEM_TM_CASE, 1)
		clearflag(FLAG_NO_TM_CASE)
		setvar(VAR_CSR_DMCA_SAFARI_ZONE_MAP_SCENE, 2)
		msgbox("Mysteriously, you feel your TM CASE\nre-materialize in your bag.\lNeat!", MSGBOX_DEFAULT)
	}
	release
}

script FushciaCity_HiddenHbox {
	if(checkitem(ITEM_DEVON_SCOPE)) {
		//messagebox about using the scope
		//set visible, toggle on and off
		delay(60)
		goto(Common_EventScript_StaticEncounter)
	} else {
		lock
		msgbox("There's an invisible object in\nthe way.", MSGBOX_DEFAULT)
		release
	}
}

script FushciaCity_SmallChild {
	lock
	faceplayer
	msgbox("Help!\nI can't get up!\pIf only it were physically possible\nto scale waist-high cliffs…", MSGBOX_DEFAULT)
	closemessage
	applymovement(VAR_LAST_TALKED, Common_Movement_FaceLeft)
	waitmovement(0)
	release
}

script FushciaCity_MartClosed {
	msgbox("FUSHCIA CITY POKéMART\nTEMPORARILY CLOSED\pPending investigation of a link to\nthe mass POISONING scandal.\pAuthorities cite spike in sales of\nANTIDOTES as evidence.\lStay tuned for updates.", MSGBOX_SIGN)
	end
}

script FushciaCity_MartEmployee {
	msgbox("This is outrageous!\nWe're innocent, I tell you!", MSGBOX_NPC)
	end
}

script FushciaCity_BlackSesameSeed {
	lock
	if(flag(FLAG_SANDWICH_GOT_SESAME_SEED)) {
		msgbox("A small sesame seed-shaped\nimprint is all that remains.", MSGBOX_SIGN)
		end
	}
	if(flag(FLAG_TALKED_TO_SARA)) {
		msgbox("ERIK: Hello, there!\n{PAUSE 20}…Oh? What's that?\lSARA's waiting for me?\pOh no… I totally forgot.\nToday was our anniversary…\pI'm {PAUSE 30}an awful partner.\nShe deserves better than me…\pCould you take me to where she is?\nI need to make it up to her.", MSGBOX_YESNO)
		if(var(VAR_RESULT)) {
			msgbox("ERIK: Great, thank you!\n", MSGBOX_DEFAULT)
			playfanfare(MUS_LEVEL_UP)
			call(FuschiaCity_RemoveErik)
			special(DrawWholeMapView)
			msgbox("{PLAYER} used false pretenses to\nobtain the SESAME SEED!", MSGBOX_DEFAULT)
			waitfanfare
			msgbox("{PLAYER} put the SESAME SEED in\nthe SANDWICH CASE.", MSGBOX_DEFAULT)
			setflag(FLAG_SANDWICH_GOT_SESAME_SEED)
			call(FushciaCity_MakeASandwich)
			release
			end
		} else {
			msgbox("Ah, I understand.\nI need to take responsibility.\pThank you for telling me.\nI'll figure something out.", MSGBOX_DEFAULT)
			release
			end
		}
	}
	if(checkitem(ITEM_SANDWICH_CASE)) {
		msgbox("ERIK: Oh?\nHello, there.\lI am but a humble black sesame seed.\pWhat's that?\nYou'd like me to come with you?\pSorry, but I cannot.\nI plan to see my partner SARA soon.\pI wonder where she's gone…\n", MSGBOX_DEFAULT)
	} else {
		msgbox("ERIK: Oh?\nHello, there.\pI am but a humble black sesame seed.\nMy name is ERIK.", MSGBOX_DEFAULT)

	}
	release
}

script FuschiaCity_RemoveErik {
	setmetatile(48, 17, 0x0BE, FALSE)
	return
}

script FushciaCity_SloganGuy {
	lock
	if(flag(FLAG_TEMP_1)) {
		msgbox("…\pWhat the fuck kind of slogan is\nthat?", MSGBOX_DEFAULT)
	} else {
		msgbox("…\p…What?", MSGBOX_DEFAULT)
	}
	release
}

script FushciaCity_MoveDeleterSign {
	msgbox("Move Deleter's House\pNotice!\nThe Move Deleter's House\lhas been deleted.", MSGBOX_SIGN)
	end
}

const SIGN_GUY = 10
script FushciaCity_SloganSign {
	lock
	msgbox(FushciaCity_Text_SafariGameSign)
	closemessage
	delay(20)
	applymovement(SIGN_GUY, WalkInPlaceLeft)
	waitmovement(0)
	textcolor(NPC_TEXT_COLOR_MALE)
	msgbox("…\pWhat the fuck kind of slogan is\nthat?", MSGBOX_DEFAULT)
	release
}

movement WalkInPlaceLeft {
	walk_in_place_left * 2
	face_left
}

const DAD = 1
script FushciaCity_Dad {
	lock
	setrespawn(HEAL_LOCATION_FUSHCIA_OUTSIDE)
	applymovement(DAD, Common_Movement_FaceDown)
	textcolor(0)
	msgbox("DAD: {PLAYER}!\nWhat are you doing out here?\pI'm just relaxing here in my\ncage.\lI love when people come to see me!\pWell, never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}

script FushciaCity_OldMan {
	msgbox("Hello, traveler!\nHave you met the SAFARI WARDEN?\pHe's a kind soul. He wouldn't dare\nhurt anyone innocent.\lBut…\pHe's been under a lot of stress,\nwith the whole SAFARI ZONE thing.\lMaybe he needs someone to talk to.\pYou should pay him a visit.\nI'm sure he'd appreciate it.", MSGBOX_NPC)
	end
}

script FushciaCity_OfficesSign {
	msgbox("SAFARI ZONE, LLC.\nFinancial Division", MSGBOX_SIGN)
	end
}

script FushciaCity_GuruBrotherSign {
	msgbox("The FISHING GURU'S BROTHER's house\n", MSGBOX_SIGN)
	end
}

const SMALL_KID = 14
script FushciaCity_Splat {
	lock
	playse(SE_BANG)
	removeobject(SMALL_KID)
	waitse
	setvar(VAR_TEMP_9, 1)
	release
}

script FushciaCity_SplatOops {
	msgbox("Oops\n", MSGBOX_SIGN)
	end
}

script FushciaCity_OakTree {
	goto_if_questlog(EventScript_ReleaseEnd)
	lockall
	goto_if_unset(FLAG_BADGE02_GET, EventScript_CantCutTree)
	checkpartymove(MOVE_CUT)
	goto_if_eq(VAR_RESULT, PARTY_SIZE, EventScript_CantCutTree)
	setfieldeffectargument(0, VAR_RESULT)
	bufferpartymonnick(STR_VAR_1, VAR_RESULT)
	buffermovename(STR_VAR_2, MOVE_CUT)
	msgbox(Text_CutTreeDown, MSGBOX_DEFAULT)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox(Text_TreeConfirm, MSGBOX_YESNO)
	goto_if_eq(VAR_RESULT, NO, EventScript_DontCutTree)
	msgbox(Text_MonUsedMove)
	closemessage
	dofieldeffect(FLDEFF_USE_CUT_ON_TREE)
	waitstate
	applymovement(VAR_LAST_TALKED, Movement_CutTreeDown)
	waitmovement(0)
	removeobject(VAR_LAST_TALKED)
	if(checkitem(ITEM_SANDWICH_CASE)) {
		delay(30)
		playfanfare(MUS_LEVEL_UP)
		msgbox("{PLAYER} obtained some LETTUCE!\n", MSGBOX_DEFAULT)
		waitfanfare
		msgbox("{PLAYER} put the LETTUCE in the\nSANDWICH CASE.", MSGBOX_DEFAULT)
		setflag(FLAG_SANDWICH_GOT_LETTUCE)
		setflag(FLAG_FUSCHIA_CUT_TREE)
		call(FushciaCity_MakeASandwich)

	}
	releaseall
	end
}

script FushciaCity_CeliaEndDemo3 {
	msgbox("Hiya!\nI'm CELIA, the creator!\pThis is the end of DEMO 3!\nThank you for playing!\pSurf will be unusable until the\nfull release of the game.\lStay tuned!\pIn the meantime, try to fill out\nyour POKéDEX!\pI recommend that you have 87\nPOKéMON caught right now.\lThe most you can have is 103!\pPlus, there's plenty of secrets\nto find if you know where to look!\pTry everything you can think of -\nYou're likely to be rewarded!\pAnyway, thank you so much for\nplaying!\lI hope you had fun!", MSGBOX_NPC)
	end
}