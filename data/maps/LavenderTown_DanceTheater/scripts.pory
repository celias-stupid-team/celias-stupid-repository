movement DT_exclmark {
	emote_exclamation_mark
}

movement DT_walkbackLeft {
	walk_left
	walk_in_place_faster_right
	step_end
}

movement DT_walkbackRight {
	walk_right
	walk_in_place_faster_left
	step_end
}