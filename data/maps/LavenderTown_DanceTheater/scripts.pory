    walk_slow_right //32
    face_right //1 beat = 26
    delay_4
    delay_8
    delay_16 //1 beat = 26
    

    walk_slow_down //16
    face_down //1 beat = 26
    face_left //Triplet turnaround; Sixteenth triplet = 4 frames each
    delay_4
    face_up
    delay_4
    face_right
    delay_4
    face_down
    delay_16
    delay_4
    delay_2
    delay_1

    //Repeat first phase of dance
    walk_slow_down //32
    face_down //1 beat = 26
    delay_4
    delay_8
    delay_16 //1 beat = 26

    
    walk_slow_left //32
    face_left //1 beat = 26
    delay_4
    delay_8
    delay_16 //1 beat = 26

    
    walk_slow_down //32
    face_down //1 beat = 26
    delay_4
    delay_8
    delay_16 //1 beat = 26
    

    walk_slow_left //32
    face_left //1 beat = 26
    face_left //Triplet turnaround; Sixteenth triplet = 4 frames each
    delay_4
    face_up
    delay_4
    face_right
    delay_4
    face_down
    delay_16
    delay_4
    delay_2
    delay_1

    //Move inward
    
    walk_slow_up //16
    face_up //1 beat = 26
    delay_4
    delay_8
    delay_16 //1 beat = 26

    walk_slow_right //16
    face_right //1 beat = 26
    delay_4
    delay_8
    delay_16 //1 beat = 26

    walk_slow_up //16
    face_up //1 beat = 26
    delay_4
    delay_8
    delay_16 //1 beat = 26
    
    walk_slow_left //16
    face_left //1 beat = 26
    delay_4
    delay_8
    delay_16 //1 beat = 26

    face_up
    delay_16
    delay_8
    delay_2
    face_down
    delay_16
    delay_8
    delay_2

    delay_16 * 2
    walk_slow_right * 2 //64 frames
    face_right
    walk_slow_up
    walk_slow_up // 32
    face_up
    delay_16 * 2
    
    //6 beats before this = 160 frames
    face_left
    delay_8 //half beat:
    delay_4
    delay_1
    face_right
    delay_8 //half beat:
    delay_4
    delay_1
    face_down //4.5 beats = 480 frames =
    delay_16 * 5

}


movement DT_exclmark {
	emote_exclamation_mark
}

movement DT_walkbackLeft {
	walk_left
	walk_in_place_faster_right
	step_end
}

movement DT_walkbackRight {
	walk_right
	walk_in_place_faster_left
	step_end
}


script DanceTheater_PlayerDance {
    lock
    special(SpawnCameraObject)
    removeobject(YELLOW)
    removeobject(BLUE)
    applymovement(LOCALID_CAMERA, PlayerDanceStart)
    applymovement(LOCALID_PLAYER, PlayerDanceStart)
    fadenewbgm(MUS_DUMMY)
    waitmovement(0)
    delay(120)
    playbgm(MUS_CELADON_GYM_2, FALSE)
    applymovement(LOCALID_PLAYER, PlayerDance)
    delay(1140)
    special(RemoveCameraObject)
    addobject(GUY)
    setobjectxy(GUY, 5, 2)
    applymovement(GUY, PlayerDanceSplat)
    waitmovement(GUY)
    playse(SE_LEDGE)
    applymovement(LOCALID_PLAYER, PlayerDanceEnd)
    fadedefaultbgm
    waitmovement(0)
    applymovement(GUY, GuyAscends)
    waitmovement(0)
    removeobject(GUY)
    release
    end
}

movement GuyAscends {
    lock_facing_direction
    walk_fast_up * 4
}

movement PlayerDanceStart {
    walk_up * 2
    face_down
}

movement PlayerDance {
    face_left
    delay_16
    delay_8
    delay_4
    face_right
    delay_16
    delay_8
    delay_4
    face_left
    delay_16
    delay_8
    delay_4
    face_up
    delay_16
    delay_8
    delay_4
    face_down
    delay_16 * 4
    delay_8 * 4
    delay_4 * 4
    
    face_right
    lock_facing_direction
    walk_slow_left
    face_right
    delay_16 * 2
    walk_slow_left
    face_right
    delay_16 * 2
    unlock_facing_direction
    face_left
    lock_facing_direction
    walk_slow_right
    face_left
    delay_16 * 2
    walk_slow_right
    face_left
    delay_16 * 2

    
    walk_slow_right
    face_left
    delay_16 * 2
    walk_slow_right
    face_left
    delay_16 * 2
    unlock_facing_direction
    face_right
    lock_facing_direction
    walk_slow_left
    face_right
    delay_16 * 2
    walk_slow_left
    face_right
    delay_16 * 3
    unlock_facing_direction
    face_down
    lock_facing_direction
    walk_slow_left * 2
    walk_slow_up
    walk_slow_right * 4
    walk_slow_down
    walk_slow_left * 2
    unlock_facing_direction
    walk_slow_up * 2
    lock_facing_direction
    walk_slow_down * 2
    unlock_facing_direction
    delay_16
    face_left
    delay_2
    face_up
    delay_2
    face_right
    delay_2
    face_down
    delay_2
    face_left
    delay_2
    face_up
    delay_2
    face_right
    delay_2
    face_down
    delay_2
    face_left
    delay_2
    face_up
    delay_2
    face_right
    delay_2
    face_down
    delay_2
    face_left
    delay_2
    face_up
    delay_2
    face_right
    delay_2
    face_down
    delay_2
    face_left
    delay_2
    face_up
    delay_2
    face_right
    delay_2
    face_down
    delay_2
    face_left
    face_up
    face_right
    delay_2
    face_down
    delay_2
    face_left
    delay_2
    face_up
    delay_2
    face_right
    delay_2
    face_down
    delay_2
    face_left
    delay_2
    face_up
    delay_2
    face_right
    delay_2
    face_down      
    delay_2 

}

movement PlayerDanceEnd {
    unlock_facing_direction
    face_up
    lock_facing_direction
    jump_2_down
    face_up
    unlock_facing_direction
    delay_16 * 4
    walk_down * 2
}

movement PlayerDanceSplat {
    slide_down * 8
}