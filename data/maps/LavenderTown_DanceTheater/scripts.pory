    face_right
    delay_8 //half beat:
    delay_4
    delay_2
    face_left
    delay_8 //half beat:
    delay_4
    delay_1
    face_down //4.5 beats = 480 frames =
    delay_16 * 5


    //Dance Starts
    walk_slow_right //24
    face_right //1 beat = 26
    delay_4
    delay_8
    delay_16 //1 beat = 26

    
    walk_slow_down //32
    face_down //1 beat = 26
    delay_4
    delay_8
