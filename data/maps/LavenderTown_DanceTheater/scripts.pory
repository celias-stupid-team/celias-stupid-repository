// ############### Mapscripts ###############

mapscripts LavenderTown_DanceTheater_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setvar(VAR_TEMP_5, 8) // Sign Lady's X
        setflag(FLAG_TEMP_5)
    }
}

// ############### regular scripts ###############

script CeliaSecrets_DanceTheaterDance {
	msgbox("Y'know there isn't exactly a script\nthat says “Walk to the beat.”\pI had to calculate how many frames\neach beat of the song was and how\llong each walk cycle is.\pThen I had to painstakingly time it\nexactly along with the music.\pIt was a very tedious process.\n", MSGBOX_NPC)
	end
}


const LOOK_GIRL = 9
script DanceTheater_LookLookGirl {
	    lock
	
		msgbox(format("Hmm...\nIs that right..."), MSGBOX_DEFAULT)
		applymovement(VAR_LAST_TALKED, Common_Movement_FacePlayer)
		waitmovement(0)
		playse(SE_PIN)
		applymovement(VAR_LAST_TALKED, DT_exclmark)
		waitmovement(0)
		delay(48)
		msgbox(format("Oh!\nLook, look!"), MSGBOX_DEFAULT)
		closemessage
		switch(var(VAR_FACING)) {
			case DIR_EAST:
                    addvar(VAR_TEMP_5, 1)
					applymovement(VAR_LAST_TALKED, DT_walkbackRight)
					waitmovement(0)
					break
				default:
                    subvar(VAR_TEMP_5, 1)
					applymovement(VAR_LAST_TALKED, DT_walkbackLeft)
					waitmovement(0)
					break
        }
    copyobjectxytoperm(VAR_LAST_TALKED)
	release
}


const SHORT_KID = 10
script DanceTheater_ShortKid {
    lock
    if(!flag(FLAG_DANCE_THEATER_WATCHED_SHOW)) {
        if(var(VAR_TEMP_5) == 8) {
            if(flag(FLAG_DANCE_THEATER_KID_READY_TO_GIVE)) {
                msgbox("Hey!\nWhy'd you put her back?\lNow I can't see!", MSGBOX_DEFAULT)
                release
                end
            } else {
                msgbox("Hey! Get out of the way!\nI can't see the show!", MSGBOX_DEFAULT)
                release
                end

            }
        } else {
            getplayerxy(VAR_TEMP_3, VAR_TEMP_4)
            if(var(VAR_TEMP_4) == 17 && var(VAR_TEMP_3) == 8) {
                msgbox("Hey!\nGet out of the way!\pThanks for moving that girl in front\nof me, but I still can't see!", MSGBOX_DEFAULT)
                release
                end
            } else {
                faceplayer
                msgbox("Oh, wow! I can see!\nThanks so much, mister!\pLet's chat again after the show.\nThere's something I wanna show you!", MSGBOX_DEFAULT)
                setflag(FLAG_DANCE_THEATER_KID_READY_TO_GIVE)
                closemessage
                applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
                waitmovement(0)

                release
                end
            }
        }
    } else {
        if(flag(FLAG_DANCE_THEATER_MOVED_GIRL_BEFORE_SHOW)) {
            if(!checkitem(ITEM_CANDY_DISPENSER)) {
                msgbox("Wowie, thanks!\nThat DANCE was so cool!\pBeing short stinks!\nI can't wait until I grow up…\pHere, take this.\nIt'll help your POKéMON grow!", MSGBOX_DEFAULT)
                giveitem_msg("{PLAYER} received a PEZ DISPENSER\nfrom the tiny child!", ITEM_CANDY_DISPENSER)
            }
            msgbox("I wish eating CANDY all day would\nmake me grow up faster.\lIt's not fair…", MSGBOX_DEFAULT)

        } else {
            if(flag(FLAG_DANCE_THEATER_KID_READY_TO_GIVE)) {
                msgbox("…\pYou moved the girl out of the\nway\land then you-\p…{PAUSE 20}C'mon, man…\n", MSGBOX_DEFAULT)
                closemessage
                fadescreen(FADE_TO_BLACK)
                removeobject(VAR_LAST_TALKED)
                setflag(FLAG_SHORT_KID_RAN_OFF)
                clearflag(FLAG_TEMP_5)
                addobject(SHORT_KID_BALL)
                delay(30)
                fadescreen(FADE_FROM_BLACK)

            }   else {
                msgbox("Aww…\pI really wanted to watch the show,\nbut I couldn't see anything!\pGuess I'll need to come back\nnext year.", MSGBOX_DEFAULT)
            }
        } 
        release
        end
    }
    
}

script DanceTheater_ShortKidBall {
    lock
    msgbox("The short kid left this here.\n", MSGBOX_DEFAULT)
    removeobject(VAR_LAST_TALKED)
    setflag(FLAG_SHINY_CREATION) //Ekans
    playfanfare(MUS_LEVEL_UP)
    msgbox("{PLAYER} stole a small child's\nEKANS!", MSGBOX_DEFAULT)
    setvar(VAR_CSR_GIFT_POKEMON, SPECIES_EKANS)
    call(Common_Script_GiftPokemon)
}

script DanceTheater_DietDance {
    if(flag(FLAG_DANCE_THEATER_WATCHED_SHOW)) {
        msgbox("What a lovely show!\nAh, it brings back memories.\pMe and my friends were BLUE, RED,\nYELLOW, and GREEN too!\pI hear my GREEN-HAIRED friend is\naround here somewhere.\lI hope I run into him again!", MSGBOX_NPC)
    } else {
	    msgbox("Ah, the DANCE THEATER is finally\nopen!\pI can't wait to SHAKE IT!\nThe DIET DANCE beckons!", MSGBOX_NPC)

    }
	end
}

script DanceTheater_Ash {
    if(checkitem(ITEM_SOOT_SACK)) {
        setflag(FLAG_PUT_ASH_IN_SACK) 
        textcolor(NPC_TEXT_COLOR_NEUTRAL)
        removeobject(VAR_LAST_TALKED)
        playfanfare(MUS_LEVEL_UP)
        msgbox("{PLAYER} put some ASH in the\nSOOT SACK!", MSGBOX_DEFAULT)
        waitfanfare
    } else {
        if(flag(FLAG_DANCE_THEATER_WATCHED_SHOW)) {
            applymovement(VAR_LAST_TALKED, Common_Movement_FaceLeft)
            msgbox("ASH: Wow, PIKACHU!\nThat was such a good show!", MSGBOX_DEFAULT)
            applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
            closemessage
            waitmovement(0)
        } else {
            applymovement(VAR_LAST_TALKED, Common_Movement_FaceLeft)
            msgbox("ASH: All right, PIKACHU!\nI can't wait to watch the dance!", MSGBOX_DEFAULT)
            applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
            closemessage
            waitmovement(0)
        }
    }
    release
    end
}

script DanceTheater_Dad {
	lock
	faceplayer
	textcolor(0)
	msgbox("{PLAYER}!\nWhat are you doing out here?\pI didn't know you were into\ntraditional ceremonial dance.\lWhat fine taste you've developed!\pWell, never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}

script DanceTheater_Pikachu {
    lock
    faceplayer
    textcolor(NPC_TEXT_COLOR_MALE)
    if(flag(FLAG_PUT_ASH_IN_SACK)) {
        msgbox("POKéKID: Huh?\nWhere'd that guy go?", MSGBOX_DEFAULT)
    } else {
        special(GetPlayerFacingDirection)
        //if(var(VAR_RESULT) == DIR_SOUTH) {
            applymovement(VAR_LAST_TALKED, Common_Movement_FaceLeft)
            delay(30)
            applymovement(VAR_LAST_TALKED, Common_Movement_FaceRight)
            delay(30)
            applymovement(VAR_LAST_TALKED, Common_Movement_FacePlayer)
            delay(30)
        //}
        msgbox("POKéKID: Uh, hey.\pThis guy picked me up off the street\nthe other day.\pI guess he thinks I'm a\nPOKéMON?\lChu Pika!!", MSGBOX_DEFAULT)
        
        applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
        closemessage
        waitmovement(0)
    }
    release
    end
}

script DanceTheater_FluteMan {
    lock
    faceplayer
    if(!checkitem(ITEM_SOOT_SACK)) {
        msgbox("Why hello, there!\nWhat an excellent show, huff-puff!\pBack in my home region, I was an\nesteemed glassworker, huff-puff.\pSeeing such a beautiful performance\ninspired my inner craftsman.\lI wish to create again, huff-puff.\pHere!\nTake this, huff-puff!", MSGBOX_DEFAULT)
        giveitem(ITEM_SOOT_SACK)
        msgbox("Fill that SOOT SACK with ash and\nbring it back to me.\lI'll craft you a present, huff-puff!", MSGBOX_DEFAULT)
    } else {
        if(flag(FLAG_CRAFTED_BLUE_FLUTE)) {
            msgbox("A BLUE FLUTE is a most wonderful\nitem, huff-puff.\pPlaying it will awaken any sleeping\nPOKéMON, huff-puff!", MSGBOX_DEFAULT)
        } else {
            if(flag(FLAG_PUT_ASH_IN_SACK)) {
                setflag(FLAG_CRAFTED_BLUE_FLUTE)
                msgbox("Ah, lovely!\nSome fresh ASH, huff-puff!\pI'll craft you a lovely glass item\nwith this, huff-puff.", MSGBOX_DEFAULT)
                closemessage
                delay(15)
                fadescreen(FADE_TO_BLACK)
                delay(30)
                fadescreen(FADE_FROM_BLACK)
                delay(15)
                msgbox("Here you are!\nA beautiful glass FLUTE, huff-puff!", MSGBOX_DEFAULT)
                giveitem(ITEM_POKE_FLUTE)
                msgbox("A BLUE FLUTE is a most wonderful\nitem, huff-puff.\pPlaying it will awaken any sleeping\nPOKéMON, huff-puff!", MSGBOX_DEFAULT)
            } else {
                msgbox("Fill that SOOT SACK with ash and\nbring it back to me.\lI'll craft you a present, huff-puff!", MSGBOX_DEFAULT)
            }
        }

    }
    release
    end
}


// Dance Scripts 

const RED = 4
const BLUE = 1
const YELLOW = 2
const GREEN = 3

const GUY = 13

script DanceTheater_Trailer {
    lock
    setvar(VAR_CSR_DANCE_SHOW, 1)
    fadeoutbgm(1)
    playse(SE_CLICK)
    setweather(WEATHER_SHADE)
    doweather
    waitse
    delay(60)
    textcolor(NPC_TEXT_COLOR_NEUTRAL)
    special(SpawnCameraObject)
    getplayerxy(VAR_TEMP_3, VAR_TEMP_4)
    copyvar(VAR_TEMP_6, VAR_TEMP_3)
    while(var(VAR_TEMP_3) != 5) {
        if(var(VAR_TEMP_3) < 5) {
            applymovement(LOCALID_CAMERA, Common_Movement_WalkRight)
            waitmovement(0)
            addvar(VAR_TEMP_3, 1)
        } else {
            if(var(VAR_TEMP_3) > 5) {
                applymovement(LOCALID_CAMERA, Common_Movement_WalkLeft)
                waitmovement(0)
                subvar(VAR_TEMP_3, 1)
            }
        }
    }
    delay(30)
    msgbox("All right, ladies and gentlemen!\nIt's time for tonight's show!\pComing in from JOHTO, put your hands\ntogether for our main event:\lBIG YELLOW and the KIMONO GIRLS!", MSGBOX_DEFAULT)
    closemessage
    delay(30)
    playbgm(MUS_CSR_DANCE_PRELUDE, FALSE)
    delay(150)
    applymovement(LOCALID_CAMERA, Theater_CameraGoesUp)
    waitmovement(0)
    delay(410)
    if(var(VAR_TEMP_5) != 8) {
        setflag(FLAG_DANCE_THEATER_MOVED_GIRL_BEFORE_SHOW)
    }
    playbgm(MUS_CSR_DRIFTVEIL, FALSE)
    delay(80)
    addobject(GUY)
    delay(12)
    playse(SE_FALL)
    applymovement(GUY, GuyDance)
    delay(14) //Intro
    playse(SE_M_STRENGTH)

    applymovement(RED, RedDance)
    applymovement(BLUE, BlueDance)
    applymovement(YELLOW, YellowDance)
    applymovement(GREEN, GreenDance)
    waitmovement(GUY)
    playse(SE_LEDGE)
    applymovement(GUY, GuyJump)
    waitmovement(GUY)
    playse(SE_M_STRENGTH)
    applymovement(GUY, GuyDelayAndRaiseArm)
    waitmovement(GREEN)
    setweather(WEATHER_NONE)
    applymovement(LOCALID_CAMERA, Theater_CameraComesDown)
    delay(60)
    fadedefaultbgm
    doweather
    waitmovement(0)
    while(var(VAR_TEMP_3) != VAR_TEMP_6) {

        if(var(VAR_TEMP_3) < VAR_TEMP_6) {
            applymovement(LOCALID_CAMERA, Common_Movement_WalkRight)
            waitmovement(0)
            addvar(VAR_TEMP_3, 1)
        } else {
            if(var(VAR_TEMP_3) > VAR_TEMP_6) {
                applymovement(LOCALID_CAMERA, Common_Movement_WalkLeft)
                waitmovement(0)
                subvar(VAR_TEMP_3, 1)
            }
        }
    }
    delay(30)
    
    setflag(FLAG_DANCE_THEATER_WATCHED_SHOW)
    special(RemoveCameraObject)
    release
}

movement Theater_CameraGoesUp {
    walk_slower_up * 8
}

movement Theater_CameraComesDown {
    walk_down * 8
}

movement Theater_CameraLeft {
    walk_left
}
movement Theater_CameraRight {

}

movement GuyDance {
    slide_down * 8
    delay_16 * 6
    lock_facing_direction
    walk_slow_right
    delay_1
    delay_4
    delay_8
    delay_16

    walk_slow_left
    delay_1
    delay_4
    delay_8
    delay_16

    walk_slow_left
    delay_1
    delay_4
    delay_8
    delay_16

    walk_slow_right
    delay_1
    delay_4
    delay_8
    delay_16
    
    walk_slow_up
    delay_1
    delay_4
    delay_8
    delay_16
    
    walk_slow_down
    delay_1
    delay_4
    delay_8
    delay_16
    
    walk_slow_down
    delay_1
    delay_4
    delay_8
    delay_16
    
    walk_slow_up
    delay_1
    delay_4
    delay_8

    // B section
    
    delay_16
    delay_4
    delay_2
    unlock_facing_direction
    face_right
    lock_facing_direction
    walk_slow_left
    delay_4
    delay_8
    delay_16
    
    unlock_facing_direction
    face_left
    lock_facing_direction
    walk_slow_right
    delay_4
    delay_8
    delay_16
    
    unlock_facing_direction
    face_left
    lock_facing_direction
    walk_slow_right
    delay_4
    delay_8
    delay_16

    unlock_facing_direction
    face_right
    lock_facing_direction
    walk_slow_left
    delay_4
    delay_8
    delay_16 * 2

    unlock_facing_direction
    face_up
    delay_16
    delay_8
    delay_2
    face_down
    delay_16
    delay_8
    delay_2

    lock_facing_direction
    walk_slow_up // 24
    face_down // 25
    delay_16 * 2 // 57
    delay_8
    walk_slow_up // 24
    face_down // 25
    delay_16 * 2 // 114
    delay_4
    

}

movement GuyJump { //I know this looks ugly but bear with me
    jump_2_down
    

}

movement GuyDelayAndRaiseArm {
    delay_8 //half beat:
    delay_4
    delay_1 * 2
    delay_8 //half beat:
    delay_4
    delay_1 * 2
    raise_hand_and_stop //4.5 beats = 480 frames =
}

movement BlueDance {
    face_right
    delay_8 //half beat:
    delay_4
    delay_2
    face_left
    delay_8 //half beat:
    delay_4
    delay_1
    face_down //4.5 beats = 480 frames =
    delay_16 * 5


    //Dance Starts
    walk_slow_up //24
    face_up //1 beat = 26
    delay_4
    delay_8
    delay_16 //1 beat = 26

    
    walk_slow_up //24
    face_up //1 beat = 26
    delay_4
    delay_8
    delay_16 //1 beat = 26

    
    walk_slow_left //24
    face_left //1 beat = 26
    delay_4
    delay_8
    delay_16 //1 beat = 26
    

    walk_slow_up //24
    face_up //1 beat = 26
    face_left //Triplet turnaround; Sixteenth triplet = 4 frames each
    delay_4
    face_up
    delay_4
    face_right
    delay_4
    face_down
    delay_16
    delay_4
    delay_2
    delay_1

    //Repeat first phase of dance
    walk_slow_up //32
    face_up //1 beat = 26
    delay_4
    delay_8
    delay_16 //1 beat = 26

    
    walk_slow_right //32
    face_right //1 beat = 26
    delay_4
    delay_8
    delay_16 //1 beat = 26

    
    walk_slow_up //32
    face_up //1 beat = 26
    delay_4
    delay_8
    delay_16 //1 beat = 26
    

    walk_slow_right //32
    face_right //1 beat = 26
    face_left //Triplet turnaround; Sixteenth triplet = 4 frames each
    delay_4
    face_up
    delay_4
    face_right
    delay_4
    face_down
    delay_16
    delay_4
    delay_2
    delay_1

    //Move inward
    
    walk_slow_down
    face_down //1 beat = 26
    delay_4
    delay_8
    delay_16 //1 beat = 26

    walk_slow_right
    face_right //1 beat = 26
    delay_4
    delay_8
    delay_16 //1 beat = 26

    walk_slow_up
	face_up //1 beat = 26
    delay_4
    delay_8
    delay_16 //1 beat = 26
    
    walk_slow_left //16
    face_left //1 beat = 26
    delay_4
    delay_8
    delay_16 //1 beat = 26

    face_up
    delay_16
    delay_8
    delay_2
    face_down
    delay_16
    delay_8
    delay_2

    delay_16 * 2
    walk_slow_left * 2 //64 frames
    face_down
    walk_slow_down
    walk_slow_down // 32
    face_up
    delay_16 * 2
    
    //6 beats before this = 160 frames
    face_left
    delay_8 //half beat:
    delay_4
    delay_1
    face_right
    delay_8 //half beat:
    delay_4
    delay_1
    face_down //4.5 beats = 480 frames =
    delay_16 * 5
}

