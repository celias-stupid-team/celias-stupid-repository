mapscripts PokemonIsland_LabBackRoom_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if(flag(FLAG_IVY_SIGN)) {
            setobjectmovementtype(LOCALID_IVY_SHRINE, MOVEMENT_TYPE_FACE_UP)
        }
    }
}



script PokemonIsland_LabBackRoom_Shrine {
    if(flag(FLAG_IVY_SIGN)) {
        msgbox(
        "Wow!\p"

        "Something incredible must have\n"
        "happened here!", MSGBOX_SIGN)
    } else {
        msgbox(
        "A shrine sits on the table.\p"

        "This looks to be the site of\n"
        "something incredible.", MSGBOX_SIGN)

    }

}
