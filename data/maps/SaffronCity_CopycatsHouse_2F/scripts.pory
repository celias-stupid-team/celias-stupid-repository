raw `
SaffronCity_CopycatsHouse_2F_MapScripts::
	.byte 0

SaffronCity_CopycatsHouse_2F_EventScript_Doduo::
	lock
	faceplayer
	waitse
	playmoncry SPECIES_DODUO, CRY_MODE_NORMAL
	msgbox SaffronCity_CopycatsHouse_2F_Text_Doduo
	waitmoncry
	release
	end

SaffronCity_CopycatsHouse_2F_EventScript_Doll::
	lock
	msgbox SaffronCity_CopycatsHouse_2F_Text_RareMonOnlyDoll
	release
	end

SaffronCity_CopycatsHouse_2F_EventScript_Copycat::
	goto_if_questlog EventScript_ReleaseEnd
	special QuestLog_CutRecording
	lock
	faceplayer
	checkitem ITEM_POKE_DOLL
	goto_if_eq VAR_RESULT, TRUE, EventScript_MimicTutor
	checkplayergender
	call_if_eq VAR_RESULT, MALE, SaffronCity_CopycatsHouse_2F_EventScript_MimicPlayerMale
	call_if_eq VAR_RESULT, FEMALE, SaffronCity_CopycatsHouse_2F_EventScript_MimicPlayerFemale
	release
	end

SaffronCity_CopycatsHouse_2F_EventScript_MimicPlayerMale::
	msgbox SaffronCity_CopycatsHouse_2F_Text_MimickingFavoriteHobbyMale
	return

SaffronCity_CopycatsHouse_2F_EventScript_MimicPlayerFemale::
	msgbox SaffronCity_CopycatsHouse_2F_Text_MimickingFavoriteHobbyFemale
	return

SaffronCity_CopycatsHouse_2F_EventScript_Computer::
	msgbox SaffronCity_CopycatsHouse_2F_Text_MySecrets, MSGBOX_SIGN
	end

SaffronCity_CopycatsHouse_2F_EventScript_Game::
	msgbox SaffronCity_CopycatsHouse_2F_Text_MarioWearingABucket, MSGBOX_SIGN
	end
`



script CopycatHouse_GiveMimikyuPlaceholder {
    lock
    playfanfare(MUS_LEVEL_UP)
	removeobject(VAR_LAST_TALKED)
    msgbox(
	"{PLAYER} found the\n"
	"MIMIKYU!", MSGBOX_DEFAULT)
    waitfanfare
    setvar(VAR_CSR_GIFT_POKEMON, SPECIES_MIMIKYU)
    call(Common_Script_GiftPokemon)
    removeobject(VAR_LAST_TALKED)
    release
}


script CopycatHouse_Dad {
	msgbox(
	"placeholder dialogue\n"
	"", MSGBOX_NPC)
}

script CopycatHouse_Mom {
	if(var(VAR_COPYCAT_USED) < 2) {
		msgbox(
		"Oh no, no, no-!\p"

		"The DMCA kidnapped our precious\n"
		"daughter, and she's still missing!\p"

		"She must be so, so, so scared…\n"
		"Whatever should we do?", MSGBOX_NPC)
		end
	}
	msgbox(
	"placeholder dialogue\n"
	"", MSGBOX_NPC)
}


script CopycatHouse_Child {
	lock
	faceplayer
	if(flag(FLAG_TEMP_1F) &&
	flag(FLAG_TEMP_1)  && 
	flag(FLAG_TEMP_2) && 
	flag(FLAG_TEMP_3) && 
	flag(FLAG_TEMP_4) && 
	flag(FLAG_TEMP_5) && 
	flag(FLAG_TEMP_6) && 
	flag(FLAG_TEMP_7) && 
	flag(FLAG_TEMP_8) && 
	flag(FLAG_TEMP_9) && 
	flag(FLAG_TEMP_A) && 
	flag(FLAG_TEMP_B) && 
	flag(FLAG_TEMP_C) && 
	flag(FLAG_TEMP_D)) {
		finditem(ITEM_COPYCAT_TM)
		release
		end
	}
	msgbox(
	"{PLAYER}: Say something stupid!\p"

	"{PLAYER}: Uh, no, I just asked you.\n"
	"{PAUSE 30}Quit copying me!", MSGBOX_DEFAULT)
	closemessage
	delay(60)
	msgbox(
	"COPYCAT: Do you really say that\n"
	"to everyone you meet?", MSGBOX_DEFAULT)
	release

}

script CopycatHouse_Game {
	msgbox(
	"Dear BIPPI,\n"
	"I hope you're doing well.\p"

	"Here in SAFFRON, we're facing a\n"
	"major NES shortage.\p"

	"I had to play SUPER MARIO BROS\n"
	"on this sheet of paper.\p"

	"I hope to see you soon!\n"
	"", MSGBOX_SIGN)

}


script CopycatHouse_ChildDelivery {
	msgbox(
	"Dear MR. and MRS. COPYCAT,\p"

	"We have confirmed the annulment\n"
	"of your recent REPLACEMENT order.\p"

	"Do note that our refund policy\n"
	"does not cover cancellations\l"
	"within one (1) business day.\p"

	"As such, your order remains on\n"
	"file if you'd like a new sibling.\l"
	"We have a special going for twins!\p"

	"Thank you,\n"
	"KANTO CHILD DELIVERY SERVICE", MSGBOX_SIGN)

}

script CopycatHouse_FavoriteShirt {
	msgbox(
	"Twelve identical copies of your\n"
	"favorite copies of your favorite\l"
	"shirt!", MSGBOX_SIGN)

}

script CopycatHouse_Painting {
	msgbox(
	"It looks like a picture of a\n"
	"painting, but it's actually a\l"
	"copy of a picture of a painting.", MSGBOX_SIGN)

}


script CopycatHouse_Bookshelf {
	msgbox(
	"My Secret Life, chapter three\p"

	"Looks like it's copying every\n"
	"other bookshelf.", MSGBOX_SIGN)

}
