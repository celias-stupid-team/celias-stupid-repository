
mapscripts MtMoon_Outside_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_CSR_MAP_ALTAR_OF_MOONE)
		if(!flag(FLAG_PUT_NEBBY_IN_ALTAR)) {
			setflag(FLAG_TEMP_5)
		}
    }
}



script MoonAltar_TentacoolWater {
	msgbox("Examining the water, you find it\nrefreshingly TENTACOOL-free.", MSGBOX_SIGN)
	end
}

script MoonAltar_CameraPan {
    lock
    special(SpawnCameraObject)
	if(checkitem(ITEM_NEBBY)) {
		fadenewbgm(MUS_NONE)
		applymovement(LOCALID_CAMERA, MtMoon_CameraGoesUp)
		delay(30)
		playse(SE_M_EARTHQUAKE)
		setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 4)
		setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 4)
		setvar(VAR_SHAKESCREEN_NUM_SHAKES, 30)
		setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
		special(ShakeScreen)
		waitmovement(0)
		delay(90)
		playmoncry(SPECIES_COSMOG, CRY_MODE_DEFAULT)
		waitmoncry
		setobjectxy(LOCALID_ALTAR_NEBBY, 17, 12)
		applymovement(LOCALID_ALTAR_NEBBY, moves(
			lock_facing_direction
			set_visible
			walk_up * 6
		))
		waitmovement(LOCALID_ALTAR_NEBBY)
		delay(30)
		fadescreeninstant(FADE_TO_WHITE)
		removeobject(LOCALID_ALTAR_NEBBY)
		clearflag(FLAG_TEMP_5)
		addobject(LOCALID_MOON_WORMHOLE)
		delay(10)
		fadescreeninstant(FADE_FROM_WHITE)
		removeitem(ITEM_NEBBY)
		setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 4)
		setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 4)
		setvar(VAR_SHAKESCREEN_NUM_SHAKES, 10)
		setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 1)
		special(ShakeScreen)
		playse(SE_M_BLIZZARD)
		delay(120)
		additem(ITEM_POKE_BALL)
		setobjectsubpriority(LOCALID_MOON_WORMHOLE, MAP_MT_MOON_OUTSIDE, 255)
		setobjectsubpriority(LOCALID_PLAYER, MAP_MT_MOON_OUTSIDE, 0)
		applymovement(LOCALID_PLAYER, moves(
			face_down
			lock_facing_direction
			slide_up * 5
			walk_in_place_fast_down * 6
			slide_up
			walk_in_place_fast_down * 4
			slide_up
			unlock_facing_direction
			walk_in_place_fast_down * 3
			walk_in_place_fast_left
			walk_in_place_fast_right
			walk_in_place_fast_left
			walk_in_place_fast_right
			walk_in_place_fast_down * 5
			lock_facing_direction
			slide_up * 2
			set_invisible
		))
		waitmovement(LOCALID_PLAYER)
		playse(SE_M_SCREECH)
		delay(60)
		//Scene of you getting sucked in
		// Warp to wormhole
		setobjectxy(LOCALID_PLAYER, 9, 12)
		warpsilent(MAP_WORMHOLE_ENTRANCE, 1)
		release
		end



	}
    applymovement(LOCALID_CAMERA, MtMoon_CameraGoesUp)
    waitmovement(0)
    delay(60)
    applymovement(LOCALID_CAMERA, MtMoon_CameraGoesDown)
    waitmovement(0)
    delay(30)
    special(RemoveCameraObject)
    if(checkitem(ITEM_TEA)) {
            playfanfare(MUS_LEVEL_UP)
            msgbox("The TOXIC SLUDGE in your BAG\ntransformed into GRIMER!", MSGBOX_DEFAULT)
            waitfanfare
            waitmessage
            setflag(FLAG_SHINY_CREATION) //Grimer
            setvar(VAR_TEMP_1, SPECIES_GRIMER)
			givemon(SPECIES_GRIMER, 25)
			clearflag(FLAG_SHINY_CREATION)
			switch(var(VAR_RESULT)) {
				case 0: //Mon goes to party
					bufferspeciesname(STR_VAR_1, SPECIES_GRIMER)
					msgbox(Text_GiveNicknameToThisMon, MSGBOX_YESNO)
					goto_if_eq(VAR_RESULT, NO, MtMoon_GiveGrimerEnd)
					call(EventScript_GetGiftMonPartySlot)
					call(EventScript_ChangePokemonNickname)
					goto(MtMoon_GiveGrimerEnd)
					end
				case 1: //Mon goes to PC
						bufferspeciesname(STR_VAR_1, SPECIES_GRIMER)
						msgbox(Text_GiveNicknameToThisMon, MSGBOX_YESNO)
						if(var(VAR_RESULT) == 0) {
							call(EventScript_TransferredToPC)
							goto(MtMoon_GiveGrimerEnd)
						} else {
							call(EventScript_NameReceivedBoxMon)
							call(EventScript_TransferredToPC)
							goto(MtMoon_GiveGrimerEnd) //This can be simplified; I'll deal with it later
						}
						end
				case 2:
					goto(EventScript_NoMoreRoomForPokemon)
					break
			}
    }

    setvar(VAR_TEMP_0, 1)
    release
    
}

script MtMoon_ShitComputerSign {
	msgbox("There was once a sign here\nbecause the computer was broken.\pHowever, now the computer is fixed,\nso the sign was removed.\pDespite this, you feel compelled\nto check this patch of grass.\pInteresting.\n", MSGBOX_SIGN)
	end
}

script MtMoon_GiveGrimerEnd {
    removeitem(ITEM_TEA)
    setvar(VAR_TEMP_0, 1)
    release
}

script MoonAltar_ClearVar {
    setvar(VAR_TEMP_0, 0)
    release
}

movement MtMoon_CameraGoesUp {
    walk_slow_up * 9
}

movement MtMoon_CameraGoesDown {
    walk_slow_down * 9
}