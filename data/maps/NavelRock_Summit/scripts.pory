raw `
NavelRock_Summit_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, NavelRock_Summit_OnTransition
	map_script MAP_SCRIPT_ON_RESUME, NavelRock_Summit_OnResume
	.byte 0



NavelRock_Summit_EventScript_HideHoOh::
	setvar VAR_TEMP_1, 1
	setflag FLAG_HIDE_HO_OH
	return

NavelRock_Summit_EventScript_TryShowHoOh::
	setvar VAR_TEMP_1, 1
	setvar VAR_TEMP_1, 0
	clearflag FLAG_HIDE_HO_OH
	return

NavelRock_Summit_OnResume::
	call_if_set FLAG_SYS_SPECIAL_WILD_BATTLE, NavelRock_Summit_EventScript_TryRemoveHoOh
	end

NavelRock_Summit_EventScript_TryRemoveHoOh::
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_ne VAR_RESULT, B_OUTCOME_CAUGHT, EventScript_Return
	removeobject LOCALID_NAVEL_ROCK_HO_OH
	return

NavelRock_Summit_EventScript_HoOh::
	goto_if_questlog EventScript_ReleaseEnd
	special QuestLog_CutRecording
	lockall
	setvar VAR_TEMP_1, 1
	special SpawnCameraObject
	setvar VAR_0x8004, 3  @ Num loops
	setvar VAR_0x8005, 35 @ Delay
	special LoopWingFlapSound
	applymovement LOCALID_NAVEL_ROCK_HO_OH, Movement_HoOhAppear
	applymovement LOCALID_CAMERA, Movement_CameraPanUp
	waitmovement 0
	delay 50
	setweather 0
	doweather
	waitse
	playmoncry SPECIES_PIDGEY, CRY_MODE_ENCOUNTER
	delay 30
	waitmoncry
	delay 60
	setvar VAR_0x8004, 3  @ Num loops
	setvar VAR_0x8005, 35 @ Delay
	special LoopWingFlapSound
	applymovement LOCALID_CAMERA, Movement_CameraPanDown
	applymovement LOCALID_NAVEL_ROCK_HO_OH, Movement_HoOhApproach
	waitmovement 0
	special RemoveCameraObject
	seteventmon SPECIES_PIDGEY, 70
	setflag FLAG_SYS_SPECIAL_WILD_BATTLE
	special StartLegendaryBattle
	waitstate
	clearflag FLAG_SYS_SPECIAL_WILD_BATTLE
	setvar VAR_LAST_TALKED, LOCALID_NAVEL_ROCK_HO_OH
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_eq VAR_RESULT, B_OUTCOME_WON, NavelRock_Summit_EventScript_DefeatedHoOh
	goto_if_eq VAR_RESULT, B_OUTCOME_RAN, NavelRock_Summit_EventScript_RanFromHoOh
	goto_if_eq VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED, NavelRock_Summit_EventScript_RanFromHoOh
	addobject LOCALID_SKY_TOWER_CHUCKSTER
	clearflag FLAG_TEMP_1
	setflag FLAG_FOUGHT_HO_OH
	releaseall
	end

NavelRock_Summit_EventScript_DefeatedHoOh::
	setvar VAR_0x8004, SPECIES_PIDGEY
	goto EventScript_MonFlewAway
	end

NavelRock_Summit_EventScript_RanFromHoOh::
	setvar VAR_0x8004, SPECIES_PIDGEY
	goto EventScript_MonFlewAway
	end

Movement_CameraPanUp:
	walk_up
	walk_up
	walk_up
	step_end

Movement_CameraPanDown:
	delay_16
	delay_16
	walk_down
	walk_down
	walk_down
	step_end

Movement_HoOhApproach:
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_in_place_down
	delay_16
	delay_16
	step_end

Movement_HoOhAppear:
	delay_16
	delay_16
	walk_in_place_down
	walk_in_place_down
	walk_in_place_down
	walk_in_place_down
	step_end
`

script NavelRock_Summit_OnTransition {
	call_if_set(FLAG_FOUGHT_HO_OH, NavelRock_Summit_EventScript_HideHoOh)
	call_if_unset(FLAG_FOUGHT_HO_OH, NavelRock_Summit_EventScript_TryShowHoOh)
	setflag(FLAG_TEMP_1)
	setflag(FLAG_CSR_MAP_SKY_TOWER)
}

script NavelRock_Chuckster {
	lock
	faceplayer
	msgbox(
	"I'm a CHUCKSTER!\n"
	"", MSGBOX_DEFAULT)
	closemessage
	specialvar(VAR_TEMP_6, GetPlayerFacingDirection)
	switch(var(VAR_TEMP_6)) {
		case DIR_NORTH:
			special(SpawnCameraObject)
			applymovement(LOCALID_PLAYER, moves(
				walk_right
				walk_up * 2
				walk_left
				face_right
			))
			applymovement(LOCALID_CAMERA, moves(
				delay_16
				walk_up
			))
		case DIR_SOUTH:
			special(SpawnCameraObject)
			applymovement(LOCALID_PLAYER, moves(
				face_right
			))
			applymovement(LOCALID_CAMERA, moves(
				
				walk_down
			))
			
		case DIR_EAST:
			special(SpawnCameraObject)
			applymovement(LOCALID_PLAYER, moves(
				walk_up
				walk_right
				face_right
			))
		case DIR_WEST:
			special(SpawnCameraObject)
			applymovement(LOCALID_PLAYER, moves(
				walk_up
				walk_left
				face_right

			))
	}
	waitmovement(LOCALID_CAMERA)
	waitmovement(LOCALID_PLAYER)
	delay(30)
	applymovement(LOCALID_SKY_TOWER_CHUCKSTER, moves(
		face_right
		lock_facing_direction
		walk_slow_left
		face_right
		delay_16 * 2
		walk_slow_left
		face_right
		delay_16 * 3
		walk_faster_right * 8
		face_right
	))
	applymovement(LOCALID_PLAYER, moves(
		face_right
		lock_facing_direction
		walk_slow_left
		face_right
		delay_16 * 2
		walk_slow_left
		face_right
		delay_16 * 3
		walk_faster_right * 8
	))
	waitmovement(LOCALID_PLAYER)
	playse(SE_LEDGE)
	applymovement(LOCALID_PLAYER, moves(
		jump_2_right
	))
	delay(30)
	setobjectxy(LOCALID_PLAYER, 29, 35)
	warphole(MAP_NEW_MAP1)
	waitmovement(0)

	release


}