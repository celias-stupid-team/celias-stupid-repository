	"fuck making new individual maps\l"
	"for the indoors of houses.", MSGBOX_NPC)
}

script CeliaSecret_GirlHole {
	msgbox(
	"“Girl Hole” was not supposed\n"
	"to come off like that LOL\p"

	"But it was funny, so I kept it.\n"
	"", MSGBOX_NPC)
}


script CeliaSecret_WetFloor {
	msgbox(
	"Starlight would mark the borders\n"
	"of maps using signs.\p"

	"Sometimes she forgot to erase them\n"
	"before we pushed vital updates to\l"
	"the game.\l"
	"This was one of them.\p"

	"I had to reverse engineer it into\n"
	"a gag.", MSGBOX_NPC)
}


script CeliaSecret_WizRoom {
	msgbox(
