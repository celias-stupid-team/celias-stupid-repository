}

script CeliaSecret_DittoOrder {
	msgbox(
	"We tried like 9 different ways of\n"
	"laying out the multi-truck Ditto.\p"

	"Personally I'm still not fully\n"
	"happy with this one, but hey.\l"
	"It'll do.", MSGBOX_NPC)
}


script CeliaSecret_PirateDocks {
	msgbox(
	"The layering on these docks was\n"
	"nightmarishly hard.\p"

	"Between walking under them on\n"
	"the beach, walking over them from\l"
	"the mainland, and being able to\l"
	"surf from them, none of it worked\l"
	"out of the box.\p"

	"These rocks are here to mask the\n"
	"transition from one elevation\l"
	"to another.", MSGBOX_NPC)
}

script CeliaSecret_PorygonConfusion {
	msgbox(
	"This slightly adds some Porygon\n"
	"confusion, but hey.\p"

	"People can figure it out.\n"
	"", MSGBOX_NPC)
}

script CeliaSecret_BreakTheSeal {
	msgbox(
	"This lady's hint has gone through\n"
	"tons of iterations.\p"

	"Sometimes it was Destroy the Seal,\n"
	"sometimes it was Break or smth.\p"

	"It's hard to make it clear what to\n"
	"do without being so direct that\l"
	"it's not fun.", MSGBOX_NPC)
}


script CeliaSecret_DiveSpots {
	msgbox(
