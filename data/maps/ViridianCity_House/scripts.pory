raw `
ViridianCity_House_MapScripts::
	.byte 0

ViridianCity_House_EventScript_BaldingMan::
	msgbox ViridianCity_House_Text_NicknamingIsFun, MSGBOX_NPC
	end

ViridianCity_House_EventScript_LittleGirl::
	msgbox ViridianCity_House_Text_MyDaddyLovesMonsToo, MSGBOX_NPC
	end

ViridianCity_House_EventScript_Speary::
	lock
	faceplayer
	waitse
	playmoncry SPECIES_SPEAROW, CRY_MODE_NORMAL
	msgbox ViridianCity_House_Text_Speary
	waitmoncry
	release
	end
`
script ViridianCity_House_EventScript_CeliaSpiro {
	msgbox("There are three kinds of people who\nsee SPEARONOLACTONE:\p1. LGBT folks, who INSTANTLY know\nwhat it means.\p2. Non-queer folks, who will get\nEXTREMELY confused.\p3. People who aren't queer but can\ngoogle spironolactone.\lThese are the funniest.\pThe first google result talks about\nhow it's a water pill.\lThus, they assume it's about peeing!\pAs any trans person could tell you,\nhowever, that's not QUITE it!", MSGBOX_NPC)
	end
}

script ViridianCity_House_EventScript_Window {
	msgbox("Nope! This window, along with\nall others, has no flavor text!", MSGBOX_SIGN)
	end
}

//For my own sanity, I'm going to put all Celia Secret Reward Scripts in here.

script CeliaSecrets_Bonus_ShinyRatExplode {
	msgbox(
	"After half the game was already\n"
	"done, I made this guy's weedle\l"
	"blow up and kill him.\p"

	"This meant that suddenly, I needed\n"
	"to retroactively add a bit where\l"
	"weedle explodes everywhere.\p"

	"This was not planned LOL\n"
	"", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_ViridianLedge {
	msgbox("Putting a ledge here to block the\nexpected item pickup was so clever.\pIt's one of the myriad ways this\nhack subtly fucks with you.\lI feel it isn't appreciated enough!", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_UselessLedge {
	msgbox("Yes, there's nothing up here.\nThis ledge is completely pointless.\pIt's that way in vanilla too.\pI have no clue why.\n", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_CandyGuy {
	msgbox("I feel concerned that I scared the\naverage player into thinking that\lthis guy would talk for ages.\pCome on, guys!\nI'm not THAT mean!", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_Gambler {
	msgbox("The quest to get into this house is\nactually so convenient for me.\pMany of the Celia Secrets are tied\nto specific locations, but I didn't\lwant people to get spoiled if they\lfound one early.\pBut this one requires you to get to\nCeladon to finish, so it acts as a\lgatekeeper for the others.\pThat way, you'll never learn about\nan area you haven't been to yet!", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_PoisoningEveryone {
	msgbox(
	"The old Celia here said I didn't\n"
	"have a punchline for the Poisoning\l"
	"everyone gag.\p"

	"Thus, I felt obligated to finish\n"
	"the bit.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_Survey {
	msgbox("Have you tried filling in the survey\nyet?\lIt's one of my favorite bits!", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_Route2 {
	msgbox("It could be argued that this is the\nworst part of the hack.\lCertainly it has the least going on.\pHowever, I think some relative calm\nis important after the clusterfuck\lthat is the opening thru the Parcel.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_FlowersInViridian {
	msgbox("One of the most obscure references\nin this hack!\pIn RBY, certain patches of grass\ncouldn't spawn wild encounters\lif they had a small flower on them.\pSpeedrunners use this to optimize\ntheir route through Viridian Forest.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_DadFadeIn {
	msgbox("There was a bug here in beta where\nthe screen wouldn't fully fade in.\lIt's a problem with FRLG's engine.\pI've fixed it now, but before that I\njust had Dad talk about how it's\lgetting dark out.\pPeople seemed to like it :)\n", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_BugCatcherDoug {
	msgbox("This is a reference to Beating Fire\nRed While Blind And Deaf!\pTo beat Brock, he had to grind vs\nthis guy's first Pokemon and then\limmediately faint.\lHe repeated this for weeks.\pI'm guessing the experience gave\nthis kid a bit of an ego.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_LookGirl2 {
	msgbox("I wanted to make this girl a\nrecurring character for later.\pI decided she needed to come back\nearly so the player keeps her in mind", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_ThisGuy {
	msgbox("THIS GUY is a manga-exclusive\nPokemon!\pRed finds him early in the journey,\nbut he runs away, never to be seen\lagain!\pThe voice clip is from the youtuber\nReverend, who made a video about\lvarious Pokemon Cryptids!", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_Signposts {
	msgbox("Every time I put a signpost in a\nfield like this, I am reminded of\lhow much I hate using Porymap.\pHMA is sooooooooo much better for\nmap design!!", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_MimeTrade {
	msgbox(
	"Listen, I REALLY didn't want\n"
	"people to forget that you can\l"
	"trade with this guy.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_FlashOfficer {
	msgbox("First draft of this line said he's\nwaiting on a “Kid” to pass through.\pYea that one's prolly a little too\niffy for my tastes.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_StuckAtBrock {
	msgbox("I do not understand how people get\nstuck at Brock.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_Route3Dad {
	msgbox("Originally, dad here talked about\nyou getting chased by the Lasses.\pUnfortunately, the plural tipped\npeople off that she'd attack again\lbefore getting a chance to see it.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_HboxRespawn {
	msgbox("I really like the respawn animation\nhere.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_Route4Benches {
	msgbox("You can retreat back and forth from\nthe other side of Mt Moon.\lI have no clue if this is made clear\pHopefully people are able to figure\nit out, cuz I haven't playtested\lthat puzzle!", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_GardenerPuzzle {
	msgbox("Fun fact: I never playtested this\npuzzle to see how hard it was.\pThankfully most people seem to be\nable to figure it out, but I was\lterrified that it would be too hard!", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_RalphJoey {
	msgbox("Yes, this is a reference to the old\nVulpix card that had a misprint\lon every single copy.\pI was surprised to see so many folks\ngetting confused on where Joey and\lRalph live!", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_BikeKid {
	msgbox("This kid actually has two different\nlines of dialogue!\lFor before and after having a Bike.\pHowever, most people were only\ntalking to him once, missing it.\pSo, I merged the first dialogue\nonto the second when you talk to\lhim afterwards.\pThat way, at least some players will\nsee the updated dialogue.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_Level1Gastly {
	msgbox("This guy has a LEVEL 1 GASTLY in\nhis team.\pIt's supposed to be a reference to\nthe infamously awful Base Set card.\lArguably the worst card ever made.\pHowever, because the card itself is\ntechnically Level 8, people get\lconfused on what it's referencing.\pSadly, when I set the mon to just\nbe level 8, players don't notice\lthat there's a joke there at all!", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_PoisonKid {
	msgbox("This guy is a joke that sadly\ndoesn't actually land very well.\pHe's supposed to be trying to be\na POISON-type trainer, but he only\lplays the TCG.\pBecause of that, he's very confused\non which mons are ACTUALLY poison.\pIn Gen 1, Poison types were shown as\nGRASS cards, so he has a Grass mon.\pThen in gen 4, Poison was shown as\nPsychic, so he has one of those.\pFinally, in gen 8 onwards, they're\nDark, so he has one of those too.\pI wanted a way to make fun of\nPoison's history, so I'm kinda\lsad this joke isn't very clear.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_DragonFairyKids {
	msgbox("These two NPCS at this table are\nsupposed to compliment each other:\lOne sets up a joke, the other ends.\pFor that to work, players would need\nto read the DRAGON guy first,\land then read the FAIRY girl.\pThe whole table used to be placed\non the left side of the GYM.\pHowever, players were consistently\nreading the two in the wrong order!\lEven after I would swap them around!\pSo, I decided to simply move them\nall to the right side.\pNow, it seems like players are\ntalking to the DRAGON guy first.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_NakedMisty {
	msgbox("The joke with Misty is the ONLY\nreason Cerulean is card-themed.\pAlso, I was utterly terrified that\nthe joke would be going too far,\land that I'd get my hack banned.\pThankfully, people seem to get that\nit's just an uncomfortable joke.\pLet it be known that all I did to\nthe sprite was add a Staryu to it.\lI did not remove ANYTHING.\pI was extremely strict about that,\nand you can tell cuz the sprite is\lkinda wonky in one of the arms.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_Level20Guy {
	msgbox("The example Pokemon that this guy\ngives for one that doesn't evolve\lhas changed a lot in development.\pOriginally it was Paras, then\nSandshrew (before Sonic was a thing)\pI settled on Abra, but honestly I\nthink Rattata might be better?\lIdk!", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_DaisyFlowers {
	msgbox("Any time there's a section where\nyou're searching for a hidden item,\lthe flowers aren't DAISY.\pI made a seperate non-Daisy tile\njust so she won't annoy you.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_CeliaSecretOne {
	msgbox("I made all of the Celia Secrets\nwithout realizing that this one is\lthe first one you see stepping out\lof the gym.\pProbably not the kindest first\nimpression for the special bonus.\lOops!", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_DMCAHouse {
	msgbox("This room is full of interactables\nthat reference the player's house.\pWriting the dialogue here was\nreally fun!", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_PitJumpscare {
	msgbox("Pit jumpscare!\pI had to manually set each and\nevery one of these tiles one-by-one\pPlease never make me do that again.\n", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_SecretGarden {
	msgbox("It was surprisingly obnoxious to get\nthe secret garden bit working.\pWhen you enter Bill's house, you can\nBARELY see the grass for a second.\pIn vanilla FRLG, there's actually\nno path north at all.\lI guess they removed it since RBY.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_CandyGirl {
	msgbox("The number of people who would just\nflat out ignore the candies in the\lmart, I swear to god.\pI needed to add this NPC just to\nmaybe get people to realize that\lthey were there.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_BooFuckingHoo {
	msgbox("I'd like to give a personal fuck you\nto the redditor who told me, quote,\l“Boo fucking hoo” when I said\lI don't like when people cheat rare\lcandies into my puzzle game.\pHe's clearly not smart enough to\nget this far, so I'm not worried.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_NewRetreatBench {
	msgbox(
	"This puzzle exists to help you\n"
	"remember that Retreat exists,\l"
	"and to emphasize that it'll still\l"
	"be important going forward.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_EarthboundHouse {
	msgbox("This map is a recreation of the\nsea cottage from Earthbound!\pThat map is notable for being the\norigin of My Secret Life, Chapter 3", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_LeafStone {
	msgbox(
	"There used to be a LEAF STONE here\n"
	"so you could get exeggutor in the\l"
	"nuzlocke route.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_WEmblem {
	msgbox(
	"The long, arduous trading quest\n"
	"is the intended way to find the\l"
	"W emblem, but you can just sneak\l"
	"in the back at any time.\p"

	"The For Sale signs are here so that\n"
	"if you come in early, there's still\l"
	"something fun to find on revisit!", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_MtMoonBench {
	msgbox(
	"I love how if you wanna get here\n"
	"early, you have to find the\l"
	"world's most hidden bench.\p"

	"If you don't find it, then later\n"
	"when you return with Surf you'll\l"
	"see that it was here all along!", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_AltarOfTheMoone {
	msgbox(
	"The PC here in the demos made\n"
	"everyone speculate about which\l"
	"Pokemon you needed to bring here.\p"

	"Nope!\n"
	"Not a Pokemon, silly!", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_WhatsUpcave {
	msgbox("Did you know that FRLG doesn't\nnatively have an upwards-facing\lcave entrance?\pI had to make this one!\n", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_TreePath {
	msgbox("The sneaky path through the woods\nis sooooo cool.\pYou can actually see the path by the\ntrees that don't have shadows.\lIt's very subtle.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_SecretTunnel {
	msgbox("I made this cave exactly long enough\nthat the song would reach the part\lwhere they yell “SECRET TUNNEL!”", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_MoonSquare {
	msgbox("This is like a three-layer secret\narea, and I love it!\pThe intended way of finding it is\nwith the TOWN MAP.\lYou can see a secret area called ???.\pYou can see it's to the left of the\nALTAR, but the ALTAR is hidden too!\pYou need to put a whole bunch of\nproblem solving skills to the test.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_PEmblem {
	msgbox("Adding a P Emblem to the W and L\ngives you 8 costumes in total!\pWhich one is your favorite?\n", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_CaveSwap {
	msgbox("I swapped the entrance and exit of\nthis part of the cave.\pI didn't like how it felt with the\nLass Island there when you enter.\pSuch is the minutia of detail that\ngoes into pacing a map well!", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_CrystalBerry {
	msgbox("The sprite and description of the\nCRYSTAL BERRY are from Paper Mario!", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_UndergroundPath {
	msgbox("I hate this map too.\n", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_UndergroundBench {
	msgbox("Putting a bench at the end is very,\nvery, funny.", MSGBOX_NPC)
	end
}

script Celia_UngergroundHaircutUnderConstruction {
	msgbox("Hi! I'm CELIA, the creator.\nCongrats on finding this place!\pUnfortunately it's still under\nconstruction.\lNone of the scripts are done yet!\pStill, good job getting here!\nKeep it in mind for later!", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_Gen5Girl {
	msgbox("This girl is all of us.\n", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_AshButterfree {
	msgbox("Yes, the other Butterfree was\nAsh's.\lPeople somehow miss that.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_SpearowPuzzle {
	msgbox("The Spearow puzzle to get Cut was\nactually the first one I designed!\pIt turned into the framework for\nbasically every other puzzle:\pBreak the rules of Pokemon, but\nin a logical and interesting way.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_PhishingGuru {
	msgbox("Of all the dumb nonsense that decomp\nmade available to me, I'm so glad\lI could do this stupid bit.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_UnchangedMap {
	msgbox("This is one of very, very few\ncompletely unchanged maps!\pThere's literally nothing new in\nhere, but there doesn't have to be.\lIt does what it needs to do.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_UnchangedMap2 {
	msgbox("Actually.\pI think the existence of Celia\nCommentary in this map means that\ltechnically it HAS been changed.\pHum.\n", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_FanClubRant {
	msgbox("I'm sure I will update this guy's\nrant every time a new game releases.\pPokemon fans are sadly impossible to\nplease.\psidenote: Gen IX is the best\nfuck you fight me.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_FanClubFloor {
	msgbox("The floor here is a different color\nthan usual!\pSomething with the palettes broke,\nso rather than fixed it I just\lswapped it out for a new one.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_NESChanging {
	msgbox("At one point in development, I\naccidentally replaced all newspapers\lwith NES's.\pI could've changed them back, but\nwhere's the fun in that?", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_MemorialBench {
	msgbox("This is an homage to POKéMON MY ASS\nversion.\pI haven't actually played it, and I\ncan't say I really care to, but I\lwill still pay my respects to those\lwho came before me.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_Losselle {
	msgbox("Losselle actually marked a turning\npoint for my production:\pIt was the first “Big” cutscene\nI ever worked on.\pIt gave me the confidence and skill\nto go back and add stuff like the\lLASS on Route 3.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_LEmblem {
	msgbox("Hiding a secret behind a detail that\nyou can only make out in the intro?\pFucking genius, if I do say so\nmyself.\pWhich Emblem is your favorite?\n", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_KantoLawnMaintenance {
	msgbox(
	"Here's a perfect example of how I\n"
	"write:\p"

	"I make a silly one off gag, like\n"
	"the Kanto Lawn service back in\l"
	"Viridian.\p"

	"Then I quote it again, turning it\n"
	"into a running gag.\p"

	"Then, I add it to my toolkit of\n"
	"bits - ready to deploy at any time!\p"

	"Sadly the ultimate lawn service\n"
	"punchline eventually got scrapped.\l"
	"Oh well!", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_SnorlaxMoved {
	msgbox("The only reason Snorlax is moved\nso close to the city is because\lthere's a guardhouse here normally.\pI was too lazy to think of anything\ninteresting to put there, so I\lkilled it.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_ElementarySchool {
	msgbox("Lavender Town elementary school?\nNow that's odd!\pI wonder why I'd do that!\n", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_NameRater {
	msgbox("This guy has a unique line if you\nbring him the PHIONE Egg!", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_HarryRat {
	msgbox("Fun fact: Harry's Raticate starting\nat 1 HP is actually a bug!\pBut! It's a bug I liked, so now it's\na feature.\pI'm very good at programming.\n", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_TMShop {
	msgbox("This guy is here in case you forget\nabout the Tombstoner TM.\pSeeing it in the shop might make you\nread it if you hadn't yet.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_FlowerShop {
	msgbox("In the beta, players kept going down\nthe underground path before looking\lhere to see all the rain and such.\pThus, I added a silly roadblock in\nLavender and a dumb puzzle to boot!", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_FlowerWindows {
	msgbox("I definitely think through my map\ndesign.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_Route8 {
	msgbox(
	"This was the last route I made\n"
	"before switching from binary to\l"
	"decomp.\p"

	"I designed it to show everything\n"
	"I'd learned, and push the limits\l"
	"of what I could do.\p"

	"It's a little clunky, but I'm\n"
	"prout of what I accomplished here.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_OopsVulpix {
	msgbox("I made a fatal error on this route\nin the beta.\pI accidentally put Vulpix in the\ngrass, even though it's supposed to\lonly be Doduo.\pThat's a legit problem for people\nreading the signs to find new mons!", MSGBOX_NPC)
	end
}


script CeliaSecrets_Bonus_AtNight {
	msgbox("No, you cannot change it to night.\pThis should be obvious if you check\nyour Pokedex and see that Houndour\land Murkrow don't show up.\pAlas.\n", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_GirthyOak {
	msgbox("Jokes that'll get me banned from\nPOKECOMMUNITY:", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_CeladonRandom {
	msgbox("Celadon was the absolute bottleneck\nfor development for so long.\pI couldn't think of any good ideas\nfor it, and the map was so big\lI just felt overwhelmed.\pThen one day, the idea for the rando\nhit me, and everything just clicked.\lNow it's one of my favorite parts!", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_DiglettsCave {
	msgbox("Digletts' Cave is WAY shorter than\nin vanilla.\pI absolutely hate running through\nthis place, so I needed to make\lit better.", MSGBOX_NPC)
	end
}


script CeliaSecret_PitMessage {
	lock
	faceplayer
	msgbox(
	"Incidentally, there used to be a\n"
	"scene if you Walk Through Walls\l"
	"cheated to escape.\p"

	"It was a very lovely and cute\n"
	"message, and I'm sad that code\l"
	"no longer works.\l"
	"Here it is in its entirety:", MSGBOX_DEFAULT)
	closemessage
	goto(Route1_EventScript_PitEscaped)
}

script CeliaSecret_OakParcelMessage {
	msgbox(
	"If you talk to an Oak tree with the\n"
	"PARCEL, he has unique dialogue!", MSGBOX_NPC)
}


script CeliaSecret_OakForceSurf {
	msgbox(
	"Yes, I put that Celia there just to\n"
	"force you to get here via surf.\p"

	"I cannot stop myself from making\n"
	"new gags.", MSGBOX_NPC)
}


script CeliaSecret_Aidsjoke {
	msgbox(
	"This AIDS line used to appear first\n"
	"in Lavender Town school.\p"

	"I moved it here to more properly\n"
	"establish the bit before riffing\l"
	"on it later.", MSGBOX_NPC)
}

script CeliaSecret_Teala {
	msgbox(
	"In the first releases, these\n"
	"just took you to the cable club.\p"

	"There wasn't anything fun there,\n"
	"just teala telling you that nothing\l"
	"was there.\p"

	"I couldn't think of anything, so I\n"
	"had them send you right back down.\p"

	"Fun fact, that's map index 0 so\n"
	"anytime you go out of bounds it\l"
	"warps you there.\p"

	"Teala still talks to you, so I made\n"
	"her line into:\p"

	"“Hey dumbass.\n"
	"Don't go out of bounds.”\p"

	"I see that line very, very, very\n"
	"frequently", MSGBOX_NPC)
}

script CeliaSecret_Route22Grass {
	msgbox(
	"There's specific tiles in this\n"
	"grass guaranteed to get all 3\l"
	"encounters.\p"

	"This is so speedruns and replays\n"
	"are more consistent.", MSGBOX_NPC)
}


script CeliaSecret_Impeckable {
	msgbox(
	"The Larry fight used to have\n"
	"Drill Peck, which is a way cooler\l"
	"animation than Tbolt.\p"

	"However, I also wanted to give\n"
	"nidotran the Impeckable ability.\p"

	"That conflicted with Rattata as\n"
	"the answer, so I had to swap\l"
	"the moves out.", MSGBOX_NPC)
}

script CeliaSecret_CalPit {
	msgbox(
	"This guy has unique dialogue if\n"
	"you nickname a pokemon MEWTWO\l"
	"and try to give it to him.\p"

	"People kept trying it lmfao\p"

	"Also, RIP to the scene of him\n"
	"chucking you in the pit if you\l"
	"hacked in a mewtwo early.\l"
	"Fuck you Cal LOL", MSGBOX_NPC)
}

script CeliaSecret_Nonmalicious {
	msgbox(
	"The primary purpose of Dad here\n"
	"in the forest is subtle:\l"
	"He's here to make you trust me.\p"

	"I need people to trust that I won't\n"
	"be mean to them, so they can solve\l"
	"the Butterfree puzzle.\p"

	"After spending the whole opening\n"
	"bullying you, I needed to be nice\l"
	"so you'd know I'm not malicious.", MSGBOX_NPC)
}

script CeliaSecret_10UPokedex {
	msgbox(
	"This guy serves an important\n"
	"purpose as well:\l"
	"The Pokedex is changed. Look at it.\p"

	"With how important the dex is to\n"
	"this hack, giving you an early\l"
	"piqueing of curiosity helps\l"
	"build intuition for later.", MSGBOX_NPC)
}

script CeliaSecret_OaksPC {
	msgbox(
	"Oak's PC has been a thorn in my\n"
	"side relentlessly.\p"

	"On one hand I want it available as\n"
	"hints for people who get stuck.\p"

	"On the other, I HATE that some folk\n"
	"will default to it before even\l"
	"trying to solve a puzzle.\p"

	"For the full release, I went through\n"
	"and made every hint 20x worse.\p"

	"At least now you have to sometimes\n"
	"use your goddamn brain.", MSGBOX_NPC)
}

script CeliaSecret_BrockGymGuy {
	msgbox(
	"Lots of folks were getting into\n"
	"Brock's gym entirely by chance\l"
	"while talking to NPCS.\p"

	"Thus, I moved the guy who walks\n"
	"you over a bit offscreen.\l"
	"Now you have to actively go to him.", MSGBOX_NPC)
}


script CeliaSecret_NerdBuglar {
	msgbox(
	"This nerd doesn't actually have\n"
	"an ending lol\p"

	"Originally it did, but it was\n"
	"scrapped.\p"

	"But then I didn't wanna rewrite\n"
	"the scene where he robs the\l"
	"museum.\p"

	"Thus uhhhhhhhhhhhhhhhhhhhh\n"
	"he dies the end", MSGBOX_NPC)
}

script CeliaSecret_MoonStones {
	msgbox(
	"MUK was the last Pokemon whose\n"
	"quest was decided.\p"

	"Originally Moon stones were gone\n"
	"from the game period.\l"
	"I had no plans with them.\p"

	"But then a few months before the\n"
	"release, I put those last pieces\l"
	"together and voila!", MSGBOX_NPC)
}

script CeliaSecret_BrockSneaky {
	msgbox(
	"If you try to sneak past the\n"
	"trainer, he walks around the\l"
	"rock to battle you anyway.\p"

	"Tbh you should know better by now\n"
	"anyway.", MSGBOX_NPC)
}


script CeliaSecret_Xrays {
	msgbox(
	"Yes.\p"

	"X Rays.\p"

	"From the moon.\n"
	"", MSGBOX_NPC)
}

script CeliaSecret_MoonShortcut {
	msgbox(
	"Holy fuck getting people to\n"
	"read this sign and then actually\l"
	"fucking TAKE the shortcut\p"

	"I have no clue why it's so hard\n"
	"to be nice to people.", MSGBOX_NPC)
}


script CeliaSecret_MoonCandy {
	msgbox(
	"I like how there's two ways to get\n"
	"to this candy.\p"

	"Either you figure out walking thru\n"
	"walls early, or you remember it\l"
	"and come back with surf.\p"

	"Either way it's a satisfying\n"
	"puzzle!", MSGBOX_NPC)
}

script CeliaSecret_GreatBayEarly {
	msgbox(
	"You can access this tiny bit of\n"
	"Great Bay early!\p"

	"If you stumble upon it, I love how\n"
	"it gives the vibe of there being\l"
	"WAY more adventure to come.", MSGBOX_NPC)
}


script CeliaSecret_NoMorePC {
	msgbox(
	"There used to be a PC here for one\n"
	"update, but I got rid of it for\l"
	"pacing reasons.\p"

	"Here's the deleted dev commentary\n"
	"Celias that talked about the PC!", MSGBOX_NPC)
}


script CeliaSecret_MoltresFight {
	msgbox(
	"In the first versions, there was no\n"
	"puzzle to this fight.\p"

	"Realizing that the sandshrew in\n"
	"the grass would match up perfectly\l"
	"to a Moltres here was what made me\l"
	"commit to all rivals having puzzles.\p"

	"That then led to the glorious\n"
	"final battle.", MSGBOX_NPC)
}

script CeliaSecret_SingingFerret {
	msgbox(
	"This lady is the reason for the\n"
	"beautiful release patch of:\p"

	"Celias' Stupid Romhack Demo 2 v2\n"
	"Removed the Singing Ferret\p"

	"Also apparently this fight fucking\n"
	"sucked in the speedrun.", MSGBOX_NPC)
}

script CeliaSecret_GrassEnergy {
	msgbox(
	"When this guy gives you scyther,\n"
	"it's holding a Grass energy.\p"

	"This is to prevent you being\n"
	"softlocked by running out of\l"
	"money for pokeballs and being\l"
	"unable to beat Jerry.", MSGBOX_NPC)
}

script CeliaSecret_TCGIsland {
	msgbox(
	"Music here is the world map from\n"
	"Pokemon TCG!\p"

	"I completely re-imagined the\n"
	"original track to fit the style.\l"
	"Very happy with how it came out!", MSGBOX_NPC)
}

script CeliaSecret_TCGPause {
	msgbox(
	"This center uses the pause music\n"
	"from Pokemon TCG.\p"

	"This is a center you'll spend a lot\n"
	"of time in cuz of early game\l"
	"evolutions, so I gave it a custom\l"
	"track to make it more fun.", MSGBOX_NPC)
}

script CeliaSecret_RockTunnelGirl {
	msgbox(
	"This girl is a new addition.\p"

	"She shows up as a way to build\n"
	"anticipation for the upcoming\l"
	"ROCK TUNNEL fakeout.\p"

	"I needed to plant the idea in your\n"
	"head so the skip gag landed right.", MSGBOX_NPC)
}


script CeliaSecret_NoOneLivesHere {
	msgbox(
	"The line on the day care door\n"
	"is actually a line from GSC!\p"

	"If you examine this house's door\n"
	"in that game, you'll see this line.\p"

	"Only thing is, the house ISN'T for\n"
	"sale.\l"
	"The door isn't locked, and there's\l"
	"people there.\p"

	"It's an odd case of a leftover\n"
	"from a different design direction.", MSGBOX_NPC)
}

script CeliaSecret_ScrappedComms {
	msgbox(
	"The very, very first instance of\n"
	"the dev commentary quest was to\l"
	"bring your Toxic Sludge to this\l"
	"map and melt the north guard first.\p"

	"That's how hidden I WANTED the\n"
	"puzzles to be.\p"

	"However, I didn't want to make the\n"
	"dev commentary a missable reward,\l"
	"so that method is scrapped.", MSGBOX_NPC)
}

script CeliaSecret_LookGirlPC {
	msgbox(
	"Here's where I discovered the true\n"
	"use of the Look girl:\l"
	"Making players actually fucking\l"
	"look at the screen.\p"

	"Nobody noticed that I put a PC here\n"
	"for convenience with the trade,\l"
	"so I put her here to draw attention\l"
	"to it.", MSGBOX_NPC)
}


script CeliaSecret_UndergroundHaircut {
	msgbox(
	"One element I wanted to emphasize\n"
	"was hiding things under your nose.\p"

	"Putting a whole secret area just\n"
	"offscreen in the underground map\l"
	"with giant arrows but they can't\l"
	"be seen without flash?\l"
	"Genius.", MSGBOX_NPC)
}

script CeliaSecret_HaircutDialogue {
	msgbox(
	"This guy has a few bonus lines of\n"
	"dialogue if you show him different\l"
	"Pokemon!", MSGBOX_NPC)
}

script CeliaSecret_ShinyBellsprout {
	msgbox(
	"This shiny went from being the\n"
	"worst in the game to one of my\l"
	"favorites!\p"

	"I really hope most people find it\n"
	"with the 2-stage shiny bike like\l"
	"they're supposed to.", MSGBOX_NPC)
}

script CeliaSecret_UndergroundCandy {
	msgbox(
	"Making people WILLINGLY return to\n"
	"Underground Path Hell a second\l"
	"time to get a candy?\l"
	"Devious.", MSGBOX_NPC)
}

script CeliaSecret_InvisibleHeal {
	msgbox(
	"There's a hidden line of triggers\n"
	"that heals your party right here!\p"

	"That's cuz the Butterfree fight is\n"
	"weirdly difficult, and I didn't\l"
	"want people to white out all the\l"
	"way back to Cerulean.\p"

	"I just don't draw attention to the\n"
	"fact that it happens, and people\l"
	"usually don't notice.\p"

	"Invisible game design!\n"
	"", MSGBOX_NPC)
}


script CeliaSecret_TentacruelStoryline {
	msgbox(
	"This guy's the remnants of a\n"
	"scrapped storyline!\p"

	"I wanted to have a DMCA radio tower\n"
	"takedown bit involving Tentacruel\l"
	"from the anime, but the pieces\l"
	"never quite lined up right.", MSGBOX_NPC)
}


script CeliaSecret_BulldozeItems {
	msgbox(
	"The fact that placing two items\n"
	"here took me line 5 seperate tries\l"
	"was my first clue that decomp was\l"
	"gonna be WAY harder than HMA.\p"

	"geez.\n"
	"", MSGBOX_NPC)
}

script CeliaSecret_OnixHead {
	msgbox(
	"Okay so look TECHNICALLY Vermilion\n"
	"isn't exactly on the other side of\l"
	"the globe from the Onix guy, but-\p"

	"This was the one place I could be\n"
	"reasonably sure you'd revisit\l"
	"at least twice, regardless of\l"
	"if you'd gotten statues early.\p"

	"That made it the best possible\n"
	"spot to put the rest of the sign.", MSGBOX_NPC)
}

script CeliaSecret_VermilionHbox {
	msgbox(
	"I hope at least one person finds\n"
	"the hidden item back here.", MSGBOX_NPC)
}

script CeliaSecret_NextToTruck {
	msgbox(
	"This bonus Celia has been sitting\n"
	"here since the first release,\l"
	"with no purpose but taunting you.\p"

	"What can I say?\n"
	"I like fucking with people.", MSGBOX_NPC)
}

script CeliaSecret_FirstCan {
	msgbox(
	"Fun fact: There's only one unique\n"
	"solution to the trash can puzzle.\p"

	"The first can NEEDS to be here,\n"
	"otherwise the rest of the switches\l"
	"cannot logically be placed.\p"

	"It is technically possible to\n"
	"deduce the starting can.\l"
	"If you're, idk, fuckin insane.", MSGBOX_NPC)
}

script CeliaSecret_Loss_1 {
	msgbox(
	"Okay so listen.\n"
	"I like the loss route.", MSGBOX_NPC)
}

script CeliaSecret_Loss_2 {
	msgbox(
	"However…\n"
	"I hate what it means for the game.", MSGBOX_NPC)
}


script CeliaSecret_Loss_3 {
	msgbox(
	"This is not “Hahaha pokemon but\n"
	"there's memes lol internet jokes”\p"

	"And I really resent the perception\n"
	"it had for a while.", MSGBOX_NPC)
}

script CeliaSecret_Loss_4 {
	msgbox(
	"To me, this route was always a bit\n"
	"emblematic of the way I didn't\l"
	"want this game to be seen.", MSGBOX_NPC)
}

script CeliaSecret_Loss_5 {
	msgbox(
	"Which is a shame cuz I think that\n"
	"hiding a loss joke within the\l"
	"layout of a route is pretty\l"
	"goddamn funny!!", MSGBOX_NPC)
}

script CeliaSecret_Loss_6 {
	msgbox(
	"Oh well.\p"

	"At the end of the day, anyone who\n"
	"ACTUALLY plays the game instead of\l"
	"watching youtube videos of it\l"
	"will understand this.", MSGBOX_NPC)
}

script CeliaSecret_Misberriage {
	msgbox(
	"This hidden item caused me immense\n"
	"suffering, cuz sometimes it just\l"
	"wouldn't show up.\p"

	"Apparently it was linked to a weird\n"
	"gen 3 mechanic of hidden items\l"
	"only occasionally being available.\p"

	"I thiiiiiiiiiink I fixed it, but\n"
	"I can never really be sure.", MSGBOX_NPC)
}

script CeliaSecret_LossPond {
	msgbox(
	"At one point I planned to add a\n"
	"secret over here.\p"

	"Alas, nothing ever really stuck.\n"
	"So there isn't anything here.", MSGBOX_NPC)
}

script CeliaSecret_LosselleDisappears {
	msgbox(
	"The reason Losselle says she'll\n"
	"stay there at the end of the scene\l"
	"is cuz when I first made it, I\l"
	"didn't know how to make NPCs\l"
	"disappear from the overworld.\p"

	"I never re-visited it cuz I didn't\n"
	"wanna re-write anything here.", MSGBOX_NPC)
}

script CeliaSecret_BacktrackSecret {
	msgbox(
	"Fun fact, you can retreat from this\n"
	"route all the way to the bench on\l"
	"the other side of the underground\l"
	"path!", MSGBOX_NPC)
}

script CeliaSecret_Hi {
	msgbox(
	"Hi!\n"
	"", MSGBOX_NPC)
}

script CeliaSecret_ElementarySchool {
	msgbox(
	"I think the existence of the\n"
	"elementary school here is enough\l"
	"for you to be able to predict the\l"
	"entire Marowak Kangaskhan DMCA\l"
	"plotline at the top of the tower.\p"

	"I don't think anyone ever actually\n"
	"DID predict it, but hey.", MSGBOX_NPC)
}

script CeliaSecret_LifeChapterThree {
	msgbox(
	"This was the first area I wrote\n"
	"variants of the Secret Life gag!", MSGBOX_NPC)
}


script CeliaSecret_EllipsisExclamation {
	msgbox(
	"At one point, I got rid of the\n"
	"music in this room to set up the\l"
	"ominousness of the imminent second\l"
	"underground path.\p"

	"I then switched this guy's dialogue\n"
	"to end with an … instead of a ! .\p"

	"That's the level of detail I need\n"
	"in order to balance the tone of\l"
	"this game.", MSGBOX_NPC)
}

script CeliaSecret_LarryWarp {
	msgbox(
	"Originally this warp tile led to\n"
	"the Larry 2 fight.\p"

	"However people kept completely\n"
	"ignoring it, meaning they'd get\l"
	"stuck trying to find bidoof.\p"

	"Thus, I re-arranged the Silph\n"
	"warp maze such that this just\l"
	"leads you back.\p"

	"PS you can check the wall where\n"
	"the elevator used to be.", MSGBOX_NPC)
}

script CeliaSecret_Masuda {
	msgbox(
	"This is Masuda's daughter!\p"

	"Sadly the line about her daddy\n"
	"making sure you can catch\l"
	"psyduck in every game doesn't\l"
	"quite hold true  anymore.\p"

	"Alas!\n"
	"", MSGBOX_NPC)
}




script CeliaSecrets_Litwicks {
	msgbox(
	"Well, here we are.\n"
	"Burning.\p"

	"There are 27 unique conversations\n"
	"that these guys can have!\p"

	"Sadly the vast majority of people\n"
	"only talk to them once each.\p"

	"Alas.\n"
	"", MSGBOX_NPC)
}

script CeliaSecrets_Misspelling {
	msgbox(
	"Sigh… … …\p"

	"Yes.\p"

	"This guy's mispellings are on\n"
	"purpose.\l"
	"{PAUSE 45}…That one was too.", MSGBOX_NPC)
}

script CeliaSecrets_PrincipleDefinitions {
	msgbox(
	"This is a joke that I'm sure\n"
	"single-digit numbers of players\l"
	"will actually understand.\p"

	"Oh well.\n"
	"", MSGBOX_NPC)
}


script CeliaSecrets_Poincare {
	msgbox(
	"This is the only one of the\n"
	"Millennium Problems that's been\l"
	"solved!\p"

	"I had to consult some mathy folk\n"
	"to make sure I phrased the question\l"
	"correctly.", MSGBOX_NPC)
}


script CeliaSecrets_Stanley {
	msgbox(
	"The purified and protected zone\n"
	"is me trying to channel the\l"
	"Stanley Parable as best I can.\p"

	"Frustratingly, I apparently did it\n"
	"so well that some folks think I\l"
	"just ripped quotes from the game.\p"

	"Alas.\n"
	"", MSGBOX_NPC)
}

script CeliaSecrets_OldManIsland {
	msgbox(
	"I don't actually have a line for\n"
	"this celia.\p"

	"It's just here to fuck with people\n"
	"before Surf was available.", MSGBOX_NPC)
}

script CeliaSecrets_BirdCultists {
	msgbox(
	"The “Bird Cultist” here is a\n"
	"leftover from a dropped plotline.\p"

	"Originally there was a boss rush\n"
	"against a bunch of 'em to get the\l"
	"float stone, but I couldn't get it\l"
	"to work.\p"

	"So there's just one or two guys\n"
	"hanging out.", MSGBOX_NPC)
}

script CeliaSecrets_Frick {
	msgbox(
	"This guy's Igglybuff's cry being\n"
	"FRICKING FRICK is distressingly\l"
	"underrated.", MSGBOX_NPC)
}


script CeliaSecrets_Porygon {
	msgbox(
	"I'll confess that finding coins\n"
	"on the ground to buy a Porygon\l"
	"is prolly the weakest puzzle here.\p"

	"It stems from a time when this was\n"
	"more of a trivia game, and progress\l"
	"was gated by knowing details.\p"

	"It's not a puzzle I would design\n"
	"nowadays, but it was one I couldn't\l"
	"ever really change. Oh well.", MSGBOX_NPC)
}

script CeliaSecrets_PrinterMachine {
	msgbox(
	"One of my goals in this project was\n"
	"getting people to engage with the\l"
	"fun, silly casual side of things.\p"

	"When's the last time you used the\n"
	"printer machine in a romhack?", MSGBOX_NPC)
}


script CeliaSecrets_MeltedGuard {
	msgbox(
	"This quest was based on a story told\n"
	"by BikdipOnABus, about when he\l"
	"played Japanese FRLG first.\p"

	"Apparently he interpreted the Tea\n"
	"sprite as being a vat of toxic\l"
	"waste, which is fucking hilarious.", MSGBOX_NPC)
}

script CeliaSecrets_MeltedGuardSteps {
	msgbox(
	"After you step in the melted guard,\n"
	"you leave footprints on the floor!", MSGBOX_NPC)
}


script CeliaSecrets_GrowlitheSign {
	msgbox(
	"When the growlithe sign blinks,\n"
	"it's not the sprite animating.\p"

	"Instead, I draw map tiles under him\n"
	"with his eyes closed, and then I\l"
	"toggle the sprite visibility!\p"

	"…I have since learned how to\n"
	"make sprites blink.", MSGBOX_NPC)
}

script CeliaSecrets_MewNerd {
	msgbox(
	"This joke sadly gets lost in\n"
	"translation.\p"

	"He's one of the trainers you could\n"
	"perform the Mew glitch with in RBY.\p"

	"The idea is that he thinks the\n"
	"glitch was the intended method, so\l"
	"he complains that it's obscure.", MSGBOX_NPC)
}

script CeliaSecrets_LegendaryDaisy {
	msgbox(
	"I wonder if that flower tile\n"
	"under the Lass is special…", MSGBOX_NPC)
}

script CeliaSecrets_BenchPush {
	msgbox(
	"In the demos, no one realized the\n"
	"bench was interactable.\p"

	"Thus, I added a little bobbing\n"
	"animation to it to draw your eye.\p"

	"Now you talk to it without thinking,\n"
	"triggering the bench push scene.", MSGBOX_NPC)
}

script CeliaSecrets_NoCutscene {
	msgbox(
	"Narrator voice:\n"
	"She never put a cutscene here.", MSGBOX_NPC)
}


script CeliaSecrets_LookerScene {
	msgbox(
	"I don't like removing player\n"
	"agency to explore and do what\l"
	"you want.\p"

	"Railroading you into the Looker\n"
	"cutscene for the rotom dex is the\l"
	"only time in the game I do this.\p"

	"I hope you can agree that it was,\n"
	"overall, worth it.", MSGBOX_NPC)
}

script CeliaSecrets_Whirlpool {
	msgbox(
	"The reason this guy has Clamperl is\n"
	"cuz that was the gift Pokemon given\l"
	"to you in Shiny Gold for Whirlpool!\p"

	"That game was my childhood, fuckin\n"
	"classic.", MSGBOX_NPC)
}


script CeliaSecrets_Wraparound {
	msgbox(
	"The reason the westward direction\n"
	"is blocked from the shore is cuz\l"
	"I wanted to force you to see the\l"
	"world wraparound from Minnesota.", MSGBOX_NPC)
}

script CeliaSecrets_SSAnneBoat {
	lock
	faceplayer
	msgbox(
	"Fun fact! This boat isn't layered\n"
	"below the rocks!\p"

	"The cliffs above it are manually\n"
	"carved out of the sprite itself!\p"

	"Check it out!\n"
	"", MSGBOX_DEFAULT)
	closemessage
	applymovement(LOCALID_RIPBOAT, moves(
		walk_right * 2
	))
	waitmovement(0)
	release
}

script CeliaSecrets_BlindPeople {
	msgbox(
	"A bunch of blind players joined my\n"
	"discord once asking if their\l"
	"screen readers would work with the\l"
	"hack.\p"

	"Sadly it wouldn't, so instead I put\n"
	"on a full in-call commentated\l"
	"adventure style playthrough for em.\p"

	"It was fun. I then made you push\n"
	"them into holes.", MSGBOX_NPC)
}

script CeliaSecret_HarryWorld {
	msgbox(
	"For some reason all my playtesters\n"
	"struggled HARD with this puzzle.\p"

	"It is literally USE THE BARRY BERRY\n"
	"ON BARRY.\l"
	"Idk how to make it easier.\p"

	"Anyway the bit is inspired by that\n"
	"one Fairly Oddparents bit.", MSGBOX_NPC)
}

script CeliaSecret_UnderTheFloorboards {
	msgbox(
	"I wanted to have wood under these\n"
	"floorboards.\l"
	"Y'know, showing the deck below.\p"

	"Unfortunately it just confused\n"
	"people, so it's water instead.", MSGBOX_NPC)
}


script CeliaSecret_BrailleLife {
	msgbox(
	"This braille is here so that later\n"
	"when you have to translate the\l"
	"letter W, you already have a\l"
	"translator on-hand.\p"

	"Yes I know it says lif.\n"
	"Blame font size.\p"

	"ps the chair is braille\n"
	"", MSGBOX_NPC)
}

script CeliaSecret_DeadRat2 {
	msgbox(
	"This Raticate sprite was originally\n"
	"made for the first draft of the\l"
	"final battle.\p"

	"This was LONG before they had\n"
	"birds.", MSGBOX_NPC)
}

script CeliaSecret_Theseus {
	msgbox(
	"I like this Celia because most\n"
	"players will think it's entirely\l"
	"out of reach.\p"

	"Nice job talking to me!\n"
	"", MSGBOX_NPC)
}

script CeliaSecret_Chapter7 {
	msgbox(
	"I've never played final fantasy.\n"
	"", MSGBOX_NPC)
}

script CeliaSecret_TrendySayingsMan {
	msgbox(
	"This is from an old guide for\n"
	"Diamond/Pearl.\p"

	"Idk why I just thought the label\n"
	"they gave to an old dude's house\l"
	"was really funny.", MSGBOX_NPC)
}

script StarLightHouseComingSoon {
	msgbox(
	"STARLIGHT'S MAP MAKING HOUSE\n"
	"Coming Soon!", MSGBOX_SIGN)

}

script CeliaSecret_HalfSign {
	msgbox(
	"The idea for playing half the\n"
	"Pokemon Sign jingle here came from\l"
	"Banjo Tooie!\p"

	"There's a bit where the jiggy\n"
	"jingle gets cut off halfway thru", MSGBOX_SIGN)

}

script CeliaSecret_Palworld {
	msgbox(
	"Look, I don't {ASTERISK}like{ASTERISK} PALWORLD.\p"

	"But disliking a lazy, derivative\n"
	"slop fest is not enough to make me\l"
	"abandon my principles.\p"

	"Corporate ownership and monopoly\n"
	"over creative choices is bullshit.\l"
	"I will not support Pokemon on this.", MSGBOX_NPC)
}

script CeliaSecret_FourDayCare {
	msgbox(
	"In vanilla Four Island, the Day\n"
	"Care is on the left side of town.\p"

	"But! I thought that'd be too soon\n"
	"after the last Furret House bit,\l"
	"so I moved it to this side of the\l"
	"island to put some space between.", MSGBOX_NPC)
}



script CeliaSecret_FourIslandIntro {
	msgbox(
	"Took me like 20 iterations to\n"
	"decide on an opening line of\l"
	"text for Four Island.\p"

	"I like this one.\n"
	"", MSGBOX_NPC)
}


script CeliaSecret_ElectricDark {
	msgbox(
	"Listen, I like Electric/Dark\n"
	"Luxray.\l"
	"I really do.\p"

	"It's certainly better than Poison\n"
	"Dragon Arbok.\l"
	"Or Psychic Venomoth.", MSGBOX_NPC)
}

script CeliaSecret_OddMulch {
	msgbox(
	"After you buy Odd Mulch from this\n"
	"guy, you can hear the music\l"
	"fade out for a sec and then in.\p"

	"That's cuz if you left the map\n"
	"while the jingle was still playing,\l"
	"the game would crash.\l"
	"I had to reset the sound.", MSGBOX_NPC)
}

script CeliaSecret_StrugglingDucks {
	msgbox(
	"These psyducks were once blocking\n"
	"a yellow tree that would've been\l"
	"imposter oak.\p"

	"To clear them you'd have to use\n"
	"the SecretEther from Ampharos.\p"

	"Talking to them, it'd say “The\n"
	"POKéMON are struggling.”\p"

	"Sadly, the puzzle payoff got\n"
	"scrapped so it's unimplemented.", MSGBOX_NPC)
}


script CeliaSecret_Weast {
	msgbox(
	"Listen I never said I was good\n"
	"at directions.", MSGBOX_NPC)
}

script CeliaSecret_LostTower {
	msgbox(
	"You can find the tower in the\n"
	"other tower!\p"

	"Inception :)\n"
