}

script CeliaSecret_NormalRock {
	msgbox(
	"For 90% of development, the third\n"
	"eevee was gonna be Lumineon.\l"
	"Using a Shiny Stone.\p"

	"But then I realized that the bit\n"
	"went down in absurdity after the\l"
	"Latias evo, so I needed a better\l"
	"capstone for it.\p"

	"Sidenote, I love “It is normal\n"
	"to the touch.”", MSGBOX_NPC)
}


script CeliaSecret_Drifloon {
	msgbox(
	"I played Diamond first.\p"

	"I hate Amity Square with literally\n"
	"every fucking fiber of my being\l"
	"cuz they wouldn't let me bring my\l"
	"ADORABLE and perfect and lovely\l"
	"Wooper but somehow they had the\l"
	"fucking GALL to say that the ugly\l"
	"ass piece of FUCK shit called\l"
	"Drifloon is acceptable.\p"

	"Oh my fucking god.\n"
	"", MSGBOX_NPC)
}


