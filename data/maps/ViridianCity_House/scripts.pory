}

script CeliaSecret_StopNSwop {
	msgbox(
	"This was going to be the source of\n"
	"a STOP N SWOP event using Pokemon\l"
	"Pisces version.\p"

	"Sadly the update that would've\n"
	"done it hasn't released yet, so\l"
	"you can't do it as intended.\p"

	"If you want to try anyway, feel\n"
	"free!\l"
	"The third word is “GOTTEN.”", MSGBOX_NPC)
}

script CeliaSecret_NewGamePlus {
	lock
	faceplayer
	msgbox(
		"Hi!\n"
		"Welcome to New Game Plus!\p"

		"I didn't design this hack with it\n"
		"in mind, but apparently the flag\l"
		"that hides the bonus Celias\l"
		"doesn't have to reset on new files.\p"

		"I'm going to pretend that this\n"
		"was intended all along.\p"

		"Alternatively, I can disable\n"
		"this for you if you just want to\l"
		"have a raw Celia experience.\p"

		"Would you like to begin on\n"
		"New Game+?", MSGBOX_YESNO)
		if(var(VAR_RESULT)) {
			setflag(FLAG_NEW_GAME_PLUS)
			setflag(FLAG_CELIA_SECRET_PIT)
			setflag(FLAG_CELIA_SECRET_PALLET)
			setflag(FLAG_CELIA_SECRET_VIRIDIAN)
			setflag(FLAG_CELIA_SECRET_PEWTER)
			setflag(FLAG_CELIA_SECRET_CERULEAN)
			setflag(FLAG_CELIA_SECRET_VERMILION)
			setflag(FLAG_CELIA_SECRET_LAVENDER)
			setflag(FLAG_CELIA_SECRET_CELADON)
			setflag(FLAG_CELIA_SECRET_FUCHSIA)
			setflag(FLAG_CELIA_SECRET_CINNABAR)
			setflag(FLAG_CELIA_SECRETS_FINISHED)
			clearflag(FLAG_HIDE_CELIA_IN_CERULEAN_BACK)
			additem(ITEM_CANDY_DISPENSER)
			msgbox(
			"Awesome!\n"
			"Have fun!", MSGBOX_DEFAULT)
		} else {
			msgbox(
			"Gotcha!\n"
			"Have fun!", MSGBOX_DEFAULT)
			removeobject(VAR_LAST_TALKED)
		}
		release
		end
}


script CeliaSecret_MinnesotaSize {
	msgbox(
	"When my mapmaker Starlight made\n"
	"Minnesota, the first draft of the\l"
	"map was about 4x the size of the\l"
	"rest of Kanto combined.\p"

	"Needless to say, we had a little\n"
	"talk about that LOL", MSGBOX_NPC)
}

script CeliaSecret_WorldWrap {
	msgbox(
	"Making the game world loop back on\n"
	"itsself was one of the big things\l"
	"I wanted for the great sea.\p"

	"Mostly because having a giant wall\n"
	"of rocks at the border would've\l"
	"been super boring.", MSGBOX_NPC)
}


script CeliaSecret_Hakari {
	msgbox(
	"Hakari joined the dev team like\n"
	"one month before the release.\p"

	"Despite this, he IMMEDIATELY\n"
	"picked up on the vibe, and his\l"
	"move animations are incredible.\p"

	"Excellent work!\n"
	"", MSGBOX_NPC)
}

script CeliaSecret_Pittsburg {
	msgbox(
	"Go to wplace to see the Celia I\n"
	"drew near Pittsburg!", MSGBOX_NPC)
}

script CeliaSecret_Golurk {
	msgbox(
	"There was gonna be a secret here\n"
	"for bringing this guy a Golurk.\p"

	"Golurk is, famously, green.\p"

	"Unfortuantely FRLG doesn't show\n"
	"Pokedex Color by default, so I\l"
	"had to scrap the secret.", MSGBOX_NPC)
}

script CeliaSecret_MartDialogue {
	msgbox(
	"I really hate writing Mart NPCS.\p"

	"What the fuck do you make them\n"
	"say?", MSGBOX_NPC)
}

script CeliaSecret_NoZubats {
	msgbox(
	"In Mt Moon, the game very heavily\n"
	"implies that Zubats will be all\l"
	"over the ocean.\p"

	"This is compounded with trainers\n"
	"having them with Shadow Tag.\p"

	"By the time you actually get to the\n"
	"Great Sea, you've probably already\l"
	"forgotten about them.\p"

	"This lady reminds you Oh Yeah, I'm\n"
	"Supposed To Be Annoyed Right Now.", MSGBOX_NPC)
}

script CeliaSecret_BidoofInSilph {
	msgbox(
	"This NPC has moved places like 20\n"
	"times.\p"

	"At first she was on Four Island,\n"
	"but then I put her in Saffron to\l"
	"get people to finish Silph.\p"

	"But after moving her, people were\n"
	"having trouble remembering that\l"
	"Silph exists.\p"

	"Thus, she's now here to push you\n"
	"to go back there.", MSGBOX_NPC)
}

script CeliaSecret_LongRangeCut {
	msgbox(
	"I wanted you to be able to cut this\n"
	"guy long range across the conuter.\p"

	"Sadly it proved to be too hard with\n"
	"how Cut works in the engine, so I\l"
	"had to cut it.", MSGBOX_NPC)
}


script CeliaSecret_Sheldon {
	msgbox(
	"He went to college!\n"
	"", MSGBOX_NPC)
}


script CeliaSecret_Genocide {
	msgbox(
	"Genocide route…\n"
	"", MSGBOX_NPC)
}


script CeliaSecret_AroundTheWorld {
	msgbox(
	"This girl despawns from the little\n"
	"island above sooner than I'd like.\p"

	"Oh well.\n"
	"", MSGBOX_NPC)
}


script CeliaSecret_Entei {
	msgbox(
	"Filling the world with clues to\n"
	"the Arcanine Gun puzzle was tricky.\p"

	"They needed to feel like one-off\n"
	"jokes in isolation, and only with\l"
	"context you'd know they were more.", MSGBOX_NPC)
}


script CeliaSecret_Superbowl {
	msgbox(
	"I love the superb owl.\n"
	"I look forward to it every year.\p"

	"Anyway, look up Look How Calm\n"
	"She Is for my favorite gif ever.", MSGBOX_NPC)
}


script CeliaSecret_MagnetTrain {
	msgbox(
	"The subway loopback here from\n"
	"Saffron was to keep Waterfall\l"
	"gated until after you did Silph.\p"

	"I did everything in my power to\n"
	"get people to do Seafoam before\l"
	"doing Bill's Garden so they could\l"
	"see the north/south loopback.", MSGBOX_NPC)
}


script CeliaSecret_MiltankPhilosophy {
	msgbox(
	"In the game's code, I dubbed this\n"
	"exchange, “Miltank Philosophy”.", MSGBOX_NPC)
}


script CeliaSecret_MiltankScratch {
	msgbox(
	"A scrapped puzzle here was that the\n"
	"Miltank was sick, so you needed to\l"
	"heal it up.\p"

	"Berries wouldn't work, so you'd\n"
	"need to use a move that heals.\p"

	"Rest would be an option, but you\n"
	"could also use Scratch for the 1/8\l"
	"heal chance.\p"

	"If you did Scratch, the Miltank\n"
	"would die and the girl would sell\l"
	"you a hamburger.", MSGBOX_NPC)
}


script CeliaSecret_SurfSprite {
	msgbox(
	"For some reason, the player's\n"
	"surf sprite gets copied every\l"
	"32 tiles off screen.\p"

	"When the camera moves, you could\n"
	"see the surf sprite copies and\l"
	"it looked glitchy.\p"

	"You can still see one of them during\n"
	"the cutscene, but I covered the\l"
	"second up with clever tile\l"
	"layering.\p"

	"It would've been right here.\n"
	"", MSGBOX_NPC)
}

script CeliaSecret_EnvironmentalStorytelling {
	msgbox(
