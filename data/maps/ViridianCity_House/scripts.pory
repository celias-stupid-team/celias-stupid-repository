script CeliaSecret_Dividum {
	msgbox(
	"Dividum's sprite is made so its\n"
	"tail is entirely behind its body.\p"

	"I had no clue how to make a tail\n"
	"with two floating dots, so I hid\l"
	"it and left it to the imagination.", MSGBOX_NPC)
}

script CeliaSecret_NuggetHeal {
	msgbox(
