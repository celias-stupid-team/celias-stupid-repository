raw `
SafariZone_East_RestHouse_MapScripts::
	.byte 0

SafariZone_East_RestHouse_EventScript_Rocker::
	msgbox SafariZone_East_Text_CaughtChanseyAllWorthwhile, MSGBOX_NPC
	end

SafariZone_East_RestHouse_EventScript_Scientist::
	msgbox SafariZone_East_Text_HowManyDidYouCatch, MSGBOX_NPC
	end

SafariZone_East_RestHouse_EventScript_BaldingMan::
	msgbox SafariZone_East_Text_TiredFromAllTheFun, MSGBOX_NPC
	end
`
script SafariZone_RestHouse_FishingGuru {
	setflag(FLAG_CSR_HINT_DRAGONITE)
	call(SetPlayerPokedexValues)
	if(flag(FLAG_HIDE_DMCA_IN_SAFARI_ZONE)) {
		msgbox("FISHING GURU's BROTHER'S COUSIN:\nHello! I am the FISHING GURU'S\lBROTHER'S COUSIN!\pOh? You thought I was the FISHING\nGURU's BROTHER?\lNope!\pNever heard of him.\nHe from around here?", MSGBOX_NPC)
		end
	} elif(flag(FLAG_BATTLED_IRON_CLEFTS)) {
		msgbox("FISHING GURU's BROTHER: You\ndefeated the DMCA's POKéMON?\lIncredible work!\pBut they're still here…\nWe must be rid of them.\pGo talk to my good friend, the\nWARDEN.\lHe might be able to help.", MSGBOX_NPC)
		end
	}
	
	if(flag(FLAG_TALKED_TO_FISHING_GURU)) {
	msgbox("FISHING GURU'S BROTHER: The DMCA\nare after DRAGONITE.\pIf we want to stop them, you'll\nneed to find one somewhere.\lIt won't be in the SAFARI ZONE.\pGood luck.\nI'm sure you can save us!", MSGBOX_NPC)	
	} else {
		setflag(FLAG_TALKED_TO_FISHING_GURU)
	msgbox("FISHING GURU's BROTHER: You…\nYou aren't with them, right?\pI'm the FISHING GURU'S BROTHER.\pThe DMCA attacked me, but I escaped.\nI overheard what they're up to.\lMaybe it'll help us out.\pThey're after the prize POKéMON\nin the SAFARI ZONE: a DRAGONITE.\lThey say it violates copyright.\pBut don't worry, it's safe.\nIt's nowhere to be found in here.\pI think if you want to stop them,\nyou'll need to find one yourself.\pGood luck in your search.\nI believe in you!", MSGBOX_NPC)
	}
	end
}