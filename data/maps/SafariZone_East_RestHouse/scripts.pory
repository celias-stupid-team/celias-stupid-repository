`
script SafariZone_RestHouse_FishingGuru {
	if(flag(FLAG_TALKED_TO_FISHING_GURU)) {
	msgbox("FISHING GURU'S BROTHER: The DMCA\nare after DRAGONITE.\pIf we want to stop them, you'll\nneed to find one somewhere.\lIt won't be in the SAFARI ZONE.\pGood luck.\nI'm sure you can save us!", MSGBOX_NPC)	} else {
		setflag(FLAG_TALKED_TO_FISHING_GURU)
	msgbox("FISHING GURU's BROTHER: You…\nYou aren't with them, right?\pI'm the FISHING GURU'S BROTHER.\pThe DMCA attacked me, but I escaped.\nI overheard what they're up to.\lMaybe it'll help us out.\pThey're after the prize POKéMON\nin the SAFARI ZONE: a DRAGONITE.\lThey say it violates copyright.\pBut don't worry, it's safe.\nIt's nowhere to be found in here.\pI think if you want to stop them,\nyou'll need to find one yourself.\pGood luck in your search.\nI believe in you!", c)
	}
	end
}