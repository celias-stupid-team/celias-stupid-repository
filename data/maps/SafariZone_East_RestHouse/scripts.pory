raw `
SafariZone_East_RestHouse_MapScripts::
	.byte 0

SafariZone_East_RestHouse_EventScript_Rocker::
	msgbox SafariZone_East_Text_CaughtChanseyAllWorthwhile, MSGBOX_NPC
	end

SafariZone_East_RestHouse_EventScript_Scientist::
	msgbox SafariZone_East_Text_HowManyDidYouCatch, MSGBOX_NPC
	end

SafariZone_East_RestHouse_EventScript_BaldingMan::
	msgbox SafariZone_East_Text_TiredFromAllTheFun, MSGBOX_NPC
	end
`
script Script_Name {
	if(flag(FLAG_TALKED_TO_FISHING_GURU)) {
		msgbox("If we want to stop the DMCA, you'll\nneed to obtain a DRAGONITE.\lAfterwards, you need to evolve it.\pGood luck.\nI'm sure you can save us!", MSGBOX_NPC)
	} else {
		setflag(FLAG_TALKED_TO_FISHING_GURU)
		msgbox("FISHING GURU: You...\nYou aren't with them, right?\pI'm the FISHING GURU here in\nFUSHCIA CITY.\lThe DMCA attacked me, but I escaped.\pI overheard what they're up to.\nMaybe it'll help us out.\pThey're looking to find DRAGONITE.\nThey say it can evolve, and when it\ldoes it violates copyright.\pWhat they don't know is that it\ncannot be found here.\pI think you should go find one\nyourself, and then evolve it.\lI bet that'll stop them.\pGood luck in your search.\nI believe in you!", MSGBOX_NPC)
	}
	end
}