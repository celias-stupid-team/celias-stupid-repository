script ThirtyEightIsland_HeadbuttMan {
	lock
	msgbox(
	"headbutt joke\n"
	"", MSGBOX_DEFAULT)
	closemessage
	specialvar(VAR_RESULT, GetPlayerFacingDirection)
	if(var(VAR_RESULT) == DIR_SOUTH || var(VAR_RESULT) == DIR_NORTH) {
		applymovement(LOCALID_PLAYER, moves(
			walk_right
			face_left
		))
	}
	applymovement(VAR_LAST_TALKED, moves(
		lock_facing_direction
		walk_slow_down
		delay_16 * 3
		walk_fast_up
		jump_2_up

	))
	waitmovement(VAR_LAST_TALKED)
	playse(SE_WALL_HIT)
    setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 3)
    setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 3)
    setvar(VAR_SHAKESCREEN_NUM_SHAKES, 6)
    setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
	special(ShakeScreen)
	applymovement(VAR_LAST_TALKED, moves(
		delay_16 * 4
		slide_down
		unlock_facing_direction
		delay_16 * 4
		walk_slow_down
		face_up
	))
	waitmovement(VAR_LAST_TALKED)
	release
	end

}


