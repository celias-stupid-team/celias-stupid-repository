script ThirtyEightIsland_Dad {
	lock
	faceplayer
	textcolor(0)
	msgbox(
	"DAD: {PLAYER}!\n"
	"What are you doing out here?\p"

	"I'm just out here grazing in\n"
	"the pasture.\l"
	"The grass here is delicious!\p"

	"But never mind that.\n"
	"How about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}


script ThirtyEightIsland_LassMaze {
	lock
	playbgm(MUS_ENCOUNTER_GIRL, FALSE)
	delay(60)
	getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
	special(SpawnCameraObject)
	applymovement(LOCALID_CAMERA, moves(
		walk_faster_right * 2
		walk_fastest_right * 50
	))
	waitmovement(0)
	switch(var(VAR_TEMP_0)) {
		case 10:
		applymovement(LOCALID_CAMERA, moves(
			walk_faster_right * 1
		))
		waitmovement(0)

		case 9:
		applymovement(LOCALID_CAMERA, moves(
			walk_faster_right * 2
		))
		waitmovement(0)

	}
	applymovement(LOCALID_CAMERA, moves(
		walk_fastest_right * 2
		walk_faster_right * 3
	))
	applymovement(LOCALID_OCEAN13_LASS, moves(
		walk_down * 5
		face_left
		lock_facing_direction
		delay_16 * 2
		walk_slow_right
		face_left
		delay_16 * 3
		walk_fast_left
	))
	waitmovement(LOCALID_OCEAN13_LASS)
	applymovement(LOCALID_OCEAN13_LASS, moves(
		walk_fast_left * 2
	))
	applymovement(LOCALID_CAMERA, moves(
		walk_fast_left * 2
	))
	waitmovement(LOCALID_OCEAN13_LASS)
	applymovement(LOCALID_OCEAN13_LASS, moves(
		jump_2_left
	))
	applymovement(LOCALID_CAMERA, moves(
		jump_2_left
	))
	waitmovement(LOCALID_OCEAN13_LASS)
	playse(SE_M_WATERFALL)
	playbgm(MUS_NONE, TRUE)
	removeobject(LOCALID_OCEAN13_LASS)
	delay(120)
	
	switch(var(VAR_TEMP_0)) {
		case 10:
		applymovement(LOCALID_CAMERA, moves(
			walk_faster_left * 1
		))
		waitmovement(0)

		case 9:
		applymovement(LOCALID_CAMERA, moves(
			walk_faster_left * 2
		))
		waitmovement(0)

	}
	applymovement(LOCALID_CAMERA, moves(
		walk_fastest_left * 53
	))
	delay(40)
	fadedefaultbgm
	waitmovement(LOCALID_CAMERA)
	special(RemoveCameraObject)
	setvar(VAR_CSR_OCEAN_LASS_MAZE, 1)
	release
	end


}


