script ThirtyEightIsland_Chuck {
    lock
    faceplayer
    msgbox(
	"I'm      {PAUSE 30}CHUCK    {PAUSE 20}!\n"
	"", MSGBOX_DEFAULT)
    	closemessage
	delay(30)
	specialvar(VAR_RESULT, GetPlayerFacingDirection)
	switch(var(VAR_RESULT)) {
		case DIR_NORTH:
			applymovement(LOCALID_PLAYER, moves(
				walk_right
				walk_up
				face_up

			))
		case DIR_WEST:
			applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
		case DIR_EAST:
			applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
		case DIR_SOUTH:
			applymovement(LOCALID_PLAYER, moves(
				walk_left
				walk_down
				face_up

			))
	}
	applymovement(VAR_LAST_TALKED, Common_Movement_FaceUp)
	waitmovement(LOCALID_PLAYER)
	delay(30)
	applymovement(LOCALID_PLAYER, WalkFastUp)
	applymovement(VAR_LAST_TALKED, WalkFastUp)
	waitmovement(0)
	playse(SE_FALL)
	applymovement(LOCALID_PLAYER, moves(
        slide_up * 17
    ))
	waitmovement(0)
    setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 3)
    setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 3)
    setvar(VAR_SHAKESCREEN_NUM_SHAKES, 6)
    setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
    special(ShakeScreen)
	delay(30)
	release
}

script ThirtyEightIsland_NationalParkGuy {
	msgbox(
	"This island is great, but I really\n"
	"miss being home in JOHTO.\p"

	"I'd visit the NATIONAL PARK just\n"
	"to relax on the BENCHES all day.\p"

	"Ah, if only I could take a\n"
	"RETREAT back there now…", MSGBOX_NPC)
}

script ThirtyEightIsland_DarnBarn {
	msgbox(
	"Wha-\n"
	"Hey!\p"

	"This darn barn's made a' yarn!\n"
	"", MSGBOX_SIGN)

}

script ThirtyEightIsland_HelpMiltank {
	msgbox(
	"Help milank\n"
	"placeholder", MSGBOX_NPC)
}

script ThirtyEightIsland_MommyMilkers {
    lock
    faceplayer
    textcolor(NPC_TEXT_COLOR_FEMALE)
    if(flag(FLAG_GOT_CREAM_DROP)) {
        msgbox(
        "The MOOMOO MILK…{PAUSE 30}\n"
        "Has all sold out.", MSGBOX_DEFAULT)
        }
        release
        end
	msgbox(
	"Hello… … …\n"
	"Would you like some MOOMOO MILK?", MSGBOX_YESNO)
    if(var(VAR_RESULT)) {
        msgbox(
        "We are unfortunately…\n"
        "{PAUSE 30}Out of MOOMOO MILK.\p"

        "Here…{PAUSE 30}\n"
        "Take this instead.", MSGBOX_DEFAULT)
        giveitem_msg("{PLAYER} got the mysterious\nCREAM DROP!", ITEM_CREAM_DROP)
        waitfanfare
        setflag(FLAG_GOT_CREAM_DROP)
    }
}

script ThirtyEightIsland_Miltank {

    if(flag(FLAG_HELPED_MILTANK)) {
        goto(ThirtyEightIsland_MiltankPhilosophy)

    } else {
        lock
        faceplayer
        playmoncry(SPECIES_MILTANK, CRY_MODE_FAINT)
        msgbox(
        "MILTANK: Moo...\n"
        "", MSGBOX_DEFAULT)
        waitmoncry

    }
    release
    end
}

script ThirtyEightIsland_MiltankPhilosophy {
    lock
    textcolor(NPC_TEXT_COLOR_RED)
    //Little girl walks right
    switch(var(VAR_TEMP_1)) {
        case 0:
            msgbox(
            "Hey, MILTANK!\p"

            "What's a word that rhymes with\n"
            "“Shoe?”", MSGBOX_DEFAULT)
            closemessage
            delay(60)
            textcolor(NPC_TEXT_COLOR_NEUTRAL)
            playmoncry(SPECIES_MILTANK, CRY_MODE_DEFAULT)
            msgbox(
            "MILTANK: Moo!\n"
            "", MSGBOX_DEFAULT)
        case 1:
            msgbox(
            "Hey, MITANK!\p"

            "What Greek symbol represents the\n"
            "mean in statistical analysis?", MSGBOX_DEFAULT)
            closemessage
            delay(60)
            textcolor(NPC_TEXT_COLOR_NEUTRAL)
            playmoncry(SPECIES_MILTANK, CRY_MODE_DEFAULT)
            msgbox(
            "MILTANK: Mu!\n"
            "", MSGBOX_DEFAULT)
        
        case 2:
            msgbox(
            "Hey, MILTANK!\p"

            "How do you say “Radish” in\n"
            "Korean?", MSGBOX_DEFAULT)
            closemessage
            delay(60)
            textcolor(NPC_TEXT_COLOR_NEUTRAL)
            playmoncry(SPECIES_MILTANK, CRY_MODE_DEFAULT)
            msgbox(
            "MILTANK: {MU}!\n"
            "", MSGBOX_DEFAULT)
        case 3:
            msgbox(
            "Hey, MITANK!\p"

            "What sound does a cow make?\n"
            "", MSGBOX_DEFAULT)
            closemessage
            delay(60)
            textcolor(NPC_TEXT_COLOR_NEUTRAL)
            playmoncry(SPECIES_MILTANK, CRY_MODE_DEFAULT)
            msgbox(
            "MILTANK: What the fuck is a cow?\n"
            "", MSGBOX_DEFAULT)
        
    }    
    waitmoncry
    addvar(VAR_TEMP_1, 1)
    if(var(VAR_TEMP_1) >= 4) {
        setvar(VAR_TEMP_1, 0)
    }
    release
}


script ThirtyEightIsland_GoldenRod {
    lock
    faceplayer
    msgbox(
	"gift\n"
	"", MSGBOX_DEFAULT)
    giveitem_msg("{PLAYER} obtained the\nGOLDEN ROD!", ITEM_GOOD_ROD)
    waitfanfare
    release
}

