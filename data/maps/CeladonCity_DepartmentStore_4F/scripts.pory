raw `


CeladonCity_DepartmentStore_4F_EventScript_Man::
	msgbox CeladonCity_DepartmentStore_4F_Text_GettingPokeDollAsPresent, MSGBOX_NPC
	end

CeladonCity_DepartmentStore_4F_EventScript_Youngster::
	msgbox CeladonCity_DepartmentStore_4F_Text_CanRunAwayWithPokeDoll, MSGBOX_NPC
	end

CeladonCity_DepartmentStore_4F_EventScript_FloorSign::
	msgbox CeladonCity_DepartmentStore_4F_Text_FloorSign, MSGBOX_SIGN
	end

CeladonCity_DepartmentStore_4F_EventScript_Clerk::
	goto_if_questlog EventScript_ReleaseEnd
	lock
	faceplayer
	message Text_MayIHelpYou
	waitmessage
	pokemart CeladonCity_DepartmentStore_4F_Items
	msgbox Text_PleaseComeAgain
	release
	end

	.align 2
CeladonCity_DepartmentStore_4F_Items::
	.2byte ITEM_POKE_DOLL
	.2byte ITEM_RETRO_MAIL
	.2byte ITEM_WATER_STONE
	.2byte ITEM_LEAF_STONE
	.2byte ITEM_SUN_STONE
	.2byte ITEM_DAWN_STONE
	.2byte ITEM_NONE
	release
	end
`
mapscripts CeladonCity_DepartmentStore_4F_MapScripts {
	MAP_SCRIPT_ON_TRANSITION: CeladonDeptStoneEmporium_OnTransition
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_TEMP_3, 1 {
			setvar(VAR_TEMP_3, 0)
			setflag(FLAG_SHINY_CREATION)
			setvar(VAR_CSR_GIFT_POKEMON, SPECIES_CLEFAIRY)
			playfanfare(MUS_LEVEL_UP)
			msgbox("{PLAYER} obtained a CLEFAIRY!\n", MSGBOX_DEFAULT)
			waitfanfare
			call(Common_Script_GiftPokemon)
			release
		}
	]
}
script CeladonDeptStoneEmporium_OnTransition {
	setflag(FLAG_CSR_MAP_STONE_EMPORIUM)
	call(SetPlayerPokedexValues)
}
script CeladonCity_DepartmentStore_4F_EventScript_GoldMom {
	msgbox("Hello, GOLD?\nYes, this is MOM.\pI got caught up in another\nshopping spree…\pI know I promised I wouldn't.\pWhat's that?\nYou're-\pSettle down! I promise that\nthis time I didn't buy that much!\p…Huh?\nWhat did I buy?\pUh, if you check your room,\nyou'll-\pOh, you see the DOLLSs there?\nI thought you'd like them-\p…What's that? How much did\nI spend?\pFunny thing about that, son…\n", MSGBOX_DEFAULT)
	closemessage
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox("It might be best to leave her\nalone.", MSGBOX_DEFAULT)
	release
}