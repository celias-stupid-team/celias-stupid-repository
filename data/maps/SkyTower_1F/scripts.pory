script SkyTower_Bill {
	lock
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	removeobject(VAR_LAST_TALKED)
	playfanfare(MUS_LEVEL_UP)
	msgbox(
	"{PLAYER} found a\n"
	"POKé DOLL!", MSGBOX_DEFAULT)
	waitfanfare
	closemessage
	delay(30)
	setvar(VAR_SKY_TOWER_POKE, 500)
	msgbox(
	"…Wait, no!\p"

	"{PLAYER} found\n"
	"5000 POKé{PAUSE 20} {ASTERISK}inside{ASTERISK}{PAUSE 10} a DOLL!", MSGBOX_DEFAULT)
	closemessage
	delay(20)
	playse(SE_PIN)
	applymovement(LOCALID_SKY_TOWER_CHATOT, moves(
		face_right
		emote_exclamation_mark
		delay_16 * 3
		walk_faster_right * 6
		face_up
	))
	waitmovement(0)
	delay(20)
	applymovement(LOCALID_PLAYER, moves(
		face_down
	))
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"CHATOT: Oho, I see you've found\n"
	"some POKé!\l"
	"That's the currency of the world.\p"

	"However because this is our GUILD,\n"
	"we claim 90% of all POKé earned!", MSGBOX_DEFAULT)
	closemessage
	playse(SE_M_PAY_DAY)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox(
	"CHATOT took 90% of your POKé,\n"
	"leaving you with only 500…", MSGBOX_DEFAULT)
	closemessage
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"CHATOT: Anyway, carry on!\n"
	"You've done excellent work!", MSGBOX_DEFAULT)
	closemessage
	applymovement(LOCALID_SKY_TOWER_CHATOT, moves(
		walk_faster_left * 6
		face_down
	))
	addobject(LOCALID_DEAD_BILL)
	clearflag(FLAG_TEMP_5)
	waitmovement(0)



	release
}

