script SkyTower_Dracula {
	lock
	faceplayer
	if(flag(FLAG_TEMP_1)) {
		msgbox(
		"Man… It seems that humans are\n"
		"the real monsters after all.", MSGBOX_DEFAULT)
	} else {
		msgbox(
		"One…{PAUSE 30}\n"
		"Two…\p"

		"Three!{PAUSE 30}\n"
		"Three chapters, ah ha ha!", MSGBOX_DEFAULT)
		closemessage
		applymovement(VAR_LAST_TALKED, moves(
			face_original_direction
		))
		waitmovement(0)
	}
	release
}
script SkyTower_Werewolf {
	lock
	faceplayer
	if(flag(FLAG_TEMP_1)) {
		msgbox(
		"Man… It seems that humans are\n"
		"the real monsters after all.", MSGBOX_DEFAULT)
	} else {
		msgbox(
		"WEREWOLF: Hiya!\n"
		"Welcome to the MONSTER HOUSE!\p"

		"Have you met my cousin SEBASTIAN?\n"
		"He's quite successful.", MSGBOX_DEFAULT)
	}
	release
}


