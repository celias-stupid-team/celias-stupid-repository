	release
}

script SkyTower_NotFrankenstein {
	lock
	if(flag(FLAG_TEMP_3)) {
		msgbox(
		"Hey, where's the wolf?\n"
		"", MSGBOX_DEFAULT)
		release
		end
	}
	switch(var(VAR_TEMP_1)) {
		case 0:
			msgbox(
			"That's not FRANKENSTEIN, silly!\n"
			"", MSGBOX_DEFAULT)

		case 1:
			msgbox(
			"It's not FRANKENSTEIN's {PAUSE 20}MONSTER\n"
			"either, you pedant.", MSGBOX_DEFAULT)
		case 2:
			msgbox(
			"Actually, I think it's WOLFBANE.\n"
			"", MSGBOX_DEFAULT)
			closemessage
			delay(45)
			playse(SE_M_EMBER)
			removeobject(LOCALID_WEREWOLF)
			delay(60)
			msgbox(
			"Oops.\n"
			"", MSGBOX_DEFAULT)

	}
	addvar(VAR_TEMP_1, 1)
	release
}

