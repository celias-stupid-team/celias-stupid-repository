script SkyTower_OranBerryGuy {
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_BLUE)
	//logic here
	if(!flag(FLAG_GOT_ORAN_BERRY)) {
		if(checkitem(ITEM_ORAN_BERRY)) {
			msgbox(
			"Uh, hi!\p"

			"I work at the KECLEON MARKET, and\n"
			"I was supposed to be handing out\l"
			"free ORAN BERRIES.\p"

			"However, it seems this is the last\n"
			"ORAN BERRY in the known universe.\p"

			"… … …Oh!!\n"
			"What's that?\p"

			"You have an ORAN BERRY!?\n"
			"That's unbelievable!\p"

			"I guess they still exist after all!\n"
			"", MSGBOX_DEFAULT)
			release
			end
		}
		msgbox(
		"Uh, hi!\p"

		"I work at the KECLEON MARKET, and\n"
		"I was supposed to be handing out\l"
		"free ORAN BERRIES.\p"

		"However, it seems this is the last\n"
		"ORAN BERRY in the known universe.\p"

		"Uh, I guess you can have it.\n"
		"", MSGBOX_DEFAULT)
		//give item
		giveitem_msg("{PLAYER} obtained the\nORAN BERRY.", ITEM_ORAN_BERRY)
		waitfanfare
		setflag(FLAG_GOT_ORAN_BERRY)
		//set flag
	} else {
		msgbox("Come visit us if you need, uh,\nnot ORAN BERRIES.", MSGBOX_DEFAULT)
	}
	release
	end
}

script SkyTower_FroslassScene {
	lock
	playbgm(MUS_ENCOUNTER_GIRL, TRUE)
	applymovement(LOCALID_SKY_TOWER_FROSLASS, moves(
		emote_exclamation_mark
		delay_16 * 4
		walk_down * 2
	))
	waitmovement(LOCALID_SKY_TOWER_FROSLASS)
	textcolor(NPC_TEXT_COLOR_RED)
	msgbox(
	"FROSLASS: Excuse me!\n"
	"Did you look at me?", MSGBOX_DEFAULT)
	playbgm(MUS_CSR_SKY_TOWER, TRUE)
	msgbox(
	"(battle)\n"
	"", MSGBOX_DEFAULT)
	msgbox(
	"after battle\n"
	"", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	applymovement(LOCALID_SKY_TOWER_FROSLASS, moves(
		walk_right * 8
	))
	waitmovement(LOCALID_SKY_TOWER_FROSLASS)
	setobjectxy(LOCALID_SKY_TOWER_FROSLASS, 46, 18)
	copyobjectxytoperm(LOCALID_SKY_TOWER_FROSLASS)
	setvar(VAR_SKY_TOWER_LASS, 1)
}

