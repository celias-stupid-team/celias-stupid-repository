script SkyTower_1FShop_Orb {
	lock
	msgbox(
	"MONEY ORB\n"
	"Price: 500 POKé", MSGBOX_DEFAULT)
	if(var(VAR_SKY_TOWER_POKE) >= 500) {
		removeobject(VAR_LAST_TALKED)
		msgbox(
		"You buy the MONEY ORB\p"

		"You use the MONEY ORB\p"

		"You get 501 POKé!\n"
		"", MSGBOX_DEFAULT)
		setvar(VAR_SKY_TOWER_POKE, 501)
	} elif(var(VAR_SKY_TOWER_POKE) < 500) {
		msgbox(
		"You take the MONEY ORB\p"

		"Kecleon fucking kills you\n"
		"", MSGBOX_DEFAULT)
		msgbox(
		"The money orb is now back\n"
		"", MSGBOX_DEFAULT)
	}
	release
}

script SkyTower_1FShop_Seed {
	lock
	msgbox(
	"JOY SEED\n"
