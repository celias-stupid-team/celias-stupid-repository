script SkyTower_Itemizer {
	lock
	
	setplayermetatile(METATILE_NavelRock_Itemizer, FALSE)
	call(EventScript_PlayerJumpInPlace)
	special(DrawWholeMapView)
	playse(SE_CLICK)
	waitse
	delay(30)
	if(!flag(FLAG_TEMP_C)) {
		playse(SE_M_SPIT_UP)
		removeobject(LOCALID_SKY_TOWER_TRAP_FINDER)
		addobject(LOCALID_SKY_TOWER_ITEMIZER_ITEM)
	} else {
		msgbox(
		"The ITEMIZER trap had no effect…\n"
		"", MSGBOX_DEFAULT)
	}
	release
}

script SkyTower_ItemizerItem {
	setflag(FLAG_TEMP_C)
	finditem(ITEM_NUGGET)
}


script SkyTower_PPTrap {
	lock
	
	setplayermetatile(METATILE_NavelRock_PPZero, FALSE)
	if(checkplayergender == MALE) {
		dogenderfluideffect
		call(EventScript_PlayerJumpInPlace)
		special(DrawWholeMapView)
		playse(SE_CLICK)
		waitse
		delay(45)
		msgbox(
		"The PP ZERO trap removed\n"
		"{PLAYER}'s PP!", MSGBOX_DEFAULT)
	} else {
		
		call(EventScript_PlayerJumpInPlace)
		special(DrawWholeMapView)
		playse(SE_CLICK)
		waitse
		delay(30)
		msgbox(
		"The PP ZERO trap had no effect…\n"
		"", MSGBOX_DEFAULT)
	}
	release
}

script SkyTower_TrapRoomMapper {
	textcolor(NPC_TEXT_COLOR_RED)
	msgbox(
	"Hey, watch it!\n"
	"Be careful where you step!\p"

	"This room's full of tricky and\n"
	"scary traps.\l"
	"Some are downright terrifying…\p"

	"Follow my footsteps, okay?\n"
	"I know for sure they're safe.", MSGBOX_NPC)
}




script SkyTower_1F_WarpTrap {
    lock
    playse(SE_CLICK)
    call(EventScript_PlayerJumpInPlace)
    setplayermetatile(METATILE_NavelRock_WarpTrap, FALSE)
    special(DrawWholeMapView)
    waitse
    delay(30)
    waitmovement(0)
    playse(SE_WARP_OUT)
    fadescreen(FADE_TO_WHITE)
    applymovement(LOCALID_PLAYER, moves(
        walk_fastest_left * 13
		walk_fastest_down * 6
        face_down
    ))
    waitmovement(0)
    waitse
    playse(SE_WARP_IN)
    fadescreen(FADE_FROM_WHITE)
    release
    end

}


script SkyTower_1F_HboxTrap {
    lock
    playse(SE_CLICK)
    call(EventScript_PlayerJumpInPlace)
    setplayermetatile(METATILE_NavelRock_HboxTrap, FALSE)
    special(DrawWholeMapView)
    waitse
    delay(30)
    waitmovement(0)
    playmoncry(SPECIES_JIGGLYPUFF, CRY_MODE_ENCOUNTER)
	waitmoncry
	setwildbattle(SPECIES_JIGGLYPUFF, 30)
	dowildbattle
    release
    end

}


script EventScript_PlayerJumpInPlace {
	specialvar(VAR_RESULT, GetPlayerFacingDirection)
	switch(var(VAR_RESULT)) {
		case DIR_NORTH:
			applymovement(LOCALID_PLAYER, moves(
				jump_in_place_up
			))
		case DIR_SOUTH:
			applymovement(LOCALID_PLAYER, moves(
				jump_in_place_down
			))
		case DIR_EAST:
			applymovement(LOCALID_PLAYER, moves(
				jump_in_place_right
			))
		case DIR_WEST:
			applymovement(LOCALID_PLAYER, moves(
				jump_in_place_left
			))

	}
	return
}


script SkyTower_Wigglytuff {
	lock
	waitse
	textcolor(NPC_TEXT_COLOR_BLUE)
	playse(SE_LEDGE)
	applymovement(VAR_LAST_TALKED, moves(
		jump_in_place_down
	))
	waitmovement(0)
	waitse
	playse(SE_LEDGE)
	applymovement(VAR_LAST_TALKED, moves(
		jump_in_place_down
	))
	waitmovement(0)
	waitse
	faceplayer
	if(flag(FLAG_GOT_FRIEND_AREA)) {
		msgbox(
		"WIGGLYTUFF: Hi, new friend!\p"

		"Keep up the good work!\n"
		"", MSGBOX_DEFAULT)
		release
		end
	}
	msgbox(
	"Hiya!\n"
	"I'm WIGGLYTUFF, and I love friends.\p"

	"In fact, I can even show you how\n"
	"to make new friends!\l"
	"Yoom… {PAUSE 20}TAH!", MSGBOX_DEFAULT)
	fadescreeninstant(FADE_TO_WHITE)
	closemessage
	fadescreenswapbuffers(FADE_FROM_WHITE)
	playfanfare(MUS_LEVEL_UP)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox(
	"You've unlocked a FRIEND AREA!\n"
	"", MSGBOX_DEFAULT)
	waitfanfare
	textcolor(NPC_TEXT_COLOR_BLUE)
	closemessage
	playse(SE_LEDGE)
	applymovement(VAR_LAST_TALKED, moves(
		jump_in_place_down
	))
	waitmovement(0)
	faceplayer
	setflag(FLAG_GOT_FRIEND_AREA)
	msgbox(
	"WIGGLYTUFF: Hooray!\n"
	"Now you can make new friends!\p"

	"When you find a new friend, they'll\n"
	"wait for you in the FRIEND AREA.\l"
	"How fun!", MSGBOX_DEFAULT)
	release
}

script SkyTower_Chatot {
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"CHATOT: Yes, hello.\n"
	"I'm the GUILDMASTER's assistant.\p"

	"Carry on, then!\n"
	"We have important work to do!", MSGBOX_DEFAULT)
	release
	end
}