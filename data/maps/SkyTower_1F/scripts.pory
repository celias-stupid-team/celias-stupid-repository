script SkyTower_1FShop_Orb {
	lock
	applymovement(VAR_LAST_TALKED, moves(
			set_invisible
	))
	waitse
	playse(SE_LEDGE)
	applymovement(LOCALID_SKY_TOWER_1F_KECLEON, moves(
		jump_in_place_down
	))
	waitmovement(0)
	waitse
	delay(20)
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"That's a MONEY ORB.\n"
	"It costs 500 POKé.\l"
	"Is that acceptable to you?", MSGBOX_YESNO) 
	if(!var(VAR_RESULT)) {
		playse(SE_BALL_CLICK)
		applymovement(VAR_LAST_TALKED, moves(
			set_visible
		))
		waitmovement(0)
		release
		end
	}
	if(var(VAR_SKY_TOWER_POKE) >= 500) {
		removeobject(VAR_LAST_TALKED)
		playse(SE_SHOP)
		waitse
		msgbox(
		"Thank you for your patronage!\n"
		"", MSGBOX_DEFAULT)
		closemessage
		delay(30)
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		msgbox(
		"{PLAYER} used the\n"
		"MONEY ORB…", MSGBOX_DEFAULT)
		playfanfare(MUS_LEVEL_UP)
		msgbox(
		"{PLAYER} got 5000 POKé!\n"
		"Nice!", MSGBOX_DEFAULT)

		setvar(VAR_SKY_TOWER_POKE, 501)
		release
		end
	} elif(var(VAR_SKY_TOWER_POKE) < 500) {
		msgbox(
		"…Wait a minute!\n"
		"You don't have enough POKé!\p"

		"Stop!!\n"
		"Thief!!!", MSGBOX_DEFAULT)
		fadescreeninstant(FADE_TO_WHITE)
		playse(SE_M_EXPLOSION)
		waitse
		msgbox(
		"{PLAYER} fucking died!\n"
		"", MSGBOX_DEFAULT)
		applymovement(VAR_LAST_TALKED, moves(
			set_visible
		))
		waitmovement(0)
		fadescreenswapbuffers(FADE_FROM_WHITE)

	}
	release
}

script SkyTower_1FShop_Seed {
	lock
	applymovement(VAR_LAST_TALKED, moves(
			set_invisible
	))
	waitse
	playse(SE_LEDGE)
	applymovement(LOCALID_SKY_TOWER_1F_KECLEON, moves(
		jump_in_place_down
	))
	waitmovement(0)
	waitse
	delay(20)
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"That's a JOY SEED.\n"
	"It costs 5000 POKé.\l"
	"Is that acceptable to you?", MSGBOX_YESNO) 
	if(!var(VAR_RESULT)) {
		playse(SE_BALL_CLICK)
		applymovement(VAR_LAST_TALKED, moves(
			set_visible
		))
