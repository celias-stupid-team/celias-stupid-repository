script SkyTower_Bill {
	lock
	removeobject(VAR_LAST_TALKED)
	playfanfare(MUS_LEVEL_UP)
	msgbox(
	"{PLAYER} found a\n"
	"POKé DOLL!", MSGBOX_DEFAULT)
	waitfanfare
	closemessage
	delay(30)
	setvar(VAR_SKY_TOWER_POKE, 500)
	msgbox(
	"…Wait, no!\p"

	"{PLAYER} found\n"
	"500 POKé{PAUSE 20} {ASTERISK}inside a DOLL!{ASTERISK}", MSGBOX_DEFAULT)
	release
}