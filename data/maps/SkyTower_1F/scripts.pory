script SkyTower_Trap1 {
	lock
	
	setplayermetatile(METATILE_NavelRock_ExplosionTrap, FALSE)
	call(EventScript_PlayerJumpInPlace)
	special(DrawWholeMapView)
	playse(SE_CLICK)
	waitse
	delay(30)
	waitmovement(0)
	playse(SE_M_EXPLOSION)
	fadescreeninstant(FADE_TO_WHITE)

	setmetatile(20, 19, METATILE_NavelRock_Floor, FALSE)
	setmetatile(21, 19, METATILE_NavelRock_Floor, FALSE)
	setmetatile(22, 19, METATILE_NavelRock_Floor, FALSE)
	setmetatile(23, 19, METATILE_NavelRock_Floor, FALSE)
	setmetatile(24, 19, METATILE_NavelRock_Floor, FALSE)

	
	setmetatile(20, 20, METATILE_NavelRock_Floor, FALSE)
	setmetatile(21, 20, METATILE_NavelRock_Floor, FALSE)
	setmetatile(22, 20, METATILE_NavelRock_Floor, FALSE)
	setmetatile(23, 20, METATILE_NavelRock_Floor, FALSE)
	setmetatile(24, 20, METATILE_NavelRock_Floor, FALSE)

	setmetatile(20, 21, METATILE_NavelRock_Floor, FALSE)
	setmetatile(21, 21, METATILE_NavelRock_Floor, FALSE)
