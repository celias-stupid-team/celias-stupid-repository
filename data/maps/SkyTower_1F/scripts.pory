script SkyTower_ChuckTrap {
	lock
	
	setplayermetatile(METATILE_NavelRock_ChucksterTrap, FALSE)
	call(EventScript_PlayerJumpInPlace)
	special(DrawWholeMapView)
	playse(SE_CLICK)
	waitse
	delay(30)
	waitmovement(0)
	playse(SE_FALL)
	applymovement(LOCALID_PLAYER, moves(
		face_up
		lock_facing_direction
		walk_faster_down * 4
	))
	waitmovement(0)
	playse(SE_LEDGE)
	applymovement(LOCALID_PLAYER, moves(
		jump_up
	))
	waitmovement(0)
	goto(SkyTower_BombTrap1)
}




