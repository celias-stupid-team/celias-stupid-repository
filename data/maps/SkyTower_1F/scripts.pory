		playse(SE_SHOP)
		waitse
		msgbox(
		"Thank you for your patronage!\n"
		"", MSGBOX_DEFAULT)
		closemessage
		delay(30)
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		playfanfare(MUS_LEVEL_UP)
		msgbox(
		"{PLAYER} got the JOY SEED!\n"
		"", MSGBOX_DEFAULT)
		waitfanfare
		msgbox(
		"{PLAYER} put the JOY SEED into\n"
		"the SEED POUCH.", MSGBOX_DEFAULT)
		setvar(VAR_SKY_TOWER_POKE, 0)
		release
		end
	} elif(var(VAR_SKY_TOWER_POKE) < 501) {
		msgbox(
		"…Wait a minute!\n"
		"You don't have enough POKé!\p"

		"Stop!!\n"
		"Thief!!!", MSGBOX_DEFAULT)
		fadescreeninstant(FADE_TO_WHITE)
		playse(SE_M_EXPLOSION)
		waitse
		msgbox(
		"{PLAYER} fucking died!\n"
		"", MSGBOX_DEFAULT)
		applymovement(VAR_LAST_TALKED, moves(
			set_visible
		))
		waitmovement(0)
		fadescreenswapbuffers(FADE_FROM_WHITE)

	}
	release
}



script SkyTower_DadStatue {
	lock
	
	msgbox(
	"A fatherly statue stands in the\n"
	"room.\p"

	"Approaching it, you feel overcome\n"
	"by a restful presence.", MSGBOX_DEFAULT)
	
	fadescreenswapbuffers(FADE_TO_BLACK)
	closemessage
	playfanfare(MUS_HEAL)
	waitfanfare
	special(HealPlayerParty)
	fadescreenswapbuffers(FADE_FROM_BLACK)
	
	release
	end
}


script SkyTower_OranBerryGuy {
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_BLUE)
	//logic here
	if(!flag(FLAG_GOT_ORAN_BERRY)) {
		if(checkitem(ITEM_ORAN_BERRY)) {
			msgbox(
			"Uh, hi!\p"

			"I work at the KECLEON MARKET, and\n"
			"I was supposed to be handing out\l"
			"free ORAN BERRIES.\p"

			"However, it seems this is the last\n"
			"ORAN BERRY in the known universe.\p"

			"… … …Oh!!\n"
			"What's that?\p"

			"You have an ORAN BERRY!?\n"
			"That's unbelievable!\p"

			"I guess they still exist after all!\n"
			"", MSGBOX_DEFAULT)
			release
			end
		}
		msgbox(
		"Uh, hi!\p"

		"I work at the KECLEON MARKET, and\n"
		"I was supposed to be handing out\l"
		"free ORAN BERRIES.\p"

		"However, it seems this is the last\n"
		"ORAN BERRY in the known universe.\p"

		"Uh, I guess you can have it.\n"
		"", MSGBOX_DEFAULT)
		//give item
		giveitem_msg("{PLAYER} obtained the\nORAN BERRY.", ITEM_ORAN_BERRY)
		waitfanfare
		setflag(FLAG_GOT_ORAN_BERRY)
		//set flag
	} else {
		msgbox("Come visit us if you need, uh,\nnot ORAN BERRIES.", MSGBOX_DEFAULT)
	}
	release
	end
}

script SkyTower_FroslassScene {
	lock
	playbgm(MUS_ENCOUNTER_GIRL, TRUE)
	applymovement(LOCALID_SKY_TOWER_FROSLASS, moves(
		emote_exclamation_mark
		delay_16 * 4
		walk_down * 2
		delay_16
	))
	waitmovement(LOCALID_SKY_TOWER_FROSLASS)
	textcolor(NPC_TEXT_COLOR_RED)
	msgbox(
	"FROSLASS: Excuse me!\n"
	"Did you look at me?", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	fadedefaultbgm
	
	msgbox(
	"… … … …\n"
	"Well, whatever.\p"

	"This is why I like to live in\n"
	"the mountaintops.", MSGBOX_DEFAULT)
	
	closemessage
	delay(45)
	applymovement(LOCALID_SKY_TOWER_FROSLASS, moves(
		walk_left
		walk_down * 7
	))
	waitmovement(LOCALID_SKY_TOWER_FROSLASS)
	
	copyobjectxytoperm(LOCALID_SKY_TOWER_FROSLASS)
	setvar(VAR_SKY_TOWER_LASS, 1)
}

