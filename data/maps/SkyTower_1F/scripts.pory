mapscripts SkyTower_1F_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		if(!flag(FLAG_SKY_TOWER_GYARADOS_EVOLVED)) {
			setflag(FLAG_TEMP_3)

		}
		if(!flag(FLAG_SKY_TOWER_BILL)) {
			setflag(FLAG_TEMP_5)
		}
		setflag(FLAG_TEMP_A)
	}
}

