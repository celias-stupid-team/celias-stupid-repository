	msgbox(
	"MONSTER HOUSE\n"
	"", MSGBOX_SIGN)

}


script SkyTower_MonsterHousePlaceholder {
	msgbox(
	"There's like frankenstein and shit\n"
	"", MSGBOX_SIGN)

