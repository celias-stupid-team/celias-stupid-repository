raw `
FushciaCity_PokemonCenter_1F_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, FushciaCity_PokemonCenter_1F_OnTransition
	map_script MAP_SCRIPT_ON_RESUME, CableClub_OnResume
	.byte 0

FushciaCity_PokemonCenter_1F_OnTransition::
	setrespawn HEAL_LOCATION_FUSHCIA_CITY
	end

FushciaCity_PokemonCenter_1F_EventScript_Nurse::
	lock
	faceplayer
	call EventScript_PkmnCenterNurse
	release
	end

FushciaCity_PokemonCenter_1F_EventScript_Man::
	msgbox FushciaCity_PokemonCenter_1F_Text_CantBecomeGoodTrainerWithOneMon, MSGBOX_NPC
	end

FushciaCity_PokemonCenter_1F_EventScript_CooltrainerF::
	msgbox FushciaCity_PokemonCenter_1F_Text_PokemonLeagueWestOfViridian, MSGBOX_NPC
	end

FushciaCity_PokemonCenter_1F_EventScript_Youngster::
	msgbox FushciaCity_PokemonCenter_1F_Text_VisitSafariZoneForPokedex, MSGBOX_NPC
	end
`

script FushciaCity_GetOakPC {
	msgbox("D'ya ever find yourself completely\nstuck with no clue what to do?\lI do sometimes.\pWhenever I'm completely stumped, I\ncheck OAK's PC.\lThere's no shame in getting help.", MSGBOX_NPC)
	end
}


script FushciaCity_GetThroughGym {
	msgbox("Hey, TRAINER!\nYou been using your RUMOR LOG?\pIf I'm not sure what to do, I'll\npull it up first thing.\lHelps me keep track of everything.\pOnce you've figured a RUMOR out, a\ncheck will appear to mark it off.\pUse that feature to be sure you're\nnot missing anything!", MSGBOX_NPC)
}

