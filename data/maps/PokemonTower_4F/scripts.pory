`
mapscripts PokemonTower_4F_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		if(!flag(FLAG_CSR_POKEMON_TOWER_MUSIC)) {
			playbgm(MUS_NONE, TRUE)
		} 
	}
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_TEMP_5, 0 { //Correct
			switch(var(VAR_POKEMONTOWER_ANSWER)) {
				case 0:
					break
				case 1:
					playse(SE_SUCCESS)
					waitse
					setvar(VAR_POKEMONTOWER_ANSWER, 0)
					
				case 2:
					playse(SE_BOO)
					waitse
					setvar(VAR_POKEMONTOWER_ANSWER, 0)
					
			}
			
			setvar(VAR_TEMP_5, 1)
			release
			end
		}

	]
}

script PokemonTower_CorrectAnswer {
	setvar(VAR_POKEMONTOWER_ANSWER, 1)
	release
}

script PokemonTower_IncorrectAnswer {
	setvar(VAR_POKEMONTOWER_ANSWER, 2)
	release
}

script PokemonTower_NeutralAnswer {
	setvar(VAR_POKEMONTOWER_ANSWER, 0)
	release
}

script PokemonTower_MathQuestion_One {
	lock
	msgbox("Three plus Five plus Seven equals?\n{LEFT_ARROW} 2    {UP_ARROW} 16    {RIGHT_ARROW}15", MSGBOX_DEFAULT)
	if(!flag(FLAG_CSR_POKEMON_TOWER_MUSIC)) {
		playbgm(MUS_GYM, TRUE)
	}
	setflag(FLAG_CSR_POKEMON_TOWER_MUSIC)
	closemessage
	release
}