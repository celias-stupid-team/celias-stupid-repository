raw `




SafariZone_Center_EventScript_RestHouseSign::
	msgbox SafariZone_Center_Text_RestHouse, MSGBOX_SIGN
	end

SafariZone_Center_EventScript_TrainerTips::
	msgbox SafariZone_Center_Text_PressStartToCheckTime, MSGBOX_SIGN
	end

SafariZone_Center_EventScript_AreaSign::
	msgbox SafariZone_Center_Text_CenterArea, MSGBOX_SIGN
	end
`
const DMCA_Lead = 4
const DMCA_Left = 2
const DMCA_Right = 3

mapscripts SafariZone_Center_MapScripts {
	MAP_SCRIPT_ON_LOAD {

		if(flag(FLAG_FREED_KANGA)) {
			call(SafariZone_Center_BreakLeftWall)
			call(SafariZone_Center_BreakMiddleWall)
		}
		if(flag(FLAG_BROKE_BABY_KANGA_WALL)) {
			call(SafariZone_Center_BreakRightWall)
		}
	}
	MAP_SCRIPT_ON_TRANSITION {
		setworldmapflag(FLAG_WORLD_MAP_SAFARI_ZONE_CENTER)
		if(flag(FLAG_NO_TM_CASE) || flag(FLAG_HIDE_DMCA_IN_SAFARI_ZONE)) {
			setflag(FLAG_TEMP_3)
		}
		
		if(!flag(FLAG_BATTLED_IRON_CLEFTS)) {
			setflag(FLAG_TEMP_4)
		}
		if(!flag(FLAG_HIDE_DMCA_IN_SAFARI_ZONE)) {
			setflag(FLAG_TEMP_5)
		}
	}
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_CSR_DMCA_SAFARI_ZONE_MAP_SCENE, 0 {
			setvar(VAR_GLITCH_CITY_STATUS, 0)
			applymovement(LOCALID_PLAYER, Common_Movement_WalkUp)
			waitmovement(0)
			setflag(FLAG_TEMP_2)
			setvar(VAR_CSR_DMCA_SAFARI_ZONE_MAP_SCENE, 1)
			goto(SafariZone_Center_DMCA_Take_Case)
		}
		VAR_CSR_DMCA_SAFARI_ZONE_MAP_SCENE, 2 {
			setvar(VAR_GLITCH_CITY_STATUS, 0)
			applymovement(LOCALID_PLAYER, Common_Movement_WalkUp)
			waitmovement(0)
			setvar(VAR_CSR_DMCA_SAFARI_ZONE_MAP_SCENE, 1)
			applymovement(DMCA_Lead, DMCA_Lead_Down)
			waitmovement(0)
			textcolor(NPC_TEXT_COLOR_MALE)
			delay(20)
			msgbox("Hey!\nHow'd you get your TM CASE back?\pGrr…\nGive it here!", MSGBOX_DEFAULT)
			closemessage
			delay(30)
			fadescreen(FADE_TO_BLACK)
			removeobject(DMCA_Lead)
			removeobject(DMCA_Right)
			removeobject(DMCA_Left)
			setflag(FLAG_TEMP_2)
			removeitem(ITEM_TM_CASE)
			setflag(FLAG_NO_TM_CASE)
			fadescreen(FADE_FROM_BLACK)
			release
			end
		}
	]
}

script SafariZone_Center_ResetGlitchCity {
	setvar(VAR_GLITCH_CITY_STATUS, 0)
	release
}

movement DMCA_Lead_Down {
	walk_down
	face_down
}

script SafariZone_BrickBreakTM {
	lock
	if(!flag(FLAG_NO_TM_CASE)) {
		setflag(FLAG_HIDE_SAFARI_ZONE_CENTER_TM32)
		call(SetPlayerPokedexValues)
		finditem(ITEM_TM32)
	} else {
		msgbox("{PLAYER} found a TM32!\nIt contains BRICK BREAK.", MSGBOX_DEFAULT)
		msgbox("Too bad!\nThere's no TM CASE…", MSGBOX_DEFAULT)
		release
	}
}

script SafariZone_KangaskhanSign {
	lock
	if(flag(FLAG_FREED_KANGA)) {
		showmonpic(SPECIES_CHANSEYBLANK, 10, 3)
		msgbox("Name: KANGASKHAN\pOurs ran away.\n", MSGBOX_DEFAULT)
		hidemonpic
	} else {
		showmonpic(SPECIES_KANGASKHAN, 10, 3)
		msgbox("Name: KANGASKHAN\n", MSGBOX_DEFAULT)
		hidemonpic
	}
	release
	end
}

const BIG_KANGA = 7
const SMALL_KANGA = 6
script SafariZone_KangaskahnCage {
	lock
	applymovement(BIG_KANGA, Common_Movement_FaceDown)
	if(flag(FLAG_FREED_KANGA)) {
		msgbox("The BRICKS have been BREAKED.\n", MSGBOX_DEFAULT)
		release
		end
	}
	playmoncry(SPECIES_KANGASKHAN, CRY_MODE_FAINT)
	msgbox("KANGASKHAN: Kang! Kanga-!!\n", MSGBOX_DEFAULT)
	closemessage
	delay(20)
	if(checkitem(ITEM_TM_CASE)) {
		msgbox("She's staring intently at your\nTM CASE.\pWould you like to give her a\nTM?", MSGBOX_YESNO)
		if(var(VAR_RESULT)) {
			if(var(VAR_RESULT)) {
				setflag(FLAG_FREED_KANGA)
				removeitem(ITEM_TM32)
				playfanfare(MUS_LEVEL_UP)
				msgbox("{PLAYER} gave the TM32 to the\nimprisoned KANGASKHAN!", MSGBOX_DEFAULT)
				waitfanfare
				closemessage
				applymovement(BIG_KANGA, SafariZone_KangaskahnWalkInPlace)
				waitmovement(0)
				playse(SE_PC_LOGIN)
				msgbox("KANGASKHAN booted up the TM!\pIt contained BRICK BREAK!\n", MSGBOX_DEFAULT)
				closemessage
				fadenewbgm(MUS_NONE)
				delay(30)
				applymovement(BIG_KANGA, Common_Movement_FaceRight)
				delay(60)
				playmoncry(SPECIES_KANGASKHAN, CRY_MODE_DEFAULT)
				waitmoncry
				delay(20)
				applymovement(BIG_KANGA, SafariZone_KangaAttackWall1)
				waitmovement(0)
				playse(SE_M_HORN_ATTACK)
				applymovement(BIG_KANGA, SafariZone_KangaAttackWall2)
				waitmovement(0)
				playse(SE_M_HORN_ATTACK)
				applymovement(BIG_KANGA, SafariZone_KangaAttackWall2)
				waitmovement(0)
				playse(SE_M_EXPLOSION)
				fadescreen(FADE_TO_WHITE)
				call(SafariZone_Center_BreakMiddleWall)
				special(DrawWholeMapView)
				playbgm(MUS_SEVII_ROUTE, TRUE)
				fadescreen(FADE_FROM_WHITE)
				delay(60)
				applymovement(SMALL_KANGA, Common_Movement_FaceLeft)
				waitmovement(0)
				playse(SE_PIN)
				applymovement(SMALL_KANGA, Common_Movement_ExclamationMark)
				delay(60)
				msgbox("KANGASKHAN: Gah!\nKan-Gah!!", MSGBOX_DEFAULT)
				closemessage
				applymovement(SMALL_KANGA, Common_Movement_WalkLeft)
				waitmovement(0)
				playse(SE_LEDGE)
				applymovement(SMALL_KANGA, SafariZone_BabyJumpLeft)
				waitmovement(0)
				delay(60)
				applymovement(BIG_KANGA, SafariZone_KangaWalksOverToYou)
				waitmovement(0)
				playse(SE_M_EXPLOSION)
				fadescreen(FADE_TO_WHITE)
				call(SafariZone_Center_BreakLeftWall)
				special(DrawWholeMapView)
				fadescreen(FADE_FROM_WHITE)
				delay(60)
				playmoncry(SPECIES_KANGASKHAN, CRY_MODE_DEFAULT)
				waitmoncry
				msgbox("The KANGASKHAN breathes a sigh of\nrelief.", MSGBOX_DEFAULT)
				closemessage
				applymovement(BIG_KANGA, Common_Movement_WalkDown)
				waitmovement(0)
				msgbox("…Oh?\nWhat's this?\pKANGASKHAN would like to join you\non your adventure!", MSGBOX_DEFAULT)
				playfanfare(MUS_LEVEL_UP)
				setvar(VAR_CSR_GIFT_POKEMON, SPECIES_KANGASKHAN)
				removeobject(BIG_KANGA)
				removeobject(SMALL_KANGA)
				setflag(FLAG_FREED_KANGA)
				msgbox("{PLAYER} obtained the grateful\nKANGASKHAN!", MSGBOX_DEFAULT)
				call(Common_Script_GiftPokemon)
				fadedefaultbgm
				release
			}
		} else {
			closemessage
			playmoncry(SPECIES_KANGASKHAN, CRY_MODE_FAINT)
			msgbox("KANGASKHAN: Gah! Kan-gah!\n", MSGBOX_DEFAULT)
			waitmoncry
			closemessage
			delay(20)
			msgbox("The POKéMON looks thoroughly\nforlorn.", MSGBOX_DEFAULT)
		} 
	} else {
		
		msgbox("She's separated from her child…\n", MSGBOX_DEFAULT)
	}
	release
}

script SafariZoneCenter_WorriedWoman {
	lock
	faceplayer
	if(flag(FLAG_FREED_KANGA)) {
		msgbox("KANGASKHAN!\nShe's finally free!\pThank goodness.\nIt hurt my heart seeing her stuck.", MSGBOX_DEFAULT)
	} else {
		msgbox("The DMCA have been chased out,\nbut KANGASKHAN is still trapped…\pIt's all right, though.\nShe's a fierce one.\lI bet she's planning an escape.\pMaybe we can give her something\nto help out!", MSGBOX_DEFAULT)
	}
	applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
}

movement SafariZone_BabyJumpLeft {
	jump_2_left
	set_invisible
}

movement SafariZone_KangaskahnWalkInPlace {
	walk_in_place_down * 2
	face_down
}

movement SafariZone_KangaAttackWall1 {
	walk_fast_right
	face_right
}


movement SafariZone_KangaAttackWall2 {
	lock_facing_direction
	walk_slow_left
	face_right
	delay_16 * 2
	walk_fast_right
	face_right
	unlock_facing_direction
}

movement SafariZone_KangaWalksOverToYou {
	walk_left
	face_down
	delay_16 * 2
	walk_fast_down
	face_down
}

script SafariZone_Center_BreakLeftWall {
	setmetatile(11, 12, 0x0D8, FALSE)
	setmetatile(12, 12, 0x0D9, FALSE)
	setmetatile(13, 12, 0x0D9, FALSE)
	setmetatile(11, 13, 0x0E0, FALSE)
	setmetatile(12, 13, 0x0E1, FALSE)
	setmetatile(13, 13, 0x0E1, FALSE)
	return
}

script SafariZone_Center_BreakMiddleWall {
	setmetatile(14, 10, 0x294, TRUE)
	setmetatile(14, 11, 0x0D1, FALSE)
	setmetatile(14, 12, 0x0D9, FALSE)
	return

}

script SafariZone_Center_BreakRightWall {
	setmetatile(15, 12, 0x0D9, FALSE)
	setmetatile(16, 12, 0x0D9, FALSE)
	setmetatile(17, 12, 0x0DA, FALSE)
	setmetatile(15, 13, 0x0E1, FALSE)
	setmetatile(16, 13, 0x0E1, FALSE)
	setmetatile(17, 13, 0x0E2, FALSE)
	return

}


script SafariZone_KangaJailDMCA {
	msgbox("This POKéMON was holding an\nillegal copy of itself.\pI've put into custody until I can\nfigure out which came first.", MSGBOX_NPC)
	end
}

script SafariZone_KangaBabyCage {
	lock
	if(flag(FLAG_BROKE_BABY_KANGA_WALL)) {
		msgbox("The BRICKS have been BREAKED.\n", MSGBOX_DEFAULT)
		release
		end

	}
	if(flag(FLAG_FREED_KANGA)) {
		call(Common_Script_BrickBreak)
			if(var(VAR_RESULT) == 1) {
		
				setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 1)
				setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 1)
				setvar(VAR_SHAKESCREEN_NUM_SHAKES, 1)
				setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 1)
				call(SafariZone_Center_BreakRightWall)
				special(DrawWholeMapView)
				special(ShakeScreen)
				setflag(FLAG_BROKE_BABY_KANGA_WALL)
				delay(60)
				giveitem_msg("{PLAYER} found a BRICK PIECE!\n", ITEM_BRICK_PIECE, 1)
				release
				end
	}
	release
	}
	playmoncry(SPECIES_CUBONE, CRY_MODE_FAINT)
	msgbox("BABY: Ka-kanga?\n", MSGBOX_DEFAULT)
	waitmoncry
	
	release
}


script SafariZone_Center_DMCA_Take_Case {
	lock
	textcolor(NPC_TEXT_COLOR_MALE)
	playse(SE_PIN)
	applymovement(DMCA_Lead, Common_Movement_ExclamationMark)
	waitmovement(0)
	delay(45)
	msgbox("Hold it!", MSGBOX_DEFAULT)
	closemessage
	delay(10)
	applymovement(DMCA_Lead, Common_Movement_WalkDown)
	waitmovement(0)
	applymovement(DMCA_Lead, Common_Movement_FaceDown)
	waitmovement(0)
	msgbox("This area's under DMCA control!\nNo copyrighted content allowed.\lGet 'em!", MSGBOX_DEFAULT)
	closemessage
	applymovement(DMCA_Left, DMCALeft) //Henchmen rough you up
	applymovement(DMCA_Right, DMCARight)
	waitmovement(0)
	delay(8)
	playse(SE_M_DOUBLE_SLAP)
	applymovement(LOCALID_PLAYER, PlayerRoughedUp)
	waitse
	playse(SE_M_DOUBLE_SLAP)
	waitse
	playse(SE_M_DOUBLE_SLAP)
	waitse
	playse(SE_M_DOUBLE_SLAP)
	waitmovement(0)
	setvar(VAR_TEMP_0, 1)
	playse(SE_PIN)
	applymovement(DMCA_Right, Common_Movement_ExclamationMark)
	delay(60)
	applymovement(DMCA_Right, Common_Movement_FaceUp)
	waitmovement(0)
	msgbox("Hey BOSS!\nCheck out what I found!", MSGBOX_DEFAULT)
	closemessage
	applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
	applymovement(DMCA_Lead, Common_Movement_WalkRight)
	waitmovement(0)
	applymovement(DMCA_Lead, Common_Movement_FaceDown)
	msgbox("What's this?\nA TM CASE?\pHa!\nNo way we'll let that slide.\lIt's ours now!", MSGBOX_DEFAULT)
	closemessage
	delay(20)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox("{PLAYER}'s TM CASE was taken…\n", MSGBOX_DEFAULT)
	closemessage
	applymovement(DMCA_Lead, DMCA_Lead_GoesUp)
	waitmovement(0)
	textcolor(NPC_TEXT_COLOR_MALE)
	msgbox("Come on, gang!\nLet's bring this up.", MSGBOX_DEFAULT)
	closemessage
	applymovement(DMCA_Lead, DMCA_Lead_Leaves)
	applymovement(DMCA_Right, DMCA_GoonsLeave)
	applymovement(DMCA_Left, DMCA_GoonsLeave)
	waitmovement(0)
	removeitem(ITEM_TM_CASE)
	removeobject(DMCA_Lead)
	removeobject(DMCA_Right)
	removeobject(DMCA_Left)
	setflag(FLAG_NO_TM_CASE)
	release
}

movement DMCA_Lead_GoesUp {
	walk_up
	face_down
}

movement DMCA_Lead_Leaves {
	walk_right * 9
}

movement DMCA_GoonsLeave {
	walk_up * 2
	walk_right * 9
}

movement DMCALeft { 
	walk_fast_down * 3
	walk_fast_right
	face_right
}

movement DMCARight {
	walk_fast_down * 3
	walk_fast_left
	face_left
}

movement PlayerRoughedUp {
	face_left
	delay_16
	face_right
	delay_16
	face_left
	delay_16
	face_right
	delay_16
	face_left
	delay_16
}

movement DMCA_Sides_Return {
	walk_up * 3
	face_up
}
movement DMCA_Lead_Returns {
	face_up
	delay_16 * 2
	walk_right * 5
	walk_up * 2
}

script SafariZone_LaprasMeatSalesman {
	lock
	faceplayer
	if(flag(FLAG_SANDWICH_GOT_MEAT)) {
		msgbox("Those DMCA guys have been a real\nboon to my hustle here.\pThere used to be some kinda\n“Conservation effort” stopping me\lfrom doing my honest work.\pBah, to heck with that.\nI'm here to make a living!", MSGBOX_DEFAULT)
		applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
		waitmovement(0)
		release
		end
	}
	showmoneybox(0, 0)
	msgbox("Why hello there, young adventurer!\nHow're you doing this fine day?\pI'm but a humble salesman of the\nfreshest meats in KANTO.\lEthically sourced, of course!\pRight now, my exotic tastes go\nfor a mere ¥500!\lHow's about it, eh?", MSGBOX_YESNO)
	if(var(VAR_RESULT)) {
		if(checkmoney(500)) {
			playse(SE_SHOP)
			removemoney(500)
			updatemoneybox
			waitse
			closemessage
			textcolor(NPC_TEXT_COLOR_NEUTRAL)
			playfanfare(MUS_LEVEL_UP)
			msgbox("{PLAYER} purchased the (allegedly)\nethically-sourced MEAT!", MSGBOX_DEFAULT)
			waitfanfare
			closemessage
			fadescreen(FADE_TO_BLACK)
			setflag(FLAG_SANDWICH_GOT_MEAT)
			delay(20)
			removeobject(LAPRAS)
			fadescreen(FADE_FROM_BLACK)
			delay(20)
			textcolor(NPC_TEXT_COLOR_MALE)
			msgbox("Thanks for doing business!\n", MSGBOX_DEFAULT)
			call(FushciaCity_MakeASandwich)

		} else {
			msgbox("Huh?\nYou don't even have ¥500?\pYeesh, kid.\nGo visit BILL.", MSGBOX_DEFAULT)
		}
		
	}
	hidemoneybox

	applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
	end
}

script SafariZone_Center_Chuckster {
	lock
	faceplayer
	msgbox("I'm a CHUCKSTER!\n", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	specialvar(VAR_RESULT, GetPlayerFacingDirection)
	switch(var(VAR_RESULT)) {
		case DIR_NORTH:
			applymovement(LOCALID_PLAYER, PlayerWalkUp)
		case DIR_WEST:
			applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
		case DIR_EAST:
			applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
		case DIR_SOUTH:
			applymovement(LOCALID_PLAYER, PlayerWalkDown)
	}
	applymovement(VAR_LAST_TALKED, Common_Movement_FaceUp)
	waitmovement(LOCALID_PLAYER)
	delay(30)
	applymovement(LOCALID_PLAYER, WalkFastUp)
	applymovement(VAR_LAST_TALKED, WalkFastUp)
	waitmovement(0)
	playse(SE_LEDGE)
	applymovement(LOCALID_PLAYER, Jump2Up)
	waitmovement(0)
	delay(30)
	applymovement(VAR_LAST_TALKED, Common_Movement_WalkDown)
	delay(10)
	
	applymovement(LOCALID_PLAYER, Common_Movement_FaceDown)
	waitmovement(0)
	applymovement(VAR_LAST_TALKED, Common_Movement_FaceUp)
	delay(30)
	release

}

movement Jump2Up {
	jump_2_up
}

movement WalkFastUp {
	walk_fast_up
	face_up
}

movement PlayerWalkUp {
	walk_left
	walk_up
	face_up

}

movement PlayerWalkDown {
	walk_left
	walk_down
	face_up
}