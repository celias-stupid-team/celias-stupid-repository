raw `


Route19_EventScript_RouteSign::
	msgbox Route19_Text_RouteSign, MSGBOX_SIGN
	end
`
mapscripts Route19_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setflag(FLAG_TEMP_1)
		if(flag(FLAG_FUSHCIA_GO_TO_SHORE_SCENE) && !flag(FLAG_LOOKER_SCENE)) {
			clearflag(FLAG_TEMP_1)
		}
		setflag(FLAG_TEMP_2)
		if(flag(FLAG_LOOKER_SCENE) && !(var(VAR_CURRENT_CHAPTER) >= 7)) {
			setvar(VAR_TEMP_1, 1)
			clearflag(FLAG_TEMP_2)
		}
		if(var(VAR_CURRENT_CHAPTER) < 3) {
			setvar(VAR_CURRENT_CHAPTER, 3)
		}
	}
}

script EventScript_RemoveUselessItems {
	additem(ITEM_POKE_BALL, 20)
	while(checkitem(ITEM_ANTIDOTE)) {
		removeitem(ITEM_ANTIDOTE)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_RIPPED_MEMO)) {
		removeitem(ITEM_RIPPED_MEMO)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_PARALYZE_HEAL)) {
		removeitem(ITEM_PARALYZE_HEAL)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_SODA_POP)) {
		removeitem(ITEM_SODA_POP)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_ELIXIR)) {
		removeitem(ITEM_ELIXIR)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_MAX_ELIXIR)) {
		removeitem(ITEM_MAX_ELIXIR)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_MAX_ETHER)) {
		removeitem(ITEM_MAX_ETHER)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_NUGGET)) {
		removeitem(ITEM_NUGGET)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_DAWN_STONE) && checkmoncaught(SPECIES_NIDOQUEEN) && checkmoncaught(SPECIES_NIDOKING) && checkmoncaught(SPECIES_SYLVEON)) {
		removeitem(ITEM_DAWN_STONE)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_LEAF_STONE) && checkmoncaught(SPECIES_EXEGGUTOR)) {
		removeitem(ITEM_LEAF_STONE)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_TINY_MUSHROOM)) {
		removeitem(ITEM_TINY_MUSHROOM)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_REVIVE)) {
		removeitem(ITEM_REVIVE)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_HP_UP)) {
		removeitem(ITEM_HP_UP)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_WATER_STONE) && checkmoncaught(SPECIES_NINETALES)) {
		removeitem(ITEM_WATER_STONE)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_SUPER_REPEL)) {
		removeitem(ITEM_SUPER_REPEL)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_X_SPECIAL)) {
		removeitem(ITEM_X_SPECIAL)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_TINY_MUSHROOM)) {
		removeitem(ITEM_TINY_MUSHROOM)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_RETRO_MAIL)) {
		removeitem(ITEM_RETRO_MAIL)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_CHOICE_BAND)) {
		removeitem(ITEM_CHOICE_BAND)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_GRASS_ENERGY)) {
		removeitem(ITEM_GRASS_ENERGY)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_FIGHTING_ENERGY)) {
		removeitem(ITEM_FIGHTING_ENERGY)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_LIGHTNING_ENERGY)) {
		removeitem(ITEM_LIGHTNING_ENERGY)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_FIRE_ENERGY)) {
		removeitem(ITEM_FIRE_ENERGY)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_PSYCHIC_ENERGY)) {
		removeitem(ITEM_PSYCHIC_ENERGY)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_METRONOME)) {
		removeitem(ITEM_METRONOME)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_AWAKENING_DUNE)) {
		removeitem(ITEM_AWAKENING_DUNE)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_AWAKENING)) {
		removeitem(ITEM_AWAKENING)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_AWAKENING_FIRE_EMBLEM)) {
		removeitem(ITEM_AWAKENING_FIRE_EMBLEM)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_AWAKENING_FIRE_EMBLEM)) {
		removeitem(ITEM_DMC)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_SECRETETHER)) {
		removeitem(ITEM_SECRETETHER)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_MAGIC_MUFFLER)) {
		removeitem(ITEM_MAGIC_MUFFLER)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_LIFT_KEY)) {
		removeitem(ITEM_LIFT_KEY)
	}
	while(checkitem(ITEM_WADDED_NOTE_METAPOD)) {
		removeitem(ITEM_WADDED_NOTE_METAPOD)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_TORN_PAPER_GEODUDE)) {
		removeitem(ITEM_TORN_PAPER_GEODUDE)
		addvar(VAR_TEMP_5, 1)
	}
	while(checkitem(ITEM_DEVON_SCOPE) && flag(FLAG_CSR_FUSHCIA_HBOX)) {
		removeitem(ITEM_DEVON_SCOPE)
		addvar(VAR_TEMP_5, 1)
	}
	if(var(VAR_TEMP_5) > 10) {
		additem(ITEM_SECRETPAGE)
	}
	setvar(VAR_CURRENT_CHAPTER, 3)
	//additem(ITEM_SECRETPAGE)
	return

}

script Route19_LookerScene {
	lock
	fadenewbgm(MUS_NONE)
	call(EventScript_RemoveUselessItems)
	//player walks to right side
	specialvar(VAR_RESULT, GetPlayerFacingDirection)
	switch(var(VAR_RESULT)) {
		case DIR_SOUTH:
			applymovement(LOCALID_PLAYER, moves(
				walk_right
				walk_down
				face_left
			))
			waitmovement(LOCALID_PLAYER)
		case DIR_EAST:
			applymovement(LOCALID_PLAYER, moves(
				walk_up
				walk_right * 2
				walk_down
				face_left
			))
			waitmovement(LOCALID_PLAYER)
	}
	delay(60)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox(
	"A man has washed up on the\n"
	"shore.\l"
	"He's unconscious…", MSGBOX_DEFAULT)
	closemessage
	delay(60)
	playse(SE_PC_LOGIN)
	applymovement(LOCALID_PLAYER, moves(
		walk_in_place_left
	))
	msgbox(
	"{PLAYER} kicked the man.", MSGBOX_DEFAULT)
	closemessage
	playse(SE_M_TAKE_DOWN)
	fadescreenswapbuffers(FADE_TO_WHITE)
	delay(30)
	applymovement(LOCALID_LOOKER_LAYING, moves(
		set_invisible
		walk_up
	))
	applymovement(LOCALID_LOOKER_UP, moves(
		set_visible
	))
	waitmovement(LOCALID_LOOKER_UP)
	fadescreeninstant(FADE_FROM_WHITE)
	playbgm(MUS_LOOKER_THEME, FALSE)
	playse(SE_LEDGE)
	applymovement(LOCALID_LOOKER_UP, moves(
		jump_in_place_down
		delay_16 * 3
		face_left
		delay_16 * 3
		face_up
		delay_16 * 2
		face_down
		delay_16 * 2
		face_up
		delay_16 * 3
		
	))
	
	waitmovement(LOCALID_LOOKER_UP)
	playse(SE_PIN)
	applymovement(LOCALID_LOOKER_UP, moves(
		face_right
		emote_exclamation_mark
	))
	delay(60)
	waitmovement(LOCALID_LOOKER_UP)
	textcolor(NPC_TEXT_COLOR_MALE)
	msgbox(
	"LOOKER: Wha-!\n"
	"I've been found!\p"

	"You, there!\n"
	"You can call me LOOKER.\l"
	"I'm an INTERNATIONAL POLICE AGENT.\p"

	"I was tasked with delivering vital\n"
	"cargo, but I was attacked!\p"

	"My position has been compromised.\n"
	"I can't maintain this any longer.\p"

	"Here, take this.\n"
	"It'll be safer in your hands!", MSGBOX_DEFAULT)
	closemessage
	fadescreenswapbuffers(FADE_TO_WHITE)
	delay(20)
	applymovement(LOCALID_PLAYER, moves(
		lock_facing_direction
		walk_right
		face_left
		unlock_facing_direction

	))
	applymovement(LOCALID_ROUTE19_ROTOM, moves(
		walk_right
		set_visible
	))
	waitmovement(LOCALID_PLAYER)
	fadescreeninstant(FADE_FROM_WHITE)
	playmoncry(SPECIES_ROTOM, CRY_MODE_DEFAULT)
	waitmoncry
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox(
	"Wow!\n"
	"It's a special ROTOM!", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	applymovement(LOCALID_ROUTE19_ROTOM, moves(
		walk_right
		set_invisible
	))
	waitmovement(0)
	delay(20)
	setflag(FLAG_SYS_ROTOM_MENU)
	setvar(VAR_CURRENT_CHAPTER, 4)
	playfanfare(MUS_SLOTS_JACKPOT)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox(
	"{PLAYER} obtained the\n"
	"ROTOM POKéDEX!", MSGBOX_DEFAULT)
	waitfanfare
	playfanfare(MUS_LEVEL_UP)
	msgbox(
	"You can now access field moves\n"
	"directly from the PC BOX!", MSGBOX_DEFAULT)
	waitfanfare
	closemessage
	delay(20)
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"That ROTOM is the result of years\n"
	"of research.\l"
	"I know you'll find it useful.\p"

	"Now, I need to get out of here\n"
	"before-", MSGBOX_DEFAULT)
	closemessage
	fadenewbgm(MUS_DUMMY)
	delay(60)
	playse(SE_PIN)
	applymovement(LOCALID_LOOKER_UP, moves(
		face_down
		emote_exclamation_mark
	))
	waitmovement(0)
	delay(40)
	applymovement(LOCALID_LOOKER_UP, moves(
		lock_facing_direction
		walk_slow_up
		face_down
	))
	applymovement(LOCALID_PLAYER, moves(
		delay_16 * 2
		face_up
	))
	delay(30)
	msgbox(
	"N-no…!\n"
	"", MSGBOX_DEFAULT)
	waitmovement(LOCALID_LOOKER_UP)
	closemessage
	applymovement(LOCALID_LOOKER_UP, moves(
		unlock_facing_direction
		face_left
		delay_16
		face_right
		delay_16
		face_left
		delay_16
		face_down
	))
	delay(20)
	
	msgbox(
	"She's coming!\n"
	"", MSGBOX_DEFAULT)
	waitmovement(LOCALID_LOOKER_UP)
	closemessage
	delay(30)
	playbgm(MUS_ENCOUNTER_GIRL, FALSE)
	delay(50)
	applymovement(LOCALID_LOOKER_UP, moves(
		lock_facing_direction
		walk_up
		delay_16
		unlock_facing_direction
		walk_fast_up * 2
		walk_fast_right * 5
		walk_fast_up * 5
	))
	applymovement(LOCALID_ROUTE19_LASS_1, moves(
		delay_16 * 2
		delay_16 * 1
		walk_fast_up * 9
		walk_fast_right * 5
		walk_fast_up * 6
	))
	applymovement(LOCALID_ROUTE19_LASS_3, moves(
		delay_16 * 2
		delay_16 * 2
		delay_16 * 1
		walk_fast_up * 5
		walk_fast_right * 2
		walk_fast_up * 4
		walk_fast_right * 2
		walk_fast_up * 3
		walk_fast_right * 4
		walk_fast_up * 6
	))
	applymovement(LOCALID_ROUTE19_LASS_2, moves(
		delay_16 * 2
		delay_16 * 2
		delay_16 * 1
		walk_fast_up * 6
		walk_fast_right * 5
		walk_fast_up * 3
		walk_fast_right * 8
		walk_fast_up * 3
		walk_fast_up * 6
	))
	delay(50)
	playse(SE_FLEE)
	delay(70)
	textcolor(NPC_TEXT_COLOR_RED)
	message(
	"Don't…{PAUSE 30} look…{PAUSE 30} at…{PAUSE 30} me!\n"
	"")
	waitmovement(LOCALID_ROUTE19_LASS_2)
	fadedefaultbgm
	delay(20)
	closemessage
	removeobject(LOCALID_ROUTE19_LASS_1)
	removeobject(LOCALID_ROUTE19_LASS_2)
	removeobject(LOCALID_ROUTE19_LASS_3)
	removeobject(LOCALID_ROUTE19_ROTOM)
	removeobject(LOCALID_LOOKER_UP)
	removeobject(LOCALID_LOOKER_LAYING)
	setflag(FLAG_LOOKER_SCENE)
	clearflag(FLAG_TEMP_2)
	setvar(VAR_TEMP_1, 1)
	setrespawn(HEAL_LOCATION_ROUTE19)
	release


	//Lasses attack; looker runs away

}

script Route19_CeliaAsksYouNotToGo {
	if(!checkmoncaught(SPECIES_GIMMIGHOUL)) {
		additem(ITEM_RARE_CANDY, 1)
		msgbox(
		"Don't worry!\n"
		"You don't need to go back!\p"

		"Look through your ITEMS carefully!\n"
		"", MSGBOX_NPC)
	} else {
		if(!checkmoncaught(SPECIES_GHOLDENGO)) {
			additem(ITEM_RARE_CANDY, 1)
			msgbox(
			"Pssst!\n"
			"Check your POKéMON carefully!\p"

			"There's one you gotta evolve\n"
			"real fast!", MSGBOX_NPC)
		} else {
			msgbox(
				"CELIA: Psssst…!\p"

				"Just play along for a little bit\n"
				"longer!\l"
				"Trust me!", MSGBOX_NPC)

		}

	}
}

script Route19_CeliaTurnsYouAround {
	lock
	textcolor(NPC_TEXT_COLOR_RED)
	if(!checkmoncaught(SPECIES_GIMMIGHOUL)) {
		giveitem(ITEM_RARE_CANDY, 1)
		msgbox(
		"Don't worry!\n"
		"You don't need to go back!\p"

		"Look through your ITEMS carefully!\n"
		"", MSGBOX_DEFAULT)
	} else {
		if(!checkmoncaught(SPECIES_GHOLDENGO)) {
			giveitem(ITEM_RARE_CANDY, 1)
			msgbox(
			"Pssst!\n"
			"Check your POKéMON carefully!\p"

			"There's one you gotta evolve\n"
			"real fast!", MSGBOX_DEFAULT)
		} else {
			msgbox(
				"CELIA: Psssst…!\p"

				"Just play along for a little bit\n"
				"longer!\l"
				"Trust me!", MSGBOX_DEFAULT)

		}

	}
	closemessage
	applymovement(LOCALID_PLAYER, moves(
		walk_down
	))
}



script Route19_DrawThePit {
	setlayouttiles(LAYOUT_ROUTE19_PIT_LOW, 0, 0, 0, 0, 20, 20)

	setvar(VAR_TEMP_0, 1)
}


script Route19_DrawThePitHigh {
	setlayouttiles(LAYOUT_ROUTE19_PIT_HIGH, 0, 0, 0, 0, 20, 20)

	setvar(VAR_TEMP_0, 1)
}

script Route19_DestroyThePit {
	setlayouttiles(LAYOUT_ROUTE19, 0, 0, 0, 0, 20, 20)
	setvar(VAR_TEMP_0, 0)
}

script Route19_ChapterConfusion {
	//special(DrawWholeMapView)
	msgbox(
	"You might be asking yourself,\n"
	"“What about Chapters 4, 5, and 6?”\p"

	"Well, actually! Our Chapter 2 was\n"
	"the Japanese Chapter 4, and our\l"
	"3 was the Japanese Chapter 6!\p"

	"Now that we're on Chapter 7, they\n"
	"finally lined the numbers back up!", MSGBOX_NPC)
}

script GreatSea_FlyFix {
	clearflag(FLAG_SYS_FUSHCIA_DISABLE_FLY)
	release
}

script GreatSea_LoveChinchou {
	lock
	textcolor(NPC_TEXT_COLOR_FEMALE)
	playmoncry(SPECIES_CHINCHOU, CRY_MODE_DEFAULT)
	msgbox(
	"I don't care what they say!\p"

	"I love you, and we were meant\n"
	"for each other!", MSGBOX_DEFAULT)
	release
}


script GreatSea_LoveTirtouga {
	lock
	textcolor(NPC_TEXT_COLOR_MALE)
	playmoncry(SPECIES_TIRTOUGA, CRY_MODE_DEFAULT)
	msgbox(
	"No!\n"
	"We can't be together!\p"

	"I'm WATER 1 and WATER 3, but\n"
	"you're just WATER 2!\l"
	"It's forbidden!", MSGBOX_DEFAULT)
	release
}


script GreatSea_FontTest {
	lock
	callnative(FullyUnlockFameChecker)
	callnative(CallNativeMetronome)
	call(EventScript_RemoveUselessItems)
	msgbox(
	"{FONT_SMALL}SURF WATERFALL ROCK CLIMB\n"
	"STRENGTH CUT FLY\p"

	"WHIRLPOOL GUILLOTINE BRICK BREAK\n"
	"TAIL GLOW REST RETREAT\p"
	
	"999/999\n"
	"1234567890/\p"
	
	"There is no bench nearby!\n"
	"FALINKS used NO RETREAT!", MSGBOX_NPC)
}


script GreatSea_RadicalRed {
	trainerbattle_single(TRAINER_RADICAL_RED, "...", "...\p…!!!")
	msgbox(
	"…!!!\n"
	"", MSGBOX_NPC)
}


script GreatSea_Chapter7 {
	lock
	clearflag(FLAG_FUSHCIA_GO_TO_SHORE_SCENE)
	clearflag(FLAG_SYS_FUSHCIA_DISABLE_FLY)
	
	setvar(VAR_0x8000, MUGSHOT_CHAPTER7)
	callnative(DrawMugshot)
	delay(120)	
	setvar(VAR_0x8000, MUGSHOT_CHAPTER7_2)
	callnative(DrawMugshot)
	delay(120)

	setvar(VAR_CURRENT_CHAPTER, 7)
	callnative(ClearMugshot)
	release
}


