	msgbox(
	"SPORE (2008)\n"
	"", MSGBOX_SIGN)

}

script ExperimentRoom_FlavorText4 {
	msgbox(
	"A list of various animals, with\n"
	"different body parts circled.\p"

	"Annotations reading “This one!”\n"
	"and “Try this!” adorn the display.", MSGBOX_SIGN)

