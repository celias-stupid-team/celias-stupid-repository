script ExperimentRoom_FlavorText1 {
	msgbox(
	"“OPERATION by MILTON BRADLEY\n"
	"Speedrun Strats”", MSGBOX_SIGN)

}

script ExperimentRoom_FlavorText2 {
	msgbox(
	"A slot machine displays three body\n"
	"parts lined up perfectly.\p"

	"The full payout is given, despite\n"
	"the species being fully mismatched.", MSGBOX_SIGN)

}

