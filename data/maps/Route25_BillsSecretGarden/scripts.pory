raw `
.equ RIGHT_BOX_NUMBER,  VAR_TEMP_1
.equ RIGHT_BOX_OPEN,  FLAG_TEMP_1
.equ RIGHT_BOX_THERE, FLAG_TEMP_5


.equ LEFT_BOX_NUMBER,  VAR_TEMP_2
.equ LEFT_BOX_OPEN,  FLAG_TEMP_2
.equ LEFT_BOX_THERE, FLAG_TEMP_6
.equ LEFT_BOX_IN_PC, FLAG_TEMP_9



.equ CRIMP_BOX_NUMBER,  VAR_TEMP_3
.equ CRIMP_BOX_OPEN,  FLAG_TEMP_3
.equ CRIMP_BOX_THERE, FLAG_TEMP_7


.equ PLAYER_BOX_NUMBER,  VAR_TEMP_4
.equ PLAYER_BOX_OPEN,  FLAG_TEMP_4
.equ PLAYER_BOX_THERE, FLAG_TEMP_8


.equ PC_CURRENT_POKEMON, VAR_TEMP_5
.equ PC_CAMERA_X_VALUE,        VAR_TEMP_6
.equ PC_CAMERA_Y_VALUE,        VAR_TEMP_7
.equ PC_BOX_SLOT_NUMBER,      VAR_TEMP_8

.equ LOADED_SYSTEM_BOX, VAR_TEMP_A
.equ STRING_INCREMENTED_SYSTEM_BOX, VAR_TEMP_B

.equ PC_CURRENT_BOX, VAR_TEMP_C

.equ VAR_VIEWING_PC, VAR_TEMP_9




`

mapscripts Route25_BillsSecretGarden_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_CSR_MAP_SECRET_GARDEN)
        if(checkplayergender == MALE) {
            setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_BOX_BOY)
        } else {
            setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_BOX_GIRL)

        }
        
    }
}



script SecretGarden_Sign {
	msgbox(
	"BILL's SECRET GARDEN\n"
	"NEW WILD POKéMON: 1", MSGBOX_SIGN)

}


script SecretGarden_GivePikabluPlaceholder {
    lock
    playfanfare(MUS_LEVEL_UP)
    msgbox(
	"{PLAYER} withdrew the\n"
	"PIKABLU!", MSGBOX_DEFAULT)
    waitfanfare
    setvar(VAR_CSR_GIFT_POKEMON, SPECIES_PIKABLU)
    call(Common_Script_GiftPokemon)
    removeobject(VAR_LAST_TALKED)
    release
}

script SecretGarden_PCTerminal {
    lock
    
    if(flag(FLAG_SYS_BILL_GARDEN)) {
        playse(SE_PC_ON)
        msgbox(
        "MASTER TERMINAL OPEN\n"
        "")
        
        waitse
        dynmultichoice(0,0,TRUE,3, 0, DYN_MULTICHOICE_CB_NONE, "WITHDRAW", "CHANGE BOX", "CANCEL")
        switch(var(VAR_RESULT)) {
            case 0:
                if(!flag(LEFT_BOX_IN_PC)) {
                    waitse
                    playse(SE_BOO)
                    waitse
                    msgbox(
                    "ERROR\p"
                    "No box loaded into the system", MSGBOX_DEFAULT)
                    release
                    end
                }
                closemessage
                hidemonpic
                setvar(PC_BOX_SLOT_NUMBER, 0)
                
                delay(30)
                playse(SE_BALL_TRADE)
                delay(30)
                bufferspeciesname(STR_VAR_1, PC_CURRENT_POKEMON)
                playfanfare(MUS_LEVEL_UP)
                msgbox(
                "{PLAYER} withdrew the\n"
                "{STR_VAR_1}!", MSGBOX_DEFAULT)
                waitfanfare
                copyvar(VAR_CSR_GIFT_POKEMON, PC_CURRENT_POKEMON)
                if(var(PC_CURRENT_POKEMON) == SPECIES_PIKABLU) {
                    setflag(FLAG_BILL_PC_BROKE)
                }
                if(var(PC_CURRENT_POKEMON) == SPECIES_SHINYABRA) {
                    setflag(FLAG_SHINY_CREATION)
                    setvar(VAR_CSR_GIFT_POKEMON, SPECIES_ABRA)
                }
                call(Common_Script_GiftPokemon)
                if(flag(FLAG_BILL_PC_BROKE)) {
                    fadedefaultbgm
                    delay(60)
                    msgbox(
                    "The PC SYSTEM has gone offline.\n"
                    "", MSGBOX_DEFAULT)
                    clearflag(FLAG_SYS_BILL_GARDEN)
                    release
                    end
                    
                }
                release
                end

            case 1:
                copyvar(STRING_INCREMENTED_SYSTEM_BOX, LOADED_SYSTEM_BOX)
                addvar(STRING_INCREMENTED_SYSTEM_BOX, 1)
                buffernumberstring(STR_VAR_1, STRING_INCREMENTED_SYSTEM_BOX)
                msgbox(
                "Current selection:\n"
                "BOX {STR_VAR_1}")
                waitmessage
                dynmultichoice(0,0,FALSE,4, 0, DYN_MULTICHOICE_CB_NONE, "BOX 1   ", "BOX 2   ", "BOX 3", "BOX 4", "BOX 5", "BOX 6")
                copyvar(LOADED_SYSTEM_BOX, VAR_RESULT)
                copyvar(STRING_INCREMENTED_SYSTEM_BOX, LOADED_SYSTEM_BOX)
                addvar(STRING_INCREMENTED_SYSTEM_BOX, 1)
                buffernumberstring(STR_VAR_1, STRING_INCREMENTED_SYSTEM_BOX)
                msgbox(
                "BOX {STR_VAR_1} selected.\n"
                "", MSGBOX_DEFAULT)
                release
                end

            case 2:
                closemessage
                release
                end
        }


    } else {
        msgbox(
        "MASTER TERMINAL\n"
        "", MSGBOX_DEFAULT)
        release
        end
    }
}

script SecretGarden_PCMonitor {
    lock
    if(!flag(FLAG_SYS_BILL_GARDEN)) {
        fadenewbgm(MUS_DUMMY)

        msgbox(
        "A large, complicated PC sits\n"
        "in the field.\p"

        "Kick the PC?\n"
        "", MSGBOX_YESNO)
        if(var(VAR_RESULT)) {
            if(checkpartymove(MOVE_MEGA_KICK) == PARTY_SIZE) {
                
            }
            playse(SE_PC_ON)
            msgbox(
            "{PLAYER} kicked the PC!\n"
            "", MSGBOX_DEFAULT)
            playbgm(MUS_DELIVERY, TRUE)
            
        } else {
            fadedefaultbgm  

        }
        setflag(FLAG_SYS_BILL_GARDEN)
        setvar(LOADED_SYSTEM_BOX, 0)
        setvar(RIGHT_BOX_NUMBER, 0)
        clearflag(RIGHT_BOX_OPEN)
        setvar(LEFT_BOX_NUMBER, 1)
        setflag(RIGHT_BOX_OPEN)
        setvar(RIGHT_BOX_NUMBER, 0)
        clearflag(RIGHT_BOX_OPEN)
        setflag(LEFT_BOX_IN_PC)
        setvar(PC_CURRENT_BOX, 1)
        //setflag(LEFT_BOX_THERE)
        release
        end 

        
    }
    closemessage
    if(var(VAR_VIEWING_PC) == 0) {
        special(SpawnCameraObject)
        applymovement(LOCALID_CAMERA, moves(
            walk_fast_up * 4
        ))
        waitmovement(0)
        delay(30)
        call(SecretGarden_GetCurrentPCPokemon)
        showmonpic(PC_CURRENT_POKEMON, 10, 3)
        //waitbuttonpress
        //hidemonpic
        setvar(VAR_VIEWING_PC, 1)

    } else {
        
    }
    release
}




script SecretGarden_RetrievalChute {
    lock
	if(flag(FLAG_SYS_BILL_GARDEN)) {
        msgbox(
        "RETRIEVAL DEPOT\n"
        "", MSGBOX_DEFAULT)
        if(flag(RIGHT_BOX_THERE)) {
            if(flag(RIGHT_BOX_OPEN)) {
                closemessage
                delay(20)
                playse(SE_BOO)
                waitse
                msgbox(
                "System error.\p"

                "Please close box before exporting.\n"
                "", MSGBOX_DEFAULT)
                release
                end
            } else {
                closemessage
                delay(20)
                playse(SE_M_TELEPORT)
                applymovement(LOCALID_RIGHT_BOX, moves(
                    face_down
                    lock_facing_direction
                    walk_fast_up * 6
                ))
                waitmovement(LOCALID_RIGHT_BOX)
                clearflag(RIGHT_BOX_THERE)
                copyobjectxytoperm(LOCALID_RIGHT_BOX)
                release
                end
            }
        } else {
            
            addobject(LOCALID_RIGHT_BOX)
            setobjectxy(LOCALID_RIGHT_BOX, 25, 3)
            closemessage
            delay(20)
            playse(SE_CLICK)
            waitse
            applymovement(LOCALID_RIGHT_BOX, moves(
                walk_fast_down * 6
            ))
            delay(30)
            playse(SE_M_SPIT_UP)
            waitmovement(LOCALID_RIGHT_BOX)
            setflag(RIGHT_BOX_THERE)
            clearflag(RIGHT_BOX_OPEN)
            copyobjectxytoperm(LOCALID_RIGHT_BOX)
            copyvar(RIGHT_BOX_NUMBER, LOADED_SYSTEM_BOX)
            release
            end
        }
    } else {
        msgbox(
        "RETRIEVAL DEPOT\n"
        "", MSGBOX_DEFAULT)
        closemessage
        delay(20)
        playse(SE_CLICK)
        waitse
        msgbox(
        "The button does not respond.\n"
        "", MSGBOX_DEFAULT)
        release
    }
    release

}









script SecretGarden_LeavePC {
    lock
    special(RemoveCameraObject)
    closemessage
    setvar(VAR_VIEWING_PC, 0)
    hidemonpic
    special(SpawnCameraObject)
    waitmovement(0)
    while(var(VAR_TEMP_7) != 8) {
        applymovement(LOCALID_CAMERA, moves(
            walk_faster_down
        ))
        waitmovement(0)
        subvar(VAR_TEMP_7, 1)

    }
    waitmovement(0)

    while(var(VAR_TEMP_6) != 19) {
        
            if(var(VAR_TEMP_6) < 19) {
                applymovement(LOCALID_CAMERA, moves(
                    walk_faster_left
                ))
                waitmovement(0)
                addvar(VAR_TEMP_6, 1)
            } elif(var(VAR_TEMP_6) > 19) {
                applymovement(LOCALID_CAMERA, moves(
                    walk_faster_right
                ))
                waitmovement(0)
                subvar(VAR_TEMP_6, 1)
            } else {

            }
        
    }
    waitmovement(0)
    special(RemoveCameraObject)
    return
}

script SecretGarden_Debug {
    callnative(BillsSecretGardenDebug)
    release
}

script SecretGarden_PCRightButton {
    lock
    if(flag(FLAG_SYS_BILL_GARDEN)) {
        if(var(VAR_TEMP_9) == 0) {
            release
            end
        }
        if(var(PC_BOX_SLOT_NUMBER) < 8) {
            addvar(PC_BOX_SLOT_NUMBER, 1)
            hidemonpic
            call(SecretGarden_GetCurrentPCPokemon)
            showmonpic(PC_CURRENT_POKEMON, 10, 3)
        } else {
            waitse
            playse(SE_BOO)
            waitse
        }
    } else {
        msgbox(
        "A large, complicated machine sits\n"
        "in the field.", MSGBOX_DEFAULT)

    }
    release
}


script SecretGarden_PCLeftButton {
    lock
    if(flag(FLAG_SYS_BILL_GARDEN)) {
        
        if(var(VAR_TEMP_9) == 0) {
            release
            end
        }
        if(var(PC_BOX_SLOT_NUMBER) > 0) {
            subvar(PC_BOX_SLOT_NUMBER, 1)
            hidemonpic
            call(SecretGarden_GetCurrentPCPokemon)
            showmonpic(PC_CURRENT_POKEMON, 10, 3)
        } else {
            waitse
            playse(SE_BOO)
            waitse
        }
    } else {
        msgbox(
        "A large, complicated machine sits\n"
        "in the field.", MSGBOX_DEFAULT)

    }
    release
}

script SecretGarden_PCBoxDock {
    lock
	if(flag(FLAG_SYS_BILL_GARDEN)) {
        msgbox(
        "IMPORT DEPOT\n"
        "", MSGBOX_DEFAULT)
        if(flag(FLAG_SYS_CARRYING_BOX)) {

        }
        if(flag(LEFT_BOX_THERE)) {
            if(flag(LEFT_BOX_IN_PC)) {
                closemessage
                delay(20)
                playse(SE_BOO)
                msgbox(
                "SYSTEM ERROR\p"

                "Cannot load box.\n"
                "System is loaded.", MSGBOX_DEFAULT)
                closemessage
                release
                end
            } else {
                closemessage
                delay(20)
                playse(SE_CLICK)
                delay(40)
                applymovement(LOCALID_LEFT_BOX, moves(
                    lock_facing_direction
                    walk_fast_up * 2
                    set_invisible
                    walk_fast_up
                    walk_fast_right * 2
                    unlock_facing_direction
                    face_up
                ))
                waitmovement(LOCALID_LEFT_BOX)
                setflag(LEFT_BOX_OPEN)
                setvar(PC_BOX_SLOT_NUMBER, 0)
                clearflag(LEFT_BOX_THERE)
                setflag(LEFT_BOX_IN_PC)
                copyvar(PC_CURRENT_BOX, LEFT_BOX_NUMBER)
                setvar(PC_BOX_SLOT_NUMBER, 0)
                setobjectmovementtype(LOCALID_LEFT_BOX, MOVEMENT_TYPE_FACE_UP)
                applymovement(LOCALID_LEFT_BOX, moves(
                    face_up
                ))
                waitmovement(0)
                copyobjectxytoperm(LOCALID_LEFT_BOX)
                release
                end

            }
        } else {
            if(flag(LEFT_BOX_IN_PC)) {
                closemessage
                delay(20)
                playse(SE_CLICK)
                waitse
                applymovement(LOCALID_LEFT_BOX, moves(
                    set_invisible
                    face_up
                    lock_facing_direction
                    walk_fast_left * 2
                    walk_fast_down
                    face_up
                    set_visible
                    walk_fast_down * 2
                ))
                delay(30)
                playse(SE_M_SPIT_UP)
                waitmovement(LOCALID_LEFT_BOX)
                setobjectmovementtype(LOCALID_LEFT_BOX, MOVEMENT_TYPE_FACE_UP)
                applymovement(LOCALID_LEFT_BOX, moves(
                    face_up
                ))
                waitmovement(0)
                copyobjectxytoperm(LOCALID_LEFT_BOX)
                clearflag(LEFT_BOX_IN_PC)
                setflag(LEFT_BOX_OPEN)
                setflag(LEFT_BOX_THERE)
                release
                end

            } else {
                closemessage
                delay(20)
                playse(SE_CLICK)
                waitse
                msgbox(
                "The button does not respond.\n"
                "", MSGBOX_DEFAULT)
                release
                end
            }
        }
    } else {
        msgbox(
        "IMPORT DEPOT\n"
        "", MSGBOX_DEFAULT)
        closemessage
        delay(20)
        playse(SE_CLICK)
        waitse
        msgbox(
        "The button does not respond.\n"
        "", MSGBOX_DEFAULT)
        release
    }
    release
}


script SecretGarden_ExportBoxDock {
    lock
	msgbox(
	"LOADING BAY DOCK\n"
	"", MSGBOX_DEFAULT)
    if(flag(RIGHT_BOX_THERE)) {
        if(flag(FLAG_SYS_CARRYING_BOX)) {
            closemessage
            delay(20)
            msgbox(
            "You cannot lift a second box.\n"
            "", MSGBOX_DEFAULT)
            release
            end
        } else {
            msgbox(
            "{PLAYER} picked up the BOX.\n"
            "", MSGBOX_DEFAULT)
            setflag(FLAG_SYS_CARRYING_BOX)
            if(flag(RIGHT_BOX_OPEN)) {
                setflag(PLAYER_BOX_OPEN)
            } else {
                clearflag(PLAYER_BOX_OPEN)
            }
            copyvar(PLAYER_BOX_NUMBER, RIGHT_BOX_NUMBER)
            setflag(PLAYER_BOX_THERE)
            clearflag(RIGHT_BOX_THERE)
            setobjectxy(LOCALID_RIGHT_BOX, 25, 3)
            copyobjectxytoperm(LOCALID_RIGHT_BOX)
            release
            end
        }
    } else { // no box there
        if(flag(FLAG_SYS_CARRYING_BOX)) {
            playse(SE_BANG)
            if(flag(PLAYER_BOX_OPEN)) {
                setflag(RIGHT_BOX_OPEN)
                setobjectmovementtype(LOCALID_RIGHT_BOX, MOVEMENT_TYPE_FACE_UP)
                applymovement(LOCALID_RIGHT_BOX, moves(
                    face_up
                ))
                waitmovement(0)
            } else {
                clearflag(RIGHT_BOX_OPEN)
                setobjectmovementtype(LOCALID_RIGHT_BOX, MOVEMENT_TYPE_FACE_DOWN)
                applymovement(LOCALID_RIGHT_BOX, moves(
                    face_down
                ))
                waitmovement(0)
            }
            addobject(LOCALID_RIGHT_BOX)
            setobjectxy(LOCALID_RIGHT_BOX, 25, 9)
            copyobjectxytoperm(LOCALID_RIGHT_BOX)
            clearflag(PLAYER_BOX_THERE)
            clearflag(FLAG_SYS_CARRYING_BOX)
            setflag(RIGHT_BOX_THERE)
            copyvar(RIGHT_BOX_NUMBER, PLAYER_BOX_NUMBER)
            release
            end

        } else {

        }
    }
    release
}

script SecretGarden_PCBoxPallet {
    lock
	msgbox(
	"PC BOX PALETTE\n", MSGBOX_DEFAULT)
    if(flag(LEFT_BOX_THERE)) {
        if(flag(FLAG_SYS_CARRYING_BOX)) {
            closemessage
            delay(20)
            msgbox(
            "You cannot lift a second box.\n"
            "", MSGBOX_DEFAULT)
            release
            end
        } else {
            msgbox(
            "{PLAYER} picked up the BOX.\n"
            "", MSGBOX_DEFAULT)
            setflag(FLAG_SYS_CARRYING_BOX)
            copyvar(PLAYER_BOX_NUMBER, LEFT_BOX_NUMBER)
            if(flag(LEFT_BOX_OPEN)) {
                setflag(PLAYER_BOX_OPEN)
            } else {
                clearflag(PLAYER_BOX_OPEN)
            }
            
            setflag(PLAYER_BOX_THERE)
            clearflag(LEFT_BOX_THERE)
            setobjectxy(LOCALID_LEFT_BOX, 25, 3)
            copyobjectxytoperm(LOCALID_LEFT_BOX)
            release
            end
        }
    } else { // no box
        if(flag(FLAG_SYS_CARRYING_BOX)) {
            playse(SE_BANG)
            addobject(LOCALID_LEFT_BOX)
            if(flag(PLAYER_BOX_OPEN)) {
                setflag(LEFT_BOX_OPEN)
                setobjectmovementtype(LOCALID_LEFT_BOX, MOVEMENT_TYPE_FACE_UP)
                applymovement(LOCALID_LEFT_BOX, moves(
                    face_up
                ))
                waitmovement(0)
            } else {
                clearflag(LEFT_BOX_OPEN)
                setobjectmovementtype(LOCALID_LEFT_BOX, MOVEMENT_TYPE_FACE_DOWN)
                applymovement(LOCALID_LEFT_BOX, moves(
                    face_down
                ))
                waitmovement(0)
            }
            setobjectxy(LOCALID_LEFT_BOX, 12, 9)
            copyobjectxytoperm(LOCALID_LEFT_BOX)
            clearflag(PLAYER_BOX_THERE)
            clearflag(FLAG_SYS_CARRYING_BOX)
            setflag(LEFT_BOX_THERE)
            copyvar(LEFT_BOX_NUMBER, PLAYER_BOX_NUMBER)
            release
            end


        } else {
            release
            end
        }
    }

    release
}


script SecretGarden_BoxCrimper {
    lock
	msgbox(
	"BOX CLOSER\n"
	"", MSGBOX_DEFAULT)
    if(flag(CRIMP_BOX_THERE)) {
        if(flag(FLAG_SYS_CARRYING_BOX)) {
            closemessage
            delay(20)
            msgbox(
            "You cannot lift a second box.\n"
            "", MSGBOX_DEFAULT)
            release
            end
            
        } else {
            setobjectxy(LOCALID_CRIMP_BOX, 8, 16)
            copyobjectxytoperm(LOCALID_CRIMP_BOX)
            copyvar(PLAYER_BOX_NUMBER, CRIMP_BOX_NUMBER)
            clearflag(CRIMP_BOX_THERE)
            if(flag(CRIMP_BOX_OPEN)) {
                setflag(PLAYER_BOX_OPEN)

            } else {
                clearflag(PLAYER_BOX_OPEN)
            }
            setflag(FLAG_SYS_CARRYING_BOX)
            setflag(PLAYER_BOX_THERE)

        }
    } else { //no box
        if(flag(FLAG_SYS_CARRYING_BOX)) {
            closemessage
            playse(SE_BANG)
            clearflag(FLAG_SYS_CARRYING_BOX)
            addobject(LOCALID_CRIMP_BOX)
            clearflag(PLAYER_BOX_THERE)
            copyvar(CRIMP_BOX_NUMBER, PLAYER_BOX_NUMBER)
            if(flag(PLAYER_BOX_OPEN)) {
                setflag(CRIMP_BOX_OPEN)
                setobjectmovementtype(LOCALID_CRIMP_BOX, MOVEMENT_TYPE_FACE_UP)
                applymovement(LOCALID_CRIMP_BOX, moves(
                    face_up
                ))
            } else {
                clearflag(CRIMP_BOX_OPEN)
                setobjectmovementtype(LOCALID_CRIMP_BOX, MOVEMENT_TYPE_FACE_DOWN)
                applymovement(LOCALID_CRIMP_BOX, moves(
                    face_down
                ))
            }
            waitmovement(0)
            setobjectxy(LOCALID_CRIMP_BOX, 12, 19)
            copyobjectxytoperm(LOCALID_CRIMP_BOX)
            setflag(CRIMP_BOX_THERE)
            release
            end

        } else {
            release
            end

        }
    }
    release
}


script SecretGarden_BoxCrimperControl {
    lock
	msgbox(
	"BOX CLOSER CONTROL PANEL\n"
	"", MSGBOX_DEFAULT)
    if(flag(CRIMP_BOX_THERE)) {
        closemessage
        delay(20)
        playse(SE_CLICK)
        waitse
        clearflag(CRIMP_BOX_OPEN)
        setobjectmovementtype(LOCALID_CRIMP_BOX, MOVEMENT_TYPE_FACE_DOWN)
        applymovement(LOCALID_CRIMP_BOX, moves(
            face_down
        ))
        waitmovement(0)

    }
    release
}

script SecretGarden_BillDiary {
	msgbox(
	"Dearest Diary,\p"

	"I discovered a most rare and\n"
	"wonderful new POKéMON today.\p"

	"I have it stored in BOX 4 of my\n"
	"old PC SYSTEM.\l"
	"Thankfully it's all still kicking!\p"

	"It's a shame the instruction book\n"
	"got destroyed in that experiment.\p"

	"Oh well!\n"
	"Not like anyone else has to use it!\p"

	"Love,\n"
	"BILL", MSGBOX_SIGN)

}



