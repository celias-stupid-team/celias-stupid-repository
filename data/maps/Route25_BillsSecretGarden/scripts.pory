script SecretGarden_GetCurrentPCPokemon {
    switch(var(PC_CURRENT_BOX)) {
        case 0:
            switch(var(PC_BOX_SLOT_NUMBER)) {
                case 0:
                    setvar(PC_CURRENT_POKEMON, SPECIES_BELLSPROUT)
                case 1:
                    setvar(PC_CURRENT_POKEMON, SPECIES_RATTATA)
                case 2:
                    setvar(PC_CURRENT_POKEMON, SPECIES_ABRA)
                case 3:
                    setvar(PC_CURRENT_POKEMON, SPECIES_SPEAROW)
                case 4:
                    setvar(PC_CURRENT_POKEMON, SPECIES_CHARMANDER)
                case 5:
                    setvar(PC_CURRENT_POKEMON, SPECIES_SANDSHREW)
                case 6:
                    setvar(PC_CURRENT_POKEMON, SPECIES_BELLSPROUT)
