}



script SecretGarden_GetCurrentPCPokemon {
    switch(var(LEFT_BOX_NUMBER)) {
        case 0:
            switch(var(PC_BOX_SLOT_NUMBER)) {
                case 0:
                    setvar(PC_CURRENT_POKEMON, SPECIES_BELLSPROUT)
                case 1:
                    setvar(PC_CURRENT_POKEMON, SPECIES_RATTATA)
                case 2:
                    setvar(PC_CURRENT_POKEMON, SPECIES_ABRA)
                case 3:
                    setvar(PC_CURRENT_POKEMON, SPECIES_SPEAROW)
                case 4:
                    setvar(PC_CURRENT_POKEMON, SPECIES_CHARMANDER)
                case 5:
                    setvar(PC_CURRENT_POKEMON, SPECIES_SANDSHREW)
                case 6:
                    setvar(PC_CURRENT_POKEMON, SPECIES_BELLSPROUT)
                case 7:
                    setvar(PC_CURRENT_POKEMON, SPECIES_BELLSPROUT)
                case 8:
                    setvar(PC_CURRENT_POKEMON, SPECIES_TENTACOOL)
            }
        case 1:
            switch(var(PC_BOX_SLOT_NUMBER)) {
                case 0:
                    setvar(PC_CURRENT_POKEMON, SPECIES_BELLSPROUT)
                case 1:
                    setvar(PC_CURRENT_POKEMON, SPECIES_RATTATA)
                case 2:
                    setvar(PC_CURRENT_POKEMON, SPECIES_ABRA)
                case 3:
                    setvar(PC_CURRENT_POKEMON, SPECIES_SPEAROW)
                case 4:
                    setvar(PC_CURRENT_POKEMON, SPECIES_CHARMANDER)
                case 5:
                    setvar(PC_CURRENT_POKEMON, SPECIES_PIKABLU)
                case 6:
                    setvar(PC_CURRENT_POKEMON, SPECIES_RATTATA)
                case 7:
                    setvar(PC_CURRENT_POKEMON, SPECIES_BELLSPROUT)
                case 8:
                    setvar(PC_CURRENT_POKEMON, SPECIES_TENTACOOL)
            }
        case 2:
            switch(var(PC_BOX_SLOT_NUMBER)) {
                case 0:
                    setvar(PC_CURRENT_POKEMON, SPECIES_EEVEE)
                case 1:
                    setvar(PC_CURRENT_POKEMON, SPECIES_EEVEE)
                case 2:
                    setvar(PC_CURRENT_POKEMON, SPECIES_EEVEE)
                case 3:
                    setvar(PC_CURRENT_POKEMON, SPECIES_EEVEE)
                case 4:
                    setvar(PC_CURRENT_POKEMON, SPECIES_EEVEE)
                case 5:
                    setvar(PC_CURRENT_POKEMON, SPECIES_EEVEE)
                case 6:
                    setvar(PC_CURRENT_POKEMON, SPECIES_EEVEE)
                case 7:
                    setvar(PC_CURRENT_POKEMON, SPECIES_EEVEE)
                case 8:
                    setvar(PC_CURRENT_POKEMON, SPECIES_EEVEE)
            }
        case 3:
        case 4:
            switch(var(PC_BOX_SLOT_NUMBER)) {
                case 0:
                    setvar(PC_CURRENT_POKEMON, SPECIES_BELLSPROUT)
                case 1:
                    setvar(PC_CURRENT_POKEMON, SPECIES_RATTATA)
                case 2:
                    setvar(PC_CURRENT_POKEMON, SPECIES_ABRA)
                case 3:
                    setvar(PC_CURRENT_POKEMON, SPECIES_SPEAROW)
                case 4:
                    setvar(PC_CURRENT_POKEMON, SPECIES_CHARMANDER)
                case 5:
                    setvar(PC_CURRENT_POKEMON, SPECIES_SANDSHREW)
                case 6:
                    setvar(PC_CURRENT_POKEMON, SPECIES_PIKABLU)
                case 7:
