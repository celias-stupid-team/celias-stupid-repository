raw `
.equ RIGHT_BOX_NUMBER,  VAR_TEMP_1
.equ RIGHT_BOX_OPEN,  FLAG_TEMP_1

.equ LEFT_BOX_NUMBER,  VAR_TEMP_2
.equ LEFT_BOX_OPEN,  FLAG_TEMP_2

.equ CRIMP_BOX_NUMBER,  VAR_TEMP_3
.equ CRIM_BOX_OPEN,  FLAG_TEMP_3

.equ PLAYER_STARTER_SPECIES,  VAR_TEMP_2
.equ RIVAL_STARTER_SPECIES,   VAR_TEMP_3
.equ RIVAL_STARTER_ID,        VAR_TEMP_4
.equ RIVAL_STARTER_ID,        VAR_TEMP_5

.equ PC_CAMERA_X_VALUE,        VAR_TEMP_6
.equ PC_CAMERA_Y_VALUE,        VAR_TEMP_7
.equ PC_BOX_SLOT_NUMBER,      VAR_TEMP_8




`

mapscripts Route25_BillsSecretGarden_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_CSR_MAP_SECRET_GARDEN)
        if(checkplayergender == MALE) {
            setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_BOX_BOY)
        } else {
            setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_BOX_GIRL)

        }
        
    }
}



script SecretGarden_Sign {
	msgbox(
	"BILL's SECRET GARDEN\n"
	"NEW WILD POKéMON: 1", MSGBOX_SIGN)

}


script SecretGarden_GivePikabluPlaceholder {
    lock
    playfanfare(MUS_LEVEL_UP)
    msgbox(
	"{PLAYER} withdrew the\n"
	"PIKABLU!", MSGBOX_DEFAULT)
    waitfanfare
    setvar(VAR_CSR_GIFT_POKEMON, SPECIES_PIKABLU)
    call(Common_Script_GiftPokemon)
    removeobject(VAR_LAST_TALKED)
    release
}

script SecretGarden_PCTerminal {
    lock
    fadenewbgm(MUS_DUMMY)
    if(flag(FLAG_SYS_BILL_GARDEN)) {
        msgbox(
        "PC On.\n"
        "", MSGBOX_DEFAULT)
    } else {
        msgbox(
        "Kick the PC?\n"
        "", MSGBOX_YESNO)
        if(var(VAR_RESULT)) {
            playse(SE_PC_ON)
            msgbox(
            "{PLAYER} kicked the PC!\n"
            "", MSGBOX_DEFAULT)
            playbgm(MUS_DELIVERY, TRUE)
            
        } else {
            fadedefaultbgm  

        }
        setflag(FLAG_SYS_BILL_GARDEN)
        release
        end 
    }
}


script SecretGarden_RetrievalChute {
    lock
	msgbox(
	"Box Retrieval Chute\n"
	"", MSGBOX_DEFAULT)
    release

}

 
script SecretGarden_PCMonitor {
    lock
	msgbox(
	"PC Monitor\n"
	"", MSGBOX_DEFAULT)
    closemessage
    if(var(VAR_VIEWING_PC) == 0) {
        special(SpawnCameraObject)
        applymovement(LOCALID_CAMERA, moves(
            walk_fast_up * 4
        ))
        waitmovement(0)
        delay(30)
        showmonpic(SPECIES_ABRA, 10, 3)
        //waitbuttonpress
        //hidemonpic
        setvar(VAR_VIEWING_PC, 1)

    }
    release
}


script SecretGarden_LeavePC {
    lock
    special(RemoveCameraObject)
    closemessage
    setvar(VAR_VIEWING_PC, 0)
    hidemonpic
    special(SpawnCameraObject)
    waitmovement(0)
    while(var(VAR_TEMP_6) != 19) {
        while(var(VAR_TEMP_7) != 8) {
            if(var(VAR_TEMP_6) < 19) {
                applymovement(LOCALID_CAMERA, moves(
                    walk_faster_left
                ))
                waitmovement(0)
                addvar(VAR_TEMP_6, 1)
            } elif(var(VAR_TEMP_6) > 19) {
                applymovement(LOCALID_CAMERA, moves(
                    walk_faster_right
                ))
                waitmovement(0)
                subvar(VAR_TEMP_6, 1)
            } else {
                applymovement(LOCALID_CAMERA, moves(
                    walk_faster_down
                ))
                waitmovement(0)
                subvar(VAR_TEMP_7, 1)
            }
        }
    }
    waitmovement(0)
    special(RemoveCameraObject)
    release
}

