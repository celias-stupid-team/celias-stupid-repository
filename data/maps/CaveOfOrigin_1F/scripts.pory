mapscripts CaveOfOrigin_1F_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setflag(FLAG_CSR_MAP_CAVE_OF_ORIGIN)

	}
}


script CaveOfOrigin_1F_Sign {
	msgbox(
	"CAVE OF ORIGIN OF LIFE\n"
	"", MSGBOX_SIGN)

}

script CaveOfOrigin_OnixEncounter1 {
	lock
	setvar(VAR_CAVE_OF_ORIGIN, 1)
	setwildbattle(SPECIES_ONIX, 30)
	dowildbattle
}
script CaveOfOrigin_OnixEncounter2 {
	lock
	setvar(VAR_CAVE_OF_ORIGIN, 2)
	setwildbattle(SPECIES_ONIX, 30)
	dowildbattle
}
script CaveOfOrigin_CloysterEncounter {
	lock
	setvar(VAR_CAVE_OF_ORIGIN, 3)
	setwildbattle(SPECIES_CLOYSTER, 30)
	dowildbattle
}