mapscripts FushciaGym_DarkraiRoom_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        if(checktrainerflag(TRAINER_FUSHCIA_GYM_JANINE)) {
            call(FushciaGym_DarkraiRoom_OpenDoors)

        }
        setrespawn(HEAL_LOCATION_FUSHCIA_GYM_DARKRAI_ROOM)
    }
}

script FushciaGym_DarkraiRoom_OpenDoors {
    setmetatile(9, 6, 0x3A6, TRUE)
    setmetatile(9, 7, 0x357, TRUE)
    return
}


script FushciaGym_DarkraiRoom_Janine {
    lock
    faceplayer
    if(checktrainerflag(TRAINER_FUSHCIA_GYM_JANINE)) {
    msgbox("The FRONTIER BRAINS in the other\nrooms won't stop yelling.\pIt's keeping me awake!\n", MSGBOX_DEFAULT)
        call(FushciaGym_DarkraiRoom_OpenDoors)
        special(DrawWholeMapView)
    } else {
        msgbox("My name is JANINE!\nMy FATHER is the LEADER of this GYM!\pAre you tired yet?\nFUSHCIA GYM is just beginning!")
        trainerbattle_no_intro(TRAINER_FUSHCIA_GYM_JANINE, "Hey!\nNo fair!")
        call(FushciaGym_DarkraiRoom_OpenDoors)
        special(DrawWholeMapView)

    }
    call(FushciaGym_DarkraiRoom_OpenDoors)
    special(DrawWholeMapView)
    release
}