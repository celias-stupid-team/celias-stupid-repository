
const DeadMan = 1
mapscripts KantoLighthouse_2F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if(!flag(FLAG_LIGHTHOUSE_FALLING_FROM_ABOVE)) {
            setflag(FLAG_TEMP_1)
        }
        if(flag(FLAG_LIGHTHOUSE_FALLING_FROM_ABOVE)) {
            setflag(FLAG_LIGHTHOUSE_OLD_MAN)
        }
    }
    MAP_SCRIPT_ON_LOAD {
    }
}

script KantoLighthouse_2F_DeadMan {
    lock
	msgbox("Oops\n", MSGBOX_DEFAULT)
    release
	end
}

script KantoLighthouse_2F_FallDownHole {
	setflag(FLAG_LIGHTHOUSE_FALLING_FROM_ABOVE)
	call(DrawHoleFloorCovers)
	special(SpawnCameraObject)
	applymovement(LOCALID_PLAYER, PlayerFallsDownHole)
	delay(46)
	playse(SE_FALL)
	waitmovement(0)
    setobjectxy(LOCALID_PLAYER, 11, 5)
    warphole(MAP_KANTO_LIGHTHOUSE_1F)
    release
    end
}

script KantoLighthouse_HaircutHint {
	msgbox("People often do things in the\ndarkness of the UNDERGROUND PATH.", MSGBOX_NPC)
	end
}


script KantoLighthouse_TopHalfLady {
	msgbox("Phew, good thing the entire top\nhalf of the LIGHTHOUSE is intact!\pThe week they remodeled downstairs,\nthere were at least 12 shipwrecks.\lThe debris really ruined the view!", MSGBOX_NPC)
	end
}