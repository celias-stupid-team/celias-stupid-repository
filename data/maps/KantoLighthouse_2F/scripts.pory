
const DeadMan = 1
mapscripts KantoLighthouse_2F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if(!flag(FLAG_LIGHTHOUSE_FALLING_FROM_ABOVE)) {
            setflag(FLAG_TEMP_1)
        }
        if(flag(FLAG_LIGHTHOUSE_FALLING_FROM_ABOVE)) {
            setflag(FLAG_LIGHTHOUSE_OLD_MAN)
        }
    }
    MAP_SCRIPT_ON_LOAD {
    }
}

script KantoLighthouse_2F_DeadMan {
    lock
	msgbox("Oops\n", MSGBOX_DEFAULT)
    release
	end
}

script KantoLighthouse_2F_FallDownHole {
	setflag(FLAG_LIGHTHOUSE_FALLING_FROM_ABOVE)
	call(DrawHoleFloorCovers)
	special(SpawnCameraObject)
	applymovement(LOCALID_PLAYER, PlayerFallsDownHole)
	delay(46)
	playse(SE_FALL)
	waitmovement(0)
    setobjectxy(LOCALID_PLAYER, 11, 5)
    warphole(MAP_KANTO_LIGHTHOUSE_1F)
    release
    end
}

script KantoLighthouse_HaircutHint {
	msgbox("People often do things in the\ndarkness of the UNDERGROUND PATH.", MSGBOX_NPC)
	end
}


script KantoLighthouse_TopHalfLady {
	msgbox("Phew, good thing the entire top\nhalf of the LIGHTHOUSE is intact!\pThe week they remodeled downstairs,\nthere were at least 12 shipwrecks.\lThe debris really ruined the view!", MSGBOX_NPC)
	end
}

script CeliaSecret_VoidLighthouse {
	msgbox("There's an exact copy of this map\n50 tiles up and left of here.\lWe're in the bottom corner of a\lgiant void.\pI use the copy to line up parity\nwith the downstairs.\pYou'll see why we're in the corner\nof a void soon.", MSGBOX_NPC)
	end
}

script CeliaSecret_WhyLighthouseGts {
	msgbox("please don't question why\nthe lighthouse was still built\lon top of the gts\pi needed this\n", MSGBOX_NPC)
	end
}

script CeliaSecret_WhyVoidLighthouse {
	msgbox("When you jump out the window, the\nmap needs to be aligned with the\lspot you fall.\pBecause of that, this tiny room is\non a map the size of ROUTE 15, and\lwe're just in the bottom corner.", MSGBOX_NPC)
	end
}

script CeliaSecret_ObjectEventSubpriority {
	msgbox("When the player would fall, they'd\nalways get layered below the oldy\pIn order to fix this, I had to mess\nwith Object Event Subpriority!\pIf you don't know what that means,\nnice!\lNeither do I!", MSGBOX_NPC)
	end
}