
const DeadMan = 1
mapscripts KantoLighthouse_2F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if(!flag(FLAG_LIGHTHOUSE_FALLING_FROM_ABOVE)) {
            setflag(FLAG_TEMP_1)
            setflag(FLAG_LIGHTHOUSE_OLD_MAN)
        }
    }
    MAP_SCRIPT_ON_LOAD {
    }
}

script KantoLighthouse_2F_DeadMan {
    lock
	msgbox("Oops\n", MSGBOX_DEFAULT)
    release
	end
}

script KantoLighthouse_2F_FallDownHole {
    lock
	setflag(FLAG_LIGHTHOUSE_FALLING_FROM_ABOVE)
    setobjectxy(LOCALID_PLAYER, 8, 3)
    warphole(MAP_KANTO_LIGHTHOUSE_1F)
    release
    end
}

script KantoLighthouse_HaircutHint {
	msgbox("People often do things in the\ndarkness of the UNDERGROUND PATH.", MSGBOX_NPC)
	end
}