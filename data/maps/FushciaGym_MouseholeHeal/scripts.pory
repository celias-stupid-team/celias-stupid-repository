
const NURSE = 1
const DRILL = 3
mapscripts FushciaGym_MouseholeHeal_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        if(var(VAR_FUSHCIA_PREVIOUS_ROOM) == FUSHCIA_ROOM_DURANT) {
            setobjectxyperm(NURSE, 11, 11)
        } else {
            
            setobjectxyperm(NURSE, 17, 11)
        }
        if(var(VAR_FUSCSIA_GYM_HIPPO_ROOM) == 1) {
            setweather(WEATHER_SANDSTORM)
        } else {
            setflag(FLAG_TEMP_1)
        }
        if(flag(FLAG_DRILLED_RIGHT_HOLE)) {
            setmetatile(20, 10, 0x39B, TRUE)
            setmetatile(21, 10, 0x39B, TRUE)
            setmetatile(22, 10, 0x39B, TRUE)

        }
        if(flag(FLAG_DRILLED_LEFT_HOLE)) {
            setmetatile(7, 10, 0x39B, TRUE)
            setmetatile(6, 10, 0x39B, TRUE)
            setmetatile(5, 10, 0x39B, TRUE)

        }
        if(!flag(FLAG_DEFEATED_TRAINER_1)) {
            call(FushciaGym_MouseholesHeal_CloseLeftDoor)
        }
        
        setrespawn(HEAL_LOCATION_FUSHCIA_GYM_MOUSEHOLE_HEAL)
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_1, 0 {
            setvar(VAR_TEMP_1, 1)
            applymovement(NURSE, Common_Movement_WalkDown)
            waitmovement(0)
            call(FushciaGym_HealNurse)
        }
    ]
}

script FushciaGym_HealNurse {
    lock
    faceplayer
    textcolor(NPC_TEXT_COLOR_FEMALE)
    msgbox("Allow me to heal your POKéMON.\n", MSGBOX_DEFAULT)
    special(HealPlayerParty)
    release
}

script FushciaGym_HippoMiddle {
        lock
    faceplayer
    playse(SE_PIN)
    applymovement(VAR_LAST_TALKED, Common_Movement_ExclamationMark)
    delay(60)
    playmoncry(SPECIES_HIPPOPOTAS, CRY_MODE_NORMAL)
    msgbox("HIPPOPOTAS: Po-prra…!\n", MSGBOX_DEFAULT)
    waitmoncry
    closemessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    playse(SE_FLEE)
    if(flag(FLAG_DRILLED_RIGHT_HOLE)) {
        setvar(VAR_FUSCSIA_GYM_HIPPO_ROOM, 2)
    } else {
        setvar(VAR_FUSCSIA_GYM_HIPPO_ROOM, 0)

    }
    removeobject(VAR_LAST_TALKED)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    setweather(WEATHER_NONE)
    doweather
    setflag(FLAG_TEMP_1)
    release
}


script FushciaGym_CrackedWallMiddleRight {
    lock
    if(flag(FLAG_DRILLED_RIGHT_HOLE)) {
        msgbox("The hole is too small for you\nto walk through.", MSGBOX_DEFAULT)
        release
        end
    }
    msgbox("A small crack has been forming in\nthe wall.", MSGBOX_DEFAULT)
    if(checkitem(ITEM_DRILL_DOZER)) {
        msgbox("Would you like to DRILL through\nit?", MSGBOX_YESNO)
        if(var(VAR_RESULT)) {
            msgbox("{PLAYER} used the DRILL DOZER!\n", MSGBOX_DEFAULT)
            closemessage
            delay(20)
            addobject(DRILL)
            playse(SE_M_EARTHQUAKE)
            setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 1)
            setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 1)
            setvar(VAR_SHAKESCREEN_NUM_SHAKES, 1)
            setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 1)
            setflag(FLAG_DRILLED_RIGHT_HOLE)
            setobjectxy(DRILL, 20, 10)

            applymovement(DRILL, DrillDozesRight)
            setflag(FLAG_DRILLED_RIGHT_HOLE)
            setmetatile(20, 10, 0x39B, TRUE)
            special(DrawWholeMapView)
            special(ShakeScreen)
            delay(40)
            setmetatile(21, 10, 0x39B, TRUE)
            special(DrawWholeMapView)
            special(ShakeScreen)
            delay(40)
            setmetatile(22, 10, 0x39B, TRUE)
            special(DrawWholeMapView)
            special(ShakeScreen)
            delay(60)
            setobjectxy(DRILL, 0, 0)
            
            special(DrawWholeMapView)
        }
    }
    release
}


movement DrillDozesRight {
    set_visible
    walk_in_place_fast_right * 4
    walk_fast_right
    walk_in_place_fast_right * 4
    walk_fast_right
    walk_in_place_fast_right * 4
}


script FushciaGym_CrackedWallMiddleLeft {
    lock
    if(flag(FLAG_DRILLED_LEFT_HOLE)) {
        msgbox("The hole is too small for you\nto walk through.", MSGBOX_DEFAULT)
        release
        end
    }
    msgbox("A small crack has been forming in\nthe wall.", MSGBOX_DEFAULT)
    if(checkitem(ITEM_DRILL_DOZER)) {
        msgbox("Would you like to DRILL through\nit?", MSGBOX_YESNO)
        if(var(VAR_RESULT)) {
            msgbox("{PLAYER} used the DRILL DOZER!\n", MSGBOX_DEFAULT)
            closemessage
            delay(20)
            addobject(DRILL)
            playse(SE_M_EARTHQUAKE)
            setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 1)
            setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 1)
            setvar(VAR_SHAKESCREEN_NUM_SHAKES, 1)
            setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 1)
            setflag(FLAG_DRILLED_LEFT_HOLE)
            setobjectxy(DRILL, 7, 10)

            applymovement(DRILL, DrillDozesLeft)
            setmetatile(7, 10, 0x39B, TRUE)
            special(DrawWholeMapView)
            special(ShakeScreen)
            delay(40)
            setmetatile(6, 10, 0x39B, TRUE)
            special(DrawWholeMapView)
            special(ShakeScreen)
            delay(40)
            setmetatile(5, 10, 0x39B, TRUE)
            special(DrawWholeMapView)
            special(ShakeScreen)
            delay(40)
            setobjectxy(DRILL, 0, 0)
        }
    }
    release
}



movement DrillDozesLeft {
    set_visible
    walk_in_place_fast_left * 4
    walk_fast_left
    walk_in_place_fast_left * 4
    walk_fast_left
    walk_in_place_fast_left * 4
}

script FushciaGym_MouseholesHeal_CloseLeftDoor {
    setmetatile(10, 13, 0x28C, FALSE)
    setmetatile(11, 13, 0x28C, FALSE)
    setmetatile(12, 13, 0x28C, FALSE)
    setmetatile(10, 14, 0x008, TRUE)
    setmetatile(11, 14, 0x008, TRUE)
    setmetatile(12, 14, 0x008, TRUE)
    return
}