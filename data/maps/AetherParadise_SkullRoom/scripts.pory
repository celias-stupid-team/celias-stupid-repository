mapscripts AetherParadise_SkullRoom_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if(!flag(FLAG_DMCA_SKUNTANK_FIGHT_COMPLETED)) {
            setflag(FLAG_TEMP_1)
        }
    }
}


script AetherParadise_Dad {
	lock
	faceplayer
	textcolor(0)
	msgbox(
	"DAD: {PLAYER}!\n"
	"What are you doing out here?\p"

	"I'd be careful. I think these\n"
	"SKULL guys are a bad influence.\l"
	"This room is a mess!\p"

	"Well, never mind that.\n"
	"Why don't you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}

script Aether_Painting {
	msgbox(
	"It looks like paint, but it's\n"
	"actually a picture of paint.", MSGBOX_SIGN)

}


script Aether_Paint {
	msgbox(
	"The wall has been intricately\n"
	"painted to resemble paint.", MSGBOX_SIGN)

}

script Aether_PaintO {
	msgbox(
	"They say graffiti is the voice of\n"
	"the unheard.\p"

	"In this case, the unheard are\n"
	"saying,{PAUSE 20} “O”.", MSGBOX_SIGN)
}

script Aether_BrokeOak {
	msgbox(
	"It's broke.\n"
	"", MSGBOX_SIGN)
}

script Aether_NotBrokeOak {
	msgbox(
	"That's not broke, silly!\n"
	"", MSGBOX_SIGN)
}

script Aether_Chair {
	msgbox(
	"The chair is set up to provide\n"
