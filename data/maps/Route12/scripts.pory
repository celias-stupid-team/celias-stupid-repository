script Route12_ShinyOmanyte {
	setflag(FLAG_SHINY_CREATION)
	call(Common_EventScript_StaticEncounter)
}

script Route12_Snorlax {
	lock
	if(!checkitem(ITEM_POKE_FLUTE)) {
		msgbox(Route12_Text_MonSprawledOutInSlumber)
		release
		end
	} else {
		goto_if_questlog(EventScript_ReleaseEnd)
		special(QuestLog_CutRecording)
		msgbox(Route12_Text_MonSprawledOutInSlumber)
		msgbox(Text_WantToUsePokeFlute, MSGBOX_YESNO)
		if(!var(VAR_RESULT)) {
			release
			end
		} else {
			setflag(FLAG_CSR_HIDE_OMANYTE)
			message(Text_PlayedPokeFlute)
			waitmessage
			playfanfare(MUS_POKE_FLUTE)
			waitfanfare
			closemessage
			delay(60)
			playse(SE_CLICK)
			call(Route12_DrawHall)
			special(DrawWholeMapView)
			setflag(FLAG_HALL_OF_ORIGIN_ACTIVE)
			setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 2)
			setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 2)
			setvar(VAR_SHAKESCREEN_NUM_SHAKES, 2)
			setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
			setmaplayoutindex(LAYOUT_ROUTE12_HALLOF_ORIGIN)
			special(DrawWholeMapView)
			special(ShakeScreen)
			delay(60)
			release
			end

		}
	}
}


const TRAPPED_FISHER = 1
script Route12_TrappedFisherLooksOver {
	lock
	playse(SE_PIN)
	setvar(VAR_CSR_TRAPPED_FISHER, 1)
	setobjectmovementtype(TRAPPED_FISHER, MOVEMENT_TYPE_FACE_RIGHT)
	applymovement(TRAPPED_FISHER, Common_Movement_FaceRight)
	waitmovement(0)
	applymovement(TRAPPED_FISHER, Common_Movement_ExclamationMark)
	waitmovement(0)
	release
}

script Route12_TrappedFisherTalksDown {
	lock
	textcolor(NPC_TEXT_COLOR_MALE)
	applymovement(TRAPPED_FISHER, Common_Movement_FaceDown)
	waitmovement(0)
	lock
	msgbox("Ahoy, there!\nUh, how's it going?\pSay, is there any chance you could\ncall for some help?\lI've been trapped here for weeks!", MSGBOX_DEFAULT)
	release
}
script Route12_TrappedFisherTalksRight {
	lock
	textcolor(NPC_TEXT_COLOR_MALE)
	applymovement(TRAPPED_FISHER, Common_Movement_FaceRight)
	waitmovement(0)
	lock
	msgbox("Ahoy, there!\nUh, how's it going?\pSay, is there any chance you could\ncall for some help?\lI've been trapped here for weeks!", MSGBOX_DEFAULT)
	release
}

script Route12_BalloonDad {
	lock
	faceplayer
	textcolor(0)
	msgbox("DAD: {PLAYER}!\nWhat are you doing out here?\pI was just enjoying a nice balloon\nride over the bay.\lThe air up here is lovely!\pWell, never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}

script Route12_GoingNorth {
	setflag(FLAG_CSR_ROUTE12_BROTHER_IS_CHASING)
	release
}

script Route12_GoingSouth {
	clearflag(FLAG_CSR_ROUTE12_BROTHER_IS_CHASING)
	release
}

script Route12_ConcernedSister {
	lock
	faceplayer
	if(flag(FLAG_CSR_ROUTE12_BROTHER_IS_CHASING)) {
		msgbox("Oh no!\nMy brother is attacking a GYARADOS!\lSomeone help it!", MSGBOX_DEFAULT)
	} else {
		msgbox("Oh no!\nA GYARADOS is attacking my brother!\lSomeone help him!", MSGBOX_DEFAULT)
	}
	closemessage
	applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
}

script Route12_Celia_Path {
	msgbox("For reasons that are so dumb and\nconvoluted that I couldn't even\lbegin to describe them here,\lthis path is 2 tiles shorter now.\pPlease don't ask why.\n", MSGBOX_NPC)
	end
} //Fucking Porytiles.

script Route12_Celia_Twins {
	msgbox("For those who don't know:\nThe twins are trying a credits warp.\pSadly, they have the items on their\nPokemon wrong, so it doesn't work.", MSGBOX_NPC)
	end
}

script Route12_Trailer_Camera {
	special(SpawnCameraObject)
	applymovement(OBJ_EVENT_ID_CAMERA, CameraGoesUp)
	waitmovement(0)
	applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
	waitmovement(0)
	release
}

movement CameraGoesUp {
	walk_up
	walk_up
}

script Route12_AwakeningShopSign {
	msgbox("ROUTE 12\nWAKE-UP SHOP\pFor all your Waking Up needs!\n", MSGBOX_SIGN)
	end
}