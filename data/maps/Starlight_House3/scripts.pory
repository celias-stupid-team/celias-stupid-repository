mapscripts Starlight_House3_MapScripts {
MAP_SCRIPT_ON_TRANSITION {
		if(flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
			setflag(FLAG_TEMP_2)
            setflag(FLAG_TEMP_8)
        }
            if(flag(FLAG_DAK_HERE)) {
			setflag(FLAG_TEMP_2)
		}
        if(!flag(FLAG_DAK_HERE)) {
            setflag(FLAG_TEMP_8)
		}
        if(flag(FLAG_CSR_CELIA_BONUS)) {
			setflag(FLAG_TEMP_8)
		}
        //if(!checktrainerflag(TRAINER_STARLIGHT)) {
        //    setflag(FLAG_TEMP_15)
        //}
        //if(!checktrainerflag(TRAINER_WIZ1989)) {
        //    setflag(FLAG_TEMP_16)
        //}
        //if(!checktrainerflag(TRAINER_PLASTO)) {
        //    setflag(FLAG_TEMP_17)
        //}
        //if(!checktrainerflag(TRAINER_LICHEN)) {
        //    setflag(FLAG_TEMP_18)
        //}
        //if(!checktrainerflag(TRAINER_HAKARI_BLIZ)) {
        //    setflag(FLAG_TEMP_19)
        //}
        if(flag(FLAG_HIDE_BONUS_STARLIGHTS) || !flag(FLAG_POST_GAME)) {
			setflag(FLAG_TEMP_3)
        }
        if(flag(FLAG_POST_GAME)) {
        }
        setvar(VAR_TEMP_7, 20)
		
	}
MAP_SCRIPT_ON_LOAD {        
        if(flag(FLAG_POST_GAME) && !flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
        setlayouttiles(
				LAYOUT_STARLIGHT_HOUSE3_LAYOUT_2, 
				0,	// startingX
				0,	// startingY 
				13,	// x1 
				0,	// y1
				16, // x2
				4) // y2
        }
        if(flag(FLAG_POST_GAME)) {
        setlayouttiles(
				LAYOUT_STARLIGHT_HOUSE3_LAYOUT_2, 
				0,	// startingX
				0,	// startingY 
				13,	// x1 
				5,	// y1
				16, // x2
				7) // y2
        }
    }
}

script Starlight_House3_Dak {
    lock
	faceplayer
    textcolor(NPC_TEXT_COLOR_BLUE)
    msgbox(
	"Oh hey!...\n"
    "\l"
    "Listen, I am not a Dev...\l"

	"Pretend I am not here okay?", MSGBOX_NPC)

    //player
    textcolor(NPC_TEXT_COLOR_FEMALE)
    msgbox(
    "Hey DAK!", MSGBOX_DEFAULT)
    closemessage

    playse(SE_PIN)
    applymovement(LOCALID_DAK, moves(
        emote_exclamation_mark
        face_right
    ))
    //waitmovement(LOCALID_DAK)
    //waitmovement(0)
    
    //delay(10)
    addobject(LOCALID_STARLIGHT2)
    applymovement(LOCALID_STARLIGHT2, moves(
        set_visible
        walk_fast_down * 2
        walk_left * 8
    ))
    waitmovement(LOCALID_STARLIGHT2)
    waitmovement(0)

    applymovement(LOCALID_PLAYER, moves(
        face_right
    ))
    waitmovement(LOCALID_PLAYER)
    waitmovement(0)

    msgbox(
	"Why are you using my work computer?", MSGBOX_DEFAULT)
    textcolor(NPC_TEXT_COLOR_BLUE)
    closemessage
    delay(30)
    msgbox(
	"Um...\n"
    "\l"
    "...\l"
    "Important work stuff?", MSGBOX_DEFAULT)
    closemessage
    delay(60)
    //setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 3)
    //setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 3)
    //setvar(VAR_SHAKESCREEN_NUM_SHAKES, 6)
    //setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
    //special(ShakeScreen)
	//delay(60)

    switch(var(VAR_TEMP_A)) {
			case 1:
					applymovement(LOCALID_PLAYER, moves(face_right))
					//waitmovement(0)
					//break
			case 2:
					applymovement(LOCALID_PLAYER, moves(face_left))
					//waitmovement(0)
					//break
            case 3:
                    applymovement(LOCALID_PLAYER, moves(face_up))
                    //waitmovement(0)
                    //break
		}
    waitmovement(0)

    playse(SE_CLICK)
    setmetatile(1, 3, 0x2A6, FALSE)
    special(DrawWholeMapView)

    

    applymovement(LOCALID_DAK, moves(
        walk_in_place_faster_right * 10
        delay_16 * 4
        delay_16 * 4
        
    ))
    delay(30)
    playse(SE_FALL)
    //applymovement(LOCALID_DAK, slide_down)
    removeobject(LOCALID_DAK)
    delay(90)
    playse(SE_WALL_HIT)
    setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 3)
    setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 3)
    setvar(VAR_SHAKESCREEN_NUM_SHAKES, 6)
    setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
	special(ShakeScreen)
    delay(90)
    playse(SE_CLICK)
    setmetatile(1, 3, 0x2EB, FALSE)
    special(DrawWholeMapView)
    delay(30)
    
    applymovement(LOCALID_PLAYER, moves(
        face_right
    ))
    waitmovement(LOCALID_PLAYER)
    waitmovement(0)

    textcolor(NPC_TEXT_COLOR_RED)
    msgbox(
	"Sorry about that, I'm feeling\n"
	"a tiny bit jaded at the moment, and\l"
	"he likes to mess with my stuff.\p"

	"Don't worry, he'll be fine!\p"

	"I made sure he'd end up in a nice,\n"
	"fun map.", MSGBOX_NPC)
    closemessage
    applymovement(LOCALID_STARLIGHT2, moves(
    walk_right * 8
    ))
    waitmovement(LOCALID_STARLIGHT2)
    removeobject(LOCALID_STARLIGHT2)
    setflag(FLAG_DAK_HERE)
    setflag(FLAG_TEMP_1)
    //playse(SE_LEDGE)
    release
}

