script StarlightHouse3_NotSoFunFactsMenu {
	lock
    
    msgbox(
                    "Starlight's Journal.", MSGBOX_DEFAULT)
                    closemessage
    setvar(VAR_RESULT, 0)
	//closemessage
	dynmultichoice(2, 1, FALSE, 11, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
                "Fun Fact 1 (Pkmn Island)",
                "Fun Fact 2 (House Limits)",
                "Fun Fact 3 (Aether Hi)",
				"Fun Fact 4 (Sky Tower)",
                "Fun Fact 5 (Morph Rock)",
                "Fun Fact 6 (Seafoam Puzzle)",
                "Fun Fact 7 (Four Island)",
                "Fun Fact 8 (FirstLast Maps)",
                "Fun Fact 9 (Thirty Eight)",
                "Fun Fact 10 (Pit Room)",
                "Fun Fact 11 (House Guests)",)

	closemessage
	call(StarlightHouse3_NotSoFunFactsOptions)	
	release
}


script StarlightHouse3_NotSoFunFactsOptions {
			switch(var(VAR_RESULT)) {
				case 0:
					if(flag(FLAG_CSR_MAP_POKEMON_ISLAND)) {
                    msgbox(
                    "I hid 2 Porygon within the tiles of\n"
                    "Pokemon Island, similarly to how\l"
                    "they were hidden in the Pokemon\l"
                    "Snap game.\p"

                    "They are still there if you want to\n"
                    "look for them. It was the original\l"
                    "shiny method but we since changed\l"
                    "that. Now they just chill there.", MSGBOX_DEFAULT)
                    closemessage
                    } else {
                    msgbox(
                    "You have not discovered or\n"
                    "unlocked this part of the game yet.", MSGBOX_DEFAULT)
                    closemessage
                    }
				case 1:
                    msgbox(
                    "Celia gave me full control over\n"
                    "what happens in my house.\p"

                    "But since she wanted this house to\n"
                    "only have bonus content and not add\l"
                    "anything to the rest of the game,\l"
                    "I was fairly limited with what I\l"
                    "could do.\p"

                    "I had to come up with fun ideas\n"
                    "without using any permament flags,\l"
                    "using any special items or items\l"
                    "that aren't common, and same goes\l"
                    "with pokemon too.\p"

                    "It was a little challenging but I\n"
                    "am proud of what I could come up\l"
                    "with for this house.", MSGBOX_DEFAULT)
                    closemessage
                    
				case 2:
                    msgbox(
                    "Did you know? Northwest of the cave\n"
                    "entrance to Mt. Moon in Aether\l"
                    "(to the left of my house), I drew\l"
                    "in the out of bounds cliff area\l"
                    "“HI :)”.", MSGBOX_DEFAULT)
                    closemessage
                case 3:
					if(flag(FLAG_CSR_MAP_YES)) {
                    msgbox(
                    "When I was recruited to make the\n"
                    "Great Sea, as soon as I got access\l"
                    "to the files, the first thing I did\l"
                    "was make that overly tall Sky Tower\l"
                    "cover everything because I was\l"
                    "screwing around and it was funny\l"
                    "lol, so we kept it.", MSGBOX_DEFAULT)
                    closemessage
                    } else {
                    msgbox(
                    "You have not discovered or\n"
                    "unlocked this part of the game yet.", MSGBOX_DEFAULT)
                    closemessage
                    }
                case 4:
					if(flag(FLAG_WORLD_MAP_PIRATE_BAY)) {
                    msgbox(
                    "Did you know? That rock formation\n"
                    "between Sky Tower and southern\l"
                    "Pirate Bay has different shapes\l"
                    "based on what side you are looking\l"
                    "at it from?\p"

                    "This was because the bike path map\n"
                    "is actually longer than the maps\l"
                    "to the left and right and is a bit\l"
                    "screwy with how it works, so I\l"
                    "got creative and designed it to\l"
                    "work no matter where the maps are\l"
                    "alligned with the bike path map.", MSGBOX_DEFAULT)
                    closemessage
                    } else {
                    msgbox(
                    "You have not discovered or\n"
                    "unlocked this part of the game yet.", MSGBOX_DEFAULT)
                    closemessage
                    }
                case 5:
					if(flag(FLAG_CAPTAIN_DIRECTS_SPHEALS)) {
                    msgbox(
                    "The Seafoam strength puzzle was\n"
                    "the only puzzle contribution I got\l"
                    "to do for CSR! Celia gave me an\l"
                    "opportunity to practice my puzzle\l"
                    "making skills for the first time.\p"

                    "It was fun but there was a puzzle\n"
                    "I was more proud of that I made\l"
                    "prior to the current one we ended\l"
                    "up scrapping because we couldn't\l"
                    "get the physics to work with my\l"
                    "puzzle design. I had the older one\l"
                    "designed as if the boulders would\l"
                    "keep sliding on the ice without you\l"
                    "coming along with it.\p"

                    "Oh well, it was a fun experience\n"
                    "with both puzzles I made!", MSGBOX_DEFAULT)
                    closemessage
                    } else {
                    msgbox(
                    "You have not discovered or\n"
                    "unlocked this part of the game yet.", MSGBOX_DEFAULT)
                    closemessage
                    }
                case 6:
					if(flag(FLAG_WORLD_MAP_FOUR_ISLAND)) {
                    msgbox(
                    "Did you know? On Four Island, the\n"
                    "two upper areas with the honey tree\l"
                    "and the daycare were originally\l"
                    "swapped to be on the other side.\p"

                    "Celia felt the pacing wouldn't be\n"
                    "as effective. It was something I\l"
                    "thought was interesting during the\l"
                    "design process to share about.", MSGBOX_DEFAULT)
                    closemessage
                    } else {
                    msgbox(
                    "You have not discovered or\n"
                    "unlocked this part of the game yet.", MSGBOX_DEFAULT)
                    closemessage
                    }
                case 7:
					if(flag(FLAG_MIRAGE_ISLAND_APPEARS)) {
                    msgbox(
                    "The first map I made was Pokemon\n"
                    "Park from Johto.\p"

                    "The last map I made was Faraway\n"
                    "Island.\p"

                    "Both ironically were just\n"
                    "recreations of vanilla game maps.", MSGBOX_DEFAULT)
                    closemessage
                    } else {
                    msgbox(
                    "You have not discovered or\n"
                    "unlocked this part of the game yet.", MSGBOX_DEFAULT)
                    closemessage
                    }
                case 8:
					if(flag(FLAG_CSR_MAP_THIRTY_EIGHT_ISLAND)) {
                    msgbox(
                    "Thirty Eight Island used to be an\n"
                    "exact replica of Route 38 with\l"
                    "Island drawn around it.\p"

                    "Since then it's been shrunk down\n"
                    "twice to not take so much space\l"
                    "in the Great Sea.", MSGBOX_DEFAULT)
                    closemessage
                    } else {
                    msgbox(
                    "You have not discovered or\n"
                    "unlocked this part of the game yet.", MSGBOX_DEFAULT)
                    closemessage
                    }
                case 9:
                    msgbox(
                    "The Pit Room in my house was\n"
                    "actually a reference to how I was\l"
                    "always forgetting to do the map\l"
                    "collision when making the maps.\p"

                    "Personally I just liked designing\n"
                    "them and then worry about\l"
                    "collision afterwards.", MSGBOX_DEFAULT)
                    closemessage
                case 10:
					if(flag(FLAG_POST_GAME)) {
                    msgbox(
                    "Dak my irl friend, Bri (short for\n"
                    "Brianna) my sister, Kamina my\l"
                    "online friend and atinybitjaded\l"
                    "my other online friend were all\l"
                    "close family or friends of mine\l"
                    "I wanted to reference in here.\p"

                    "I only added them because I needed\n"
                    "NPCs or phrases for some bits I\l"
                    "wanted to use.\p"
                    
                    "Every single one of them was added\n"
                    "with a purpose.", MSGBOX_DEFAULT)
                    closemessage
                    } else {
                    msgbox(
                    "You have not discovered or\n"
                    "unlocked this part of the game yet.\p"
                    "Unlocked during post game.", MSGBOX_DEFAULT)
                    closemessage
                    }
				default:
					setvar(VAR_RESULT, 0)
                    call(StarlightHouse3_NotSoFunFactsOptions)
					release
					end
	}
}

script Starlight_House3_Secret_Plant {
	msgbox(
	"Of all places, do you really think\n"
	"OAK would be here?", MSGBOX_SIGN)

}

script Starlight_House3_Secret_Fire {
	msgbox(
	"In the fire you see a bed of coals.\p"

	"Stick your hand in?", MSGBOX_YESNO)
    if(var(VAR_RESULT)) {
        closemessage
        playse(SE_M_FLAME_WHEEL2)
        delay(50)
                msgbox(
                "Mmmm...\n"
                "Smells like you!", MSGBOX_SIGN)
			closemessage
	} else {
		closemessage
	}
    
    

}

script Starlight_House3_Secret_Mug {
	lock
    delay(30)
    playse(SE_CLICK)
    applymovement(LOCALID_STAR_MUGGER, moves(
        walk_fastest_left * 2  
        set_visible      
    ))
    delay(30)
    msgbox(
	"You just got MUGGED!", MSGBOX_DEFAULT)
    closemessage
    delay(30)
    playse(SE_CLICK)
    applymovement(LOCALID_STAR_MUGGER, moves(
        set_invisible
        walk_fastest_right * 2               
    ))
    waitmovement(0)
    release
    end
}

