    if(flag(FLAG_TEMP_1)) {
    textcolor(NPC_TEXT_COLOR_NEUTRAL)
    msgbox(
	"It shows a few tabs open.\p"
	"One tab is an AVGN video.\n"
	"Another is Dak's YouTube Page,\l"
	"Third tab is...\l"
    ""
	"A Google search of: What do\n"
	"I do if I burn my cereal?", MSGBOX_SIGN)
    } else {
            msgbox(
	"There are some tabs open.\n"
	"It's showing something called por-\l"
	"ymaps and Poryscript.", MSGBOX_SIGN)
     
	        }

    
}

script Starlight_House3_Computer_Special {
