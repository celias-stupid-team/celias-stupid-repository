script Starlight_House3_Become_Godzilla {
	setflag(FLAG_TEMP_7)
	release
}

script Starlight_House3_No_Longer_Godzilla {
	clearflag(FLAG_TEMP_7)
	release
}

script Starlight_House3_Table_On_Or_Off_Check {
	lock
    getplayerxy(VAR_TEMP_5, VAR_TEMP_6)
            if(var(VAR_TEMP_6) == 9 && var(VAR_TEMP_5) == 2) {
                msgbox(
                    "A table containing the map of the\n"
                    "entire region.", MSGBOX_SIGN)
                release
                end
            } else {
                msgbox(
                    "You hear tiny voices scream out\n"
                    "“OH NO, RUN! IT'S GODZILLA!!!”", MSGBOX_SIGN)
                    setflag(FLAG_TEMP_13)

                release
                end
            }
}

script Starlight_House3_Map_Table_Edge {
	if(flag(FLAG_TEMP_7)) {
        msgbox(
        "You hear tiny voices scream out\n"
        "“OH NO, RUN! IT'S GODZILLA!!!”", MSGBOX_SIGN)
        setflag(FLAG_TEMP_13)
        } else {
        msgbox(
        "A table of the entire region\n"
        "showing future work plans.", MSGBOX_SIGN)
    }
}

script Starlight_House3_Map_Table_Edge_Bit_Hi {
    
    if(flag(FLAG_TEMP_13) && flag(FLAG_TEMP_7)) {
        msgbox(
        "You hear tiny voices scream out\n"
        "“OH, HI GODZILLA!!!”", MSGBOX_SIGN)
        }
    if(flag(FLAG_TEMP_7) && !flag(FLAG_TEMP_13)) {
        msgbox(
        "HI!!!", MSGBOX_SIGN)
    
        } 
    if(!flag(FLAG_TEMP_7) && !flag(FLAG_TEMP_13)) {
        msgbox(
        "A table of the entire region\n"
        "showing future work plans.", MSGBOX_SIGN)
        }
    if(!flag(FLAG_TEMP_7) && flag(FLAG_TEMP_13)) {
        msgbox(
        "A table of the entire region\n"
        "showing future work plans.", MSGBOX_SIGN)
        }
}

script Starlight_House3_Map_Table_Bit_Lass {
	if(flag(FLAG_TEMP_13) && !flag(FLAG_TEMP_9)) {
        lockall
		msgbox(
        "You hear tiny voices scream out\n"
        "“OH NO, LOOK! IT'S GO-”", MSGBOX_SIGN)
		closemessage
		//delay(10)
		//msgbox("...", MSGBOX_DEFAULT)
		//closemessage
		fadeoutbgm(1)
		msgbox("Wait...", MSGBOX_DEFAULT)
		closemessage
		delay(10)
        playbgm(MUS_TINY_LASS, FALSE)
		textcolor(NPC_TEXT_COLOR_FEMALE)
		msgbox("{FONT_SMALL}Hey! Did you just look at me?!", MSGBOX_DEFAULT)
		closemessage
		//delay(20)
		delay(150)
        playbgm(MUS_NONE, FALSE)
        playse(SE_MUD_BALL)
        delay(60)
        textcolor(NPC_TEXT_COLOR_NEUTRAL)
		msgbox(
            "...\n"
            "\l"
