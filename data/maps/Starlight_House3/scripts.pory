script Starlight_House3_Rematch {
    lock
	faceplayer
    textcolor(NPC_TEXT_COLOR_FEMALE)
    msgbox("STARLIGHT: Hi! I am here if you\n"
	"ever want a rematch.\p"

	"Would you like to battle me again?", MSGBOX_YESNO)
		closemessage
		if(var(VAR_RESULT)) {
			cleartrainerflag(TRAINER_STARLIGHT)
    textcolor(NPC_TEXT_COLOR_FEMALE)
    trainerbattle_single(TRAINER_STARLIGHT,
	"Yay!",
	//
	"Another fun battle!")
		}
    release
    end
}

