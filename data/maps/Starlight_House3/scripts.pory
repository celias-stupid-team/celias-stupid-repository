script Starlight_House3_PMD_Star_Character {
	lock
    faceplayer
    playmoncry(SPECIES_GARDEVOIR, CRY_MODE_DEFAULT)
    msgbox(
	"...!", MSGBOX_NPC)
    delay(30)
    playse(SE_M_TELEPORT)
    fadescreeninstant(FADE_TO_WHITE)
    removeobject(LOCALID_PMD_STAR_OBJECT)
    setflag(FLAG_TEMP_3)
    fadescreenswapbuffers(FADE_FROM_WHITE)
    release
    end
}

script Starlight_House3_Table_On_Or_Off_Check {
	lock
    getplayerxy(VAR_TEMP_5, VAR_TEMP_6)
            if(var(VAR_TEMP_6) == 9 && var(VAR_TEMP_5) == 2) {
                msgbox(
                    "A table containing the map of the\n"
                    "entire region.", MSGBOX_SIGN)
                release
                end
            } else {
                msgbox(
                    "You hear tiny voices scream out\n"
                    "“IT'S GODZILLA!!!”", MSGBOX_SIGN)

                release
                end
            }
}

script Starlight_House3_Hi_Table {
    msgbox(
	"HI", MSGBOX_SIGN)
}

script Starlight_House3_Tiny_Lass {
	lockall
		msgbox(
	"You hear tiny voices scream out\n"
	"“IT'S GO-", MSGBOX_SIGN)
		closemessage
		delay(10)
		msgbox("...", MSGBOX_DEFAULT)
		closemessage
		fadeoutbgm(1)
		msgbox("Wait...", MSGBOX_DEFAULT)
		closemessage
		delay(20)
        playbgm(MUS_TINY_LASS, FALSE)
		textcolor(NPC_TEXT_COLOR_FEMALE)
		msgbox("{FONT_SMALL}Hey! Did you just look at me?!", MSGBOX_DEFAULT)
		closemessage
		//delay(20)
		delay(180)
        playbgm(MUS_NONE, FALSE)
        playse(SE_MUD_BALL)
        delay(90)
        textcolor(NPC_TEXT_COLOR_NEUTRAL)
		msgbox(
            "...\n"
            "\l"
            "You accidentally stepped on her...", MSGBOX_SIGN)
            delay(60)
		playbgm(MUS_DOWNSTREAM, TRUE)
        setflag(FLAG_TEMP_9)
		release
		end
	}

