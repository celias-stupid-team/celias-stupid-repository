script Starlight_House3_PMD_Star_Character {
	lock
    faceplayer
    playmoncry(SPECIES_GARDEVOIR, CRY_MODE_DEFAULT)
    msgbox(
	"...!", MSGBOX_NPC)
    closemessage
    delay(30)
    playse(SE_M_TELEPORT)
    fadescreeninstant(FADE_TO_WHITE)
    removeobject(LOCALID_PMD_STAR_OBJECT)
    setflag(FLAG_TEMP_3)
    fadescreenswapbuffers(FADE_FROM_WHITE)
    release
    end
}

