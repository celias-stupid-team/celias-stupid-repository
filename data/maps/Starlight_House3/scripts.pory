script Starlight_House3_Map_Table_Bit_Look_Look {
	lock
    if(var(VAR_TEMP_7) <= 16) {
        msgbox(
        "TRAINER TIPS!\p"

        "She has moved far enough to not be\n"
        "on this tile.", MSGBOX_SIGN)
    }
    if(var(VAR_TEMP_7) >= 24) {
        msgbox(
        "TRAINER TIPS!\p"

        "She is now stuck in the trees.", MSGBOX_SIGN)
    }
    if(var(VAR_TEMP_7) >= 17 && var(VAR_TEMP_7) <= 23) {
        msgbox(format("Hmm...\nIs that right..."), MSGBOX_DEFAULT)
        //delay(5)
        playse(SE_PIN)
        //delay(5)
        delay(48)
        msgbox(format("Oh!\nLook, look!"), MSGBOX_DEFAULT)
        closemessage
    }
    getplayerxy(VAR_TEMP_6, VAR_TEMP_5)
    if(var(VAR_TEMP_6) >= 4) {           
        subvar(VAR_TEMP_7, 1)
    }
    if(var(VAR_TEMP_6) <= 3) {
        if(!flag(FLAG_TEMP_1D)) {
        addvar(VAR_TEMP_7, 1)
        }
    }    
    if(var(VAR_TEMP_7) == 16) {
    setmetatile(4, 7, 0x2B9, FALSE)
    setmetatile(3, 7, 0x2B8, TRUE)
    //setflag(FLAG_TEMP_1C)  
    }
    if(var(VAR_TEMP_7) == 24) {
    setmetatile(4, 7, 0x2B9, FALSE)
    }
    release
    end
}

