	"streamer {COLOR DYNAMIC_COLOR6}pHurdles", MSGBOX_DEFAULT)
                    setflag(FLAG_TEMP_6)
                }
	        }
        }
    }   
    
        if(flag(FLAG_TEMP_4)) {
        random(3)
            switch(var(VAR_RESULT)) {
                case 0:
                textcolor(NPC_TEXT_COLOR_NEUTRAL)
                    msgbox(
	"...\p"
    "Let's close that tab.", MSGBOX_SIGN)
                case 1:
                textcolor(NPC_TEXT_COLOR_NEUTRAL)
                    msgbox(
	"...\p"
    "How silly!", MSGBOX_SIGN)
                case 2:
                textcolor(NPC_TEXT_COLOR_NEUTRAL)
                    msgbox(
	"They were better in their early\n"
	"days…", MSGBOX_NPC)
           
           
            } 

    } else {

        textcolor(NPC_TEXT_COLOR_NEUTRAL)
        msgbox(
	"...\p"
    "Let's close that tab.", MSGBOX_SIGN)
            
        }
                    
        release
        end
}



