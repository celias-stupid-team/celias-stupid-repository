mapscripts Starlight_House3_MapScripts {
MAP_SCRIPT_ON_TRANSITION {
		if(flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
			setflag(FLAG_TEMP_2)
            setflag(FLAG_TEMP_8)
        }
            if(flag(FLAG_DAK_HERE)) {
			setflag(FLAG_TEMP_2)
		}
        if(!flag(FLAG_DAK_HERE)) {
            setflag(FLAG_TEMP_8)
		}
        if(flag(FLAG_CSR_CELIA_BONUS)) {
			setflag(FLAG_TEMP_8)
		}
        setflag(FLAG_TEMP_8)//temporary until commentary is finished
		
	}
}
script Starlight_House3_Map_Table {
	msgbox(
	"A table containing the map of the\n"
	"entire region.\p"
	"Seems to be used for planning out\n"
    "the region layout.", MSGBOX_SIGN)

}

script Starlight_House3_Dak {
    lock
	faceplayer
    textcolor(NPC_TEXT_COLOR_BLUE)
    msgbox(
	"Oh hi!\p"

	"Pretend I am not here okay?", MSGBOX_NPC)
    
    //playbgm(MUS_NONE, TRUE)
    applymovement(LOCALID_DAK, moves(
        emote_exclamation_mark
        face_right
    ))
    textcolor(NPC_TEXT_COLOR_RED)
    msgbox(
    "Hey Dak!", MSGBOX_DEFAULT)
    closemessage
    
    delay(10)
    addobject(LOCALID_STARLIGHT2)
    applymovement(LOCALID_STARLIGHT2, moves(
        set_visible
        walk_fast_down * 2
        walk_left * 8
    ))
    waitmovement(LOCALID_STARLIGHT2)
    //applymovement(LOCALID_PLAYER, moves(
    //    face_right
    //))

//textcolor(NPC_TEXT_COLOR_RED)
msgbox(
	"Why are you using my work computer?", MSGBOX_DEFAULT)
    textcolor(NPC_TEXT_COLOR_BLUE)
    closemessage
    delay(30)
    msgbox(
	"Um...\p"
    "Important work stuff?", MSGBOX_DEFAULT)
    closemessage
    delay(60)
    //setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 3)
    //setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 3)
    //setvar(VAR_SHAKESCREEN_NUM_SHAKES, 6)
    //setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
    //special(ShakeScreen)
	//delay(60)
    playse(SE_CLICK)
    setmetatile(1, 2, 0x2A6, FALSE)
    special(DrawWholeMapView)

    //applymovement(LOCALID_PLAYER, moves(//moves(
    //    face_left
    //))

    applymovement(LOCALID_DAK, moves(
        walk_in_place_faster_right * 10
        delay_16 * 4
        delay_16 * 4
        
    ))
    delay(30)
    playse(SE_FALL)
    //applymovement(LOCALID_DAK, slide_down)
    removeobject(LOCALID_DAK)
    delay(90)
    playse(SE_WALL_HIT)
    setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 3)
    setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 3)
    setvar(VAR_SHAKESCREEN_NUM_SHAKES, 6)
    setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
	special(ShakeScreen)
    delay(90)
    playse(SE_CLICK)
    setmetatile(1, 2, 0x2EB, FALSE)
    special(DrawWholeMapView)
    delay(30)
    
    //waitmovement(LOCALID_DAK)

    //applymovement(LOCALID_PLAYER, face_right)
    //applymovement(LOCALID_PLAYER, moves(
    //    face_right
    //))
    //applymovement(LOCALID_PLAYER, moves(
    //    face_right
    //))

    textcolor(NPC_TEXT_COLOR_RED)
    msgbox(
	"Sorry about that, Dak is my friend.\p"
    "He likes to mess with my stuff\n"
    "from time to time.\p"
    "Don't worry he will be fine!\p"
    "I made sure he would go to\n" 
    "a nice fun map!", MSGBOX_NPC)
    closemessage
    applymovement(LOCALID_STARLIGHT2, moves(
    walk_right * 8
    ))
    waitmovement(LOCALID_STARLIGHT2)
    removeobject(LOCALID_STARLIGHT2)
    setflag(FLAG_DAK_HERE)
    setflag(FLAG_TEMP_1)
    //playse(SE_LEDGE)
    release
}

