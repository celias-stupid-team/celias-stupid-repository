script Starlight_House3_Rematch {
    lock
	faceplayer
    textcolor(NPC_TEXT_COLOR_FEMALE)
    msgbox("STARLIGHT: Hi! I am here if you\n"
	"ever want a rematch.\p"

	"Would you like to battle me again?", MSGBOX_YESNO)
		closemessage
		if(var(VAR_RESULT)) {
			cleartrainerflag(TRAINER_STARLIGHT)
    textcolor(NPC_TEXT_COLOR_FEMALE)
    trainerbattle_single(TRAINER_STARLIGHT,
	"Yay!",
	//
	"Feel free to kick my ass anytime!")
		}
    release
    end
}

script Starlight_House3_Team_Hack_Event {
	if(flag(FLAG_POST_GAME)) {
    msgbox(
	"There's some paper containing a\n"
	"schedule for PMD Team Hack Event.\p"
	"There's also something scratched out\n"
	"at the bottom.\p"
	"-r---c- -vr-n\p"
	"...\n"
	"\l"
	"Probably unrelated to this hack.", MSGBOX_SIGN)
    } else {
        msgbox(
	"The My Secret Life books are\n"
	"suspiciously missing.", MSGBOX_SIGN)
    }

}

script Starlight_House3_PMD_Star_Character {
	lock
    faceplayer
    playmoncry(SPECIES_GARDEVOIR, CRY_MODE_DEFAULT)
    msgbox(
	"...!", MSGBOX_NPC)
    delay(30)
    playse(SE_M_TELEPORT)
    fadescreeninstant(FADE_TO_WHITE)
    removeobject(LOCALID_PMD_STAR_OBJECT)
    setflag(FLAG_TEMP_3)
    fadescreenswapbuffers(FADE_FROM_WHITE)
    release
    end
}