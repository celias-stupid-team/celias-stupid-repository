script Starlight_House3_Map_Table_Bit_Grandpas_Dead {
	if(flag(FLAG_TEMP_13) && !flag(FLAG_TEMP_1B) && !flag(FLAG_TEMP_1C)) {
        delay(20)
        playbgm(MUS_NONE, FALSE)
        playse(SE_MUD_BALL)
        delay(60)
        msgbox(
        "You hear tiny voices scream out\n"
        "“OH NO, GRANDPA'S DEAD!!!”", MSGBOX_SIGN)
        delay(60)
		playbgm(MUS_DOWNSTREAM, TRUE)
        setflag(FLAG_TEMP_1B)
        }
    if(flag(FLAG_TEMP_13) && flag(FLAG_TEMP_1B) && !flag(FLAG_TEMP_1C)) {   
        msgbox(
        "Something is stuck on your shoe.\p"

	    "Wipe it off across the floor?", MSGBOX_YESNO)
        if(var(VAR_RESULT)) {
            msgbox(
            "You hear tiny voices scream out\n"
            "“OH NO, GRANDPA'S SPREAD!!!”", MSGBOX_SIGN)
			closemessage
        }
        setflag(FLAG_TEMP_1C)
    } else {
        msgbox(
        "You hear tiny voices scream out\n"
        "“OH NO, RUN! IT'S GODZILLA!!!”", MSGBOX_SIGN)
        setflag(FLAG_TEMP_13)
    }
}

