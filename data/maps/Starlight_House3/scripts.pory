script Starlight_House3_Plant3 {
    lock
    msgbox(
	"Why would Oak be here?", MSGBOX_SIGN)
    clearflag(FLAG_TEMP_10)
    clearflag(FLAG_TEMP_11)
    clearflag(FLAG_TEMP_12)
    setvar(VAR_TEMP_1, 0)
    setvar(VAR_TEMP_2, 0)
    setvar(VAR_TEMP_3, 0)
    setvar(VAR_TEMP_0, 0)
    release
}

