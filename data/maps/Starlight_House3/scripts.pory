script Starlight_House3_Wall_Map {
	lock
    msgbox(
	"The table had a baby!", MSGBOX_DEFAULT)

    setmetatile(6, 1, 0x2F0, FALSE)
	setmetatile(7, 1, 0x2F1, FALSE)
    special(DrawWholeMapView)

    msgbox(
	"Wait! No!\n"
	"This baby is a demon child!", MSGBOX_DEFAULT)
    release
    end
}

script Starlight_House3_PlantA {
    if(flag(FLAG_TEMP_10)) {
        are_vars_equal(VAR_TEMP_1, VAR_LAST_TALKED)
        if(var(VAR_RESULT)) {
            goto(Starlight_House3_Plant1)
        }
        are_vars_equal(VAR_TEMP_2, VAR_LAST_TALKED)
        if(var(VAR_RESULT)) {
            goto(Starlight_House3_Plant2)
        }
        are_vars_equal(VAR_TEMP_3, VAR_LAST_TALKED)
        if(var(VAR_RESULT)) {
            goto(Starlight_House3_Plant3)
        }

    } else {
        setflag(FLAG_TEMP_10)
        addvar(VAR_TEMP_0, 1)
        switch(var(VAR_TEMP_0)) {
            case 1:
                copyvar(VAR_TEMP_1, VAR_LAST_TALKED)
                goto(Starlight_House3_Plant1)
            case 2:
                copyvar(VAR_TEMP_2, VAR_LAST_TALKED)
                goto(Starlight_House3_Plant2)
            case 3:
                copyvar(VAR_TEMP_3, VAR_LAST_TALKED)
                goto(Starlight_House3_Plant3)
        }
    }


}

