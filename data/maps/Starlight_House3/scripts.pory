                    textcolor(NPC_TEXT_COLOR_NEUTRAL)
                    msgbox(
                    "It's a video of that famous Twitch\n"
	"streamer {COLOR DYNAMIC_COLOR6}TinyTermite.", MSGBOX_DEFAULT)
                setflag(FLAG_TEMP_6)
                case 1:
                    textcolor(NPC_TEXT_COLOR_NEUTRAL)
                    msgbox(
                    "It's a video of that famous Twitch\n"
	"streamer {COLOR DYNAMIC_COLOR6}SalamenceHG.", MSGBOX_DEFAULT)
                setflag(FLAG_TEMP_6)
                case 2:
                    textcolor(NPC_TEXT_COLOR_NEUTRAL)
                    msgbox(
                    "It's a video of that famous Twitch\n"
	"streamer {COLOR DYNAMIC_COLOR6}ScrumptiousJimmy.", MSGBOX_DEFAULT)
                setflag(FLAG_TEMP_6)
                case 3:
                    textcolor(NPC_TEXT_COLOR_NEUTRAL)
                    msgbox(
