                "She fell off the table...", MSGBOX_SIGN)
        }
        if(var(VAR_TEMP_7) == 12) {
                msgbox(format("Hmm...\nIs that right..."), MSGBOX_DEFAULT)
                //delay(5)
                playse(SE_PIN)
                //delay(5)
                delay(48)
                msgbox(format("Oh!\nLook, look!"), MSGBOX_DEFAULT)
                closemessage        
                delay(30)
                playbgm(MUS_NONE, FALSE)
                playse(SE_WALL_HIT)
                setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 3)
                setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 3)
                setvar(VAR_SHAKESCREEN_NUM_SHAKES, 6)
                setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
                special(ShakeScreen)
                subvar(VAR_TEMP_7, 1)
                setmetatile(3, 7, 0x2B8, FALSE)
                delay(60)
                playbgm(MUS_DOWNSTREAM, TRUE)
                setflag(FLAG_TEMP_1D)
        }
        if(var(VAR_TEMP_7) >= 13 && var(VAR_TEMP_7) <= 16) {
            //if(var(VAR_TEMP_7) >= 17 && var(VAR_TEMP_7) <= 23) {
                msgbox(format("Hmm...\nIs that right..."), MSGBOX_DEFAULT)
                //delay(5)
                playse(SE_PIN)
                //delay(5)
                delay(48)
                msgbox(format("Oh!\nLook, look!"), MSGBOX_DEFAULT)
                closemessage        
                subvar(VAR_TEMP_7, 1)
                
            //}
            if(var(VAR_TEMP_7) == 11) {
            setmetatile(3, 7, 0x2B8, FALSE)
            }
        }
        if(var(VAR_TEMP_7) >= 17) {
                msgbox(
        "You hear tiny voices scream out\n"
        "“OH NO, RUN! IT'S GODZILLA!!!”", MSGBOX_SIGN)
        }
    }
    if(!flag(FLAG_TEMP_7)) {
        msgbox(
        "A table of the entire region\n"
        "showing future work plans.", MSGBOX_SIGN)       
    }
    //} else {
    //    msgbox(
    //    "A table of the entire region\n"
    //    "showing future work plans.", MSGBOX_SIGN)
    
    release
    end
}

