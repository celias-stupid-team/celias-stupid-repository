mapscripts Route20_SeafoamIslands_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
		
		setworldmapflag(FLAG_WORLD_MAP_SEAFOAM_ISLANDS_1F)
		if(!flag(FLAG_HIDE_HARRY_RAT)) {
			setflag(FLAG_TEMP_1)
		}
	}
	
}


script Route20_SeafoamIslands_Sign {
	msgbox(
	"SEAFOAM ISLANDS\n"
	"", MSGBOX_SIGN)

}


script Route20_DeadRatFisher {
	trainerbattle_single(TRAINER_DEAD_RAT_FISHER,
	"Woah!\n"
	"Look what I fished up!",
	"Rats!"
	)
	msgbox(
	"after dialogue\n"
	"", MSGBOX_NPC)
}
