mapscripts Route19_UnusedHouse_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		if(flag(FLAG_BADGE05_GET)) {
			setmaplayoutindex(LAYOUT_SURF_FURRET_2)
		}
	}
}
script Route19_Furrets {
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_FEMALE)
	waitse
	playmoncry(SPECIES_FURRET, CRY_MODE_NORMAL)
	msgbox("FURRET: Bwaah!\n", MSGBOX_DEFAULT)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox("FURRET is surfing!\n", MSGBOX_DEFAULT)
	release
}

script Route19_Furret_F {
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_MALE)
	waitse
	playmoncry(SPECIES_FURRET, CRY_MODE_NORMAL)
	msgbox("FURRET: Bwaah!\n", MSGBOX_DEFAULT)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox("FURRET is surfing!\n", MSGBOX_DEFAULT)
	release
}

script Route19_PayDayCelia {
	msgbox(
	"This PC is here so if you deposit\n"
	"your Pay Day TM, you won't be\l"
	"softlocked.", MSGBOX_NPC)
}
