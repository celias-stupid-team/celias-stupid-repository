raw `


Route17_EventScript_ItemsNotice::
	msgbox Route17_Text_WatchOutForDiscardedItems, MSGBOX_SIGN
	end

Route17_EventScript_TrainerTips1::
	msgbox Route17_Text_SameSpeciesGrowDifferentRates, MSGBOX_SIGN
	end

Route17_EventScript_TrainerTips2::
	msgbox Route17_Text_PressBToStayInPlace, MSGBOX_SIGN
	end

Route17_EventScript_RouteSign::
	msgbox Route17_Text_RouteSign, MSGBOX_SIGN
	end

Route17_EventScript_BallsNotice::
	msgbox Route17_Text_DontThrowGameThrowBalls, MSGBOX_SIGN
	end

Route17_EventScript_CyclingRoadSign::
	msgbox Route17_Text_CyclingRoadSign, MSGBOX_SIGN
	end
`

mapscripts Route17_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		if(flag(FLAG_UNDER_DICK_BRIDGE)) {
			clearflag(FLAG_UNDER_DICK_BRIDGE)
			setmaplayoutindex(LAYOUT_ROUTE17_UNDERNEATH)
		}
	}
}

script Route17_GoUnderBridge {
	setlayouttiles(LAYOUT_ROUTE17_UNDERNEATH,0,0,0,0,32, 88)
					setmaplayoutindex(LAYOUT_ROUTE17_UNDERNEATH)
	setvar(VAR_TEMP_0, 1)
	release
}
script Route17_GoAboveBridge {
	setlayouttiles(LAYOUT_ROUTE17,0,0,0,0,32, 88)
					setmaplayoutindex(LAYOUT_ROUTE17)
	setvar(VAR_TEMP_0, 0)
	release
}


script Route17_KoraidonNeedsSandwhich_CandyRoute {
	setflag(FLAG_TEMP_A)
	goto(Route17_KoraidonNeedsSandwich)
}


script Route17_KoraidonNeedsSandwich {
	lock
	setflag(FLAG_TRIED_SLOPE)
	setflag(FLAG_WORLD_MAP_ROUTE10_POKEMON_CENTER_1F)
	setflag(FLAG_WORLD_MAP_ROUTE4_POKEMON_CENTER_1F)
	if(flag(FLAG_FED_SANDWICH)) {
		msgbox("You've already seen this cutscene!\nWould you like to skip it?", MSGBOX_YESNO)
		if(var(VAR_RESULT)) {
			closemessage
			warp(MAP_ROUTE16, 5)
		} else {
			goto(Route17_BikeFliesUp)
		}
	}
	if(checkitem(ITEM_SANDWICH)) {
		msgbox("The slope is too steep for your\nBIKE to handle.\pWould you like to feed your BIKE\na SANDWICH?", MSGBOX_YESNO)
		if(var(VAR_RESULT)) {
			goto(Route17_BikeFliesUp)
		} else {
			goto(Route17_TurnAroundAndLeave)
		}
	} else {
		setflag(FLAG_TRIED_SLOPE)
		msgbox("The steep slope is too much for\nyour BIKE to handle…", MSGBOX_DEFAULT)
		goto(Route17_TurnAroundAndLeave)
	}
}

script Route17_TurnAroundAndLeave {
	closemessage
	delay(30)
	setflag(FLAG_TRIED_SLOPE)
	applymovement(LOCALID_PLAYER, Common_Movement_WalkDown)
	waitmovement(0)
	release
}

script Route17_BikeFliesUp {
	closemessage
	setflag(FLAG_FED_SANDWICH)
	call(SetPlayerPokedexValues)
	removeitem(ITEM_SANDWICH, 1)
	msgbox("{PLAYER}'s BIKE ate the SANDWICH!\n", MSGBOX_DEFAULT)
	fadeoutbgm(1)
	playbgm(MUS_CSR_DRILL_DOZER, TRUE) //Bike Music
	//mugshot appears

	if(flag(FLAG_SYS_ON_SHINY_BIKE)) {
		setvar(VAR_0x8000, MUGSHOT_BIKE_FRAME_1_SHINY)
	} else {
		setvar(VAR_0x8000, MUGSHOT_BIKE_FRAME_1)
	}
	callnative(DrawMugshot)
	messageautoscroll(" ")
	delay(60)

	
	if(flag(FLAG_SYS_ON_SHINY_BIKE)) {
		setvar(VAR_0x8000, MUGSHOT_BIKE_FRAME_2_SHINY)
	} else {
		setvar(VAR_0x8000, MUGSHOT_BIKE_FRAME_2)
	}	
	callnative(DrawMugshot)
	
	messageautoscroll(" ")
	playse(SE_M_EARTHQUAKE)
	setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 2) //I'm gonna fuckin define shakescreen variables this is too hard
	setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 4)
	setvar(VAR_SHAKESCREEN_NUM_SHAKES, 30)
	setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 3)
	special(ShakeScreen)
	delay(90)
	
	
	playmoncry(SPECIES_CYCLIZAR, CRY_MODE_NORMAL)
	fadescreenspeed(FADE_TO_WHITE, 1)
	if(flag(FLAG_SYS_ON_SHINY_BIKE)) {
		setvar(VAR_0x8000, MUGSHOT_BIKE_FRAME_3_SHINY)
	} else {
		setvar(VAR_0x8000, MUGSHOT_BIKE_FRAME_3)
	}
	callnative(DrawMugshot)
	
	messageautoscroll(" ")
	fadescreenspeed(FADE_FROM_WHITE, 1)
	delay(90)
	if(flag(FLAG_SYS_ON_SHINY_BIKE)) {
		setvar(VAR_0x8000, MUGSHOT_BIKE_FRAME_4_SHINY)
	} else {
		setvar(VAR_0x8000, MUGSHOT_BIKE_FRAME_4)
	}	
	callnative(DrawMugshot)
	messageautoscroll(" ")
	delay(120)
	callnative(ClearMugshot)
	closemessage
	delay(30)
	special(SpawnCameraObject)
	applymovement(LOCALID_PLAYER, Route17_BikeWindsUp)
	waitmovement(0)
	delay(60)
	applymovement(LOCALID_PLAYER, Route17_BikeCatchesUpToCamera)
	waitmovement(0)
	special(RemoveCameraObject)
	if(flag(FLAG_TEMP_A) && !flag(FLAG_ROUTE_17_CANDY)) {
		applymovement(LOCALID_PLAYER, moves(
			walk_faster_up * 18
			walk_fastest_up * 12
			face_up
		))
		waitmovement(0)
		

		delay(5)
		removeobject(LOCALID_ROUTE17_CANDY)
		giveitem(ITEM_ODD_CANDY)
		closemessage
		applymovement(LOCALID_PLAYER, moves(
		
		walk_fastest_up * 56
		walk_faster_up * 8
		walk_fast_up * 4
		walk_up * 2
		))

	} else {
		applymovement(LOCALID_PLAYER, Route17_BikeZoomsUp)

	}
	waitmovement(0)
	playbgm(MUS_CYCLING, TRUE)
	release
}

movement Route17_BikeWindsUp {
	lock_facing_direction
	walk_slow_down
	delay_16
	walk_slow_down
	delay_16
	walk_slow_down
}

movement Route17_BikeCatchesUpToCamera {
	walk_faster_up * 3
}

movement Route17_BikeZoomsUp {
	walk_faster_up * 18
	walk_fastest_up * 68
	walk_faster_up * 8
	walk_fast_up * 4
	walk_up * 2
}

script Route17_IllusionPants {
	lock
	faceplayer
	msgbox("Death is an illusion.{PAUSE 10}\nAnd so are pants!", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	playse(SE_CLICK)
	removeobject(VAR_LAST_TALKED)
	release
}

script Route17_DickBridge {
	msgbox("DICK BRIDGE\pThis bridge is DICK.\n", MSGBOX_SIGN)
	end
}

