mapscripts FushciaGym_ShedinjaRoom_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        if(flag(FLAG_DRILLED_RIGHT_HOLE)) {
            call(FushciaGym_ShedinjaRoom_DrawDrilledWall)
        }
        if(flag(FLAG_DEFEATED_SHEDINJA_MAN)) {
            setmetatile(11, 8, 0x357, TRUE)
            setmetatile(15, 8, 0x357, TRUE)
        }

        if(var(VAR_FUSCSIA_GYM_HIPPO_ROOM) == 2) {
            setweather(WEATHER_SANDSTORM)
        } else {
            setflag(FLAG_TEMP_1)
        }
        if(!flag(FLAG_DEFEATED_TRAINER_2)) {
            setmetatile(15, 14, 0x281, FALSE)
            setmetatile(15, 15, 0x280, TRUE)
            setmetatile(16, 14, 0x281, FALSE)
            setmetatile(16, 15, 0x280, TRUE)
            setmetatile(17, 14, 0x281, FALSE)
            setmetatile(17, 15, 0x280, TRUE)
        }
    }
}

script FushciaGym_ShedinjaTrainer {
    lock
    faceplayer
    if(var(VAR_FUSCSIA_GYM_HIPPO_ROOM) == 2) {
        msgbox("Hippo is here\nYou win", MSGBOX_DEFAULT)
        setflag(FLAG_DEFEATED_SHEDINJA_MAN)
            setmetatile(11, 8, 0x357, TRUE)
            setmetatile(15, 8, 0x357, TRUE)
            special(DrawWholeMapView)
        
    } else {
        msgbox("tera electric shedinja\nYou lose", MSGBOX_DEFAULT)
    }
    release
}

script FushciaGym_HippopotasRight {
    lock
    faceplayer
    playse(SE_PIN)
    applymovement(VAR_LAST_TALKED, Common_Movement_ExclamationMark)
    delay(60)
    playmoncry(SPECIES_HIPPOPOTAS, CRY_MODE_NORMAL)
    msgbox("HIPPOPOTAS: Po-prra…!\n", MSGBOX_DEFAULT)
    waitmoncry
    closemessage
    if(flag(FLAG_DRILLED_RIGHT_HOLE)) {
        applymovement(VAR_LAST_TALKED, HippoLooksAround_Right)
        waitmovement(0)
        delay(48)
        playse(SE_FLEE)
        applymovement(VAR_LAST_TALKED, HippoRunsAway_Right)
        if(var(VAR_FACING) == DIR_EAST) {
            applymovement(LOCALID_PLAYER, PlayerGetsOutOfWay_Right)
        }
        waitmovement(VAR_LAST_TALKED)
        setvar(VAR_FUSCSIA_GYM_HIPPO_ROOM, 1)
        setflag(FLAG_TEMP_1)
        setweather(WEATHER_NONE)
        doweather

    } else {
        msgbox("This POKéMON is terrified of you.\nHe looks ready to run away.", MSGBOX_DEFAULT)
    }

}


const DRILL = 3
script FushciaGym_CrackedWallRight {
    lock
    if(flag(FLAG_DRILLED_RIGHT_HOLE)) {
        msgbox("The hole is too small to walk\nthrough.", MSGBOX_DEFAULT)
        release
        end
    }
    msgbox("A small crack has been forming in\nthe wall.", MSGBOX_DEFAULT)
    if(checkitem(ITEM_DRILL_DOZER)) {
        msgbox("Would you like to DRILL through\nit?", MSGBOX_YESNO)
        if(var(VAR_RESULT)) {
            msgbox("{PLAYER} used the DRILL DOZER!\n", MSGBOX_DEFAULT)
            
            closemessage
            delay(20)
            addobject(DRILL)
            playse(SE_M_EARTHQUAKE)
            setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 1)
            setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 1)
            setvar(VAR_SHAKESCREEN_NUM_SHAKES, 1)
            setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 1)
            setflag(FLAG_DRILLED_RIGHT_HOLE)
            setobjectxy(DRILL, 7, 10)

            applymovement(DRILL, DrillDozesLeft)
            setmetatile(7, 10, 0x39B, TRUE)
            special(DrawWholeMapView)
            special(ShakeScreen)
            delay(40)
            setmetatile(6, 10, 0x39B, TRUE)
            special(DrawWholeMapView)
            special(ShakeScreen)
            delay(40)
            setmetatile(5, 10, 0x39B, TRUE)
            special(DrawWholeMapView)
            special(ShakeScreen)
            delay(40)
            setobjectxy(DRILL, 0, 0)
        }
    }
    release
}



script FushciaGym_ShedinjaRoom_DrawDrilledWall {
    
            setmetatile(7, 10, 0x39B, TRUE)
            setmetatile(6, 10, 0x39B, TRUE)
            setmetatile(5, 10, 0x39B, TRUE)
            return
}

movement HippoLooksAround_Right {
    face_left
    delay_16 * 2
    face_right
    delay_16 * 2
    face_left
    face_right
    delay_16 * 2
}

movement HippoRunsAway_Right {
    walk_faster_left * 8 //it makes sense trust me
}

movement PlayerGetsOutOfWay_Right {
    face_up
    lock_facing_direction
    jump_down
    unlock_facing_direction
}

movement DrillTheWall_Right {
    walk_faster_left
    walk_in_place_fast_left * 3
}

script FushciaGym_ShedinjaRoom_OpenDoors {
    setmetatile(11, 7, 0x34F, TRUE)
    setmetatile(11, 8, 0x357, TRUE)
    setmetatile(15, 7, 0x34F, TRUE)
    setmetatile(15, 8, 0x357, TRUE)


    return
}