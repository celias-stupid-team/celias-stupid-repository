script SixIsland_Zygarde {
    lock
    faceplayer
    playmoncry(SPECIES_ZYGARDE, CRY_MODE_ENCOUNTER)
    setwildbattle(SPECIES_ZYGARDE, 50)
    dowildbattle
    delay(20)
    removeobject(VAR_LAST_TALKED)
    release

}