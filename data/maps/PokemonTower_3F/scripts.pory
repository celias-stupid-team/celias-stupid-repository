`
script PokemonTower_3F_LostSilver {
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"SILVER: Uh, hey.\n"
	"Could you give me some directions?\l"
	"I'm lost.", MSGBOX_NPC)
}


mapscripts PokemonTower_3F_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setflag(FLAG_TEMP_9)
		if(var(VAR_CURRENT_CHAPTER) == 2 || var(VAR_CURRENT_CHAPTER) == 1) {
			setflag(FLAG_TEMP_10)
		}
		if(!flag(FLAG_ENTERED_MAROWAK_FIGHT_WITH_SCOPE)) {
			setflag(FLAG_TEMP_8)
			setflag(FLAG_HIDE_CLEFAIRY_DOLL_GIRL)
		}
		if(flag(FLAG_TOOK_TOWER_CLEFAIRY_DOLL) && var(VAR_CSR_GHOST_FIGHT) != 0) {
			clearflag(FLAG_TEMP_9)
			setflag(FLAG_TEMP_8)
			if(flag(FLAG_POKEMONTOWER_BANETTE)) {
				setflag(FLAG_TEMP_9)
				setflag(FLAG_TEMP_11)
			} else {
				setflag(FLAG_TEMP_13) // Room loaded in with banette
			}
		}
		if(flag(FLAG_TOOK_GIRL_DOLL)) {
			setflag(FLAG_HIDE_CLEFAIRY_DOLL_GIRL)
			setflag(FLAG_TEMP_9)
			setflag(FLAG_TEMP_8)
		}
		if(!flag(FLAG_WORLD_MAP_FUSHCIA_CITY)) {
			setflag(FLAG_CSR_HIDE_MUSIC_GIRL)
		}
	}
}

script PokemonTower_3F_ClefairyDollGirl {
	lock
	faceplayer
	if(flag(FLAG_TEMP_11)) {
		setflag(FLAG_TOOK_GIRL_DOLL)
		finditem(ITEM_PERSON_DOLL)
		end
	}
	if(var(VAR_CSR_GHOST_FIGHT) != 0 && flag(FLAG_TOOK_TOWER_CLEFAIRY_DOLL) && flag(FLAG_TEMP_8) && flag(FLAG_TEMP_13)) {
		if(flag(FLAG_TEMP_12)) {
			msgbox("Wha-?\nHey!\pDon't take my new DOLL!\n", MSGBOX_DEFAULT)
		} else {
			msgbox("Waa!\nThe GHOSTS in here are so scary!\pIt's okay, though.\nI found a new DOLL to keep me safe.", MSGBOX_DEFAULT)
		}
	} else {
		if(flag(FLAG_TEMP_12)) {
			msgbox("Wha-?\nHey!\pDon't take my CLEFAIRY!\n", MSGBOX_DEFAULT)
		} else {
			msgbox("Waa!\nThe GHOSTS in here are so scary!\pIt's okay, though.\nMy CLEFAIRY will keep me safe.", MSGBOX_DEFAULT)
		}

	}
	release
}

script PokemonTower_BanetteDoll {
	setflag(FLAG_TEMP_12)
	setflag(FLAG_POKEMONTOWER_BANETTE)
	finditem(ITEM_BANETTE_DOLL)
}

script PokemonTower_ClefairyDoll {
	setflag(FLAG_TEMP_12)
	setflag(FLAG_TOOK_TOWER_CLEFAIRY_DOLL)
	finditem(ITEM_POKE_DOLL)
}

const LITTLEGIRL = 8
const CLEFAIRY = 4
script PokemonTower_6F_EventScript_MarowakGhost {
	lockall
	textcolor(NPC_TEXT_COLOR_MON)
	clearflag(FLAG_USED_CLEFAIRY_DOLL)
	msgbox(PokemonTower_6F_Text_BeGoneIntruders)
	goto_if_questlog(EventScript_ReleaseEnd)
	setwildbattle(SPECIES_MAROWAK, 30)
	special(StartMarowakBattle)
	delay(65)
	if(flag(FLAG_CSR_SUPER_SCOPE)) {
		addobject(LITTLEGIRL)
		clearflag(FLAG_HIDE_CLEFAIRY_DOLL_GIRL)
		if(!flag(FLAG_TOOK_TOWER_CLEFAIRY_DOLL)) {
			addobject(CLEFAIRY)
			clearflag(FLAG_TEMP_8)

		}

	}
	waitstate
	special(QuestLog_CutRecording)
	//goto_if_eq(FLAG_USED_CLEFAIRY_DOLL, FALSE, PokemonTower_6F_EventScript_DefeatedMarowakGhost)  // VAR_RESULT set by CB2_EndMarowakBattle
	if(flag(FLAG_USED_CLEFAIRY_DOLL)) {
		msgbox("{PLAYER} got away safely!\pThe GHOST seems to be appeased.", MSGBOX_DEFAULT)
		playmoncry(SPECIES_GASTLY, CRY_MODE_NORMAL)
		
		waitmoncry
		closemessage
		setvar(VAR_CSR_GHOST_FIGHT, 1)
		releaseall
		end
	} else {
		applymovement(LOCALID_PLAYER, PokemonTower_6F_Movement_ForcePlayerUp)
		waitmovement(0)
		releaseall

	}
	end
}

script PokemonTower_6F_EventScript_DefeatedMarowakGhost {
	message(PokemonTower_6F_Text_GhostWasCubonesMother)
	waitmessage
	waitse
	playmoncry(SPECIES_GASTLY, CRY_MODE_NORMAL)
	waitbuttonpress
	waitmoncry
	msgbox(PokemonTower_6F_Text_MothersSpiritWasCalmed)
	setvar(VAR_CSR_GHOST_FIGHT, 1)
	releaseall
}

movement PokemonTower_6F_Movement_ForcePlayerUp {
	walk_left
	step_end
}


script PokemonTower_GreatestFear {
	msgbox("Beware, fair traveler, as you\nascend.\pClimbing this tower will face you\nagainst the greatest fear of any\lfanfiction author.", MSGBOX_NPC)
	end
}

script PokemonTower_NuzlockeGrave {
	msgbox("Here lies yet another run.\nCTRL + R to try again.", MSGBOX_SIGN)
	end
}

script PokemonTower_ScaryDad {
	lock
	faceplayer
	textcolor(0)
	msgbox("DAD: {PLAYER}!\nWhat are you doing out here?\pHey!\nDid you see my face just now?\lI think I finally made it big!\pWell, never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}

script PokemonTower_TrainerTipsSign {
	msgbox(
	"TRAINER TIPS\p"

	"Keep talking to them!\n"
	"", MSGBOX_SIGN)

}
