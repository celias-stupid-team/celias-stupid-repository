
const ATTENDANT = 1
mapscripts FushciaGym_Entrance_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        if(flag(FLAG_IN_FUSHCIA_GYM) || flag(FLAG_REVEALED_DAD)) {
            setflag(FLAG_TEMP_1)
            setrespawn(HEAL_LOCATION_FUSHCIA_GYM_ENTRANCE)
        }
        if(flag(FLAG_REVEALED_DAD)) {
            setvar(VAR_FUSHCIA_GYM_CHALLENGE, 3)
        }
    }
}

script FushciaGym_Entrance_Celia {
	msgbox("Hi!\nI'm CELIA, the creator.\lThis is the end of the preview!\pI hope you had fun!\pSee if you can catch all 103\nPOKéMON available.\lYou made it this far. You can do it!\pThe full demo will contain this\ngym, so look forward to it!", MSGBOX_NPC)
	end
}

script FushciaGym_Entrance_Koga {
    lock
    faceplayer
    if(!flag(FLAG_TALKED_TO_KOGA_AT_START)) {
        msgbox("Fwahahaha!\nWelcome, child, to FUSHCIA GYM!\pYou wish to challenge me and claim\nmy BADGE as your own?\lWhat folly!\pIf that's what you desire, you\nmust solve the maze ahead.\pHowever!\nThere is a twist!\pTo enter my GYM, you are only\npermitted to bring 3 POKéMON.\lBeyond that, only your wits remain.\pKnowing this, do you still wish to\nchallenge me?", MSGBOX_YESNO)
        setflag(FLAG_TALKED_TO_KOGA_AT_START)
        
    } else {
        msgbox("Fwahahaha!\nSo you've returned to my GYM!\pTo earn the right to challenge me,\nnavigate my maze to the end.\lYou may only bring 3 POKéMON along.\pDo you wish to attempt the\nchallenge again?", MSGBOX_YESNO)
    }
    if(var(VAR_RESULT)) {
        msgbox("Excellent!\nI welcome your tenacity.\pWhich POKéMON would you like to\nbring? Choose wisely…", MSGBOX_DEFAULT)
        special(SavePlayerParty)
        //select three Pokemon
        fadescreen(FADE_TO_BLACK)
        special(ChooseHalfPartyForBattle)
        //Only use three pokemon
        waitstate
        if(var(VAR_RESULT) == 0) {
            special(LoadPlayerParty)
            msgbox("Bah!\nSuch cowardice!\pFine, then.\nBe on your way.", MSGBOX_DEFAULT)
            release
            end
        }
        special(LoadPlayerParty)
        special(SavePlayerParty)
        special(ReducePlayerPartyToThree)
        msgbox("I shall await you at your final\ngoal.\lShow me all that you've learned!\pBut first, you must take a rest.\nI'll be gone when you arise.", MSGBOX_DEFAULT)
        closemessage
        fadescreen(FADE_TO_BLACK)
        special(HealPlayerParty)
        playfanfare(MUS_HEAL)
        waitfanfare
        setflag(FLAG_IN_FUSHCIA_GYM)
        removeobject(VAR_LAST_TALKED)
        fadescreen(FADE_FROM_BLACK)
        delay(30)
        setvar(VAR_FUSHCIA_GYM_CHALLENGE, 1)
        setrespawn(HEAL_LOCATION_FUSHCIA_GYM_ENTRANCE)
        applymovement(LOCALID_PLAYER, FushciaGym_PlayerWalksUp)
        waitmovement(0)
        release


    } else {
        msgbox("Bah!\nSuch cowardice!\pFine, then.\nBe on your way.", MSGBOX_DEFAULT)
        release
        end
    }
}

script FushciaGym_Attendant {
    lock
    faceplayer
    if(!flag(FLAG_IN_FUSHCIA_GYM)) {
        msgbox("Welcome\nGood Luck") // Placeholder
        setflag(FLAG_IN_FUSHCIA_GYM)
        setflag(FLAG_TEMP_1)
        closemessage
        applymovement(ATTENDANT, AttendantWalksAway)
        waitmovement(0)
    } else {
        msgbox("Good luck") //Placeholder
    }
    release
    end
}

script FushciaGym_LeaveChallenge {
    lock
    addobject(ATTENDANT)
    setobjectxy(ATTENDANT, 9, 10)
    playse(SE_LEDGE)
    applymovement(ATTENDANT, KogaJumpsYou)
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
    textcolor(NPC_TEXT_COLOR_MALE)
    delay(40)
    msgbox("Aha!\nSo you wish to leave the GYM?", MSGBOX_YESNO)
    if(var(VAR_RESULT)) {
        copyobjectxytoperm(ATTENDANT)
        setvar(VAR_FUSHCIA_GYM_CHALLENGE, 0)
        special(LoadPlayerParty)
        msgbox("Bah!\nSuch cowardice!\pFine, then.\nBe on your way.", MSGBOX_DEFAULT)
        release
        end

    } else {
        msgbox("That's what I thought.\nThen return to the challenge!", MSGBOX_DEFAULT)
        closemessage
        fadescreen(FADE_TO_BLACK)
        removeobject(ATTENDANT)
        fadescreen(FADE_FROM_BLACK)
        delay(30)
        setvar(VAR_FUSHCIA_GYM_CHALLENGE, 1)
        applymovement(LOCALID_PLAYER, FushciaGym_PlayerWalksUp)
        waitmovement(0)
        release
    }
}

movement KogaJumpsYou {
    jump_2_down
}

script FushciaGym_InvisibleLass {
    lock
    faceplayer
    if(checkitem(ITEM_DEVON_SCOPE)) {
        textcolor(NPC_TEXT_COLOR_NEUTRAL)
        msgbox("There's an invisible object\nin the way.\pWould you like to use the\nDEVON SCOPE?", MSGBOX_YESNO)
        if(var(VAR_RESULT)) {
            msgbox("{PLAYER} used the DEVON SCOPE!\n", MSGBOX_DEFAULT)
            closemessage
            delay(20)
            applymovement(VAR_LAST_TALKED, InvisibleToVisible)
            waitmovement(0)
            textcolor(NPC_TEXT_COLOR_FEMALE)
            playbgm(MUS_ENCOUNTER_GIRL, FALSE)
            delay(60)
            msgbox("Hey!\n", MSGBOX_DEFAULT) // Placeholder
            playbgm(MUS_BATTLE_FRONTIER, FALSE)
            trainerbattle_no_intro(TRAINER_LASS_INVISIBLE, "Oh no!")
            msgbox("Y'know, I've always liked the\nREGI POKéMON.\pThe only people who find them on\ntheir own never look at me!", MSGBOX_DEFAULT)
            closemessage
            special(LoadPlayerParty)
            fadescreen(FADE_TO_BLACK)
            removeobject(VAR_LAST_TALKED)
            fadescreen(FADE_FROM_BLACK)
            setflag(FLAG_FUSHCIA_GYM_INVISIBLE_LASS)
            delay(30)
            msgbox("You spot a small compartment on the\nfloor under the LASS.\lLet's see what's inside…", MSGBOX_DEFAULT)
            playfanfare(MUS_LEVEL_UP)
            msgbox("It's the rest of your POKéMON!\nNice!", MSGBOX_DEFAULT)
            waitfanfare
            release
        } else {   
            release
            end
        }
    } else {
        textcolor(NPC_TEXT_COLOR_NEUTRAL)
        msgbox("There's an invisible object\nin the way.", MSGBOX_DEFAULT)
    }
    release
    end
}

movement FushciaGym_PlayerWalksUp {
    walk_up * 2
}

movement AttendantWalksAway {
    walk_up
    walk_right
    face_left
}

movement AttendantReturnsFromUp {
    walk_left
    walk_down
    face_down
}

movement AttendantReturnsFromDown {
    walk_right
    walk_up
    face_down
}

movement InvisibleToVisible {
    set_visible
    delay_2
    set_invisible
    delay_2
    set_visible
    delay_4
    set_invisible
    delay_4
    
    set_visible
    delay_8
    set_invisible
    delay_8
    set_visible
}