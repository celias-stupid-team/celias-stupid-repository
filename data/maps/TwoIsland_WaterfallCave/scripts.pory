mapscripts TwoIsland_WaterfallCave_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setbench(BENCH_TWO_ISLAND_CAVE)
		setflag(FLAG_BEEN_IN_WATERFALL_HOUSE)
	}
}

script WaterfallCave_MoveTutor {
	lock
	faceplayer
	msgbox(
	"Hmm…?\n"
	"You've found my secret retreat!\p"

	"Then… Then you may be the one\n"
	"I've been waiting for!\p"

	"I have secret, powerful moves for\n"
	"use in DOUBLE BATTLES.\l"
	"Only the STARTERS can use them.", MSGBOX_DEFAULT)
	msgbox(
	"Here, to whom shall I teach one?\n"
	"", MSGBOX_DEFAULT)
	special(ChooseMonForPledgeTutor)
	waitstate
	goto_if_eq(VAR_RESULT, FALSE, CapeBrinkTutor_EventScript_DeclineMove)
	goto(CapeBrinkTutor_EventScript_TaughtMove)
	release
}
