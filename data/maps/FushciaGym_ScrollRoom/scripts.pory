mapscripts FushciaGym_ScrollRoom_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        if(flag(FLAG_LASS_BROKE_WALL)) {
            call(FushciaGym_ScrollRoom_SetBrokenWall)
        }
        
        setrespawn(HEAL_LOCATION_FUSHCIA_GYM_SCROLL_ROOM)
    }
}

script FushciaGym_ScrollRoom_Glass {
	msgbox("100% Look-proof glass!\pSatisfaction guaranteed!\n", MSGBOX_SIGN)
	end
}

script FushciaGym_ScrollRoom_Scroll {
    setflag(FLAG_MEMORIZED_SCROLL)
	msgbox("{PLAYER} memorized the secret\npassword…", MSGBOX_SIGN)
	end
}

script FushciaGym_ScrollRoom_SetBrokenWall {
    setmetatile(17, 11, 0x39E, TRUE)
    setmetatile(18, 11, 0x39E, TRUE)
    setmetatile(19, 11, 0x39E, TRUE)
    setmetatile(20, 11, 0x39E, TRUE)
    setmetatile(21, 11, 0x39E, TRUE)
    setmetatile(22, 11, 0x39E, TRUE)
    return
}