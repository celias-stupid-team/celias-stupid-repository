mapscripts Silph_BallShop_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setflag(FLAG_TEMP_2)
		setvar(VAR_TEMP_5, 11)
		if(var(VAR_SILPH_LOOK_GIRL) == 1) {
			clearflag(FLAG_TEMP_2)
		}
		setflag(FLAG_TEMP_5)
		if(var(VAR_SILPH_LOOK_GIRL) > 2) {
			clearflag(FLAG_TEMP_5)
		}
	}
	MAP_SCRIPT_ON_LOAD {
		
		if(var(VAR_SILPH_LOOK_GIRL) > 1) {
			setobjectxyperm(LOCALID_KURT, 14, 7)
			setobjectmovementtype(LOCALID_KURT, MOVEMENT_TYPE_FACE_DOWN)
		}
	}
}


script SilphCo_BallShop_Kurt {
	lock
	setflag(FLAG_CSR_MAP_BALL_SHOP)
	msgbox(
	"KURT: Hello, there.\n"
	"Are you a fan of BALLS?", MSGBOX_DEFAULT)
	waitmessage
	pokemart(SilphCo_BallShop_Mart)
	msgbox(Text_PleaseComeAgain)
	if(checkitem(ITEM_BIG_MUSHROOM)) {
		if(checkitem(ITEM_BIG_MUSHROOM, 9)) {
			setflag(FLAG_TEMP_6)
		}
		while(checkitem(ITEM_BIG_MUSHROOM)) {
			removeitem(ITEM_BIG_MUSHROOM)
		}
		closemessage
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		playfanfare(MUS_LEVEL_UP)
		msgbox(
		"{PLAYER} bought an AMOONGUSS!\n"
		"", MSGBOX_DEFAULT)
		waitfanfare
		setvar(VAR_CSR_GIFT_POKEMON, SPECIES_AMOONGUSS)
		call(Common_Script_GiftPokemon)
		if(flag(FLAG_TEMP_6)) {
			clearflag(FLAG_TEMP_6)
			textcolor(NPC_TEXT_COLOR_BLUE)
			msgbox(
			"Were you trying to purchase a\n"
			"PREMIER MUSHROOM?\p"

			"That's not actually a feature in\n"
			"FIRE RED VERSION. Sorry!", MSGBOX_DEFAULT)

		}
	}
	release
}

script SilphCo_BallShop_Sign {
	lock
	msgbox(
	"SILPH CO 3F\n"
	"POKé BALL SHOP", MSGBOX_SIGN)

}

mart SilphCo_BallShop_Mart {
	ITEM_BURN_BALL
	ITEM_LOVE_BALL
	ITEM_QUEUE_BALL
	ITEM_DUMMY_BALL
	ITEM_SPORTS_BALL
	ITEM_BIG_MUSHROOM
	ITEM_SLUGMA_BALL
}


script SilphCo_BallShop_Elevator {
	msgbox(
	"Rats!\n"
	"The ladies are being indecisive!", MSGBOX_SIGN)

}


script Silph_LookGirl_Balls {
	    lock
	
		msgbox(format("Hmm...\nIs that down..."), MSGBOX_DEFAULT)
		applymovement(VAR_LAST_TALKED, Common_Movement_FacePlayer)
		waitmovement(0)
		playse(SE_PIN)
		applymovement(VAR_LAST_TALKED, DT_exclmark)
		waitmovement(0)
		delay(48)
		msgbox(format("Oh!\nLook, look!"), MSGBOX_DEFAULT)
		closemessage
		switch(var(VAR_FACING)) {
			case DIR_SOUTH:
                    addvar(VAR_TEMP_5, 1)
					applymovement(VAR_LAST_TALKED, moves(
						face_up
						lock_facing_direction
						walk_down
					))
					waitmovement(0)
					break
				default:
                    subvar(VAR_TEMP_5, 1)
					applymovement(VAR_LAST_TALKED, moves(
						face_down
						lock_facing_direction
						walk_up
					))
					waitmovement(0)
					break
        }
	if(var(VAR_TEMP_5) == 5 && var(VAR_SILPH_LOOK_GIRL) == 1) {
		playse(SE_BIKE_BELL)
		waitse
		
		playse(SE_PIN)
		applymovement(LOCALID_KURT, moves(
			emote_exclamation_mark
			delay_16 * 4
			face_left
			delay_16
			face_right
			delay_16 * 2
			walk_down * 2
			face_down
		))
		waitmovement(LOCALID_KURT)
		copyobjectxytoperm(LOCALID_KURT)
		setobjectmovementtype(LOCALID_KURT, MOVEMENT_TYPE_FACE_DOWN)
		setvar(VAR_SILPH_LOOK_GIRL, 2)
		waitmovement(0)
	}
	if(var(VAR_TEMP_5) == 2) {
		playse(SE_ICE_BREAK)
		removeobject(VAR_LAST_TALKED)
		setvar(VAR_SILPH_LOOK_GIRL, 3)
		addobject(LOCALID_BALL_WINDOW)

	}
    copyobjectxytoperm(VAR_LAST_TALKED)
	release
}


script SilphCo_RingBellForService {
	msgbox(
	"Ring bell for service!\n"
	"- KURT", MSGBOX_SIGN)

}

