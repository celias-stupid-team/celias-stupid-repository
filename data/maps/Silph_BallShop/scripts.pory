	"Despite your best efforts, it's\n"
	"too far to reach.", MSGBOX_SIGN)

}

script Silph_KurtNotThere {
	msgbox(
	"You step up to the counter, but\n"
	"he does not pay you any mind.\p"

	"He's too engrossed in his work to\n"
	"notice you.", MSGBOX_SIGN)

}


script Silph_WhisMan {
	
	msgbox(
	"…\p"

	"I spend my entire life savings\n"
	"to purchase a MASTER BALL.\p"

	"It…{PAUSE 30} didn't work out.\n"
	"", MSGBOX_SIGN)
}

script Silph_Whiscash {
	lock
	playmoncry(SPECIES_WHISCASH, CRY_MODE_DEFAULT)
	waitmoncry
	msgbox(
	"{ASTERISK}burp{ASTERISK}\n"
	"", MSGBOX_DEFAULT)
	release
}

