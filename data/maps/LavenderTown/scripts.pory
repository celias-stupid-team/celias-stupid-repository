	end

LavenderTown_EventScript_UndergroundPathSign::
	msgbox LavenderTown_Text_UndergroundPathSign, MSGBOX_SIGN
	end
`
const IMPOSTER_OAK = 7
script LavenderTown_ImposterOak {
	lock
	if(checkitem(ITEM_WAILMER_PAIL)) {
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		msgbox("There is an odd tree in the way.\nWould you like to WATER it?", MSGBOX_YESNO)
		if(var(VAR_RESULT)) {
			removeitem(ITEM_WAILMER_PAIL)
			additem(ITEM_EMPTY_PAIL)
			setvar(VAR_CSR_PSYDUCK_PAIL_STATUS, 1)
			msgbox("{PLAYER} watered the tree…\n", MSGBOX_DEFAULT)
			closemessage
			playse(SE_PIN)
			applymovement(IMPOSTER_OAK, Common_Movement_ExclamationMark)
			waitmovement(0)
			delay(60)
			textcolor(NPC_TEXT_COLOR_TREE)
			msgbox("{FONT_SMALL}OAK?: Wha-?\nHey!", MSGBOX_DEFAULT)
			
			trainerbattle_single(TRAINER_IMPOSTER_OAK_1, "{FONT_SMALL}What gives?", "{FONT_SMALL}Grr-\nFine!\pI'll go somewhere else!\n", LavenderTown_RemoveTree)
		}
	} else {
		applymovement(IMPOSTER_OAK, OakDances)
		playse(SE_M_SCRATCH)
		delay(10)
		playse(SE_M_SCRATCH)
		delay(10)
		playse(SE_M_SCRATCH)
		delay(10)
		waitmovement(0)
		
	}
	
	release
}

script LavenderTown_RemoveTree {
	fadescreen(FADE_TO_BLACK)
	removeobject(IMPOSTER_OAK)
	setflag(FLAG_CSR_IMPOSTEROAK1)
	fadescreen(FADE_FROM_BLACK)
	release
}

movement OakDances {
	walk_in_place_down * 3
	face_down
}

script LavenderTown_DanceDMCA {
	msgbox("Stop right there!\pThis building right here is the\nLAVENDER TOWN DANCE THEATER.\pThey've been putting on shows that\nviolate copyright!\lIt's shut down until further notice.", MSGBOX_NPC)
	end
}

script LavenderTown_MusicGoesAway {
	fadenewbgm(MUS_DUMMY)
	setvar(VAR_TEMP_3, 1)
	release
}

script LavenderTown_MusicComesBack {
	fadedefaultbgm
	setvar(VAR_TEMP_3, 0)
	release
}

script LavenderTown_MusicDoesntFade {
	setvar(VAR_TEMP_3, 1)
	release
}