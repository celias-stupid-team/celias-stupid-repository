raw `



LavenderTown_EventScript_LittleGirl::
	lock
	faceplayer
	msgbox LavenderTown_Text_DoYouBelieveInGhosts, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, LavenderTown_EventScript_LittleGirlBelieve
	msgbox LavenderTown_Text_JustImaginingWhiteHand
	release
	end

LavenderTown_EventScript_LittleGirlBelieve::
	msgbox LavenderTown_Text_SoThereAreBelievers
	release
	end

LavenderTown_EventScript_WorkerM::
	famechecker FAMECHECKER_LAVENDER, 0
	msgbox LavenderTown_Text_TownKnownAsMonGraveSite, MSGBOX_NPC
	end

LavenderTown_EventScript_DietDance::
	msgbox LavenderTown_Text_DietDance_Before, MSGBOX_NPC
	end

LavenderTown_EventScript_Boy::
	msgbox LavenderTown_Text_GhostsAppearedInTower, MSGBOX_NPC
	end

LavenderTown_EventScript_TownSign::
	msgbox LavenderTown_Text_TownSign, MSGBOX_SIGN
	end

LavenderTown_EventScript_SilphScopeNotice::
	msgbox LavenderTown_Text_SilphScopeNotice, MSGBOX_SIGN
	end

LavenderTown_EventScript_VolunteerHouseSign::
	msgbox LavenderTown_Text_VolunteerPokemonHouse, MSGBOX_SIGN
	end

LavenderTown_EventScript_PokemonTowerSign::
	msgbox LavenderTown_Text_PokemonTowerSign, MSGBOX_SIGN
	end



LavenderTown_EventScript_UndergroundPathSign::
	msgbox LavenderTown_Text_UndergroundPathSign, MSGBOX_SIGN
	end
`
const IMPOSTER_OAK = 7

mapscripts LavenderTown_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setworldmapflag (FLAG_WORLD_MAP_LAVENDER_TOWN)
		setbench (BENCH_LAVENDER)
		setflag(FLAG_TEMP_6)
		if(flag(FLAG_CSR_SUPER_SCOPE) && !flag(FLAG_BADGE04_GET)) {
			clearflag(FLAG_TEMP_6)
		}
		setflag (FLAG_HIDE_SS_ANNE_RIVAL)
		if(var(VAR_CURRENT_CHAPTER) == 2) {
			setflag(FLAG_DANCE_THEATER_CHAPTER_3)
			setdynamicwarp(MAP_CHAPTER3, 0)

		} else {
			clearflag(FLAG_DANCE_THEATER_CHAPTER_3)
			setdynamicwarp(MAP_LAVENDER_TOWN_DANCE_THEATER, 0)
		}


		end
	}
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_CSR_SEPIA, 1 {
			if(flag(FLAG_TEMP_5)) {
				setvar(VAR_CSR_SEPIA, 2)
				delay(30)
				msgbox("…?\n", MSGBOX_DEFAULT)
				closemessage
				setflag(FLAG_SHINY_CREATION) // Tangela
				setwildbattle(SPECIES_TANGELA, 20)
				dowildbattle
				delay(30)
				msgbox("It was the GREEN-HARIED\nDANCER!", MSGBOX_DEFAULT)
				release
				end
			} else {
				setvar(VAR_CSR_SEPIA, 0)
			}
		}
	]
}


script LavenderTown_ImposterOak {
	lock
	if(checkitem(ITEM_WAILMER_PAIL)) {
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		msgbox("There is an odd tree in the way.\nWould you like to WATER it?", MSGBOX_YESNO)
		if(var(VAR_RESULT)) {
			removeitem(ITEM_WAILMER_PAIL)
			additem(ITEM_EMPTY_PAIL)
			setvar(VAR_CSR_PSYDUCK_PAIL_STATUS, 1)
			msgbox("{PLAYER} watered the tree…\n", MSGBOX_DEFAULT)
			closemessage
			playse(SE_PIN)
			applymovement(IMPOSTER_OAK, Common_Movement_ExclamationMark)
			
			fadeoutbgm(1)
			waitmovement(0)
			textcolor(NPC_TEXT_COLOR_TREE)
			playbgm(MUS_CSR_IMPOSTER_OAK, TRUE)
			msgbox("{FONT_SMALL}OAK?: Wha-?\nHey!\p{FONT_SMALL}What gives?", MSGBOX_DEFAULT)
			
			trainerbattle_no_intro(TRAINER_IMPOSTER_OAK_1, "{FONT_SMALL}Grr-\nFine!\pI'll go somewhere else!\n")
			goto(LavenderTown_RemoveTree)
		}
	} else {
		applymovement(IMPOSTER_OAK, OakDances)
		playse(SE_M_SCRATCH)
		delay(10)
		playse(SE_M_SCRATCH)
		delay(10)
		playse(SE_M_SCRATCH)
		delay(10)
		waitmovement(0)
		
	}
	
	release
}

script LavenderTown_EventScript_FailedMath {
	lock
	faceplayer
	msgbox("Originally, POKéMON TOWER was\nsupposed to be built horizontally.", MSGBOX_DEFAULT)
	closemessage
	delay(20)
	special(SpawnCameraObject)
	applymovement(LOCALID_CAMERA, LavenderCameraUp)
	waitmovement(0)
	delay(60)
	msgbox("However, the engineers who built\nit all failed math.", MSGBOX_DEFAULT)
	closemessage
	delay(60)
	msgbox("This is what we got instead.\n", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	applymovement(LOCALID_CAMERA, LavenderCameraDown)
	waitmovement(0)
	special(RemoveCameraObject)
	release
}

movement LavenderCameraUp {
	walk_fast_up * 8
}

movement LavenderCameraDown {
	walk_faster_down * 8
}

script LavenderTown_RemoveTree {
	msgbox("{FONT_SMALL}Geez, what a lousy neighborhood.\nI'm outta here!\pStay dry, ya jerk!\n", MSGBOX_DEFAULT)
	closemessage
	fadescreenswapbuffers(FADE_TO_BLACK)
	playse(SE_EXIT)
	fadedefaultbgm
	removeobject(IMPOSTER_OAK)
	waitse
	setflag(FLAG_CSR_IMPOSTEROAK1)
	fadescreenswapbuffers(FADE_FROM_BLACK)
	release
}

movement OakDances {
	walk_in_place_down * 3
	face_down
}

script LavenderTown_DanceDMCA {
	msgbox("Stop right there!\pThis building right here is the\nLAVENDER TOWN DANCE THEATER.\pThey've been putting on shows that\nviolate copyright!\lIt's shut down until further notice.", MSGBOX_NPC)
	end
}

script LavenderTown_MusicGoesAway {
	fadenewbgm(MUS_NONE)
	setvar(VAR_TEMP_3, 1)
	setvar(VAR_TEMP_4, 1)
	setflag(FLAG_TEMP_5)
	release
}

script LavenderTown_MusicComesBack {
	fadedefaultbgm
	setvar(VAR_TEMP_3, 0)
	clearflag(FLAG_TEMP_5)
	release
}

script LavenderTown_MusicDoesntFade {
	setvar(VAR_TEMP_3, 1)
	clearflag(FLAG_TEMP_5)
	release
}

script LavenderTown_ProgressionCelia {
	msgbox(
	"Are you stuck on CELADON GYM?\p"

	"Don't worry: You don't need to do\n"
	"the TOWER first.\l"
	"Going in here won't help you.\p"

	"Good luck!\n"
	"", MSGBOX_NPC)
}


script LavenderTown_SchoolOak {
	msgbox(
	"That's not the science teacher,\n"
	"silly!", MSGBOX_SIGN)

}

script LavenderTown_NameRaterOak {
	msgbox(
	"Its name isn't OAK, silly!\n"
	"", MSGBOX_SIGN)

}

script LavenderTown_AllOaksEverywhere {
	msgbox(
	"What, did you think it was all\n"
	"trees everywhere who are OAK?\l"
	"Ha!", MSGBOX_SIGN)

}

script LavenderTown_NotDaisySilly {
	msgbox(
	"That's not DAISY, silly!\n"
	"", MSGBOX_SIGN)

}
script LavenderTown_YoungOak {
	msgbox(
	"A young, potted OAK.\n"
	"", MSGBOX_SIGN)

}


script LavenderTown_FlowerPainting {
	lock
	if(flag(FLAG_TEMP_3)) {
		msgbox(
		"That's what they call a faceplant.\n"
		"", MSGBOX_DEFAULT)
		release
		end
	}
	msgbox(
	"A familiar picture of a flower.\n"
	"Wanna jump face-first into it?", MSGBOX_YESNO)
	if(var(VAR_RESULT) == YES) {
		closemessage
		delay(20)
		applymovement(LOCALID_PLAYER, BackUp)
		waitmovement(0)
		playse(SE_LEDGE)
		applymovement(LOCALID_PLAYER, JumpSplat)
		waitmovement(0)
		
				playse(SE_WALL_HIT)
				applymovement(OBJ_EVENT_ID_PLAYER, Faceplant)
				waitmovement(0)
				delay(40)
				setflag(FLAG_TEMP_3)
		
	}
	release
}

script LavenderTown_WindSound {
	playse(SE_M_SAND_TOMB)
	setvar(VAR_TEMP_4, 2)
	release
	end
}