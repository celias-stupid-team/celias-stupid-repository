raw `


PalletTown_PlayersHouse_1F_EventScript_Mom::
	lock
	faceplayer
	famechecker FAMECHECKER_PALLET, 3
	goto_if_set FLAG_BEAT_RIVAL_IN_OAKS_LAB, PalletTown_PlayersHouse_1F_EventScript_MomHeal
	checkplayergender
	call_if_eq VAR_RESULT, MALE, PalletTown_PlayersHouse_1F_EventScript_MomOakLookingForYouMale
	call_if_eq VAR_RESULT, FEMALE, PalletTown_PlayersHouse_1F_EventScript_MomOakLookingForYouFemale
	closemessage
	applymovement LOCALID_MOM, Common_Movement_FaceOriginalDirection
	waitmovement 0
	release
	end

PalletTown_PlayersHouse_1F_EventScript_MomOakLookingForYouMale::
	msgbox PalletTown_PlayersHouse_1F_Text_AllBoysLeaveOakLookingForYou
	return

PalletTown_PlayersHouse_1F_EventScript_MomOakLookingForYouFemale::
	msgbox PalletTown_PlayersHouse_1F_Text_AllGirlsLeaveOakLookingForYou
	return

PalletTown_PlayersHouse_1F_EventScript_MomHeal::
	msgbox PalletTown_PlayersHouse_1F_Text_YouShouldTakeQuickRest
	closemessage
	call EventScript_OutOfCenterPartyHeal
	msgbox PalletTown_PlayersHouse_1F_Text_LookingGreatTakeCare
	release
	end

@ Displays special text if interacted with from side or back (which are normally inaccessible)
PalletTown_PlayersHouse_1F_EventScript_TV::
	lockall
	call_if_eq VAR_FACING, DIR_SOUTH, PalletTown_PlayersHouse_1F_EventScript_WTFBackSide
	call_if_eq VAR_FACING, DIR_WEST, PalletTown_PlayersHouse_1F_EventScript_YayRightSide
	call_if_eq VAR_FACING, DIR_NORTH, PalletTown_PlayersHouse_1F_EventScript_OopsWrongSide
	call_if_eq VAR_FACING, DIR_EAST, PalletTown_PlayersHouse_1F_EventScript_OopsLeftSide
	releaseall
	end

PalletTown_PlayersHouse_1F_EventScript_OopsWrongSide::
	msgbox PalletTown_PlayersHouse_1F_Text_OopsWrongSide
	return

PalletTown_PlayersHouse_1F_EventScript_OopsLeftSide::
	msgbox PalletTown_PlayersHouse_1F_Text_OopsLeftSide
	return

PalletTown_PlayersHouse_1F_EventScript_WTFBackSide::
	msgbox PalletTown_PlayersHouse_1F_Text_WTFBackSide
	return



PalletTown_PlayersHouse_1F_EventScript_TVScreen::
	msgbox PalletTown_PlayersHouse_1F_Text_MovieOnTVFourBoysOnRailroad
	releaseall
	end

PalletTown_PlayersHouse_1F_EventScript_TVScreenMale::
	msgbox PalletTown_PlayersHouse_1F_Text_MovieOnTVFourBoysOnRailroad
	return

PalletTown_PlayersHouse_1F_EventScript_TVScreenFemale::
	msgbox PalletTown_PlayersHouse_1F_Text_MovieOnTVGirlOnBrickRoad
	return
`
mapscripts PalletTown_PlayersHouse_1F_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		
		setvar(VAR_JUMPING_FROM_PALLET_ROOF, 0)
	}

}
script PalletTown_PlayersHouse_1F_EventScript_Plant {
	lock
	switch(var(VAR_NOT_OAK_SILLY)) {
		case 0:
			msgbox("That's not OAK, silly!", MSGBOX_AUTOCLOSE)
			break
		case 1:
			msgbox("Nope!\nThat's not OAK either!", MSGBOX_AUTOCLOSE)
			break
		case 2:
			msgbox("Nope, still not OAK!\n", MSGBOX_AUTOCLOSE)
			break
		case 3:
			msgbox("Alas, OAK isn't over here\neither.", MSGBOX_AUTOCLOSE)
			break
		case 4:
			msgbox("Upon double-checking, you find that\nthe tree is, in fact, still not OAK.", MSGBOX_DEFAULT)
			break
		case 5:
			msgbox("It's OAK!\p…\p…Wait, maybe not.\n", MSGBOX_DEFAULT)
			break
		case 6:
			msgbox("It looks kinda like a palm tree, if\nyou look at it from the right angle.\pBut it certainly doesn't look like\nOAK…\l…does it?", MSGBOX_DEFAULT)
			break
		case 7:
			msgbox("Despite your continued insistance,\nthis remains not OAK.\pOh well.\n", MSGBOX_DEFAULT)
			break
		case 8:
		case 9:
		case 10:
			msgbox("It's not OAK.\n", MSGBOX_DEFAULT)
			break
		case 11:
			msgbox("For the last time, it's not OAK.\n", MSGBOX_DEFAULT)
			setflag(FLAG_NOT_OAK_TEMP)
			break
		default:
			if(flag(FLAG_NOT_OAK_TEMP)) {
				msgbox("…\n", MSGBOX_DEFAULT)

			} else {
				msgbox("It's not OAK.\n", MSGBOX_DEFAULT)

			}
			break

	}
	addvar(VAR_NOT_OAK_SILLY, 1)
	if(var(VAR_NOT_OAK_SILLY) > 12) {
		setvar(VAR_NOT_OAK_SILLY, 12)
	}
	release
}

script PalletTown_PlayersHouse_1F_EventScript_CeliaBakemeat {
	msgbox("Volcano Bakemeat is a line from\nPokemon Vietnamese Crystal, a\lbootleg English translation.", MSGBOX_NPC)
	end
}

script PalletTown_PlayersHouse_1F_EventScript_CeliaWrongSide {
	msgbox("Fun fact!\pIn FRLG, if you use a cheat to check\nthe TV from the left or right, it'll\lsay “Oops! Wrong side!”\pThat's where the idea for this\njoke came from!\pPS: Have you found your way to the\nback side yet?", MSGBOX_NPC)
	end
}

script PalletTown_PlayersHouse_1F_EventScript_CeliaDad {
	msgbox("Dad is by far my favorite character\nto write for this hack.\pEveryone expects it to be some gross\nsexual joke or whatever, but no.\lIt's just Dad.\pAll he needs to do is show up and\nsay something kinda silly.\pHe's already conceptually so funny,\nthat almost anything I write works.", MSGBOX_NPC)
	end
}


script CeliaSecret_OutSide {
	msgbox(
	"And right here you can find the\n"
	"TV's out-side!", MSGBOX_NPC)
}

script CeliaSecret_SouthCandy {
	msgbox(
	"The candy behind the fence is here\n"
	"to draw your curiosity.\p"

	"People will likely see it before\n"
	"picking up the one in Daisy's\l"
	"house, so they'll want to know\l"
	"what it is.", MSGBOX_NPC)
}

script CeliaSecret_MarioWall {
	msgbox(
	"On one hand, I wanted the Mario 64\n"
	"warp as a big shock moment.\p"

	"On the other hand, it was WAY too\n"
	"crazy for the relatively mild\l"
	"game opening without buildup.\p"

	"Thus, I added the three-stage\n"
	"wall break to finding it.", MSGBOX_NPC)
}

script CeliaSecret_OakWall {
	msgbox(
	"One of the early ideas for the\n"
	"PALLET TOWN secret was a hole\l"
	"appearing here and drilling it.\p"

	"Sadly I found it too noticable, so\n"
	"I moved it to the house instead.", MSGBOX_NPC)
}

script CeliaSecret_ScratchPresent {
	msgbox(
	"I messed with the Scratch Present\n"
	"odds so that they never heal if the\l"
	"foe is at full health.\p"

	"This is cuz during the intro rival\n"
	"battle, if you got two Heal turns\l"
	"in a row, people would think that\l"
	"scratch was completely useless.\p"

	"Thus I had to make it always work\n"
	"on turn 1 so you'd know it can\l"
	"SOMETIMES work.", MSGBOX_NPC)
}

script CeliaSecret_GSBall {
	msgbox(
	"In the first releases of the game,\n"
	"cutting Oak triggered a Dev\l"
	"commentary quest.\p"

	"However I thought this was way too\n"
	"easy, so I made it a required quest\l"
	"event for GS Ball instead.", MSGBOX_NPC)
}




script PalletTown_PlayersHouse_1F_EventScript_YayRightSide {
	msgbox(PalletTown_PlayersHouse_1F_Text_YayRightSide)
	if(flag(FLAG_SYS_POKEDEX_GET) && !flag(FLAG_SYS_ROTOM_MENU)) {
		goto(PalletTown_PlayersHouse_GiveRotom)

	}
	release
	end
}

script PalletTown_PlayersHouse_GiveRotom {
	msgbox(
		"…Oh, hey!\n"
		"Inside the TV…", MSGBOX_DEFAULT)
		playmoncry(SPECIES_ROTOM, CRY_MODE_DEFAULT)
		waitmoncry
		msgbox(
		"There's a ROTOM hiding!\n"
		"", MSGBOX_DEFAULT)
		playfanfare(MUS_SLOTS_JACKPOT)
		msgbox(
		"ROTOM entered {PLAYER}'s\n"
		"POKéDEX!", MSGBOX_DEFAULT)
		setflag(FLAG_SYS_ROTOM_MENU)
		release
		end
}