mapscripts ViridianGym_Erika_MapScripts {
        MAP_SCRIPT_ON_TRANSITION {
        if(var(VAR_CURRENT_DMCA_PHASE) < 4) {
            setvar(VAR_CURRENT_DMCA_PHASE, 4)
        }
        setrespawn(HEAL_LOCATION_VIRIDIAN_GYM_ERIKA)
        switch(var(VAR_CURRENT_DMCA_PHASE)) {
            case 1:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM, 4)
            case 2:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_2, 4)
            case 3:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_3, 4)
            case 4:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_4, 4)
            case 5:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_5, 4)
            case 6:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_6, 4)
            case 7:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_7, 4)
            case 8:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_8, 4)
            case 9:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_9, 4)
        }
    }
}


script ViridianGym_ErikaBattle {
    lock
    textcolor(NPC_TEXT_COLOR_TREE)
    msgbox(
        "straight people\n"
        "", MSGBOX_DEFAULT)
    trainerbattle_no_intro(TRAINER_DMCA_ERIKA, ViridianGym_ErikaBattle_End)
    if(!(checkpartymove(MOVE_WATER_PLEDGE) != PARTY_SIZE && checkpartymove(MOVE_FIRE_PLEDGE) != PARTY_SIZE)) {
        msgbox(
        "The BRAVIARY uses the move\n"
        "“PLEDGE OF ALLEGIANCE.”\l"
        "This “makes FREEDOM rain!”\p"

        "The BUTTERFREE then uses SHOOT.\p"

        "You did not have the solution to\n"
        "the fight.\l"
        "You will die now.", MSGBOX_DEFAULT)
        goto(EventScript_FieldWhiteOutNoMoney)

    }
    checkpartymove(MOVE_WATER_PLEDGE)
    copyvar(VAR_TEMP_0, VAR_RESULT)
    checkpartymove(MOVE_FIRE_PLEDGE)
    copyvar(VAR_TEMP_1, VAR_RESULT)
    compare_var_to_var(VAR_TEMP_0, VAR_TEMP_1)
    if(var(VAR_RESULT)) {
        msgbox(
                "The BRAVIARY uses the move\n"
                "“PLEDGE OF ALLEGIANCE.”\l"
                "This “makes FREEDOM rain!”\p"

                "The BUTTERFREE then uses SHOOT.\p"

                "You technically did not have\n"
                "the solution to the fight.\p"

                "Yes, I am going to be anal about\n"
                "this.", MSGBOX_DEFAULT)
                goto(EventScript_FieldWhiteOutNoMoney)

    }
    removeobject(LOCALID_ERIKA_ROADBLOCK)
    msgbox(
	"Too much gay\n"
	"", MSGBOX_DEFAULT)
}

text ViridianGym_ErikaBattle_Start {
    "straight people\n"
}


text ViridianGym_ErikaBattle_End {
   "oh no\n"
}


