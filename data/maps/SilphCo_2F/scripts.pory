raw `
SilphCo_2F_MapScripts::
	map_script MAP_SCRIPT_ON_LOAD, SilphCo_2F_OnLoad
	.byte 0



SilphCo_2F_EventScript_ThunderWaveTutor::
	goto EventScript_ThunderWaveTutor
	end

SilphCo_2F_EventScript_FloorSign::
	msgbox SilphCo_2F_Text_FloorSign, MSGBOX_SIGN
	end

SilphCo_2F_EventScript_Connor::
	trainerbattle_single TRAINER_SCIENTIST_CONNOR, SilphCo_2F_Text_ConnorIntro, SilphCo_2F_Text_ConnorDefeat
	msgbox SilphCo_2F_Text_ConnorPostBattle, MSGBOX_AUTOCLOSE
	end

SilphCo_2F_EventScript_Jerry::
	trainerbattle_single TRAINER_SCIENTIST_JERRY, SilphCo_2F_Text_JerryIntro, SilphCo_2F_Text_JerryDefeat
	msgbox SilphCo_2F_Text_JerryPostBattle, MSGBOX_AUTOCLOSE
	end




`

script SilphCo_2F_OnLoad {
	call_if_unset(FLAG_SILPH_2F_DOOR_1, EventScript_Close2FDoor1)
	if(flag(FLAG_SILPH_DMCA_DEFEATED)) {
		setvar(VAR_START_SILPH_MUSIC, 1)
	}
	famechecker(FAMECHECKER_SAFFRON, 0)
}

script SilphCo_2F_EventScript_Grunt2 {
	trainerbattle_single(TRAINER_DMCA_GRUNT_24, "Grr!\pAll these staircases were identical\ncopies of each other.\pI did this place a favor and\ntook them out!", "You'll never get through!\n")
	msgbox("We're staging an executive\ntakeover of SILPH CO!\pAll copyrighted materials are\ngetting deleted.\lIncluding stairs!", MSGBOX_NPC)
}

script SilphCo_2F_EventScript_Grunt1 {
	trainerbattle_single(TRAINER_DMCA_GRUNT_23, "Nyehehe!\pWithout the stairs, this place has\nturned into a warp tile labyrinth!\pYou'll never make it through!\n", "Impossible!")
	msgbox("It's no worry.\nYou'll never make it to the BOSS!\pCopyright law is sacred!\nYou've got no chance against us!", MSGBOX_NPC)
}

script SilphCo_2F_EventScript_MissingStaircase {
	msgbox("You can make out an imprint of the\nmissing staircase.", MSGBOX_SIGN)

}

script SilphCo_2F_EventScript_ElevatorDoor {
	msgbox("Rats!\nThe door's been stapled shut!", MSGBOX_SIGN)

}

script SilphCo_2F_EventScript_TruckLady {
	setflag(FLAG_DITTO_MEW_HINT)
	msgbox(
	"Hey, you!\n"
	"I met you in VERMILION CITY.\p"

	"Y'know, I never did find where I\n"
	"parked my TRUCK.\l"
	"Did you look around for it?", MSGBOX_NPC)
}

script SilphCo_2F_EventScript_LunchSign {
	msgbox(
	"OUT TO LUNCH\n"
	"", MSGBOX_SIGN)

}

script SilphCo_2F_EventScript_JohnCage {
	msgbox(
	"JOHN CAGE: Oh, dearie…\n"
	"The DMCA stole my music!\p"

	"And now they're playing it\n"
	"outside, at full volume!", MSGBOX_NPC)
}

script SilphCo_2F_EventScript_FireMove {
	msgbox(
	"The PRESIDENT is meeting with the\n"
	"DMCA's BOSS…\l"
	"Who knows what'll come of this?\p"

	"If only MR. FLAMETHROWER were here…\n"
	"He'd know what to do!", MSGBOX_NPC)
}

script SilphCo_2F_EventScript_BlockedSign {
	msgbox(
	"This sign was once blocked, and\n"
	"now it is not.\p"

	"Alas, it doesn't actually say\n"
	"anything worthwhile.\p"

	"Oh well.\n"
	"", MSGBOX_SIGN)

}

script SilphCo_2F_EventScript_Dad {
	lock
	faceplayer
	textcolor(0)
	msgbox(
	"DAD: {PLAYER}!\n"
	"What are you doing out here?\p"

	"Golly, this building sure is\n"
	"confusing.\l"
	"These warp panels make my head spin!\p"

	"Well, never mind that\n"
	"How about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}


script SilphCo_DMCADad {
	lock
	faceplayer
	textcolor(0)
	msgbox(
	"DAD: {PLAYER}!\n"
	"What are you doing out here?\p"

	"Shh-!\n"
	"I'm in disguise!\l"
	"The DMCA thinks I'm one of them!\p"

	"Well, never mind that\n"
	"How about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}