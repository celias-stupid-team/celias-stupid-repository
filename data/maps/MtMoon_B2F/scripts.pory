raw `
.equ LOCALID_DOME_FOSSIL,  1
.equ LOCALID_HELIX_FOSSIL, 2
.equ LOCALID_MIGUEL,       3

MtMoon_B2F_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, MtMoon_B2F_OnTransition
	.byte 0

MtMoon_B2F_OnTransition::
	call_if_unset FLAG_GOT_FOSSIL_FROM_MT_MOON, MtMoon_B2F_EventScript_ShowFossils
	end

MtMoon_B2F_EventScript_ShowFossils::
	clearflag FLAG_HIDE_DOME_FOSSIL
	clearflag FLAG_HIDE_HELIX_FOSSIL
	return

MtMoon_B2F_EventScript_MiguelTrigger::
	lockall
	applymovement LOCALID_MIGUEL, Common_Movement_WalkInPlaceFasterRight
	waitmovement 0
	call MtMoon_B2F_EventScript_BattleMiguel
	releaseall
	end

MtMoon_B2F_EventScript_Miguel::
	lock
	faceplayer
	famechecker FAMECHECKER_MT_MOON, 5
	goto_if_set FLAG_GOT_FOSSIL_FROM_MT_MOON, MtMoon_B2F_EventScript_MiguelFossilPicked
	goto_if_defeated TRAINER_SUPER_NERD_MIGUEL, MtMoon_B2F_EventScript_MiguelGoPickFossil
	call MtMoon_B2F_EventScript_BattleMiguel
	release
	end

MtMoon_B2F_EventScript_BattleMiguel::
	textcolor NPC_TEXT_COLOR_MALE
	message MtMoon_B2F_Text_MiguelIntro
	waitmessage
	playbgm MUS_ENCOUNTER_GYM_LEADER, 0
	waitbuttonpress
	setvar VAR_LAST_TALKED, LOCALID_MIGUEL
	trainerbattle_no_intro TRAINER_SUPER_NERD_MIGUEL, MtMoon_B2F_Text_MiguelDefeat
	setvar VAR_MAP_SCENE_MT_MOON_B2F, 1
	msgbox MtMoon_B2F_Text_WellEachTakeAFossil
	return

MtMoon_B2F_EventScript_MiguelFossilPicked::
	msgbox MtMoon_B2F_Text_LabOnCinnabarRegeneratesFossils
	release
	end

MtMoon_B2F_EventScript_MiguelGoPickFossil::
	msgbox MtMoon_B2F_Text_WellEachTakeAFossil
	release
	end



MtMoon_B2F_Movement_MiguelToHelixFossil::
	walk_right
	walk_up
	walk_up
	walk_up
	step_end



MtMoon_B2F_EventScript_DontTakeFossil::
	release
	end

MtMoon_B2F_Movement_MiguelToDomeFossil::
	walk_up
	walk_up
	walk_up
	step_end

MtMoon_B2F_EventScript_Grunt1::
	trainerbattle_single TRAINER_DMCA_GRUNT, MtMoon_B2F_Text_Grunt1Intro, MtMoon_B2F_Text_Grunt1Defeat
	msgbox MtMoon_B2F_Text_Grunt1PostBattle, MSGBOX_AUTOCLOSE
	end

MtMoon_B2F_EventScript_Grunt2::
	trainerbattle_single TRAINER_DMCA_GRUNT_2, MtMoon_B2F_Text_Grunt2Intro, MtMoon_B2F_Text_Grunt2Defeat
	famechecker FAMECHECKER_MT_MOON, 0
	msgbox MtMoon_B2F_Text_Grunt2PostBattle, MSGBOX_AUTOCLOSE
	end

MtMoon_B2F_EventScript_Grunt3::
	trainerbattle_single TRAINER_DMCA_GRUNT_3, MtMoon_B2F_Text_Grunt3Intro, MtMoon_B2F_Text_Grunt3Defeat
	msgbox MtMoon_B2F_Text_Grunt3PostBattle, MSGBOX_AUTOCLOSE
	end

MtMoon_B2F_EventScript_Grunt4::
	trainerbattle_single TRAINER_DMCA_GRUNT_4, MtMoon_B2F_Text_Grunt4Intro, MtMoon_B2F_Text_Grunt4Defeat
	msgbox MtMoon_B2F_Text_Grunt4PostBattle, MSGBOX_AUTOCLOSE
	end
`

script MtMoon_EventScript_SolutionsSign {
	msgbox("TRAINER TIPS\pThere's actually five different\nsolutions to that fight!\pWhich one did you find?\n", MSGBOX_SIGN)
	end
}

script MtMoon_EventScript_SavestateSign {
	msgbox("WARNING!\nBe sure to savestate frequently!", MSGBOX_SIGN)
	end
}

script MtMoon_B2F_Item_SuperRepel1 {
	finditem(ITEM_SUPER_REPEL)
}

script MtMoon_B2F_Item_SuperRepel2 {
	finditem(ITEM_SUPER_REPEL)
}

script MtMoon_B2F_Item_SuperRepel3 {
	finditem(ITEM_SUPER_REPEL)
}

script MtMoon_B2F_Item_EscapeKey {
	finditem(ITEM_ESCAPE_ROPE)
}

script MtMoon_B2F_EventScript_Dad {
	lock
	faceplayer
	textcolor(0)
	msgbox("DAD: {PLAYER}!\nWhat are you doing out here?\pThat guy up there has a really\nscary POKéMON!\lNone of my moves worked on it!\pWell, never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	setflag(FLAG_DAD_MTMOON_B2F)
	release
	end
}

const ACTUAL_MIGUEL = 20
script MtMoon_B2F_EventScript_HelixFossil { //Jaw Fossil
	lock
	faceplayer
	
	famechecker(FAMECHECKER_MT_MOON, FCPICKSTATE_COLORED, UpdatePickStateFromSpecialVar8005)
	msgbox(MtMoon_B2F_Text_YouWantHelixFossil, MSGBOX_YESNO)
	goto_if_eq(VAR_RESULT, NO, MtMoon_B2F_EventScript_DontTakeFossil)
	removeobject(LOCALID_HELIX_FOSSIL)
	giveitem_msg(MtMoon_B2F_Text_ObtainedDomeFossil, ITEM_JAW_FOSSIL, 1, MUS_OBTAIN_KEY_ITEM)
	closemessage
	special(QuestLog_CutRecording)
	delay(10)
	if(flag(FLAG_GOT_DOME_FOSSIL)) {
		applymovement(ACTUAL_MIGUEL, Common_Movement_FaceRight)
		applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
		waitmovement(0)
		textcolor(NPC_TEXT_COLOR_MALE)
		msgbox("That's okay.\nI got the one I wanted.\pHey, what was that other guy doing\nhere anyway?", MSGBOX_DEFAULT)
		closemessage
		applymovement(LOCALID_MIGUEL, ProtonArrestsMiguel)
		delay(15)
		playse(SE_PIN)
		//applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceDown)
		applymovement(ACTUAL_MIGUEL, MiguelOhShit)
		delay(60)
		applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
		waitmovement(ACTUAL_MIGUEL)
		setobjectxy(ACTUAL_MIGUEL, 0, 18)
		setobjectmovementtype(ACTUAL_MIGUEL, MOVEMENT_TYPE_INVISIBLE)		// Doesn't actually seem to do anything

	} else {
		applymovement(LOCALID_MIGUEL, MtMoon_B2F_Movement_MiguelToDomeFossil)
		waitmovement(0)
		copyobjectxytoperm(LOCALID_MIGUEL)
		textcolor(NPC_TEXT_COLOR_MALE)
		playfanfare(MUS_OBTAIN_KEY_ITEM)
		msgbox("WOLFF: Then this fossil shall\nremain in custody!", MSGBOX_DEFAULT)
		waitmessage
		waitfanfare
		removeobject(LOCALID_DOME_FOSSIL)
	}
	
	setflag(FLAG_GOT_HELIX_FOSSIL)
	setflag(FLAG_GOT_FOSSIL_FROM_MT_MOON)
	release
}

movement ProtonArrestsMiguel {
	walk_slower_up * 3
	face_up
}

movement MiguelOhShit {
	face_down
	emote_exclamation_mark
	delay_16 * 3
	lock_facing_direction
	walk_up * 2
	delay_16
	unlock_facing_direction
	face_left
	delay_16 
	face_right
	delay_16
	face_left
	delay_16
	face_right
	delay_16
	face_down
	delay_8 * 6
	walk_faster_left * 7
	set_invisible
}

movement MiguelRunsUp {
	set_visible
	walk_fast_up * 5
	face_left
}

movement MiguelShovesYou {
	walk_left
	face_left
}

movement PlayerGetsShoved {
	face_right
	lock_facing_direction
	jump_2_left
	unlock_facing_direction
}



script MtMoon_B2F_EventScript_DomeFossil { //Sail fossil that you can't have
	lock
	faceplayer
	msgbox(MtMoon_B2F_Text_YouWantDomeFossil, MSGBOX_YESNO)
	goto_if_eq(VAR_RESULT, NO, MtMoon_B2F_EventScript_DontTakeFossil)	
	setflag(FLAG_GOT_DOME_FOSSIL)
	closemessage
	delay(10)
	textcolor(NPC_TEXT_COLOR_MALE)
	msgbox("Wait!!\n", MSGBOX_DEFAULT)
	closemessage
	addobject(ACTUAL_MIGUEL)
	//applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceDown) Doesn't look good 
	waitmovement(0)
	playse(SE_PIN)
	applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_ExclamationMark)
	delay(15)
	setobjectxy(ACTUAL_MIGUEL, 14, 13)
	applymovement(ACTUAL_MIGUEL, MiguelRunsUp)
	waitmovement(ACTUAL_MIGUEL)
	delay(10)
	playse(SE_WALL_HIT)
	applymovement(ACTUAL_MIGUEL, MiguelShovesYou)
	applymovement(OBJ_EVENT_ID_PLAYER, PlayerGetsShoved)
	waitmovement(OBJ_EVENT_ID_PLAYER)
	delay(30)
	applymovement(ACTUAL_MIGUEL, Common_Movement_FaceUp)
	waitmovement(0)
	msgbox("You can't have that one!\nIt's my favorite!", MSGBOX_DEFAULT)
	closemessage
	removeobject(LOCALID_DOME_FOSSIL)
	playfanfare(MUS_OBTAIN_KEY_ITEM)
	textcolor(NPC_TEXT_COLOR_DEFAULT)
	msgbox("The SAIL FOSSIL was taken…\n", MSGBOX_DEFAULT)
	waitfanfare
	//setobjectmovementtype(ACTUAL_MIGUEL, MOVEMENT_TYPE_FACE_UP)
	release
}

script MtMoon_MiguelStoleFossil {
	msgbox("Yes!\nI've always wanted a SAIL FOSSIL!\pHahaha!\nGet your own, loser!", MSGBOX_NPC)
	end
}