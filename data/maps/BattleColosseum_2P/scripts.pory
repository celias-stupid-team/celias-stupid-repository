	if((flag(FLAG_BAKED_DONUT_HINT) && checkmoncaught(SPECIES_GOLURK)) || checkmoncaught(SPECIES_DACHSBUN)) { 
		setobtainable(SPECIES_DACHSBUN) // 128
	}
	if(flag(FLAG_CSR_MAP_ALTAR_OF_MOONE) && flag(FLAG_GOT_NEBBY_ONCE)) { //TODO figure out logic
		setobtainable(SPECIES_ORTHWORM) // 129
	}
	if(flag(FLAG_CSR_MAP_ROUTE_9_FAR)) {
		setobtainable(SPECIES_OMANYTE) // 130
	}
	if(flag(FLAG_HIDE_ROUTE9_BURN_HEAL) && flag(FLAG_WORLD_MAP_CINNABAR_ISLAND)) { 
		setobtainable(SPECIES_TYRANASTAR) // 131
	}
	if(flag(FLAG_WORLD_MAP_CINNABAR_ISLAND)) { //TODO figure out logic
		setobtainable(SPECIES_SUDOWOODO) // 132
	}
	if(flag(FLAG_COPYCAT_TM)) { //TODO figure out logic
		setobtainable(SPECIES_MIMIKYU) // 133
	}
	if(flag(FLAG_CSR_MAP_MINNESOTA) && flag(FLAG_HOOPA_HINT) || flag(FLAG_BADGE08_GET)) { //TODO figure out logic
		setobtainable(SPECIES_HOOPA) // 134
	}
	if(flag(FLAG_CSR_MAP_GAME_SHOP)) {
		setobtainable(SPECIES_JIRACHI) // 135
	}
	if(flag(FLAG_TRIED_WHIRLPOOL_BATTLE) && checkmoncaught(SPECIES_SMEARGLE) && (flag(FLAG_CSR_HINT_GYM_STATUES) && checkmoncaught(SPECIES_PERSIAN)) && (checkmoncaught(SPECIES_JYNX) || checkmoncaught(SPECIES_ARTICUNO))) { //TODO figure out logic
		setobtainable(SPECIES_ARTICUNO) // 136
	}
	if(((checkmoncaught(SPECIES_FLAREON) && checkmoncaught(SPECIES_ARTICUNO)) || checkmoncaught(SPECIES_ESPEON)) && (flag(FLAG_CSR_HINT_GYM_STATUES) && checkmoncaught(SPECIES_PERSIAN))) { //TODO figure out logic
		setobtainable(SPECIES_ESPEON) // 137
	}
	if(flag(FLAG_BADGE08_GET)) { //TODO figure out logic
		setobtainable(SPECIES_ZAPDOS) // 138
	}
	if(flag(FLAG_BADGE08_GET) && checkmoncaught(SPECIES_ZAPDOS)) { //TODO figure out logic
		setobtainable(SPECIES_JOLTEON) // 139
	}
	if(flag(FLAG_WORLD_MAP_POKEMON_MANSION_1F)) { //TODO figure out logic
		setobtainable(SPECIES_MOLTRES) // 140 
	}
	if(((checkmoncaught(SPECIES_JOLTEON) && checkmoncaught(SPECIES_MOLTRES)) || checkmoncaught(SPECIES_FLAREON)) && (flag(FLAG_CSR_HINT_GYM_STATUES) && checkmoncaught(SPECIES_PERSIAN))) { //TODO figure out logic
		setobtainable(SPECIES_FLAREON) // 141
	}
	if(flag(FLAG_CSR_PHIONE_EGG)) {
		setobtainable(SPECIES_PHIONE) // 142
	}
	if(checkmoncaught(SPECIES_HAUNTER) && (flag(FLAG_CSR_HINT_GYM_STATUES) && checkmoncaught(SPECIES_PERSIAN))) { //TODO figure out logic
		setobtainable(SPECIES_ETERNATUS) // 143
	}
	if(flag(FLAG_WORLD_MAP_FOUR_ISLAND) && checkmoncaught(SPECIES_TRUBBISH_HAIRCUT) && (flag(FLAG_CSR_HINT_GYM_STATUES) && checkmoncaught(SPECIES_PERSIAN))) { //TODO figure out logic
		setobtainable(SPECIES_ZYGARDE) // 144
	}
	if(flag(FLAG_BADGE08_GET)) { //TODO figure out logic
		setobtainable(SPECIES_MELTAN) // 145
	}
	if(checkmoncaught(SPECIES_SEAKING)) { //TODO figure out logic
		setobtainable(SPECIES_ARCANINE) // 146
	}
	if(checkmoncaught(SPECIES_ARCANINE) || checkmoncaught(SPECIES_POKEMON_GUN)) { //I need to figure out which one is THE hint. Probably multiple.
		setobtainable(SPECIES_POKEMON_GUN) // 147
	}
	if(flag(FLAG_DITTO_MEW_HINT) || checkmoncaught(SPECIES_DITTO_MEW)) { //TODO figure out logic
		setobtainable(SPECIES_DITTO_MEW) // 148
	}
	if(flag(FLAG_CSR_VIRIDIAN_GYM_BACK_ROOM)) { //TODO figure out logic
		setobtainable(SPECIES_MEWTWO) // 150
	}
	if(flag(FLAG_DUGTRIO_SIGN) && flag(FLAG_GROWLITHE_SIGN) && flag(FLAG_ELECTIVIRE_SIGN) && flag(FLAG_AMBIGUOUS_STATUE_SIGN) && flag(FLAG_ONIX_TAIL_SIGN) && flag(FLAG_KINGLER_SIGN) && flag(FLAG_IVY_SIGN)) { //TODO figure out logic
		setobtainable(SPECIES_CASTFORM) // 152
	}
	if(checkmoncaught(SPECIES_BULBASAUR)) { //TODO figure out logic
		setobtainable(SPECIES_VENUSAUR) // 151
	}
return
}

