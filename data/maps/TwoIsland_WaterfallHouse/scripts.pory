mapscripts TwoIsland_WaterfallHouse_MapScripts {

}


script TwoIsland_WaterfallHouse_Message {
	if(var(VAR_TWO_ISLAND_STARMAN) == 0) {
		setvar(VAR_TWO_ISLAND_STARMAN, 1)
	}
	msgbox(
	"If you'd like to learn my secret\n"
	"Moves, find me under the WATERFALL.\p"

	"To enter, you must stand behind the\n"
	"falls for 3 Minutes without moving.\l"
	"Good luck!", MSGBOX_SIGN)

} //Add sussy Eaerthbound music here
