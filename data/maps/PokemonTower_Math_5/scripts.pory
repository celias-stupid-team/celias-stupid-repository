mapscripts PokemonTower_Math_5_MapScripts {
        MAP_SCRIPT_ON_FRAME_TABLE [
            VAR_TEMP_5, 0 { //Correct
                switch(var(VAR_POKEMONTOWER_ANSWER)) {
                    case 0:
                        break
                    case 1:
                        playse(SE_SUCCESS)
                        waitse
                        setvar(VAR_POKEMONTOWER_ANSWER, 0)
                        
                    case 2:
                        playse(SE_BOO)
                        waitse
                        setvar(VAR_POKEMONTOWER_ANSWER, 0)
                        
                }
                
                setvar(VAR_TEMP_5, 1)
                release
                end
            }

        ]  
}

script PokemonTower_Math_AfraidOfSeven {
    lock
    setflag(FLAG_EATEN_SIGNPOST)
    msgbox("Wh- w-s -ix -fraid -f s-ven?\n{LEFT_ARROW} 7     {UP_ARROW} 8     {RIGHT_ARROW} … …", MSGBOX_DEFAULT)
    clearflag(FLAG_EATEN_SIGNPOST)
    closemessage
    delay(30)
    msgbox("The final option has been devoured.\n", MSGBOX_DEFAULT)
    release
}

script PokemonTower_TerrifiedSix {
	msgbox("SIX: No…\nN-no! No!\lNot again!", MSGBOX_NPC)
	end
}