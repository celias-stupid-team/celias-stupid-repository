raw `


PokemonTower_5F_EventScript_Channeler::
	msgbox PokemonTower_5F_Text_RestHereInPurifiedSpace, MSGBOX_NPC
	end



PokemonTower_5F_EventScript_ExitPurifiedZone::
	lockall
	setvar VAR_TEMP_1, 0
	releaseall
	end

PokemonTower_5F_EventScript_Tammy::
	trainerbattle_single TRAINER_CHANNELER_TAMMY, PokemonTower_5F_Text_TammyIntro, PokemonTower_5F_Text_TammyDefeat
	msgbox PokemonTower_5F_Text_TammyPostBattle, MSGBOX_AUTOCLOSE
	end

PokemonTower_5F_EventScript_Ruth::
	trainerbattle_single TRAINER_CHANNELER_RUTH, PokemonTower_5F_Text_RuthIntro, PokemonTower_5F_Text_RuthDefeat
	msgbox PokemonTower_5F_Text_RuthPostBattle, MSGBOX_AUTOCLOSE
	end



PokemonTower_5F_EventScript_Janae::
	trainerbattle_single TRAINER_CHANNELER_JANAE, PokemonTower_5F_Text_JanaeIntro, PokemonTower_5F_Text_JanaeDefeat
	msgbox PokemonTower_5F_Text_JanaePostBattle, MSGBOX_AUTOCLOSE
	end
`
mapscripts PokemonTower_5F_MapScripts {
		MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_TEMP_5, 0 { //Correct
			switch(var(VAR_POKEMONTOWER_ANSWER)) {
				case 0:
					break
				case 1:
					playse(SE_SUCCESS)
					waitse
					setvar(VAR_POKEMONTOWER_ANSWER, 0)
					
				case 2:
					playse(SE_BOO)
					waitse
					setvar(VAR_POKEMONTOWER_ANSWER, 0)
					
			}
			
			setvar(VAR_TEMP_5, 1)
			release
			end
		}

	]
}


script PokemonTower_5F_EventScript_Twin3 {
	trainerbattle_double(TRAINER_CHANNELER_KARINA, "MAI: I love doing math!\nWhat's two plus two?\pPRA: Ooh, yeah!\nI love MAGIKARP!", "Oh no!\n", "You are insufficient.")
	msgbox("MAI: No, no, PRA.\nWe're doing Math!", MSGBOX_AUTOCLOSE)
}

script PokemonTower_5F_EventScript_Twin4 {
	trainerbattle_double(TRAINER_CHANNELER_KARINA, "MAI: I love doing math!\nWhat's two plus two?\pPRA: Ooh, yeah!\nI love MAGIKARP!", "Oh no!\n", "You are insufficient.")
	msgbox("PRA: Oh yeah, Math!\nI love that one.\pEspecially because there's no\nletters in it!", MSGBOX_DEFAULT)
}

script PokemonTower_MathQuestion_Two {
	lock
	msgbox("SQRT(121) = ?\n{LEFT_ARROW} 11     {UP_ARROW} -11     {RIGHT_ARROW} 12", MSGBOX_SIGN) //sqrt 121
	release
}

script PokemonTower_5F_Twins {
	trainerbattle_double(TRAINER_CHANNELER_KARINA, "MAI: I love doing math!\nWhat's two plus two?\pPRA: Ooh, yeah!\nI love MAGIKARP!", "Oh no!\n", "You are insufficient.")
	msgbox("MAI: No, no, PRA.\nWe're doing Math!", MSGBOX_AUTOCLOSE)
}

script PokemonTower_6F_Dad {
	lock
	faceplayer
	textcolor(0)
	if(var(VAR_TEMP_1) == 2) {
		msgbox("DAD: {PLAYER}!\nWhat are you doing out here?\pAwww.\nWhat happened to the floor?\lIt's not warm and glowy anymore!\pWell, never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)
	} else {
		msgbox("DAD: {PLAYER}!\nWhat are you doing out here?\pSay, this spot on the ground is\nreally nice!\lIt makes me all warm and tingly!\pBut never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)
	}
	call(EventScript_DadHeal)
	release
	end
}

const X1 = 7
const X2 = 8
const X3 = 9
const Y1 = 8
const Y2 = 9
const Y3 = 10
script PokemonTower_5F_EventScript_PurifiedZone {
	lock
	fadescreenswapbuffers(FADE_TO_WHITE)
	special(HealPlayerParty)
	fadescreenswapbuffers(FADE_FROM_WHITE)
	
	setvar(VAR_TEMP_1, 1)
	switch(var(VAR_TEMP_3)) {
		case 0:
			msgbox(PokemonTower_5F_Text_PurifiedZoneMonsFullyHealed)
		case 1:
			msgbox("Entered the purified and protected\nzone.\l{PAUSE 45}…Again.\p{PLAYER}'s POKéMON were fully\nhealed.", MSGBOX_DEFAULT)
		case 2:
			msgbox("{PLAYER} once again wandered into\nthe purified zone.\p{PLAYER}'s POKéMON have once again\nbeen healed.", MSGBOX_DEFAULT)
		case 3:
			msgbox("Oh? Forgot something on the other\nside, did you?\pThat's fine. Going through the\npurified zone still heals you.", MSGBOX_DEFAULT)
		case 4:
			msgbox("Ah, to bask in the warm glow of\nthe purified zone!\p{PLAYER} enjoys the brief spot of\nrespite.", MSGBOX_DEFAULT)
		case 5:
			msgbox("Perhaps it's the pleasant white\nflash that draws {PLAYER} in so.\pAh, what a fine flash.\nHow about we see it again?", MSGBOX_DEFAULT)
		case 6:
			msgbox("There we are!\nAbsolutely beautiful!\pYes, now that we've experienced\nthe lovely white flash, we can\lbe on our way.", MSGBOX_DEFAULT)
		case 7:
			msgbox("Er…\nAhem. Let me repeat myself:\pNow that we have experienced the\nlovely{PAUSE 20} white{PAUSE 20} flash,{PAUSE 40}\lwe can be on our way.", MSGBOX_DEFAULT)
		case 8:
			msgbox("It's not OAK.\n", MSGBOX_DEFAULT)

		case 9:
			msgbox("Oh?\nReally?\pNot even the cute callback to an old\njoke is going to make you stop?", MSGBOX_DEFAULT)
		case 10:
			msgbox("Okay but seriously.\nDad is RIGHT THERE.\pWhy can't we just heal with him?\n", MSGBOX_DEFAULT)
		case 11:
			msgbox("No?\nYou're truly insisting we do this?\pIs there some pleasure you derive\nfrom stepping in and out of here?", MSGBOX_DEFAULT)
		case 12:
			msgbox("Mayhaps you're hoping to find some\nkind of secret?\pMaybe a hidden SHINY POKéMON will\nappear for all your efforts?", MSGBOX_DEFAULT)
		case 13:
			msgbox("Well I regret to inform you that\nnothing else is tied to this event.\pNothing but my increasingly-inane\nramblings on.", MSGBOX_DEFAULT)
		case 14:
			msgbox("Oh…\nOh dear.\lThat IS why you're here, isn't it?", MSGBOX_DEFAULT)
		case 15:
			msgbox("You want nothing more than to see\nhow far my narration spirals down?\lTo see me lose my grip?\pHmph. How childish.\nI won't play that game.", MSGBOX_DEFAULT)
		case 16:
			msgbox("If that's what you're up to, then\nbe my guest!\pYou won't be hearing any more\nfrom me!", MSGBOX_DEFAULT)
		case 20:
			msgbox("OH, FOR PETE'S SAKE.\nWOULD YOU JUST STOP IT?\pHrrrrm.\nNow I've had it!\pYou've really made me lose my\ntemper now!\pFine then.\nYou've made your bed.\lNow sleep in it!", MSGBOX_DEFAULT)
			closemessage
			delay(30)
			    setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 3)
				setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 3)
				setvar(VAR_SHAKESCREEN_NUM_SHAKES, 2)
				setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 1)
				setmetatile(X1, Y1, 0x282, FALSE)
				setmetatile(X2, Y1, 0x282, FALSE)
				setmetatile(X3, Y1, 0x282, FALSE)
				setmetatile(X1, Y2, 0x282, FALSE)
				setmetatile(X2, Y2, 0x282, FALSE)
				setmetatile(X3, Y2, 0x282, FALSE)
				setmetatile(X1, Y3, 0x282, FALSE)
				setmetatile(X2, Y3, 0x282, FALSE)
				setmetatile(X3, Y3, 0x282, FALSE)
				playse(SE_CLICK)
				special(DrawWholeMapView)
				special(ShakeScreen)
				delay(90)
				msgbox("There.\pI hope you're happy with yourself.\n", MSGBOX_DEFAULT)
			setvar(VAR_TEMP_1, 2)
		default:
			nop

	}
	addvar(VAR_TEMP_3, 1)
	release
}