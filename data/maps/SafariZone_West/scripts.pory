raw `


SafariZone_West_EventScript_RestHouseSign::
	msgbox SafariZone_West_Text_RestHouse, MSGBOX_SIGN
	end

SafariZone_West_EventScript_LostTeethNotice::
	famechecker FAMECHECKER_FUSHCIA 4
	setflag FLAG_CSR_HINT_GOLD_TEETH
	msgbox SafariZone_West_Text_PleaseFindWardensLostTeeth, MSGBOX_SIGN
	end

SafariZone_West_EventScript_TrainerTips::
	msgbox SafariZone_West_Text_SearchForSecretHouse, MSGBOX_SIGN
	end

SafariZone_West_EventScript_AreaSign::
	msgbox SafariZone_West_Text_AreaSign, MSGBOX_SIGN
	end
`
mapscripts SafariZone_West_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		switch(var(VAR_CSR_SAFARI_ZONE_EVOLUTION)) {
			case 0: //Charizard
				setflag(FLAG_TEMP_2)
				setflag(FLAG_TEMP_3)
				setvar(VAR_CSR_SAFARI_ZONE_EVOLUTION, 1)
			case 1:
				setflag(FLAG_TEMP_1)
				setflag(FLAG_TEMP_3)
				setvar(VAR_CSR_SAFARI_ZONE_EVOLUTION, 2)
			case 2:
				setflag(FLAG_TEMP_1)
				setflag(FLAG_TEMP_2)
				clearflag(FLAG_CSR_HIDE_MUSIC_GIRL)
				setvar(VAR_CSR_SAFARI_ZONE_EVOLUTION, 0)
		}
	}
}

script SafariZone_West_MusicGirl {
	msgbox("Hey, where's that music coming\nfrom?", MSGBOX_NPC)
	end
}

script SafariZone_West_SecretHouse {
	msgbox("SECRET HOUSE\nNow offering prizes!\l- SAFARI ZONE, LLC.", MSGBOX_SIGN)
	end
}

script SafariZone_West_PitSign {
	lock
	addobject(LOCALID_CHUCKSTER)
	setobjectxy(LOCALID_CHUCKSTER, 9, 30)
	applymovement(LOCALID_CHUCKSTER, SafariZone_ChucksterApproaches)
	msgbox("TRAINER TIPS!\pVisit the SECRET HOUSE for\na great prize!\p…\pDumbass.\n", MSGBOX_DEFAULT)
	closemessage
	waitmovement(0)
	copyobjectxytoperm(LOCALID_CHUCKSTER)
	setobjectmovementtype(LOCALID_CHUCKSTER, MOVEMENT_TYPE_FACE_UP)
	release
	end
}

movement SafariZone_ChucksterApproaches {
	delay_16 * 2
	set_visible
	walk_right * 7
	walk_up * 2
	face_up
}

script SafariZone_GruncleStan {
	msgbox(
	"My EX-WIFE still misses me…\p"

	"{PAUSE 30}…But her aim is gettin' better!\n"
	"", MSGBOX_NPC)
}


script SafariZone_Remoraid {
	lock
	playmoncry(SPECIES_OCTILLERY, CRY_MODE_DEFAULT)
	msgbox(
	"REMORAID used LOCK-ON!\n"
	"", MSGBOX_DEFAULT)
	waitmoncry
	release
}