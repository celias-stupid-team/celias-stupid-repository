raw `


Route14_EventScript_RouteSign::
	msgbox Route14_Text_RouteSign, MSGBOX_SIGN
	end
`

script Route15_PokeRap_Trainer1 {
    trainerbattle_single(TRAINER_POKERAP_1, "Okay, guys!\nWe gotta rap some POKéMON!", "Placeholder Defeat", Route15_PokeRap_Trainer1_Defeat)
    msgbox("Diglett done by Jogaklaa!\pMankey done by PKMNTRAINERSPRITERC")
    release
}

mapscripts Route14_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setbench(BENCH_ROUTE14)
    }
}

script Route14_ThankYouSign {
	msgbox("Thank you to everyone who\ncontributed!\pMay we all remember to have fun!\n-Celia, the creator", MSGBOX_SIGN)
	end
}

script Route15_PokeRap_Trainer1_Defeat {
    setvar(VAR_0x8004, SPECIES_DIGLETT)
    special(SetSeenMon)
    setvar(VAR_0x8004, SPECIES_NIDORAN_M)
    special(SetSeenMon)
    setvar(VAR_0x8004, SPECIES_MANKEY)
    special(SetSeenMon)
    release
}

