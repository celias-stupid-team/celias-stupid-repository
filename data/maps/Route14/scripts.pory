script Route15_Pokerap_Dad {
	lock
	faceplayer
	textcolor(0)
	msgbox("DAD: Whoa!\nCatch your breath, man!", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}