mapscripts Silph_HubRoom_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        if(flag(FLAG_SILPH_WARP_HOSTAGES)) {
            setmetatile(10, 7, METATILE_SilphCo_SilphWarp, FALSE)
        }
        if(flag(FLAG_SILPH_WARP_PRESIDENT)) {
            setmetatile(7, 10, METATILE_SilphCo_SilphWarp, FALSE)
        }
        if(flag(FLAG_SILPH_WARP_BALLS)) {
            setmetatile(14, 5, METATILE_SilphCo_SilphWarp, FALSE)
        }
        if(flag(FLAG_SILPH_WARP_LARRY)) {
            setmetatile(6, 5, METATILE_SilphCo_SilphWarp, FALSE)
        }
        if(flag(FLAG_SILPH_WARP_THREE_ISLAND)) {
            setmetatile(13, 10, METATILE_SilphCo_SilphWarp, FALSE)
        }
        
        
        
    }
}

script SilphCo_Activate_Warp_Callcenter {
    setflag(FLAG_SILPH_WARP_CALLCENTER)
    setvar(VAR_TEMP_0, 1)
    release
}

script SilphCo_Activate_Warp_RD {
    setflag(FLAG_SILPH_WARP_RD)
    setvar(VAR_TEMP_0, 1)
    release
}
