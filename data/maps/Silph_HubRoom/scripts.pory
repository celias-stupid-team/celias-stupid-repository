}

script SilphCo_Warp_Callcenter_Label {
    if(flag(FLAG_SILPH_WARP_CALLCENTER)) {
        msgbox(
        "SILPH CO\n"
        "Call Center", MSGBOX_SIGN)
    } else {
        msgbox(
        "This warp is dead.\p"

        "Someone killed it.\n"
        "", MSGBOX_SIGN)
    }
}
