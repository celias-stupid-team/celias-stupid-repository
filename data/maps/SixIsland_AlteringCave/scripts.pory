raw `


SixIsland_AlteringCave_OnTransition::
	setworldmapflag FLAG_WORLD_MAP_SIX_ISLAND_ALTERING_CAVE
	end
`

mapscripts SixIsland_AlteringCave_MapScripts {
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_USED_W_EMBLEM, 1 {
			if(checkmoncaught(SPECIES_WOOBAT)) {
				setvar(VAR_USED_W_EMBLEM, 0)
				release
				end
			}
			delay(10)
			playmoncry(SPECIES_ZUBAT, CRY_MODE_DEFAULT)
			waitmoncry
			msgbox(
			"… … …\n"
			"… … …\p"

			"There's no response.\n"
			"Looks like that wasn't quite it.\p"

			"Still, the POKéMON here seem to\n"
			"have noticed…\l"
			"You're on the right track.", MSGBOX_DEFAULT)
				setvar(VAR_USED_W_EMBLEM, 0)
				release
				end

		}
	]
}



script AlteringCave_ABC {
	famechecker(FAMECHECKER_GREAT_SEA_CENTER, 5)
	lockall
	braillemessage(AlteringCave_Braille_DEFGHI)
	waitbuttonpress
	releaseall
}

