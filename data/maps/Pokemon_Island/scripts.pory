mapscripts Pokemon_Island_MapScripts {
}


script PokemonIsland_Kingler {
	lock
	msgbox(
	"Millions of years of evolution\n"
	"have culminated in the creation\l"
	"of this exact rock.", MSGBOX_DEFAULT)
	if(!flag(FLAG_KINGLER_SIGN)) {
		closemessage
		delay(10)
		playfanfare(MUS_SLOTS_WIN)
		msgbox("{PLAYER} discovered a\nPOKéMON SIGN!", MSGBOX_DEFAULT)
		waitfanfare
		delay(10)
		setflag(FLAG_KINGLER_SIGN)
	}
	release
}