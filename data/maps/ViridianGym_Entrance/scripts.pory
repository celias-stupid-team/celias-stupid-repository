mapscripts ViridianGym_Entrance_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        
        switch(var(VAR_CURRENT_DMCA_PHASE)) {
            case 0:
                setdynamicwarp(MAP_ROUTE1, 0)
            case 1:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM, 1)
            case 2:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_2, 1)
            case 3:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_3, 1)
            case 4:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_4, 1)
            case 5:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_5, 1)
            case 6:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_6, 1)
            case 7:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_7, 1)
            case 8:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_8, 1)
            case 9:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_9, 1)
        }
    }
}


script ViridianGym_Entrance_Trainer {
    trainerbattle_single(TRAINER_DMCA_GRUNT_35, "Hold it right there!\pYou're ten thousand light years\naway from stopping the DMCA!", "Fuck.")
    msgbox("Our ADMIN up ahead has an\ninvincible POKéMON!\pIt's immune to both physical AND\nspecial attacks.\lYou'll never get through!", MSGBOX_NPC)
}