	releaseall
	end

PalletTown_EventScript_PlayersHouseSign::
	msgbox PalletTown_Text_PlayersHouse, MSGBOX_SIGN
	end

PalletTown_EventScript_RivalsHouseSign::
	msgbox PalletTown_Text_RivalsHouse, MSGBOX_SIGN
	end

PalletTown_EventScript_TownSign::
	msgbox PalletTown_Text_TownSign, MSGBOX_SIGN
	end


PalletTown_EventScript_SignLadyStartShowSign::
	applymovement LOCALID_PALLET_SIGN_LADY, Common_Movement_FacePlayer
	waitmovement 0
	call PalletTown_EventScript_SignLadyShowSign
	release
	end
`
script PalletTown_OnTransition {
	if(var(VAR_JUMPING_FROM_PALLET_ROOF) > 0) {
		applymovement(LOCALID_PLAYER, Common_Movement_FaceLeft)
		playbgm(MUS_NONE, TRUE)
	}
	setworldmapflag (FLAG_WORLD_MAP_PALLET_TOWN)
	call(SetPlayerPokedexValues)
	famechecker(FAMECHECKER_PALLET, 0)
	famechecker(FAMECHECKER_PALLET, 1)
	famechecker(FAMECHECKER_PALLET, 5)
	famechecker(FAMECHECKER_PALLET, FCPICKSTATE_COLORED, UpdatePickStateFromSpecialVar8005)
	
	if(flag(FLAG_PT_NPC_SIGN_LADY)) {
		setobjectxyperm(1, 12, 2)
		setobjectmovementtype(1, MOVEMENT_TYPE_FACE_RIGHT)
	} else {
		setobjectxyperm(1, 5, 15)
		setobjectmovementtype(1, MOVEMENT_TYPE_FACE_UP)
	}
	if(flag(FLAG_PALLET_IMPOSTER_OAK)) {	
			setmetatile(1, 4, 0x009, FALSE)
			setmetatile(1, 5, 0x00F, FALSE)
	}
}

script PalletTown_EventScript_JumpFromRoof {
	playse(SE_LEDGE)
	applymovement(LOCALID_PLAYER, moves(
		jump_2_left
		face_left
		delay_16 * 3
	))
	waitmovement(0)
	playse(SE_FALL)
	applymovement(LOCALID_PLAYER, moves(
		lock_facing_direction
		slide_down * 2
		unlock_facing_direction
	))
	waitmovement(0)
	setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 2)
    setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 2)
    setvar(VAR_SHAKESCREEN_NUM_SHAKES, 2)
    setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
	playse(SE_WALL_HIT)
	special(ShakeScreen)
	delay(60)
	setvar(VAR_JUMPING_FROM_PALLET_ROOF, 0)
	if(!flag(FLAG_CELIA_SECRET_PALLET)) {
		setflag(FLAG_CELIA_SECRET_PALLET)
		applymovement(LOCALID_PALLET_CELIA, Common_Movement_WalkLeft)
		waitmovement(LOCALID_PALLET_CELIA)
		playse(SE_LEDGE)
		applymovement(LOCALID_PALLET_CELIA, moves(
			jump_2_left
			face_left
			delay_16 * 3

		))
		waitmovement(0)
		playse(SE_FALL)
		applymovement(LOCALID_PALLET_CELIA, moves(
			lock_facing_direction
			slide_down * 2
			unlock_facing_direction
			
		))
		waitmovement(0)
		playse(SE_WALL_HIT)
		applymovement(LOCALID_PLAYER, moves(
			face_right
			lock_facing_direction
			jump_left
			unlock_facing_direction
		))
		waitmovement(LOCALID_PLAYER)
		delay(30)
		textcolor(NPC_TEXT_COLOR_FEMALE)
		msgbox("Woah, there!\nIt's me: CELIA, the creator.\lSorry about the landing!\pI hope you don't mind sleeping\nwith a giant hole in your wall.\lThose winter nights'll be rough!\pBut hey, while I'm here: How about\nyou give this a try next?", MSGBOX_DEFAULT)
		setvar(VAR_CSR_CURRENT_CELIA_SECRET, CELIA_SECRET_PALLET)
		call(CeliaSecrets_CeliaTellsYouNextHint)
		applymovement(LOCALID_PALLET_CELIA, moves(
			face_right
			delay_16 * 2
			lock_facing_direction
			walk_slow_up * 2
			face_right
			delay_16
			walk_slow_right
			face_right
			delay_16
		))
		waitmovement(LOCALID_PALLET_CELIA)
		playse(SE_EXIT)
		removeobject(LOCALID_PALLET_CELIA)
	}
	playbgm(MUS_PALLET, TRUE)
}

script PalletTown_EventScript_CeliaLookLook {
	msgbox("The girl throwing herself into\nthe woods was originally a bug!\pBut it was so funny that there was\nno way I was gonna remove it.\pThat said, even though it was funny,\npeople still kept reporting it.\pSo, I changed the sign to explicitly\ndirect the player to try it.", MSGBOX_NPC)
	end
}
script PalletTown_EventScript_SignLady_CSR {
	lock
	if(flag(FLAG_PT_NPC_SIGN_LADY)) {
		faceplayer
		
		//applymovement(LOCALID_PLAYER, Common_Movement_FaceLeft)
		clearflag(FLAG_PT_NPC_SIGN_LADY)
		call(PalletTown_EventScript_SignLadyShowSign)
	} else {
		setflag(FLAG_CSR_TALKED_TO_SIGN_GIRL)
		msgbox(format("Hmm...\nIs that right..."), MSGBOX_DEFAULT)
		applymovement(VAR_LAST_TALKED, Common_Movement_FacePlayer)
		waitmovement(0)
		playse(SE_PIN)
		applymovement(VAR_LAST_TALKED, PT_exclmark)
		waitmovement(0)
		delay(48)
		msgbox(format("Oh!\nLook, look!"), MSGBOX_DEFAULT)
		closemessage
		switch(var(VAR_FACING)) {
			case DIR_EAST:
					applymovement(VAR_LAST_TALKED, PT_walkbackRight)
					waitmovement(0)
					break
				default:
					applymovement(VAR_LAST_TALKED, PT_walkbackLeft)
					waitmovement(0)
					break
		}
	}
	release
}

script PalletTown_EventScript_TrainerTips {
	lockall
	if(flag(FLAG_CSR_TALKED_TO_SIGN_GIRL)) {
		msgbox(format("TRAINER TIPS\pTalk to her again!"), MSGBOX_SIGN)
	} else {
		msgbox(format("TRAINER TIPS\pTalk to her!"), MSGBOX_SIGN)
	}
	releaseall
}

script PalletTown_EventScript_LabMissed {
	lockall
	msgbox(format("Oops, you missed!"), MSGBOX_AUTOCLOSE)
	releaseall
}



script PalletTown_EventScript_SignLadyTrigger {
	lockall
	clearflag(FLAG_PT_NPC_SIGN_LADY)
	applymovement(LOCALID_PALLET_SIGN_LADY, Common_Movement_WalkInPlaceFasterRight)
	applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterLeft)
	waitmovement(0)
	call(PalletTown_EventScript_SignLadyShowSign)
	releaseall
}

script PalletTown_EventScript_SignLadyShowSign {
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(PalletTown_Text_LookCopiedTrainerTipsSign, MSGBOX_DEFAULT)
	closemessage
	delay(20)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	setflag(FLAG_OPENED_START_MENU)
	setvar(VAR_MAP_SCENE_PALLET_TOWN_SIGN_LADY, 1)
	setvar(SIGN_LADY_READY, FALSE)
	special(SetWalkingIntoSignVars)
	special(DisableMsgBoxWalkaway)
	signmsg
	msgbox("TRAINER TIPS!\p…\n", MSGBOX_DEFAULT)
	closemessage
	delay(20)
	normalmsg
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox("…I forgot the rest.\n", MSGBOX_DEFAULT)
	setvar(VAR_MAP_SCENE_PALLET_TOWN_PROFESSOR_OAKS_LAB, 5)
	return
}


//movements
movement PT_exclmark {
	emote_exclamation_mark
}

movement PT_walkbackLeft {
	walk_left
	walk_in_place_faster_right
	step_end
}

movement PT_walkbackRight {
	walk_right
	walk_in_place_faster_left
	step_end
}

script PalletTown_EventScript_CeliaYouMissed {
	msgbox("There's an easter egg if you miss\nwhen going to Oak's Lab.\pIt's a small reference to an old\nRBY softlock.", MSGBOX_NPC)
	end
}

const IMPOSTER_OAK = 7
const INVISIBLE_OAK = 8
script PalletTown_ImposterOak {
	lock
	if(flag(FLAG_PALLET_IMPOSTER_OAK)) {
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		msgbox("Ooh, look!\nThere's a path through the trees!", MSGBOX_DEFAULT)
		release
		end
	}
	if(!checkitem(ITEM_WAILMER_PAIL)) {
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		msgbox("Something about this tree in\nparticular feels... off.", MSGBOX_DEFAULT)
		playmoncry(SPECIES_SUDOWOODO, CRY_MODE_NORMAL)
		waitmoncry
	} else {
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		msgbox("Something about this tree in\nparticular feels... off.\pWould you like to WATER it?", MSGBOX_YESNO)
		if(var(VAR_RESULT)) {
			msgbox("{PLAYER} watered the tree…\n", MSGBOX_DEFAULT)
			fadeoutbgm(1)
			removeitem(ITEM_WAILMER_PAIL)
			additem(ITEM_EMPTY_PAIL)
			closemessage
			delay(10)
			playbgm(MUS_CSR_IMPOSTER_OAK, TRUE)
			delay(20)
			applymovement(IMPOSTER_OAK, Common_Movement_FaceUp) // open eyes
			waitmovement(0)
			delay(60)
			applymovement(IMPOSTER_OAK, Common_Movement_FaceLeft)
			delay(10)
			applymovement(IMPOSTER_OAK, Common_Movement_FaceUp)
			delay(20)
			applymovement(IMPOSTER_OAK, Common_Movement_FaceLeft)
			delay(10)
			applymovement(IMPOSTER_OAK, Common_Movement_FaceUp)
			delay(60)
			textcolor(NPC_TEXT_COLOR_TREE)
			msgbox("{FONT_SMALL}OAK?: Wha-… Hey!\nWhat's the big idea?\pThis spot here is mine!\nI've been here since the beginning.\pAh forget it.\nI don't need to take this.", MSGBOX_DEFAULT)
			closemessage
			fadescreen(FADE_TO_BLACK)
			setflag(FLAG_PALLET_IMPOSTER_OAK)
			removeobject(IMPOSTER_OAK)
			removeobject(INVISIBLE_OAK)
			playse(SE_EXIT)
			fadeoutbgm(1)
			setmetatile(1, 4, 0x009, FALSE)
			setmetatile(1, 5, 0x00F, FALSE)
			waitse
			fadescreen(FADE_FROM_BLACK)
			delay(90)
			fadedefaultbgm
			
		}
	}
	release
	end
}

script PalletTown_TV_Outside {
	msgbox("Ohohoho!\nOut-side!", MSGBOX_SIGN)
	end
}