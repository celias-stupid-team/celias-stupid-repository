raw `

Route13_EventScript_TrainerTips1::
	msgbox Route13_Text_LookToLeftOfThatPost, MSGBOX_SIGN
	end

Route13_EventScript_TrainerTips2::
	msgbox Route13_Text_SelectToSwitchItems, MSGBOX_SIGN
	end

Route13_EventScript_RouteSign::
	msgbox Route13_Text_RouteSign, MSGBOX_SIGN
	end
`

mapscripts Route13_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setvar(VAR_TEMP_1, 53)
		if(flag(FLAG_ROUTE13_SIGN_BACK_HOME)) {
			setvar(VAR_TEMP_1, 17)
			setobjectxyperm(LOOK_SIGN, 17, 14)

		}
		setflag(FLAG_SHINY_CREATION) // Venonat
	}
}

script Route13_SignItem {
	lock
	if(flag(FLAG_ROUTE13_SIGN_BACK_HOME) || var(VAR_TEMP_1) == 17) {
		if(flag(FLAG_FOUND_ZINC)) {
			msgbox("There was ZINC here.\n", MSGBOX_DEFAULT)
			release
			end
		}
		setflag(FLAG_FOUND_ZINC)
		setvar(VAR_LAST_TALKED, 30)
		finditem(ITEM_ZINC)
	} else {
		msgbox("There's nothing here… {PAUSE 20}yet.\n", MSGBOX_DEFAULT)
			release
	}
}

script Route13_SpeedupTip {
	msgbox("TRAINER TIPS\pThe Speedup option is in your\nemulator.\pRemember to use it when needed!\n", MSGBOX_SIGN)
	end
}

script Route13_TheMountains {
	msgbox("The Mountains\n", MSGBOX_SIGN)
	end
}

script Route13_LookLookSign {
	lock
	playse(SE_PIN)
	applymovement(VAR_LAST_TALKED, Common_Movement_ExclamationMark)
	delay(60)
	if(var(VAR_TEMP_1) == 17) {
		setflag(FLAG_ROUTE13_SIGN_BACK_HOME)
		msgbox("Oh my goodness-!\nI… I'm back home!\pThank you so much for bringing\nme here.\pI am forever in your debt.\n", MSGBOX_DEFAULT)
	} else {
		
		msgbox("TRAINER TIPS!\pLook, look!\nTo the right of this sign!", MSGBOX_DEFAULT)
		closemessage
		delay(30)
		specialvar(VAR_RESULT, GetPlayerFacingDirection)
		if(var(VAR_RESULT) == DIR_EAST) {
			addvar(VAR_TEMP_1, 1)
			applymovement(VAR_LAST_TALKED, Common_Movement_WalkRight)
			waitmovement(0)

		} else {
			subvar(VAR_TEMP_1, 1)
			applymovement(VAR_LAST_TALKED, Common_Movement_WalkLeft)
			waitmovement(0)

		}
		copyobjectxytoperm(VAR_LAST_TALKED)
	}
	release
}



const SNORLAX = 2
script Route13_Snorlax {
	lock
	setrespawn(HEAL_LOCATION_ROUTE12)
	setflag(FLAG_SYS_SNORLAX_FIGHT)
	msgbox("A POKéMON is asleep on the road.\nThere's no way around it.\pLooks like it's time to get through\nby force!", MSGBOX_DEFAULT)
	setwildbattle(SPECIES_SNORLAX, 30)
	waitse
	playmoncry(SPECIES_SNORLAX, CRY_MODE_ENCOUNTER)
	delay(40)
	waitmoncry
	dowildbattle
	clearflag(FLAG_SYS_SPECIAL_WILD_BATTLE)
	msgbox("The SNORLAX ran off to the\nmountains…", MSGBOX_DEFAULT)
	closemessage
	fadescreen(FADE_TO_BLACK)
	playmoncry(SPECIES_SNORLAX, CRY_MODE_NORMAL)
	waitmoncry
	clearflag(FLAG_SYS_SNORLAX_FIGHT)
	removeobject(SNORLAX)
	fadescreen(FADE_FROM_BLACK)
	release
	end
}

script Route13_Approaching_From_Behind_Ledge {
	setflag(FLAG_APPROACHING_ROUTE_14_FROM_ABOVE)
	setvar(VAR_TEMP_2, 1)
}

script Route13_Artist {
	msgbox("At long last, I have completed\nmy life's work!\pI've painted photorealistic fences\nall along the grass on this route!\lMy artistic genius knows no limits!", MSGBOX_NPC)
	end
}

script Route13_Artist_Two {
	msgbox("At long last, I have completed\nmy life's work!\pI've painted photorealistic,\nanimated water behind the trees!\lMy genius continues to impress!\pYes, the water back there is\ncompletely intentional and not the\lresult of a developer oversight.\pHow could you possibly imply such\na thing about my artistic vision?", MSGBOX_NPC)
	end
}

script Route13_Fence {
	msgbox("This patch of grass has been\nintricately painted to resemble\la fence.", MSGBOX_SIGN)
	end
}

script Route13_WrongTurnSign {
	msgbox("TRAINER TIPS!\pDon't make a wrong turn!\n", MSGBOX_SIGN)
	end
}

script Route13_StuckDad {
	lock
	faceplayer
	textcolor(0)
	msgbox("DAD: {PLAYER}!\nWhat are you doing out here?\pI was making my way through the maze\nbut I think I took a wrong turn.\lDo you know the way out?\pWell, never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}

const LASS = 1

script Route13_LassAttack {
	lock
	playbgm(MUS_ENCOUNTER_GIRL, TRUE)
	setflag(FLAG_ROUTE13_HIDE_DAD)
	delay(60)
	special(SpawnCameraObject)
	applymovement(LOCALID_CAMERA, Route13_CameraPansLeft)
	delay(100)
	addobject(LASS)
	applymovement(LASS, Route13_LassComesUp)
	delay(60)
	waitmovement(0)
	applymovement(LASS, Route13_MazeMovement)
	applymovement(LOCALID_CAMERA, Route13_MazeMovement)
	delay(60)
	waitmovement(0)
	playse(SE_PIN)
	applymovement(LASS, Route13_LassOops)
	delay(300)
	applymovement(LOCALID_CAMERA, Route13_BackOnTrack)
	waitmovement(LASS)
	applymovement(LASS, Route13_LastSteps)
	applymovement(LOCALID_CAMERA, Route13_LastSteps)
	waitmovement(0)
	delay(40)
	special(RemoveCameraObject)
	textcolor(NPC_TEXT_COLOR_FEMALE)
	clearflag(FLAG_ROUTE13_HIDE_DAD)
	msgbox("Hey!\nDon't look at me!", MSGBOX_DEFAULT)
	playbgm(MUS_ROUTE11, TRUE)
	trainerbattle_no_intro(TRAINER_LASS_FENCES, "Hey!")
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox("Aww, man.\nAll these fences are see-through!\pOh well.\n", MSGBOX_DEFAULT)
	closemessage
	delay(60)
	applymovement(LASS, Route13_LassLeaves)
	waitmovement(0)
	setobjectxy(LASS, 35, 9)
	setobjectxyperm(LASS, 35, 9)
	setvar(VAR_ROUTE13_LASS_ATTACK, 1)
	setflag(FLAG_ROUTE13_LASSATTACK)
	release
	end
}

script Route13_LassPostAttack {
	lock
	msgbox("Oh, rats.\nI went the wrong way…", MSGBOX_DEFAULT)
	closemessage
	playse(SE_PIN)
	faceplayer
	applymovement(VAR_LAST_TALKED, Common_Movement_ExclamationMark)
	delay(60)
	msgbox("Hey!\nStop it!", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	applymovement(VAR_LAST_TALKED, Route13_LassLeavesAgain)
	waitmovement(0)
	setflag(FLAG_ROUTE13_LASS_2)
	removeobject(LASS)
	release
}

movement Route13_LassLeavesAgain {
	walk_left
	walk_up * 2
	walk_left * 8
}

movement Route13_LassLeaves {
	walk_left * 8
}

movement Route13_CameraPansLeft {
	walk_left
	walk_fast_left
	walk_faster_left
	walk_fastest_left * 46
	walk_faster_left
	walk_fast_left
	walk_left
}

movement Route13_LassComesUp {
	walk_up * 5
	face_up
	delay_16 * 2
	face_right
	lock_facing_direction
	walk_slow_left
	face_right
	unlock_facing_direction
	delay_16 * 2
	walk_fast_right
}

movement Route13_MazeMovement {
	walk_fast_right * 16
	walk_fast_up * 2
	walk_fast_right * 7
	walk_fast_up * 2
	walk_fast_right * 6
	walk_fast_up * 2	
	walk_fast_right * 12
	walk_fast_down * 2
	walk_fast_left * 8
	walk_fast_down * 2
	walk_fast_right * 10
	walk_fast_down * 2
	walk_fast_left * 2
	walk_fast_down * 2
	walk_fast_right * 6
	walk_right * 2
	face_right
}

movement Route13_LassOops {
	emote_exclamation_mark
	delay_16 * 4
	lock_facing_direction
	walk_slow_left
	face_right
	unlock_facing_direction
	delay_16 * 4
	walk_left * 7
	walk_up * 2
	walk_right * 7
}

movement Route13_BackOnTrack {
	walk_slow_up * 2
}

movement Route13_LastSteps {
	walk_right * 3
}


script CeliaSecrets_Bonus_SnorlaxPuzzle {
	msgbox("I tried so hard to make an\ninteresting puzzle out of this\lSNORLAX.\pAlas, no matter what I tried\nI couldn't think of anything fun.\pThus, he blows up in your face.\n", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_SignSide {
	msgbox("If you want to know the level of\ndetail I strive for:\pI spent at least an hour agonizing\nover whether this sign should be on\lthe right or left of the snorlax.\pIt's right.\nDefinitely right.\p…\puh\nI think", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_SkipRoute {
	msgbox("This route is so fucking boring\nin vanilla.\lI had no clue what to do with it.\pI settled on “Let you ignore all\nof it.”", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_LeftOfSign {
	msgbox("The “Look! To the left of\nthis sign!” thing in vanilla\lwas always so weird.\pThe hidden item is… to the\nfucking left of it.\pUnless it means from the player\ncharacter's POV, and you'd have to\luse spacial reasoning for it?\pIdk, it's fucky.\n", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_PhotorealisticWater {
	msgbox("I'm very good at programming.\n", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_RapSkip {
	msgbox("As much fun as the pokerap is, I'd\nnever force someone to do all of it\pThe joke here is that this stretch\nin Kanto is basically just a giant\lline of trainers.\pI just put them a little closer\ntogether.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_RapSong {
	msgbox("To my knowledge, I was the first\nperson to make a midi pokerap.\pI couldn't find any fan ones made\nonline, so I had to do it myself.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_DadRap {
	msgbox("Did you notice that Dad here is the\nRap's entry for Mr. Mime?", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_Thesis {
	msgbox("This right here is my thesis\nstatement for this game.\pIf you come away from this hack\nwith nothing else, let it be this:\lYour creative work is valuable!\pAll art is a conversation, and\nevery voice matters.\lNo one but you has your vision!", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_Onigiri {
	msgbox("The sign says ONIGIRI in Japanese.\nThat's the word for Rice Balls.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_SurfBoat {
	msgbox("The idea here is that someone\nkept shoving Surf HMs onto the boat\land they kept breaking.\pThus, they came to the conclusion\nthat the boat sucks.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_SeashoreJesus {
	msgbox("The layering on these beach chairs\nwas really obnoxious to get right.\pThe way FRLG is set up, tiles that\nlet you walk onto higher elevation\lalso let you walk onto water.\pI had to do a lot of trickery to\nprevent you from becoming Jesus.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_Route15Pretty {
	msgbox("I'm very happy wtih how this\nroute turned out.\pAll the jokes and bits are paced\nout wonderfully, and it's very\lpretty too.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_FushciaSpelling {
	msgbox("Read this guy's dialogue veeeeeery\ncarefully lol", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_ModernExp {
	msgbox("In this hack, I removed the ability\nto organize your pokedex by type\land by letter.\pThis is explicitly me taking\nagency away from the player.\pHowever, within the context of\nthis hack, it's obvious why.\pPlayers who use those features by\ndefault don't expect there to be\lanything new with the dex order,\lso they default to what they know.\pIt's my job as a game designer to\nguide players to the experience I\lwant them to have.\pAnyway, modern gen exp share.\n", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_BinocularLass {
	msgbox("Strong contender for best cutscene\nin the hack.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_Pickles {
	msgbox("Lickitung's bit was gonna be some\nweird schtick where the guy was\lbisexual and you needed to give him\lonix or cloyster based on your\lplayer's gender.\pIt wasn't funny, and it wasn't\nvery interesting.\pNow it's pickles.\n", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_BikeSign {
	msgbox("I love making people annoy\nthemselves with their own actions.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_DickBridge {
	msgbox("This bridge was drawn by my good\nfriend LIAM DICK!", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_IllusionPants {
	msgbox("In Pokemon BW, there's an NPC\non a bridge who suddenly phases\lout of existence.\pIn Avatar the Last Airbender, an\niconic line is “Pants are an\lillusion, and so is death!”", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_CivilAssetForfeiture {
	msgbox("Ah, politics.\n", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_HarryDubois {
	msgbox("This guy is an allusion to Harry\nDubois from Disco Elysium!\pHe lost his gun, which the\nSafari Warden eventualy finds.\pReal Harry is not nearly this\nrude, though.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_TentacoolSound {
	msgbox("You wouldn't believe how hard it\nis to come up with convincing\lsounds for random Pokemon to make\lwhen writing dialouge for them.", MSGBOX_NPC)
	end
}

script CeliaSecrets_Bonus_SwimFurret {
	msgbox("Normally it's impossible to talk\nto NPCs in the water while you're\lon land.\pI had to do some actual fuckery\nin the game's code to let this\lroom work.", MSGBOX_NPC)
	end
}


script CeliaSecrets_Bonus_BlendyCandy {
	msgbox("I'm so, so sorry to any colorblind\nplayers.", MSGBOX_NPC)

}

script CeliaSecrets_Bonus_Crabhammer {
	msgbox("Crabhammer is supposed to tell you\nwhich of your Pokemon can evolve.\pIf they evolve into krabby, they\ncan't evolve using other methods.", MSGBOX_NPC)

}

script CeliaSecrets_Bonus_BirdCultistStatue {
	msgbox("Ooh, I wonder what this is about!\n", MSGBOX_NPC)

}

script CeliaSecrets_Bonus_FloatStoneGuy {
	msgbox("I'm kinda sad that most people\ngrab the float stone before\ltalking to this kid.\pFor what it's worth, he doesn't\nsay anything interesting.", MSGBOX_NPC)

}

script CeliaSecrets_Bonus_InaccessibleCelias {
	msgbox("I'll often put CELIAS in areas\nyou can't actually reach.\pI think it's funny to fuck with\npeople", MSGBOX_NPC)

}

script CeliaSecrets_Bonus_BlackSeed {
	msgbox("I put the sesame seed directly in\nthe path between Dad and the sign\pThis is to force the player to\nbump into it in case they don't\lsee the black pixel.", MSGBOX_NPC)

}

script CeliaSecrets_Bonus_BookOfMario {
	msgbox("This line was ripped from Book\nof Mario 64!\pIt's a google translate version of\nPM64, and it's a great time.\l(the discord server sucks tho)", MSGBOX_NPC)

}

script CeliaSecrets_Bonus_Fishinggurubrother {
	msgbox("I can't tell if anyone besides me\nthinks the fishing guru's brother\lbit is actually funny.", MSGBOX_NPC)

}

script CeliaSecrets_Bonus_RockScientist {
	msgbox("Full disclosure: I don't actually\nknow what this guy will do.\pIn the first draft of the game he\ngave you moon stones, and you'd\levolve Nidoking here to get Surf.\pThings have changed quite a bit\nsince then, progression-wise.\pBut I still think it's funny to\nkeep some dude trapped by a rock.\lSo for now, he's staying.", MSGBOX_NPC)

}

script CeliaSecrets_Bonus_CutsceneSilence {
	msgbox("Fading music out during the scene\nwhere he pulls a gun at you was\lactually really tricky.\pThe game does NOT like warping you\nwhile the music is faded out.\pSo I had to create a distinct music\ntrack of pure silence to use, as\lopposed to just pausing the BGM.", MSGBOX_NPC)

}

script CeliaSecrets_Bonus_BrickWall {
	msgbox("What will the Brick Pieces be used\nfor?\lStay tuned!", MSGBOX_NPC)

}

script CeliaSecrets_Bonus_TwoFridge {
	msgbox("While designing this map, I just\nspammed decorations everywhere.\pI happened to land on two fridges\nfor no real reason, and I thought\lit was funny enough to keep.", MSGBOX_NPC)

}

script CeliaSecrets_Bonus_WhosPoisoning {
	msgbox("The “Who's poisoning everyone”\nbit from Viridian was never really\lplanned to go anywhere.\pBut! I wanted to be sure every joke\nwas followed-up on.", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_Buffalo {
	msgbox("Buffalo buffalo Buffalo buffalo\nbuffalo buffalo Buffalo buffalo!", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_Tails {
	msgbox("Slowpoke is a strong contender for\nmy favorite learnset in the hack.", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_Slowpoketail {
	msgbox("Let's be real:\nThese guys are actually right!\lSlowpoketail WILL cost a ton!\pSurely this means you should spend\nyour life savings on a png!", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_Wallpaper {
	msgbox("“Put your Pokemon in the PC with\na very specific wallpaper” is\lone hell of an evolution method.", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_FushciaPokemonCenter {
	msgbox("The NPCs here are to prepare you\nfor the rest of the game.\pThis is when the puzzle aspects of\nthe design are emphasized, so I\lgave a reminder of the hint systems", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_StepOnTheKid {
	msgbox("Every time I fly here, I shout\n“Step on the kid!”", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_MoveDeleter {
	msgbox("As if I'd give you a move deleter\nin a game where vital field moves\lare restricted to certain Pokemon.\pI'm not letting you get softlocked\nTHAT easily!", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_BrendanDad {
	msgbox("Yeah, Dad is everyone's Dad.\pWhat, you thought you were special?\n", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_MachopBrick {
	msgbox("In gen 2, a machop you traded from\nRBY will always be holding the item\lBRICK PIECE.\pIt doesn't do anything, and it\nsells for only ¥25\pWhat the fuck.\n", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_JirachiScene {
	msgbox("I'm gonna put a cutscene here at\nsome point.", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_WallStairs {
	msgbox("These doors are a bit fucky because\nthe warp wall behavior is only in\lEmerald.\pI could port it in, but I'm lazy.\n", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_PokemonUCatch {
	msgbox("This slogan is in vanilla!\p\n…for some reason.", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_TaurosKid {
	msgbox("I love how this guy will fuck with\nyou if you try arranging your box\lby Pokedex number.", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_WhiteSesameSeed {
	msgbox("The white sesame seed walks back\nand forth on the ground here,\lto make sure you don't miss her.\pI tried my hardest to make “look\nfor one single off color pixel”\lnot as annoying as it coulda been.", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_GoldTeethHint {
	msgbox("People struggled with the gold\nteeth quest, so I put the sign\land the NPC beside each other.\pI hoped that the proximity would\nclue people in that they're\lrelated.", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_SafariZoneGrass {
	msgbox("No grass in the safari zone!\nToo bad!", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_EvoMusic {
	msgbox("The joke is that the starters in\nthe cage are causing the evo music.\pApparently that one goes over\nsome people's heads.", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_WaterStone {
	msgbox("I put a Water Stone here so you\ncould evolve your Shellder without\lneeding to backtrack to Celadon.\pAlas, some people do that anyway.\n", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_ChucksterHole {
	msgbox("Nope!\nThere's nothing back here.\lIt's just for the Chuckster.\pI probably could add something,\nbut idk what.", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_SecretHouseMusic {
	msgbox("Have you activated the secret\nmusic in this room?", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_PayDayTM {
	msgbox("The fact that you need to do the\nwhole quest to get your TM Case\land when you get the TM, it just\lappears with your normal items?\pGenius.\n", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_ShinyGun {
	msgbox("In retrospect, this shiny was\nprobably a little too easy.\pOh well.\n", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_TauntTM {
	msgbox("What, you didn't seriously think\nI was gonna give you TAUNT, right?\pThat's the single most Breaks\nPuzzles move in the game!\ltsk tsk.", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_FightingGuruBrotherSisterCousin {
	msgbox("The age-old question of “When\nyou're done with the quest, what\lshould the NPC say?”\pIt plagues every game dev because\nno one actually checks anyway.", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_BreloomLuigi {
	msgbox("“Kill the CEOs by shooting them”\nwas actually already written into\lthe plot long before Luigi came.\pIt's pure coincidence that I got\nto make a joke about him! :)", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_OzoneFinest {
	msgbox("If you approach the arena with\nYoshi knowing Gulp in your party,\lthe music changes.\pThe song is Ozone's Finest from\nPokemon Pisces!\lOne of the tracks I wrote for them.", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_GymDeletePokemon {
	msgbox("It was shockingly hard to not get\nyour Pokemon deleted permanently.\pI had to disable Saving while you\nexplore the main gym challenge.", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_BrandonSpenser {
	msgbox("No matter which door you choose,\nyour first opponent is Brandon\land your second is Spenser.\pThe illusion of free choice!\n", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_DadBadgeWall {
	msgbox("If you're looking carefully, you\ncan see the DAD BADGE on the wall.\pForeshadowing!\n", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_FastNurseHeal {
	msgbox("The nurses in this gym don't do\nthe full “fade out screen play\ljingle fade back in messagebox”\lthing.\pIf you had to sit through that each\ntime you walked into this room,\lyou'd go insane.", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_ElectricShedinja {
	msgbox("I was content with just a simple\nfade in-out for the Tera animation\lbut my programmer Wiz1989 decided\lto go all out!\pIt's very fun that we could port\nthe whole thing from expansion!", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_LassMaze {
	msgbox("I wanted this to be a proper\nstealth section with all the bells\land whistles, but it didn't work.\pOh well, this is still cute enough.\n", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_AronPuzzle {
	msgbox("It's a shame how easy this puzzle\nis to cheese, cuz it's honestly\lvery clever.\pThe fact that there's two parallel\npuzzles which have an interlinked\lsolution (Aron and Shedinja) is\lso fun.\pToo bad most players can cheese\nit for free.", MSGBOX_NPC)
}



script CeliaSecrets_Bonus_LassMazeHeal {
	msgbox("“Oh god getting healed is actually\na problem!” was a genius bit.", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_JanineDad {
	msgbox("Yup, Dad is her dad too.\n", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_StickerStar {
	msgbox("I'd like to thank Paper Mario\nSticker Star for the door puzzle.\pYou're a shit-ass awful waste of\na game, but that doesn't mean\lnothing in you has value.", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_FireCurtain {
	msgbox("If you try putting the curtain on\nthis door, you won't be able to\lwalk through because it won't\lbe aligned with the tile grid.\pA silly consequence of how we\nmade the tiles!", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_LassScrollRoom {
	msgbox("This is probably the most creative\npuzzle in the gym.\pYou need to think about how every\nroom connects to each other and\lremember what you've seen.\p…Or you could stumble into the\nanswer by accident.\lEither works!", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_CleaningLadyRoom {
	msgbox("The statues in here are to make\nsure you know that you need to\lbring water from the other side.\pAfter you've done the puzzle, they\ndon't serve a purpose anymore so\lI removed them.", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_ThePitRoom {
	msgbox("I get a shocking amount of milage\nfrom the pit.", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_PokemonOrLion {
	msgbox("Obviously the pokemon would win.\n", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_IcePuzzleCelia {
	msgbox("Good job talking to me!\n", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_DoubleBattelROom {
	msgbox("This puzzle wound up being much\nharder than I wanted.\pIt's hard to communicate what you\nneed to do if you aren't used to\lsolving escape rooms.\pBTW! This double battle behavior\nis only in Emerald!\pWe had to port it over, and it was\nfucking HARD.", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_CrashedIntoWall {
	msgbox("I came up with the whole Regi\nCrashed Into A Wall schtick like\l8 hours before the game launched.\pI had to build this whole second\nroom, add new tiles, add the Regi\loverworld sprite, etc hella fast.", MSGBOX_NPC)
}

script CeliaSecrets_Bonus_KogaNinjaTrick {
	msgbox("If you know you know.\n", MSGBOX_NPC)
}

