raw `
Route13_MapScripts::
	.byte 0

Route13_EventScript_TrainerTips1::
	msgbox Route13_Text_LookToLeftOfThatPost, MSGBOX_SIGN
	end

Route13_EventScript_TrainerTips2::
	msgbox Route13_Text_SelectToSwitchItems, MSGBOX_SIGN
	end

Route13_EventScript_RouteSign::
	msgbox Route13_Text_RouteSign, MSGBOX_SIGN
	end
`
script Route13_SpeedupTip {
	msgbox("TRAINER TIPS\pThe Speedup option is in your\nemulator.\pRemember to use it when needed!\n", MSGBOX_SIGN)
	end
}

script Route13_TheMountains {
	msgbox("The Mountains\n", MSGBOX_SIGN)
	end
}

script Route13_LookLookSign {
	lock
	playse(SE_PIN)
	applymovement(VAR_LAST_TALKED, Common_Movement_ExclamationMark)
	delay(60)
	msgbox("TRAINER TIPS!\pLook, look!\nTo the right of this sign!", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	applymovement(VAR_LAST_TALKED, Common_Movement_WalkLeft)
	waitmovement(0)
	release
}



const SNORLAX = 2
script Route13_Snorlax {
	lock
	msgbox("A POKéMON is asleep on the road.\nThere's no way around it.\pLooks like it's time to get through\nby force!", MSGBOX_DEFAULT)
	setwildbattle(SPECIES_SNORLAX, 30)
	waitse
	playmoncry(SPECIES_SNORLAX, CRY_MODE_ENCOUNTER)
	delay(40)
	waitmoncry
	dowildbattle
	clearflag(FLAG_SYS_SPECIAL_WILD_BATTLE)
	msgbox("The SNORLAX ran off to the\nmountains…", MSGBOX_DEFAULT)
	closemessage
	fadescreen(FADE_TO_BLACK)
	playmoncry(SPECIES_SNORLAX, CRY_MODE_NORMAL)
	waitmoncry
	removeobject(SNORLAX)
	fadescreen(FADE_FROM_BLACK)
	release
	end
}

script Route13_Artist {
	msgbox("At long last, I have completed\nmy life's work!\pI've painted photorealistic fences\nall along the grass on this route!\lMy artistic genius knows no limits!", MSGBOX_NPC)
	end
}

script Route13_Fence {
	msgbox("This patch of grass has been\nintricately painted to resemble\la fence.", MSGBOX_SIGN)
	end
}

script Route13_WrongTurnSign {
	msgbox("TRAINER TIPS!\pDon't make a wrong turn!\n", MSGBOX_SIGN)
	end
}

script Route13_StuckDad {
	lock
	faceplayer
	textcolor(0)
	msgbox("DAD: {PLAYER}!\nWhat are you doing out here?\pI was making my way through the maze\nbut I think I took a wrong turn.\lDo you know the way out?\pWell, never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}

const LASS = 1

script Route13_LassAttack {
	lock
	playbgm(MUS_ENCOUNTER_GIRL, TRUE)
	setflag(FLAG_ROUTE13_HIDE_DAD)
	delay(60)
	special(SpawnCameraObject)
	applymovement(OBJ_EVENT_ID_CAMERA, Route13_CameraPansLeft)
	delay(100)
	addobject(LASS)
	applymovement(LASS, Route13_LassComesUp)
	delay(60)
	waitmovement(0)
	applymovement(LASS, Route13_MazeMovement)
	applymovement(OBJ_EVENT_ID_CAMERA, Route13_MazeMovement)
	delay(60)
	waitmovement(0)
	playse(SE_PIN)
	applymovement(LASS, Route13_LassOops)
	delay(300)
	applymovement(OBJ_EVENT_ID_CAMERA, Route13_BackOnTrack)
	waitmovement(LASS)
	applymovement(LASS, Route13_LastSteps)
	applymovement(OBJ_EVENT_ID_CAMERA, Route13_LastSteps)
	waitmovement(0)
	delay(30)
	special(RemoveCameraObject)
	textcolor(NPC_TEXT_COLOR_FEMALE)
	clearflag(FLAG_ROUTE13_HIDE_DAD)
	msgbox("Hey!\nDon't look at me!", MSGBOX_DEFAULT)
	playbgm(MUS_ROUTE11, TRUE)
	//Battle
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox("Aww, man.\nAll these fences are see-through!\pOh well.\n", MSGBOX_DEFAULT)
	closemessage
	delay(60)
	applymovement(LASS, Route13_LassLeaves)
	waitmovement(0)
	setobjectxy(LASS, 27, 9)
	setobjectxyperm(LASS, 27, 9)
	setvar(VAR_ROUTE13_LASS_ATTACK, 1)
	setflag(FLAG_ROUTE13_LASSATTACK)
	release
	end
}

script Route13_LassPostAttack {
	lock
	msgbox("Oh, rats.\nI went the wrong way…", MSGBOX_DEFAULT)
	closemessage
	playse(SE_PIN)
	faceplayer
	applymovement(VAR_LAST_TALKED, Common_Movement_ExclamationMark)
	delay(60)
	msgbox("Hey!\nStop it!", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	applymovement(VAR_LAST_TALKED, Route13_LassLeavesAgain)
	waitmovement(0)
	setflag(FLAG_ROUTE13_LASS_2)
	removeobject(LASS)
	release
}

movement Route13_LassLeavesAgain {
	walk_left
	walk_up * 2
	walk_left * 8
}

movement Route13_LassLeaves {
	walk_left * 8
}

movement Route13_CameraPansLeft {
	walk_left
	walk_fast_left
	walk_faster_left
	walk_fastest_left * 46
	walk_faster_left
	walk_fast_left
	walk_left
}

movement Route13_LassComesUp {
	walk_up * 5
	face_up
	delay_16 * 2
	face_right
	lock_facing_direction
	walk_slow_left
	face_right
	unlock_facing_direction
	delay_16 * 2
	walk_fast_right
}

movement Route13_MazeMovement {
	walk_fast_right * 16
	walk_fast_up * 2
	walk_fast_right * 7
	walk_fast_up * 2
	walk_fast_right * 6
	walk_fast_up * 2	
	walk_fast_right * 12
	walk_fast_down * 2
	walk_fast_left * 8
	walk_fast_down * 2
	walk_fast_right * 10
	walk_fast_down * 2
	walk_fast_left * 2
	walk_fast_down * 2
	walk_fast_right * 6
	walk_right * 2
	face_right
}

movement Route13_LassOops {
	emote_exclamation_mark
	delay_16 * 4
	lock_facing_direction
	walk_slow_left
	face_right
	unlock_facing_direction
	delay_16 * 4
	walk_left * 7
	walk_up * 2
	walk_right * 7
}

movement Route13_BackOnTrack {
	walk_slow_up * 2
}

movement Route13_LastSteps {
	walk_right * 3
}