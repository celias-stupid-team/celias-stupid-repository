const MAN = 1
const DUSCLOPS = 2

mapscripts FushciaGym_ToxicDusclopsRoom_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if(flag(FLAG_GOT_POISONED_ONCE)) {
            setvar(VAR_TEMP_1, 1)
            setobjectxyperm(MAN, 6, 11)
            setobjectxyperm(DUSCLOPS, 7, 11)
        }
        
        setrespawn(HEAL_LOCATION_FUSHCIA_GYM_TOXIC_DUSCLOPS_ROOM)
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_1, 0 {
            playse(SE_PIN)
            setvar(VAR_TEMP_1, 2)
            applymovement(MAN, Common_Movement_ExclamationMark)
            applymovement(DUSCLOPS, DusclopsAttacksYou)
            waitmovement(DUSCLOPS)
            playmoncry(SPECIES_DUSCLOPS, CRY_MODE_DEFAULT)
            msgbox("DUSCLOPS: Cloooops!\n", MSGBOX_DEFAULT)
            waitmoncry
            closemessage
            msgbox("DUSCLOPS used TOXIC!\n", MSGBOX_DEFAULT)
            setstatus1(STATUS1_POISON, 0)
            setflag(FLAG_GOT_POISONED_ONCE)
            release
        }
    ]
}


script FushciaGym_ToxicDusclops {
    lock
    faceplayer
    if(var(VAR_TEMP_1) == 1) {
            setflag(FLAG_TEMP_2)
            playmoncry(SPECIES_DUSCLOPS, CRY_MODE_DEFAULT)
            msgbox("DUSCLOPS: Cloooops!\n", MSGBOX_DEFAULT)
            waitmoncry
            closemessage
            msgbox("DUSCLOPS used TOXIC!\n", MSGBOX_DEFAULT)
            setstatus1(STATUS1_POISON, 0)
            setflag(FLAG_GOT_POISONED_ONCE)

    } else {
            playmoncry(SPECIES_DUSCLOPS, CRY_MODE_DEFAULT)
            msgbox("DUSCLOPS: Cloooops!\n", MSGBOX_DEFAULT)
            waitmoncry
    }
    release
    end
}

script FushciaGym_ToxicDusclopsMan {
    if(flag(FLAG_TEMP_2)) {
        msgbox("This POISON is even more potent\nthan usual!\pYour HP will drain ten times as\nfast in the overworld\lMwahaha!", MSGBOX_NPC)
    } else {
	    msgbox("Mwahaha!\nIt's me!\pI'm the one POISONING everyone!", MSGBOX_NPC)

    }
	end
}