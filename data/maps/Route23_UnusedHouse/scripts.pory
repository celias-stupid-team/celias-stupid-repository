raw `
Route23_UnusedHouse_MapScripts::
	.byte 0
`

script ShinyBidoof_Cynthia {
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_RED)
	if(flag(FLAG_SHINY_BIDOOF)) {
		msgbox(
		"I hope to see you again.\n"
		"", MSGBOX_DEFAULT)

	} else {
		msgbox(
		"Oh?\n"
		"Hello, there.\l"
		"Didn't expect to see you here.\p"

		"I don't think it's time to battle.\n"
		"Not yet, anyway.\p"

		"But here, take this gift.\n"
		"", MSGBOX_DEFAULT)
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		playfanfare(MUS_LEVEL_UP)
		msgbox(
		"{PLAYER} was inexplicably\n"
		"given the BIDOOF!", MSGBOX_DEFAULT)
		setflag(FLAG_SHINY_CREATION)
		setvar(VAR_CSR_GIFT_POKEMON, SPECIES_BIDOOF)
		call(Common_Script_GiftPokemon)
		textcolor(NPC_TEXT_COLOR_RED)
		msgbox(
		"I hope to see you again.\n"
		"", MSGBOX_DEFAULT)
		setflag(FLAG_SHINY_BIDOOF)
	}
	applymovement(VAR_LAST_TALKED, moves(
		face_original_direction
	))
	waitmovement(0)
	release
	end
}

script ShinyBidoof_NotOak {
	msgbox(
	"It's been scared OAKless.\n"
	"", MSGBOX_SIGN)

}
