mapscripts PokemonTower_Math_3_MapScripts {
    		MAP_SCRIPT_ON_FRAME_TABLE [
				VAR_TEMP_5, 0 { //Correct
					switch(var(VAR_POKEMONTOWER_ANSWER)) {
						case 0:
							break
						case 1:
							playse(SE_SUCCESS)
							waitse
							setvar(VAR_POKEMONTOWER_ANSWER, 0)
							
						case 2:
							playse(SE_BOO)
							waitse
							setvar(VAR_POKEMONTOWER_ANSWER, 0)
							
					}
					
					setvar(VAR_TEMP_5, 1)
					release
					end
				}

			]
}

script PokemonTower_5F_EventScript_Twin1 {
	trainerbattle_double(TRAINER_CHANNELER_JANAE, "MAI: I love doing math!\nWhat's two plus two?\pPRA: Ooh, yeah!\nI love MAGIKARP!", "Oh no!\n", "You are insufficient.")
	msgbox("MAI: No, no, PRA.\nWe're doing Math!", MSGBOX_AUTOCLOSE)
}

script PokemonTower_5F_EventScript_Twin2 {
	trainerbattle_double(TRAINER_CHANNELER_JANAE, "MAI: I love doing math!\nWhat's two plus two?\pPRA: Ooh, yeah!\nI love MAGIKARP!", "Oh no!\n", "You are insufficient.")
	msgbox("PRA: I eat glue.\n", MSGBOX_DEFAULT)
}

script PokemonTower_MathQuestion_Three {
	lock
	msgbox("6 {DIVIDE} 2(1 + 2) = ?\n{LEFT_ARROW} 9    {UP_ARROW} 1    {RIGHT_ARROW} Shitty Notation", MSGBOX_SIGN)
	release
}

script PokemonTower_MathDad {
	lock
	faceplayer
	textcolor(0)
	msgbox("DAD: {PLAYER}!\nWhat are you doing out here?\pWow, these math questions are\nreally tricky.\lI hope you've done your homework!\pWell, never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}