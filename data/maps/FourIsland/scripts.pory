}


script FourIsland_RockClimbUp {
	lock
	msgbox("Jagged rocks line the wall.\n", MSGBOX_DEFAULT)
	if(checkfieldmove(MOVE_ROCK_CLIMB) != PARTY_SIZE) {
		msgbox("Would you like to use\nROCK CLIMB?", MSGBOX_YESNO)
		closemessage
		if(var(VAR_RESULT)) {
			applymovement(LOCALID_PLAYER, moves(
				walk_fast_up * 3
				jump_up
			))
			waitmovement(0)
		}
	}
	release

}
script FourIsland_RockClimbDown {
	lock
	msgbox("Jagged rocks line the wall.\n", MSGBOX_DEFAULT)
	if(checkfieldmove(MOVE_ROCK_CLIMB) != PARTY_SIZE) {
		msgbox("Would you like to use\nROCK CLIMB?", MSGBOX_YESNO)
		closemessage
		if(var(VAR_RESULT)) {
			applymovement(LOCALID_PLAYER, moves(
				walk_fast_down * 3
				jump_down
			))
			waitmovement(0)
		}
	}
	release

}

script FourIsland_Rock {
	famechecker(FAMECHECKER_GREAT_SEA_EAST, 3)
	msgbox(
	"It's a rock.\p"

	"It feels normal to the touch.\n"
	"", MSGBOX_SIGN)

}

