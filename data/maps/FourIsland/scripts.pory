script FourIsland_CutInHalf {
	msgbox(
	"They say this mountain divides\n"
	"FOUR ISLAND in half.\p"

	"Looking at our local BERRIES, I\n"
	"think I understand.\p"
	
	"And also looking at, y'know…\n"
	"{PAUSE 10}the mountain.",MSGBOX_NPC)
}


//House 1
script FourIsland_DrFootstep {
	lock
	faceplayer
	msgbox(
	"Hello, young one.\n"
	"I am DR. FOOTSTEP.\p"

	"I need only to see the footprints\n"
	"of your POKéMON to understand\l"
	"their true nature.\p"

	"Would you like me to tell you about\n"
	"your POKéMON?", MSGBOX_YESNO)
	if(var(VAR_RESULT)) {
		msgbox(
		"Good, good.\p"

		"Now, let's have your POKéMON walk\n"
		"in front of me…", MSGBOX_DEFAULT)
		fadescreenswapbuffers(FADE_TO_BLACK)
		closemessage
		//re-adjust NPCs
		delay(30)
		fadescreenswapbuffers(FADE_FROM_BLACK)
		//walk back and forth
		if(!flag(FLAG_WORLD_MAP_FOUR_ISLAND)) { //Placeholder conditional for no footprint
			msgbox(
			"Hrrm…\p"

			"It seems your POKéMON does not\n"
			"leave any footsteps.\p"

			"As such{PAUSE 30} I cannot ascertain whether\n"
			"or not it has feet.\p"

			"{PAUSE 30}Please come again.\n"
			"", MSGBOX_DEFAULT)
		} elif (checkpartymonslot(SPECIES_TENTACOOL) == 0) {
			msgbox(
			"Hrrrm…\p"

			"It seems your POKéMON does not\n"
			"leave any footsteps.\l"
			"But…\p"

			"I can hear its heart begging for\n"
			"the ability to walk.\p"

			"Here, take these.\n"
			"", MSGBOX_DEFAULT)
			giveitem_msg("{PLAYER} received a pair\nof RUNNING SHOES!", ITEM_RUNNING_SHOES, 1, MUS_OBTAIN_KEY_ITEM)
			waitfanfare
			release
			end

		}
		msgbox(
		"Hmm, yes.\n"
		"I see.\p"

		"I can confidently declare that\n"
		"your POKéMON {PAUSE 30}has feet.\p"

		"{PAUSE 30}Thank you for your time.\n"
		"", MSGBOX_DEFAULT)
		release
		end
	} else {
		msgbox(
		"Ah… Scared of the truth, eh?\n"
		"I understand.\p"

		"Well, you're always welcome back.\n"
		"", MSGBOX_DEFAULT)
		release
		end
	}
}

script FourIsland_SealCase {
	lock
	faceplayer
	famechecker(FAMECHECKER_GREAT_SEA_EAST, 1)
	if(flag(FLAG_GOT_SEAL_CASE)) {
		msgbox(
		"Alternatively, you can always call\n"
		"your PALKIA a DICK HEAD!", MSGBOX_DEFAULT)
		release
		end
	} else {
		msgbox(
		"Hey, you!\p"

		"Have you ever wanted to call your\n"
		"opponent a FUCKHEAD?\p"

		"Take this!\n"
		"", MSGBOX_DEFAULT)
		giveitem_msg("{PLAYER} got the SEAL CASE!\n", ITEM_SEAL_CASE)
		setflag(FLAG_GOT_SEAL_CASE)
		release
		end
	}
}

