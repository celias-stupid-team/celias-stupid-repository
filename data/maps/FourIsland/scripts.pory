script FourIsland_AmitySquareLady {
	lock
	faceplayer
	famechecker(FAMECHECKER_GREAT_SEA_EAST, 4)
	msgbox(
	"Hello!\n"
	"Welcome to AMITY SQUARE.\p"

	"Here, you can go on a stroll with\n"
	"a cute POKéMON.\l"
	"{PAUSE 30}But only if it's cute.\l"
	"We're extremely strict.", MSGBOX_DEFAULT)
	//logic
	if(checkpartymon(SPECIES_TRUBBISH_HAIRCUT)) {
		msgbox(
		"Ah!\n"
		"I see you have a TRUBBISH.\l"
		"He's perfectly cute!\p"

		"Right this way, then.\n"
		"You're a welcome guest!", MSGBOX_DEFAULT)
		closemessage
		//movement
		warp(MAP_FOUR_ISLAND_AMITY_SQUARE, 0)
		release
		end
	}
	msgbox(
	"Let's see…{PAUSE 20}\n"
	"Ewww.\l"
	"Nothing in your party is cute.\p"

	"The permitted POKéMON are PIKACHU,\n"
	"{PAUSE 10}PACHIRISU, {PAUSE 10}EMOLGA,{PAUSE 20} and TRUBBISH.\p"

	"Come back when you've gotten your\n"
	"life together, you ugly bitch.\l"
	"Cheers!", MSGBOX_DEFAULT)
	release
	end
}

