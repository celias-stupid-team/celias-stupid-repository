}

script FourIsland_CombeeSign {
	msgbox("TRAINER TIPS\pCATERPIE evolves into a butterfly,\nand WEEDLE evolves into a bee!", MSGBOX_SIGN)
}

script FourIsland_OldLady {
	msgbox(
	"Welcome to FOUR ISLAND, dearie.\n"
	"Here, we honor our culture's myths.\p"

	"For example, the myth of this\n"
	"so-called {PAUSE 10}“FIRE-TYPE.”\l"
	"Ah, what a fun legend!", MSGBOX_NPC)
}



script FourIsland_CeliaDawn {
	textcolor(NPC_TEXT_COLOR_RED)
	msgbox(
	"Hiya! I'm DAWN, the crea-{PAUSE 30} uh\n"
	"I mean a very regular person!\p"

	"I hope you've been filling up your\n"
	"POKéDEX!\l"
	"haha", MSGBOX_NPC)
}



script FourIsland_HoneyTree {
	lock
	if(checkitem(ITEM_HONEY)) {
		msgbox("The tree has been hastily covered\nwith a coat of cheap paint.\lSlather the bark with HONEY?", MSGBOX_YESNO)
		if(var(VAR_RESULT)) {
			msgbox("{PLAYER} slathered the bark with\nHONEY…", MSGBOX_DEFAULT)
			closemessage
			playmoncry(SPECIES_SMEARGLE, CRY_MODE_ENCOUNTER)
			waitmoncry
			removeitem(ITEM_HONEY, 1)
			setwildbattle(SPECIES_SMEARGLE, 30, ITEM_NONE)
			dowildbattle
			delay(60)
			release
			end
		}
	} else {
		
		msgbox("The tree has been hastily covered\nwith a coat of cheap paint.", MSGBOX_DEFAULT)
	}
	release
}

script FourIsland_TrendySayingHouse {
	msgbox(
	"HOUSE of an OLD MAN who\n"
	"TEACHES you TRENDY SAYINGS.", MSGBOX_SIGN)

}


script FourIsland_Froslass { //PLACEHOLDER
	lock
	playbgm(MUS_GEN4_LASS, TRUE)
	setvar(VAR_FROSLASS_SCENE, 1)
	setvar(VAR_TEMP_0, 1)
	applymovement(LOCALID_FROSLASS, moves(
		face_up
		emote_exclamation_mark
	))
	waitmovement(0)
	delay(30)
	special(SpawnCameraObject)
	applymovement(LOCALID_CAMERA, moves(
		walk_down * 2
	))
	waitmovement(0)
	delay(10)
	playse(SE_LEDGE)
	applymovement(LOCALID_FROSLASS, moves(
		jump_up
	))
	waitmovement(0)
	delay(20)
	applymovement(LOCALID_CAMERA, moves(
		walk_up * 2
	))
	applymovement(LOCALID_FROSLASS, moves(
		walk_up
		face_up
	))
	//switch statement for player's XY
	waitmovement(LOCALID_CAMERA)
	special(RemoveCameraObject)

	playmoncry(SPECIES_FROSLASS, CRY_MODE_DEFAULT)
	msgbox("FROSLASS: Fraaah!", MSGBOX_DEFAULT)
	waitmoncry
	closemessage
	delay(10)
	msgbox(
	"The FROSLASS is upset that\n"
	"you looked at it.", MSGBOX_DEFAULT)
	playbgm(MUS_FOUR_ISLAND, TRUE)
	//trainer battle
	removeobject(LOCALID_FROSLASS)
	release
	end
}

script FourIsland_DadJr { //PLACEHOLDER
	lock
	faceplayer
	textcolor(0)
	msgbox("DAD JR.: {PLAYER}!\nWhat are you doing out here?\pWow, this island sure is lovely.\nIt's bringing out my inner child!\pWell, never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	
	release
	end
}

