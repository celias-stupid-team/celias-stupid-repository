mapscripts SeafoamIslands_B2F_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		if(var(VAR_SEAFOAM_CAPTAIN_FLOOR) != 2) {
			setflag(FLAG_SEAFOAM_B2F_CAPTAIN)
		} elif (var(VAR_SEAFOAM_CAPTAIN_FLOOR) == 2) {
			clearflag(FLAG_SEAFOAM_B2F_CAPTAIN)
		}

	}
}

script Seafoam_B2F_Captain {
	lock
	msgbox(
	"Hmm, I know there's a cave\n"
	"around here somewhere…", MSGBOX_DEFAULT)
	release
}
