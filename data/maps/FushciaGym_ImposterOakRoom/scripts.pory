mapscripts FushciaGym_ImposterOakRoom_MapScripts {
    MAP_SCRIPT_ON_LOAD {
		
        setrespawn(HEAL_LOCATION_FUSHCIA_GYM_IMPOSTER_OAK_ROOM)
		if(!flag(FLAG_FUSHCIA_IMPOSTER_OAK)) {
			setflag(FLAG_TEMP_1)
			if(flag(FLAG_IMPOSTER_OAK_ROOM_SWITCH)) {
				call(FushciaGym_ImposterOakRoom_DrawNoStatue)

			}
		} else {
			setmaplayoutindex(LAYOUT_FUSHCIA_GYM_IMPOSTER_OAK_ROOM_LAYOUT_2)
		}
	}
	MAP_SCRIPT_ON_TRANSITION {
		if(flag(FLAG_FUSHCIA_IMPOSTER_OAK) && flag(FLAG_IMPOSTER_OAK_ROOM_SWITCH)) {
			setmaplayoutindex(LAYOUT_FUSHCIA_GYM_IMPOSTER_OAK_ROOM_LAYOUT_2)

		}
	}
}

script FushciaGym_ImposterOakRoom_SecretSwitch {
	lock
	if(flag(FLAG_IMPOSTER_OAK_ROOM_SWITCH)) {
		msgbox("The secret switch inexplicably\nmade the whole statue disappear.", MSGBOX_DEFAULT)
		release
		end
	} else {
		specialvar(VAR_RESULT, GetPlayerFacingDirection)
		if(var(VAR_RESULT) == DIR_SOUTH) {
			msgbox("The statue is blocking your path.\pIt seems there's a switch on the\nother side.", MSGBOX_DEFAULT)
			release
			end
		} 
		msgbox("A secret switch!\nPress it?", MSGBOX_YESNO)
		if(var(VAR_RESULT)) {
			msgbox("{PLAYER} pressed the switch!\n", MSGBOX_DEFAULT)
			closemessage
			playse(SE_CLICK)
			setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 3)
			setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 3)
			setvar(VAR_SHAKESCREEN_NUM_SHAKES, 2)
			setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 1)
			call(FushciaGym_ImposterOakRoom_DrawNoStatue)
			special(DrawWholeMapView)
			special(ShakeScreen)
			delay(40)
			setflag(FLAG_IMPOSTER_OAK_ROOM_SWITCH)
			
			msgbox("The secret switch inexplicably\nmade the whole statue disappear.", MSGBOX_DEFAULT)

		}
		release

	}
}

script FushciaGym_ImposterOakRoom_DrawNoStatue {
	setmetatile(10, 9, 0x28C, FALSE)
	setmetatile(10, 10, 0x28C, FALSE)
	return
}

script FushciaGym_ImposterOakRoom_ImposterOak{
    lock
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    if(checkitem(ITEM_WAILMER_PAIL)) {
        textcolor(NPC_TEXT_COLOR_NEUTRAL)
		msgbox("There is an odd tree in the way.\nWould you like to WATER it?", MSGBOX_YESNO)
		if(var(VAR_RESULT)) {
			removeitem(ITEM_WAILMER_PAIL)
			additem(ITEM_EMPTY_PAIL)
			setvar(VAR_CSR_PSYDUCK_PAIL_STATUS, 1)
			msgbox("{PLAYER} watered the tree…\n", MSGBOX_DEFAULT)
			closemessage
			playse(SE_PIN)
			applymovement(VAR_LAST_TALKED, Common_Movement_ExclamationMark)
			
			fadeoutbgm(1)
			waitmovement(0)
			textcolor(NPC_TEXT_COLOR_TREE)
			playbgm(MUS_CSR_IMPOSTER_OAK, TRUE)
			msgbox("{FONT_SMALL}OAK?: Wha-?\nHey!\p{FONT_SMALL}You again?", MSGBOX_DEFAULT)
			trainerbattle_no_intro(TRAINER_IMPOSTER_OAK_FUSHCIA, "{FONT_SMALL}Hey!\n")
			msgbox("{FONT_SMALL}Just when I thought I had a nice\n{FONT_SMALL}place to myself!\p{FONT_SMALL}Later, kid.\n{FONT_SMALL}I got better things to do!", MSGBOX_DEFAULT)
			closemessage
			fadescreen(FADE_TO_BLACK)
			playse(SE_EXIT)
			fadedefaultbgm
			removeobject(VAR_LAST_TALKED)
			waitse
			setflag(FLAG_FUSHCIA_IMPOSTER_OAK)
			fadescreen(FADE_FROM_BLACK)
			release

		}
    } else {
		applymovement(VAR_LAST_TALKED, OakDances)
		playse(SE_M_SCRATCH)
		delay(10)
		playse(SE_M_SCRATCH)
		delay(10)
		playse(SE_M_SCRATCH)
		delay(10)
		waitmovement(0)
		
	}
	
	release
}

script FushciaGym_CleaningLady {
	msgbox("Huh?\nYeah, I'm the CLEANING LADY.\pThis room's getting remodeled.\nI moved the STATUES to storage.", MSGBOX_NPC)
	end
}

script FushciaGym_OakRoom_Sign {
	msgbox("SCROLL ROOM\pFor the time being, feel free to\nscroll right past.", MSGBOX_SIGN)
	end
}