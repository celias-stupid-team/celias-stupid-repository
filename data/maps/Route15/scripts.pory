script Route15_LighthouseGirl {
	msgbox("You know the LIGHTHOUSE on the\nshore of ROUTE 15?\pLegends say that at the top rests\na powerful DRAGON.\pI hope that someday I can meet him…\n", MSGBOX_NPC)
	end
}

const GUARD = 1
const FATGUY = 2


const FAR_LEFT = 40
const MID_LEFT = 41
const MID_RIGHT = 42
const FAR_RIGHT = 43


script Route15_PowerOutTrigger {
	if(flag(FLAG_MELTED_LIGHTHOUSE_GUARD)) {
		release
		end
	}
	lock
	textcolor(NPC_TEXT_COLOR_MALE)
	playse(SE_PIN)
	applymovement(GUARD, Common_Movement_ExclamationMark)
	waitmovement(0)
	delay(30)
	msgbox("Hey, wait!", MSGBOX_DEFAULT)
	closemessage
	getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
	switch(var(VAR_TEMP_1)) { //Guard approaches
		case FAR_RIGHT:
			break
		case MID_RIGHT:
			applymovement(GUARD, Route15_Lighthouse_WalkOneLeft)
			waitmovement(0)
			break
		case MID_LEFT:
			applymovement(GUARD, Route15_Lighthouse_WalkTwoLeft)
			waitmovement(0)
			break
		case FAR_LEFT:
			applymovement(GUARD, Route15_Lighthouse_WalkThreeLeft)
			waitmovement(0)
			break
	}
	call(Route15_NoPower)
	delay(20)
	switch(var(VAR_TEMP_1)) { //Guard Leaves
		case FAR_RIGHT:
			break
		case MID_RIGHT:
			applymovement(GUARD, Route15_Lighthouse_WalkOneRight)
			waitmovement(0)
			break
		case MID_LEFT:
			applymovement(GUARD, Route15_Lighthouse_WalkTwoRight)
			waitmovement(0)
			break
		case FAR_LEFT:
			applymovement(GUARD, Route15_Lighthouse_WalkThreeRight)
			waitmovement(0)
			break
	}
	delay(10)
	applymovement(LOCALID_PLAYER, Route15_Lighthouse_WalkDown)
	waitmovement(0)
	release
}

script Route15_NoPower {
	famechecker(FAMECHECKER_KANTO_SHORELINE, 0)
	msgbox("I'm sorry, but there's a blackout\nat the LIGHTHOUSE right now.", MSGBOX_DEFAULT)
	closemessage
	//camera goes up
	if(checkitem(ITEM_TEA)) {
		msgbox("Wait…\nWhat are you doing?\pNo! Stop!\nPlease!", MSGBOX_DEFAULT)
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		msgbox("Would you like to use your\nTOXIC SLUDGE?", MSGBOX_YESNO)
		if(var(VAR_RESULT)) {
			msgbox("{PLAYER} used the TOXIC SLUDGE!\n", MSGBOX_DEFAULT)
			removeitem(ITEM_TEA)
			fadescreen(FADE_TO_BLACK)
			playse(SE_M_ACID_ARMOR)
			waitse
			removeobject(GUARD)
			fadescreen(FADE_FROM_BLACK)
			setflag(FLAG_MELTED_LIGHTHOUSE_GUARD)
			setflag(FLAG_HIDE_GTS_NPCS)
			release
			end
		} else {
			textcolor(NPC_TEXT_COLOR_BLUE)
			msgbox("Oh, phew…\nOkay. False alarm.\lBut yeah, anyway…\pThere's a blackout at the\nLIGHTHOUSE.", MSGBOX_DEFAULT)
		}

	}
	delay(30)
	special(SpawnCameraObject)
	applymovement(LOCALID_CAMERA, Route15_Lighthouse_CameraGoesUp)
	waitmovement(0)


	delay(120) //waiting on lighthouse sign

	msgbox("Yup.\nMassive blackout.", MSGBOX_DEFAULT)
	closemessage
	delay(15)
	//camera goes down
	applymovement(LOCALID_CAMERA, Route15_Lighthouse_CameraGoesDown)
	//NPC enters lighthouse
	delay(8) //delay to make it line up with the camera

	switch(var(VAR_TEMP_1)) { //Man walks up - This decides where he starts
		case FAR_LEFT: //Yeah yeah I should've just used default case 
		case FAR_RIGHT:
			setobjectxy(FATGUY, MID_RIGHT, 29)
			applymovement(FATGUY, Route15_Lighthouse_FatGuy1)
			break
		case MID_RIGHT:
			setobjectxy(FATGUY, MID_LEFT, 29)
			applymovement(FATGUY, Route15_Lighthouse_FatGuy2)
			break
		case MID_LEFT:
			setobjectxy(FATGUY, FAR_RIGHT, 29)
			applymovement(FATGUY, Route15_Lighthouse_FatGuy3)
			break
		
	}
	
	delay(60)
	msgbox("I'm sorry, but rules are rules.\nNobody's allowed to go inside.", MSGBOX_DEFAULT)
	waitmovement(0)
	closemessage
	setobjectxy(FATGUY, 47, 26)
	special(RemoveCameraObject)
	return
}

script Route15_Guard_NPC {
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_MALE)

	call(Route15_NoPower)
	applymovement(GUARD, Common_Movement_FaceLeft)
	waitmovement(0)
	release
}

