movement Route15_Lighthouse_WalkOneLeft // I kinda forgot aboout the * notation for multiple walks oops
{
	walk_left
	face_left
}

movement Route15_Lighthouse_WalkTwoLeft
{
	walk_left
	walk_left
	face_left
}
movement Route15_Lighthouse_WalkThreeLeft
{
	walk_left
	walk_left
	walk_left
	face_left
}

movement Route15_Lighthouse_WalkOneRight
{
	walk_right
	face_left
}

movement Route15_Lighthouse_WalkTwoRight
{
	walk_right
	walk_right
	face_left
}
movement Route15_Lighthouse_WalkThreeRight
{
	walk_right
	walk_right
	walk_right
	face_left
}

movement Route15_Lighthouse_CameraGoesUp {
	walk_up * 4
}

movement Route15_Lighthouse_CameraGoesDown {
	walk_down * 4
}

movement Route15_Lighthouse_FatGuy1 {
	set_visible
	walk_up * 6
	delay_8
	set_invisible
}

movement Route15_Lighthouse_FatGuy2 {
	set_visible
	walk_up * 4
	walk_right
	walk_up
	walk_up
	face_up
	delay_8
	set_invisible
}

movement Route15_Lighthouse_FatGuy3 {
	set_visible
	walk_up * 4
	walk_left
	walk_up
	walk_up
	face_up
	delay_8
	set_invisible
}

movement Route15_Lighthouse_WalkDown {
	walk_down
}

script Route15_Chuckster {
	lock
	faceplayer
	msgbox("I'm a CHUCKSTER!\n", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	specialvar(VAR_RESULT, GetPlayerFacingDirection)
	switch(var(VAR_RESULT)) {
		case DIR_NORTH:
			applymovement(LOCALID_PLAYER, moves(
				walk_right
				walk_up
				face_up

			))
		case DIR_WEST:
			applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
		case DIR_EAST:
			applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
		case DIR_SOUTH:
			applymovement(LOCALID_PLAYER, moves(
				walk_right
				walk_down
				face_up

			))
	}
	applymovement(VAR_LAST_TALKED, Common_Movement_FaceUp)
	waitmovement(LOCALID_PLAYER)
	delay(30)
	applymovement(LOCALID_PLAYER, WalkFastUp)
	applymovement(VAR_LAST_TALKED, WalkFastUp)
	waitmovement(0)
	playse(SE_LEDGE)
	applymovement(LOCALID_PLAYER, Jump2Up)
	waitmovement(0)
	delay(30)
	applymovement(VAR_LAST_TALKED, moves(
		walk_down
		face_up
	))
	waitmovement(VAR_LAST_TALKED)
	release

}
