raw `


Route15_EventScript_RouteSign::
	msgbox Route15_Text_RouteSign, MSGBOX_SIGN
	end
`

const TUBER = 7
const OldMan = 11
const Woman = 12
mapscripts Route15_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		if(flag(FLAG_WORLD_MAP_FUSHCIA_CITY) && !flag(FLAG_FED_SANDWICH)) {
            //I accidentally did the logic backwards but this is more sensible anyway LOL 
			if(!flag(FLAG_SAW_CELIA_ROUTE15)) {
				setvar(VAR_TEMP_A, 1)

			}
        } else {
            setflag(FLAG_TEMP_A)
			
        }

		if(flag(FLAG_CSR_TALKED_TO_TUBER) && !flag(FLAG_GOLURK_SANDWICH)) {
			setflag(FLAG_CSR_TUBER_EATEN)
			removeobject(TUBER)
		}
		if(!flag(FLAG_JUMPED_FROM_LIGHTHOUSE)) {
			setflag(FLAG_TEMP_7)
		} else {
			setflag(FLAG_TEMP_4)
		}
		setbench(BENCH_ROUTE15)
		if(var(VAR_CSR_TURNED_ON_POWER) == 0) {
			setflag(FLAG_TEMP_4)
		} else {
			setflag(FLAG_TEMP_5)
		}
		if(flag(FLAG_MELTED_LIGHTHOUSE_GUARD)) {
			setflag(FLAG_TEMP_5)

		}
		clearflag(FLAG_LIGHTHOUSE_FALLING_FROM_ABOVE)
	}
	
}

script Route15_CeliaStopsYou {
	lock
	setflag(FLAG_SAW_CELIA_ROUTE15)
	setvar(VAR_TEMP_A, 0)
	playse(SE_PIN)
	applymovement(LOCALID_ROUTE15_CELIA, moves(
		emote_exclamation_mark
	))
	waitmovement(0)
	delay(40)
	applymovement(LOCALID_PLAYER, moves(
		face_up
	))
	waitmovement(0)
	textcolor(NPC_TEXT_COLOR_FEMALE)
	goto(Route15_CeliaSandwich)
	msgbox("Looking for SANDWICH ingredients?\nDon't worry!\lYou don't have to go back for any.\pLook around and pay attention!\n", MSGBOX_DEFAULT)
	release
}

script Route15_CeliaSandwich {
	setflag(FLAG_SAW_CELIA_ROUTE15)
	setvar(VAR_TEMP_A, 0)
	msgbox("Looking for SANDWICH ingredients?\nDon't worry!\lYou don't have to go back for any.\pLook around and pay attention!\n", MSGBOX_NPC)
	end
}

