	msgbox("Oh no!\pGrandpa's dead!\n", MSGBOX_NPC)
	end
}

script Route15_DeadGrandpa {
	msgbox("oops.\n", MSGBOX_SIGN)
	end
}

script Route15_Tuber {
	lock
	faceplayer
	if(flag(FLAG_GOLURK_SANDWICH)) {
		msgbox("Wowwie!\nWas that a GHOST/GROUND TYPE?\pI've never seen one of those\nbefore!", MSGBOX_DEFAULT)
		applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
		waitmovement(0)
		release
		end
	}
	if(flag(FLAG_CSR_TALKED_TO_TUBER)) {
		msgbox("I'm gonna play pretend.\nI'll be the queen of this castle!\pDo you wanna play with me?\nMy mommy won't be back for a while.", MSGBOX_DEFAULT)	
	} else {
		msgbox("Oooh, wow!\nLook at this neat SANDCASTLE!\pOh? No, I didn't make it.\nSomeone else must have.", MSGBOX_DEFAULT)
	}
	applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
}

script Route15_Sandcastle {
	lock
	if(flag(FLAG_CSR_TUBER_EATEN)) {
		msgbox("The sandcastle appears well-fed.\n", MSGBOX_DEFAULT)
			playmoncry(SPECIES_PALOSSAND, CRY_MODE_NORMAL)
			waitmoncry
	} else {
		msgbox("The sandcastle is exceedingly\nwell-crafted.\pThere's an opening on the front.\nLook inside?", MSGBOX_YESNO)
		if(var(VAR_RESULT)) {
			setflag(FLAG_CSR_TALKED_TO_TUBER)
			msgbox("Peering into the sandcastle, you\nsee dozens of small skeletons.", MSGBOX_DEFAULT)
			if(checkitem(ITEM_SANDWICH, 1) && !flag(FLAG_GOLURK_SANDWICH)) {
				call(Route15_ShinyGolurk)
			}
			playmoncry(SPECIES_PALOSSAND, CRY_MODE_NORMAL)
			waitmoncry
		} else {
			msgbox("{PLAYER} decided against testing\nfate.", MSGBOX_DEFAULT)
		}
	}
	
	release
}

script Route15_ShinyGolurk {
					msgbox("Would you like to feed the\nSAND CASTLE a SAND WICH?", MSGBOX_YESNO)
					if(var(VAR_RESULT)) {
						msgbox("{PLAYER} fed the ominous CASTLE\na SANDWICH!", MSGBOX_DEFAULT)
						closemessage
						playmoncry(SPECIES_PALOSSAND, CRY_MODE_NORMAL)
						waitmoncry
						msgbox("Oh?\nOne of the CASTLE GUARDS showed up.\pLooks like it wants in on the\npicnic as well!", MSGBOX_DEFAULT)
						setvar(VAR_CSR_GIFT_POKEMON, SPECIES_GOLURK)
						setflag(FLAG_SHINY_CREATION) //GOLURK
						playfanfare(MUS_LEVEL_UP)
						msgbox("{PLAYER} obtained the\nGOLURK!", MSGBOX_DEFAULT)
						waitfanfare
						call(Common_Script_GiftPokemon)
						setflag(FLAG_GOLURK_SANDWICH)
						msgbox("{PLAYER} quickly made a\nnew SANDIWCH, such that\lyou don't have to do it again!", MSGBOX_DEFAULT)
					
				}
				return
}

