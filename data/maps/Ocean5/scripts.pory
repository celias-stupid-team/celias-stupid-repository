mapscripts Ocean5_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setbench(BENCH_HALF_ISLAND)
    }
}


script GreatSea_HalfIslandSign {
	msgbox(
	"HALF\n"
	"ISLAND\p"

	"POPULATION:\n"
	"ONE HALF", MSGBOX_SIGN)

}


script GreatSea_ShortFight {
    trainerbattle_single(TRAINER_SHORT, "Hey!\nI'm SHORT!\pI'm comfy and\neasy to wear!", "I've been\nripped!", GreatSea_ShortEnding)
}

script GreatSea_ShortEnding {
    textcolor(NPC_TEXT_COLOR_BLUE)
    msgbox(
	"I left to visit\n"
	"the GREAT SEA a\l"
	"while ago.\p"

	"I haven't quite been\n"
	"the same since…", MSGBOX_DEFAULT)
    closemessage
    //playerxy switch
    applymovement(LOCALID_SHORT, moves(
        walk_slower_up * 2
        delay_16
        walk_slower_left
    ))
    waitmovement(LOCALID_SHORT)
    playse(SE_LEDGE)
    applymovement(LOCALID_SHORT, moves(
        jump_2_left
        walk_slower_left * 2
    ))
    delay(30)
    fadescreenswapbuffers(FADE_TO_BLACK)
    waitmovement(LOCALID_SHORT)
    removeobject(LOCALID_SHORT)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    release
    end
}


script GreatSea_HalfWasland {
	msgbox(
	"HALF WASLAND\n"
	"", MSGBOX_SIGN)

}


script GreatSea_HalfIsland_999 {
	msgbox(
	"Oh, wow!\p"

	"It's the Steam port of Zero Escape\n"
	"9 Hours 9 Persons 9 Doors!\l"
	"In Adventure mode!", MSGBOX_SIGN)

}
