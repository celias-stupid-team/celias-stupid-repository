const LOOK_GIRL = 1
mapscripts FushciaGym_LookGirlRoom_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        if(var(VAR_FUCHSIA_LOOK_GIRL_LOCATION) == 0) {
            setvar(VAR_FUCHSIA_LOOK_GIRL_LOCATION, 18)
        } else {
            setobjectxyperm(LOOK_GIRL, VAR_FUCHSIA_LOOK_GIRL_LOCATION, 9)
        }
    }
}

script FushciaGym_LookGirlRoom_RedCurtain {
	msgbox("Behind the door is the back of\nthe red curtain.\pYou could easily walk through it,\nbut you choose not to.\lIt's important to play along!", MSGBOX_SIGN)
	end
}

script FushciaGym_LookGirlRoom_ResetButton {
    lock
    playse(SE_CLICK)
    setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 3)
    setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 3)
    setvar(VAR_SHAKESCREEN_NUM_SHAKES, 2)
    setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 1)
    setvar(VAR_FUCHSIA_LOOK_GIRL_LOCATION, 18)
    setobjectxy(LOOK_GIRL, VAR_FUCHSIA_LOOK_GIRL_LOCATION, 9)
    setobjectxyperm(LOOK_GIRL, VAR_FUCHSIA_LOOK_GIRL_LOCATION, 9)
    applymovement(LOOK_GIRL, Common_Movement_FaceUp)
    waitmovement(0)
    special(DrawWholeMapView)
    special(ShakeScreen)
    release
    end
}


script FushciaGym_LookGirl_Sign {
	msgbox("TRAINER TIPS\pTalk to her again!\n", MSGBOX_SIGN)
	end
}

script FushciaGym_LookGirlRoom_Scroll {
    lock
    if(flag(FLAG_MEMORIZED_SCROLL)) {
        msgbox("{PLAYER} wrote down the secret\nmessage…", MSGBOX_DEFAULT)
        closemessage
        msgbox(Text_Bookshelf)
        closemessage
        msgbox("The secret door opened!\n", MSGBOX_DEFAULT)
        warp(MAP_FUSHCIA_GYM_DEVON_SCOPE_ROOM, 0)
    } else {
        msgbox("There's a scroll on the wall.\nIt needs a secret message.", MSGBOX_DEFAULT)
    }
    release
    end
}

script FushciaGym_LookLookGirl {
	    lock
	
		msgbox(format("Hmm...\nIs that right..."), MSGBOX_DEFAULT)
		applymovement(VAR_LAST_TALKED, Common_Movement_FacePlayer)
		waitmovement(0)
		playse(SE_PIN)
		applymovement(VAR_LAST_TALKED, DT_exclmark)
		waitmovement(0)
		delay(48)
		msgbox(format("Oh!\nLook, look!"), MSGBOX_DEFAULT)
		closemessage
		switch(var(VAR_FACING)) {
			case DIR_EAST:
                    addvar(VAR_FUCHSIA_LOOK_GIRL_LOCATION, 1)
					applymovement(VAR_LAST_TALKED, DT_walkbackRight)
					waitmovement(0)
					break
				default:
                    subvar(VAR_FUCHSIA_LOOK_GIRL_LOCATION, 1)
					applymovement(VAR_LAST_TALKED, DT_walkbackLeft)
					waitmovement(0)
					break
        }
    copyobjectxytoperm(VAR_LAST_TALKED)
	release
}