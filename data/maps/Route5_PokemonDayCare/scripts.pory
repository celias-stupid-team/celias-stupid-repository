@ Handled by data/scripts/day_care.inc

::
	.byte 0
`
mapscripts Route5_PokemonDayCare_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		if(var(VAR_NUMBER_FOR_SALES) < 7) {
			setflag(FLAG_TEMP_7)
		}
		if(var(VAR_NUMBER_FOR_SALES) < 6) {
			setflag(FLAG_TEMP_6)
		}
		if(var(VAR_NUMBER_FOR_SALES) < 5) {
			setflag(FLAG_TEMP_5)
		}
		if(var(VAR_NUMBER_FOR_SALES) < 4) {
			setflag(FLAG_TEMP_4)
		}
		if(var(VAR_NUMBER_FOR_SALES) < 3) {
			setflag(FLAG_TEMP_3)
		}
		if(var(VAR_NUMBER_FOR_SALES) < 2) {
			setflag(FLAG_TEMP_2)
		}
		if(var(VAR_NUMBER_FOR_SALES) < 1) {
			setflag(FLAG_TEMP_1)
		}
	}
}

script AbandonedHouse_ForSale {
	msgbox(
	"One of the FOR SALE signs you\n"
	"bought.", MSGBOX_SIGN)

}



script AbandonedHouse_Bed {
	lock
	msgbox("{PLAYER} laid in the bed.\pMmm…\nThis bed stinks!", MSGBOX_DEFAULT)
	release
}

script AbandonedHouse_WEmblem {
	finditem(ITEM_W_EMBLEM)
}

script AbandonedHouse_Books {
	lock
	msgbox("The books are tattered.\nSome words can be made out…", MSGBOX_DEFAULT)
	closemessage
	delay(10)
	msgbox("My --- Life, Ch--\pI w-- --her a mur-- sus--,\nnor a t--- -- - --nterna--…", MSGBOX_DEFAULT)
	closemessage
	delay(10)
	msgbox("You decide to stop reading.\n", MSGBOX_DEFAULT)
	release
}