script SilphCo_PikachuScientist {
	lock
	faceplayer
	if(flag(FLAG_TEMP_3)) {
		if(!flag(FLAG_TEMP_4)) {
			msgbox(
			"Um, speak into the microphone.\n"
			"{PAUSE 20}Not to me.", MSGBOX_DEFAULT)
		} else {
			msgbox(
			"Isn't my invention neat?\n"
			"", MSGBOX_DEFAULT)
		}
	} else {
		msgbox(
		"We're developing the technology\n"
		"to talk to POKéMON via microphone.\p"

		"Here - give it a try!\n"
		"", MSGBOX_DEFAULT)
		closemessage
		applymovement(VAR_LAST_TALKED, moves(
			walk_right
			face_left
		))
		waitmovement(0)
		setflag(FLAG_TEMP_3)
		copyobjectxytoperm(VAR_LAST_TALKED)
	}
	release
}

script SilphCo_PikachuWindow {
	lock
	setflag(FLAG_TEMP_4)
	message(
	"You can talk to PIKACHU!\n"
	"What do you want to say?{PAUSE 20}")
	waitmessage
	dynmultichoice(2,4,TRUE,5, 0, DYN_MULTICHOICE_CB_NONE, "Hello, PIKACHU!", "Use THUNDERBOLT!", "Do a cool flip!", "How do you feel about the current", "problems in the Middle East?")
	special(SpawnCameraObject)
	closemessage
	applymovement(LOCALID_CAMERA, moves(
		walk_fast_up * 2
	))
	waitmovement(LOCALID_CAMERA)
	switch(var(VAR_RESULT)) {
		case 0:
			closemessage
			delay(30)
			//playse(SE_BANG)
			applymovement(LOCALID_SILPH_PIKACHU, moves(
				emote_smile
				delay_16 * 3
			))
			playmoncry(SPECIES_PIKACHU_OLD, CRY_MODE_NORMAL)
			waitmoncry
		case 1:
			closemessage
			delay(30)
			playse(SE_M_THUNDERBOLT)
			applymovement(LOCALID_SILPH_PIKACHU, moves(
				jump_in_place_down * 2
			))
			waitmovement(0)
			waitse
			playse(SE_M_THUNDERBOLT2)
			waitse
		case 2:
			closemessage
			delay(30)
			playse(SE_LEDGE)
			applymovement(LOCALID_SILPH_PIKACHU, moves(
				lock_facing_direction
				walk_faster_up
				unlock_facing_direction
				face_left
				delay_2
				face_up
				delay_2
				face_right
				delay_2
				jump_down
			))
			waitmovement(0)
		case 3:
		case 4:
			closemessage
			delay(30)
			playse(SE_BANG)
			applymovement(LOCALID_SILPH_PIKACHU, moves(
				emote_double_exclamation_mark
				delay_16 * 3
			))
			playmoncry(SPECIES_PIKACHU_OLD, CRY_MODE_ENCOUNTER)
			waitmoncry
			delay(60)
			msgbox(
			"Wow!\p"

			"What a nuanced answer!\n"
			"", MSGBOX_DEFAULT)
	}
	closemessage
	delay(30)
	applymovement(LOCALID_CAMERA, moves(
		walk_fast_down * 2
	))
	waitmovement(LOCALID_CAMERA)
	special(RemoveCameraObject)
	release
	end
}

