mapscripts Silph_RD_MapScripts {

}

script SilphCo_RD_Sign {
	msgbox(
	"SILPH CO\n"
	"R & D", MSGBOX_SIGN)

}


script SilphCo_RD_ApplinKid {
	lock
	faceplayer
	if(flag(FLAG_GOT_PENCIL_ERASER)) {
		msgbox(
		"I am APPLIN KID.\n"
		"", MSGBOX_DEFAULT)
	} else {
		msgbox(
		"I am APPLIN KID.\p"

		"Here!\n"
		"", MSGBOX_DEFAULT)
		giveitem_msg(
		"{PLAYER} obtained the\n"
		"PENCIL ERASER!",
		ITEM_PENCIL_ERASER, 1)
		setflag(FLAG_GOT_PENCIL_ERASER)

	}
	release
}

script SilphCo_RD_OranKid {
	msgbox(
	"I am ORAN KID.\n"
	"", MSGBOX_NPC)
}


script SilphCo_RD_Elevator {
	msgbox(
	"Rats!\n", MSGBOX_SIGN)

}

script SilphCo_MakeElevatorDisappear {
	lock
	applymovement(LOCALID_APPLE_KID, moves(
		face_up
	))
	playse(SE_CLICK)
	delay(60)
	setmetatile(6, 0, 0x330, TRUE)
	setmetatile(7, 0, 0x330, TRUE)
	setmetatile(8, 0, 0x330, TRUE)
	
	setmetatile(6, 1, 0x338, TRUE)
	setmetatile(7, 1, 0x338, TRUE)
	setmetatile(8, 1, 0x338, TRUE)
	special(DrawWholeMapView)
	
			    setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 3)
				setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 3)
				setvar(VAR_SHAKESCREEN_NUM_SHAKES, 2)
				setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 1)
				special(ShakeScreen)
	delay(60)
	msgbox(
	"APPLIN KID: Excellent!\n"
	"My ELEVATOR ERASER is working!", MSGBOX_DEFAULT)
	setvar(VAR_TEMP_1, 1)
	release
}