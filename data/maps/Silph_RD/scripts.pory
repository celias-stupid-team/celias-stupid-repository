script SilphCo_OranPainting {
	lock
	playse(SE_PIN)
	applymovement(LOCALID_ORAN_KID, moves(
		face_right
		emote_exclamation_mark
		delay_16 * 3
	))
	waitmovement(0)
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"ORAN KID: Ah, I see you have a\n"
	"discerning eye.\p"

	"That right there is called a\n{PAUSE 20}“painting”.\l"

	"You may have heard of such things.\p"
	"Yes, I am indeed quite cultured.\nOho!", MSGBOX_DEFAULT)
	closemessage
	applymovement(LOCALID_ORAN_KID, moves(
		face_original_direction
	))
	waitmovement(0)
	release

}

