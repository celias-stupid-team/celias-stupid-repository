script SilphCo_MonkeyFour {
	lock
	faceplayer
	playmoncry(SPECIES_PANPOUR, CRY_MODE_DEFAULT)
	waitmoncry
	delay(30)
	playse(SE_PIN)
	applymovement(LOCALID_SILPH_MONKEY_MASTER, moves(
		emote_exclamation_mark
		delay_16 * 3
		walk_faster_left * 3
		face_up
	))
	waitmovement(0)
	delay(20)
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"HEY!\n"
	"{PAUSE 20}GET BACK TO WORK!", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	applymovement(VAR_LAST_TALKED, moves(
		face_up
		delay_16
		face_down
		delay_16
		face_up
		delay_16 * 2
		face_original_direction
	))
	waitmovement(0)
	delay(30)
	applymovement(LOCALID_SILPH_MONKEY_MASTER, moves(
		walk_slow_right * 3
		face_up
	))
	delay(15)
	msgbox(
	"Grumble… {PAUSE 20}\n"
	"That one's always been a problem…", MSGBOX_DEFAULT)
	closemessage
	setflag(FLAG_SILPH_MONKEY)
	waitmovement(0)
	release
	end
}

