mapscripts Silph_RD_MapScripts {

}

script SilphCo_RD_Sign {
	msgbox(
	"SILPH CO\n"
	"R&D", MSGBOX_SIGN)

}


script SilphCo_RD_ApplinKid {
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_BLUE)
	if(flag(FLAG_GOT_PENCIL_ERASER)) {
		msgbox(
		"That PENCIL ERASER is something\n"
		"special.\p"

		"It'll eradicate all pencil-shaped\n"
		"objects nearby.\p"

		"If you use it before school, make\n"
		"sure you keep a pen handy!", MSGBOX_DEFAULT)
	} else {
		msgbox(
		"Oh! Ah!\n"
		"A visitor?\p"

		"Hello. I'm APPLIN KID.\n"
		"Sorry, my office is a pig sty…\l"
		"And I haven't taken a bath in ages.\p"

		"By the way, I'm starving.\n"
		"Can I have something to eat?", MSGBOX_YESNO)
		if(var(VAR_RESULT)) {
			if(checkitem(ITEM_HAMBURGER)) {
				removeitem(ITEM_HAMBURGER)
				msgbox(
				"Oh, that's a HAMBURGER!\n"
				"There's still one left!\l"
				"Thanks so much!", MSGBOX_DEFAULT)
				playse(SE_M_BITE)
				waitse
				msgbox(
				"Thank you!\n"
				"They don't actually, uh, pay me.\p"

				"Anyway, I just finished work on\n"
				"this great invention.\l"
				"It's called the “PENCIL ERASER.”\p"

				"It'll eradicate all pencil-shaped\n"
				"objects nearby instantaneously!\p"

				"Here, take it!\n"
				"", MSGBOX_DEFAULT)
				giveitem_msg(
				"{PLAYER} obtained the\n"
				"PENCIL ERASER!",
				ITEM_PENCIL_ERASER, 1)
				setflag(FLAG_GOT_PENCIL_ERASER)
				msgbox(
				"Make sure you don't use it near\n"
				"a pencil shop!\l"
				"haha…", MSGBOX_DEFAULT)

			} else {
				msgbox(
				"Oh, you don't seem to have any\n"
				"food I can eat.\l"
				"I'm not a garbage can, y'know…\p"

				"I used to live on TWO ISLAND.\n"
				"I think there's food there still.\l"
				"Unless I, uh…\p"

				"Anyway!\n"
				"Thanks for visiting. Good bye.", MSGBOX_DEFAULT)
			}

		} else {
			msgbox(
				"Well, go ahead and make yourself\n"
				"comfortable anyway.\l"
				"You can flop down anywhere.", MSGBOX_DEFAULT)
				release
				end
		}

	}
	release
}

script SilphCo_RD_OranKid {
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"Ohoho!\n"
	"Why, hello there!\l"
	"My name is ORAN KID.\p"

	"I'm a genius inventor, if I do say\n"
	"so myself.\l"
	"Yes, an absolute prodigy!\p"

	"Hm?\n"
	"You'd like to see my work?\p"

	"Ohoho, how silly of you!\n"
	"I haven't actually made anything!\p"

	"See, my parents own this company.\n"
	"Therefore, I am a genius!\l"
	"It's quite simple!", MSGBOX_NPC)
}


script SilphCo_RD_Elevator {
	msgbox(
	"Rats!\n", MSGBOX_SIGN)

}

script SilphCo_MakeElevatorDisappear {
	lock
	textcolor(NPC_TEXT_COLOR_BLUE)
	applymovement(LOCALID_APPLE_KID, moves(
		face_up
	))
	playse(SE_CLICK)
	delay(60)
	setmetatile(6, 0, 0x330, TRUE)
	setmetatile(7, 0, 0x330, TRUE)
	setmetatile(8, 0, 0x330, TRUE)
	
	setmetatile(6, 1, 0x338, TRUE)
	setmetatile(7, 1, 0x338, TRUE)
	setmetatile(8, 1, 0x338, TRUE)
	special(DrawWholeMapView)
	
			    setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 3)
				setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 3)
				setvar(VAR_SHAKESCREEN_NUM_SHAKES, 2)
				setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 1)
				special(ShakeScreen)
	delay(60)
	msgbox(
	"APPLIN KID: Excellent!\n"
	"My ELEVATOR ERASER is working!", MSGBOX_DEFAULT)
	setvar(VAR_TEMP_1, 1)
	release
}