script SilphCo_FinancialReport {
	lock
	faceplayer
	if(flag(FLAG_FINANCIAL_REPORT_TOSSED)) {
		msgbox(
		"…\p"

		"Looks like it's back to work.\n"
		"", MSGBOX_DEFAULT)
		release
		end
	}
	addobject(LOCALID_SILPH_CHUCKSTER)
	applymovement(LOCALID_SILPH_CHUCKSTER, moves(
		delay_16 * 6
		set_visible
		walk_left * 2
		walk_up * 6
		walk_right * 3
		face_up
	))
	msgbox(
	"After weeks of work, I've finally\n"
	"finished our financial report!\p"

	"Phew, and with only a single day\n"
	"to spare.\l"
	"Looks like I can take some time off!", MSGBOX_DEFAULT)

	closemessage
	waitmovement(LOCALID_SILPH_CHUCKSTER)
	setflag(FLAG_FINANCIAL_REPORT_TOSSED)
	delay(30)
	playse(SE_PIN)
	specialvar(VAR_TEMP_6, GetPlayerFacingDirection)
	
	applymovement(VAR_LAST_TALKED, moves(
		face_down
		emote_exclamation_mark
		delay_16 * 3
	))
	applymovement(LOCALID_PLAYER, moves(
		face_down
	))
	waitmovement(VAR_LAST_TALKED)
	switch(var(VAR_TEMP_6)) {
		case DIR_NORTH:
			applymovement(LOCALID_PLAYER, moves(
				face_right
				lock_facing_direction
				walk_left
				unlock_facing_direction
			))
		case DIR_EAST:
			nop
		case DIR_WEST:
			applymovement(LOCALID_PLAYER, moves(
				face_up
				lock_facing_direction
				walk_down
				unlock_facing_direction
				face_left
			))
	}
	applymovement(VAR_LAST_TALKED, moves(
		face_left
		lock_facing_direction
		walk_right
		unlock_facing_direction
	))
	waitmovement(VAR_LAST_TALKED)
	applymovement(LOCALID_SILPH_CHUCKSTER, moves(
		walk_slow_up * 2
		face_up
		delay_16 * 3
	))
	waitmovement(LOCALID_SILPH_CHUCKSTER)
	if(var(VAR_TEMP_6) == DIR_EAST) {
			applymovement(LOCALID_PLAYER, moves(
				face_up
				lock_facing_direction
				walk_down
				unlock_facing_direction
				face_left
			))
	}
	applymovement(LOCALID_SILPH_CHUCKSTER, moves(
		walk_left * 3
		face_up
	))
	applymovement(LOCALID_SILPH_COMPUTER, moves(
		lock_facing_direction
		walk_left * 3
	))
	waitmovement(LOCALID_SILPH_CHUCKSTER)
	delay(50)
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"I'm a CHUCKSTER!\n"
	"", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	applymovement(LOCALID_SILPH_CHUCKSTER, moves(
		walk_fast_up
		face_up
	))
	applymovement(LOCALID_SILPH_COMPUTER, moves(
		jump_2_up
		face_up
		set_invisible
	))
	waitmovement(LOCALID_SILPH_COMPUTER)
	playse(SE_ICE_BREAK)
	addobject(LOCALID_SILPH_COMPUTER_WINDOW)
	removeobject(LOCALID_SILPH_COMPUTER)
	waitse
	delay(60)
	applymovement(LOCALID_SILPH_CHUCKSTER, moves(
		walk_down * 9
	))
	
	applymovement(VAR_LAST_TALKED, moves(
		delay_16 * 5
		walk_slower_left
		face_up
	))
	waitmovement(VAR_LAST_TALKED)
	waitmovement(LOCALID_SILPH_CHUCKSTER)
	removeobject(LOCALID_SILPH_CHUCKSTER)
	release
	end

}

