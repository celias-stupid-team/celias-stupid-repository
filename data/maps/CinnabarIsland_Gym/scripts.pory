		setmetatile(9, 21, 0x29F, TRUE)
		setmetatile(9, 22, 0x280, TRUE)
		special(DrawWholeMapView)
		delay(30)
		special(SpawnCameraObject)
		playse(SE_FALL)
		applymovement(LOCALID_PLAYER, moves(
			lock_facing_direction
			slide_down * 3
			set_invisible
		))
		waitmovement(LOCALID_PLAYER)
		fadescreeninstant(FADE_TO_BLACK)
		waitse
		playse(SE_M_ACID_ARMOR)
		waitse
		warpsilent(MAP_CINNABAR_ISLAND_GYM, 1)
		release
		end

	}
}

script CinnabarGym_BoardGameQuestion4 {
	lock
	msgbox(
	"BLAINE'S FURNACE FUN{PAUSE 30}\n"
	"Question 4:\p"

	"Eek!{PAUSE 30}\n"
	"Did you just look at me?", MSGBOX_YESNO)
	closemessage
	playbgm(MUS_ENCOUNTER_GIRL, FALSE)
	delay(60)
	addobject(LOCALID_BLAINE_LASS)
	applymovement(LOCALID_BLAINE_LASS, moves(
		walk_down * 6
		walk_right * 2
	))
	waitmovement(0)
	delay(30)
	textcolor(NPC_TEXT_COLOR_FEMALE)
	if(var(VAR_RESULT)) {
		msgbox(
		"I knew it!\n"
		"", MSGBOX_DEFAULT)

	} else {
		msgbox(
		"Don't lie to me!\n"
		"", MSGBOX_DEFAULT)
	}
	msgbox(
	"battle happens here\n"
	"", MSGBOX_DEFAULT)
	fadedefaultbgm
	closemessage
	delay(30)
	playse(SE_CLICK)
	setmetatile(8, 16, METATILE_BlaineFurnaceFun_Lava, TRUE)
	setmetatile(8, 17, METATILE_BlaineFurnaceFun_Lava, TRUE)
	setmetatile(8, 18, METATILE_BlaineFurnaceFun_Lava, TRUE)
	special(DrawWholeMapView)
	delay(30)
	playse(SE_FALL)
	applymovement(LOCALID_BLAINE_LASS, moves(
		lock_facing_direction
		slide_down * 3
		set_invisible
	))
	waitmovement(LOCALID_BLAINE_LASS)
	waitse
	playse(SE_M_ACID_ARMOR)
	removeobject(LOCALID_BLAINE_LASS)
	waitse
	setvar(VAR_BLAINE_GYM_QUESTION, 5)


}

script CinnabarGym_AddChuckster {
	addobject(LOCALID_BLAINE_CHUCKSTER)
	clearflag(FLAG_TEMP_1)
	release
}

script CinnabarGym_BoardGameQuestion5 {
	lock
	msgbox(
	"BLAINE'S FURNACE FUN{PAUSE 10}\n"
	"Question 5:\p"

	"TM28 contains TOMBSTONIFIER?\n"
	"", MSGBOX_YESNO)
	if(!var(VAR_RESULT)) {
		waitse
		playse(SE_SUCCESS)
		waitse
		applymovement(LOCALID_BLAINE_TRAINER_5, moves(
			walk_left * 2
		))
		waitmovement(LOCALID_BLAINE_TRAINER_5)
		msgbox(
		"battle happens here\n"
		"", MSGBOX_DEFAULT)
		closemessage
		delay(30)
		playse(SE_CLICK)
		setmetatile(15, 16, METATILE_BlaineFurnaceFun_Lava, TRUE)
		setmetatile(15, 17, METATILE_BlaineFurnaceFun_Lava, TRUE)
		setmetatile(15, 18, METATILE_BlaineFurnaceFun_Lava, TRUE)
		special(DrawWholeMapView)
		delay(30)
		playse(SE_FALL)
		applymovement(LOCALID_BLAINE_TRAINER_5, moves(
			lock_facing_direction
			slide_down * 3
			set_invisible
		))
		waitmovement(LOCALID_BLAINE_TRAINER_5)
		waitse
		playse(SE_M_ACID_ARMOR)
		removeobject(LOCALID_BLAINE_TRAINER_5)
		waitse
		release
		end


	} else {
		waitse
		playse(SE_BOO)
		waitse
		closemessage
		delay(30)
		playse(SE_CLICK)
		setmetatile(14, 16, 0x2C2, TRUE)
		setmetatile(14, 17, 0x29F, TRUE)
		setmetatile(14, 18, 0x29C, TRUE)
		special(DrawWholeMapView)
		delay(30)
		playse(SE_FALL)
		applymovement(LOCALID_PLAYER, moves(
			lock_facing_direction
			slide_down * 3
			unlock_facing_direction
			face_down
		))
		waitmovement(LOCALID_PLAYER)
		setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 2)
		setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 2)
		setvar(VAR_SHAKESCREEN_NUM_SHAKES, 4)
		setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 2)
		special(ShakeScreen)
		delay(30)

		release
		end

	}
}