script CinnabarGym_BoardGameQuestion1 {
	lock
	msgbox(
	"BLAINE'S FURNACE FUN{PAUSE 10}\n"
	"Question 1:\p"

	"How many holes{PAUSE 30} in a polo?\n"
	"", MSGBOX_YESNO)
	if(var(VAR_RESULT)) {
		waitse
		playse(SE_SUCCESS)
		setvar(VAR_BLAINE_GYM_QUESTION, 1)
		waitse
		applymovement(LOCALID_BLAINE_TRAINER_1, moves(
			walk_right * 3
		))
		waitmovement(LOCALID_BLAINE_TRAINER_1)
		msgbox(
		"battle happens here\n"
		"", MSGBOX_DEFAULT)
		closemessage
		delay(30)
		playse(SE_CLICK)
		setmetatile(9, 32, METATILE_BlaineFurnaceFun_Lava, TRUE)
		setmetatile(9, 33, METATILE_BlaineFurnaceFun_Lava, TRUE)
		setmetatile(9, 34, METATILE_BlaineFurnaceFun_Lava, TRUE)
		special(DrawWholeMapView)
		delay(30)
		playse(SE_FALL)
		applymovement(LOCALID_BLAINE_TRAINER_1, moves(
			lock_facing_direction
			slide_down * 3
			set_invisible
		))
		waitmovement(LOCALID_BLAINE_TRAINER_1)
		waitse
		playse(SE_M_ACID_ARMOR)
		removeobject(LOCALID_BLAINE_TRAINER_1)
		waitse
		release
		end


	} else {
		waitse
		playse(SE_BOO)
		waitse
		closemessage
		delay(30)
		playse(SE_CLICK)
		setmetatile(10, 32, 0x2C3, TRUE)
		setmetatile(10, 33, 0x29F, TRUE)
		setmetatile(10, 34, 0x280, TRUE)
		special(DrawWholeMapView)
		delay(30)
		special(SpawnCameraObject)
		playse(SE_FALL)
		applymovement(LOCALID_PLAYER, moves(
			lock_facing_direction
			slide_down * 3
			set_invisible
		))
		waitmovement(LOCALID_PLAYER)
		fadescreeninstant(FADE_TO_BLACK)
		waitse
		playse(SE_M_ACID_ARMOR)
		waitse
		warpsilent(MAP_CINNABAR_ISLAND_GYM, 1)
		release
		end

	}
}

script CinnabarGym_ClearQuestionFloors {
	if(var(VAR_BLAINE_GYM_QUESTION) > 0) {
		setmetatile(9, 32, METATILE_BlaineFurnaceFun_Lava, TRUE)
		setmetatile(9, 33, METATILE_BlaineFurnaceFun_Lava, TRUE)
		setmetatile(9, 34, METATILE_BlaineFurnaceFun_Lava, TRUE)

	}
	if(var(VAR_BLAINE_GYM_QUESTION) > 1) {
		setmetatile(16, 28, METATILE_BlaineFurnaceFun_Lava, TRUE)
		setmetatile(16, 29, METATILE_BlaineFurnaceFun_Lava, TRUE)
		setmetatile(16, 30, METATILE_BlaineFurnaceFun_Lava, TRUE)

	}
}


