`
script CinnabarGym_Blaine {
	lock
	faceplayer
	if(flag(FLAG_BADGE07_GET)) {
		msgbox(
		"You beat me\n"
		"", MSGBOX_DEFAULT)
		release
		end
	}
	if(!flag(FLAG_TALKED_TO_BLAINE)) {
		setflag(FLAG_TALKED_TO_BLAINE)
		msgbox(
		"Welcome to the gym\p"

		"here's a quiz\n"
	"", MSGBOX_DEFAULT)
		addvar(VAR_CINNABAR_GYM_PHASE, 1)
	} else {
		msgbox(
		"Ready for quiz\n"
		"", MSGBOX_DEFAULT)
	}
	goto(CinnabarGym_GymQuestionLoop)
}


script CinnabarGym_GymQuestionLoop {
	switch(var(VAR_CINNABAR_GYM_PHASE)) {
		case 1:
			setvar(VAR_CURRENT_BLAINE_ANSWER, 1) // Bulbasaur or 
			msgbox(
			"QUESTION 1!\p"

			"Who is{PAUSE 30} the first POKéMON?", MSGBOX_DEFAULT)
		
		case 2:
			setvar(VAR_CURRENT_BLAINE_ANSWER, 2) // Hitmonchan or Hitmonchin?
			msgbox(
			"QUESTION 2!\p"

			"This POKéMON shares part of its\n"
			"name with a famous Martial Artist.", MSGBOX_DEFAULT)
		
		case 3:
			setvar(VAR_CURRENT_BLAINE_ANSWER, 3)
			msgbox(
			"QUESTION 3!\p"

			"This POKéMON's name is the same\n"
			"both forwards and backwards.", MSGBOX_DEFAULT)
		
		case 4:
			setvar(VAR_CURRENT_BLAINE_ANSWER, 4)
			msgbox(
			"QUESTION 4!\p"

			"According to the 2023 Census, this\n"
			"POKéMON has a population of over\l"
			"23 Million!", MSGBOX_DEFAULT)
		case 5:
			setvar(VAR_CURRENT_BLAINE_ANSWER, 5)
			msgbox(
			"QUESTION 5!\p"

			"The winner of Smash Summit 7 Semi-\n"
			"Finals featuring Zain was…?", MSGBOX_DEFAULT)
		
		case 6:
			setvar(VAR_CURRENT_BLAINE_ANSWER, 6)
			msgbox(
			"QUESTION 6!\p"

			"What is the fifth word of Proverbs\n"
			"Chapter 1 Verse 14 (KJV, 1638)?", MSGBOX_DEFAULT)
		
		case 7:
			setvar(VAR_CURRENT_BLAINE_ANSWER, 7)
		
		case 8:
			setvar(VAR_CURRENT_BLAINE_ANSWER, 8)
			msgbox(
			"QUESTION 8!\p"

			"Who is the last POKéMON?", MSGBOX_DEFAULT)
	}
	special(ChoosePartyMon)
	closemessage
	waitstate
    if(var(VAR_0x8004) >= PARTY_SIZE) {
        msgbox(
		"What's that?\n"
		"You don't know the answer?\p"

		"All righty, folks!\n"
		"We'll be back after a short break!", MSGBOX_DEFAULT)
		release
		end
    }
    specialvar(VAR_RESULT, ScriptGetPartyMonSpecies)
	switch(var(VAR_CINNABAR_GYM_PHASE)) {
		case 1:
			if(var(VAR_RESULT) == SPECIES_BULBASAUR || var(VAR_RESULT) == SPECIES_RHYDON) {
				msgbox(
				"Ah, so that's your answer?\p"

				"Let's see if it's correct!\n"
				"", MSGBOX_DEFAULT)
				// battle
				goto(CinnabarGym_CheckBattleOutcome)
			} else {
				goto(CinnabarGym_IncorrectAnswer)
			}
		case 2:
			if(var(VAR_RESULT) == SPECIES_HITMONCHAN_SHIT || var(VAR_RESULT) == SPECIES_RHYDON) {
				msgbox(
				"Ah, so that's your answer?\p"

				"Let's see if it's correct!\n"
				"", MSGBOX_DEFAULT)
				// battle
				goto(CinnabarGym_CheckBattleOutcome)
			} else {
				goto(CinnabarGym_IncorrectAnswer)
			}
		case 3:
			if(var(VAR_RESULT) == SPECIES_ALOMOMOLA || var(VAR_RESULT) == SPECIES_RHYDON) {
				msgbox(
				"Ah, so that's your answer?\p"

				"Let's see if it's correct!\n"
				"", MSGBOX_DEFAULT)
				// battle
				goto(CinnabarGym_CheckBattleOutcome)
			} else {
				goto(CinnabarGym_IncorrectAnswer)
			}
		case 4:
			if(var(VAR_RESULT) == SPECIES_KENYA || var(VAR_RESULT) == SPECIES_RHYDON) {
				msgbox(
				"Ah, so that's your answer?\p"

				"Let's see if it's correct!\n"
				"", MSGBOX_DEFAULT)
				// battle
				goto(CinnabarGym_CheckBattleOutcome)
			} else {
				goto(CinnabarGym_IncorrectAnswer)
			}
		case 5:
			if(var(VAR_RESULT) == SPECIES_JIGGLYPUFF || var(VAR_RESULT) == SPECIES_RHYDON) {
				msgbox(
				"Ah, so that's your answer?\p"

				"Let's see if it's correct!\n"
				"", MSGBOX_DEFAULT)
				// battle
				goto(CinnabarGym_CheckBattleOutcome)
			} else {
				goto(CinnabarGym_IncorrectAnswer)
			}
		case 6:
			if(var(VAR_RESULT) == SPECIES_AMOONGUSS || var(VAR_RESULT) == SPECIES_RHYDON) {
				msgbox(
				"Ah, so that's your answer?\p"

				"Let's see if it's correct!\n"
				"", MSGBOX_DEFAULT)
				// battle
				goto(CinnabarGym_CheckBattleOutcome)
			} else {
				goto(CinnabarGym_IncorrectAnswer)
			}
		case 7:
		case 8:
	}

	// Keep track of if you've been secret the whole time
	// Do the battle
	// If you win, increment your current question
}

script CinnabarGym_CheckBattleOutcome {
	specialvar(VAR_TEMP_F, GetBattleOutcome)
	setvar(VAR_TEMP_F, B_OUTCOME_WON) // TEMPORARY!!!! SWITCH THIS OUT YOU IDIOT
	if(var(VAR_TEMP_F) == B_OUTCOME_WON) {
		playse(SE_SUCCESS)
		waitse
		addvar(VAR_CINNABAR_GYM_PHASE, 1)
		if(var(VAR_CINNABAR_GYM_PHASE) == 7) {
			msgbox(
			"That's absolutely CORRECT!\n"
			"Nicely done!", MSGBOX_DEFAULT)
			msgbox(
			"{PLAYER} obtained the\n"
			"VOLCANOBAKEMEAT BADGE!", MSGBOX_DEFAULT)
			setflag(FLAG_BADGE07_GET)
			waitfanfare
			setvar(VAR_TEMP_C, 1) //For the shakey ground
			release
			end
		}
		playse(SE_SUCCESS)
		waitse
		msgbox(
		"That's absolutely CORRECT!\n"
		"Nicely done!\p"

		"Are you ready for your next\n"
		"challenge?\l"
		"Let's go!", MSGBOX_DEFAULT)
		goto(CinnabarGym_GymQuestionLoop)

	} else {
		goto(CinnabarGym_IncorrectAnswer)
	}
}


script CinnabarGym_IncorrectAnswer {
	playse(SE_BOO)
	waitse
	msgbox(
	"I'm so sorry, but that answer\n"
	"is INCORRECT!\p"

	"But not to worry!\n"
	"Take a pause and try again!", MSGBOX_DEFAULT)
	release
	end
}


script CinnabarGym_IslandAppears {
	lock
	playbgm(MUS_NONE, FALSE)
	setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 4)
    setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 4)
    setvar(VAR_SHAKESCREEN_NUM_SHAKES, 20)
    setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 1)
	special(ShakeScreen)
	delay(120)
	setvar(VAR_TEMP_C, 0)
	setflag(FLAG_MIRAGE_ISLAND_APPEARS)
	setmetatile(9, 2, 0x16B, TRUE)
	release
}

script CinnabarGym_BackDoor {
	if(flag(FLAG_MIRAGE_ISLAND_APPEARS)) {
		msgbox(
		"For some reason, the door is\n"
		"blocked.", MSGBOX_DEFAULT)
	} else {
		msgbox(
		"A back door!\n"
		"Neat!", MSGBOX_DEFAULT)
	}
}


