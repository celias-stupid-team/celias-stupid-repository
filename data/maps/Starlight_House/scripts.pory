{COLOR DYNAMIC_COLOR3}I
{COLOR DYNAMIC_COLOR4}N
{COLOR DYNAMIC_COLOR5}B
{COLOR DYNAMIC_COLOR6}O
{COLOR DARK_GRAY}W", MSGBOX_SIGN)
}

