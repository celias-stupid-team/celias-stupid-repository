script Starlight_House_Color_Test {
	msgbox(
"{COLOR WHITE}C
{COLOR DARK_GRAY}O
{COLOR LIGHT_GRAY}L
{COLOR RED}O
{COLOR LIGHT_RED}R
{COLOR GREEN}F
{COLOR LIGHT_GREEN}U
{COLOR BLUE}L
{COLOR LIGHT_BLUE}L
{COLOR DYNAMIC_COLOR1}R
{COLOR DYNAMIC_COLOR2}A
{COLOR DYNAMIC_COLOR3}I
{COLOR DYNAMIC_COLOR4}N
{COLOR DYNAMIC_COLOR5}B
{COLOR DYNAMIC_COLOR6}O
{COLOR DARK_GRAY}W", MSGBOX_SIGN)
}

