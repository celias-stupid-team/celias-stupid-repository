script Starlight_House_Sink { //figure out yesno setup for reading messages.
	if(flag(FLAG_TEMP_5)) {
	msgbox(
	"There's another one poking out of\n"
	"the faucet, blocking the water.\p"

	"Poke it?", MSGBOX_YESNO)
	}
	if(!flag(FLAG_TEMP_5)) {
	msgbox(
	"There's something poking out of\n"
	"the faucet, blocking the water.\p"

	"Poke it?", MSGBOX_YESNO)
	}
		if(var(VAR_RESULT)) {
			closemessage
			msgbox(
			"An ear popped out.\p"

			"Poke it again?", MSGBOX_YESNO)
		}
			if(var(VAR_RESULT)) {
				//closemessage
				setwildbattle(SPECIES_JIGGLYPUFF, 15)
				waitse
				playmoncry(SPECIES_JIGGLYPUFF, CRY_MODE_ENCOUNTER)
				delay(40)
				waitmoncry
				setflag(FLAG_SYS_SPECIAL_WILD_BATTLE)
				setflag(FLAG_TEMP_5)
				dowildbattle
				clearflag(FLAG_SYS_SPECIAL_WILD_BATTLE)
			closemessage
	} else {
		closemessage
	}
}

