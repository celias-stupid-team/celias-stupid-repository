mapscripts Starlight_House_MapScripts {
	
	MAP_SCRIPT_ON_TRANSITION {
		if(flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
			setflag(FLAG_TEMP_8)
        }
            if(flag(FLAG_CSR_CELIA_BONUS)) {
			setflag(FLAG_TEMP_8)
			setflag(FLAG_TEMP_4)
		}
		if(flag(FLAG_DAK_HERE)) {
			setflag(FLAG_TEMP_8)
		}
		if(flag(FLAG_HIDE_BONUS_STARLIGHTS) || flag(FLAG_DAK_HERE) || flag(FLAG_CSR_CELIA_BONUS)) {
			setflag(FLAG_TEMP_9)
		}
		if(!flag(FLAG_POST_GAME) || flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
			setflag(FLAG_TEMP_7)
		}

		 

	}
	MAP_SCRIPT_ON_LOAD {
		setflag(FLAG_TEMP_1)
		if (var(VAR_BONUS_STARS) == 1023) {
		setmetatile(2, 0, 0x1C4, TRUE)
		setmetatile(3, 0, 0x1C5, TRUE)
		setmetatile(4, 0, 0x1C6, TRUE)
		setmetatile(2, 1, 0x1CC, TRUE)
		setmetatile(3, 1, 0x1CD, TRUE)
		setmetatile(4, 1, 0x1CE, TRUE)
		clearflag(FLAG_TEMP_1)
		}
	}
}

script Starlight_House_Window {
	msgbox(
	"This window has a lovely view\n"
    "of the other room.", MSGBOX_SIGN)

}

script Starlight_House_Painting {
	msgbox(
	"This painting is a lovely view\n"
	"of a window.", MSGBOX_SIGN)

}

script Starlight_House_Bookshelf {
	msgbox(
	"The MY SECRET LIFE section is\n"
	"suspiciously empty.", MSGBOX_SIGN)

}

script Starlight_House_Cabinet {
	msgbox(
	"Opening the cabinet, some pills\n"
	"fall on the floor.\p"

	"Oh no! Grandpa's Med(s)!\n", MSGBOX_SIGN)

}


script Starlight_House_Smiley_Face {
	if(!flag(FLAG_TEMP_2)) {
	lock
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"BRI: :)", MSGBOX_DEFAULT)
	} else {
		lock
		faceplayer
		textcolor(NPC_TEXT_COLOR_FEMALE)
		msgbox(
	"BRI: :(", MSGBOX_DEFAULT)
	}
	release
}

script Starlight_House_Celia_Doll {
	finditem(ITEM_POKE_BALL)
	removeobject(CeliaDoll)
	setflag(FLAG_TEMP_4)
}

script Starlight_House_Mudkip_Doll {
	finditem(ITEM_POKE_BALL)
	removeobject(MudkipDoll)
	setflag(FLAG_TEMP_3)
}

script Starlight_House_Eevee_Doll {
	playmoncry(SPECIES_EEVEE, CRY_MODE_DEFAULT)
	msgbox(
	"Vee!", MSGBOX_NPC)
	closemessage
	delay(10)
	finditem(ITEM_POKE_BALL)
	removeobject(EeveeDoll)
	setflag(FLAG_TEMP_2)
}

script Starlight_House_Post_Game_Starlight {
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"STARLIGHT: Thank you {PLAYER} for\n"
	"playing Celia's Stupid Romhack!\p"

	"I am grateful to be a part of this\n"
	"Team and for Celia to give me an\l"
	"opportunity to learn and express\l"
	"some of my ideas in this hack!\p"

	"I made this house to apply those\n"
	"ideas and try new things! I have\l"
	"learned a lot since then.\p"

	"I hope those that play this hack\n"
	"can find inspiration and express\l"
	"themselves through their own\l"
	"creations! No matter what it is.\p"

	"Anyways sorry for my ramble.\p"

	"Remember, there's stuff to do post\n"
	"game! I hid secrets in this house.\l"

	"Have you found them all?", MSGBOX_NPC)
	applymovement(VAR_LAST_TALKED, moves(
		face_original_direction
	))
	waitmovement(0)
}

script Starlight_House_My_Secret_Life {//UNUSED
	msgbox(
	 "My Secret Life, chapter three.\p"
	 "I was neither a murder suspect, nor\n"
	 "a target for an international spy\l"
	 "organization.\p"
	 "But I drove a car down the Jersey\n"
	 "Turnpike at 80 mph.\p"
	 "…A police officer pulled me over\n"
	 "and asked for my driver's license.\p"
	 "He said I was going 20 mph over the\n"
	 "speed limit. I instantly pointed to\l"
	 "my wife and said, “I'm in a hurry,\l"
	 "my wife is in labor.”\p"
	 "Fortunately, my wife actually had a\n"
	 "big stomach.\p"
	 "I hoped he'd let me go with this\n"
	 "excuse.\p"
	 "“Oh, since it's an emergency, I'll\n"
	 "lead you to the hospital with my\l"
	 "police car,” he said.\p"
	 "“No, it's not necessary.”\p"
	 "“Why not?” asked the officer.\n"
	 "“Uh… well…”\p"
	 "“Let's get going,” said the officer.\p"
	 "“No, no! We can't! This baby is a\n"
	 "demon child!”$", MSGBOX_SIGN)
}










script StarlightHouse_NotSoFunFactsMenu {
	setvar(VAR_RESULT, 0)
	//closemessage
	dynmultichoice(2, 1, FALSE, 3, VAR_RESULT, DYN_MULTICHOICE_CB_NONE,
				"Music Tracks",
				"Dance Floor",
				"Dancers"
				//"BACK"
				,)
				
		closemessage
		call(StarlightHouse_CallMusicMenuOptions)
	

	
	release
}

script StarlightHouse_NotSoFunFactsOptions {
			switch(var(VAR_RESULT)) {
				case 0:
					call(StarlightHouse_Jukebox)
				case 1:
					call(StarlightHouse_Floorbox)
				case 2:
					call(StarlightHouse_Dancebox)
				//case 3:
					//call(StarlightHouse_MainMenu)
				default:
				//call(StarlightHouse_MainMenu)
					setvar(VAR_RESULT, 0)
					release
					end
	}
}

script StarlightHouse_Plant_Chain {
	//setvar(VAR_TEMP_0, 14)//For testing the final animation
	closemessage
		if(var(VAR_TEMP_0) == 0) {
			msgbox(
			"It's an OAKn't.", MSGBOX_SIGN)
		}
		if(var(VAR_TEMP_0) == 1) {
			msgbox(
			"No OAK here.", MSGBOX_SIGN)
		}
		if(var(VAR_TEMP_0) == 2) {
			msgbox(
			"Still not OAK.", MSGBOX_SIGN)
		}
		if(var(VAR_TEMP_0) == 3) {
			msgbox(
			"If you squint your eyes hard enough\n"
			"it could be OAK.", MSGBOX_SIGN)
		}
		if(var(VAR_TEMP_0) == 4) {
			msgbox(
			"I'm out of OAK jokes...", MSGBOX_SIGN)
		}
		if(var(VAR_TEMP_0) >= 5 && var(VAR_TEMP_0) <= 6) {
			msgbox(
			"I'm out of OAK jokes....", MSGBOX_SIGN)
		}
		if(var(VAR_TEMP_0) == 7) {
			msgbox(
			"STOP!!!", MSGBOX_SIGN)
		}
		if(var(VAR_TEMP_0) == 8) {
			//playse(SE_CLICK)
			playse(SE_CLICK)
			setlayouttiles(
				LAYOUT_STARLIGHT_HOUSE_LAYOUT_2, 
				0,	// startingX
				0,	// startingY 
				0,	// x1 
				0,	// y1
				16, // x2
				10) // y2
		msgbox(
			"There, no more trees.", MSGBOX_SIGN)
		}

		if(var(VAR_TEMP_0) >= 9 && var(VAR_TEMP_0) <= 13) {		
			msgbox(
			"...", MSGBOX_SIGN)
		}
		

		//God I wish I knew how to make this smaller... I know there's a way, I just haven't figured it out yet.
		if(var(VAR_TEMP_0) >= 14) {
			if(flag(FLAG_HIDE_BONUS_STARLIGHTS)) {//before talking to starlight
			
			if(var(VAR_TEMP_4) == 1) {
			delay(30)
			playse(SE_CLICK)
    		setmetatile(0, 10, 0x357, FALSE)
    		special(DrawWholeMapView)
    		applymovement(LOCALID_PLAYER, moves(
        		walk_in_place_faster_right * 15
        	))
			waitmovement(LOCALID_PLAYER)
    		playse(SE_FALL)
			applymovement(LOCALID_PLAYER, moves(set_invisible))	
			delay(30)	
			fadescreenswapbuffers(FADE_TO_BLACK)
			setobjectxy(LOCALID_PLAYER, 6, 9)
			special(SpawnCameraObject)
			applymovement(LOCALID_CAMERA, moves(walk_fastest_down * 20))
			waitmovement(0)
			warphole(MAP_STARLIGHT_HOUSE5)
            waitstate
			}

			if(var(VAR_TEMP_4) == 2) {
			delay(30)
			playse(SE_CLICK)
    		setmetatile(1, 9, 0x357, FALSE)
    		special(DrawWholeMapView)
    		applymovement(LOCALID_PLAYER, moves(
        		walk_in_place_faster_down * 15
        	))
			waitmovement(LOCALID_PLAYER)
    		playse(SE_FALL)
			applymovement(LOCALID_PLAYER, moves(set_invisible))	
			delay(30)	
			fadescreenswapbuffers(FADE_TO_BLACK)
			setobjectxy(LOCALID_PLAYER, 6, 9)
			special(SpawnCameraObject)
			applymovement(LOCALID_CAMERA, moves(walk_fastest_down * 20))
			waitmovement(0)
			warphole(MAP_STARLIGHT_HOUSE5)
            waitstate
			}

			if(var(VAR_TEMP_4) == 3) {
			delay(30)
			playse(SE_CLICK)
