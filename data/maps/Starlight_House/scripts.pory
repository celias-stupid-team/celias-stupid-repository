script Starlight_House_Color_Test {
	msgbox(
"{COLOR WHITE}C
{COLOR DARK_GRAY}O
{COLOR LIGHT_GRAY}L
{COLOR RED}O
{COLOR LIGHT_RED}R
{COLOR GREEN}F
{COLOR LIGHT_GREEN}U
{COLOR BLUE}L
{COLOR LIGHT_BLUE}L
