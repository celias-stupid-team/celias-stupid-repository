script Starlight_House_Test {
	if(var(VAR_TEMP_3) == 0) {		
			msgbox(
			"Test 1", MSGBOX_SIGN)
		}
	if(var(VAR_TEMP_3) == 1) {		
			msgbox(
			"Test 2", MSGBOX_SIGN)
		}
	if(var(VAR_TEMP_3) == 2) {		
			msgbox(
			"Test 3", MSGBOX_SIGN)
		}
}

script Starlight_House_Exit {
	if(flag(FLAG_POST_GAME)) {

	}
	if(!flag(FLAG_POST_GAME)) {
		warp(MAP_AETHER_PARADISE_ISLAND, 3)
	}
	
}

