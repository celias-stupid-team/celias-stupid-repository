mapscripts Starlight_House_MapScripts {
	
	MAP_SCRIPT_ON_TRANSITION {
		if(flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
			setflag(FLAG_TEMP_8)
        }
            if(flag(FLAG_CSR_CELIA_BONUS)) {
			setflag(FLAG_TEMP_8)
		}
		if(flag(FLAG_DAK_HERE)) {
			setflag(FLAG_TEMP_8)
		}
		if(flag(FLAG_HIDE_BONUS_STARLIGHTS) || flag(FLAG_DAK_HERE) || flag(FLAG_CSR_CELIA_BONUS)) {
			setflag(FLAG_TEMP_9)
		}
		setflag(FLAG_TEMP_8)//temporary until commentary is finished
		setflag(FLAG_TEMP_9)//temporary until commentary is finished
	}
	MAP_SCRIPT_ON_LOAD {
	if(!flag(FLAG_CSR_CELIA_BONUS)) {
		setmetatile(9, 9, METATILE_Starlight_Interior_Table1, FALSE)
		setmetatile(10, 9, METATILE_Starlight_Interior_Table2, FALSE)
		setmetatile(9, 10, METATILE_Starlight_Interior_Table3, FALSE)
		setmetatile(10, 10, METATILE_Starlight_Interior_Table4, FALSE)
	}
}
}

script Starlight_House_Window {
	msgbox(
	"This window has a lovely view\n"
    "of the other room.", MSGBOX_SIGN)

}

script Starlight_House_Painting {
	msgbox(
	"It looks to be a painting\n"
    "of a window.", MSGBOX_SIGN)

}

script Starlight_House_TV {
	msgbox(
	"Why are there always TV's in\n"
    "houses, but no couches?", MSGBOX_SIGN)

}

script Starlight_House_Commentary_But_No_Dak {
	textcolor(NPC_TEXT_COLOR_RED)
	msgbox(
	"Hey! did you know I have a dev\n"
	"commentary too?\p"

	"But for it to appear, first you\n"
	"need to go find my friend!", MSGBOX_NPC)
}

