mapscripts Starlight_House_MapScripts {
	
	MAP_SCRIPT_ON_TRANSITION {
		if(flag(FLAG_HIDE_BONUS_STARLIGHTS)) {
			setflag(FLAG_TEMP_8)
        }
            if(flag(FLAG_CSR_CELIA_BONUS)) {
			setflag(FLAG_TEMP_8)
		}
		if(flag(FLAG_DAK_HERE)) {
			setflag(FLAG_TEMP_8)
		}
		if(flag(FLAG_HIDE_BONUS_STARLIGHTS) || flag(FLAG_DAK_HERE) || flag(FLAG_CSR_CELIA_BONUS)) {
			setflag(FLAG_TEMP_9)
		}
		if(!flag(FLAG_POST_GAME) || flag(FLAG_HIDE_BONUS_STARLIGHTS) || !flag(FLAG_DAK_HERE)) {
			setflag(FLAG_TEMP_7)
		}

		 

	}
	MAP_SCRIPT_ON_LOAD {
	if(!flag(FLAG_CSR_CELIA_BONUS)) {
		setmetatile(9, 9, METATILE_Starlight_Interior_Table1, FALSE)
		setmetatile(10, 9, METATILE_Starlight_Interior_Table2, FALSE)
		setmetatile(9, 10, METATILE_Starlight_Interior_Table3, FALSE)
		setmetatile(10, 10, METATILE_Starlight_Interior_Table4, FALSE)
	}
}
}

script Starlight_House_Window {
	msgbox(
	"This window has a lovely view\n"
    "of the other room.", MSGBOX_SIGN)

}

script Starlight_House_Painting {
	msgbox(
	"It looks to be a painting\n"
    "of a window.", MSGBOX_SIGN)

}

script Starlight_House_TV {
	msgbox(
	"Why are there always TV's in\n"
    "houses, but no couches?", MSGBOX_SIGN)

}

script Starlight_House_Smiley_Face {
	if(!flag(FLAG_TEMP_2)) {
	lock
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"Bri: :)", MSGBOX_DEFAULT)
	} else {
		lock
		faceplayer
		textcolor(NPC_TEXT_COLOR_FEMALE)
		msgbox(
	"Bri: :(", MSGBOX_DEFAULT)
	}
	release
}


script Starlight_House_Mudkip_Doll {
	finditem(ITEM_POKE_DOLL)
	removeobject(Mudkip)
	setflag(FLAG_TEMP_3)
}

script Starlight_House_Eevee_Doll {
	playmoncry(SPECIES_EEVEE, CRY_MODE_DEFAULT)
	msgbox(
	"Vee!", MSGBOX_NPC)
	closemessage
	delay(10)
	finditem(ITEM_POKE_DOLL)
	removeobject(Eevee)
	setflag(FLAG_TEMP_2)
}

script Starlight_House_Post_Game_Starlight {
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"Thank you so much for playing\n"
	"Celia's Stupid Romhack!\p"

	"I made this house to learn how to\n"
	"script and indulge in fun map\l"
	"ideas!\p"

	"Working on this hack was a lot of\n"
	"work, but one of the most\l"
	"enriching experiences in my life.\l"
	"I thank Celia for helping me\l"
	"achieve my dreams!", MSGBOX_NPC)
}