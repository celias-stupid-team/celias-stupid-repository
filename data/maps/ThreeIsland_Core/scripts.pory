mapscripts ThreeIsland_Core_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_TEMP_1)
        if(flag(FLAG_BADGE07_GET)) {
            setmaplayoutindex(LAYOUT_THREE_ISLAND_CORE_DESTROYED)
            clearflag(FLAG_TEMP_1)
            setobjectxyperm(LOCALID_IDIOT_RANGER_GUY, 22, 12)
            setobjectmovementtype(LOCALID_IDIOT_RANGER_GUY, MOVEMENT_TYPE_FACE_RIGHT)
            setobjectxyperm(LOCALID_IDIOT_RANGER_GIRL, 20, 18)
        }
    }
}


script FourthTrial_Woman {
    lock
    faceplayer
    if(flag(FLAG_BADGE07_GET)) {
    msgbox(
        "Oh, no!\n"
        "A catacalysm befell the land!\p"

        "Whoever could have seen this\n"
        "coming?", MSGBOX_DEFAULT)
    } else {
        msgbox(
        "They say that if you clear all\n"
        "four trials in this cave, a\l"
        "catacalysm will befall the land.\p"

        "That's okay, though!\n"
        "We're only going to try clearing\l"
        "exactly three of them!", MSGBOX_DEFAULT)
    }
    release
    end
}


script FourthTrial_Man {
    lock
    faceplayer
    if(flag(FLAG_BADGE07_GET)) {
    msgbox(
        "Ohhhh…\p"

        "So THAT'S what pressing the button\n"
        "does.", MSGBOX_DEFAULT)
    } else {
    msgbox(
        "We've already gotten three of\n"
        "the four trials cleared, but…\p"

        "I'm really interested in looking\n"
        "at the fourth trial.\l"
        "Y'know, just to see it.\p"

        "Don't worry!\n"
        "I won't actually clear it!\l"
        "{PAUSE 30}…I think.", MSGBOX_DEFAULT)
    }
    release
    end
}

script FourthTrial_Sign {
	msgbox(
	"PRESS BUTTON TO CLEAR FOURTH TRIAL\n"
	"", MSGBOX_SIGN)

}


script FourthTrial_FirstTrialTorch {
	msgbox(
	"FIRST TRIAL\n"
	"CLEARED", MSGBOX_SIGN)

}

script FourthTrial_SecondTrialTorch {
	msgbox(
	"SECOND TRIAL\n"
	"CLEARED", MSGBOX_SIGN)

}

script FourthTrial_ThirdTrialTorch {
	msgbox(	Text_ThirdTrial, MSGBOX_SIGN)

}

script FourthTrial_FourthTrialTorch {
    lock
    faceplayer
    if(!flag(FLAG_BADGE07_GET)) {
    msgbox(
	"FOURTH TRIAL\p"

	"Warning!\n"
	"Do not clear!", MSGBOX_SIGN)
    } else {
        msgbox(
        "FOURTH TRIAL\n"
        "CLEARED\l"
        "YOU FUCKING MORON", MSGBOX_DEFAULT)
    }
    release
    end
}