raw `

SaffronCity_CopycatsHouse_1F_EventScript_CopycatsMom::
	msgbox SaffronCity_CopycatsHouse_1F_Text_DaughterIsSelfCentered, MSGBOX_NPC
	end

SaffronCity_CopycatsHouse_1F_EventScript_CopycatsDad::
	msgbox SaffronCity_CopycatsHouse_1F_Text_DaughterLikesToMimicPeople, MSGBOX_NPC
	end

SaffronCity_CopycatsHouse_1F_EventScript_Chansey::
	lock
	faceplayer
	waitse
	playmoncry SPECIES_CHANSEY, CRY_MODE_NORMAL
	msgbox SaffronCity_CopycatsHouse_1F_Text_Chansey
	waitmoncry
	release
	end
`

mapscripts SaffronCity_CopycatsHouse_1F_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		if(var(VAR_COPYCAT_USED) < 2) {
			setvar(VAR_COPYCAT_USED, 0)
			
		}
	}
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_COPYCAT_USED, 1 {
			
			fadenewbgm(MUS_NONE)
			applymovement(LOCALID_COPYCAT_MOM, moves(
				walk_left
			))
			fadescreen(FADE_TO_BLACK)
			delay(60)
			addobject(LOCALID_COPYCAT_DAD)
			addobject(LOCALID_COPYCAT_MOM)
			addobject(LOCALID_COPYCAT_DOWNSTAIRS)
			getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
			while(var(VAR_TEMP_1) != 4) {
				if(var(VAR_TEMP_1) < 4) {
					applymovement(LOCALID_PLAYER, moves(
						walk_fastest_right
					))
					waitmovement(LOCALID_PLAYER)
					addvar(VAR_TEMP_1, 1)
				}
				if(var(VAR_TEMP_1) > 4) {
					applymovement(LOCALID_PLAYER, moves(
						walk_fastest_left
					))
					waitmovement(LOCALID_PLAYER)
					subvar(VAR_TEMP_1, 1)
				}
				
			}
			while(var(VAR_TEMP_2) != 6) {
				if(var(VAR_TEMP_2) < 6) {
					applymovement(LOCALID_PLAYER, moves(
						walk_fastest_down
					))
					waitmovement(LOCALID_PLAYER)
					addvar(VAR_TEMP_2, 1)
				}
				if(var(VAR_TEMP_2) > 6) {
					applymovement(LOCALID_PLAYER, moves(
						walk_fastest_up
					))
					waitmovement(LOCALID_PLAYER)
					subvar(VAR_TEMP_2, 1)
				}
				
			}
			applymovement(LOCALID_COPYCAT_DAD, moves(
				face_left
			))
			applymovement(LOCALID_PLAYER, moves(
				face_right
			))
			waitmovement(LOCALID_COPYCAT_MOM)
			setobjectmovementtype(LOCALID_COPYCAT_MOM, MOVEMENT_TYPE_FACE_LEFT)
			setobjectmovementtype(LOCALID_COPYCAT_DAD, MOVEMENT_TYPE_FACE_LEFT)
			setobjectxy(LOCALID_COPYCAT_DAD, 8, 6)
			setobjectxy(LOCALID_COPYCAT_MOM, 8, 7)
			setobjectxy(LOCALID_COPYCAT_DOWNSTAIRS, 4, 6)
			fadescreen(FADE_FROM_BLACK)
			delay(30)
			playse(SE_LEDGE)
			applymovement(LOCALID_COPYCAT_DOWNSTAIRS, moves(
				face_right
				set_visible
				jump_right
			))
			waitmovement(0)
			playbgm(MUS_SEVII_ROUTE, FALSE)
			delay(30)
			playse(SE_PIN)
			applymovement(LOCALID_COPYCAT_DAD, moves(
				emote_exclamation_mark
				delay_16 * 3
				walk_slow_left
				face_left
			))
			delay(10)
			playse(SE_PIN)
			applymovement(LOCALID_COPYCAT_MOM, moves(
				emote_exclamation_mark
			))
			waitmovement(LOCALID_COPYCAT_DAD)
			textcolor(NPC_TEXT_COLOR_BLUE)
			msgbox(
			"C-COPYCAT?\n"
			"Is it really you…?", MSGBOX_DEFAULT)
			closemessage
			applymovement(LOCALID_COPYCAT_DOWNSTAIRS, moves(
				face_up
				delay_16 
				face_down
				delay_16
				face_right
				delay_16 * 2
			))
			waitmovement(LOCALID_COPYCAT_DOWNSTAIRS)
			textcolor(NPC_TEXT_COLOR_RED)
			msgbox(
			"COPYCAT: Waaah-!\n"
			"{PAUSE 30}COPYCAT!\l"
			"Is it really you!!", MSGBOX_DEFAULT)
			textcolor(NPC_TEXT_COLOR_RED)
			closemessage
			applymovement(LOCALID_COPYCAT_DOWNSTAIRS, moves(
				walk_right
			))
			applymovement(LOCALID_COPYCAT_MOM, moves(
				delay_8
				walk_left * 2
				face_up
			))
			waitmovement(LOCALID_COPYCAT_MOM)
			msgbox(
			"Oh good, good, goodness, darling!\n"
			"We were so worried about you!", MSGBOX_DEFAULT)
			closemessage
			applymovement(LOCALID_COPYCAT_DOWNSTAIRS, moves(
				walk_in_place_right
				walk_in_place_down
			))
			waitmovement(LOCALID_COPYCAT_DOWNSTAIRS)
			msgbox(
			"COPYCAT: So worried about you!!\n"
			"", MSGBOX_DEFAULT)
			closemessage
			applymovement(LOCALID_COPYCAT_DAD, moves(
				walk_in_place_left * 2
			))
			waitmovement(0)
			textcolor(NPC_TEXT_COLOR_BLUE)
			msgbox(
			"Come, darling.\n"
			"Let's get you back upstairs.", MSGBOX_DEFAULT)
			closemessage
			applymovement(LOCALID_COPYCAT_DAD, moves(
				walk_right * 2 
				walk_up
				walk_right 
				walk_up * 3
				face_right
				delay_16
				set_invisible
				face_left
			))
			applymovement(LOCALID_COPYCAT_MOM, moves(
				delay_16 * 4
				walk_up
				face_right
			))
			applymovement(LOCALID_COPYCAT_DOWNSTAIRS, moves(
				delay_16
				walk_right * 3 
				walk_up
				walk_right 
				walk_up * 3
				face_right
				delay_16
				set_invisible
			))
			waitmovement(LOCALID_COPYCAT_DAD)
			playse(SE_EXIT)
			waitmovement(LOCALID_COPYCAT_DOWNSTAIRS)
			playse(SE_EXIT)
			removeobject(LOCALID_COPYCAT_DOWNSTAIRS)
			applymovement(LOCALID_COPYCAT_MOM, moves(
				delay_16
				walk_left
			))
			textcolor(NPC_TEXT_COLOR_FEMALE)
			applymovement(LOCALID_COPYCAT_DAD, moves(
				delay_16 * 10
				face_left
				set_visible
				delay_16 * 2
				walk_down * 2
				walk_left * 2
			))
			delay(30)
			msgbox(
			"And you!\n"
			"Thank you so, so, so much.\p"

			"Because of you, our family is\n"
			"whole, whole, whole again.\p"

			"I couldn't possibly express my\n"
			"gratitute enough.\p"

			"Please, please, please come back\n"
			"any time.\l"
			"You're always welcome here.", MSGBOX_DEFAULT)
			fadedefaultbgm
			waitmovement(LOCALID_COPYCAT_DAD)
			copyobjectxytoperm(LOCALID_COPYCAT_DAD)
			copyobjectxytoperm(LOCALID_COPYCAT_MOM)
			setobjectmovementtype(LOCALID_COPYCAT_MOM, MOVEMENT_TYPE_FACE_LEFT)
			setvar(VAR_COPYCAT_USED, 2)
			releaseall



		}
	]
}

script SaffronCity_CopycatHouse_DontGoUpstairs {
	lock
	applymovement(LOCALID_COPYCAT_DAD, moves(
		walk_in_place_down * 2
	))
	waitmovement(0)
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"My daughter is still missing…!\p"

	"Until she's back safely, I can't\n"
	"bear to let anyone into her room.", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	applymovement(LOCALID_PLAYER, moves(
		walk_down
	))
	waitmovement(0)
	release

}

script SaffronCity_CopycatHouse_Newspaper {
	if(var(VAR_COPYCAT_USED) == 2) {
		msgbox(
		"BREAKING NEWS\p"

		"Local child COPYCAT recovered from\n"
		"DMCA captivity!\p"

		"We learned of this via our hidden\n"
		"cameras installed in their home.\p"

		"In other news, local government\n"
		"has approved zoning for the new\l"
		"TRAIN STATION!", MSGBOX_SIGN)
	} else {
		msgbox(
		"BREAKING NEWS\p"

		"Local child COPYCAT still missing\n"
		"after DMCA takeover!\p"

		"Authorities suspect she's in their\n"
		"hideout, still in captivity.\l"
		"Stay tuned for updates!", MSGBOX_SIGN)

	}

}

script CopycatHouse_PlaceholderScriptStarter {
	setvar(VAR_COPYCAT_USED, 1)
	waitse
	playse(SE_PC_LOGIN)
	msgbox(
	"{PLAYER} booted up the TM.\p"

	"It contained COPYCAT!\n"
	"", MSGBOX_DEFAULT)
	release
}


script CopycatHouse_NotOak {
	msgbox(
	"Hey!\n"
	"It's copying OAK!", MSGBOX_SIGN)

}
