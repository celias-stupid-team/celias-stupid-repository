mapscripts Route18_SandwichShop_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_TEMP_1, 1 {
			while(checkitem(ITEM_BREAD)) {
				removeitem(ITEM_BREAD)
			}
			setflag(FLAG_SANDWICH_GOT_BREAD)
			call(FushciaCity_MakeASandwich)
			setvar(VAR_TEMP_1, 2)
			release
		}
	]
	MAP_SCRIPT_ON_TRANSITION {
        
    }
}


script SandwichShop_Eggs {
	msgbox(
	"A plate of traditional AMERICAN\n"
	"scrambled eggs!", MSGBOX_SIGN)

}


script SandwichShop_Dad {
	lock
	faceplayer
	textcolor(0)
	msgbox("DAD: {PLAYER}!\nWhat are you doing out here?\pI'm making some delicious AMERICAN\nsandwiches.\lNothing beats the classics!\pAnyway, never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}

script SandwichShop_GamblerMan {
	msgbox("Go ahead! Laugh!\nI'm flat-out busted!\pI gambled for years and finally\nstruck the jackpot!\lI was so excited to be rich!\pBut just as I was walking over to\nthe PRIZE EXCHANGE, the entire\lcity went and shuffled itself!\pHere I am to drown my sorrow in some\ntraditional AMERICAN apple juice.\pCome to me if you ever need COINS.\nI have more than enough to spare.\lSob…", MSGBOX_NPC)
	end
}

script SandwichShop_DonutGirl {
	setflag(FLAG_BAKED_DONUT_HINT)
	call(SetPlayerPokedexValues)
	famechecker(FAMECHECKER_KANTO_SHORELINE, 1)
	msgbox("The traditional AMERICAN cuisine\nhere is amazing!\pI think the DONUTS are extra good \nif you put them in the toaster first.\lIt gets 'em nice and crispy!", MSGBOX_NPC)
	end
}

script Route18_SandwichChef {
	lock
	msgbox("Ah, hello!\nWelcome to our AMERICAN Bakery!", MSGBOX_DEFAULT)
	if(!flag(FLAG_GOT_SANDWICH_CASE)) {
		msgbox("I'm sorry, but it appears you have\nnot brought your SANDWICH CASE.\lI cannot do business with you.\pTurning customers away for dumb\nreasons is how I choose to express\lmy traditional AMERICAN values!\pCome back once you have one!\n", MSGBOX_DEFAULT)
		release
		end
	} else {
		msgbox("I see you've brought your\nSANDWICH CASE!\lVery good!\pHow may I serve you today?\n", MSGBOX_DEFAULT)
		pokemart(SandwichShop_Mart)
		msgbox("Thank you for your business!\n", MSGBOX_DEFAULT)
	}
	release
}


mart SandwichShop_Mart {
	ITEM_BREAD
	ITEM_JELLY_DONUT
}


script SandwichShop_AppleJuice {
	msgbox("A glass of nice, frothy\nAPPLE JUICE!", MSGBOX_SIGN)
	end
}

script SandwichShop_CreateSandwich {
	if(flag(FLAG_SANDWICH_GOT_BREAD) && flag(FLAG_SANDWICH_GOT_MEAT) && flag(FLAG_SANDWICH_GOT_CHEESE) && flag(FLAG_SANDWICH_GOT_LETTUCE) && flag(FLAG_SANDWICH_GOT_PICKLES) && flag(FLAG_SANDWICH_GOT_SESAME_SEED)) {
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		msgbox("Oh?\p{PLAYER} has gathered together\nall the ingredients!\pAfter a silly minigame (which\nCelia shall not be programming)…", MSGBOX_DEFAULT)
		waitmessage
		closemessage
		giveitem_msg("{PLAYER} turned all the ingredients\ninto a SANDWICH!", ITEM_SANDWICH, 1)
		return

	} else {
		return
	}
}




script SandwhichShop_Rotom {
	lock
	faceplayer
	playmoncry(SPECIES_ROTOM, CRY_MODE_FAINT)
	waitmoncry
	applymovement(VAR_LAST_TALKED, moves(
		emote_question_mark
	))
	waitmovement(0)
	delay(60)
	msgbox(
	"Why do you of in the cold tom and\n"
	"of out eat ro tom?", MSGBOX_DEFAULT)
    closemessage
    fadescreen(FADE_TO_BLACK)
    removeobject(VAR_LAST_TALKED)
    setflag(FLAG_FOUND_ROTOM_HEAT)
    fadescreen(FADE_FROM_BLACK)
	release
}

script SandwichShop_Football {
	msgbox(
	"A poster depicting traditional\n"
	"AMERICAN customs, such as\l"
	"football.", MSGBOX_SIGN)
}
