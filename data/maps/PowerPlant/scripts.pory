raw `
PowerPlant_MapScripts::
	map_script MAP_SCRIPT_ON_RESUME, PowerPlant_OnResume
	map_script MAP_SCRIPT_ON_TRANSITION, PowerPlant_OnTransition
	.byte 0

PowerPlant_OnResume::
	call_if_set FLAG_SYS_SPECIAL_WILD_BATTLE, PowerPlant_EventScript_TryRemoveStaticMon
	end

PowerPlant_EventScript_TryRemoveStaticMon::
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_ne VAR_RESULT, B_OUTCOME_CAUGHT, EventScript_Return
	removeobject VAR_LAST_TALKED
	return

PowerPlant_OnTransition::
	setworldmapflag FLAG_WORLD_MAP_POWER_PLANT
	call_if_unset FLAG_FOUGHT_ZAPDOS, PowerPlant_EventScript_ShowZapdos
	call_if_unset FLAG_FOUGHT_ROUTE25_HBOX, PowerPlant_EventScript_ShowElectrode1
	call_if_unset FLAG_FOUGHT_POWER_PLANT_ELECTRODE_2, PowerPlant_EventScript_ShowElectrode2
	end

PowerPlant_EventScript_ShowZapdos::
	clearflag FLAG_HIDE_ZAPDOS
	return

PowerPlant_EventScript_ShowElectrode1::
	clearflag FLAG_HIDE_POWER_PLANT_ELECTRODE_1
	return

PowerPlant_EventScript_ShowElectrode2::
	clearflag FLAG_HIDE_POWER_PLANT_ELECTRODE_2
	return



PowerPlant_EventScript_DefeatedZapdos::
	setflag FLAG_FOUGHT_ZAPDOS
	goto EventScript_RemoveStaticMon
	end

PowerPlant_EventScript_RanFromZapdos::
	setvar VAR_0x8004, SPECIES_ZAPDOS
	goto EventScript_MonFlewAway
	end

PowerPlant_EventScript_Electrode1::
	goto_if_questlog EventScript_ReleaseEnd
	lock
	faceplayer
	setwildbattle SPECIES_ELECTRODE, 34
	waitse
	playmoncry SPECIES_ELECTRODE, CRY_MODE_ENCOUNTER
	delay 40
	waitmoncry
	setflag FLAG_SYS_SPECIAL_WILD_BATTLE
	dowildbattle
	clearflag FLAG_SYS_SPECIAL_WILD_BATTLE
	special QuestLog_CutRecording
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_eq VAR_RESULT, B_OUTCOME_WON, PowerPlant_EventScript_FoughtElectrode1
	goto_if_eq VAR_RESULT, B_OUTCOME_RAN, PowerPlant_EventScript_FoughtElectrode1
	goto_if_eq VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED, PowerPlant_EventScript_FoughtElectrode1
	setflag FLAG_FOUGHT_ROUTE25_HBOX
	release
	end

PowerPlant_EventScript_FoughtElectrode1::
	setflag FLAG_FOUGHT_ROUTE25_HBOX
	goto EventScript_RemoveStaticMon
	end

PowerPlant_EventScript_Electrode2::
	goto_if_questlog EventScript_ReleaseEnd
	lock
	faceplayer
	setwildbattle SPECIES_ELECTRODE, 34
	waitse
	playmoncry SPECIES_ELECTRODE, CRY_MODE_ENCOUNTER
	delay 40
	waitmoncry
	setflag FLAG_SYS_SPECIAL_WILD_BATTLE
	dowildbattle
	clearflag FLAG_SYS_SPECIAL_WILD_BATTLE
	special QuestLog_CutRecording
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_eq VAR_RESULT, B_OUTCOME_WON, PowerPlant_EventScript_FoughtElectrode2
	goto_if_eq VAR_RESULT, B_OUTCOME_RAN, PowerPlant_EventScript_FoughtElectrode2
	goto_if_eq VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED, PowerPlant_EventScript_FoughtElectrode2
	setflag FLAG_FOUGHT_POWER_PLANT_ELECTRODE_2
	release
	end

PowerPlant_EventScript_FoughtElectrode2::
	setflag FLAG_FOUGHT_POWER_PLANT_ELECTRODE_2
	goto EventScript_RemoveStaticMon
	end
`
const ELECTRODE_1 = 1
const ELECTRODE_2 = 2
const ELECTRODE_3 = 3
const ELECTRODE_4 = 4
script PowerPlant_MagnemiteMan {
	lock
	faceplayer
	if(checkmoncaught(SPECIES_MAGNEMITE)) {
		//check player party. If No magnemite, then do his original speeches, but slightly different. 
		//If yes, then if you already talked to him he'll say "Too bad!"
		//If you hadn't talked to him, he'll introduce the problem but still evolve your magnemite. 

	} else {
		if(flag(FLAG_CSR_TALKED_TO_MAGNEMITE_GUY)) {
			msgbox("Hey again!\nDo you have a MAGNEMITE yet?\pMe and my two MAGNEMITES are gonna\nwait here for you so we can evolve.\pBe sure to come back when you find\none!", MSGBOX_DEFAULT)
		} else {
			setflag(FLAG_CSR_TALKED_TO_MAGNEMITE_GUY)
			msgbox("Hey, there!\nDo you happen to have a MAGNEMITE?\pI actually have two MAGNEMITES here\nwith me right now.\lWe're just one away from evolving!\pBut, it looks like there aren't any\nwild ones here anymore.\pIf you ever catch a MAGNEMITE, do\nyou think you could bring it here?\lThat way, we can evolve together!\pI'll be waiting for you!\n", MSGBOX_DEFAULT)
		}
	}
	release
}

script PowerPlant_Trees {
	msgbox("It's a POWER Plant!\n", MSGBOX_SIGN)
	end
}

script PowerPlant_Dazzle {
	lock
	faceplayer
	if(flag(FLAG_CSR_TRADED_WITH_DAZZLE)) {
		msgbox("DAZZLE: Thank you for trading with\nme, guy!", MSGBOX_DEFAULT)
	} else {
		if(flag(FLAG_CSR_TALKED_TO_DAZZLE)) {
			msgbox("DAZZLE: Hey, guy!\nDo you have a STAR PIECE?\lI'd love to trade one for a BADGE!\p… … …\n", MSGBOX_DEFAULT)
		} else {
			msgbox("DAZZLE: My name is DAZZLE!\nAnd I collect STAR PIECES!\lThe more I collect the happier I am!\pSo, guy, if you have any STAR PIECES\nI'll trade you a BADGE for them!\lYay!", MSGBOX_DEFAULT)
		}
		if(checkitem(ITEM_STAR_PIECE)) {
				msgbox("DAZZLE: Ooh!\nYou have a STAR PIECE!\pWould you like to trade it for a\nBADGE?", MSGBOX_YESNO)
				setflag(FLAG_CSR_TALKED_TO_DAZZLE)
				if(var(VAR_RESULT)) {
					msgbox("DAZZLE: Yes!\nLet's trade!", MSGBOX_DEFAULT)
					closemessage
					textcolor(NPC_TEXT_COLOR_NEUTRAL)
					//You got the badge!
					msgbox("{PLAYER} obtained the POWER BOUNCE BADGE!\n", MSGBOX_DEFAULT)
					call(EventScript_GymBadgeFanfare)
					closemessage
					textcolor(NPC_TEXT_COLOR_MALE)
					setflag(FLAG_CSR_TRADED_WITH_DAZZLE)
					msgbox("DAZZLE: YESSS!\pThanks to you, guy, my STAR PIECE\ncollection is even bigger now!\lYESSS!", MSGBOX_DEFAULT)
					if(checkplayergender) {
						msgbox("DAZZLE: …Wait.\nYou're not a guy, guy?\lOops!", MSGBOX_DEFAULT)
					}
				} else {
					msgbox("DAZZLE: What?\nYou changed your mind?\lSo… … … LAME!!!", MSGBOX_DEFAULT)
				}
			} else {
				if(flag(FLAG_CSR_TALKED_TO_DAZZLE)) {
					msgbox("DAZZLE: Hey!\nYou don't have any STAR PIECES!\pAre you trying to swindle me?\nGo away!", MSGBOX_DEFAULT)
				} else {
					setflag(FLAG_CSR_TALKED_TO_DAZZLE)
				}
			}
	}
	release
}


script PowerPlant_Max {
	lock
	faceplayer
	msgbox("MAX: Hello!\nMy name is MAX.\pBehind me is a very important LOCK.\nNo one is allowed to touch it.", MSGBOX_DEFAULT)
	release
}

script PowerPlant_StarmieHint {
	if(flag(FLAG_CSR_POWER_IS_ON)) {

	} else {
		if(checkitem(ITEM_EVERSTONE)) {
			msgbox("Oh, hey!\nIs that a B BUTTON?\pI think that's what our reactor\nneeds to get started again!\lLet's give it a shot!", MSGBOX_NPC)
		} else {
			msgbox("I see the problem.\nThe reactor got flipped off.\pAccording to our protocols, to get\nit back on we just need someone to\lplay a fun mini-game!\pBut…\nThe control console is really old.\lI think it's broken, actually.\pUhh… let's try it anyway, maybe?\nNot like we can break it harder!", MSGBOX_NPC)		
		}
	}
}

script PowerPlant_PowerPlantIsBroken {
	lock
	faceplayer
	if(flag(FLAG_CSR_POWER_IS_ON)) {
		msgbox("Thank goodness the POWER is back\non.\pI bet the LIGHTHOUSE is finally\ntaking visitors again.", MSGBOX_NPC)
	} else {
		msgbox("Oh, no!\pThe POWER PLANT's broken!", MSGBOX_NPC)
	}
	release
}

script PowerPlant_RockTunnelIsDark {
	lock
	faceplayer
	if(flag(FLAG_CSR_POWER_IS_ON)) {
		//reacts to power being back on
	} else {
		msgbox("The POWER PLANT is supposed to\nsupply lighting to ROCK TUNNEL.\pNow that it's down, the whole cave\nis pitch black.\lThis is awful!\pWho knows what they're doing in\nthere?", MSGBOX_DEFAULT)
	}
	release
}

script PowerPlant_DMCA {
	lock
	faceplayer
	if(flag(FLAG_CSR_POWER_IS_ON)) {
		msgbox("Hey!\nYou can't just turn the power on!\pThat's a violation of POKéMON\nSWORD and SHIELD!\lWe can't have that!", MSGBOX_DEFAULT)
	} else {
		msgbox("Gwahaha!\nThis PLANT got what was coming!\pThe main reactor used to run on\nURANIUM, but not anymore!\lThe DMCA made sure to take it down!\pI love providing a public service.\nWe do so much good in the world!", MSGBOX_DEFAULT)
	}
	release
}

script PowerPlant_NuclearReactor {
	msgbox("It's an extraordinarily expensive\nhobbyist nuclear reactor.", MSGBOX_SIGN)
}

script PowerPlant_Computer {
	lock
	msgbox("It's opened to a search engine…", MSGBOX_DEFAULT)
	closemessage
	msgbox("“Operating Nuclear Power Plants\nfor Dummies\lfree download”", MSGBOX_SIGN)
	end
}


script PowerPlant_MinigameStart {
	lock
	if(!var(VAR_CSR_TURNED_ON_POWER)) {
		msgbox("no power\nplay game?", MSGBOX_YESNO)
		if(var(VAR_RESULT)) {
			// if(checkitem(ITEM_EVERSTONE)) {
				closemessage
				call(PowerPlant_ElectrodesSlideDown)
				msgbox("you have b button\nyou win", MSGBOX_DEFAULT)
			// 	setwildbattle(SPECIES_ETERNATUS, 50, ITEM_NONE)
			// 	dowildbattle
			// 	//waitstate
				// special(SpawnCameraObject)
				// applymovement(OBJ_EVENT_ID_CAMERA, PowerPlant_CameraGoDown)
				// waitmovement(0)
				// special(RemoveCameraObject)
			// } else {
			// 	msgbox("cannot beat game\n", MSGBOX_DEFAULT)
			// }
			callnative(StartPowerplantGame)
			waitstate
			msgbox("yay power\n", MSGBOX_DEFAULT) //placeholder
			waitmessage
			special(SpawnCameraObject)
			applymovement(OBJ_EVENT_ID_CAMERA, PowerPlant_CameraGoDown)
			waitmovement(0)
			special(RemoveCameraObject)
		}

	} else {
		msgbox("yay power\n", MSGBOX_DEFAULT) //placeholder
	}
	removeobject(ELECTRODE_1)
	removeobject(ELECTRODE_2)
	removeobject(ELECTRODE_3)
	removeobject(ELECTRODE_4)
	release
	end
}

script PowerPlant_Electrode {
	msgbox("placeholder\n", MSGBOX_SIGN)
	end
}



script PowerPlant_ElectrodesSlideDown {
	fadenewbgm(MUS_NONE)
	special(SpawnCameraObject)
	applymovement(OBJ_EVENT_ID_CAMERA, PowerPlant_CameraGoUp)
	waitmovement(0)
	special(RemoveCameraObject)
	addobject(ELECTRODE_1)
	addobject(ELECTRODE_2)
	addobject(ELECTRODE_3)
	addobject(ELECTRODE_4)
	applymovement(ELECTRODE_1, PowerPlant_ElectrodeMoveDown)
	playse(SE_FALL)
	delay(20)
	applymovement(ELECTRODE_2, PowerPlant_ElectrodeMoveDown)
	playse(SE_FALL)
	delay(20)
	applymovement(ELECTRODE_3, PowerPlant_ElectrodeMoveDown)
	playse(SE_FALL)
	delay(20)
	applymovement(ELECTRODE_4, PowerPlant_ElectrodeMoveDown)
	playse(SE_FALL)
	delay(60)
	return
}

movement PowerPlant_ElectrodeMoveDown {
	set_visible
	slide_down * 6
}

movement PowerPlant_CameraGoUp {
	walk_fast_up * 3
}

movement PowerPlant_CameraGoDown {
	walk_fast_down * 3
}