script SS_Anne_Harry {
	if(flag(FLAG_HIDE_HARRY_RAT)) {
		lock
		msgbox(
		"HARRY: …\n"
		"", MSGBOX_DEFAULT)
		release
	} else {
		msgbox(
		"HARRY: Hey there, {PLAYER}!\n"
		"How's it going?\p"

		"It's me, HARRY!\n"
		"We met before at POKéMON TOWER.\p"

		"I'm out here having a great time\n"
		"with my buddy, RATICATE.\l"
		"He's such a great partner!\p"

		"We're just chilling, precariously\n"
		"hovering next to this giant cliff.\p"

		"It sure is a long way down, haha!\p"

		"Anyway, it was good to see you\n"
		"again!\l"
		"We'll just be standing right here.\p"

		"Hope to catch you again!\n"
		"Extrasensorally perceive ya later!", MSGBOX_NPC)

	}
}

script SS_Anne_Raticate {
	lock
	faceplayer
	playmoncry(SPECIES_RATICATE, CRY_MODE_DEFAULT)
	msgbox(
	"RATICATE: Frraa!\n"
	"", MSGBOX_DEFAULT)
	waitmoncry
	release
}


script SSAnne_2F_Corridor_EventScript_RivalTrigger {
	textcolor(NPC_TEXT_COLOR_MALE)
	playse(SE_EXIT)
	delay(5)
	playbgm(MUS_ENCOUNTER_RIVAL, 0) //Barry theme
	addobject(LOCALID_SS_ANNE_RIVAL)
	delay(10)
	applymovement(LOCALID_SS_ANNE_RIVAL, Common_Movement_WalkInPlaceFasterDown)
	waitmovement(0)
	delay(20)
	call_if_eq(VAR_TEMP_1, 0, SSAnne_2F_Corridor_EventScript_RivalApproachLeft)
	call_if_eq(VAR_TEMP_1, 1, SSAnne_2F_Corridor_EventScript_RivalApproachMid)
	call_if_eq(VAR_TEMP_1, 2, SSAnne_2F_Corridor_EventScript_RivalApproachRight)
	msgbox(SSAnne_2F_Corridor_Text_RivalIntro)
	setvar(VAR_LAST_TALKED, LOCALID_SS_ANNE_RIVAL)
	call(SSAnne_2F_Corridor_EventScript_RivalCharmander)
	msgbox(SSAnne_2F_Corridor_Text_RivalPostBattle)
	closemessage
	delay(10)
	playbgm(MUS_RIVAL_EXIT, 0) //idk
	call_if_eq(VAR_TEMP_1, 0, SSAnne_2F_Corridor_EventScript_RivalExitLeft)
	call_if_eq(VAR_TEMP_1, 1, SSAnne_2F_Corridor_EventScript_RivalExitMid)
	call_if_eq(VAR_TEMP_1, 2, SSAnne_2F_Corridor_EventScript_RivalExitRight)
	fadenewbgm(MUS_NONE)
	delay(60)
    setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 4)
    setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 4)
    setvar(VAR_SHAKESCREEN_NUM_SHAKES, 6)
    setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 4)
	playse(SE_WALL_HIT)
	special(ShakeScreen)
	delay(60)
	removeobject(LOCALID_SS_ANNE_RIVAL)
	removeobject(LOCALID_HARRY_RAT)
	setflag(FLAG_HIDE_HARRY_RAT)
	setobjectmovementtype(LOCALID_SS_ANNE_HARRY, MOVEMENT_TYPE_FACE_LEFT)
	setvar(VAR_MAP_SCENE_S_S_ANNE_2F_CORRIDOR, 1)
	releaseall
}