raw `

Route2_ViridianForest_NorthEntrance_EventScript_Youngster::
	msgbox Route2_ViridianForest_NorthEntrance_Text_ManyMonsOnlyInForests, MSGBOX_NPC
	end

Route2_ViridianForest_NorthEntrance_EventScript_OldMan::
	msgbox Route2_ViridianForest_NorthEntrance_Text_CanCutSkinnyTrees, MSGBOX_NPC
	end

Route2_ViridianForest_NorthEntrance_EventScript_CooltrainerF::
	msgbox Route2_ViridianForest_NorthEntrance_Text_CanCancelEvolution, MSGBOX_NPC
	end
`
mapscripts Route2_ViridianForest_NorthEntrance_MapScripts {
	MAP_SCRIPT_ON_LOAD {
		if(flag(FLAG_WORLD_MAP_PEWTER_CITY)) {
			setflag(FLAG_TEMP_1)
		}
	}
}

script Route2_EventScript_NorthGirl {
	msgbox("TRAINER TIPS!\pAfter you've beaten a TRAINER,\ndon't forget to talk to them again.\pOftentimes, they'll have something\nuseful or interesting to say!", MSGBOX_SIGN)
	end
}



script ViridianForest_IsThatOak {
	lock
	textcolor(NPC_TEXT_COLOR_TREE)
	if(flag(FLAG_PT_NPC_SIGN_LADY)) {
		faceplayer
		
		//applymovement(LOCALID_PLAYER, Common_Movement_FaceLeft)
		clearflag(FLAG_PT_NPC_SIGN_LADY)
		call(PalletTown_EventScript_SignLadyShowSign)
	} else {
		setflag(FLAG_CSR_TALKED_TO_SIGN_GIRL)
		msgbox(format("Hmm…\nIs that OAK…"), MSGBOX_DEFAULT)
		applymovement(VAR_LAST_TALKED, Common_Movement_FacePlayer)
		waitmovement(0)
		playse(SE_PIN)
		applymovement(VAR_LAST_TALKED, PT_exclmark)
		waitmovement(0)
		delay(48)
		msgbox(format("Oh!\nLook, look!"), MSGBOX_DEFAULT)
		closemessage
		switch(var(VAR_FACING)) {
			case DIR_EAST:
					applymovement(VAR_LAST_TALKED, PT_walkbackRight)
					waitmovement(0)
					break
				default:
					applymovement(VAR_LAST_TALKED, PT_walkbackLeft)
					waitmovement(0)
					break
		}
	}
	release
}