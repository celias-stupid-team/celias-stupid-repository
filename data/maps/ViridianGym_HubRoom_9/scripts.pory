mapscripts ViridianGym_HubRoom_9_MapScripts {
    
}

script ViridianGym_StatueFisher {
    lock
    faceplayer
    setflag(FLAG_CSR_HINT_GYM_STATUES)
    msgbox(
	"Shh!\n"
	"Don't bother me!\p"

	"I'm trying to fish up a rare\n"
	"POKéMON!", MSGBOX_DEFAULT)
    closemessage
    applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
}