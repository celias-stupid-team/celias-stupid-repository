mapscripts Route19_SurfHouse_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        
		if(flag(FLAG_FOUND_ROTOM_FROST) || !flag(FLAG_SYS_ROTOM_MENU)) {
			setflag(FLAG_TEMP_1)
		}
    }
}

script Route19_SurfHouse_Rhydon {
    lock
    faceplayer
    playmoncry(SPECIES_RHYDON, CRY_MODE_NORMAL)
    msgbox("RHYDON: Grraaah!\n", MSGBOX_DEFAULT)
    waitmoncry
    closemessage
    delay(30)
    msgbox("Rhydon deez nuts\n", MSGBOX_DEFAULT)
    release
}

script Route19_SurfHouse_Zigzagoon {
    lock
    faceplayer
    playmoncry(SPECIES_ZIGZAGOON, CRY_MODE_NORMAL)
    msgbox("ZIGZAGOON: Guguu?\n", MSGBOX_DEFAULT)
    waitmoncry
    release

}

script Route19_SurfHouse_NotLettuce {
	msgbox("That's not LETTUCE, silly!\n", MSGBOX_SIGN)
	end
}

script Route19_SurfHouse_Furret {
    lock
    faceplayer
    playmoncry(SPECIES_FURRET, CRY_MODE_NORMAL)
    msgbox("FURRET: Bwaah!\n", MSGBOX_DEFAULT)
    waitmoncry
    closemessage
    msgbox("FURRET is surfing!\n", MSGBOX_DEFAULT)
    release
}

script Route19_SurfHouse_Trees {
	msgbox("OAK can't surf, silly!\n", MSGBOX_SIGN)
	end
}

script Route19_SurfHouse_Fridge {
	msgbox("Why do you need a second fridge?\n", MSGBOX_SIGN)
	end
}

script Route19_SurfHouse_SurfGuy {
        lock
        faceplayer
    if(!flag(FLAG_GOT_SANDWICH_CASE)) {
        msgbox("Hey, kid!\nYou wanna know what's hot?\lThat's right: SANDWICHES.\pFor breakfast? SANDWICHES.\nLunch? SANDWICHES.\lDinner? Dessert? Take a guess.\pThere is literally nothing in the\nworld I love more.\pHere, take this.\nI need to share my love with you.", MSGBOX_DEFAULT)
        textcolor(NPC_TEXT_COLOR_NEUTRAL)
        giveitem_msg("{PLAYER} obtained the\nSANDWICH CASE!", ITEM_SANDWICH_CASE, 1)
        setflag(FLAG_GOT_SANDWICH_CASE)
    }
    textcolor(NPC_TEXT_COLOR_MALE)
    famechecker(FAMECHECKER_FUSHCIA, 0)
    msgbox("Aight, listen up!\nHere's the perfect SANDWICH:\pA fresh loaf of BREAD!\nCoated in SESAME SEEDS!\pHearty cuts of MEAT, alongside a\nlovely slice of CHEESE!\pSome LETTUCE that's been very\nfreshly CUT!\pAnd to top it off: Crunchy,\nflavorful PICKLES!\pBring all of these together, and\nyou'll have the perfect food!", MSGBOX_DEFAULT)
    release
}




script SandwichHouse_Rotom {
	lock
	faceplayer
	playmoncry(SPECIES_ROTOM, CRY_MODE_FAINT)
	waitmoncry
	applymovement(VAR_LAST_TALKED, moves(
		emote_question_mark
	))
	waitmovement(0)
	delay(60)
	msgbox(
	"Why do you need a third fridge?\n"
	"", MSGBOX_DEFAULT)
    closemessage
    fadescreen(FADE_TO_BLACK)
    removeobject(VAR_LAST_TALKED)
    setflag(FLAG_FOUND_ROTOM_FROST)
    fadescreen(FADE_FROM_BLACK)
	release
}