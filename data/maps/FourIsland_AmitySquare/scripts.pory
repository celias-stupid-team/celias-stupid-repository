mapscripts FourIsland_AmitySquare_MapScripts {

}



script FourIsland_AmitySquare_Bows {
	textcolor(NPC_TEXT_COLOR_RED)
	if(flag(FLAG_BOWS_GIVES_SHINY_PINSIR)) {
		clearflag(FLAG_BOWS_GIVES_SHINY_PINSIR)
		setflag(FLAG_SHINY_CREATION)
		msgbox(
		"BOWS: Hey!\n"
		"I saw you on the computer!\p"

		"This is one of my favorite bugs.\n"
		"You can have him as a gift!", MSGBOX_DEFAULT)
		closemessage
		setvar(VAR_CSR_GIFT_POKEMON, SPECIES_PINSIR)
		call(EventScript_GiftPokemon)
		release
		end
	}
	msgbox(
	"BOWS: Hello, yes!\p"

	"This is my partner, PIKACHU!\n"
	"He's, uh...\l"
	"He's very yellow, as you can see!\p"

	"Uh, yup!\n"
	"Perfectly normal PIKACHU.\l"
	"Nothing to see here :3", MSGBOX_NPC)
}


script FourIsland_AmitySquare_Trapinch {
    lock
    faceplayer
    msgbox(
	"PIKACHU?: Prrah!\n"
	"", MSGBOX_DEFAULT)
    showmonpic(SPECIES_TRAPINCH, 10, 3)
    waitbuttonpress
    hidemonpic
    release
    end
    
}



script AmitySquare_PokemonStatue {
	lock
	msgbox(
	"It's a statue resembling a…\n"
	"POKéMON.\l"
	"You know the one.\p"

	"Y'know, it's that one.\n"
	"The one with the, uh…", MSGBOX_DEFAULT)
	if(!flag(FLAG_AMBIGUOUS_STATUE_SIGN)) {
		closemessage
		delay(10)
		playfanfare(MUS_SLOTS_WIN)
		msgbox("{PLAYER} discovered a\nPOKéMON SIGN!", MSGBOX_DEFAULT)
		waitfanfare
		delay(10)
		setflag(FLAG_AMBIGUOUS_STATUE_SIGN)
	}
	release
}

script AmitySquare_CaveSign {
	msgbox(
	"SIX ISLAND CAVE\n"
	"", MSGBOX_SIGN)

}
