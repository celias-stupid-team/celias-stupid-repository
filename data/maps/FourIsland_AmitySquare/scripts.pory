mapscripts FourIsland_AmitySquare_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		if(!flag(FLAG_OPENED_SKY_TOWER)) {
			setflag(FLAG_TEMP_5)

		}
		setflag(FLAG_SHINY_CREATION)
	}
}



script FourIsland_AmitySquare_Bows {
	textcolor(NPC_TEXT_COLOR_RED)
	if(flag(FLAG_SHINY_MEWTWO)) {
		clearflag(FLAG_SHINY_MEWTWO)
		setflag(FLAG_SHINY_CREATION)
		msgbox(
		"BOWS: Hey!\n"
		"I saw you on the computer!\p"

		"This is one of my favorite bugs.\n"
		"You can have him as a gift!", MSGBOX_DEFAULT)
		closemessage
		setvar(VAR_CSR_GIFT_POKEMON, SPECIES_PINSIR)
		call(Common_Script_GiftPokemon)
		release
		end
	}
	msgbox(
	"BOWS: Hello, yes!\p"

	"This is my partner, PIKACHU!\n"
	"He's, uh...\l"
	"He's very yellow, as you can see!\p"

	"Uh, yup!\n"
	"Perfectly normal PIKACHU.\l"
	"Nothing to see here :3", MSGBOX_NPC)
}


script FourIsland_AmitySquare_Trapinch {
    lock
    faceplayer
    msgbox(
	"PIKACHU?: Prrah!\n"
	"", MSGBOX_DEFAULT)
    showmonpic(SPECIES_TRAPINCH, 10, 3)
    waitbuttonpress
    hidemonpic
    release
    end
    
}


script AmitySquare_PokeKid {
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"Shhh…\p"

	"Don't tell anyone I snuck in!\n"
	"", MSGBOX_NPC)
}



script AmitySquare_PokemonStatue {
	lock
	msgbox(
	"It's a statue resembling a…\n"
	"POKéMON.\l"
	"You know the one.\p"

	"Y'know, it's that one.\n"
	"The one with the, uh…", MSGBOX_DEFAULT)
	if(!flag(FLAG_AMBIGUOUS_STATUE_SIGN)) {
		closemessage
		delay(10)
		playfanfare(MUS_SLOTS_WIN)
		msgbox("{PLAYER} discovered a\nPOKéMON SIGN!", MSGBOX_DEFAULT)
		waitfanfare
		delay(10)
		setflag(FLAG_AMBIGUOUS_STATUE_SIGN)
	}
	release
}

script AmitySquare_CaveSign {
	msgbox(
	"SIX ISLAND CAVE\n"
	"", MSGBOX_SIGN)

}


script AmitySquare_MainSign {
	msgbox(
	"AMITY SQUARE\p"

	"We sure are a square!\n"
	"", MSGBOX_SIGN)

}


script AmitySquare_NineIsland {
	lock
	msgbox(
	"N-NE ISL--D\n"
	"", MSGBOX_DEFAULT)
	closemessage
	delay(20)
	msgbox(
	"The message is faded.\n"
	"", MSGBOX_DEFAULT)
	release

}

script AmitySquare_SquareHole {
	msgbox(
	"Oh, hey!\p"

	"It's the stuff from the square\n"
	"hole!", MSGBOX_SIGN)

}

script AmitySquare_Resembler {
	msgbox(
	"You and your POKéMON…{PAUSE 20}\n"
	"You somehow resemble each other!", MSGBOX_NPC)
}

script AmitySquare_GarbodorGirl {
	textcolor(NPC_TEXT_COLOR_RED)
	msgbox(
	"That lady up front said I look\n"
	"just like my POKéMON…\p"

	"I dunno, I don't really see the\n"
	"resemblance.", MSGBOX_NPC)
}

script AmitySquare_Garbodor {
	lock
	faceplayer
	playmoncry(SPECIES_GARBODOR, CRY_MODE_DEFAULT)
	waitmoncry
	release
	end
}
