
const MAN = 1
const DUSCLOPS = 2
mapscripts FushciaGym_ParalysisDusclopsRoom_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        if(flag(FLAG_GOT_PARALYZED_ONCE)) {
            setvar(VAR_TEMP_1, 1)
            setobjectxyperm(MAN, 6, 11)
            setobjectxyperm(DUSCLOPS, 7, 11)
            setobjectmovementtype(MAN, MOVEMENT_TYPE_FACE_RIGHT)
        }
        
        setrespawn(HEAL_LOCATION_FUSHCIA_GYM_PARALYSIS_DUSCLOPS_ROOM)
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_1, 0 {
            playse(SE_PIN)
            setvar(VAR_TEMP_1, 2)
            applymovement(MAN, Common_Movement_ExclamationMark)
            applymovement(DUSCLOPS, DusclopsAttacksYou)
            waitmovement(DUSCLOPS)
            playmoncry(SPECIES_DUSCLOPS, CRY_MODE_DEFAULT)
            msgbox("DUSCLOPS: Cloooops!\n", MSGBOX_DEFAULT)
            waitmoncry
            closemessage
            msgbox("DUSCLOPS used THUNDER WAVE!\n", MSGBOX_DEFAULT)
            setstatus1(STATUS1_PARALYSIS, 0)
            setflag(FLAG_GOT_PARALYZED_ONCE)
            release
        }
    ]
}

movement DusclopsAttacksYou {
    walk_fast_down
    Walk_fast_left
    walk_fast_down
    face_down
}

script FushciaGym_ClosedCurtain {
	msgbox("The curtain does not open further.\nIt seems this is a dead end.", MSGBOX_SIGN)
	end
}

script FushciaGym_ParalysisDusclops {
    lock
    faceplayer
    if(var(VAR_TEMP_1) == 1) {
            playmoncry(SPECIES_DUSCLOPS, CRY_MODE_DEFAULT)
            msgbox("DUSCLOPS: Cloooops!\n", MSGBOX_DEFAULT)
            waitmoncry
            closemessage
            msgbox("DUSCLOPS used THUNDER WAVE!\n", MSGBOX_DEFAULT)
            setstatus1(STATUS1_PARALYSIS, 0)
            setflag(FLAG_GOT_PARALYZED_ONCE)
            setvar(VAR_TEMP_1, 2)

    } else {
            playmoncry(SPECIES_DUSCLOPS, CRY_MODE_DEFAULT)
            msgbox("DUSCLOPS: Cloooops!\n", MSGBOX_DEFAULT)
            waitmoncry
    }
    release
    end
}

script FushciaGym_ParalysisDusclopsMan {
    if(var(VAR_TEMP_1) == 2) {
	    msgbox("Ah!\nTerribly sorry about that.\pMy DUSCLOPS is quite ill-mannered.\nI only recently acquired him.\pI'll see to it that he's trained\nat once.", MSGBOX_DEFAULT)

    } else {
        lock
        msgbox("Now see here, DUSCLOPS.\pYou cannot simply attack any\nTRAINER who comes in!\lIt's quite unbefitting of you.", MSGBOX_DEFAULT)
        release
    }
	end
	end
}