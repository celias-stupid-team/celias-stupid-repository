
const MAN = 1
const DUSCLOPS = 2
mapscripts FushciaGym_ParalysisDusclopsRoom_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if(flag(FLAG_GOT_PARALYZED_ONCE)) {
            setvar(VAR_TEMP_1, 2)
            setobjectxyperm(MAN, 6, 11)
            setobjectxyperm(DUSCLOPS, 7, 11)
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_1, 0 {
            playse(SE_PIN)
            applymovement(MAN, Common_Movement_ExclamationMark)
            applymovement(DUSCLOPS, DusclopsAttacksYou)
            waitmovement(DUSCLOPS)
            playmoncry(SPECIES_DUSCLOPS, CRY_MODE_DEFAULT)
            msgbox("DUSCLOPS: Cloooops!\n", MSGBOX_DEFAULT)
            waitmoncry
            closemessage
            msgbox("DUSCLOPS used THUNDER WAVE!\n", MSGBOX_DEFAULT)
            setflag(FLAG_GOT_PARALYZED_ONCE)
            release
        }
    ]
}

movement DusclopsAttacksYou {
    walk_fast_down
    Walk_fast_left
    walk_fast_down
    face_down
}

script FushciaGym_ClosedCurtain {
	msgbox("The curtain does not open further.\nIt seems this is a dead end.", MSGBOX_SIGN)
	end
}

script FushciaGym_ParalysisDusclops {
    lock
    faceplayer
    if(var(VAR_TEMP_1) == 1) {
            playmoncry(SPECIES_DUSCLOPS, CRY_MODE_DEFAULT)
            msgbox("DUSCLOPS: Cloooops!\n", MSGBOX_DEFAULT)
            waitmoncry
            closemessage
            msgbox("DUSCLOPS used THUNDER WAVE!\n", MSGBOX_DEFAULT)
            setflag(FLAG_GOT_PARALYZED_ONCE)
            setvar(VAR_TEMP_1, 2)

    } else {
            playmoncry(SPECIES_DUSCLOPS, CRY_MODE_DEFAULT)
            msgbox("DUSCLOPS: Cloooops!\n", MSGBOX_DEFAULT)
            waitmoncry
    }
    release
    end
}

script FushciaGym_ParalysisDusclopsMan {
	msgbox("bad dusclops\n", MSGBOX_NPC)
	end
}