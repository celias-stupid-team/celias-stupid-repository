script ContestHall_Judge {
	lock

	textcolor(NPC_TEXT_COLOR_BLUE)
	if(flag(FLAG_TEMP_1)) {
		msgbox(
		"Wow!\n"
		"Astonishing!", MSGBOX_DEFAULT)
	} else {
		msgbox(
		"Contestant!\n"
		"Blow me away!", MSGBOX_DEFAULT)
	}
	release
	end
}