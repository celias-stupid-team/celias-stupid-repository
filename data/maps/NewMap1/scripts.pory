raw `

`
mapscripts NewMap1_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setflag(FLAG_CSR_MAP_SOOTOPOLIS)
		call(SetPlayerPokedexValues)
		
		if(!flag(FLAG_BADGE07_GET)) {
			setmaplayoutindex(LAYOUT_SOOTOPOLIS_NO_CENTER)
			setflag(FLAG_TEMP_3)
		}
	}
	MAP_SCRIPT_ON_LOAD {
	}
}
script Sootopolis_EventScript_Dad {
	lock
	faceplayer
	textcolor(0)
	msgbox("DAD: {PLAYER}!\nWhat are you doing out here?\pI really want to challenge that\nGYM over there, but I can't!\lI don't know how to swim!\pWell, never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	setflag(FLAG_DAD_SOOTOPOLIS)
	release
	end
}

script Sootopolis_EventScript_Guy {
	msgbox("Hmm, so going left at the GAME FREAK\noffice leads to the DEPT. STORE,\land going up the stairs leads…\p…Okay yeah, I have no idea where\nI am.", MSGBOX_NPC)
	end
}


script Sootopolis_EventScript_Kiri {
	lock
	faceplayer
	if(flag(FLAG_CSR_KIRI_PSYDUCK)) {
		msgbox("My daddy hasn't come home from work\nin a while.\pI see people from the city walking in\nand out of those buildings, though.", MSGBOX_DEFAULT)
		release
		end
	} else {
		msgbox("Hi, what's your name?\p... ... ...\n... ... ...\p... ... ...\nOkay. That's nice!\pMy name is KIRI.\pMy mommy and daddy named me that so\nI would grow healthy and happy.\lThat's what they wished.\pMy daddy really loves this POKéMON.\nYou can have it as a gift!", MSGBOX_DEFAULT)

		playfanfare(MUS_LEVEL_UP)
		msgbox("{PLAYER} obtained the\nPSYDUCK!", MSGBOX_DEFAULT)
		waitfanfare
		setvar(VAR_TEMP_1, SPECIES_GOLDUCK)
			givemon(SPECIES_GOLDUCK, 19)
			switch(var(VAR_RESULT)) {
				case 0: //Mon goes to party
					bufferspeciesname(STR_VAR_1, SPECIES_GOLDUCK)
					msgbox(Text_GiveNicknameToThisMon, MSGBOX_YESNO)
					goto_if_eq(VAR_RESULT, NO, Sootopolis_KiriEnd)
					call(EventScript_GetGiftMonPartySlot)
					call(EventScript_ChangePokemonNickname)
					goto(Sootopolis_KiriEnd)
					end
				case 1: //Mon goes to PC
						bufferspeciesname(STR_VAR_1, SPECIES_GOLDUCK)
						msgbox(Text_GiveNicknameToThisMon, MSGBOX_YESNO)
						if(var(VAR_RESULT) == 0) {
							call(EventScript_TransferredToPC)
							goto(Sootopolis_KiriEnd)
						} else {
							call(EventScript_NameReceivedBoxMon)
							call(EventScript_TransferredToPC)
							goto(Sootopolis_KiriEnd) //This can be simplified; I'll deal with it later
						}
						end
				case 2:
					goto(EventScript_NoMoreRoomForPokemon)
					break
			}
	}
	release
	end

	Sootopolis_KiriEnd:
		setflag(FLAG_CSR_KIRI_PSYDUCK)
		msgbox("My daddy loves that POKéMON!\pHe says he makes sure to always\nlet people catch it in every game!\pBut…\pThis one seems a little…\ndifferent.", MSGBOX_DEFAULT)
		release
		end
}


script Sootopolis_GymSign {
	msgbox(
	"SOOTOPOLIS CITY GYM\n"
	"LEADER: WALLACE\p"

	"Or like, maybe it's JUAN.{PAUSE 30}\n"
	"It kinda depends.", MSGBOX_SIGN)

}


script Sootopolis_LeaveTown {
	msgbox(
	"If you want to leave town, you\n"
	"need to DIVE underwater.\p"

	"In order to use DIVE, you must\n"
	"defeat the MOSSDEEP CITY GYM.\p"

	"To get to MOSSDEEP, you must first\n"
	"leave this town.\p"

	"…{PAUSE 30}Yeah this city is basically a\n"
	"prison.", MSGBOX_NPC)
}

script Sootopolis_LuvdiscClue {
	lock
	msgbox(
	"Hmm, I could've sworn my friend\n"
	"told me it was right here!\p"

	"Maybe I'm not understanding…\n"
	"", MSGBOX_DEFAULT)
	release
}

