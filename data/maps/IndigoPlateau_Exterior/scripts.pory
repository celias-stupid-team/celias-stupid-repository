raw `
IndigoPlateau_Exterior_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, IndigoPlateau_Exterior_OnTransition
	map_script MAP_SCRIPT_ON_FRAME_TABLE, IndigoPlateau_Exterior_OnFrame
	.byte 0

IndigoPlateau_Exterior_OnTransition::
	setworldmapflag FLAG_WORLD_MAP_INDIGO_PLATEAU_EXTERIOR
	call_if_eq VAR_MAP_SCENE_INDIGO_PLATEAU_EXTERIOR, 1, IndigoPlateau_Exterior_EventScript_PlayCreditsMusic
	end

IndigoPlateau_Exterior_EventScript_PlayCreditsMusic::
	playbgm MUS_STUPID_CREDITS, 0
	return

IndigoPlateau_Exterior_OnFrame::
	map_script_2 VAR_MAP_SCENE_INDIGO_PLATEAU_EXTERIOR, 1, IndigoPlateau_Exterior_EventScript_Credits
	.2byte 0


@ After beating the champion, you are warped to the main
@ entrance of Indigo Plateau. This script starts running
@ immediately after your walking animation.
@ The script is timed to the music.

IndigoPlateau_Exterior_Movement_PlayerLeave::
	player_run_down
	player_run_down
	player_run_down
	player_run_down
	player_run_down
	player_run_down
	step_end

@ Unused
IndigoPlateau_Exterior_Movement_PlayerExitBuilding::
	walk_down
	walk_down
	step_end

IndigoPlateau_Exterior_Movement_PlayerWatchRivalLeave::
	delay_16
	delay_4
	walk_in_place_faster_down
	step_end

IndigoPlateau_Exterior_Movement_PlayerWatchOakLeave::
	delay_8
	walk_in_place_faster_right
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	walk_in_place_faster_down
	step_end

IndigoPlateau_Exterior_Movement_PlayerBeginLeave::
	walk_right
	delay_16
	walk_down
	walk_down
	delay_16
	delay_16
	step_end

IndigoPlateau_Exterior_Movement_PlayerTurnAround::
	walk_in_place_faster_down
	step_end

IndigoPlateau_Exterior_Movement_PushPlayerOutOfWay::
	face_right
	lock_facing_direction
	walk_left
	unlock_facing_direction
	step_end

IndigoPlateau_Exterior_Movement_PlayerFaceLeague::
	walk_in_place_faster_up
	step_end

IndigoPlateau_Exterior_Movement_RivalLeave::
	walk_fast_down
	walk_fast_down
	walk_fast_down
	walk_fast_down
	walk_fast_down
	walk_fast_down
	walk_fast_down
	step_end

IndigoPlateau_Exterior_Movement_RivalExitBuilding::
	walk_fast_down
	step_end

IndigoPlateau_Exterior_Movement_OakLeave::
	walk_in_place_faster_left
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	walk_in_place_faster_down
	delay_16
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	step_end

IndigoPlateau_Exterior_Movement_OakExitBuilding::
	walk_down
	step_end
`
script IndigoPlateau_Exterior_EventScript_Credits {
	lockall
	special(SpawnCameraObject)
	

	//Rival exits building. Spawn a dummy object to lock the camera.
	//opendoor(11, 6)
	//waitdooranim
	delay(20)
	applymovement(LOCALID_CAMERA, moves(
		walk_down * 2
	))
	applymovement(LOCALID_PLAYER, moves(
		walk_down * 2
		face_down
		delay_16
		delay_8
		face_up
	))
	delay(16)
	//closedoor(11, 6)
	waitmovement(0)
	delay(40)
	
	// Rivals all exit
	opendoor(84, 6)
	waitdooranim
	addobject(LOCALID_CREDITS_RIVAL)
	applymovement(LOCALID_CREDITS_RIVAL, moves(
		set_visible
		walk_slow_down
		face_down
		delay_16 * 2
		delay_8
		walk_slow_down
		walk_slow_left
		walk_slow_down * 9
	))
	delay(92)
	addobject(LOCALID_CREDITS_RIVAL2)
	applymovement(LOCALID_CREDITS_RIVAL2, moves(
		set_visible
		walk_slow_down * 2
		walk_slow_right
		walk_slow_down * 9
	))
	delay(60)
	addobject(LOCALID_CREDITS_RIVAL3)
	applymovement(LOCALID_CREDITS_RIVAL3, moves(
		set_visible
		walk_slow_down * 2
		walk_slow_left
		walk_slow_down * 9
	))
	delay(60)
	addobject(LOCALID_CREDITS_RIVAL4)
	applymovement(LOCALID_CREDITS_RIVAL4, moves(
		set_visible
		walk_slow_down * 2
		walk_slow_right
		walk_slow_down * 9
	))
	delay(60)
	addobject(LOCALID_CREDITS_RIVAL5)
	applymovement(LOCALID_CREDITS_RIVAL5, moves(
		set_visible
		walk_slow_down * 2
		walk_slow_left
		walk_slow_down * 9
	))
	delay(60)
	addobject(LOCALID_CREDITS_RIVAL6)
	applymovement(LOCALID_CREDITS_RIVAL6, moves(
		set_visible
		walk_slow_down * 2
		walk_slow_right
		walk_slow_down * 9
	))
	waitmovement(LOCALID_CREDITS_RIVAL3)
	closedoor(84, 6)
	waitdooranim
	delay(140)

	// Lass comes out
	applymovement(LOCALID_PLAYER, moves(
		emote_exclamation_mark
	))
	waitmovement(0)
	delay(96)
	opendoor(84, 6)
	waitdooranim
	delay(64)
	addobject(LOCALID_CREDITS_LASS)
	applymovement(LOCALID_CREDITS_LASS, moves( //Keep this timing perfectly here.
		set_visible
		walk_slow_down
		face_down
		delay_16 * 5
		walk_slower_down
		delay_16 * 6
		walk_slower_left
	))
	delay(45)
	closedoor(84, 6)
	waitmovement(LOCALID_CREDITS_LASS)
	applymovement(LOCALID_CREDITS_LASS, moves(
		walk_slower_down * 2
		
	))
	applymovement(LOCALID_PLAYER, moves(
		delay_16
		delay_8
		face_left
	))
	waitmovement(LOCALID_CREDITS_LASS)
	applymovement(LOCALID_CREDITS_LASS, moves(
		walk_slower_right
		walk_slower_down * 6
		
	))
	applymovement(LOCALID_PLAYER, moves(
		delay_16
		delay_8
		face_down
	))
	delay(180)
	applymovement(LOCALID_PLAYER, moves(
		face_up
	))
	delay(85)
	removeobject(LOCALID_CREDITS_RIVAL)
	removeobject(LOCALID_CREDITS_RIVAL2)
	removeobject(LOCALID_CREDITS_RIVAL3)
	removeobject(LOCALID_CREDITS_RIVAL4)
	removeobject(LOCALID_CREDITS_RIVAL5)
	removeobject(LOCALID_CREDITS_RIVAL6)
	removeobject(LOCALID_CREDITS_LASS)



	
	// Slowly pan down
	applymovement(LOCALID_CAMERA, moves(
		walk_slower_down * 5
	))
	delay(60)
	fadescreen(FADE_TO_BLACK)
	waitmovement(LOCALID_CAMERA)
	applymovement(LOCALID_CAMERA, moves(
		walk_fastest_down * 13
	))
	waitmovement(LOCALID_CAMERA)

	//Scene 2
	applymovement(LOCALID_CAMERA, moves(
		walk_slow_down * 9
	))
	fadescreen(FADE_FROM_BLACK)
	waitmovement(0)
	applymovement(LOCALID_CAMERA, moves(
		walk_slow_down * 5
	))
	fadescreen(FADE_TO_BLACK)
	waitmovement(0)
	applymovement(LOCALID_CAMERA, moves(
		walk_fastest_down * 13
	))
	//setlayouttiles(LAYOUT_INDIGO_PLATEAU_EXTERIOR_LAYOUT_JOHTO, 0, 0, 0, 0, 96, 74)
	waitmovement(0)


	//Scene 3
	applymovement(LOCALID_CAMERA, moves(
		walk_slow_down * 8
		walk_slow_left * 3
	))
	fadescreen(FADE_FROM_BLACK)
	waitmovement(0)
	applymovement(LOCALID_CAMERA, moves(
		walk_slow_left * 4
	))
	waitmovement(0)
	applymovement(LOCALID_CAMERA, moves(
		walk_slow_left * 4
	))
	fadescreen(FADE_TO_BLACK)
	waitmovement(0)
	applymovement(LOCALID_CAMERA, moves(
		walk_fastest_left * 13
	))
	waitmovement(0)

	// Scene 4
	
	applymovement(LOCALID_CAMERA, moves(
		walk_slow_left * 9
	))
	fadescreen(FADE_FROM_BLACK)
	waitmovement(0)
	applymovement(LOCALID_CAMERA, moves(
		walk_slow_left * 5
	))
	fadescreen(FADE_TO_BLACK)
	waitmovement(0)
	applymovement(LOCALID_CAMERA, moves(
		walk_fastest_left * 13
	))

	waitmovement(0)
	applymovement(LOCALID_CAMERA, moves(
		walk_slow_left * 12
	))
	callnative(EnableSEDuringCredits)
	fadescreen(FADE_FROM_BLACK)
	waitmovement(LOCALID_CAMERA)
	delay(70)
	addobject(LOCALID_CREDITS_GOLD)
	applymovement(LOCALID_CREDITS_GOLD, moves(
		walk_fast_right * 8
		walk_fast_down * 2
	))
	waitmovement(LOCALID_CREDITS_GOLD)
	playse(SE_LEDGE)
	applymovement(LOCALID_CREDITS_GOLD, moves(
		jump_2_down
	))
	delay(31)
	fadescreeninstant(FADE_TO_BLACK)
	delay(60)
	playbgm(MUS_TITLE, TRUE)
	
	setvar(VAR_MAP_SCENE_INDIGO_PLATEAU_EXTERIOR, 0)
	waitstate
	releaseall
	end
}