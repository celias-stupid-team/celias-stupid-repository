`

script DiglettsCave_North_ThisGuyGuy {
	lock
	faceplayer
	message("Long ago, I found a strange\nPOKéMON near here.\pIt escaped from my POKé BALL and\nit was never seen again.\pThis guy haunts my dreams.")
	waitmessage
	showmonpic(SPECIES_THIS_GUY, 10, 3)
	waitbuttonpress
	hidemonpic
	release
	end
}