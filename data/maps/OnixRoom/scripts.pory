mapscripts OnixRoom_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if(!flag(FLAG_TRANSPORTED_IRATE_GAMER)) {
            setflag(FLAG_TEMP_2)
        }
    }
}


script OnixRoom_Onix {
    lock
    if(checkitem(ITEM_RUBY)) {
        removeitem(ITEM_RUBY)
    }
    setflag(FLAG_SHINY_CREATION)
    setwildbattle(SPECIES_ONIX, 30)
    playmoncry(SPECIES_ONIX, CRY_MODE_ENCOUNTER)
    dowildbattle
    delay(10)
    removeobject(VAR_LAST_TALKED)
    release
    end
}



script OnixRoom_Suckman {
	msgbox(
	"IRATE GAMER: What the shit is\n"
	"this fuck?\p"

	"I am transphobic.\n"
	"", MSGBOX_NPC)
}
