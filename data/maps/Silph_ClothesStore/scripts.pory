mapscripts Silph_ClothesStore_MapScripts {

}


script ClothesStore_Woman {
	msgbox(
	"Welcome to the SILPH CO CLOTHES\n"
	"SHOP.\l"
	"We're here for your fashion needs.\p"

	"…{PAUSE 30}Wait.\n"
	"You're…{PAUSE 30} not very stylish.\p"

	"Sorry, but in that case I'm afraid\n"
	"I won't let you shop here.\p"

	"This is a line of reasoning that\n"
	"makes perfect sense.\l"
	"Goodbye.", MSGBOX_NPC)
}

script ClothesStore_SoupMan {
	msgbox(
	"What kinda CLOTHES STORE is this?\p"

	"I can't find a decent can of\n"
	"SOUP anywhere!", MSGBOX_NPC)
}

script ClothesStore_Shorts {
    textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"Hi!\n"
	"I'm SHORTS!\p"

	"I hope I look comfy and easy to\n"
	"wear!", MSGBOX_NPC)
}

script ClothesStore_MaleClothes {
    lock
    if(checkplayergender == MALE) {
        msgbox(
        "A shirt is on display.\p"

        "It's an identical copy of your\n"
        "favorite, but inexplicably it\l"
        "costs 500x more.", MSGBOX_DEFAULT)
    } else {
        playse(SE_PIN)
       applymovement(LOCALID_GENDER_POLICE, moves(
            face_left
            emote_exclamation_mark

       ))
       waitmovement(0)
       delay(40)
        textcolor(NPC_TEXT_COLOR_FEMALE)
        msgbox(
        "This is our MEN'S section.\p"

        "We are extremely strict about\n"
        "where you're allowed to shop.\p"

        "How dare you even think about\n"
        "wearing clothes the programmers\l"
        "didn't account for?", MSGBOX_DEFAULT)
    }
}
script ClothesStore_FemaleClothes {
    lock
    if(checkplayergender == FEMALE) {
        msgbox(
        "A shirt is on display.\p"

        "It's an identical copy of your\n"
        "favorite, but inexplicably it\l"
        "costs 500x more.", MSGBOX_DEFAULT)
    } else {
        playse(SE_PIN)
       applymovement(LOCALID_GENDER_POLICE, moves(
            face_right
            emote_exclamation_mark

       ))
       waitmovement(0)
       delay(40)
        textcolor(NPC_TEXT_COLOR_FEMALE)
        msgbox(
        "This is our MEN'S section.\p"

        "We are extremely strict about\n"
        "where you're allowed to shop.\p"

        "How dare you even think about\n"
        "wearing clothes the programmers\l"
        "didn't account for?", MSGBOX_DEFAULT)
    }
}