mapscripts FushciaGym_DoubleBattleRoom_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        
        setrespawn(HEAL_LOCATION_FUSHCIA_GYM_DOUBLE_BATTLE_ROOM)
    }
}

// single battle 1
script FushciaGym_DoubleBattleRoom_EventScript_Liam {
	trainerbattle_single(TRAINER_CAMPER_LIAM, PewterCity_Gym_Text_LiamIntro, PewterCity_Gym_Text_LiamDefeat)
	msgbox("Double battler 1\n", MSGBOX_AUTOCLOSE)
}

// single battle 2
script FushciaGym_DoubleBattleRoom_EventScript_Linda {
	trainerbattle_single(TRAINER_CAMPER_FLINT, PewterCity_Gym_Text_LiamIntro, PewterCity_Gym_Text_LiamDefeat)
	msgbox("Double battler 2\n", MSGBOX_AUTOCLOSE)
}

// double battle
script FushciaGym_DoubleBattleRoom_EventScript_Linda_Double {
	trainerbattle_double(TRAINER_COOL_COUPLE_RAY_TYRA, VictoryRoad_3F_Text_TyraIntro, VictoryRoad_3F_Text_TyraDefeat, VictoryRoad_3F_Text_TyraNotEnoughMons, FushciaGym_DoubleBattleRoom_EventScript_Linda_Double_Continue)
}

script FushciaGym_DoubleBattleRoom_EventScript_Linda_Double_Continue {
    // set the flags for both single trainers after winning the double battle
    settrainerflag(TRAINER_CAMPER_LIAM)
    settrainerflag(TRAINER_CAMPER_FLINT)
}
