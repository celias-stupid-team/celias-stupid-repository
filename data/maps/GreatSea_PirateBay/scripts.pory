}


script PirateBay_GluedToATree {
	msgbox(
	"He's glued to a tree.\n"
	"", MSGBOX_SIGN)

}

script PirateBay_Nurse {
	lock
	textcolor(NPC_TEXT_COLOR_RED)
	message(
	"Ahoy, matey!\n"
	"Welcome to the POKéMON HUT!\p"

	"Would you like to heal your\n"
	"POKéMON?")
	waitmessage
	dynmultichoice(19, 7, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "AYE", "NAY")
	if(!var(VAR_RESULT)) {
		message(
		"Do ye be sure?\n"
		"")
		waitmessage
		dynmultichoice(19, 7, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "AYE", "NAY")
		if(!var(VAR_RESULT)) {
			message(
			"Do ye be REALLY sure?\n"
			"")
			waitmessage
			dynmultichoice(19, 7, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "AYE", "NAY")
			if(!var(VAR_RESULT)) {
				msgbox(
				"If ye insist…\n"
				"", MSGBOX_DEFAULT)
					fadescreenswapbuffers(FADE_TO_BLACK)
					closemessage
					playfanfare(MUS_HEAL)
					waitfanfare
					special(HealPlayerParty)
					fadescreenswapbuffers(FADE_FROM_BLACK)
					msgbox(
					"Aye!\n"
					"Yer POKéMON are fully healed!", MSGBOX_DEFAULT)
					applymovement(VAR_LAST_TALKED, moves(
							nurse_joy_bow
							delay_4

					))
					waitmovement(0)
					
					msgbox(
					"I hope yer POKéMON be trounced\n"
					"again!", MSGBOX_DEFAULT)
					release
					end



			} else {
				
				msgbox(
				"I hope yer POKéMON be trounced\n"
				"again!", MSGBOX_DEFAULT)
				release
				end

			}

		} else {
				
			msgbox(
			"I hope yer POKéMON be trounced\n"
			"again!", MSGBOX_DEFAULT)
			release
			end
		}

	} else {
		msgbox(
		"I hope yer POKéMON be trounced\n"
		"again!", MSGBOX_DEFAULT)
		release
		end
	}
}