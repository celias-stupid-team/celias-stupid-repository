mapscripts GreatSea_PirateBay_MapScripts {

}

script PirateBay_BuyItOrDie {
	msgbox(
	"Hello! If you like this game,\n"
	"buy it or die.", MSGBOX_NPC) //Buy or Die message box appears
}

script PirateBay_PokeharborSign {
	msgbox(
	"POKéHARBOR\p"

	"We steal from you.\n"
	"Thanks!", MSGBOX_SIGN)

}

script PirateBay_PrePatchedPirate {
	msgbox(
	"Arr…\n"
	"What happened to me eye, ye ask?\p"

	"Ahaha!\n"
	"Actually, I came pre-patched!", MSGBOX_NPC)
}

script PirateBay_BreakTheSealHint {
	setflag(FLAG_HOOPA_HINT)
	msgbox(
	"There was a powerful POKéMON that\n"
	"once something something\l"
	"However, it has been SEALED away.\p"

	"To find it something something\n"
	"you must break the SEAL!", MSGBOX_NPC)
}


//Potion Shop

//Burn Drive Shop

script PirateBay_BurnDriveGuy {
	lock
	faceplayer
	msgbox(
	"Take this\n"
	"", MSGBOX_DEFAULT)
	giveitem_msg("{PLAYER} obtained the\nBURN DRIVE!", ITEM_BURN_DRIVE)
	waitfanfare
	release
}

//One Piece shop

script PirateBay_PotionShop {
	lock
	faceplayer
	msgbox(
	"I am a merchant\n"
	"", MSGBOX_DEFAULT)
	pokemart(PirateBay_Potions)
	release
}

mart PirateBay_Potions {
	ITEM_POTION_EXE
	ITEM_NONE
}

script PirateBay_WarehouseGuard {
	msgbox(
	"you can't go here\n"
	"", MSGBOX_NPC)
}

script PirateBay_SkyTower {
	lock
	msgbox(
	"sky tower\n"
	"", MSGBOX_DEFAULT)
	release
}

script PirateBay_Copperajah {
	lock
	msgbox(
	"A COPPERAJAH is on sale.\n"
	"", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	playmoncry(SPECIES_COPPERAJAH, CRY_MODE_DEFAULT)
	msgbox(
	"COPPERAJAH: Cruh, cah-rah?\n"
	"", MSGBOX_DEFAULT)
	waitmoncry
	closemessage
	delay(40)
	msgbox(
	"It appears to be low-quality.\n"
	"", MSGBOX_DEFAULT)
	release
}



script PirateBay_Sailor {
    trainerbattle_single(TRAINER_SODASHOP_SAILOR, "PLACEHOLDER", "PLACEHOLDER")
    msgbox("Yarrrgh.\nYe can't be using words like that!\pThis be a fucking kids' game, after\nall!", MSGBOX_NPC)

}