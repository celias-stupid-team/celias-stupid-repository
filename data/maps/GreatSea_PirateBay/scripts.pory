mapscripts GreatSea_PirateBay_MapScripts {
	MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
		VAR_TEMP_0, 0 {
			getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
			if(var(VAR_TEMP_0) > 53) {
				special(ForcePlayerToStartSurfing)

			}

		}
	]
	MAP_SCRIPT_ON_TRANSITION {
		setworldmapflag(FLAG_WORLD_MAP_PIRATE_BAY)
	}
	
}

script PirateBay_BuyItOrDie {
	msgbox(
	"But hey! If you like this game,\n"
	"maybe you should buy it!\l"
	"{PAUSE 30}…From us, of course.", MSGBOX_NPC)
}

script PirateBay_PokeharborSign {
	msgbox(
	"POKéHARBOR\p"

	"We steal from you.\n"
	"Thanks!", MSGBOX_SIGN)

}

script PirateBay_Sign {
	msgbox(
	"PIRATE BAY\n"
	"Boosts WATER moves in a pinch!", MSGBOX_SIGN)

}


script PirateBay_Pokey {
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"Nye heh heh…\n"
	"This HARBOR belongs to me!", MSGBOX_NPC)
}


script PirateBay_PrePatchedPirate {
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"Arr…\n"
	"What happened to me eye, ye ask?\p"

	"Ahaha!\n"
	"Actually, I came pre-patched!", MSGBOX_NPC)
}

script PirateBay_BreakTheSealHint {
	famechecker(FAMECHECKER_GREAT_BAY, 3)
	setflag(FLAG_HOOPA_HINT)
	msgbox(
	"Hello, dearie.\n"
	"Let me tell you a story.\p"

	"There was once a POKéMON so greedy\n"
	"and powerful, we humans had to\l"
	"Seal it away for our own safety.\p"

	"Now it is hidden somewhere in the\n"
	"world, and no one knows where.\p"

	"Some day, someone may come along\n"
	"and break the Seal themselves…", MSGBOX_NPC)
}


//Potion Shop

//Burn Drive Shop

script PirateBay_BurnDriveGuy {
	lock
	faceplayer
	if(flag(FLAG_GOT_BURN_DRIVE)) {
		msgbox(
		"I put that disk together myself!\p"

		"No need to worry about any corpos\n"
		"getting in the way of my art!", MSGBOX_DEFAULT)
		release
		end
	}
	msgbox(
	"Hey, there!\n"
	"Welcome to PIRATE BAY!\p"

	"Here, take this!\n"
	"", MSGBOX_DEFAULT)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	giveitem_msg("{PLAYER} obtained the\nBURN DRIVE!", ITEM_BURN_DRIVE)
	waitfanfare
	setflag(FLAG_GOT_BURN_DRIVE)

	release
}

//One Piece shop

script PirateBay_PotionShop {
	lock
	faceplayer
	msgbox(
	"Heyyyyyyyyy there, kid!\n"
	"Wanna check out my shop?", MSGBOX_DEFAULT)
	pokemart(PirateBay_Potions)
	if(checkitem(ITEM_POTION_EXE)) {
		while(checkitem(ITEM_POTION_EXE)) {
			removeitem(ITEM_POTION_EXE)
		}
		closemessage
		playse(SE_ITEMFINDER)
		waitse
		playse(SE_ITEMFINDER)
		waitse
		playse(SE_ITEMFINDER)
		waitse
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		msgbox(
		"{PLAYER}'s ANTIVIRUS is going off!\p"

		"POTION.exe was uninstalled.\n"
		"", MSGBOX_DEFAULT)
	}

	release
}

mart PirateBay_Potions {
	ITEM_POTION_EXE
	ITEM_NONE
}

script PirateBay_WarehouseGuard {
	lock
	msgbox(
	"Ha!\nHe's asleep!"
	"", MSGBOX_DEFAULT)
	release
}

script PirateBay_SkyTower {
	lock
	faceplayer
	msgbox(
	"Hello, adventurer.\n"
	"Do you know the TOWER to the west?\p"

	"It's been locked all my life, but\n"
	"I have a feeling deep in my bones.\l"
	"Soon, the door will finally open.\p"

	"Follow the path of the dark water.\n"
	"It'll lead you there.", MSGBOX_DEFAULT)
	closemessage
	applymovement(VAR_LAST_TALKED, moves(
		face_original_direction
	))
	waitmovement(0)
	release
}

script PirateBay_Copperajah {
	lock
	faceplayer
	msgbox(
	"A COPPERAJAH is on sale.\n"
	"", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	playmoncry(SPECIES_COPPERAJAH, CRY_MODE_DEFAULT)
	msgbox(
	"COPPERAJAH: Cruh, cah-rah?\n"
	"", MSGBOX_DEFAULT)
	waitmoncry
	closemessage
	delay(40)
	msgbox(
	"It appears to be low-quality.\n"
	"", MSGBOX_DEFAULT)
	release
}



script PirateBay_Sailor {
    trainerbattle_single(TRAINER_FAG_SAILOR, "FUCK intro", "FUCK")
    msgbox("Yarrrgh.\nYe can't be using words like that!\pThis be a fucking kids' game, after\nall!", MSGBOX_NPC)

}


script PirateBay_Entrance {
	lock
	playse(SE_PIN)
	fadenewbgm(MUS_NONE)
	applymovement(LOCALID_PIRATEBAY_SAILOR, moves(
		emote_exclamation_mark
		delay_16 * 2
	))
	waitmovement(0)
	applymovement(LOCALID_PLAYER, moves(
		face_up
	))
	delay(30)
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"Hey, you! {PAUSE 30}If you like this game…\n"
	"{PAUSE 30}Buy it or die.", MSGBOX_DEFAULT)
	closemessage
	delay(60)
	msgbox(
	"Bahahaha!\n"
	"Just kidding!\p"

	"Welcome aboard, friend!\n"
	"", MSGBOX_DEFAULT)
	playbgm(MUS_BINKS_SAKE, TRUE)
	setvar(VAR_PIRATE_BAY_SCENE, 1)
	release

}

script PirateBay_PhishingGuru {
	msgbox(
	"Why, hello!\n"
	"I am the PHISHING GURU's BROTHER!\p"

	"Say, would you be interested in\n"
	"a fancy GOOD ROD?", MSGBOX_NPC)
}


script PirateBay_MessageBottle {
	lock
	msgbox(
	"It's a message in a bottle.\n"
	"", MSGBOX_DEFAULT)
	closemessage
	delay(10)
	msgbox(
	"Greetings, friend!\n"
	"It is indeed my pleasure to write\l"
	"to you this letter.\p"

	"My name is Mutassim Gaddafi, and I\n"
	"am a prince of Nigeria.\p"

	"Recently my father has passed away\n"
	"and left me with a large sum.\p"

	"MR. KUKUI, please send us a\n"
	"small fee…", MSGBOX_DEFAULT)
	release
}


script PirateBay_Dad {
	lock
	faceplayer
	textcolor(0)
	msgbox(
	"DAD: {PLAYER}!\n"
	"What are you doing out here?\p"

	"I'm just out here SURFING the\n"
	"WEB!\l"
	"I hope I don't get a virus!\p"

	"Well, never mind that.\n"
	"How about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}

script PirateBay_DontGoToWarehouse {
	msgbox(
	"See that building up there?\n"
	"It's the DMCA's WAREHOUSE.\p"

	"We need to keep a low profile\n"
	"down here in the BAY.\l"
	"Otherwise, they might notice us!\p"

	"Thankfully they're usually busy\n"
	"dealing with real issues, such as\l"
	"Youtubers using 10 seconds of music.", MSGBOX_NPC)
}


script PirateBay_RockClimbUp {
	lockall
	msgbox("Jagged rocks line the wall.\n", MSGBOX_DEFAULT)
	if(checkfieldmove(MOVE_ROCK_CLIMB) != PARTY_SIZE) {
		msgbox("Would you like to use\nROCK CLIMB?", MSGBOX_YESNO)
		closemessage
		if(var(VAR_RESULT)) {
			applymovement(LOCALID_PLAYER, moves(
				walk_fast_up * 2
				jump_up
			))
			waitmovement(0)
		}
	}
	releaseall

}
script PirateBay_RockClimbDown {
	lockall
	msgbox("Jagged rocks line the wall.\n", MSGBOX_DEFAULT)
	if(checkfieldmove(MOVE_ROCK_CLIMB) != PARTY_SIZE) {
		msgbox("Would you like to use\nROCK CLIMB?", MSGBOX_YESNO)
		closemessage
		if(var(VAR_RESULT)) {
			applymovement(LOCALID_PLAYER, moves(
				walk_fast_down * 2
				jump_down
			))
			waitmovement(0)
		}
	}
	releaseall

}


