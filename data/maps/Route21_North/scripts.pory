raw `
Route21_North_MapScripts::
	.byte 0
`

script Route21_LassSign {
	msgbox(
	"TRAINER TIPS!\p"

	"You can avoid battle by not letting\n"
	"trainers see you.", MSGBOX_SIGN)

}


script Route21_AroundTheWorld {
	lock
	playbgm(MUS_ENCOUNTER_GIRL, FALSE)

	// 	special(SpawnCameraObject)
	// applymovement(LOCALID_CAMERA, moves(
	// 	delay_16 * 7
	// 	walk_faster_right * 10
	// 	walk_faster_right * 365
	// ))
	// applymovement(LOCALID_AROUND_WORLD_LASS, moves(
	// 	face_right
	// 	emote_exclamation_mark
	// 	delay_16 * 5
	// 	walk_right * 4
	// 	walk_faster_right * 364
		
	// ))
	// waitmovement(LOCALID_CAMERA)
	// waitmovement(LOCALID_AROUND_WORLD_LASS)
	// addobject(LOCALID_PLAYER)



	applymovement(LOCALID_AROUND_WORLD_LASS, moves(
		face_right
		emote_exclamation_mark
		delay_16 * 5
		walk_right * 5
		
	))
	waitmovement(0)
	setobjectxy(LOCALID_AROUND_WORLD_LASS, 9, 41)
	delay(60)
	applymovement(LOCALID_AROUND_WORLD_LASS, moves(
		walk_right * 7
		
	))
	waitmovement(0)
	delay(10)
	applymovement(LOCALID_PLAYER, moves(
		face_left
	))
	textcolor(NPC_TEXT_COLOR_RED)
	msgbox(
	"Hey!\n"
	"Don't look at me!", MSGBOX_DEFAULT)
	playbgm(MUS_ROUTE11, TRUE)
	trainerbattle_no_intro(TRAINER_AROUND_WORLD_LASS, "After I came all this way-!")
	msgbox(
	"No matter where you go, you'll\n"
	"always be looking at me…", MSGBOX_DEFAULT)
	closemessage
	applymovement(LOCALID_AROUND_WORLD_LASS, moves(
		walk_left * 6
		walk_down * 6
		walk_fastest_left
		walk_fastest_up * 12
		walk_fastest_right * 2
		walk_down * 2
		face_down
	))
	waitmovement(0)
	copyobjectxytoperm(LOCALID_AROUND_WORLD_LASS)
	setobjectmovementtype(LOCALID_AROUND_WORLD_LASS, MOVEMENT_TYPE_FACE_DOWN)
	setvar(VAR_AROUND_THE_WORLD_LASS, 1)
	release
	end
}


script Route21_Lass {
	msgbox(
	"It's a small, small world…\n"
	"", MSGBOX_NPC)
}
