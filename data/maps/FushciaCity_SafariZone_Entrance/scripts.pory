raw `


FushciaCity_SafariZone_Entrance_OnFrame::
	map_script_2 VAR_MAP_SCENE_FUSHCIA_CITY_SAFARI_ZONE_ENTRANCE, 1, FushciaCity_SafariZone_Entrance_EventScript_ExitWarpIn
	map_script_2 VAR_MAP_SCENE_FUSHCIA_CITY_SAFARI_ZONE_ENTRANCE, 2, FushciaCity_SafariZone_Entrance_EventScript_ExitEarly
	map_script_2 VAR_MAP_SCENE_FUSHCIA_CITY_SAFARI_ZONE_ENTRANCE, 3, FushciaCity_SafariZone_Entrance_EventScript_ExitWalkIn
	.2byte 0

@ When player runs out of balls mid-battle
FushciaCity_SafariZone_Entrance_EventScript_ExitWalkIn::
	lockall
	textcolor NPC_TEXT_COLOR_MALE
	applymovement LOCALID_PLAYER, FushciaCity_SafariZone_Entrance_Movement_ApproachCounter
	waitmovement 0
	msgbox FushciaCity_SafariZone_Entrance_Text_CatchFairShareComeAgain
	closemessage
	applymovement LOCALID_PLAYER, FushciaCity_SafariZone_Entrance_Movement_Exit2
	waitmovement 0
	special ExitSafariMode
	setvar VAR_MAP_SCENE_FUSHCIA_CITY_SAFARI_ZONE_ENTRANCE, 0
	releaseall
	end

@ When player runs of out balls after catching a pokemon, or runs out of steps
FushciaCity_SafariZone_Entrance_EventScript_ExitWarpIn::
	lockall
	textcolor NPC_TEXT_COLOR_MALE
	msgbox FushciaCity_SafariZone_Entrance_Text_CatchFairShareComeAgain
	closemessage
	applymovement LOCALID_PLAYER, FushciaCity_SafariZone_Entrance_Movement_Exit
	waitmovement 0
	special ExitSafariMode
	setvar VAR_MAP_SCENE_FUSHCIA_CITY_SAFARI_ZONE_ENTRANCE, 0
	releaseall
	end

@ When player re-enters the entrance building with balls/steps remaining
FushciaCity_SafariZone_Entrance_EventScript_ExitEarly::
	lockall
	textcolor NPC_TEXT_COLOR_MALE
	msgbox FushciaCity_SafariZone_Entrance_Text_GoingToLeaveSafariZoneEarly, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, FushciaCity_SafariZone_Entrance_EventScript_ReturnToSafariZone
	msgbox FushciaCity_SafariZone_Entrance_Text_PleaseReturnSafariBalls
	closemessage
	applymovement LOCALID_PLAYER, FushciaCity_SafariZone_Entrance_Movement_Exit
	waitmovement 0
	special ExitSafariMode
	setvar VAR_MAP_SCENE_FUSHCIA_CITY_SAFARI_ZONE_ENTRANCE, 0
	releaseall
	end

FushciaCity_SafariZone_Entrance_EventScript_ReturnToSafariZone::
	msgbox FushciaCity_SafariZone_Entrance_Text_GoodLuck
	closemessage
	applymovement LOCALID_PLAYER, FushciaCity_SafariZone_Entrance_Movement_ReEnter
	waitmovement 0
	warp MAP_SAFARI_ZONE_CENTER, 26, 30
	waitstate
	end

FushciaCity_SafariZone_Entrance_Movement_Exit::
	walk_down
	walk_down
	step_end

FushciaCity_SafariZone_Entrance_Movement_ReEnter::
	walk_up
	step_end

FushciaCity_SafariZone_Entrance_Movement_Exit2::
	walk_down
	walk_down
	step_end

FushciaCity_SafariZone_Entrance_Movement_ApproachCounter::
	walk_down
	delay_8
	step_end

FushciaCity_SafariZone_Entrance_EventScript_EntryTriggerMid::
	lockall
	setvar VAR_TEMP_2, 0
	goto FushciaCity_SafariZone_Entrance_EventScript_AskEnterSafariZone
	end

FushciaCity_SafariZone_Entrance_EventScript_EntryTriggerRight::
	lockall
	setvar VAR_TEMP_2, 1
	goto FushciaCity_SafariZone_Entrance_EventScript_AskEnterSafariZone
	end

FushciaCity_SafariZone_Entrance_EventScript_EntryTriggerLeft::
	lockall
	setvar VAR_TEMP_2, 2
	goto FushciaCity_SafariZone_Entrance_EventScript_AskEnterSafariZone
	end

FushciaCity_SafariZone_Entrance_EventScript_AskEnterSafariZone::
	textcolor NPC_TEXT_COLOR_MALE
	msgbox FushciaCity_SafariZone_Entrance_Text_WelcomeToSafariZone
	applymovement LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterRight
	waitmovement 0
	showmoneybox 0, 0
	msgbox FushciaCity_SafariZone_Entrance_Text_PlaySafariGameFor500, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, FushciaCity_SafariZone_Entrance_EventScript_TryEnterSafariZone
	msgbox FushciaCity_SafariZone_Entrance_Text_OkayPleaseComeAgain
	goto FushciaCity_SafariZone_Entrance_EventScript_ForcePlayerBack
	end

FushciaCity_SafariZone_Entrance_EventScript_TryEnterSafariZone::
	call FushciaCity_SafariZone_Entrance_EventScript_CheckSpaceForMons
	checkmoney 500
	goto_if_eq VAR_RESULT, FALSE, FushciaCity_SafariZone_Entrance_EventScript_NotEnoughMoney
	removemoney 500
	updatemoneybox
	msgbox FushciaCity_SafariZone_Entrance_Text_ThatllBe500WeOnlyUseSpecialBalls
	textcolor NPC_TEXT_COLOR_NEUTRAL
	playfanfare MUS_LEVEL_UP
	message FushciaCity_SafariZone_Entrance_Text_PlayerReceived30SafariBalls
	waitfanfare
	call EventScript_RestorePrevTextColor
	msgbox FushciaCity_SafariZone_Entrance_Text_CallYouOnPAWhenYouRunOut
	closemessage
	hidemoneybox
	call_if_eq VAR_TEMP_2, 0, FushciaCity_SafariZone_Entrance_EventScript_EnterSafariZoneMid
	call_if_eq VAR_TEMP_2, 1, FushciaCity_SafariZone_Entrance_EventScript_EnterSafariZoneRight
	call_if_eq VAR_TEMP_2, 2, FushciaCity_SafariZone_Entrance_EventScript_EnterSafariZoneLeft
	special EnterSafariMode
	setvar VAR_MAP_SCENE_FUSHCIA_CITY_SAFARI_ZONE_ENTRANCE, 2
	warp MAP_SAFARI_ZONE_CENTER, 255, 26, 30
	waitstate
	end

FushciaCity_SafariZone_Entrance_EventScript_EnterSafariZoneRight::
	applymovement LOCALID_PLAYER, FushciaCity_SafariZone_Entrance_Movement_EnterSafariZoneRight
	waitmovement 0
	return

FushciaCity_SafariZone_Entrance_EventScript_EnterSafariZoneMid::
	applymovement LOCALID_PLAYER, FushciaCity_SafariZone_Entrance_Movement_EnterSafariZoneMid
	waitmovement 0
	return

FushciaCity_SafariZone_Entrance_EventScript_EnterSafariZoneLeft::
	applymovement LOCALID_PLAYER, FushciaCity_SafariZone_Entrance_Movement_EnterSafariZoneLeft
	waitmovement 0
	return

FushciaCity_SafariZone_Entrance_EventScript_CheckSpaceForMons::
	getpartysize
	goto_if_ne VAR_RESULT, PARTY_SIZE, EventScript_Return
	specialvar VAR_RESULT, IsThereRoomInAnyBoxForMorePokemon
	goto_if_eq VAR_RESULT, TRUE, EventScript_Return
	msgbox SafariZone_Text_ExcuseMeYourPCBoxIsFull
	goto FushciaCity_SafariZone_Entrance_EventScript_ForcePlayerBack
	end

FushciaCity_SafariZone_Entrance_EventScript_NotEnoughMoney::
	msgbox FushciaCity_SafariZone_Entrance_Text_OopsNotEnoughMoney
	goto FushciaCity_SafariZone_Entrance_EventScript_ForcePlayerBack
	end

FushciaCity_SafariZone_Entrance_EventScript_ForcePlayerBack::
	closemessage
	applymovement LOCALID_PLAYER, FushciaCity_SafariZone_Entrance_Movement_ForceBack
	waitmovement 0
	releaseall
	end

FushciaCity_SafariZone_Entrance_Movement_ForceBack::
	walk_down
	step_end

FushciaCity_SafariZone_Entrance_Movement_EnterSafariZoneMid::
	walk_up
	walk_up
	step_end

FushciaCity_SafariZone_Entrance_Movement_EnterSafariZoneRight::
	walk_up
	walk_left
	walk_up
	step_end

FushciaCity_SafariZone_Entrance_Movement_EnterSafariZoneLeft::
	walk_up
	walk_right
	walk_up
	step_end

FushciaCity_SafariZone_Entrance_EventScript_InfoAttendant::
	lock
	faceplayer
	msgbox FushciaCity_SafariZone_Entrance_Text_FirstTimeAtSafariZone, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, FushciaCity_SafariZone_Entrance_EventScript_ExplainSafariZone
	msgbox FushciaCity_SafariZone_Entrance_Text_SorryYoureARegularHere
	release
	end

FushciaCity_SafariZone_Entrance_EventScript_ExplainSafariZone::
	msgbox FushciaCity_SafariZone_Entrance_Text_ExplainSafariZone
	release
	end
`

mapscripts FushciaCity_SafariZone_Entrance_MapScripts {
	MAP_SCRIPT_ON_FRAME_TABLE: FushciaCity_SafariZone_Entrance_OnFrame
	MAP_SCRIPT_ON_LOAD {
		getplayerxy(VAR_TEMP_3, VAR_TEMP_2)
		if(var(VAR_TEMP_2) < 3 || flag(FLAG_HIDE_DMCA_IN_SAFARI_ZONE)) {
			setvar(VAR_TEMP_1, 1)
		}

	}
}



script FushciaCity_SafariZone_Entrance_EventScript_Guy {
	lock
	faceplayer
	if(flag(FLAG_HIDE_DMCA_IN_SAFARI_ZONE)) {
		msgbox("Thank you for kicking those DMCA\nguys out of the SAFARI ZONE.\pNow we can get back to business\nas usual!", MSGBOX_DEFAULT)
	} else {
		msgbox("Hiya!\nWelcome to the SAFARI ZONE.\pWe, uh… We have some important\nguests in the park right now.\lI hope you don't mind them.", MSGBOX_DEFAULT)

	}
	applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
	end
}



script FushciaCity_SafariZone_Entrance {
	lockall
	setvar(VAR_RESULT, 0)
	textcolor(NPC_TEXT_COLOR_MALE)
	applymovement(LOCALID_PLAYER, Common_Movement_FaceRight)
	//applymovement(ASSISTANT, Common_Movement_FaceLeft)
	if(checkitem(ITEM_SANDWICH_CASE)) {
		msgbox("Hiya!\nWelcome to the SAFARI ZONE.\pWe, uh… We have some important\nguests in the park right now.\lI hope you don't mind them.\pWould you like to enter anyway?\n", MSGBOX_YESNO)
		if(var(VAR_RESULT)) {
			msgbox("Lovely!\pI hope you have a wonderful, non-\ninfringing visit!", MSGBOX_DEFAULT)
			closemessage
			getplayerxy(VAR_TEMP_2, VAR_TEMP_5)
			switch(var(VAR_TEMP_2)) {
				case 3:
					call(FushciaCity_SafariZone_Entrance_EventScript_EnterSafariZoneLeft)
				case 4:
					call(FushciaCity_SafariZone_Entrance_EventScript_EnterSafariZoneMid)
				case 5:
					call(FushciaCity_SafariZone_Entrance_EventScript_EnterSafariZoneRight)
			}
			special(EnterSafariMode)
			setvar(VAR_MAP_SCENE_FUSHCIA_CITY_SAFARI_ZONE_ENTRANCE, 2)
			warp(MAP_SAFARI_ZONE_CENTER, 255, 26, 30)
			waitstate
			end
		} else {
			msgbox("All right, totally understood.\pHave a nice day!\n", MSGBOX_DEFAULT)
			closemessage
			goto(FushciaCity_SafariZone_Entrance_EventScript_ForcePlayerBack)

		}
	} else {
		msgbox("Excuse me!\pYou need a SANDWICH CASE to enter\nthe SAFARI ZONE!\pTrust me, these rules make a lot\nof sense.\lPlease come again!", MSGBOX_DEFAULT)
		closemessage
		goto(FushciaCity_SafariZone_Entrance_EventScript_ForcePlayerBack)
	}
	releaseall
}