raw `


SaffronCity_House_EventScript_Lass::
	msgbox SaffronCity_House_Text_DontLookAtMyLetter, MSGBOX_NPC
	end

SaffronCity_House_EventScript_Youngster::
	msgbox SaffronCity_House_Text_GettingCopycatPokeDoll, MSGBOX_NPC
	end

SaffronCity_House_EventScript_Pidgey::
	lock
	faceplayer
	waitse
	playmoncry SPECIES_PIDGEY, CRY_MODE_NORMAL
	msgbox SaffronCity_House_Text_Pidgey
	waitmoncry
	release
	end

SaffronCity_House_EventScript_Letter::
	msgbox SaffronCity_House_Text_ExplainPPUp, MSGBOX_SIGN
	end
`

mapscripts SaffronCity_House_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setflag(FLAG_TEMP_1)
		if(flag(FLAG_SAFFRON_CHECKED_MONKEY_WINDOW)) {
			clearflag(FLAG_TEMP_1)
		}
	}
}

script SaffronCity_HouseNPC1 {
	if(flag(FLAG_SAFFRON_CHECKED_MONKEY_WINDOW)) {
		msgbox(
		"Wow!\n"
		"This MONKEY just fell from the sky!\p"

		"He's gonna be my bestest friend\n"
		"forever!", MSGBOX_NPC)
	} else {
		msgbox(
		"We've been trapped inside for\n"
		"who knows how long…\l"
		"I'm so lonely!", MSGBOX_NPC)
	}
}
script SaffronCity_HouseNPC2 {
	if(flag(FLAG_SAFFRON_CHECKED_MONKEY_WINDOW)) {
		msgbox(
		"Grr…\p"

		"A MONKEY fell from the sky, so I\n"
		"had to repair my roof.\l"
		"Again.\p"

		"This is the fourth time this month…\n"
		"", MSGBOX_DEFAULT)
	} else {
		msgbox(
		"The DMCA are finally gone, eh?\n"
		"Serves them right.\p"

		"Now if only you could deal with\n"
		"the strange weather we always get.", MSGBOX_NPC)
	}
}

script SaffronCity_HouseMonkey {
	lock
	playmoncry(SPECIES_PANPOUR, CRY_MODE_FAINT)
	waitmoncry
	playse(SE_PIN)
	applymovement(VAR_LAST_TALKED, moves(
		emote_question_mark
		delay_16 * 3
	))
	waitmovement(0)
	msgbox(
	"The monkey appears to be suffering\n"
	"from a major concussion.\p"

	"Directly above his head, shoddy\n"
	"patchwork in the ceiling implies\l"
	"a recent and rushed repair.", MSGBOX_DEFAULT)
	release
}