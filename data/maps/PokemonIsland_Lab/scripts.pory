}


script PokemonIslandLab_Cameron {
    lock
    textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"CAMERON: Yes!\n"
	"Just like that!\l"
	"Now lemme…", MSGBOX_DEFAULT)
    playse(MUS_PHOTO)
	dofieldeffect(FLDEFF_PHOTO_FLASH)
	delay(60)
    msgbox(
	"Perfect!\n"
	"", MSGBOX_DEFAULT)
    release
}

