mapscripts PokemonIsland_Lab_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_USED_CUT, 1 {
            delay(30)
            playse(SE_FALL)
            applymovement(LOCALID_IVY_2, moves(
                set_visible
                slide_down * 7
            ))
            waitmovement(0)
            addobject(LOCALID_IVY)
            setobjectxy(LOCALID_IVY_2, 13, 0)
            setvar(VAR_USED_CUT, 0)
            release
        }
    ]
    MAP_SCRIPT_ON_TRANSITION {
        setvar(VAR_USED_CUT, 0)
        if(flag(FLAG_KINGLER_SIGN)) {
            addvar(VAR_TEMP_5, 1)
        }
        if(flag(FLAG_DUGTRIO_SIGN)) {
            addvar(VAR_TEMP_5, 1)
        }
        if(flag(FLAG_GROWLITHE_SIGN)) {
            addvar(VAR_TEMP_5, 1)
        }
        if(flag(FLAG_ELECTIVIRE_SIGN)) {
            addvar(VAR_TEMP_5, 1)
        }
        if(flag(FLAG_AMBIGUOUS_STATUE_SIGN)) {
            addvar(VAR_TEMP_5, 1)
        }
        if(flag(FLAG_ONIX_TAIL_SIGN)) {
            addvar(VAR_TEMP_5, 1)
        }
        if(flag(FLAG_IVY_SIGN)) {
            addvar(VAR_TEMP_5, 1)
        }
        call(PokemonIslandLab_AddSignsBasedOnSigns)
        if(flag(FLAG_TURNED_IN_POKEMON_SIGNS)) {
            setobjectxyperm(LOCALID_TODD, 17, 3)
        }

    }
    MAP_SCRIPT_ON_LOAD {
        if(flag(FLAG_TURNED_IN_POKEMON_SIGNS)) {
            setobjectxy(LOCALID_TODD, 17, 3)
        }
    }
}

script PokemonIslandLab_AddSignsBasedOnSigns {
    clearflag(FLAG_TEMP_1)
    clearflag(FLAG_TEMP_2)
    clearflag(FLAG_TEMP_3)
    clearflag(FLAG_TEMP_4)
    clearflag(FLAG_TEMP_5)
    clearflag(FLAG_TEMP_6)
    clearflag(FLAG_TEMP_7)
    if(var(VAR_TEMP_5) < 1) {
        setflag(FLAG_TEMP_1)
    }
    if(var(VAR_TEMP_5) < 2) {
        setflag(FLAG_TEMP_2)
    }
    if(var(VAR_TEMP_5) < 3) {
        setflag(FLAG_TEMP_3)
    }
    if(var(VAR_TEMP_5) < 4) {
        setflag(FLAG_TEMP_4)
    }
    if(var(VAR_TEMP_5) < 5) {
        setflag(FLAG_TEMP_5)
    }
    if(var(VAR_TEMP_5) < 6) {
        setflag(FLAG_TEMP_6)
    }
    if(var(VAR_TEMP_5) < 7) {
        setflag(FLAG_TEMP_7)
    }
    
    return
}


script PokemonIslandLab_Ivy {
    lock
    faceplayer
    if(flag(FLAG_IVY_SIGN)) {
        msgbox(
        "IVY: Thank you so much for that\n"
        "GS BALL!\p"

        "Without it, I never would have seen\n"
        "something so extraordinary!", MSGBOX_DEFAULT)
        release
        end
    }
    if(flag(FLAG_TALKED_TO_IVY)) {
        if(checkitem(ITEM_GS_BALL)) {
            goto(PokemonIslandLab_GSBallCutscene)
        }
        msgbox(
        "I heard PROFESSOR OAK received a\n"
        "G.S. BALL recently.\l"
        "We need one for our work.\p"

        "Could you visit him and see if you\n"
        "can persuade him to help out?", MSGBOX_DEFAULT)
    } else {
        setflag(FLAG_TALKED_TO_IVY)
        msgbox(
        "PROFESSOR IVY: Ah, hello!\n"
        "You must be {PLAYER}!\l"
        "My colleague OAK mentioned you.\p"

        "I'm IVY, the world's leading\n"
	    "researcher on POKéMON SIGNS.\p" 

        "In fact, I think I've located\n"
        "one right here on this island!\l"
        "It's in the back room there.\p"

        "There's just one thing we need.\n"
        "It's called the G.S. BALL.\p"

        "I think PROFESSOR OAK ordered one\n"
        "in the mail recently.\l"
        "Maybe we can ask him, but…\p"

        "He's a bit prickly, that one.\n"
        "I don't think he'll donate it.\p"

        "Do you think you could go pursuade\n"
        "him to contribute to our cause?", MSGBOX_DEFAULT)
        if(checkitem(ITEM_GS_BALL)) {
            goto(PokemonIslandLab_GSBallCutscene)
        }
    }
    release
}

script PokemonIslandLab_GSBallCutscene {
    msgbox(
	"Ah!\n"
	"That's the GS BALL!\l"
	"Excellent work!\p"

	"I can finally finish my research!\n"
	"", MSGBOX_DEFAULT)
    closemessage
    delay(20)
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    if(var(VAR_RESULT) == DIR_WEST) {
        applymovement(LOCALID_PLAYER, moves(
            lock_facing_direction
            walk_right
            unlock_facing_direction
        ))
    }
    applymovement(VAR_LAST_TALKED, moves(
        delay_16
        walk_right
        walk_up * 3
        delay_16
        set_invisible
    ))
    waitmovement(LOCALID_PLAYER)
    applymovement(LOCALID_PLAYER, moves(
        delay_16 * 2
        face_up
    ))
    waitmovement(VAR_LAST_TALKED)
    playse(SE_EXIT)
    fadenewbgm(MUS_NONE)
    delay(60)

    msgbox(
	"Okay, let's see…\n"
	"All I have to do is-!", MSGBOX_DEFAULT)
    closemessage
    delay(30)
    playse(SE_CLICK)
    waitse
    delay(30)
    playse(SE_M_TAKE_DOWN)
    waitse
    setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 3)
    setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 3)
    setvar(VAR_SHAKESCREEN_NUM_SHAKES, 15)
    setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 3)
    special(ShakeScreen)
    delay(90)
    playmoncry(SPECIES_CELEBI, CRY_MODE_DEFAULT)
    waitmoncry
    msgbox(
	"Wow!\n"
	"Incredible!", MSGBOX_DEFAULT)
    closemessage
    delay(30)
    playfanfare(MUS_SLOTS_WIN)
    textcolor(NPC_TEXT_COLOR_NEUTRAL)
    msgbox(
	"PROFESSOR IVY discovered a\n"
	"POKéMON SIGN!", MSGBOX_DEFAULT)
    waitfanfare
    closemessage
    delay(30)
    playse(SE_FLEE)
    waitse
    delay(30)
    fadedefaultbgm
    setflag(FLAG_IVY_SIGN)
    textcolor(NPC_TEXT_COLOR_TREE)
    delay(60)
    playse(SE_EXIT)
    applymovement(VAR_LAST_TALKED, moves(
        set_visible
        walk_down
        delay_16 * 2
        walk_down
        face_player
    ))
    waitmovement(0)
    msgbox(
	"Aaaaaand I'm done!\n"
	"Wow!\p"

	"I witnessed something truly\n"
	"amazing today!\l"
	"Thanks so much for the help!", MSGBOX_DEFAULT)
    closemessage
    applymovement(VAR_LAST_TALKED, moves(
        walk_down
        walk_left
    ))
    addvar(VAR_TEMP_5, 1)
    call(PokemonIslandLab_AddSignsBasedOnSigns)
    waitmovement(0)
    release
    end

}

script PokemonIslandLab_Todd {
    lock
    faceplayer
    textcolor(NPC_TEXT_COLOR_BLUE)
    if(flag(FLAG_TURNED_IN_POKEMON_SIGNS)) {
        if(checkmoncaught(SPECIES_CASTFORM)) {
            msgbox(
            "TODD: The legendary RAINBOW CLOUD\n"
            "was here all along…\p"

            "Thank you for finding it.\n"
            "", MSGBOX_DEFAULT)
            release
            end
        }
        msgbox(
        "Here, you should go ahead.\p"

        "Whatever's waiting back there,{PAUSE 20}\n"
        "it's for you to find.", MSGBOX_DEFAULT)
        release
        end
    }
    famechecker(FAMECHECKER_GREAT_SEA_WEST, 0)
    if(flag(FLAG_DUGTRIO_SIGN) && flag(FLAG_GROWLITHE_SIGN) && flag(FLAG_ELECTIVIRE_SIGN) && flag(FLAG_AMBIGUOUS_STATUE_SIGN) && flag(FLAG_ONIX_TAIL_SIGN) && flag(FLAG_KINGLER_SIGN) && flag(FLAG_IVY_SIGN)) {
        fadenewbgm(MUS_NONE)
        msgbox(
        "TODD: Hey, {PLAYER}!\n"
        "How goes the search?", MSGBOX_DEFAULT)
        playse(SE_PIN)
        applymovement(VAR_LAST_TALKED, moves(
            emote_exclamation_mark
            delay_16 * 3
        ))
        waitmovement(0)
        msgbox(
        "You-\n"
        "You've found them all!?\l"
        "This is wonderful news!", MSGBOX_DEFAULT)
        closemessage
        
        special(SpawnCameraObject)
        applymovement(LOCALID_PLAYER, moves(
                lock_facing_direction
                walk_down
                face_up
        ))
        
        applymovement(VAR_LAST_TALKED, moves(
                walk_slower_left
                face_left
                delay_16 
                walk_slower_right * 2
                face_right
                delay_16
                walk_slower_left
                walk_slower_down
                face_down
        ))
        msgbox(
        "Now… {PAUSE 45}The only thing left is to\n"
        "learn where they all point…!", MSGBOX_DEFAULT)
        waitmovement(0)
        closemessage
        delay(30)
        applymovement(VAR_LAST_TALKED, moves(
            face_up
        ))
        delay(30)
        playse(SE_PIN)
        applymovement(VAR_LAST_TALKED, moves(
            face_up
            emote_exclamation_mark
            delay_16 * 3
            face_down
            delay_16
            face_up
            delay_16
            face_down
            delay_4
            face_up
            delay_4
            face_down
            delay_4
            face_up
            delay_4
        ))
        waitmovement(0)
        playse(SE_LEDGE)
        applymovement(VAR_LAST_TALKED, moves(
            jump_in_place_down
        ))
            msgbox(
        "{PLAYER}!!\n"
        "{PAUSE 45}I wonder if it's behind that door!", MSGBOX_DEFAULT)
        closemessage
        applymovement(VAR_LAST_TALKED, moves(
            walk_left
            face_right
        ))
        waitmovement(0)
        msgbox(
        "Here, you should go ahead.\p"

        "Whatever's waiting back there,{PAUSE 20}\n"
        "it's for you to find.", MSGBOX_DEFAULT)
        closemessage
        applymovement(LOCALID_CAMERA, moves(
            walk_down
        ))
        waitmovement(0)
        special(RemoveCameraObject)
        setflag(FLAG_TURNED_IN_POKEMON_SIGNS)
        release
        end
    }

    if(flag(FLAG_TALKED_TO_TODD)) {
        msgbox(
        "TODD: We've been documenting\n"
        "POKéMON SIGNS across KANTO.\l"
        "There's 7 to see in total.\p"

        "I can't wait to learn where they\n"
        "all point!", MSGBOX_DEFAULT)
    } else {
        setflag(FLAG_TALKED_TO_TODD)
        msgbox(
        "Heya, I'm TODD.\n"
        "Photographer extraordinaire!\p"

        "Say, have you ever heard of a\n"
        "“POKéMON SIGN”?\l"
        "We've been documenting them.\p"

        "Across KANTO, there's said to be\n"
        "seven POKéMON SIGNS to find.\p"

        "My partner, PROFESSOR IVY, is in\n"
        "the room to the left.\l"
        "She'll be able to give more info.", MSGBOX_DEFAULT)
    }
    applymovement(LOCALID_TODD, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    release
}

