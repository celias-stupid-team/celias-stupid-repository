script PokemonIslandLab_Dad {
	lock
	faceplayer
	textcolor(0)
	msgbox(
	"DAD: {PLAYER}!\n"
	"What are you doing out here?\p"

	"I'm enjoying being a model!\n"
	"Watch me strike a pose!\p"

	"Well, never mind that.\n"
	"Why don't you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}

