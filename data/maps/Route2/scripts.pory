raw `

Route2_EventScript_DiglettsCaveSign::
	msgbox Route2_Text_DiglettsCave, MSGBOX_SIGN
	end
`

mapscripts Route2_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setbench(BENCH_ROUTE1)
		if(flag(FLAG_FOUND_ROTOM_MOW) || !flag(FLAG_SYS_ROTOM_MENU)) {
			setflag(FLAG_TEMP_1)
		}
	}
}
script Route2_EventScript_CeliaGrass {
	msgbox("I had to remove the grass here to\nlet Mr. Mime spawn over there.\pIt's not like there's anything of\nnote here in vanilla anyway.", MSGBOX_NPC)
	end
}

script Route2_MowedGrass {
	msgbox("The grass is newly-trimmed and\ntidy.", MSGBOX_SIGN)
	end
}

script Route2_EventScript_Dad {
	lock
	faceplayer
	textcolor(0)
	if(checkmoncaught(SPECIES_MR_MIME)) {
		msgbox(
		"DAD: {PLAYER}!\n"
		"What are you doing out here?\p"

		"Hey, I just saw you catch one of\n"
		"my sisters in the grass here.\l"
		"Didn't someone want a trade?\p"

		"Well, never mind that.\n"
		"How about you take a rest?", MSGBOX_DEFAULT)
	} elif(var(VAR_ROUTE2_SHINY_MIME) == 1) {
		msgbox("DAD: {PLAYER}!\nWhat are you doing out here?\pHey, did you run into a shiny a\nminute ago?\lWow, you must be lucky!\pWell, never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)
		setvar(VAR_ROUTE2_SHINY_MIME, 2)
	} else {
		msgbox(("DAD: {PLAYER}!\nWhat are you doing out here?\pI'm out here to visit my sisters.\nDon't try to catch them!\lIt won't work!\pWell, never mind that.\nHow about you take a rest?"), MSGBOX_DEFAULT)
	}
	call(EventScript_DadHeal)
	setflag(FLAG_DAD_SISTERS)
	release
	end
}

script Route2_EventScript_CeliaDad {
	msgbox("Mr. Mimes being found in the grass\nhere SIGNIFICANTLY predates\lDAD being a thing.\pI kinda had to retroactively justify\nthem being out here.\pWell, never mind that.\nHow about you take a rest?", MSGBOX_NPC)
	end
}

script Route2_EventScript_RouteSign {
	lock
	msgbox(Route2_Text_RouteSign, MSGBOX_DEFAULT)
	if(!flag(FLAG_CSR_MAP_ROUTE_22)) {
		msgbox("TRAINER TIPS\pDon't forget to head EAST from\nVIRIDIAN CITY and explore ROUTE 22!", MSGBOX_DEFAULT)
	}
	release
}

script Route2_EventScript_RouteSignActual {
	msgbox(Route2_Text_RouteSign, MSGBOX_SIGN)
}

script Route2_North_Sign {
	msgbox("Another job well done.\nThanks for the continued patronage!\l-KANTO Lawn Maintenance Service", MSGBOX_SIGN)
	end
}
 script Route2_DoShinyMime {
	lock
	setflag(FLAG_SHINY_CREATION) //Mime
	setvar(VAR_ROUTE2_SHINY_MIME, 1)
	setwildbattle(SPECIES_MR_MIME, 14, ITEM_NONE)
	clearflag(FLAG_SHINY_CREATION)
	dowildbattle
	release
 }

script Route2_SetShiny {
	setflag(FLAG_SHINY_CREATION) //Mime
	release
}

script Route2_ClearShiny {
	clearflag(FLAG_SHINY_CREATION)
	release

}



script Route2_Rotom {
	lock
	faceplayer
	playmoncry(SPECIES_ROTOM, CRY_MODE_DEFAULT)
	waitmoncry
	applymovement(VAR_LAST_TALKED, moves(
		emote_exclamation_mark
	))
	waitmovement(0)
	delay(60)
	msgbox(
	"It's the KANTO LAWN MAINTENANCE\n"
	"SERVICE!", MSGBOX_DEFAULT)
    closemessage
    fadescreen(FADE_TO_BLACK)
    removeobject(VAR_LAST_TALKED)
    setflag(FLAG_FOUND_ROTOM_MOW)
    fadescreen(FADE_FROM_BLACK)
	release
}