raw `
FourIsland_Mart_MapScripts::
	.byte 0



	.align 2
FourIsland_Mart_Items::
	.2byte ITEM_POKE_BALL
	.2byte ITEM_MAX_ELIXIR
	.2byte ITEM_GROWTH_MULCH
	.2byte ITEM_RICH_MULCH
	.2byte ITEM_ODD_MULCH
	.2byte ITEM_FULL_HEAL
	.2byte ITEM_NONE
	release
	end

FourIsland_Mart_Items_NoOddMulch::
	.2byte ITEM_POKE_BALL
	.2byte ITEM_MAX_ELIXIR
	.2byte ITEM_GROWTH_MULCH
	.2byte ITEM_RICH_MULCH
	.2byte ITEM_FULL_HEAL
	.2byte ITEM_NONE
	release
	end


FourIsland_Mart_EventScript_Camper::
	msgbox FourIsland_Mart_Text_IcefallCaveIsFrigid, MSGBOX_NPC
	end
`

script FourIsland_Mart_EventScript_Clerk {
	goto_if_questlog(EventScript_ReleaseEnd)
	lock
	faceplayer
	message(Text_MayIHelpYou)
	waitmessage
	if(flag(FLAG_FOUR_ISLAND_CANDY)) {
		pokemart(FourIsland_Mart_Items_NoOddMulch)
	} else {
		pokemart(FourIsland_Mart_Items)
	}
	msgbox(Text_PleaseComeAgain)
	release
}