mapscripts Minnesota_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setworldmapflag(FLAG_CSR_MAP_MINNESOTA)
	}
}

script Minnesota_CantSeeFar {
	msgbox(
	"Out to the EAST, there's naught\n"
	"but ocean, far as the eye can see.\p"

	"Granted,{PAUSE 30} I can't see very far.{PAUSE 30}\n"
	"But still!", MSGBOX_NPC)
}

script Minnesota_EastSign {
	msgbox(
	"EAST {RIGHT_ARROW}\n"
	"{PAUSE 30}WEST", MSGBOX_SIGN)

}

script Minnesota_SanDiegoZooGirl {
	msgbox(
	"Ah, I love visiting MINNESOTA's\n"
	"famous SAN DIEGO ZOO!\l"
	"It's such a gift to live here!", MSGBOX_NPC)
}


script Minnesota_SanDiegoZoo {
	msgbox(
	"SAN DIEGO ZOO\n"
	"", MSGBOX_SIGN)

}


script Minnesota_SanDiegoZoo_SealSign {
	msgbox(
	"WARNING!\p"

	"A dangerous wild ANIMAL has\n"
	"escaped its cage!\p"

	"Patrons are advised to scream\n"
	"while running in circles.\l"
	"Raising your arms will also help.", MSGBOX_SIGN)

}

script Minnesota_SanDiegoZoo_SealCage {
	msgbox(
	"Hmm, it seems the cage has been\n"
	"unsealed.", MSGBOX_SIGN)

}


script Minnesota_SanDiegoZoo_BillionLionsGirl {
	msgbox(
	"Between this and the billion lions\n"
	"that got stolen last week?\l"
	"We really need to get better locks.", MSGBOX_NPC)
}


script Minnesota_SanDiegoZoo_IndianElephantSign {
	msgbox(
	"Warning!\p"

	"This animal was found guilty of\n"
	"heinous crimes, and as such was\l"
	"sentenced to death.", MSGBOX_SIGN)

}

script MinnesotaZoo_IndianElephantCage {
	lock
	msgbox(
	"INDIAN ELEPHANT\n"
	"", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	msgbox(
	"The cage is empty…\n"
	"", MSGBOX_DEFAULT)
	release
}

script MinnesotaZoo_CagedDad {
	lock
	faceplayer
	textcolor(0)
	msgbox(
	"DAD: {PLAYER}!\n"
	"What are you doing out here?\p"

	"After a part-time gig at the FUSHCIA\n"
	"CITY ZOO, I found this new one.\l"
	"This cage is much smaller, though…\p"

	"Well, never mind that.\n"
	"How about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}

script MinnesotaZoo_FirstCage {
	msgbox(
	"MONGOOSE\n"
	"{PAUSE 30}The sworn enemy of VIPER", MSGBOX_SIGN)

}

script MinnesotaZoo_ZooBat {
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox(
	"Oh, cool!\n"
	"It's a Zoo Bat!", MSGBOX_NPC)
}



script MinnesotaZoo_FirstViking {
	textcolor(NPC_TEXT_COLOR_MALE)
	msgbox(
	"Welcome to MINNESOTA.\n"
	"We're the VIKINGS!\p"

	"We aim to explore and conquer\n"
	"far-off lands!\l"
	"SKOL!", MSGBOX_NPC)
}

script MinnesotaZoo_NoHorns {
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox(
	"…What's that?\n"
	"The HORNS are anachronistic?\p"

	"Oh c'mon, man!\n"
	"Just let us have some fun!", MSGBOX_NPC)
}

script Minnesota_FootballPlayer {
	textcolor(NPC_TEXT_COLOR_MALE)
	msgbox(
	"Welcome to MINNESOTA.\n"
	"I'm a FOOTBALL PLAYER!\p"

	"…What's that?\n"
	"The VIKINGS?\l"
	"Nah, we're the GOLDEN GOPHERS.\p"

	"The VIKINGS are on the other side\n"
	"of town!", MSGBOX_NPC)
}

script Minnesota_Townsign {
	msgbox(
	"MINNESOTA\n"
	"One fiftyith of the freest country!\l"
	"NEW WILD POKéMON: 1", MSGBOX_SIGN)

}

script Minnesota_Pittsburg {
	msgbox(
	"Welcome to PITTSBURG!\n"
	"", MSGBOX_SIGN)

}

script Minnesota_NPC {
	msgbox(
	"Hey, neighbor!\p"

	"I'm just out here for a walk with\n"
	"my mom's dog.\l"
	"He's such a good boy!", MSGBOX_NPC)
}

script Minnesota_MomsDog {
	lock
	faceplayer
	msgbox(
	"Marron: Rrrruh!\n"
	"", MSGBOX_DEFAULT)
	showmonpic(SPECIES_HERDIER, 10, 3)
	waitbuttonpress
	hidemonpic
	closemessage
	delay(30)
	msgbox(
	"Wow!\n"
	"He's outstanding!", MSGBOX_DEFAULT)
	release
}

script Minnesota_SurgeHouseSign {
	msgbox(
	"LT. SURGE'S House\n"
	"", MSGBOX_SIGN)

}


script Minnesota_LookedThroughTrubbish {
	lock
	faceplayer
	if(flag(FLAG_TEMP_1)) {
		msgbox(
		"Nope!\n"
		"Nothing but trash!", MSGBOX_DEFAULT)
		release
		end
	}
	msgbox(
	"{PLAYER} looked through the\n"
	"trash…\p"

	"Hey!\n"
	"There's a secret switch!\l"
	"Let's press it!", MSGBOX_DEFAULT)
	playse(SE_CLICK)
	setflag(FLAG_TEMP_1)
	setlayouttiles(LAYOUT_MINNESOTA_HOUSE1_BEAM_OFF, 0, 0, 0, 0, 23, 19)
	waitse
	closemessage
	release
	end
}

script Minnesota_LookedThroughTrash {
	msgbox(
	"Nope!\n"
	"Nothing but trash!", MSGBOX_SIGN)

}


script Minnesota_LaundromatSign {
	msgbox(
