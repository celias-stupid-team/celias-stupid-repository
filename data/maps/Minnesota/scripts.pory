script Minnesota_ReleasedZubats {
	faceplayer
	playmoncry(SPECIES_ZUBAT, CRY_MODE_DEFAULT)
	msgbox(
	"Oh, wow!\n"
	"It's more ZOO BATS!", MSGBOX_DEFAULT)
	waitmoncry
	release
	end
}
script Minnesota_ReleasedHbox {
	faceplayer
	playmoncry(SPECIES_JIGGLYPUFF, CRY_MODE_DEFAULT)
	waitmoncry
	release
	end
}

script Minnesota_ReleasedShinyZubats {
	specialvar(VAR_RESULT, GetPlayerFacingDirection)
	if(var(VAR_RESULT) != DIR_SOUTH) {
		faceplayer
		playmoncry(SPECIES_ZUBAT, CRY_MODE_DEFAULT)
		waitmoncry
		msgbox(
		"Waiiit a second!\n"
		"That's not a normal ZUBAT!", MSGBOX_DEFAULT)
		setflag(FLAG_SHINY_CREATION)
		removeobject(VAR_LAST_TALKED)
		setflag(FLAG_GOT_SHINY_ZUBAT)
		playfanfare(MUS_LEVEL_UP)
		setvar(VAR_CSR_GIFT_POKEMON, SPECIES_ZUBAT)
		msgbox(
		"{PLAYER} got a special ZUBAT!\n"
		"", MSGBOX_DEFAULT)
		call(Common_Script_GiftPokemon)
		release
		end

	} else {
		goto(Minnesota_ReleasedZubats)
	}

	release
	end
}