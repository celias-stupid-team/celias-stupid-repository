mapscripts Minnesota_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setworldmapflag(FLAG_CSR_MAP_MINNESOTA)
		setflag(FLAG_TEMP_5)
		setflag(FLAG_TEMP_A)
		setflag(FLAG_TEMP_B)
		if(flag(FLAG_RELEASED_ZUBAT)) {
			clearflag(FLAG_TEMP_A)
			setflag(FLAG_TEMP_C)
			if(!flag(FLAG_GOT_SHINY_ZUBAT)) {
				clearflag(FLAG_TEMP_B)
			}
		}
		if(flag(FLAG_SYS_ROTOM_MENU)) {
			
			
		} else {
			if(checkpartymove(MOVE_SURF) == PARTY_SIZE && checkpartymove(MOVE_FLY) == PARTY_SIZE) {
				clearflag(FLAG_TEMP_5)
			}
		}
		if(!flag(FLAG_SENT_BIKER_FLYING)) {
			setflag(FLAG_TEMP_6)
		}
		if(!flag(FLAG_FOUND_Y)) {
			setflag(FLAG_TEMP_7)
		}
		if(!flag(FLAG_REUNITED_HAKARI_AND_BLIZ)) {
			setflag(FLAG_TEMP_8)

		}
		setflag(FLAG_TEMP_9)
	}
}

script Minnesota_Softlock {
	lock
	faceplayer
	if(flag(FLAG_TEMP_3)) {
		playse(SE_PC_LOGIN)
		msgbox(
		"{PLAYER} kicked the CELIA.\n"
		"", MSGBOX_DEFAULT)
		goto(EventScript_PCMainMenu)

	}
	msgbox(
	"Hi!\n"
	"It's me, CELIA!\p"

	"It seems you've been trying to\n"
	"softlock yourself here.\l"
	"Whoopsies!\p"

	"Don't worry!\n"
	"I got you covered.\p"

	"Here, take this!\n"
	"", MSGBOX_DEFAULT)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	giveitem_msg("{PLAYER} was given some\nfree McDONALD's!", ITEM_RAW_NUGGET)
	waitfanfare
	closemessage
	delay(20)
	textcolor(NPC_TEXT_COLOR_RED)
	msgbox(
	"And you might need this too!\n"
	"", MSGBOX_DEFAULT)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	giveitem_msg("{PLAYER} also got a\nRARE CANDY!",ITEM_RARE_CANDY)
	textcolor(NPC_TEXT_COLOR_RED)
	msgbox(
	"And finally…!\n"
	"", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	setflag(FLAG_TEMP_3)
	playse(SE_PC_LOGIN)
	msgbox(
	"{PLAYER} kicked the CELIA.\n"
	"", MSGBOX_DEFAULT)
	goto(EventScript_PCMainMenu)
}

