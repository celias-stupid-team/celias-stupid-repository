script Minnesota_MomsDog {
	lock
	faceplayer
	msgbox(
	"Marron: Rrrruh!\n"
	"", MSGBOX_DEFAULT)
	showmonpic(SPECIES_HERDIER, 10, 3)
	waitbuttonpress
	hidemonpic
	closemessage
	delay(30)
	msgbox(
	"Wow!\n"
	"He's outstanding!", MSGBOX_DEFAULT)
	release
}

script Minnesota_SurgeHouseSign {
	msgbox(
