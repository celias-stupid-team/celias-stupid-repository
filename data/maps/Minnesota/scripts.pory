script Minnesota_LookedThroughTrubbish {
	lock
	faceplayer
	if(flag(FLAG_TEMP_1)) {
		msgbox(
		"Nope!\n"
		"Nothing but trash!", MSGBOX_DEFAULT)
		release
		end
	}
	msgbox(
	"{PLAYER} looked through the\n"
	"trash…\p"

	"Hey!\n"
	"There's a secret switch!\l"
	"Let's press it!", MSGBOX_DEFAULT)
	playse(SE_CLICK)
	setflag(FLAG_TEMP_1)
	setlayouttiles(LAYOUT_MINNESOTA_HOUSE1_BEAM_OFF, 0, 0, 0, 0, 23, 19)
		setmaplayoutindex(LAYOUT_MINNESOTA_HOUSE1_BEAM_OFF)
	waitse
	closemessage
	release
	end
}

