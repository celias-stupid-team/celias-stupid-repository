mapscripts Minnesota_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setflag(FLAG_CSR_MAP_MINNESOTA)
	}
}

script Minnesota_CantSeeFar {
	msgbox(
	"Out to the EAST, there's naught\n"
	"but ocean, far as the eye can see.\p"

	"Granted, I can't see very far.{PAUSE 30}\n"
	"But still!", MSGBOX_NPC)
}

script Minnesota_EastSign {
	msgbox(
	"EAST {RIGHT_ARROW}\n"
	"{PAUSE 30}WEST", MSGBOX_SIGN)

}

script Minnesota_SanDiegoZooGirl {
	msgbox(
	"Ah, I love visitng MINNESOTA's\n"
	"famous SAN DIEGO ZOO!\l"
	"It's such a gift to live here!", MSGBOX_NPC)
}


script Minnesota_SanDiegoZoo {
	msgbox(
	"SAN DIEGO ZOO\n"
	"", MSGBOX_SIGN)

}


script Minnesota_SanDiegoZoo_SealSign {
	msgbox(
	"WARNING!\p"

	"A dangerous wild ANIMAL has\n"
	"escaped its cage!\p"

	"Patrons are advised to run in\n"
	"circles while screaming.\l"
	"Preferably with arms in the air!", MSGBOX_SIGN)

}

script Minnesota_SanDiegoZoo_SealCage {
	msgbox(
	"Hmm, it seems the cage has been\n"
	"unsealed.", MSGBOX_SIGN)

}


script Minnesota_SanDiegoZoo_BillionLionsGirl {
	msgbox(
	"Between this and the billion lions\n"
	"that got stolen last week, this zoo\l"
	"really needs to get better locks.", MSGBOX_NPC)
}


script Minnesota_SanDiegoZoo_IndianElephantSign {
	msgbox(
	"Warning!\p"

	"This animal was found guilty of\n"
	"heinous crimes, and as such was\l"
	"sentenced to death.", MSGBOX_SIGN)

}

script MinnesotaZoo_IndianElephantCage {
	lock
	msgbox(
	"INDIAN ELEPHANT\n"
	"", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	msgbox(
	"The cage is empty…\n"
	"", MSGBOX_DEFAULT)
	release
}

script MinnesotaZoo_CagedDad {
	lock
	faceplayer
	textcolor(0)
	msgbox(
	"DAD: {PLAYER}!\n"
	"What are you doing out here?\p"

	"After a part-time gig at the\n"
	"FUSHCIA CITY ZOO, I found a new one.\l"
	"This cage is much smaller, though…\p"

	"Well, never mind that.\n"
	"How about you take a rest?", MSGBOX_DEFAULT)
	call(EventScript_DadHeal)
	release
	end
}

script MinnesotaZoo_FirstCage {
	msgbox(
	"SOME ANIMAL\n"
	"(placeholder)", MSGBOX_SIGN)

}


script MinnesotaZoo_FirstViking {
	msgbox(
	"Welcome to MINNESOTA.\n"
	"We're the VIKINGS!\p"

	"We aim to explore and conquer\n"
	"far-off lands!\l"
	"SKOL!", MSGBOX_NPC)
}

script MinnesotaZoo_NoHorns {
	msgbox(
	"…What's that?\n"
	"The HORNS are anachronistic?\p"

	"Oh c'mon, man!\n"
	"Just let us have some fun!", MSGBOX_NPC)
}

script Minnesota_FootballPlayer {
	msgbox(
	"Welcome to MINNESOTA.\n"
	"I'm a FOOTBALL PLAYER!\p"

	"…What's that?\n"
	"The VIKINGS?\l"
	"Nah, we're the GOLDEN GOPHERS.\p"

	"The VIKINGS are on the other side\n"
	"of town!", MSGBOX_NPC)
}

script Minnesota_Townsign {
	msgbox(
	"MINNESOTA\n"
	"One fiftyith of the freest country!\l"
	"NEW WILD POKéMON: 1", MSGBOX_SIGN)

}

script Minnesota_NPC {
	msgbox(
	"Minnesota town\n"
	"placeholder", MSGBOX_NPC)
}
