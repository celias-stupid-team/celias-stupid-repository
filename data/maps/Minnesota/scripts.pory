script Minnesota_Bliz {
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_BLUE)
	if(flag(FLAG_TM25_GOT)) {
		
		msgbox(
		"HAKARI: So, uh…\n"
		"", MSGBOX_DEFAULT)
		applymovement(LOCALID_MINNESOTA_HAKARI, moves(
			face_left
		))
		msgbox(
		"Where are we, anyway?\n"
		"", MSGBOX_DEFAULT)
		applymovement(LOCALID_MINNESOTA_BLIZ, moves(
			face_right
		))
		msgbox(
		"BLIZ: Minnesota.\n"
		"", MSGBOX_DEFAULT)
		applymovement(LOCALID_MINNESOTA_HAKARI, moves(
			walk_in_place_left * 2
		))
		msgbox(
		"HAKARI: … … …\p"

		"I'm divorcing you again.\n"
		"", MSGBOX_DEFAULT)
		release
		end
	}
	if(flag(FLAG_REUNITED_HAKARI_AND_BLIZ)) {
		msgbox(
		"HAKARI: Are you ready to fight us?\n"
		"We're not gonna hold back!", MSGBOX_YESNO)
		if(var(VAR_RESULT)) {
			goto(Minnesota_Battle)
		} else {
			msgbox(
			"BLIZ: No worries, I'll just fast\n"
			"forward until you're ready.", MSGBOX_DEFAULT)
			release
			end

		}
		
	}
	msgbox(
	"BLIZ: I was supposed to meet my\n"
	"husband here, but he hasn't shown\l"
	"up.\p"

	"I wonder where he could be?\n"
	"", MSGBOX_DEFAULT)
	if(checkpartymove(MOVE_RIP_ROARING) != PARTY_SIZE) {
		msgbox(
		"BLIZ: Oh!\n"
		"That's Stephen's favorite move!\l"
		"Did you meet him?\p"

		"Well, if he's not busy, I guess\n"
		"I'll just call him.", MSGBOX_DEFAULT)
		closemessage
		delay(20)
		playse(MUS_SE_KIRBY_PHONE)
		waitse
		specialvar(VAR_RESULT, GetPlayerFacingDirection)
		if(var(VAR_RESULT) == DIR_WEST) {
			applymovement(LOCALID_PLAYER, moves(
				face_up
				lock_facing_direction
				walk_down
				unlock_facing_direction

			))
		}
		delay(30)
		setflag(FLAG_REUNITED_HAKARI_AND_BLIZ)
		playse(SE_M_DIG)
		addobject(LOCALID_DIGGING_HAKARI)
		applymovement(LOCALID_DIGGING_HAKARI, moves(
			walk_in_place_left * 3
		))
		waitmovement(0)
		playse(SE_M_DIG)
		applymovement(LOCALID_DIGGING_HAKARI, moves(
			walk_in_place_up * 3
		))
		waitmovement(0)
		playse(SE_M_DIG)
		applymovement(LOCALID_DIGGING_HAKARI, moves(
			walk_in_place_down * 3
		))
		waitmovement(0)
		removeobject(LOCALID_DIGGING_HAKARI)
		addobject(LOCALID_MINNESOTA_HAKARI)
		playse(SE_LEDGE)
		applymovement(LOCALID_MINNESOTA_HAKARI, moves(
			jump_in_place_down
		))
		waitmovement(0)
		delay(30)
		applymovement(LOCALID_MINNESOTA_HAKARI, moves(
			face_left
		))
		msgbox(
		"HAKARI: It's my BOY!\p"

		"Sorry, I completely forgot that we\n"
		"lived on different continents.", MSGBOX_DEFAULT)
		applymovement(LOCALID_MINNESOTA_BLIZ, moves(
			face_right
		))
		msgbox(
		"BLIZ: I love you, you dumbass.\n"
		"", MSGBOX_DEFAULT)
		applymovement(LOCALID_MINNESOTA_HAKARI, moves(
			walk_in_place_left * 2
		))
		msgbox(
		"HAKARI: divorce\n"
		"", MSGBOX_DEFAULT)
		closemessage
		delay(20)
		applymovement(LOCALID_MINNESOTA_BLIZ, moves(
			face_down
		))
		applymovement(LOCALID_MINNESOTA_HAKARI, moves(
			face_down
		))
		msgbox(
		"HAKARI: Thanks for that!\n"
		"Now we can finally put together\l"
		"our all-star doubles team.\p"

		"Are you ready to fight us?\n"
		"We're not gonna hold back!", MSGBOX_YESNO)
		if(var(VAR_RESULT)) {
			goto(Minnesota_Battle)

		} else {
			msgbox(
			"BLIZ: No worries, I'll just fast\n"
			"forward until you're ready.", MSGBOX_DEFAULT)
			release
			end
		}


	}
	release
}

script Minnesota_Battle {
		msgbox(
		"BLIZ: Alright then, let's get into\n"
		"it!\p"

		"HAKARI: Get ready to face the\n"
		"onslaught of our…\p"

		"BOTH: FUNNY!{PAUSE 30} LITTLE!{PAUSE 30} GUYS!!!\n"
		"", MSGBOX_DEFAULT)
		trainerbattle_no_intro(TRAINER_HAKARI_BLIZ, 
		
		"HAKARI: Damn… I guess YOU were\nthe funniest little guy all along!\pBLIZ: We have been shown who is\nthe boss…")
		msgbox(
		"HAKARI: Well, I already gave you\n"
		"my secret technique, so here.\l"
		"Take this.\p"

		"I won't be needing it anymore now\n"
		"that you've reunited us.", MSGBOX_DEFAULT)
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		giveitem_msg("{PLAYER} was given TM25!\nIt contains DIG.", ITEM_TM25)
		setflag(FLAG_TM25_GOT)
		textcolor(NPC_TEXT_COLOR_BLUE)
		msgbox(
		"HAKARI: So, uh…\n"
		"", MSGBOX_DEFAULT)
		applymovement(LOCALID_MINNESOTA_HAKARI, moves(
			face_left
		))
		msgbox(
		"Where are we, anyway?\n"
		"", MSGBOX_DEFAULT)
		applymovement(LOCALID_MINNESOTA_BLIZ, moves(
			face_right
		))
		msgbox(
		"BLIZ: Minnesota.\n"
		"", MSGBOX_DEFAULT)
		applymovement(LOCALID_MINNESOTA_HAKARI, moves(
			walk_in_place_left * 2
		))
		msgbox(
		"HAKARI: … … …\p"

		"I'm divorcing you again.\n"
		"", MSGBOX_DEFAULT)
		release
		end

}

