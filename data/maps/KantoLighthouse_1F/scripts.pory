mapscripts KantoLighthouse_1F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        clearflag(FLAG_CSR_CAUGHT_AMPHAROS)
        setflag(FLAG_CSR_MAP_KANTO_LIGHTHOUSE)
    }
    MAP_SCRIPT_ON_LOAD {
        if(flag(FLAG_LIGHTHOUSE_FALLING_FROM_ABOVE)) {
            setmetatile(11, 4, 0x32A, FALSE)
            setvar(VAR_TEMP_1, 1)
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_1, 1 {
            playse(SE_PIN)
            applymovement(WONDER_KID, Common_Movement_ExclamationMark)
            delay(60)
            applymovement(LOCALID_PLAYER, Common_Movement_FaceLeft)
            textcolor(NPC_TEXT_COLOR_BLUE)
            msgbox("Wowwie!\pI've never gotten THAT from\nWonder Trade before!", MSGBOX_DEFAULT)
            closemessage
            setvar(VAR_TEMP_1, 0)
        }
    ]
}

script KantoLighthouse_1F_OldMan {
    lock
    faceplayer
	msgbox("Ah, finally the power is back\non!\pI've been waiting here before\nmaking the climb up.\lI wouldn't want to trip and fall!\pHo!\nThat'd be rather nasty indeed!\pWell, off I go.\nMeet you at the top?", MSGBOX_DEFAULT)
    closemessage
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    if(var(VAR_RESULT) == DIR_SOUTH) {
        applymovement(LOCALID_PLAYER, PlayerGetsOutOfWay)
        delay(20)
    }
    applymovement(VAR_LAST_TALKED, LighthouseMan)
    waitmovement(VAR_LAST_TALKED)
    removeobject(VAR_LAST_TALKED)
    playse(SE_EXIT)
    setflag(FLAG_LIGHTHOUSE_OLD_MAN)
    delay(30)
    release
}

movement PlayerGetsOutOfWay {
    walk_left
    face_right
}

movement LighthouseMan {
    walk_up * 3
    face_up
    delay_16
}

script GTS_Attendant {
	msgbox("Hello!\nWelcome to the GLOBAL TRADE SYSTEM! \pThe LIGHTHOUSE wasn't doing well\nfor tourism, so we traded it away.\lI hope you enjoy our services!\n", MSGBOX_NPC)
	end
}


script GTS_AngryNerdJim {
    trainerbattle_single(TRAINER_ANGRY_NERD_ANDREW, "Grr…\pI hate all these people different\nthan me!", "Grumble grumble…\n")
    msgbox("Grumble grumble…\n", MSGBOX_NPC)
}

script GTS_LowLevelGuy {
    lock
    if(flag(FLAG_DID_AMPHAROS_TRADE)) {
        msgbox("Hmm, looks like there's no\ntrade today.\lDarn!", MSGBOX_DEFAULT)
    } else {
        msgbox("You're asking for a…\nlevel 9 JIRACHI?\pYeah, okay bud.\n", MSGBOX_DEFAULT)
    }
    release
}

script GTS_TradeSpot {
	msgbox("OFFER: Level 80 CATERPIE{PAUSE 30}\nREQUESTED: BUTTERFREE {PAUSE 30}(Any Level)\pTrainer's Note:{PAUSE 30}\nHOw do you beat brock??", MSGBOX_SIGN)
	end
}


script GTS_TradeSpot_Secret {
    lock
    if(flag(FLAG_DID_AMPHAROS_TRADE)) {
        msgbox("Thank you!\n", MSGBOX_DEFAULT)
        release
        end
    }
	msgbox("OFFER: Level 30 AMPHAROS{PAUSE 60}\nREQUESTED: JIRACHI\lLevel 9 or lower", MSGBOX_DEFAULT)
    closemessage
    special(ChoosePartyMon)
    waitstate
    if(var(VAR_0x8004) >= PARTY_SIZE) {
        release
        end
    }
    specialvar(VAR_RESULT, ScriptGetPartyMonSpecies)
    if(var(VAR_RESULT) == SPECIES_JIRACHI) {
        specialvar(VAR_RESULT, ScriptGetPartyMonLevel)
        if(var(VAR_RESULT) <= 9) {
            msgbox("{PLAYER} offered a TRADE!\n", MSGBOX_DEFAULT)
            closemessage
            setvar(VAR_0x8008, INGAME_TRADE_JIRACHI)
            setflag(FLAG_DID_AMPHAROS_TRADE)
            call(EventScript_DoInGameTrade)
            msgbox("Thank you!\n", MSGBOX_DEFAULT)
            release
            end
        } else {
            playse(SE_BOO)
            msgbox("Error: Does not match request.\nTrade declined.", MSGBOX_DEFAULT)
            waitse
            release
            end

        }
    } else {
        playse(SE_BOO)
        msgbox("Error: Does not match request.\nTrade declined.", MSGBOX_DEFAULT)
        waitse
        release
        end
    }
}


script GTS_TradeScammer_Left {
    lock
    faceplayer
    if(flag(FLAG_TALKED_TO_LEFT_SCAMMER)) {
        msgbox("Hey, you!\nWanna pull our little scam?", MSGBOX_YESNO)
        if(var(VAR_RESULT)) {
            goto(GTS_LeftScammerMeat)
        } else {
            msgbox("Aww…\nYou're no fun.", MSGBOX_DEFAULT)
	        goto(GTS_Scammers_ReleaseEnd)

        }
    } else {
        if(flag(FLAG_TALKED_TO_RIGHT_SCAMMER)) {
            msgbox("Hey, you!\nListen here!\pI got a great scam going.\nYou want in?\p…Huh?\nYou've heard this pitch before?\lNonsense!\pNow come on.\nAre you in or not?", MSGBOX_YESNO)
            if(var(VAR_RESULT)) {
                goto(GTS_LeftScammerMeat)
            } else {
                msgbox("Aww…\nYou're no fun.", MSGBOX_DEFAULT)
                goto(GTS_Scammers_ReleaseEnd)
            }
        } else {
            msgbox("Hey, you!\nListen here!\pI wanna scam someone out of a good\ntrade.\lWe'll both make out like bandits!\pWhaddya say?\nAre you in?", MSGBOX_YESNO)
            if(var(VAR_RESULT)) {
                
                setflag(FLAG_TALKED_TO_LEFT_SCAMMER)
                msgbox("Sick - Here's the plan:\pYou give me some POKéMON, doesn't\nmatter which.\pThen, I'll tell people that it's\nextremely rare and valuable.\lThat way, we get high-value offers!\pWhen all's said and done, we'll\nget something awesome out of it!\lHow about it?", MSGBOX_YESNO)
                if(var(VAR_RESULT)) {
                    goto(GTS_LeftScammerMeat)
                }

            } else {
                msgbox("Aww…\nYou're no fun.", MSGBOX_DEFAULT)
	            goto(GTS_Scammers_ReleaseEnd)
            }
           
        }
    }
	goto(GTS_Scammers_ReleaseEnd)
}

script GTS_LeftScammerMeat {
    
    specialvar(VAR_RESULT, CountPartyNonEggMons)
	if(var(VAR_RESULT) == 1) {
        msgbox("Hehehe…\nThat's great to hear!\lBut…\pYou only have one POKéMON with\nyou! You'll need another.\pGo grab one and come back!\n", MSGBOX_DEFAULT)
        goto(GTS_Scammers_ReleaseEnd)
    }
    msgbox("Heheh…\nThat's great to hear!\lNow, gimme a POKéMOn…", MSGBOX_DEFAULT)
	fadescreen(FADE_TO_BLACK)
	special(ChooseSendDaycareMon)
	waitstate
	if(var(VAR_0x8004) >= PARTY_SIZE) {
        msgbox("What, you're not in?\nGimme a break!\pFine.\nCome back if you change your mind.", MSGBOX_DEFAULT)
        goto(GTS_Scammers_ReleaseEnd)
    }
	specialvar(VAR_RESULT, CountPartyAliveNonEggMons_IgnoreVar0x8004Slot)
	if(var(VAR_RESULT) == 0) {
        msgbox("Hey!\nEverything else you have is dead!\pThis is a really obscure text box.\nGood job finding it!", MSGBOX_DEFAULT)
        goto(GTS_Scammers_ReleaseEnd)
    }
	specialvar(VAR_0x8005, GetSelectedMonNicknameAndSpecies)
	waitse
	playmoncry(VAR_0x8005, CRY_MODE_NORMAL)
	waitmoncry
	specialvar(VAR_RESULT, GetDaycareState) //Use this to check in advance
    //I gotta make sure this whole chunk isn't accessed if this NPC in particular has a Pokemon stored with him
    //And then figure out what to do about if there's the other guy
    //Cuz I need to make sure you're withdrawing the right mon from the right NPC

    if(var(VAR_RESULT) == DAYCARE_ONE_MON) { //if there's already a trade waiting over there
        // Store the current mon in the daycare
	    special(StoreSelectedPokemonInDaycare)
        
        // And set a flag so when you check the other day care guy, you can withdraw
        setflag(FLAG_LEFT_SCAMMER_HAS_MON)
        setflag(FLAG_LEFT_SCAMMER_RECIEVED_MON)
        clearflag(FLAG_RIGHT_SCAMMER_HAS_MON)
        // Withdraw the other mon, with text saying "Looks like we got one"
        msgbox("Looks like we got one!\n(placeholder)", MSGBOX_DEFAULT)
        setvar(VAR_0x8004, 0)
        specialvar(VAR_RESULT, TakePokemonFromDaycare)
        waitse
        playmoncry(VAR_RESULT, CRY_MODE_NORMAL)
        textcolor(NPC_TEXT_COLOR_NEUTRAL)
        msgbox("{PLAYER} got the illicitly-acquired\n{STR_VAR_1}!", MSGBOX_DEFAULT)
        textcolor(NPC_TEXT_COLOR_MALE)
        waitmoncry
        msgbox("bye\n", MSGBOX_DEFAULT)
        
        //check species of other mon
        call(GTS_Scammers_CheckIfComplimentaryMon) 

        // if other species is right, then trigger the evolution
        //saved in Flag Temp 3

        // and set another flag so the other side knows to evolve too
        if(flag(FLAG_TEMP_3)) {
            //evolve your Pokemon
            msgbox("temp 3")
            setflag(FLAG_OTHER_SCAMMER_READY_TO_EVOLVE)
            getpartysize
            copyvar(VAR_0x8000, VAR_RESULT)
            setvar(VAR_0x8001, 0)
            setvar(VAR_0x8002, FALSE)
            callnative(EvolvePartyMon)

        }

        // while you haven't withdrawn the other side, 
    } else {
	    special(StoreSelectedPokemonInDaycare)
        copyvar(VAR_FIRST_TRADED_MON_SPECIES, VAR_0x8005)
        msgbox("put first mon in\n", MSGBOX_DEFAULT)

    }
	goto(GTS_Scammers_ReleaseEnd)
}

script GTS_SetMachineTop {
    setmetatile(11, 4, 0x31B, FALSE)
    special(DrawWholeMapView)
    setvar(VAR_TEMP_0, 1)
    release
}

script GTS_TradeScammer_Right {
    lock
    faceplayer
    if(flag(FLAG_RIGHT_SCAMMER_HAS_MON)) {
        msgbox("I have a mon\n(placeholder)", MSGBOX_DEFAULT)
        applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
        waitmovement(0)
        release
        end
    }
    if(flag(FLAG_TALKED_TO_RIGHT_SCAMMER)) {
        msgbox("Hey, you!\nWanna pull our little scam?", MSGBOX_YESNO)
        if(var(VAR_RESULT)) {
            goto(GTS_RightScammerMeat)
        } else {
            msgbox("Aww…\nYou're no fun.", MSGBOX_DEFAULT)
            release
        }
    } else {
        if(flag(FLAG_TALKED_TO_LEFT_SCAMMER)) {
            msgbox("Hey, you!\nListen here!\pI got a great scam going.\nYou want in?\p…Huh?\nYou've heard this pitch before?\lNonsense!\pNow come on.\nAre you in or not?", MSGBOX_YESNO)
            if(var(VAR_RESULT)) {
                goto(GTS_RightScammerMeat)
            } else {
                msgbox("Aww…\nYou're no fun.", MSGBOX_DEFAULT)
                goto(GTS_Scammers_ReleaseEnd)
            }
        } else {
            msgbox("Hey, you!\nListen here!\pI wanna scam someone out of a good\ntrade.\lWe'll both make out like bandits!\pWhaddya say?\nAre you in?", MSGBOX_YESNO)
            if(var(VAR_RESULT)) {
                
                setflag(FLAG_TALKED_TO_RIGHT_SCAMMER)
                msgbox("Sick - Here's the plan:\pYou give me some POKéMON, doesn't\nmatter which.\pThen, I'll tell people that it's\nextremely rare and valuable.\lThat way, we get high-value offers!\pWhen all's said and done, we'll\nget something awesome out of it!\lHow about it?", MSGBOX_YESNO)
                if(var(VAR_RESULT)) {
                    goto(GTS_RightScammerMeat)
                }

            } else {
                msgbox("Aww…\nYou're no fun.", MSGBOX_DEFAULT)
                goto(GTS_Scammers_ReleaseEnd)
            }
           
        }
    }
    goto(GTS_Scammers_ReleaseEnd)
}


