script GTS_Scammers_CheckIfComplimentaryMon {
    clearflag(FLAG_TEMP_3)
    if((var(VAR_RESULT) == SPECIES_GRAVELER && var(VAR_FIRST_TRADED_MON_SPECIES) == SPECIES_MACHOKE) || (var(VAR_RESULT) == SPECIES_MACHOKE && var(VAR_FIRST_TRADED_MON_SPECIES) == SPECIES_GRAVELER)) {
        setflag(FLAG_TEMP_3)
    }
    return
}

script GTS_Scammers_ReleaseEnd {
    closemessage
    applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    release
}

script GTS_WonderTradeKid {
    lock
    setmetatile(11, 4, 0x32A, FALSE)
    special(DrawWholeMapView)
    faceplayer
    msgbox("wonder trade joke\n", MSGBOX_DEFAULT)
    closemessage
    applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
    delay(30)
    applymovement(POKEBALL, WonderTradeBallUp)
    delay(16)
    playse(SE_WARP_OUT)
    waitmovement(0)
    delay(30)
    playse(SE_WARP_IN)
    applymovement(POKEBALL, WonderTradeBallDown)
    waitmovement(0)
    delay(30)
    msgbox("oh no caterpie\n", MSGBOX_DEFAULT)
    setmetatile(11, 4, 0x31B, FALSE)
    special(DrawWholeMapView)
    release
}

movement WonderTradeBallUp {
    set_visible
    delay_16
    walk_fast_up * 6
}


movement WonderTradeBallDown {
    set_visible
    walk_fast_down * 6
}