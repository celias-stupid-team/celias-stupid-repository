mapscripts GreatBay_SkyPillarOutside_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if(!flag(FLAG_HIDE_BIRTH_ISLAND_METEORITE)) {
            setflag(FLAG_TEMP_1)
        }
    }
}

script GreatBay_SkyPillarOutside_LookingOut {
    lock
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    if(var(VAR_RESULT) == DIR_NORTH) {
        applymovement(LOCALID_PLAYER, GreatBay_PlayerMovesIntoPosition)
        waitmovement(0)
        delay(30)
        applymovement(VAR_LAST_TALKED, Common_Movement_FaceRight)

    } else {
        faceplayer
    }
    
    msgbox("Hello, traveller.\nSee that TOWER across the bay?", MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
    applymovement(VAR_LAST_TALKED, Common_Movement_FaceUp)
    delay(20)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, GreatBay_CameraGoesUp)
    waitmovement(0)
    delay(30)
    msgbox("They say that atop the TOWER awaits\na powerful BIRD POKéMON.\lIt comes to roost once a lifetime.", MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_CAMERA, GreatBay_CameraComesDown)
    waitmovement(0)
    if(var(VAR_RESULT) == DIR_SOUTH) {
        applymovement(LOCALID_PLAYER, Common_Movement_FaceDown)
    } else {
        applymovement(LOCALID_PLAYER, Common_Movement_FaceLeft)
        applymovement(VAR_LAST_TALKED, Common_Movement_FaceRight)
    }
    msgbox("The TOWER has been sealed away\nall my life.\lNo one knows what lies inside.\pPerhaps one day, a brave soul will\nventure within.", MSGBOX_DEFAULT)
    special(RemoveCameraObject)
    release
}

movement GreatBay_PlayerMovesIntoPosition {
    walk_right
    walk_up
    face_left
}

movement GreatBay_CameraGoesUp {
    walk_up * 1
    walk_fast_up * 16
    walk_up * 1
}

movement GreatBay_CameraComesDown {
    walk_fast_down * 18
}


script GreatBay_TruckGoesInHole {
    lock
    msgbox(
	"it goes in the square hole\n"
	"", MSGBOX_DEFAULT)
    setflag(FLAG_TRUCK_PUT_IN_HOLE)
    call(GreatBay_OpenDoor)
    release
}


script GreatBay_GirlGoesInHole {
    lock
    msgbox(
	"it goes in the square hole\n"
	"", MSGBOX_DEFAULT)
    setflag(FLAG_GIRL_PUT_IN_HOLE)
    call(GreatBay_OpenDoor)
    release
}


script GreatBay_TriangleGoesInHole {
    lock
    msgbox(
	"it goes in the square hole\n"
	"", MSGBOX_DEFAULT)
    setflag(FLAG_TRIANGLE_PUT_IN_HOLE)
    setflag(FLAG_TEMP_1)
    call(GreatBay_OpenDoor)
    release
}

script GreatBay_OpenDoor {
    if(flag(FLAG_TRIANGLE_PUT_IN_HOLE) && flag(FLAG_GIRL_PUT_IN_HOLE) && flag(FLAG_TRUCK_PUT_IN_HOLE)) {
        msgbox(
        "the door opens\n"
        "", MSGBOX_DEFAULT)
        setflag(FLAG_OPENED_SKY_TOWER)
    }
    return
}