mapscripts GreatBay_SkyPillarOutside_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if(!flag(FLAG_HIDE_BIRTH_ISLAND_METEORITE)) {
            setflag(FLAG_TEMP_1)
        }
        setvar(VAR_TEMP_5, 19)
    }
}

script GreatBay_SkyPillarOutside_LookingOut {
    lock
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    if(var(VAR_RESULT) == DIR_NORTH) {
        applymovement(LOCALID_PLAYER, GreatBay_PlayerMovesIntoPosition)
        waitmovement(0)
        delay(30)
        applymovement(VAR_LAST_TALKED, Common_Movement_FaceRight)

    } elif(var(VAR_RESULT) == DIR_SOUTH) {
        applymovement(LOCALID_PLAYER, moves(
            walk_right
            walk_down
            face_left
        ))
        waitmovement(0)
        delay(30)
        applymovement(VAR_LAST_TALKED, Common_Movement_FaceRight)

    } else {
        faceplayer
    }
    
    msgbox("Hello, traveller.\nSee that TOWER across the bay?", MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
    applymovement(VAR_LAST_TALKED, Common_Movement_FaceUp)
    delay(20)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(
        walk_up * 8
        walk_fastest_up * 20
        walk_up * 5
    ))
    delay(60)
    fadescreenswapbuffers(FADE_TO_BLACK)
    delay(90)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    waitmovement(0)
    delay(60)
    msgbox("They say that atop the TOWER awaits\na powerful BIRD POKéMON.\lIt comes to roost once a lifetime.", MSGBOX_DEFAULT)
    closemessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(
        walk_fastest_down * 33
    ))
    waitmovement(0)
    special(DrawWholeMapView)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    if(var(VAR_RESULT) == DIR_SOUTH) {
        applymovement(LOCALID_PLAYER, Common_Movement_FaceLeft)
    } else {
        applymovement(LOCALID_PLAYER, Common_Movement_FaceLeft)
        applymovement(LOCALID_GREAT_BAY_SKY_PILLAR_OUTSIDE_OLD_MAN_1, Common_Movement_FaceRight)
    }
    textcolor(NPC_TEXT_COLOR_BLUE)
    msgbox("The TOWER has been sealed away\nall my life.\lNo one knows what lies inside.\pPerhaps one day, a brave soul will\nventure within.", MSGBOX_DEFAULT)
    special(RemoveCameraObject)
    release
}

movement GreatBay_PlayerMovesIntoPosition {
    walk_right
    walk_up
    face_left
}

movement GreatBay_CameraGoesUp {
    walk_up * 1
    walk_fast_up * 16
    walk_up * 1
}

movement GreatBay_CameraComesDown {
    walk_fast_down * 18
}


script GreatBay_TruckGoesInHole {
    lock
    waitse
    playse(SE_M_EARTHQUAKE)
    applymovement(VAR_LAST_TALKED, moves(
        walk_in_place_faster_down * 25
    ))
    waitmovement(VAR_LAST_TALKED)
    playse(SE_FALL)
    applymovement(VAR_LAST_TALKED, moves(
        walk_faster_left * 3
    ))
    waitmovement(0)
    delay(20)
    removeobject(VAR_LAST_TALKED)
    delay(60)
    msgbox(
	"The truck went into the square\n"
	"hole.", MSGBOX_DEFAULT)
    setflag(FLAG_TRUCK_PUT_IN_HOLE)
    call(GreatBay_OpenDoor)
    release
}


script GreatBay_GirlGoesInHole {
    lock
    msgbox(
	"it goes in the square hole\n"
	"", MSGBOX_DEFAULT)
    setflag(FLAG_GIRL_PUT_IN_HOLE)
    call(GreatBay_OpenDoor)
    release
}


script GreatBay_TriangleGoesInHole {
    lock
    fadenewbgm(MUS_NONE)
    delay(30)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(
        walk_slow_up * 3
        delay_16 * 3
        walk_faster_left * 10
        delay_16
        walk_fastest_down * 4
    ))
    applymovement(VAR_LAST_TALKED, moves(
        walk_slow_up * 3
        delay_16 * 3
        walk_faster_left * 10
        delay_16
        walk_fastest_down * 4

    ))
    waitmovement(VAR_LAST_TALKED)
    playse(SE_FALL)
    applymovement(VAR_LAST_TALKED, moves(
        walk_fastest_down * 4

    ))
    waitmovement(VAR_LAST_TALKED)
    removeobject(VAR_LAST_TALKED)
    delay(60)
    applymovement(LOCALID_CAMERA, moves(
        walk_right * 10
        walk_up
    ))
    delay(60)
    fadedefaultbgm
    waitmovement(LOCALID_CAMERA)
    special(RemoveCameraObject)
    setflag(FLAG_TRIANGLE_PUT_IN_HOLE)
    setflag(FLAG_TEMP_1)
    call(GreatBay_OpenDoor)
    release
}

script GreatBay_OpenDoor {
    if(flag(FLAG_TRIANGLE_PUT_IN_HOLE) && flag(FLAG_GIRL_PUT_IN_HOLE) && flag(FLAG_TRUCK_PUT_IN_HOLE)) {
        delay(30)
        playse(SE_UNLOCK)
        waitse
        msgbox(
        "A door has opened…\n"
        "", MSGBOX_DEFAULT)
        setflag(FLAG_OPENED_SKY_TOWER)
    }
    return
}

script GreatBay_LookGirl {
	    lock
		msgbox(format("Hmm...\nIs that right..."), MSGBOX_DEFAULT)
		applymovement(VAR_LAST_TALKED, Common_Movement_FacePlayer)
		waitmovement(0)
		playse(SE_PIN)
		applymovement(VAR_LAST_TALKED, DT_exclmark)
		waitmovement(0)
		delay(48)
		msgbox(format("Oh!\nLook, look!"), MSGBOX_DEFAULT)
		closemessage
		switch(var(VAR_FACING)) {
			case DIR_EAST:
                    addvar(VAR_TEMP_5, 1)
					applymovement(VAR_LAST_TALKED, DT_walkbackRight)
					waitmovement(0)
					break
				default:
                    subvar(VAR_TEMP_5, 1)
					applymovement(VAR_LAST_TALKED, DT_walkbackLeft)
					waitmovement(0)
					break
        }
    copyobjectxytoperm(VAR_LAST_TALKED)
    if(var(VAR_TEMP_5) == 2) {
        delay(30)
        playse(SE_FALL)
        removeobject(VAR_LAST_TALKED)
        waitse
        textcolor(NPC_TEXT_COLOR_NEUTRAL)
        msgbox(
        "She went in the square hole.\n"
        "", MSGBOX_DEFAULT)
        release

    }
	release
}



script GreatSea_Buoy_SkyTowerLookGirl {
	lock
	msgbox(
	"It's a buoy…\n"
	"", MSGBOX_DEFAULT)
	signmsg
	msgbox("TRAINER TIPS!\pTalk to her again!", MSGBOX_DEFAULT)

		
	normalmsg
	release
}