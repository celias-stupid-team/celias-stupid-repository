	"the ALTAR OF THE MOON.\p"

	"Legends say if you bring this\n"
	"POKéMON there and hold it up,\l"
	"something incredible may happen.", MSGBOX_NPC)
}



script AetherParadise_RivalOfAether {
	lock
	faceplayer
	famechecker(FAMECHECKER_GREAT_BAY, 1)
	playmoncry(SPECIES_SWELLOW, CRY_MODE_DEFAULT)
	msgbox(
	"Oh, cool!\p"

	"It's a RIVAL of AETHER!\n"
	"", MSGBOX_DEFAULT)
	waitmoncry
	release
}


