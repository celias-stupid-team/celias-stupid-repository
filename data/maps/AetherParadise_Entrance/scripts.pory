script Aether_Trader {
	lock
	faceplayer
	msgbox(
	"I'm trading with my friend to\n"
	"complete my POKéDEX!", MSGBOX_DEFAULT)
	closemessage
	applymovement(VAR_LAST_TALKED, moves(
		face_original_direction
	))
	waitmovement(0)
	release
}

script Aether_Trader2 {
	lock
	msgbox(
	"Okay!\n"
	"Let's trade!", MSGBOX_DEFAULT)
	closemessage
	fadescreenswapbuffers(FADE_TO_BLACK)
	playmoncry(SPECIES_RAICHU, CRY_MODE_DEFAULT)
	waitmoncry
	playse(SE_BALL_TRADE)
	waitse
	delay(30)
	playmoncry(SPECIES_PERSIAN, CRY_MODE_DEFAULT)
	waitmoncry
	setobjectxy(LOCALID_AETHER_RAICHU, 18, 8)
	setobjectxy(LOCALID_AETHER_MEOWTH, 14, 8)
	applymovement(LOCALID_AETHER_RAICHU, moves(
		face_left
	))
	applymovement(LOCALID_AETHER_MEOWTH, moves(
		face_right
	))
	waitmovement(0)
	fadescreenswapbuffers(FADE_FROM_BLACK)
	delay(30)
	msgbox(
	"Wow!\n"
	"Thanks!", MSGBOX_DEFAULT)
	closemessage
	delay(40)
	playse(SE_M_SPIT_UP)
	setobjectxy(LOCALID_AETHER_MEOWTH, 18, 8)
	setobjectxy(LOCALID_AETHER_RAICHU, 14, 8)
	applymovement(LOCALID_AETHER_RAICHU, moves(
		face_right
	))
	applymovement(LOCALID_AETHER_MEOWTH, moves(
		face_left
	))
	delay(40)
	playfanfare(MUS_EVOLVED)
	waitfanfare
	release
	end
}


