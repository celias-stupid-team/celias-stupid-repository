	msgbox(
	"RAINBOW DMCA: Woah!\n"
	"Hey now!\p"

	"I'm one of the good guys!\n"
	"See?\l"
	"I'm okay with GAY people!\p"

	"…{PAUSE 30}But you'd still better not\n"
	"be infringing copyright!", MSGBOX_NPC)
}


