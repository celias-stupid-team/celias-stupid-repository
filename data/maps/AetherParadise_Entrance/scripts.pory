mapscripts AetherParadise_Entrance_MapScripts {
        MAP_SCRIPT_ON_TRANSITION {
        if(checkitem(ITEM_NEBBY)) { // Outside of Aether, make On Frame Table script for Nebby, then after two failed attempts do early nebby
            setvar(VAR_TEMP_9, 1)
        }
		if(flag(FLAG_DMCA_SKULL_FIGHT_1)) {
			setvar(VAR_TEMP_0, 1)
		}
		if(flag(FLAG_DMCA_SKUNTANK_FIGHT_COMPLETED)) {
			setvar(VAR_TEMP_0, 2)
			setbench(BENCH_AETHER_PARADISE)
		}
		setrespawn(HEAL_LOCATION_AETHER_PARADISE_ENTRANCE)

    }
}

script AetherParadise_SkuntankHint {
	msgbox("
	TRAINER TIPS\p

	Some POKéMON have not had their\n
	types altered in this hack.\p

	SKUNTANK, for instance, is\n
	DARK/POISON-TYPE.", MSGBOX_SIGN)

}

script AetherParadise_Guzma {
	textcolor(NPC_TEXT_COLOR_BLUE)
	famechecker(FAMECHECKER_GREAT_BAY, 1)
	msgbox(
	"GUZMA: Those phoney TEAM SKULL\n"
	"guys are tough!\p"

	"Ever since the Gen 1 TYPE CHART,\n"
	"things have been real rough.\p"

	"My BUG-TYPES haven't been able to\n"
	"stand up to those POISON-TYPES.\l"
	"We're weak to their attacks now!\p"

	"I wish there was something we could\n"
	"do to turn the tables on them…", MSGBOX_NPC)
}

script AetherParadise_SkullGruntHint {
	textcolor(NPC_TEXT_COLOR_RED)
	msgbox(
	"Man!\n"
	"That SKUNTANK is real nasty, yo!\p"

	"He has WONDER GUARD like his crony\n"
	"KOFFING, but that's not all!\p"

	"He's got an item that lets him\n"
	"float in the air!\l"
	"Now GROUND moves won't do jack!\p"

	"Man, what're we supposed to do?\n"
	"", MSGBOX_NPC)
}

script AetherParadise_DMCA_StopsYou {
	lock
	textcolor(NPC_TEXT_COLOR_MALE)
	//cutscene stuff
	msgbox(
	"Stop in the name of the DMCA!\n"
	"", MSGBOX_DEFAULT)
	//cutscene stuff
	closemessage
	applymovement(LOCALID_AETHER_DMCA_GRUNT, moves(
		walk_down * 2
	))
	waitmovement(LOCALID_AETHER_DMCA_GRUNT)
	delay(30)
	msgbox(
	"These guys have been calling\n"
	"themselves TEAM SKULL.\l"
	"Ha!\p"

	"We all know they're a poor,\n"
	"illegal imitation.\p"

	"Here's the real TEAM SKULL!\n"
	"", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	applymovement(LOCALID_AETHER_ZUBAT, moves(
		walk_down * 3
		walk_right
		walk_down
	))
	applymovement(LOCALID_KOFFING, moves(
		walk_down * 3
		walk_left
		walk_down

	))
	waitmovement(0)
	textcolor(NPC_TEXT_COLOR_BLUE)
	delay(30)
	msgbox(
	"ZUBAT: Ahaha!\n"
	"We're the original TEAM SKULL!", MSGBOX_DEFAULT)
	closemessage
	msgbox(
	"KOFFING: Here, how about you\n"
	"have a little…{PAUSE 30} gift!", MSGBOX_DEFAULT)
	trainerbattle_no_intro(TRAINER_TEAM_SKULL, "Oh, this was a bad plan.")
	
	delay(30)
	msgbox(
	"ZUBAT: cough…\n"
	"We… lost…", MSGBOX_DEFAULT)
	closemessage
	delay(20)
	msgbox(
	"KOFFING: Let's skedaddle.\n"
	"The boss'll take care of this.", MSGBOX_DEFAULT)
	closemessage
	setflag(FLAG_DMCA_SKULL_FIGHT_1)
	setvar(VAR_TEMP_0, 1)
	closemessage
	delay(30)
	playse(SE_FLEE)
	applymovement(LOCALID_AETHER_ZUBAT, moves(
		walk_fast_up * 5
		walk_fast_left
		face_down
	))
	applymovement(LOCALID_KOFFING, moves(
		walk_fast_up * 5
		walk_fast_left
		face_down
	))
	waitmovement(0)
	removeobject(LOCALID_AETHER_ZUBAT)
	removeobject(LOCALID_KOFFING)
	applymovement(LOCALID_AETHER_DMCA_GRUNT, moves(
		face_up
		delay_16 * 2
		face_down 
		delay_16 * 2
		face_up
		delay_16 * 2
		face_down
		delay_16 * 4

	))
	waitmovement(LOCALID_AETHER_DMCA_GRUNT)
	playse(SE_FLEE)
	applymovement(LOCALID_AETHER_DMCA_GRUNT, moves(
		walk_fast_up * 5
	))
	waitmovement(LOCALID_AETHER_DMCA_GRUNT)
	removeobject(LOCALID_AETHER_DMCA_GRUNT)
	removeobject(LOCALID_AETHER_DMCA_GRUNT)
	release

}

script AetherParadise_SkuntankBattle {
	lock
    setvar(VAR_SHAKESCREEN_VERTICAL_PAN, 3)
    setvar(VAR_SHAKESCREEN_HORIZONTAL_PAN, 3)
    setvar(VAR_SHAKESCREEN_NUM_SHAKES, 15)
    setvar(VAR_SHAKESCREEN_SHAKE_DELAY, 3)
    special(ShakeScreen)
	delay(60)
	textcolor(NPC_TEXT_COLOR_BLUE)
	msgbox(
	"Oh?\n"
	"Did someone knock out my crew?\p"

	"That's not very polite.\p"

	"How about I pay them a little visit\n"
	"myself?\l"
	"Chaw-haw-haw!", MSGBOX_DEFAULT)
	closemessage

	applymovement(LOCALID_SKUNTANK, moves(
		
		
		walk_slow_down * 4

	))
	waitmovement(0)
	delay(30)
	msgbox(
	"I am SKUNTANK.\n"
	"The rightful leader of TEAM SKULL!\p"

	"Let's see how you stack up to me!\n"
	"", MSGBOX_DEFAULT)
	setflag(FLAG_SYS_KANGA_FIGHT)
	setvar(VAR_TEMP_START_EVENT_BATTLE, EVENT_BATTLE_SKUNTANK)
	setwildbattle(SPECIES_SKUNTANK, 40, ITEM_AIR_BALLOON)
	//playbgm(MUS_DUMMY, TRUE)
	//setflag(FLAG_SYS_KANGA_FIGHT)
	//setvar(VAR_TEMP_START_EVENT_BATTLE, EVENT_BATTLE_ARIANA)
	playbgm(MUS_NONE, TRUE)
	special(StartLegendaryBattle)
	delay(150)
	specialvar(VAR_RESULT, GetBattleOutcome)
	switch(var(VAR_RESULT)) {
		case B_OUTCOME_WON:
			msgbox(
			"H-hrrrn…\n"
			"You're…\l"
			"You're the real deal…\p"

			"G-gah-!\n"
			"We can't stay here anymore.\p"

			"Let's get out!\n"
			"", MSGBOX_DEFAULT)
			fadescreenswapbuffers(FADE_TO_BLACK)
			setflag(FLAG_DMCA_SKUNTANK_FIGHT_COMPLETED)
			removeobject(LOCALID_SKUNTANK)
			removeobject(LOCALID_KOFFING)
			removeobject(LOCALID_AETHER_ZUBAT)
			closemessage
			playse(SE_EXIT)
			waitse
			delay(30)
			fadescreenswapbuffers(FADE_FROM_BLACK)
			delay(20)
			playbgm(MUS_IKI_TOWN_TEST, TRUE)
			setvar(VAR_TEMP_0, 2)
			release
			end
		default:
			delay(5)
			warp(MAP_AETHER_PARADISE_ENTRANCE, 0)
	}
	release
}


script AetherParadise_SkullGruntDmca {
	textcolor(NPC_TEXT_COLOR_BLUE)
	if(flag(FLAG_DMCA_SKUNTANK_FIGHT_COMPLETED)) {
		msgbox(
			"Ayy!\n"
			"That other TEAM SKULL is gone!\p"

			"Now we can get back to taking all\n"
			"their search engine results!", MSGBOX_NPC)
	} else {
		msgbox(
		"Yo!\n"
		"Watch out, you!\p"

		"The DMCA broke in and took over!\n"
		"We're not safe anymore!", MSGBOX_NPC)

	}
}

