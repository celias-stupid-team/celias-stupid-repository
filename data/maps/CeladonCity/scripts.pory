		case CELIA_SECRET_VIRIDIAN: //Celadon, Vermilion, Pewter, Fuchsia, Lavender, Cerulean
			if(!flag(FLAG_CELIA_SECRET_CELADON)) {
				setvar(VAR_CSR_CELIA_SECRET_NEXT_HINT, CELIA_SECRET_CELADON)
				return
			}
			if(!flag(FLAG_CELIA_SECRET_VERMILION)) {
