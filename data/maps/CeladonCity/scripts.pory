raw `
.set LOCALID_FAT_MAN,   2
.set LOCALID_POLIWRATH, 3



CeladonCity_OnTransition::
	setworldmapflag FLAG_WORLD_MAP_CELADON_CITY
	setbench BENCH_CELADON
	end

CeladonCity_EventScript_LittleGirl::
	msgbox CeladonCity_Text_GotMyKoffingInCinnabar, MSGBOX_NPC
	end

CeladonCity_EventScript_OldMan1::
	lock
	msgbox CeladonCity_Text_GymIsGreatFullOfWomen
	release
	end

CeladonCity_EventScript_Woman::
	msgbox CeladonCity_Text_GameCornerIsBadForCitysImage, MSGBOX_NPC
	end

CeladonCity_EventScript_OldMan2::
	msgbox CeladonCity_Text_BlewItAllAtSlots, MSGBOX_NPC
	end

CeladonCity_EventScript_SoftboiledTutor::
	goto EventScript_SoftboiledTutor
	end

CeladonCity_EventScript_FatMan::
	lock
	faceplayer
	msgbox CeladonCity_Text_MyTrustedPalPoliwrath
	closemessage
	applymovement LOCALID_FAT_MAN, Common_Movement_FaceOriginalDirection
	waitmovement 0
	release
	end

CeladonCity_EventScript_Poliwrath::
	lock
	faceplayer
	waitse
	playmoncry SPECIES_SLOWBRO, CRY_MODE_NORMAL
	msgbox CeladonCity_Text_Poliwrath
	closemessage
	waitmoncry
	applymovement LOCALID_POLIWRATH, Common_Movement_FaceOriginalDirection
	waitmovement 0
	release
	end

CeladonCity_EventScript_RocketGrunt1::
	msgbox CeladonCity_Text_KeepOutOfTeamRocketsWay, MSGBOX_NPC
	end

CeladonCity_EventScript_RocketGrunt2::
	msgbox CeladonCity_Text_GetLostOrIllPunchYou, MSGBOX_NPC
	end

CeladonCity_EventScript_Boy::
	msgbox CeladonCity_Text_ScaldedTongueOnTea, MSGBOX_NPC
	end

CeladonCity_EventScript_SilphCoScientist::
	msgbox CeladonCity_Text_SomeoneStoleSilphScope, MSGBOX_NPC
	end

CeladonCity_EventScript_TrainerTips1::
	msgbox CeladonCity_Text_ExplainXAccuracyDireHit, MSGBOX_SIGN
	end

CeladonCity_EventScript_CitySign::
	msgbox CeladonCity_Text_CitySign, MSGBOX_SIGN
	end

CeladonCity_EventScript_GymSign::
	lockall
	msgbox CeladonCity_Text_GymSign
	releaseall
	end

CeladonCity_EventScript_MansionSign::
	msgbox CeladonCity_Text_MansionSign, MSGBOX_SIGN
	end

CeladonCity_EventScript_DeptStoreSign::
	msgbox CeladonCity_Text_DeptStoreSign, MSGBOX_SIGN
	end

CeladonCity_EventScript_TrainerTips2::
	msgbox CeladonCity_Text_GuardSpecProtectsFromStatus, MSGBOX_SIGN
	end

CeladonCity_EventScript_PrizeExchangeSign::
	msgbox CeladonCity_Text_PrizeExchangeSign, MSGBOX_SIGN
	end

CeladonCity_EventScript_GameCornerSign::
	msgbox CeladonCity_Text_GameCornerSign, MSGBOX_SIGN
	end
`

const CELIA = 15
mapscripts CeladonCity_MapScripts {
	MAP_SCRIPT_ON_TRANSITION: CeladonCity_OnTransition
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_CSR_CURRENT_CELIA_SECRET, 5 {
			lock
			delay(90)
			applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
			if(flag(FLAG_CELIA_SECRET_CELADON)) {
				release
				end
			}
			delay(40)
			playse(SE_EXIT)
			setobjectxy(CELIA, 30, 11)
			applymovement(CELIA, Celadon_CeliaComesOut)
			waitmovement(0)
			delay(10)
			playse(SE_SELECT)
			textcolor(NPC_TEXT_COLOR_FEMALE)
			msgbox("Uh, hi!\nI'm CELIA, the creator.\pHey, good job getting to the top\nof those stairs!\pI did it the old fashioned way by\njust collecting 70 Power Stars.\lIt took me forever!", MSGBOX_DEFAULT)
			msgbox("Anyway...\pYou seem to be someone who likes to\ntry stuff to see what happens.\lI have another idea for you...", MSGBOX_DEFAULT)
			setflag(FLAG_CELIA_SECRET_CELADON)
			call(CeliaSecrets_CeliaTellsYouNextHint)
			applymovement(CELIA, Celadon_CeliaLeaves)
			waitmovement(0)
			removeobject(CELIA)
			setvar(VAR_CSR_CURRENT_CELIA_SECRET, 0)
			release
			end
		}
	]
}


const CELIA_SECRET_VIRIDIAN = 0
const CELIA_SECRET_PEWTER = 1
const CELIA_SECRET_CERULEAN = 2
const CELIA_SECRET_VERMILION = 3
const CELIA_SECRET_LAVENDER = 4
const CELIA_SECRET_CELADON = 5
const CELIA_SECRET_FUCHSIA = 6

script CeliaSecrets_CeliaTellsYouNextHint {
	call(CeliaSecrets_GetNextHint)
	switch(var(VAR_CSR_CELIA_SECRET_NEXT_HINT)) {
		case CELIA_SECRET_VIRIDIAN: //implemented!
			msgbox("I hear there's someone in KANTO\nwho lost the keys to his house.\lAllegedly, he really liked gambling!", MSGBOX_DEFAULT)
		case CELIA_SECRET_PEWTER:
			msgbox("Oh, no! The PSYDUCK PAIL you picked\nup has a hole in it?\lAnd you can only fill it up in RAIN?\pIsn't there somewhere else that you\ncaused to start raining?\lOr maybe something to that effect?", MSGBOX_DEFAULT)
		case CELIA_SECRET_CERULEAN:
			msgbox("There's a hidden back room in\nCERULEAN GYM.\pNow that you've found all my secrets\nhidden across KANTO, meet me there.\lI have something to show you.", MSGBOX_DEFAULT)
			setflag(FLAG_CELIA_SECRETS_FINISHED)
			clearflag(FLAG_HIDE_CELIA_IN_CERULEAN_BACK)
		case CELIA_SECRET_VERMILION: //implemented!!
			msgbox("The trash can puzzle in VERMILLION\nGYM looked incredibly complicated.\lThank goodness for the power outage!", MSGBOX_DEFAULT)
		case CELIA_SECRET_LAVENDER:
			msgbox("Going through POKéMON TOWER was a\nreal pain.\lIt was like being in school again!\pSay, wasn't there something odd\nwritten in the TRAINER SCHOOL?", MSGBOX_DEFAULT)
		case CELIA_SECRET_CELADON: //implemented!!
			msgbox("Man, that staircase in the back of\nthe CELADON MANSION went on forever!\pCan't you skip staircases like\nthat with a speedrunning technique?\lI wonder how you could do that here.", MSGBOX_DEFAULT)
		case CELIA_SECRET_FUCHSIA:

	}
	closemessage
	delay(10)
	msgbox("Anyway, I have to head out now.\pGood luck, and see ya later!\n", MSGBOX_DEFAULT)
	closemessage
	return
}

script CeliaSecrets_GetNextHint {
