movement Celadon_CeliaComesOut {
	set_visible
	delay_8
	walk_down
	face_down
	delay_16 * 5
	walk_slow_down
	face_down
}

movement Celadon_CeliaLeaves {
	delay_16
	delay_16
	delay_16
	walk_slow_left
	walk_slow_down
	walk_slow_down
	walk_slow_down
	walk_slow_down
	walk_slow_down
	walk_slow_down
	walk_slow_down
}


script CeradonCity_EventScript_LittleGirl {
	msgbox("Uh hum.\pI sure am glad that was\na warp and not a freefall!", MSGBOX_NPC)
	end
}

script CeladonCity_EventScript_Shorts {
	famechecker(FAMECHECKER_CELADON, 0)
	msgbox("Oh no!\nSomething terrible has happened!\pSomeone shoved all of CELADON CITY\ninto a RANDOMIZER!", MSGBOX_NPC)
	end
}

script CeladonCity_EventScript_GameCornerEntrance {
	msgbox("Thank you for your support over\nthe years!\pUnfortunately, we want to release\nthis game in Europe, so we closed.", MSGBOX_SIGN)
	end
}

script CeladonCity_EventScript_EggMan {
	lock
	faceplayer
	if(flag(FLAG_CSR_PHIONE_EGG)) {
		msgbox(CeladonCity_Text_ThanksEgg, MSGBOX_DEFAULT)
		closemessage
		delay(20)
		msgbox(CeladonCity_Text_WhereDoIGo, MSGBOX_DEFAULT)
		release
	} else {
		msgbox("Uh, hello there!\pI'm a deliveryman for the CELADON\nCafé.\pThey ordered a shipment of EGGs to\nserve SOFT BOILED, but when I went\lto deliver them, I wound up here.\pHere, why don't you take one?\n", MSGBOX_DEFAULT)
		giveegg(SPECIES_PHIONE)
		closemessage
		delay(10)
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		playfanfare(MUS_LEVEL_UP)
		msgbox("{PLAYER} received the ODD EGG\nfrom the stranded deliveryman!", MSGBOX_DEFAULT)
		waitfanfare
		delay(20)
		textcolor(NPC_TEXT_COLOR_MALE)
		msgbox(CeladonCity_Text_ThanksEgg, MSGBOX_DEFAULT)
		closemessage
		delay(20)
		msgbox(CeladonCity_Text_WhereDoIGo, MSGBOX_DEFAULT)
		setflag(FLAG_CSR_PHIONE_EGG)
		call(SetPlayerPokedexValues)
		release
		
	}
}