script MtMoonSquare_StartDance {
    lockall
    special(SpawnCameraObject)
    setflag(FLAG_CSR_SPEEDRUN_CAVE)
    applymovement(OBJ_EVENT_ID_CAMERA, MtMoonSquare_CameraUp)
    fadeoutbgm(3)
    waitmovement(0)
    
    applymovement(TopLeftClefairy, Common_Movement_FaceDown)
    applymovement(BottomRightClefairy, Common_Movement_FaceDown)
    applymovement(BottomLeftClefairy, Common_Movement_FaceDown)
    applymovement(TopRightClefairy, Common_Movement_FaceDown)
    waitmovement(0)
    playmoncry(SPECIES_CLEFAIRY, CRY_MODE_NORMAL)
    //dance
    delay(50)
    playfanfare(MUS_CSR_CLEFAIRY_DANCE)
    delay(10)
    applymovement(TopLeftClefairy, MtMoonSquare_ClefairyDance_TopLeft)
    applymovement(BottomRightClefairy, MtMoonSquare_ClefairyDance_BottomRight)
    applymovement(BottomLeftClefairy, MtMoonSquare_ClefairyDance_BottomLeft)
    applymovement(TopRightClefairy, MtMoonSquare_ClefairyDance_TopRight)
    playse(SE_LEDGE)
    delay(60)
    playse(SE_LEDGE)
    delay(38)
    playse(SE_LEDGE)
    delay(48)
    playse(SE_LEDGE)
    delay(40)
    playse(SE_LEDGE)
    delay(23)
    playse(SE_LEDGE)
    delay(60)
    playse(SE_LEDGE)

    delay(90)
    playse(SE_LEDGE)
    delay(20)
    playse(SE_LEDGE)
    delay(20)
    playse(SE_LEDGE)
    waitmovement(0)
    waitse
    delay(30)
    playmoncry(SPECIES_CLEFAIRY, CRY_MODE_NORMAL)
    waitmoncry
    delay(30)
    fadescreen(FADE_TO_BLACK)
    addobject(EMBLEM)
    applymovement(OBJ_EVENT_ID_CAMERA, MtMoonSquare_CameraRepositions)
    waitmovement(0)
    setvar(VAR_MAP_SCENE_CLEFAIRY_DANCE, 2)
    fadescreen(FADE_FROM_BLACK)
    delay(30)
    applymovement(OBJ_EVENT_ID_CAMERA, MtMoonSquare_CameraDown)
    waitmovement(0)
    special(RemoveCameraObject)
    release
    end
}

script MtMoonSquare_Clefairy {
    finditem(ITEM_POKE_DOLL)
}

script MtMoonSquare_Emblem {
    finditem(ITEM_P_EMBLEM)
    fadenewbgm(MUS_CSR_MT_MOON_SQUARE)
}

movement MtMoonSquare_CameraUp {
    walk_up * 3
    walk_slow_up * 3
}

movement MtMoonSquare_CameraRepositions {
    walk_fast_down * 3
}

movement MtMoonSquare_CameraDown {
    walk_down * 3
}

movement MtMoonSquare_ClefairyDance_TopLeft {
    jump_2_down //Top Left
    delay_16 * 2
    jump_2_down
    walk_slow_right // Bottom Left
    delay_8
    walk_slow_down
    delay_8
    jump_2_right
    delay_16
    jump_2_right
    delay_16
    walk_slow_up
    delay_8
    walk_slow_right
    delay_8

    face_left
    delay_16
    face_down
    delay_16
    face_right
    delay_16

    
    
    jump_up
    jump_up
    jump_2_down
    face_down

}



movement MtMoonSquare_ClefairyDance_BottomLeft {
    walk_slow_right // Bottom Left
    delay_8
    walk_slow_down
    delay_8
    jump_2_right
    delay_16
    jump_2_right
    delay_16
    walk_slow_up
    delay_8
    walk_slow_right
    delay_8
    jump_2_up // Bottom Right
    delay_16 * 2
    jump_2_up

    face_left
    delay_16
    face_up
    delay_16
    face_right
    delay_16
    

    jump_down
    jump_down
    jump_2_up
    face_down
}

movement MtMoonSquare_ClefairyDance_BottomRight {
    jump_2_up // Bottom Right
    delay_16 * 2
    jump_2_up
    walk_slow_left //Top Right
    delay_8
    walk_slow_up
    delay_8
    jump_2_left
    delay_8
    jump_2_left
    delay_16
    walk_slow_down
    delay_8
    walk_slow_left
    delay_16

    face_right
    delay_16
    face_up
    delay_16
    face_left
    delay_16

    jump_down
    jump_down
    jump_2_up
    face_down

}

movement MtMoonSquare_ClefairyDance_TopRight {
    walk_slow_left //Top Right
    delay_8
    walk_slow_up
    delay_8
    jump_2_left
    delay_8
    jump_2_left
    delay_16
    walk_slow_down
    delay_8
    walk_slow_left
    delay_8
    jump_2_down //Top Left
    delay_16 * 2
    jump_2_down
    delay_8

    face_right
    delay_16
    face_up
    delay_16
    face_left
    delay_16
    
    jump_up
    jump_up
    jump_2_down
    face_down

}
