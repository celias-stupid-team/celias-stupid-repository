const EMBLEM = 3


const Clefairy1 = 1
const Clefairy2 = 2
const Clefairy3 = 4
const Clefairy4 = 5

const TopLeftClefairy = 6
const BottomLeftClefairy = 7
const TopRightClefairy = 8
const BottomRightClefairy = 9

mapscripts MtMoonSquare_Unbroken_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        setflag(FLAG_HIDE_P_EMBLEM)
        if(!checkitem(ITEM_P_EMBLEM, 1) && var(VAR_MAP_SCENE_CLEFAIRY_DANCE) == 2) {
            clearflag(FLAG_HIDE_P_EMBLEM)
        }
        if(checkitem(ITEM_P_EMBLEM)) {
            setflag(FLAG_CSR_SPEEDRUN_CAVE)
        }
        if(var(VAR_MAP_SCENE_CLEFAIRY_DANCE) == 0) {
            setflag(FLAG_CSR_CLEFAIRY_TOPLEFT)
            setflag(FLAG_CSR_CLEFAIRY_TOPRIGHT)
            setflag(FLAG_CSR_CLEFAIRY_BOTTOMLEFT)
            setflag(FLAG_CSR_CLEFAIRY_BOTTOMRIGHT)
        } else {
            clearflag(FLAG_CSR_CLEFAIRY_TOPLEFT)
            clearflag(FLAG_CSR_CLEFAIRY_TOPRIGHT)
            clearflag(FLAG_CSR_CLEFAIRY_BOTTOMLEFT)
            clearflag(FLAG_CSR_CLEFAIRY_BOTTOMRIGHT)

        }
    }
        
    

}



script MtMoonSquare_Clefairy1 {
    lock
    if(var(VAR_MAP_SCENE_CLEFAIRY_DANCE) == 2) {
        finditem(ITEM_POKE_DOLL)
        end
    }
    playmoncry(SPECIES_CLEFAIRY, CRY_MODE_NORMAL)
    waitmoncry
    if(!flag(FLAG_TEMP_1)) {
        setflag(FLAG_TEMP_1)
        fadescreenswapbuffers(FADE_TO_BLACK)
        removeobject(Clefairy1)
        clearflag(FLAG_CSR_CLEFAIRY_TOPLEFT)
        addobject(TopLeftClefairy)
        fadescreenswapbuffers(FADE_FROM_BLACK)
        if(flag(FLAG_TEMP_1) && flag(FLAG_TEMP_2) && flag(FLAG_TEMP_3) && flag(FLAG_TEMP_4)) {
            setvar(VAR_MAP_SCENE_CLEFAIRY_DANCE, 1)
        }
    }
    release
    end
}

