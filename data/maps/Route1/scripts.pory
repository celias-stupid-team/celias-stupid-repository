raw `


Route1_EventScript_MartClerk::
	lock
	faceplayer
	famechecker FAMECHECKER_VIRIDIAN, 0
	goto_if_set FLAG_GOT_POTION_ON_ROUTE_1, Route1_EventScript_AlreadyGotPotion
	msgbox Route1_Text_WorkAtPokeMartTakeSample
	textcolor NPC_TEXT_COLOR_NEUTRAL
	checkitemspace ITEM_POTION
	goto_if_eq VAR_RESULT, FALSE, EventScript_BagIsFull
	bufferitemname STR_VAR_2, ITEM_POTION
	playfanfare MUS_LEVEL_UP
	message Text_ObtainedTheX
	waitmessage
	waitfanfare
	additem ITEM_POTION
	msgbox Route1_Text_PutPotionAway
	call EventScript_RestorePrevTextColor
	setflag FLAG_GOT_POTION_ON_ROUTE_1
	release
	end

Route1_EventScript_AlreadyGotPotion::
	msgbox Route1_Text_ComeSeeUsIfYouNeedPokeBalls
	release
	end

Route1_EventScript_Boy::
	msgbox Route1_Text_CanJumpFromLedges, MSGBOX_NPC
	end

Route1_EventScript_RouteSign::
	msgbox Route1_Text_RouteSign, MSGBOX_SIGN
	end

Route1_EventScript_ThePit::
	famechecker FAMECHECKER_VIRIDIAN, 2	
	msgbox Route1_Text_ThePitIntro
	closemessage
	delay 30
	msgbox Route1_Text_ThePitDumbass, MSGBOX_SIGN
	end
`

mapscripts Route1_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setbench(BENCH_ROUTE1)
		setflag(FLAG_TEMP_1)
		setflag(FLAG_TEMP_6)
		setflag(FLAG_CSR_HIDE_ROUTE_1_CANDY_BEFORE_RETREAT)
		setflag(FLAG_TEMP_2)
		if(flag(FLAG_BADGE02_GET)) {
			clearflag(FLAG_TEMP_1)
			if(!flag(FLAG_CELIA_SECRET_PIT)) {
				clearflag(FLAG_TEMP_6)

			}
			if(!flag(FLAG_ROUTE_1_CANDY)) {
				clearflag(FLAG_CSR_HIDE_ROUTE_1_CANDY_BEFORE_RETREAT)
			}
		}
		if(var(VAR_CELIA_DEV_CREW) == 1) {
			clearflag(FLAG_TEMP_2)
			setflag(FLAG_TEMP_1)
			setflag(FLAG_TEMP_6)
			setvar(VAR_CELIA_DEV_CREW, 0)
		}
	} 
}



script Route1_EventScript_CeliaPotion {
	msgbox("The Potion gag was entirely made\nas an improvised joke.\lI didn't expect to actually commit.\pHowever, the idea of just casually\nhaving the last potion in the whole\lgoddamn universe is really funny.", MSGBOX_NPC)
	end
}

script Route1_EventScript_CeliaPit {
	msgbox("Ah, The Pit.\nThe most infamous part of the hack.\pHonestly I'm kinda surprised that\npeople are so enamored by it.\pI guess it serves as a reality check\nthat this is not a game to take\lvery seriously.", MSGBOX_NPC)
	end
}

script Route1_EventScript_Rat1 {
	lock
	setflag(FLAG_SHINY_CREATION) //Rattata
	setwildbattle(SPECIES_RATTATA_SHINY, 3, ITEM_FOCUS_SASH)
	clearflag(FLAG_SHINY_CREATION)
	//increment VAR_ROUTE01_SHINY_RAT1 so it only triggers once
	setvar(VAR_ROUTE01_SHINY_RAT1, 1)
	dowildbattle
	release
}

script Route1_EventScript_Rat2 {
	lock
	setflag(FLAG_SHINY_CREATION) // Rattata
	setwildbattle(SPECIES_RATTATA_SHINY, 3, ITEM_FOCUS_SASH)
	clearflag(FLAG_SHINY_CREATION)
	//increment VAR_ROUTE01_SHINY_RAT2 so it only triggers once
	setvar(VAR_ROUTE01_SHINY_RAT2, 2)
	dowildbattle
	release
}

script Route1_EventScript_EnterPit {
	lock
	setvar(VAR_TEMP_5, 1)
	release
}

script Route1_EventScript_PitEscaped {
	lock
	msgbox("You hear a voice from the skies…\n", MSGBOX_DEFAULT)
	textcolor(NPC_TEXT_COLOR_FEMALE)
	msgbox("Hi there!\nThis is CELIA, the creator!\pI saw that you got yourself a\nlittle stuck there.\lThat's okay, I've done that too.\pI hope this teaches you a valuable\nlesson about being careful!\pAlso, I noticed that you turned on\na walk-through-walls code to escape?\pI'm not gonna judge you for that,\nbut I do think this hack is more\lfun if you turn that off.\pYou were probably heading back\nto PALLET TOWN, I'm guessing?\lMaybe after receiving the PARCEL?\pDo be aware that this isn't a vanilla+\nROMhack - you're not gonna be able\lto turn your brain off and rush!\pAnyway, do have fun!\nGlad you got out safely!", MSGBOX_DEFAULT)
	setvar(VAR_TEMP_5, 0)
	release
}

script Route1_ImposterOak {
	lock
	if(!checkitem(ITEM_WAILMER_PAIL)) {
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		msgbox("Something about this tree in\nparticular feels... off.", MSGBOX_DEFAULT)
		playmoncry(SPECIES_SUDOWOODO, CRY_MODE_NORMAL)
		waitmoncry
	} else {
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		msgbox("Something about this tree in\nparticular feels... off.\pWould you like to WATER it?", MSGBOX_YESNO)
		if(var(VAR_RESULT)) {
			msgbox("{PLAYER} watered the tree…\n", MSGBOX_DEFAULT)
			fadeoutbgm(1)
			removeitem(ITEM_WAILMER_PAIL)
			additem(ITEM_EMPTY_PAIL)
			closemessage
			delay(10)
			playbgm(MUS_CSR_IMPOSTER_OAK, TRUE)
			delay(20)
			applymovement(LOCALID_PIT_OAK, Common_Movement_FaceUp) // open eyes
			waitmovement(0)
			delay(60)
			applymovement(LOCALID_PIT_OAK, Common_Movement_FaceLeft)
			delay(10)
			applymovement(LOCALID_PIT_OAK, Common_Movement_FaceUp)
			delay(20)
			applymovement(LOCALID_PIT_OAK, Common_Movement_FaceLeft)
			delay(10)
			applymovement(LOCALID_PIT_OAK, Common_Movement_FaceUp)
			delay(60)
			textcolor(NPC_TEXT_COLOR_TREE)
			msgbox("{FONT_SMALL}OAK: Hm?\n"
			"Whaddya want?\p"

			"Can't a guy get some shut-eye in\n"
			"peace around here?\p"

			"Bah, to heck with it.\n"
			"I'm outta here!", MSGBOX_DEFAULT)
			closemessage
			fadescreenswapbuffers(FADE_TO_BLACK)
			setflag(FLAG_CELIA_SECRET_PIT)
			removeobject(LOCALID_PIT_OAK)
			playse(SE_EXIT)
			fadeoutbgm(1)
			waitse
			fadescreenswapbuffers(FADE_FROM_BLACK)
			delay(90)
			addobject(LOCALID_ROUTE1_CELIA)
			setobjectxy(LOCALID_ROUTE1_CELIA, 6, 2)
			addobject(LOCALID_ROUTE1_CELIA)
			applymovement(LOCALID_ROUTE1_CELIA, moves(
				walk_down * 2
				
			))
			waitmovement(0)
			playse(SE_LEDGE)
			applymovement(LOCALID_ROUTE1_CELIA, moves(
				jump_2_down
				delay_8
				walk_down

			))
			waitmovement(0)
			textcolor(NPC_TEXT_COLOR_FEMALE)
			delay(30)
			applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
			waitmovement(0)
			msgbox(
			"Hi, there!\n"
			"I'm CELIA, the creator!\p"

			"I bet you thought you found a\n"
			"sneaky way out of the Pit!\l"
			"Nope - sorry!\p"

			"But if you like to find the sneaky\n"
			"secrets, how about you try this…", MSGBOX_DEFAULT)
			setvar(VAR_CSR_CURRENT_CELIA_SECRET, CELIA_SECRET_PIT)
			call(CeliaSecrets_CeliaTellsYouNextHint)
			applymovement(LOCALID_ROUTE1_CELIA, moves(
				walk_down * 5

				walk_right * 8
			))
			waitmovement(0)
			playbgm(MUS_ROUTE1, TRUE)
			
		}
	}
	release
	end
}







script Route1_EventScript_LittleBoy {
	lock
	msgbox(format("My daddy was playing POKéMON GO\nand didn't watch where he was going.\pI guess I need a new dad now."), MSGBOX_NPC)
	release
}

script Route1_EventScript_Dad {
	lock
	msgbox(format("I thought this sign was a\nPOKéSTOP..."), MSGBOX_NPC)
	release
}

script Route1_EventScript_ReturnToPit {
	lock
	setvar(VAR_CSR_VIRIDIAN_DOOR_TWICE, 2)
	applymovement(LOCALID_PLAYER, ReturnToPit_Start)
	waitmovement(0)
	getplayerxy(VAR_TEMP_2, VAR_RESULT)
	if(var(VAR_RESULT) == 3) {
		applymovement(LOCALID_PLAYER, ExtraRunDown)
		waitmovement(0)
	}
	
}

movement ReturnToPit_Start {
	player_run_left
	player_run_left
	player_run_left
	player_run_left
	player_run_down
}

movement ExtraRunDown {
	player_run_down
}

script Route1_EventScript_CeliaShiny {
	msgbox("Every week on my Discord I see\na new person asking if I raised\lthe shiny odds.\pNope!\nThey're actually reduced, haha!", MSGBOX_NPC)
	end
}

script Route1_Bonus_Chris {
	if(flag(FLAG_CHRIS_GIVES_LICKITUNG)) {
		lock
		faceplayer
		textcolor(NPC_TEXT_COLOR_MALE)
		msgbox("FoF: Hey! Glad you remembered!\nHere's a present!", MSGBOX_DEFAULT)
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		setflag(FLAG_SHINY_CREATION) // Lickitung
		clearflag(FLAG_CHRIS_GIVES_LICKITUNG)
		playfanfare(MUS_LEVEL_UP)
		msgbox("{PLAYER} obtained the LICKITUNG!\n", MSGBOX_DEFAULT)
		waitfanfare
		setvar(VAR_CSR_GIFT_POKEMON, SPECIES_LICKITUNG)
		call(Common_Script_GiftPokemon)
		textcolor(NPC_TEXT_COLOR_BLUE)
		msgbox("For more information about this\nPOKéMON, visit Lickipedia.org!", MSGBOX_DEFAULT)
		release
		end
	} else {
		textcolor(NPC_TEXT_COLOR_MALE)
		lock
		faceplayer
		msgbox("MASTER FoF: What do you call\na shiny HOOPA?\pA Golden Temp-Hole!\n:D", MSGBOX_DEFAULT)
	}
	release

}



