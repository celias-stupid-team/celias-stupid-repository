`

mapscripts Route10_Again_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setworldmapflag(FLAG_WORLD_MAP_ROCK_TUNNEL_1F)
	}
}

script CommonScript_EmptyPail {
	if(checkitem(ITEM_WAILMER_PAIL)) {
		lock
		removeitem(ITEM_WAILMER_PAIL)
		additem(ITEM_EMPTY_PAIL)
		if(!flag(FLAG_CSR_DUCK_PAIL_EMPTIED)) {
			msgbox("Oh no!\nThe PSYDUCK PAIL is totally empty!\pLooks like it's got a hole in the\nbottom…", MSGBOX_DEFAULT)
			setflag(FLAG_CSR_DUCK_PAIL_EMPTIED)
		} else {
			msgbox("Your PSYDUCK PAIL is out of water…\n", MSGBOX_DEFAULT)
		}
		setvar(VAR_CSR_PSYDUCK_PAIL_STATUS, 2)
	}
	release
}

script Route10_CeliaSecret {
	msgbox("Rock Tunnel is awful and unfun\nand I'm so glad I could skip it.", MSGBOX_NPC)
	end
}

script Route10_MunnaSecret {
	msgbox("They say that in gen 1, this girl\npredicts the existence of MUNNA.\pI just made her prediction mildly\nmore accurate!", MSGBOX_NPC)
	end
}