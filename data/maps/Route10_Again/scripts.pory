	.byte 0
`

script CommonScript_EmptyPail {
	if(checkitem(ITEM_WAILMER_PAIL)) {
		lock
		removeitem(ITEM_WAILMER_PAIL)
		additem(ITEM_EMPTY_PAIL)
		if(!flag(FLAG_CSR_DUCK_PAIL_EMPTIED)) {
			msgbox("Oh no!\nThe PSYDUCK PAIL is totally empty!\pLooks like it's got a hole in the\nbottom…", MSGBOX_DEFAULT)
		} else {
			msgbox("Your PSYDUCK PAIL is out of water…\n", MSGBOX_DEFAULT)
		}
		setvar(VAR_CSR_PSYDUCK_PAIL_STATUS, 2)
	}
	release
}