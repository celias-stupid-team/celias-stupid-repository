raw `
Route22_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION Route22_MapScripts_SetDexMons
	.byte 0

Route22_EventScript_EarlyRivalTriggerTop::
	lockall
	setvar VAR_TEMP_1, 0
	goto Route22_EventScript_EarlyRival
	end

Route22_EventScript_EarlyRivalTriggerMid::
	lockall
	setvar VAR_TEMP_1, 1
	setobjectxyperm LOCALID_ROUTE22_RIVAL, 25, 5
	goto Route22_EventScript_EarlyRival
	end

Route22_EventScript_EarlyRivalTriggerBottom::
	lockall
	setvar VAR_TEMP_1, 2
	setobjectxyperm LOCALID_ROUTE22_RIVAL, 25, 5
	goto Route22_EventScript_EarlyRival
	end

Route22_EventScript_EarlyRival::
	setvar VAR_TEMP_START_EVENT_BATTLE, 1
	famechecker FAMECHECKER_VIRIDIAN, 1
	textcolor NPC_TEXT_COLOR_MALE
	playbgm MUS_ENCOUNTER_RIVAL, 0
	addobject LOCALID_ROUTE22_RIVAL
	call_if_eq VAR_TEMP_1, 0, Route22_EventScript_EarlyRivalApproach
	call_if_eq VAR_TEMP_1, 1, Route22_EventScript_EarlyRivalApproach
	call_if_eq VAR_TEMP_1, 2, Route22_EventScript_EarlyRivalApproachBottom
	delay 6
	msgbox Route22_Text_EarlyRivalIntro
	call_if_eq VAR_STARTER_MON, 2, Route22_EventScript_EarlyRivalSquirtle
	call_if_eq VAR_STARTER_MON, 1, Route22_EventScript_EarlyRivalSquirtle
	call_if_eq VAR_STARTER_MON, 0, Route22_EventScript_EarlyRivalSquirtle
	msgbox Route22_Text_EarlyRivalPostBattle
	closemessage
	delay 10
	playbgm MUS_RIVAL_EXIT, 0
	call_if_eq VAR_TEMP_1, 0, Route22_EventScript_EarlyRivalExit
	call_if_eq VAR_TEMP_1, 1, Route22_EventScript_EarlyRivalExit
	call_if_eq VAR_TEMP_1, 2, Route22_EventScript_EarlyRivalExitBottom
	fadedefaultbgm
	removeobject LOCALID_ROUTE22_RIVAL
	setvar VAR_MAP_SCENE_ROUTE22, 2
	releaseall
	end

Route22_EventScript_EarlyRivalApproach::
	applymovement LOCALID_ROUTE22_RIVAL, Route22_Movement_RivalApproach
	waitmovement 0
	return

Route22_EventScript_EarlyRivalApproachBottom::
	applymovement LOCALID_ROUTE22_RIVAL, Route22_Movement_RivalApproachBottom
	applymovement LOCALID_PLAYER, Route22_Movement_PlayerFaceRival
	waitmovement 0
	return



Route22_EventScript_EarlyRivalBulbasaur::
	trainerbattle_single TRAINER_RIVAL_LARRY, 0, Route22_Text_EarlyRivalDefeat, Route22_Text_LarryVictory
	return

Route22_EventScript_EarlyRivalCharmander::
	trainerbattle_single TRAINER_RIVAL_LARRY, 0, Route22_Text_EarlyRivalDefeat, Route22_Text_LarryVictory
	return

Route22_EventScript_EarlyRivalExit::
	applymovement LOCALID_ROUTE22_RIVAL, Route22_Movement_EarlyRivalExit
	waitmovement 0
	return

Route22_EventScript_EarlyRivalExitBottom::
	applymovement LOCALID_ROUTE22_RIVAL, Route22_Movement_EarlyRivalExitBottom
	waitmovement 0
	return

Route22_Movement_UnusedRivalExit:: @ 8
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	step_end

Route22_Movement_EarlyRivalExit::
	walk_down
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	step_end

Route22_Movement_EarlyRivalExitBottom::
	walk_right
	walk_right
	walk_right
	walk_right
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	step_end

Route22_Movement_RivalApproach::
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	step_end

Route22_Movement_RivalApproachBottom::
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_in_place_faster_down
	step_end

Route22_Movement_PlayerFaceRival::
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	delay_16
	delay_8
	walk_in_place_faster_up
	step_end

Route22_EventScript_LateRivalTriggerTop::
	lockall
	setvar VAR_TEMP_1, 0
	goto Route22_EventScript_LateRival
	end

Route22_EventScript_LateRivalTriggerMid::
	lockall
	setvar VAR_TEMP_1, 1
	setobjectxyperm LOCALID_ROUTE22_RIVAL_LATE, 25, 5
	goto Route22_EventScript_LateRival
	end

Route22_EventScript_LateRivalTriggerBottom::
	lockall
	setvar VAR_TEMP_1, 2
	setobjectxyperm LOCALID_ROUTE22_RIVAL_LATE, 25, 5
	goto Route22_EventScript_LateRival
	end

Route22_EventScript_LateRival::
	textcolor NPC_TEXT_COLOR_FEMALE
	playbgm MUS_ENCOUNTER_RIVAL, 0
	addobject LOCALID_ROUTE22_RIVAL_LATE
	setvar VAR_TEMP_START_EVENT_BATTLE, EVENT_BATTLE_MARY
	call_if_eq VAR_TEMP_1, 0, Route22_EventScript_LateRivalApproach
	call_if_eq VAR_TEMP_1, 1, Route22_EventScript_LateRivalApproach
	call_if_eq VAR_TEMP_1, 2, Route22_EventScript_LateRivalApproachBottom
	msgbox Route22_Text_LateRivalIntro
	setvar VAR_LAST_TALKED, LOCALID_ROUTE22_RIVAL_LATE
	call_if_eq VAR_STARTER_MON, 2, Route22_EventScript_LateRivalSquirtle
	call_if_eq VAR_STARTER_MON, 1, Route22_EventScript_LateRivalBulbasaur
	call_if_eq VAR_STARTER_MON, 0, Route22_EventScript_LateRivalCharmander
	msgbox Route22_Text_LateRivalPostBattle
	closemessage
	delay 10
	playbgm MUS_RIVAL_EXIT, 0
	applymovement LOCALID_ROUTE22_RIVAL_LATE, Route22_Movement_LateRivalExit
	waitmovement 0
	fadedefaultbgm
	removeobject LOCALID_ROUTE22_RIVAL_LATE
	setvar VAR_MAP_SCENE_ROUTE22, 4
	releaseall
	end

Route22_EventScript_LateRivalApproach::
	applymovement LOCALID_ROUTE22_RIVAL_LATE, Route22_Movement_RivalApproach
	waitmovement 0
	return

Route22_EventScript_LateRivalApproachBottom::
	applymovement LOCALID_ROUTE22_RIVAL_LATE, Route22_Movement_RivalApproachBottom
	applymovement LOCALID_PLAYER, Route22_Movement_PlayerFaceRival
	waitmovement 0
	return

Route22_EventScript_LateRivalSquirtle::
	trainerbattle_no_intro TRAINER_RIVAL_ROUTE22_LATE_SQUIRTLE, Route22_Text_LateRivalDefeat
	return

Route22_EventScript_LateRivalBulbasaur::
	trainerbattle_no_intro TRAINER_RIVAL_ROUTE22_LATE_BULBASAUR, Route22_Text_LateRivalDefeat
	return

Route22_EventScript_LateRivalCharmander::
	trainerbattle_no_intro TRAINER_RIVAL_ROUTE22_LATE_CHARMANDER, Route22_Text_LateRivalDefeat
	return

Route22_Movement_LateRivalExit::
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	step_end

Route22_EventScript_LeagueGateSign::
	msgbox Route22_Text_LeagueGateSign, MSGBOX_SIGN
	end
`
script Route22_EventScript_CeliaLarry {
	msgbox("I think the LARRY fight might be\nthe most important scene in this\lwhole hack.\pAt first, the battle seems totally\nunfair.\lYou expect it to just be a troll.\pBut then you realize that actually,\nyou HAVE the tools you need.\pAnd to beat him, you need to use the\nsame unfair shit that has been\lkicking your ass across Route 1.\pAnd finally, in turning the game's\nstupid bullshit against itself,\lyou finally get your first Win.\pI think there's a certain beauty\nto that.", MSGBOX_NPC)
	end
}

script Route22_EventScript_OddCandyMan {
	lock
	if(flag(FLAG_GOT_SHINY_MELTAN)) {
		msgbox(
		"Thank you for everything you've\n"
		"done.\p"

		"After all that, I have nothing\n"
		"left.\p"

		"Ten of them, in fact.\n"
		"", MSGBOX_DEFAULT)
		release
		end
	}
	if(flag(FLAG_CANDY_MAN_FELL) && !flag(FLAG_RETRIEVED_CANDIES)) {
		msgbox(
		"Gah…{PAUSE 20}\n"
		"My back-!", MSGBOX_DEFAULT)
		release
		end
	}
	faceplayer
	if(flag(FLAG_CANDY_MAN_FELL) && flag(FLAG_RETRIEVED_CANDIES)) {
		msgbox(
		"Ahh…\n"
		"Apologies!\p"

		"Ahem, in any case!\p"

		"Thank you for finding the rest of\n"
		"my CANDIES.\l"
		"Now I just have to…\p"

		"… … …\n"
		"… … …{PAUSE 30}Oh, shoot.\p"

		"It looks like MELTAN can't evolve\n"
		"in this game.\p"

		"Whelp.\p"

		"In that case…{PAUSE 30} I suppose I\n"
		"don't need him anymore.\l"
		"Here you are.", MSGBOX_DEFAULT)
		playfanfare(MUS_KOROK_SEED)
		msgbox(
		"{PLAYER} was gifted the\n"
		"long-awaited MELTAN!", MSGBOX_DEFAULT)
		setvar(VAR_CSR_GIFT_POKEMON, SPECIES_MELTAN)
		call(Common_Script_GiftPokemon30)
		release
		end
	}

	if(checkmoncaught(SPECIES_MELTAN)) {
		msgbox(
		"Well, either way thank you for\n"
		"your help.\p"

		"Now that we've collected all the\n"
		"candy, there's NOTHING more I need.", MSGBOX_DEFAULT)
		if(checkitem(ITEM_NOTHING, 10)) {
			closemessage
			playse(SE_PIN)
			applymovement(VAR_LAST_TALKED, moves(
				emote_exclamation_mark
				delay_16 * 3
			))
			waitmovement(0)
			msgbox(
			"Oh!\n"
			"That's ten whole NOTHINGS!\l"
			"That's the last thing I need!\p"

			"Please, trade them to me.\n"
			"I'll give you a reward.", MSGBOX_DEFAULT)
			removeitem(ITEM_NOTHING, 10)
			textcolor(NPC_TEXT_COLOR_NEUTRAL)
			msgbox(
			"{PLAYER} traded away the\n"
			"NOTHINGs…", MSGBOX_DEFAULT)
			textcolor(NPC_TEXT_COLOR_BLUE)
			msgbox(
			"Thank you!\n"
			"And here you are.", MSGBOX_DEFAULT)
			setflag(FLAG_SHINY_CREATION)
			playfanfare(MUS_KOROK_SEED)
			msgbox(
			"{PLAYER} received the\n"
			"backup MELTAN!", MSGBOX_DEFAULT)
			waitfanfare
			setvar(VAR_CSR_GIFT_POKEMON, SPECIES_MELTAN)
			call(Common_Script_GiftPokemon30)
			setflag(FLAG_GOT_SHINY_MELTAN)
			

		}
		release
		end
	}
	famechecker(FAMECHECKER_VIRIDIAN, FCPICKSTATE_COLORED, UpdatePickStateFromSpecialVar8005)
	if(flag(FLAG_BADGE08_GET)) {
		famechecker(FAMECHECKER_VIRIDIAN, 3)
		msgbox(
		"Why, hello!\p"

		"You're the young soul who's on the\n"
		"hunt for my lost ODD CANDIES!\p"

		"I have excellent news!\n"
		"I found quite a few of them myself.\l"
		"Here, let's take inventory.", MSGBOX_DEFAULT)
		closemessage
		call(Route22_CountCandies)
		delay(30)
		textcolor(NPC_TEXT_COLOR_NEUTRAL)
		msgbox(
		"… … … …\n"
		"… … … …", MSGBOX_DEFAULT)
		closemessage
		delay(30)
		textcolor(NPC_TEXT_COLOR_BLUE)
		msgbox(
		"Aha!\n"
		"Wonderful!\p"

		"It seems that you have {STR_VAR_1},\n"
		"while I have the remaining {STR_VAR_2}!", MSGBOX_DEFAULT)
		if(var(VAR_STACK_OF_CANDY) < 3) {
		msgbox(
		"Er, yes it appears you did the\n"
		"lion's share of the work.\l"
		"Ehe…\p"

		"Nonetheless!\n"
		"", MSGBOX_DEFAULT)
		}
		applymovement(VAR_LAST_TALKED, moves(
			delay_16
			walk_slow_down
			jump_2_down
		))
		specialvar(VAR_RESULT, GetPlayerFacingDirection)
		if(var(VAR_RESULT) == DIR_NORTH) {
			applymovement(LOCALID_PLAYER, moves(
				face_left
				lock_facing_direction
				walk_right
				unlock_facing_direction
				face_down
			))
		} else {
			applymovement(LOCALID_PLAYER, moves(
				delay_16 * 2
				face_down
			))

		}
		message(
		"Now all that's left for me to\n"
		"do is… {PAUSE 45}{SE_LEDGE}Whoa!")
		waitmovement(VAR_LAST_TALKED)
		addobject(LOCALID_STACK_OF_CANDY)
		fadescreeninstant(FADE_TO_WHITE)
		playse(SE_BANG)
		closemessage
		delay(30)
		
		copyobjectxytoperm(VAR_LAST_TALKED)
		applymovement(VAR_LAST_TALKED, moves(
			face_left
		))
		fadescreenswapbuffers(FADE_FROM_WHITE)
		delay(90)
		msgbox(
		"Oww…\n"
		"", MSGBOX_DEFAULT)
		closemessage
		setflag(FLAG_CANDY_MAN_FELL)
		release
		end
	}
	msgbox("Hello, there!\nCould I ask for a bit of your time?", MSGBOX_YESNO)
	if(var(VAR_RESULT) == 1) {
		msgbox("Splendid!\pI'm a traveler, you see, but I think\nI'm in a bit of trouble.\pSee, I play POKéMON GO, and I was\npreparing to evolve my MELTAN.\pSadly, just as I was ready to do so,\nI tripped because I wasn't careful!\pAnd thus, my MELTAN CANDY got\nscattered across all of KANTO!\pI'm trying to find it all, but I'm\nstill missing 45 PIECES.\lCould you help me find the rest?", MSGBOX_YESNO)
		if(var(VAR_RESULT) == 1) {
			famechecker(FAMECHECKER_VIRIDIAN, 3)
			msgbox("Wonderful news!\nThank you so much!\pI'll even make this easier for\nyou!\pCome back to me again once\nyou've collected all your BADGES.\lI'll help you narrow your search.\pUntil then, happy hunting!\n", MSGBOX_DEFAULT)
			release
			end
		}
		else {
			goto(OddCandyMan_Rejected)
		}
	}
	else {
		goto(OddCandyMan_Rejected)
	}

	OddCandyMan_Rejected:
		msgbox("What a shame...\pWell, if you ever find time, I'm\nsure to make it worth your while.", MSGBOX_DEFAULT)
		release
		end
}

script Route22_EventScript_RouteSign {
	msgbox("ROUTE 22\nNEW WILD POKéMON: 3", MSGBOX_SIGN)
	release
}

script Route22_MapScripts_SetDexMons {
	setbench(BENCH_ROUTE1)
	setflag(FLAG_TEMP_1)
	setflag(FLAG_TEMP_2)
	if(checkmoncaught(SPECIES_MELMETAL)) {
		clearflag(FLAG_TEMP_1)
	}
	if(flag(FLAG_SYS_POKEDEX_GET)) {
		setflag(FLAG_CSR_MAP_ROUTE_22)
		call(SetPlayerPokedexValues)
	}
}

script Route22_MankeySpot {
	if(flag(FLAG_SYS_POKEDEX_GET)) {
		setvar(VAR_ROUTE22_MANKEY, 1)
		if(!checkmoncaught(SPECIES_MANKEY)) {
			setwildbattle(SPECIES_MANKEY, 2, ITEM_NONE)
			dowildbattle
		}
	}
	release
}

script Route22_MankeySpot2 {
	if(flag(FLAG_SYS_POKEDEX_GET)) {
		addvar(VAR_TEMP_2, 1)
		if(!checkmoncaught(SPECIES_MANKEY) && !checkmoncaught(SPECIES_NIDORAN_M) && !checkmoncaught(SPECIES_NIDORAN_F) && var(VAR_TEMP_2) > 8) {
			setvar(VAR_ROUTE22_MANKEY, 1)
			setflag(FLAG_SHINY_CREATION)
			setwildbattle(SPECIES_NIDORAN_F, 6, ITEM_NONE)
			dowildbattle
		}
	}
	release
}

script Route22_NidotranMSpot {
	if(flag(FLAG_SYS_POKEDEX_GET)) {
		setvar(VAR_ROUTE22_NIDOM, 1)
		if(!checkmoncaught(SPECIES_NIDORAN_M)) {
			setwildbattle(SPECIES_NIDORAN_M, 4, ITEM_NONE)
			dowildbattle
		}
	}
	release
}

script Route22_NidotranFSpot {
	if(flag(FLAG_SYS_POKEDEX_GET)) {
		setvar(VAR_ROUTE22_NIDOF, 1)
		if(!checkmoncaught(SPECIES_NIDORAN_F)) {
			setwildbattle(SPECIES_NIDORAN_F, 4, ITEM_NONE)
			dowildbattle
		}
	}
	release
}

script Route22_EventScript_EarlyRivalSquirtle {
	trainerbattle_no_intro(TRAINER_RIVAL_LARRY, Route22_Text_EarlyRivalDefeat)
	return
}

script Route22_CandyStack {
	setflag(FLAG_RETRIEVED_CANDIES)
	if(var(VAR_STACK_OF_CANDY) == 0) {
		finditem(ITEM_NOTHING)
		end
	}
	lock
	removeobject(VAR_LAST_TALKED)
	while(!checkitem(ITEM_ODD_CANDY, 45)) {
		additem(ITEM_ODD_CANDY)
	}
	waitse
	call(EventScript_PlayFanfareObtainedKorok)
	msgbox(
	"{PLAYER} found\n"
	"{STR_VAR_2} ODD CANDY(s)!", MSGBOX_DEFAULT)
	waitfanfare
	msgbox(
	"{PLAYER} put the ODD CANDY(s)\n"
	"in the KEY ITEMS POCKET.", MSGBOX_DEFAULT)
	release
	end


}


script Route22_CountCandies {
	setvar(VAR_STACK_OF_CANDY, 45)
	setvar(VAR_TEMP_A, 1)
	while(checkitem(ITEM_ODD_CANDY, VAR_TEMP_A)) {
		addvar(VAR_TEMP_A, 1)
	}
	subvar(VAR_TEMP_A, 1)
	subvar(VAR_STACK_OF_CANDY, VAR_TEMP_A)
	buffernumberstring(STR_VAR_1, VAR_TEMP_A)
	buffernumberstring(STR_VAR_2, VAR_STACK_OF_CANDY)
	//msgbox("Your candies: {STR_VAR_1}\nStack: {STR_VAR_2}")
	
	setflag(FLAG_PALLET_CANDY)
	setflag(FLAG_VIRIDIAN_CANDY)
	setflag(FLAG_PEWTER_CANDY)
	setflag(FLAG_CERULEAN_CANDY)
	setflag(FLAG_VERMILLION_CANDY)
	setflag(FLAG_LAVENDER_CANDY)
	setflag(FLAG_CELADON_CANDY)
	setflag(FLAG_FUSHCIA_CANDY)
	setflag(FLAG_CINNABAR_ISLAND_CANDY)
	setflag(FLAG_SOOTOPOLIS_CITY_CANDY)
	setflag(FLAG_MT_MOON_CANDY)
	setflag(FLAG_UNDERGROUND_PATH_CANDY)
	setflag(FLAG_POKEMON_TOWER_CANDY)
	setflag(FLAG_SAFARI_ZONE_CANDY)
	setflag(FLAG_SILPH_CO_CANDY)
	setflag(FLAG_SEAFOAM_ISLANDS_CANDY)
	setflag(FLAG_SKY_PILLAR_CANDY)
	setflag(FLAG_KANTO_LIGHTHOUSE_CANDY)
	setflag(FLAG_CERULEAN_CAVE_CANDY)
	setflag(FLAG_ONE_ISLAND_CANDY)
	setflag(FLAG_TWO_ISLAND_CANDY)
	setflag(FLAG_THREE_ISLAND_CANDY)
	setflag(FLAG_FOUR_ISLAND_CANDY)
	setflag(FLAG_THIRTY_EIGHT_ISLAND_CANDY)
	setflag(FLAG_POKEMON_ISLAND_CANDY)
	setflag(FLAG_MINNESOTA_CANDY)
	setflag(FLAG_ROUTE_1_CANDY)
	setflag(FLAG_ROUTE_2_CANDY)
	setflag(FLAG_ROUTE_3_CANDY)
	setflag(FLAG_ROUTE_4_CANDY)
	setflag(FLAG_ROUTE_5_CANDY)
	setflag(FLAG_ROUTE_6_CANDY)
	setflag(FLAG_ROUTE_8_CANDY)
	setflag(FLAG_ROUTE_9_CANDY)
	setflag(FLAG_ROUTE_10_CANDY)
	setflag(FLAG_ROUTE_11_CANDY)
	setflag(FLAG_ROUTE_12_CANDY)
	setflag(FLAG_ROUTE_13_CANDY)
	setflag(FLAG_ROUTE_14_CANDY)
	setflag(FLAG_ROUTE_16_CANDY)
	setflag(FLAG_ROUTE_21_CANDY)
	setflag(FLAG_ROUTE_18_CANDY)
	setflag(FLAG_ROUTE_22_CANDY)
	setflag(FLAG_ROUTE_24_CANDY)
	setflag(FLAG_ROUTE_25_CANDY)
	setflag(FLAG_VIRIDIAN_FOREST_CANDY)
	clearflag(FLAG_TEMP_1)
	return
}