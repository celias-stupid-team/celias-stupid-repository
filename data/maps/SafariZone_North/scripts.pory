raw `

SafariZone_North_EventScript_RestHouseSign::
	msgbox SafariZone_North_Text_RestHouse, MSGBOX_SIGN
	end

SafariZone_North_EventScript_TrainerTips1::
	msgbox SafariZone_North_Text_SecretHouseStillAhead, MSGBOX_SIGN
	end

SafariZone_North_EventScript_AreaSign::
	msgbox SafariZone_North_Text_Area2, MSGBOX_SIGN
	end

SafariZone_North_EventScript_TrainerTips2::
	msgbox SafariZone_North_Text_ZigzagThroughTallGrass, MSGBOX_SIGN
	end

SafariZone_North_EventScript_TrainerTips3::
	msgbox SafariZone_North_Text_WinFreeHMFindSecretHouse, MSGBOX_SIGN
	end
`
const BRELOOM = 8
mapscripts SafariZone_North_MapScripts {
	MAP_SCRIPT_ON_LOAD {
		if(!(checkpartymove(MOVE_GULP) == PARTY_SIZE) && !flag(FLAG_BATTLED_IRON_CLEFTS)) {
			playbgm(MUS_SAFARI_MARCH, TRUE)
		}
		if(!flag(FLAG_HIDE_DMCA_IN_SAFARI_ZONE)) {
			setflag(FLAG_TEMP_1)
			setflag(FLAG_TEMP_3)
		}
	}
	MAP_SCRIPT_ON_TRANSITION {
	
	}
	
}

script SafariZone_North_GrandDad {
	lock
	faceplayer
	textcolor(0)
	
	if(!(checkpartymove(MOVE_GULP) == PARTY_SIZE) && !flag(FLAG_BATTLED_IRON_CLEFTS)) {
		msgbox(
		"GRAND DAD: {PLAYER}!\n"
		"What are you doing out here?\p"

		"Do you hear that song?\n"
		"You have everything you need.\l"
		"It's time to take them down!\p"

		"Well, never mind that.\n"
		"Why don't you take a rest?", MSGBOX_DEFAULT)
	} else {
		msgbox("GRAND DAD: {PLAYER}!\nWhat are you doing out here?\pSee that portal?\nI actually came out of there!\lThat's why I'm your GRAND DAD!\pWell, never mind that.\nHow about you take a rest?", MSGBOX_DEFAULT)


	}
		fadescreenswapbuffers(FADE_TO_BLACK)
		closemessage
		playfanfare(MUS_HEAL)
		waitfanfare
		special(HealPlayerParty)
		fadescreenswapbuffers(FADE_FROM_BLACK)
		msgbox(("GRAND DAD: There!\nBest of luck to you!"), MSGBOX_DEFAULT)
		release
		end
}

script SafariZone_North_ShowdownSign {
	msgbox("SAFARI ZONE\nMAIN STADIUM", MSGBOX_SIGN)
	end
}

script SafariZone_North_Breloom {
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_MALE)
	playmoncry(SPECIES_BRELOOM, CRY_MODE_DEFAULT)
	msgbox("BRELOOM: Bre-Breee!\n", MSGBOX_DEFAULT)
	waitmoncry
	closemessage
	delay(30)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox("He seems sad to have missed the\naction.", MSGBOX_DEFAULT)
	callnative(GetPlayerOutfit)
	if(!flag(FLAG_GOT_PARAS_FROM_LUIGI) && var(VAR_RESULT) == OUTFIT_L) {
		delay(30)
		applymovement(VAR_LAST_TALKED, Common_Movement_ExclamationMark)
		playse(SE_PIN)
		waitmovement(0)
		delay(30)
		msgbox("…But he really likes\nyour outfit!", MSGBOX_DEFAULT)
		closemessage
		playmoncry(SPECIES_BRELOOM, CRY_MODE_DEFAULT)
		msgbox("BRELOOM: Bree!\n", MSGBOX_DEFAULT)
		waitmoncry
		closemessage
		msgbox("He has a gift for you!\n", MSGBOX_DEFAULT)
		playfanfare(MUS_LEVEL_UP)
		msgbox("{PLAYER} recieved a PARAS\nfrom the kindly BRELOOM!", MSGBOX_DEFAULT)
		waitfanfare
		setflag(FLAG_SHINY_CREATION) // Paras
		setvar(VAR_CSR_GIFT_POKEMON, SPECIES_PARAS)
		call(Common_Script_GiftPokemon)

		setflag(FLAG_GOT_PARAS_FROM_LUIGI)
	}
	release

}

script SafariZone_North_DMCA_1 {
	trainerbattle_single(TRAINER_DMCA_GRUNT_19, "A big portal opened up around here.\nA buncha POKéMON came out of it,\lbut all of them were copies!\pGood thing we, the DMCA, were here!\n", "Hey!")
	msgbox("The DMCA is here on important\nbusiness.\lThere's infringement afoot!\pWe won't rest until the violating\nPOKéMON is apprehended!", MSGBOX_NPC)
}

script SafariZone_North_DMCA_2 {
	trainerbattle_single(TRAINER_DMCA_GRUNT_20, "Were you the kid trying to sneak in\nthe TM CASE?\nHaha!", "But how!?")
	msgbox("You think all the TMs laying on\nthe ground are free pickings?\pIf you want a TRADEMARK, you have\nto work hard and earn it!\l(or be born rich and buy a company)", MSGBOX_NPC)

}

script SafariZone_North_DMCA_3 {
	trainerbattle_single(TRAINER_DMCA_GRUNT_21, "We were supposed to be taking all\nthe PARADOX POKéMON, but…\pI think I'm doing something wrong.\n", "Hey, where'd he go?")
	msgbox("Our ADMIN up ahead took the\nstrongest PARADOX POKéMON.\lThere's no way you'll get through!", MSGBOX_NPC)

}

script SafariZone_North_DMCA_4 {
	trainerbattle_single(TRAINER_DMCA_GRUNT_22, "Graaah!\nWhy won't this POKéMON just change?", "It's violating its own copyright!")
	famechecker(FAMECHECKER_FUSHCIA, 2)
	msgbox("We found a SCOPE here that induces\nan illegal evolution in DRAGONITE.\pWe passed it to our team in the\nCELADON DMCA LAW OFFICES.\lOne of our ADMINS is guarding it.\p…What's that?\nYou took it from him!?\lNo!", MSGBOX_NPC)

}

script SafariZone_North_Child {
	lock
	msgbox("Ooooh…\nPretty colors!", MSGBOX_DEFAULT)
	release
	end
}

script SafariZone_North_Mother {
	lock
	if(flag(FLAG_TEMP_2)) {
		faceplayer
		
		msgbox("Whelp.\n{PAUSE 30}I warned her.", MSGBOX_DEFAULT)
		release
		end

	}
	addobject(LOCALID_NORTH_CHUCKSTER)
	setobjectxy(LOCALID_NORTH_CHUCKSTER, 21, 34)
	applymovement(VAR_LAST_TALKED, Common_Movement_FaceDown)
	applymovement(LOCALID_NORTH_CHUCKSTER, moves(
		delay_16 * 2
		face_up
		set_visible
		walk_up * 3
		walk_right * 4
		face_right
	))
	msgbox("Now listen, sweetie!\nStay away from the fence.\lYou don't wanna get hurt!", MSGBOX_DEFAULT)
	closemessage
	waitmovement(LOCALID_NORTH_CHUCKSTER)
	textcolor(NPC_TEXT_COLOR_BLUE)
	delay(20)
	msgbox("I'm a CHUCKSTER!\n", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	playse(SE_LEDGE)
	applymovement(LOCALID_NORTH_CHUCKSTER, moves(
		walk_right
		face_right
	))
	applymovement(LOCALID_SAFARI_CHILD, moves(
		face_left
		lock_facing_direction
		jump_2_right
		delay_8
		walk_in_place_fast_left
		walk_slower_right
		walk_slow_right
		unlock_facing_direction
		face_up
		delay_4
		face_right
		delay_4
		face_down
		delay_4
		face_left
		delay_4
		face_up
		delay_4
		face_right
		delay_4
		face_down
		delay_4
		face_left
		delay_4
		face_up
		delay_2
		face_right
		delay_2
		face_down
		delay_2
		face_left
		delay_2
		face_up
		delay_2
		face_right
		delay_2
		face_down
		delay_2
		face_left
		delay_2
		face_up
		delay_2
		face_right
		delay_2
		face_down
		delay_2
		face_left
		delay_2
		face_up
		delay_2
		face_right
		delay_2
		face_down
		delay_2
		face_left
		delay_2
		set_invisible

	))
	delay(30)
	setobjectsubpriority(LOCALID_SAFARI_CHILD, MAP_SAFARI_ZONE_NORTH, 255)
	playse(SE_PIN)
	applymovement(VAR_LAST_TALKED, moves(
		face_right
		emote_exclamation_mark
	))
	waitmovement(LOCALID_SAFARI_CHILD)
	playse(SE_BANG)
	delay(60)
	applymovement(LOCALID_NORTH_CHUCKSTER, moves(
		walk_left * 5
		walk_down * 3
		face_down
		set_invisible
	))
	textcolor(NPC_TEXT_COLOR_FEMALE)
	delay(30)
	msgbox("…\n", MSGBOX_DEFAULT)
	closemessage
	delay(30)
	faceplayer
	msgbox("Whelp.\n{PAUSE 30}I warned her.", MSGBOX_DEFAULT)
	setflag(FLAG_TEMP_2)
	setflag(FLAG_TEMP_3)
	removeobject(LOCALID_SAFARI_CHILD)
	waitmovement(LOCALID_NORTH_CHUCKSTER)
	removeobject(LOCALID_NORTH_CHUCKSTER)
	release
	end
}