const BRELOOM = 8
mapscripts SafariZone_North_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		if(!flag(FLAG_HIDE_DMCA_IN_SAFARI_ZONE)) {
			removeobject(BRELOOM)
		} else {
			addobject(BRELOOM)
		}
	}
}

script SafariZone_North_Breloom {
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_MALE)
	playmoncry(SPECIES_BRELOOM, CRY_MODE_DEFAULT)
	msgbox("BRELOOM: Bre-Breee!\n", MSGBOX_DEFAULT)
	waitmoncry
	closemessage
	delay(30)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox("He seems sad to have missed the\naction.", MSGBOX_DEFAULT)
	release

}

script SafariZone_North_DMCA_1 {
	trainerbattle_single(TRAINER_DMCA_GRUNT_17, "A big portal opened up around here.\nA buncha POKéMON came out of it,\lbut all of them were copies!\pGood thing we, the DMCA, were here!\n", "PLACEHOLDER")
	msgbox("PLACEHOLDER", MSGBOX_NPC)
}

script SafariZone_North_DMCA_2 {
	trainerbattle_single(TRAINER_DMCA_GRUNT_17, "Were you the kid trying to sneak in\nthe TM CASE?\nHahaha!", "PLACEHOLDER")
	msgbox("PLACEHOLDER", MSGBOX_NPC)

}

script SafariZone_North_DMCA_3 {
	trainerbattle_single(TRAINER_DMCA_GRUNT_17, "We were supposed to be taking all\nthe PARADOX POKéMON, but…\pI think I'm doing something wrong.\n", "PLACEHOLDER")
	msgbox("PLACEHOLDER", MSGBOX_NPC)

}

script SafariZone_North_DMCA_4 {
