const BRELOOM = 8
mapscripts SafariZone_North_MapScripts {
	MAP_SCRIPT_ON_LOAD {
		if(!(checkpartymove(MOVE_GULP) == PARTY_SIZE) && !flag(FLAG_HIDE_DMCA_IN_SAFARI_ZONE)) {
			playbgm(MUS_SAFARI_MARCH, TRUE)
		} 
	}
	MAP_SCRIPT_ON_TRANSITION {
	
	}
	
}

script SafariZone_North_Breloom {
	lock
	faceplayer
	textcolor(NPC_TEXT_COLOR_MALE)
	playmoncry(SPECIES_BRELOOM, CRY_MODE_DEFAULT)
	msgbox("BRELOOM: Bre-Breee!\n", MSGBOX_DEFAULT)
	waitmoncry
	closemessage
	delay(30)
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox("He seems sad to have missed the\naction.", MSGBOX_DEFAULT)
	release

}

script SafariZone_North_DMCA_1 {
	trainerbattle_single(TRAINER_DMCA_GRUNT_19, "A big portal opened up around here.\nA buncha POKéMON came out of it,\lbut all of them were copies!\pGood thing we, the DMCA, were here!\n", "PLACEHOLDER")
	msgbox("The DMCA is here on important\nbusiness.\lThere's infringement afoot!\pWe won't rest until the violating\nPOKéMON is apprehended!", MSGBOX_NPC)
}

script SafariZone_North_DMCA_2 {
	trainerbattle_single(TRAINER_DMCA_GRUNT_20, "Were you the kid trying to sneak in\nthe TM CASE?\nHahaha!", "PLACEHOLDER")
	msgbox("PLACEHOLDER", MSGBOX_NPC)

}

script SafariZone_North_DMCA_3 {
	trainerbattle_single(TRAINER_DMCA_GRUNT_21, "We were supposed to be taking all\nthe PARADOX POKéMON, but…\pI think I'm doing something wrong.\n", "Grr!\nIt's the wrong kind of PARADOX!")
	msgbox("Our ADMIN up ahead took the\nstrongest PARADOX POKéMON.\lThere's no way you'll get through!", MSGBOX_NPC)

}

script SafariZone_North_DMCA_4 {
	trainerbattle_single(TRAINER_DMCA_GRUNT_22, "Graaah!\nWhy won't this POKéMON just change?", "PLACEHOLDER")
	msgbox("We found an ITEM here that induced\nan illegal EVOLUTION.\pWe passed it to our team in the\nCELADON DMCA LAW OFFICES.\lOne of our ADMINS is guarding it.\p…What's that?\nYou took it from him!?\lNo!", MSGBOX_NPC)

}