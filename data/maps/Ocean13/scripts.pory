mapscripts Ocean13_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if(var(VAR_CSR_OCEAN_LASS_MAZE) > 1) {
            setflag(FLAG_TEMP_2)
            setflag(FLAG_TEMP_1)
        }
    }
}


script LassMaze_PreLass {
    textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox(
	"Her eyes are locked straight down.\p"

	"She's waiting.\n"
	"", MSGBOX_SIGN)

}
