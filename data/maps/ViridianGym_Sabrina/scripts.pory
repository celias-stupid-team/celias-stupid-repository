mapscripts ViridianGym_Sabrina_MapScripts {
        MAP_SCRIPT_ON_TRANSITION {
        if(var(VAR_CURRENT_DMCA_PHASE) < 6) {
            setvar(VAR_CURRENT_DMCA_PHASE, 6)
        }
        switch(var(VAR_CURRENT_DMCA_PHASE)) {
            case 1:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM, 6)
            case 2:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_2, 6)
            case 3:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_3, 6)
            case 4:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_4, 6)
            case 5:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_5, 6)
            case 6:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_6, 6)
            case 7:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_7, 6)
            case 8:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_8, 6)
            case 9:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_9, 6)
        }
    }
}



script ViridianGym_SabrinaBattle {
    trainerbattle_single(TRAINER_DMCA_SABRINA, ViridianGym_SabrinaBattle_Start, ViridianGym_SabrinaBattle_End)
    msgbox(
	"i'm dead\n"
	"", MSGBOX_DEFAULT)
}

text ViridianGym_SabrinaBattle_Start {
    "they killed my gym\n"
}


text ViridianGym_SabrinaBattle_End {
   "oh no\n"
	"death"
}
