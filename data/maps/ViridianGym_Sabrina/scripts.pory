mapscripts ViridianGym_Sabrina_MapScripts {
        MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_SAFFRON_GYM_SHORTCUT)
        if(var(VAR_CURRENT_DMCA_PHASE) < 6 && flag(FLAG_DEFEATED_DMCA_KOGA)) {
            setvar(VAR_CURRENT_DMCA_PHASE, 6)
            setrespawn(HEAL_LOCATION_VIRIDIAN_GYM_SABRINA)
        }
        switch(var(VAR_CURRENT_DMCA_PHASE)) {
            case 1:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM, 6)
            case 2:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_2, 6)
            case 3:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_3, 6)
            case 4:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_4, 6)
            case 5:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_5, 6)
            case 6:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_6, 6)
            case 7:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_7, 6)
            case 8:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_8, 6)
            case 9:
                setdynamicwarp(MAP_VIRIDIAN_GYM_HUB_ROOM_9, 6)
        }
        setflag(FLAG_TEMP_4)
        if(flag(FLAG_BEAT_DMCA_SABRINA)) {
            clearflag(FLAG_TEMP_4)
        }

    }
    MAP_SCRIPT_ON_LOAD {
        if(flag(FLAG_SILPH_WARP_THREE_ISLAND)) {
            setmetatile(7, 12, 0x293, FALSE)
        }
        if(flag(FLAG_BEAT_DMCA_SABRINA)) {
            setmetatile(21, 9, 0x293, FALSE)
        }
    }
}


script ViridianGym_SabrinaDead {
	msgbox(
	"The little doll has had her head\n"
	"removed.", MSGBOX_SIGN)
}



script ViridianGym_SabrinaBattle {
    lock
    faceplayer
    msgbox(
	"SABRINA: I can't believe this…\n"
	"They shut down my GYM!\p"

	"You! Foolish challenger!\n"
	"You think you're more powerful\l"
	"than copyright infringement?\p"

	"Then let's put that to the test.\n"
	"", MSGBOX_DEFAULT)
    trainerbattle_no_intro(TRAINER_DMCA_SABRINA, ViridianGym_SabrinaBattle_End)
    removeobject(LOCALID_SABRINA_ROADBLOCK)
    playse(SE_WARP_OUT)
    fadescreenswapbuffers(FADE_TO_WHITE)
    addobject(LOCALID_DEAD_SABRINA)
    removeobject(VAR_LAST_TALKED)
    waitse
    fadescreeninstant(FADE_FROM_WHITE)
    playse(SE_M_CUT)
    waitse
    delay(60)
    playse(SE_SWITCH)
    setmetatile(21, 9, 0x293, FALSE)
    special(DrawWholeMapView)
    release
}

text ViridianGym_SabrinaBattle_Start {
    "they killed my gym\n"
}


text ViridianGym_SabrinaBattle_End {
   "No!\n"
	"My powers failed me-!"
}


script ViridianGym_SabrinaGrandpaDead {
	msgbox(
	"Oh no!\n"
	"Grandpa's dead!", MSGBOX_SIGN)

}


script ViridianGym_SabrinaGrandpaHead {
	msgbox(
	"Oh no!\n"
	"Grandpa's head!", MSGBOX_SIGN)

}