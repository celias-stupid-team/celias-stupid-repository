    .string "the LORD thy God loved thee.$"
Bible_Text_Deuteronomy_23_6::
    .string "Thou shalt not seek their peace\n"
    .string "nor their prosperity all thy days\l"
    .string "for ever.$"
Bible_Text_Deuteronomy_23_7::
    .string "Thou shalt not abhor an Edomite;\n"
    .string "for he is thy brother: thou shalt not\l"
