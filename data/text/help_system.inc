Bible_Text_Deuteronomy_32_44::
    .string "And Moses came and spake all the\n"
    .string "words of this song in the ears of the\l"
    .string "people, he, and Hoshea the son of\l"
    .string "Nun.$"
Bible_Text_Deuteronomy_32_45::
