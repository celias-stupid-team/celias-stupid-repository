Bible_Text_Deuteronomy_33_25::
    .string "Thy shoes shall be iron and brass;\n"
    .string "and as thy days, so shall thy\l"
    .string "strength be.$"
Bible_Text_Deuteronomy_33_26::
    .string "There is none like unto the God of\n"
    .string "Jeshurun, who rideth upon the heaven\l"
