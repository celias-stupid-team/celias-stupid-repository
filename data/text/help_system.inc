Bible_Text_Deuteronomy_33_15::
    .string "And for the chief things of the\n"
    .string "ancient mountains, and for the\l"
    .string "precious things of the lasting\l"
    .string "hills,"
Bible_Text_Deuteronomy_33_16::
    .string "And for the precious things of the\n"
